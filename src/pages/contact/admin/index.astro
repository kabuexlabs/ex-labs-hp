---
// お問い合わせの受信箱＋診断ページ（社内用）。
//   - KVに保存された問い合わせを新しい順に一覧表示（メールを見落としても
//     ここに必ず残る — 取りこぼし防止の最後の砦）
//   - メール(Resend)/KVの設定状態と、実際のテスト送信による疎通確認
// 認証は予約管理と同じ YOYAKU_ADMIN_KEY（合言葉はPOSTのみ、以降は
// HttpOnly セッションCookie）。
export const prerender = false;

import YoyakuLayout from '../../../layouts/YoyakuLayout.astro';
import { checkAdminKey, adminEmail } from '../../../lib/yoyaku';
import {
  listInquiries,
  contactConfigStatus,
  testMailSend,
  loginAllowed,
  recordLoginFailure,
  type ContactRecord,
  setInquiryStatus,
  INQUIRY_STATUS_LABEL,
  type InquiryStatus,
  readMetrics,
} from '../../../lib/contact';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

const COOKIE = 'contact_admin';
let loginFailed = false;
let testResult: { ok: boolean; detail: string } | null = null;

let key = Astro.cookies.get(COOKIE)?.value ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'login') {
    const ip = (Astro.request.headers.get('x-forwarded-for') ?? '').split(',')[0].trim() || 'unknown';
    const entered = String(form.get('key') ?? '').trim();
    if (!(await loginAllowed(ip))) {
      loginFailed = true;
    } else if (checkAdminKey(entered)) {
      Astro.cookies.set(COOKIE, entered, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/contact/admin',
      });
      return Astro.redirect(Astro.url.pathname, 303);
    } else {
      await recordLoginFailure(ip);
      loginFailed = true;
    }
  } else if (action === 'testmail' && checkAdminKey(key)) {
    testResult = await testMailSend(adminEmail());
  } else if (action === 'status' && checkAdminKey(key)) {
    const id = String(form.get('id') ?? '');
    const st = String(form.get('status') ?? 'new') as InquiryStatus;
    if (id && st in INQUIRY_STATUS_LABEL) await setInquiryStatus(id, st, String(form.get('note') ?? ''));
    return Astro.redirect(Astro.url.pathname + '#q-' + id, 303);
  }
}

const authed = checkAdminKey(key);
const status = contactConfigStatus();
const inquiries: ContactRecord[] = authed ? await listInquiries(50) : [];
// 問い合わせ導線の計測（直近28日）：フォーム表示・相談CTAクリック・送信成功
const metrics = authed ? await readMetrics(28) : { rows: [], from: '', to: '' };
const mSum = (e: string) => metrics.rows.filter((r) => r.event === e).reduce((a, r) => a + r.count, 0);
const mByPage = (e: string) => {
  const m = new Map<string, number>();
  for (const r of metrics.rows) if (r.event === e) m.set(r.page, (m.get(r.page) ?? 0) + r.count);
  return [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
};
const mByCat = (e: string) => {
  const m = new Map<string, number>();
  for (const r of metrics.rows) if (r.event === e) m.set(r.category || '(未選択)', (m.get(r.category || '(未選択)') ?? 0) + r.count);
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};

function fmtDate(iso: string) {
  const d = new Date(iso);
  return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
}

// --- 流入元の集計（受信一覧の上に表示） ------------------------------------
// SourceField が記録した「参照元 / 最初に開いたページ / 送信したページ」を
// 分解して、どの経路・どのページから問い合わせが来ているかを数える。
function channelOf(ref: string): string {
  if (!ref || ref.startsWith('(')) return '直接アクセス';
  if (/google\./.test(ref)) return 'Google検索';
  if (/bing\.com|yahoo\.co\.jp|duckduckgo/.test(ref)) return 'Google以外の検索';
  if (/chatgpt\.com|openai\.com|perplexity\.ai|gemini\.google|copilot\.microsoft|claude\.ai/.test(ref)) return 'AI検索：' + ref.replace(/^https?:\/\//, '').split('/')[0];
  if (/kabuexlabs\.com/.test(ref)) return 'サイト内リンク';
  return '外部サイト：' + ref.replace(/^https?:\/\//, '').split('/')[0];
}
function parseSource(src?: string) {
  const get = (label: string) => (src?.split('\n').find((l) => l.startsWith(label + ': ')) ?? '').slice(label.length + 2).trim();
  const ref = get('参照元');
  const landing = get('最初に開いたページ');
  const sent = get('送信したページ');
  const firstRef = get('初回参照元');
  const firstLanding = get('初回入口ページ');
  const firstDate = get('初回訪問日');
  const visits = get('訪問回数');
  const path = (u: string) => { try { return new URL(u).pathname + (new URL(u).search || ''); } catch { return u || '(不明)'; } };
  let channel = src ? channelOf(ref) : '記録なし';
  const firstChannel = firstRef ? channelOf(firstRef) : '';
  if (firstChannel && firstChannel !== channel) channel += `（初回: ${firstChannel}）`;
  return {
    channel, ref,
    landing: landing ? path(landing) : '(不明)',
    sent: sent ? path(sent) : '(不明)',
    firstRef, firstChannel,
    firstLanding: firstLanding ? path(firstLanding) : '',
    firstDate, visits,
  };
}
const stats = (() => {
  const byChannel = new Map<string, number>();
  const byLanding = new Map<string, number>();
  const byStatus = new Map<string, number>();
  let spamCount = 0;
  for (const q of inquiries) {
    if (q.spam || q.status === 'spam') { spamCount++; continue; }
    byStatus.set(q.status ?? 'new', (byStatus.get(q.status ?? 'new') ?? 0) + 1);
    const p = parseSource(q.source);
    byChannel.set(p.channel, (byChannel.get(p.channel) ?? 0) + 1);
    byLanding.set(p.landing, (byLanding.get(p.landing) ?? 0) + 1);
  }
  const sorted = (m: Map<string, number>) => [...m.entries()].sort((a, b) => b[1] - a[1]);
  const valid = (byStatus.get('meeting') ?? 0) + (byStatus.get('won') ?? 0);
  return { byChannel: sorted(byChannel), byLanding: sorted(byLanding), byStatus: sorted(byStatus), valid, spamCount, legit: inquiries.length - spamCount };
})();
---
<YoyakuLayout title="お問い合わせ受信箱｜ex Labs">
<div class="yk-wrap">
<h1 style="font-size:22px;margin:0 0 8px">お問い合わせ受信箱</h1>
<p style="font-size:13px;color:#8a8378;margin:0 0 28px">フォームからの送信はメール通知とは別にここへ必ず記録されます（直近500件）。</p>

{!authed ? (
  <form method="POST" style="display:flex;flex-direction:column;gap:14px;max-width:360px">
    <input type="hidden" name="action" value="login">
    <label style="font-size:13px;font-weight:700">合言葉（予約管理と共通）
      <input type="password" name="key" required style="display:block;width:100%;margin-top:8px;padding:12px 14px;border:2px solid var(--ink);font:inherit">
    </label>
    {loginFailed && <p style="color:#c00;font-size:13px;margin:0">合言葉が違うか、試行回数の上限に達しました。しばらくおいてからお試しください。</p>}
    <button type="submit" style="padding:12px;border:2px solid var(--ink);background:var(--accent);color:#fff;font-weight:800;cursor:pointer">ログイン</button>
  </form>
) : (
  <>
  <section style="border:2px solid var(--ink);background:#fff;padding:20px 22px;margin-bottom:28px">
    <h2 style="font-size:15px;margin:0 0 12px">システム状態</h2>
    <ul style="margin:0;padding-left:1.2em;font-size:13.5px;line-height:2">
      <li>メール通知: {status.smtp ? '✅ 自社メール（SMTP直送）— 外部サービス不使用' : status.resend ? '✅ Resend APIキーあり' : '❌ 未設定'}</li>
      <li>記録（KV）: {status.kv ? '✅ 設定あり' : '❌ 未設定 — 問い合わせの保存ができません'}</li>
      <li>送信元アドレス: {status.mailFrom}</li>
    </ul>
    <form method="POST" style="margin:16px 0 0">
      <input type="hidden" name="action" value="testmail">
      <button type="submit" style="padding:10px 20px;border:2px solid var(--ink);background:#fff;font-weight:800;cursor:pointer">テストメールを {adminEmail()} に送信</button>
    </form>
    {testResult && (
      <p style={`margin:14px 0 0;font-size:13.5px;padding:12px 14px;border:2px solid ${testResult.ok ? '#1a7f37' : '#c00'};background:${testResult.ok ? '#f0fff4' : '#fff5f5'};overflow-wrap:anywhere`}>{testResult.detail}</p>
    )}
    {!status.smtp && (
      <div style="margin:18px 0 0;padding:14px 16px;border:2px solid var(--accent);background:#fff8f0;font-size:13px;line-height:2">
        <p style="margin:0 0 6px;font-weight:800">メール通知を有効にする手順（外部サービス不要・約5分）</p>
        <p style="margin:0 0 8px">info@kabuexlabs.com（Google）自身の送信機能をそのまま使います。新しいサービスの契約は不要です。</p>
        <ol style="margin:0;padding-left:1.4em">
          <li>info@kabuexlabs.com のGoogleアカウントで2段階認証を有効にする（設定済みなら次へ）</li>
          <li><a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener" style="color:var(--accent);text-decoration:underline">myaccount.google.com/apppasswords</a> を開き（info@でログイン）、アプリ名「HP問い合わせ」等で<strong>アプリパスワード（16桁）</strong>を作成してコピー</li>
          <li>Vercelの Settings → Environment Variables に2つ追加（全環境）→ Redeploy：<br><code>SMTP_USER</code> = info@kabuexlabs.com<br><code>SMTP_PASS</code> = 作成した16桁（スペースはあってもOK）</li>
          <li>このページの「テストメール送信」で届くことを確認</li>
        </ol>
        <p style="margin:8px 0 0;color:#8a8378">※アプリパスワードは「このシステム専用の合鍵」です。Googleのログインパスワード本体ではなく、いつでも単独で無効化できます。</p>
      </div>
    )}
  </section>

  {inquiries.length > 0 && (
    <section style="border:2px solid var(--ink);background:#fff;padding:16px 18px;margin:0 0 22px">
      <h2 style="font-size:15px;margin:0 0 10px">流入元の集計（営業・スパム判定 {stats.spamCount}件を除く {stats.legit}件）</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;font-size:13.5px">
        <div>
          <p style="margin:0 0 6px;font-weight:700">商談ステータス（有効商談＝商談中＋受注：<strong>{stats.valid}件</strong>）</p>
          <ul style="margin:0;padding-left:1.2em;line-height:1.9">
            {stats.byStatus.map(([k, n]) => <li>{INQUIRY_STATUS_LABEL[k as InquiryStatus] ?? k}：<strong>{n}件</strong></li>)}
          </ul>
        </div>
        <div>
          <p style="margin:0 0 6px;font-weight:700">どこから来たか（参照元）</p>
          <ul style="margin:0;padding-left:1.2em;line-height:1.9">
            {stats.byChannel.map(([k, n]) => <li>{k}：<strong>{n}件</strong></li>)}
          </ul>
        </div>
        <div>
          <p style="margin:0 0 6px;font-weight:700">最初に開いたページ（入口）</p>
          <ul style="margin:0;padding-left:1.2em;line-height:1.9">
            {stats.byLanding.map(([k, n]) => <li><code style="font-size:12.5px">{k}</code>：<strong>{n}件</strong></li>)}
          </ul>
        </div>
      </div>
      <p style="margin:10px 0 0;font-size:11.5px;color:#8a8378">※流入元の記録はフォームに自動記録を仕込んだ日（8月中旬）以降の問い合わせに付いています。それ以前は「記録なし」になります。</p>
    </section>
  )}
  <section style="border:2px solid var(--ink);background:#fff;padding:16px 18px;margin:0 0 22px">
    <h2 style="font-size:15px;margin:0 0 10px">問い合わせ導線の計測（{metrics.from}〜{metrics.to}・個人情報なし）</h2>
    <p style="margin:0 0 10px;font-size:13.5px">相談CTAクリック <strong>{mSum('cta')}</strong> → フォーム表示 <strong>{mSum('view')}</strong> → 送信成功 <strong>{mSum('submit')}</strong>（スパム判定を除く）</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;font-size:13px">
      <div>
        <p style="margin:0 0 6px;font-weight:700">CTAをクリックしたページ</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByPage('cta').map(([k, n]) => <li><code style="font-size:12px">{k}</code>：<strong>{n}</strong></li>)}</ul>
      </div>
      <div>
        <p style="margin:0 0 6px;font-weight:700">送信時に選ばれた「ご相談の種類」</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByCat('submit').map(([k, n]) => <li>{k}：<strong>{n}</strong></li>)}</ul>
      </div>
      <div>
        <p style="margin:0 0 6px;font-weight:700">送信したページ</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByPage('submit').map(([k, n]) => <li><code style="font-size:12px">{k}</code>：<strong>{n}</strong></li>)}</ul>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;font-size:13px;margin-top:14px;padding-top:12px;border-top:1px dotted rgba(51,48,43,.25)">
      <div>
        <p style="margin:0 0 6px;font-weight:700">公演チケットサイトへのクリック <strong>{mSum('ticket')}</strong>（公演-掲載箇所）</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByCat('ticket').map(([k, n]) => <li>{k}：<strong>{n}</strong></li>)}</ul>
      </div>
      <div>
        <p style="margin:0 0 6px;font-weight:700">公演詳細ページへのクリック <strong>{mSum('show')}</strong>（公演-掲載箇所）</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByCat('show').map(([k, n]) => <li>{k}：<strong>{n}</strong></li>)}</ul>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;font-size:13px;margin-top:14px;padding-top:12px;border-top:1px dotted rgba(51,48,43,.25)">
      <div>
        <p style="margin:0 0 6px;font-weight:700">公演検索（/events/）の利用 <strong>{mSum('ev-search')}</strong>（日付種別-人数-エリア-ジャンル）</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByCat('ev-search').map(([k, n]) => <li>{k}：<strong>{n}</strong></li>)}</ul>
      </div>
      <div>
        <p style="margin:0 0 6px;font-weight:700">検索結果ゼロ <strong>{mSum('ev-zero')}</strong>（同上）</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByCat('ev-zero').map(([k, n]) => <li>{k}：<strong>{n}</strong></li>)}</ul>
      </div>
      <div>
        <p style="margin:0 0 6px;font-weight:700">公演詳細の閲覧 <strong>{mSum('ev-view')}</strong>（作品-own＝自社／3rd＝他社）</p>
        <ul style="margin:0;padding-left:1.2em;line-height:1.9">{mByCat('ev-view').map(([k, n]) => <li>{k}：<strong>{n}</strong></li>)}</ul>
      </div>
    </div>
    <p style="margin:10px 0 0;font-size:11.5px;color:#8a8378">※公演検索の計測は 2026-09-13 以降。チケットサイトへのクリックの「掲載箇所」が events-own／events-3rd／detail-own／detail-3rd のものは公演検索サービス経由で、own＝自社公演・3rd＝他社公演の送客です。購入完了は数えていません。</p>
    <p style="margin:10px 0 0;font-size:11.5px;color:#8a8378">※計測を入れた日（2026-09-08、公演クリックは 2026-09-09）以降のみ。CTA＝「#contact」へのリンクのクリック。チケットサイトへのクリックは購入完了ではありません。送信の記録には送信者情報を含めません。</p>
  </section>
  <h2 style="font-size:15px;margin:0 0 14px">受信一覧（{inquiries.length}件）</h2>
  {inquiries.length === 0 ? (
    <p style="font-size:13.5px;color:#8a8378">記録はまだありません。{!status.kv && 'KVが未設定のため保存自体が行われていません。'}</p>
  ) : (
    <div style="display:flex;flex-direction:column;gap:14px">
      {inquiries.map((q) => (
        <details id={`q-${q.id}`} style="border:2px solid var(--ink);background:#fff;padding:14px 18px">
          <summary style="cursor:pointer;font-size:13.5px;font-weight:700"><span style={`margin-right:8px;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;color:#fff;background:${q.status === 'won' ? '#1a7f4b' : q.status === 'meeting' ? 'var(--accent)' : q.status === 'lost' || q.status === 'spam' ? '#8a8378' : q.status === 'replied' ? '#3b6fb6' : '#b3261e'}`}>{INQUIRY_STATUS_LABEL[q.status ?? 'new']}</span>{fmtDate(q.createdAt)}　{q.subject}　<span style="font-weight:500;color:#8a8378">{q.email}</span>{q.spam && <span style="margin-left:8px;font-size:11px;font-weight:700;color:#fff;background:#b3261e;padding:2px 8px;border-radius:999px">営業・スパムの疑い</span>}<span style="margin-left:8px;font-size:11.5px;font-weight:600;color:var(--accent)">{parseSource(q.source).channel}</span></summary>
          <pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;font-size:13.5px;margin:12px 0 0;line-height:1.9">{q.fields}</pre>
          {q.source ? (
            <div style="margin:12px 0 0;padding:10px 12px;background:#f6f4ef;border-radius:8px;font-size:12.5px;line-height:1.8">
              <p style="margin:0;font-weight:700">流入元：{parseSource(q.source).channel}</p>
              <p style="margin:0">入口ページ: <code>{parseSource(q.source).landing}</code>　→　送信ページ: <code>{parseSource(q.source).sent}</code></p>
              {parseSource(q.source).firstLanding && <p style="margin:0">初回訪問: {parseSource(q.source).firstDate || '(不明)'}　{parseSource(q.source).firstChannel}　入口 <code>{parseSource(q.source).firstLanding}</code>{parseSource(q.source).visits && <>　訪問回数 {parseSource(q.source).visits}</>}</p>}
              {parseSource(q.source).firstRef && !parseSource(q.source).firstRef.startsWith('(') && parseSource(q.source).firstRef !== parseSource(q.source).ref && <p style="margin:0;overflow-wrap:anywhere">初回参照元URL: {parseSource(q.source).firstRef}</p>}
              {parseSource(q.source).ref && !parseSource(q.source).ref.startsWith('(') && <p style="margin:0;overflow-wrap:anywhere">参照元URL: {parseSource(q.source).ref}</p>}
            </div>
          ) : (
            <p style="margin:10px 0 0;font-size:12px;color:#8a8378">流入元: 記録なし（自動記録の導入前、またはJS無効）</p>
          )}
          <p style="font-size:11.5px;color:#8a8378;margin:10px 0 0">返信先: <a href={`mailto:${q.email}`} style="color:var(--accent)">{q.email}</a>｜IP: {q.ip}</p>
          <form method="POST" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:12px 0 0;font-size:12.5px">
            <input type="hidden" name="action" value="status"><input type="hidden" name="id" value={q.id}>
            <label>商談ステータス
              <select name="status" style="margin-left:6px;padding:6px 8px;border:2px solid var(--ink);font:inherit;font-size:12.5px">
                {(Object.keys(INQUIRY_STATUS_LABEL) as InquiryStatus[]).map((k) => <option value={k} selected={(q.status ?? 'new') === k}>{INQUIRY_STATUS_LABEL[k]}</option>)}
              </select>
            </label>
            <input type="text" name="note" value={q.statusNote ?? ''} placeholder="メモ（例：9/12 初回打合せ）" style="flex:1;min-width:180px;padding:6px 8px;border:2px solid var(--ink);font:inherit;font-size:12.5px">
            <button type="submit" style="padding:6px 12px;border:2px solid var(--ink);background:var(--ink);color:#fff;font-weight:700;cursor:pointer;font-size:12.5px">更新</button>
            {q.statusUpdatedAt && <span style="color:#8a8378">更新 {fmtDate(q.statusUpdatedAt)}</span>}
          </form>
        </details>
      ))}
    </div>
  )}
  </>
)}
</div>
</YoyakuLayout>
