---
// 名刺（連絡先）の管理。
//   /brain/contacts/          … 一覧＋新規追加
//   /brain/contacts/?id=<id>  … 詳細・編集・削除＋関連する議事録
// 変更系はすべて POST（Origin 検証つき）。認証は /brain 共通のセッション。
export const prerender = false;

import BrainLayout from '../../../layouts/BrainLayout.astro';
import BrainLogin from '../../../components/BrainLogin.astro';
import BrainPhotoInput from '../../../components/BrainPhotoInput.astro';
import {
  handleAuth,
  checkOrigin,
  isKvConfigured,
  isAdminKeyConfigured,
  isVisionConfigured,
  getContacts,
  getContact,
  createContact,
  saveContact,
  deleteContact,
  getNotes,
  relatedNotes,
  addLog,
  parseImageDataUrl,
  saveImage,
  persistImage,
  deleteImage,
  getImage,
  saveDraft,
  getDraft,
  deleteDraft,
  extractCardFields,
  formatDateJa,
  formatDateTimeJa,
  type Contact,
  type ContactDraft,
  type Note,
} from '../../../lib/brain';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

const auth = await handleAuth(Astro);
if (auth.response) return auth.response;

let error = '';
const message = (Astro.url.searchParams.get('msg') ?? '').slice(0, 80);
let viewId = (Astro.url.searchParams.get('id') ?? '').slice(0, 20);

// フォームの各項目を長さ上限つきで読み出す
function fields(form: FormData) {
  const f = (name: string, max: number) => String(form.get(name) ?? '').trim().slice(0, max);
  return {
    name: f('name', 100),
    kana: f('kana', 100) || undefined,
    company: f('company', 120) || undefined,
    role: f('role', 120) || undefined,
    email: f('email', 254) || undefined,
    phone: f('phone', 40) || undefined,
    tags: f('tags', 200) || undefined,
    met: f('met', 200) || undefined,
    memo: f('memo', 4000) || undefined,
  };
}

if (Astro.request.method === 'POST' && auth.authed) {
  if (!checkOrigin(Astro.request, Astro.url)) {
    error = '不正なリクエストです（Origin不一致）。ページを再読み込みしてやり直してください。';
  } else {
    const form = await Astro.request.formData();
    const action = String(form.get('action') ?? '');

    if (action === 'photo') {
      // 名刺写真から登録：写真を保存 → AIで項目を読み取り → 確認画面へ
      const parsed = parseImageDataUrl(String(form.get('photo') ?? ''));
      if (parsed.error || !parsed.image) {
        error = parsed.error ?? '写真を選択してください。';
      } else {
        const photoId = await saveImage(parsed.image);
        let extracted: Partial<Contact> | null = null;
        let notice = '';
        if (isVisionConfigured()) {
          extracted = await extractCardFields(parsed.image);
          notice = extracted
            ? '名刺を読み取りました。内容を確認・修正して登録してください。'
            : '写真は保存しましたが、自動読み取りに失敗しました。お手数ですが手入力してください。';
        } else {
          notice = '写真を保存しました。自動読み取り（ANTHROPIC_API_KEY）が未設定のため、項目は手入力してください。';
        }
        await saveDraft({ photoId, fields: extracted ?? {}, notice });
        return Astro.redirect(`/brain/contacts/?draft=${photoId}`, 303);
      }
    } else if (action === 'create') {
      const data = fields(form);
      const photoId = String(form.get('photoId') ?? '').slice(0, 20);
      if (!data.name) {
        error = '氏名を入力してください。';
      } else {
        let photo: string | undefined;
        if (photoId && (await getImage(photoId))) {
          await persistImage(photoId);
          photo = photoId;
        }
        const c = await createContact({ ...data, photoId: photo });
        if (photoId) await deleteDraft(photoId);
        await addLog(`名刺を登録${photo ? '（写真あり）' : ''}：${c.name}${c.company ? `（${c.company}）` : ''}`);
        return Astro.redirect(`/brain/contacts/?id=${c.id}&msg=${encodeURIComponent('登録しました。')}`, 303);
      }
    } else if (action === 'setphoto') {
      // 既存の名刺に写真を追加・差し替え
      const id = String(form.get('id') ?? '').slice(0, 20);
      const existing = await getContact(id);
      const parsed = parseImageDataUrl(String(form.get('photo') ?? ''));
      if (!existing) {
        error = '対象が見つかりません。';
      } else if (parsed.error || !parsed.image) {
        error = parsed.error ?? '写真を選択してください。';
        viewId = id;
      } else {
        const newId = await saveImage(parsed.image);
        await persistImage(newId);
        await deleteImage(existing.photoId);
        await saveContact({ ...existing, photoId: newId, updatedAt: new Date().toISOString() });
        await addLog(`名刺写真を更新：${existing.name}`);
        return Astro.redirect(`/brain/contacts/?id=${id}&msg=${encodeURIComponent('写真を保存しました。')}`, 303);
      }
    } else if (action === 'update') {
      const id = String(form.get('id') ?? '').slice(0, 20);
      const existing = await getContact(id);
      if (!existing) {
        error = '対象が見つかりません。';
      } else {
        const data = fields(form);
        if (!data.name) {
          error = '氏名を入力してください。';
          viewId = id;
        } else {
          await saveContact({ ...existing, ...data, updatedAt: new Date().toISOString() });
          await addLog(`名刺を更新：${data.name}`);
          return Astro.redirect(`/brain/contacts/?id=${id}&msg=${encodeURIComponent('保存しました。')}`, 303);
        }
      }
    } else if (action === 'delete') {
      const id = String(form.get('id') ?? '').slice(0, 20);
      const existing = await getContact(id);
      if (existing) {
        await deleteContact(id);
        await deleteImage(existing.photoId);
        await addLog(`名刺を削除：${existing.name}`);
        return Astro.redirect(`/brain/contacts/?msg=${encodeURIComponent('削除しました。')}`, 303);
      }
      error = '対象が見つかりません。';
    }
  }
}

let contacts: Contact[] = [];
let viewing: Contact | null = null;
let related: Note[] = [];
let draft: ContactDraft | null = null;

if (auth.authed) {
  contacts = await getContacts();
  if (viewId) {
    viewing = contacts.find((c) => c.id === viewId) ?? null;
    if (viewing) related = relatedNotes(viewing, await getNotes());
  }
  const draftId = (Astro.url.searchParams.get('draft') ?? '').slice(0, 20);
  if (draftId) draft = await getDraft(draftId);
}
---
<BrainLayout title="名刺｜第二の脳" active="contacts" authed={auth.authed}>
  <h1>名刺</h1>
  <p class="bn-lede">出会った人をここに貯めておくと、ホームの横断検索や議事録との紐づけで引っ張り出せます。</p>

  {!auth.authed ? (
    <BrainLogin
      loginFailed={auth.loginFailed}
      locked={auth.locked}
      kvConfigured={isKvConfigured()}
      keyConfigured={isAdminKeyConfigured()}
    />
  ) : (
    <>
      {message && <p class="bn-done">{message}</p>}
      {error && <p class="bn-error">{error}</p>}

      {viewing ? (
        <>
          <p style="margin-top:20px"><a class="bn-link" href="/brain/contacts/">← 一覧に戻る</a></p>
          <div class="bn-card">
            <h2 style="margin-top:0">{viewing.name} の編集</h2>
            <p class="bn-muted" style="margin:0">
              登録：{formatDateTimeJa(viewing.createdAt)}／最終更新：{formatDateTimeJa(viewing.updatedAt)}
            </p>
            {viewing.photoId && (
              <p style="margin:14px 0 0">
                <a href={`/brain/img/${viewing.photoId}`} target="_blank" rel="noopener">
                  <img src={`/brain/img/${viewing.photoId}`} alt="名刺写真" style="max-width:260px;max-height:200px;border-radius:10px;border:1px solid #ece5d8">
                </a>
              </p>
            )}
            <form method="post">
              <input type="hidden" name="action" value="update">
              <input type="hidden" name="id" value={viewing.id}>
              <div class="bn-row">
                <label class="bn-field">氏名<small>必須</small>
                  <input type="text" name="name" value={viewing.name} required maxlength="100">
                </label>
                <label class="bn-field">ふりがな
                  <input type="text" name="kana" value={viewing.kana ?? ''} maxlength="100">
                </label>
              </div>
              <div class="bn-row">
                <label class="bn-field">会社名
                  <input type="text" name="company" value={viewing.company ?? ''} maxlength="120">
                </label>
                <label class="bn-field">部署・役職
                  <input type="text" name="role" value={viewing.role ?? ''} maxlength="120">
                </label>
              </div>
              <div class="bn-row">
                <label class="bn-field">メール
                  <input type="email" name="email" value={viewing.email ?? ''} maxlength="254">
                </label>
                <label class="bn-field">電話
                  <input type="tel" name="phone" value={viewing.phone ?? ''} maxlength="40">
                </label>
              </div>
              <label class="bn-field">タグ<small>カンマ区切り（例：クライアント,謎解き,展示会）</small>
                <input type="text" name="tags" value={viewing.tags ?? ''} maxlength="200">
              </label>
              <label class="bn-field">出会った場所・きっかけ
                <input type="text" name="met" value={viewing.met ?? ''} maxlength="200">
              </label>
              <label class="bn-field">メモ
                <textarea name="memo" rows="5" maxlength="4000">{viewing.memo ?? ''}</textarea>
              </label>
              <button class="bn-btn" type="submit">保存する</button>
            </form>
            <form method="post" style="margin-top:14px;text-align:right" onsubmit="return confirm('この名刺を削除します。よろしいですか？')">
              <input type="hidden" name="action" value="delete">
              <input type="hidden" name="id" value={viewing.id}>
              <button class="bn-del" type="submit">この名刺を削除する</button>
            </form>
          </div>

          <div class="bn-card">
            <h2 style="margin-top:0">{viewing.photoId ? '名刺写真を差し替える' : '名刺写真を追加する'}</h2>
            <form method="post">
              <input type="hidden" name="action" value="setphoto">
              <input type="hidden" name="id" value={viewing.id}>
              <BrainPhotoInput name="photo" label="名刺の写真" help="スマホならその場で撮影できます" />
              <button class="bn-btn small" type="submit" style="margin-top:14px">写真を保存する</button>
            </form>
          </div>

          <div class="bn-card">
            <h2 style="margin-top:0">関連する議事録・メモ（{related.length}件）</h2>
            {related.length === 0 ? (
              <p class="bn-muted">この人の名前が出てくる記録はまだありません。議事録の「関係者」欄に氏名を書くとここに並びます。</p>
            ) : (
              <table class="bn-table">
                <tbody>
                  {related.map((n) => (
                    <tr>
                      <td style="white-space:nowrap">{formatDateJa(n.date)}</td>
                      <td><a class="bn-link" href={`/brain/notes/?id=${n.id}`}>{n.title}</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </>
      ) : (
        <>
          <div class="bn-card">
            <h2 style="margin-top:0">📷 名刺の写真から登録<span class="bn-muted" style="font-weight:400;margin-left:10px">撮るだけで項目を自動読み取り</span></h2>
            <form method="post">
              <input type="hidden" name="action" value="photo">
              <BrainPhotoInput name="photo" label="名刺の写真" help="スマホなら「写真を撮る」でその場で撮影できます" />
              <button class="bn-btn" type="submit" style="margin-top:14px">読み取って登録画面へ</button>
            </form>
            {!isVisionConfigured() && (
              <p class="bn-notice" style="margin-top:14px">自動読み取り（ANTHROPIC_API_KEY）が未設定です。写真の保存はできますが、項目は手入力になります。設定方法は docs/brain-setup.md 参照。</p>
            )}
          </div>

          <div class="bn-card" id="create">
            <h2 style="margin-top:0">{draft ? '読み取り結果の確認・登録' : '手入力で登録'}</h2>
            {draft && <p class="bn-done" style="margin-top:0">{draft.notice}</p>}
            {draft && (
              <p style="margin:0 0 6px">
                <img src={`/brain/img/${draft.photoId}`} alt="名刺写真" style="max-width:220px;max-height:170px;border-radius:10px;border:1px solid #ece5d8">
              </p>
            )}
            <form method="post">
              <input type="hidden" name="action" value="create">
              {draft && <input type="hidden" name="photoId" value={draft.photoId}>}
              <div class="bn-row">
                <label class="bn-field" style="margin-top:8px">氏名<small>必須</small>
                  <input type="text" name="name" required maxlength="100" value={draft?.fields.name ?? ''}>
                </label>
                <label class="bn-field" style="margin-top:8px">ふりがな
                  <input type="text" name="kana" maxlength="100" value={draft?.fields.kana ?? ''}>
                </label>
                <label class="bn-field" style="margin-top:8px">会社名
                  <input type="text" name="company" maxlength="120" value={draft?.fields.company ?? ''}>
                </label>
              </div>
              <div class="bn-row">
                <label class="bn-field">部署・役職
                  <input type="text" name="role" maxlength="120" value={draft?.fields.role ?? ''}>
                </label>
                <label class="bn-field">メール
                  <input type="email" name="email" maxlength="254" value={draft?.fields.email ?? ''}>
                </label>
                <label class="bn-field">電話
                  <input type="tel" name="phone" maxlength="40" value={draft?.fields.phone ?? ''}>
                </label>
              </div>
              <label class="bn-field">タグ<small>カンマ区切り</small>
                <input type="text" name="tags" maxlength="200">
              </label>
              <label class="bn-field">出会った場所・きっかけ
                <input type="text" name="met" maxlength="200">
              </label>
              <label class="bn-field">メモ
                <textarea name="memo" rows="3" maxlength="4000">{draft?.fields.memo ?? ''}</textarea>
              </label>
              <button class="bn-btn" type="submit">登録する</button>
            </form>
          </div>

          <div class="bn-card">
            <h2 style="margin-top:0">名刺一覧（{contacts.length}件）</h2>
            {contacts.length === 0 ? (
              <p class="bn-muted">まだ登録がありません。</p>
            ) : (
              <table class="bn-table">
                <thead><tr><th>氏名</th><th>会社・役職</th><th>タグ</th><th>更新</th></tr></thead>
                <tbody>
                  {contacts.map((c) => (
                    <tr>
                      <td><a class="bn-link" href={`/brain/contacts/?id=${c.id}`}>{c.name}</a></td>
                      <td>{[c.company, c.role].filter(Boolean).join('／') || '—'}</td>
                      <td>{(c.tags ?? '').split(',').map((t) => t.trim()).filter(Boolean).map((t) => <span class="bn-tag">{t}</span>)}</td>
                      <td class="bn-muted" style="white-space:nowrap">{formatDateTimeJa(c.updatedAt)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </>
      )}
    </>
  )}
</BrainLayout>
