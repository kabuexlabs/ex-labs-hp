  </div>
</footer>

<style is:global>
/* ==== トークン（ノワール×ゴールド） ==== */
:root{
  --bg:#0c0907;--bg-alt:#0f0b08;--bg-grad:#120c08;--bg-foot:#080604;
  --card:#140e09;--card2:#110c08;
  --head:#f3ead9;--ink:#ece3d3;--body1:#e2d6bf;--body2:#d0c4ac;--body3:#c8bda6;
  --cap:#9b8a6d;--cap2:#8f7f63;
  --gold-l:#e8c987;--gold:#d3ab61;--gold-d:#a3823f;
  --line:rgba(211,171,97,.16);
  --red:#6e1622;
  --paper:#f2e9d6;--paper-ink:#241a10;
}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Zen Kaku Gothic New',sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--gold);text-decoration:none;transition:color .18s,background .18s}
a:hover{color:var(--gold-l)}
img{max-width:100%}
input,select,textarea{font-family:'Zen Kaku Gothic New',sans-serif}
input:focus,select:focus,textarea:focus{outline:1px solid var(--gold-d)}
::selection{background:var(--red);color:var(--head)}
.cinzel{font-family:'Cinzel',serif}
.serif{font-family:'Shippori Mincho B1',serif}
.center{text-align:center}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes glowPulse{0%,100%{box-shadow:0 12px 40px rgba(0,0,0,.65),0 0 18px rgba(224,190,122,.35)}50%{box-shadow:0 12px 40px rgba(0,0,0,.65),0 0 42px rgba(240,217,164,.75)}}
@keyframes sheen{0%{transform:translateX(-130%) skewX(-20deg)}55%,100%{transform:translateX(230%) skewX(-20deg)}}
.sec-label{margin:0;font-size:13px;letter-spacing:.4em;color:#c2a468}
.sec-title{margin:10px 0 0;font-size:clamp(28px,3.4vw,38px);font-weight:700;letter-spacing:.18em;color:var(--head)}
section[id],header[id]{scroll-margin-top:64px}

/* ==== 固定ナビ ==== */
.topnav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(16px,3vw,40px);height:64px;background:rgba(10,7,5,.82);backdrop-filter:blur(10px);border-bottom:1px solid rgba(211,171,97,.22)}
.brand{display:flex;align-items:baseline;gap:10px;color:var(--ink)}
.brand-en{font-weight:700;font-size:15px;letter-spacing:.14em;color:#e8dcc4}
.brand-ja{font-size:11px;letter-spacing:.2em;color:var(--cap)}
.topnav-right{display:flex;align-items:center;gap:clamp(10px,1.6vw,24px)}
.topnav-links{display:flex;align-items:center;gap:clamp(10px,1.6vw,24px)}
.topnav-links a{font-size:12px;letter-spacing:.16em;color:var(--body3)}
.topnav-links a:hover{color:var(--gold-l)}
.topnav-ticket{font-size:13px;font-weight:600;letter-spacing:.24em;color:var(--gold-l);border:1px solid rgba(211,171,97,.6);padding:9px 20px;border-radius:2px;background:rgba(211,171,97,.08);white-space:nowrap;flex-shrink:0}
.topnav-ticket:hover{background:rgba(211,171,97,.18);color:var(--gold-l)}

/* ==== 右下固定CTA（光るアニメーション必須） ==== */
.fab{position:fixed;right:clamp(12px,2.5vw,28px);bottom:clamp(12px,2.5vw,28px);z-index:110;font-size:15px;font-weight:700;letter-spacing:.26em;color:#1a1208;border:1px solid #f0d9a4;padding:17px 34px 17px 38px;background:linear-gradient(165deg,#f0d9a4,#d3ab61 55%,#b98f45);animation:glowPulse 2.6s ease-in-out infinite;overflow:hidden}
.fab:hover{filter:brightness(1.1);color:#1a1208}
.fab-sheen{position:absolute;top:0;bottom:0;left:0;width:45%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);animation:sheen 3.4s ease-in-out infinite;pointer-events:none}

/* ==== ゴールド枠CTA ==== */
.btn-gold{display:inline-block;font-size:15px;font-weight:600;letter-spacing:.3em;color:var(--gold-l);border:1px solid rgba(211,171,97,.65);padding:16px 48px 16px 52px;background:linear-gradient(180deg,rgba(211,171,97,.14),rgba(211,171,97,.04));box-shadow:0 8px 30px rgba(0,0,0,.5);transition:background .18s,color .18s}
.btn-gold:hover{background:rgba(211,171,97,.22);color:var(--head)}

/* ==== Hero ==== */
.hero{position:relative;overflow:hidden;background:var(--bg)}
.hero-bg{position:absolute;inset:0;background-image:url('/assets/kaitou/kv.webp');background-size:cover;background-position:center 30%;filter:blur(22px) brightness(.32) saturate(.9);transform:scale(1.1)}
.hero-vignette{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%,rgba(12,9,7,.1),rgba(12,9,7,.92) 78%)}
.hero-inner{position:relative;max-width:1180px;margin:0 auto;padding:140px clamp(20px,4vw,48px) 96px;display:flex;flex-wrap:wrap;align-items:center;gap:clamp(32px,5vw,72px);justify-content:center}
.hero-copy{flex:1 1 420px;min-width:min(320px,100%);max-width:560px;animation:fadeUp .9s ease both}
.hero-logo{width:min(300px,64%);height:auto;display:block;margin-bottom:28px}
.hero-presents{margin:0 0 14px;font-size:13px;letter-spacing:.34em;color:#c2a468}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.hero-genre{margin-top:30px;display:inline-flex;align-items:center;gap:14px;border-top:1px solid rgba(211,171,97,.4);border-bottom:1px solid rgba(211,171,97,.4);padding:12px 4px}
.hero-genre span{font-size:clamp(15px,1.7vw,19px);letter-spacing:.14em;color:#e6d7ba}
.hero-meta{margin-top:26px;display:flex;flex-wrap:wrap;gap:12px 28px}
.hm-label{font-size:11px;letter-spacing:.26em;color:var(--cap)}
.hm-value{font-size:19px;letter-spacing:.1em;color:#f0e6d2;margin-top:4px}
.hero-copy .btn-gold{margin-top:36px}
.hero-poster{flex:0 1 360px;min-width:280px;margin:0;animation:fadeUp .9s .15s ease both}
.hero-poster img{width:100%;height:auto;display:block;border:1px solid rgba(211,171,97,.45);box-shadow:0 24px 70px rgba(0,0,0,.65)}

/* ==== NEWS ==== */
.news{background:var(--bg-alt);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.news-inner{max-width:920px;margin:0 auto;padding:40px clamp(20px,4vw,48px);display:flex;flex-wrap:wrap;gap:20px 48px;align-items:flex-start}
.news-h{margin:0;font-size:18px;letter-spacing:.3em;color:var(--gold);flex:0 0 auto;font-weight:600}
.news-list{list-style:none;margin:0;padding:0;flex:1 1 480px;display:grid;gap:12px}
.news-list li{display:flex;gap:20px;align-items:baseline;border-bottom:1px solid rgba(236,227,211,.08);padding-bottom:12px}
.news-date{font-size:12px;letter-spacing:.1em;color:var(--cap);flex:0 0 auto}
.news-text{font-size:14px;color:#d9cdb6}

/* ==== STORY ==== */
.story{position:relative;background:linear-gradient(180deg,#0c0907,#120c08 40%,#0c0907);overflow:hidden}
.story-inner{max-width:860px;margin:0 auto;padding:110px clamp(20px,4vw,48px) 120px;text-align:center}
.story-inner .sec-title{margin-bottom:60px}
.story-p{margin:0;font-size:clamp(16px,1.9vw,19px);line-height:2.4;letter-spacing:.08em;color:var(--body1)}
.story-close{margin:48px 0 0;font-size:clamp(19px,2.3vw,24px);font-weight:700;line-height:2.2;letter-spacing:.12em;color:var(--head)}
.letter{margin:64px auto;max-width:440px;background:var(--paper);color:var(--paper-ink);padding:44px 36px 34px;box-shadow:0 18px 60px rgba(0,0,0,.55);transform:rotate(-1.2deg);position:relative}
.letter-frame{position:absolute;inset:8px;border:1px solid rgba(36,26,16,.28);pointer-events:none}
.letter-main{margin:0;font-size:clamp(22px,2.6vw,28px);font-weight:700;letter-spacing:.22em;line-height:1.9}
.letter-sign{margin:24px 0 0;font-size:13px;letter-spacing:.2em;text-align:right;color:#5c4a33}

/* ==== ABOUT ==== */
.about{background:var(--bg-alt);border-top:1px solid var(--line)}
.wide-inner{max-width:1120px;margin:0 auto;padding:100px clamp(20px,4vw,48px)}
.about-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:24px}
.about-card{border:1px solid rgba(211,171,97,.25);background:linear-gradient(180deg,#140e09,#100b07);padding:40px 32px}
.about-num{font-size:34px;color:var(--gold-d);letter-spacing:.1em}
.about-card h3{margin:18px 0 16px;font-size:20px;font-weight:700;letter-spacing:.08em;line-height:1.7;color:#f0e6d2}
.about-card p{margin:0;font-size:14px;line-height:2;color:var(--body3)}

/* ==== TEAM ==== */
.team{background:var(--bg)}
.team-inner{max-width:1020px;margin:0 auto;padding:100px clamp(20px,4vw,48px)}
.team-row{display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,56px);align-items:flex-start;justify-content:center}
.team-photo{flex:0 1 320px;min-width:260px;max-width:360px;width:100%;height:auto;border:1px solid rgba(211,171,97,.35);box-shadow:0 18px 50px rgba(0,0,0,.5)}
.team-body{flex:1 1 420px;min-width:300px}
.team-role{margin:0;font-size:12px;letter-spacing:.3em;color:var(--gold-d)}
.team-role-ja{margin:6px 0 0;font-size:13px;letter-spacing:.18em;color:var(--cap)}
.team-row2{margin-top:72px;padding-top:56px;border-top:1px solid var(--line)}
.works-label{margin:28px 0 10px;font-size:11px;letter-spacing:.22em;color:var(--gold-d)}
.works-text{margin:0;font-size:15px;line-height:2.1;letter-spacing:.06em;color:var(--body1)}
.team-name{margin:12px 0 4px;font-size:34px;font-weight:700;letter-spacing:.16em;color:var(--head)}
.team-en{margin:0 0 24px;font-size:13px;letter-spacing:.28em;color:var(--cap)}
.team-bio{margin:0;font-size:14px;line-height:2.1;color:var(--body2)}
.team-links{display:flex;gap:16px;margin-top:28px}
.team-links a{font-size:12px;letter-spacing:.18em;border:1px solid rgba(211,171,97,.5);padding:10px 22px;color:var(--gold)}
.team-links a:hover{background:rgba(211,171,97,.12);color:var(--gold)}

/* ==== CAST（uwasabanashi と同じ flex グリッド＋ふわふわ浮遊） ==== */
.castsec{background:var(--bg-alt);border-top:1px solid var(--line)}
@keyframes castfloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.cast-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:26px 20px}
.cast-card{width:calc((100% - 60px)/4);background:none;border:0;padding:0;margin:0;text-align:center;cursor:pointer;font-family:inherit;color:inherit;opacity:0;transition:opacity .8s ease;animation:castfloat 6s ease-in-out infinite}
.rv.vis .cast-card{opacity:1}
.cast-card:hover{animation-play-state:paused}
.cast-card:nth-child(1){transition-delay:.05s;animation-delay:-0s}
.cast-card:nth-child(2){transition-delay:.15s;animation-delay:-1s}
.cast-card:nth-child(3){transition-delay:.25s;animation-delay:-2s}
.cast-card:nth-child(4){transition-delay:.35s;animation-delay:-3s}
.cast-card:nth-child(5){transition-delay:.45s;animation-delay:-4s}
.cast-card:nth-child(6){transition-delay:.55s;animation-delay:-5s}
.cast-card:nth-child(7){transition-delay:.65s;animation-delay:-.5s}
.cast-card:nth-child(8){transition-delay:.75s;animation-delay:-2.5s}
.cast-card img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;object-position:top center;display:block;border:1px solid rgba(211,171,97,.28);filter:saturate(.92);transition:filter .25s}
.cast-card:hover img{filter:saturate(1.05) brightness(1.06)}
.cast-name{display:block;margin-top:12px;font-size:16px;letter-spacing:.12em;color:var(--ink)}
.cast-hint{margin:36px 0 0;font-size:12px;color:var(--cap2);text-align:center}

/* ==== キャスト詳細モーダル ==== */
.castdlg{background:var(--card);color:var(--ink);border:1px solid rgba(211,171,97,.35);padding:0;max-width:min(760px,calc(100vw - 40px));width:100%;max-height:calc(100vh - 48px);overflow:auto}
.castdlg::backdrop{background:rgba(8,6,4,.85);backdrop-filter:blur(3px)}
.dlgbody{display:grid;grid-template-columns:280px 1fr;gap:0}
.dlgimg{width:100%;height:100%;min-height:280px;object-fit:cover;object-position:top center;display:block;background:var(--card2)}
.dlginfo{padding:34px 32px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}
.dlgname{font-size:24px;font-weight:700;letter-spacing:.14em;color:var(--head);margin:0}
.dlgx{font-size:12px;letter-spacing:.12em;color:var(--cap);word-break:break-all}
.dlgx:hover{color:var(--gold-l)}
.dlgbio{font-size:14px;line-height:2.05;color:var(--body3);margin:6px 0 0}
.dlgclose{position:absolute;top:8px;right:12px;background:none;border:0;color:var(--cap);font-size:28px;line-height:1;cursor:pointer;z-index:1}
.dlgclose:hover{color:var(--head)}

/* ==== TICKET ==== */
.ticket{position:relative;background:linear-gradient(180deg,#120c08,#0c0907);border-top:1px solid var(--line)}
.ticket-inner{max-width:760px;margin:0 auto;padding:100px clamp(20px,4vw,48px);text-align:center}
.ticket-card{border:1px solid rgba(211,171,97,.4);background:var(--card);padding:clamp(32px,5vw,56px)}
.price-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
.price-cell{flex:1 1 150px;max-width:200px;border:1px solid rgba(211,171,97,.35);padding:20px 12px 22px}
.price-label{font-size:13px;letter-spacing:.16em;color:var(--gold)}
.price-value{margin-top:8px;font-size:clamp(24px,3vw,30px);font-weight:700;letter-spacing:.04em;color:var(--head)}
.price-note{margin:14px 0 0;font-size:12px;color:var(--cap)}
.ticket-type{margin:14px 0 0;font-size:14px;letter-spacing:.14em;color:var(--gold)}
.ticket-specs{margin-top:28px;display:flex;flex-wrap:wrap;justify-content:center;gap:14px 36px;border-top:1px solid rgba(211,171,97,.25);border-bottom:1px solid rgba(211,171,97,.25);padding:18px 8px}
.ts-label{font-size:10px;letter-spacing:.24em;color:var(--cap)}
.ts-value{margin-top:4px;font-size:17px;letter-spacing:.1em;color:#f0e6d2}
.bring-box{margin-top:22px;border:1px solid rgba(211,171,97,.5);background:rgba(211,171,97,.07);padding:18px 16px 20px}
.bring-items{margin-top:10px;font-size:clamp(19px,2.6vw,26px);font-weight:700;letter-spacing:.1em;color:var(--gold-l)}
.bring-items span{display:inline-block}
.ticket-sched{margin-top:22px}
.date-chips{margin-top:12px;display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.date-chips span{font-size:15px;letter-spacing:.08em;color:#e6d7ba;border:1px solid rgba(211,171,97,.45);padding:8px 16px}
.ticket-notes{margin:28px auto 0;display:grid;gap:6px;font-size:12px;line-height:1.9;color:var(--cap);text-align:left;max-width:460px}

/* ==== FLOW ==== */
.flow{background:var(--bg-alt);border-top:1px solid var(--line)}
.flow-inner{max-width:860px;margin:0 auto;padding:100px clamp(20px,4vw,48px)}
.flow-list{list-style:none;margin:0;padding:0;display:grid;gap:0}
.flow-list li{display:grid;grid-template-columns:56px 1fr;gap:24px;position:relative;padding-bottom:40px}
.flow-list li:last-child{padding-bottom:0}
.flow-rail{display:flex;flex-direction:column;align-items:center;gap:8px}
.flow-no{width:44px;height:44px;border:1px solid var(--gold-d);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:17px;color:var(--gold);background:var(--bg);flex:0 0 auto}
.flow-line{width:1px;flex:1;background:linear-gradient(180deg,rgba(163,130,63,.6),rgba(163,130,63,.15))}
.flow-list h3{margin:8px 0 10px;font-size:20px;font-weight:700;letter-spacing:.12em;color:#f0e6d2}
.flow-list p{margin:0;font-size:14px;line-height:2;color:var(--body3)}

/* ==== NOTICE ==== */
.notice{background:var(--bg);border-top:1px solid var(--line)}
.notice-list{display:grid;gap:36px}
.notice-block{border-left:1px solid rgba(211,171,97,.4);padding-left:24px}
.notice-block h3{margin:0 0 14px;font-size:18px;font-weight:700;letter-spacing:.1em;color:#e6d7ba}
.notice-block ul{margin:0;padding-left:18px;display:grid;gap:8px}
.notice-block li{font-size:13.5px;line-height:1.9;color:var(--body3)}

/* ==== ACCESS ==== */
.access{background:var(--bg-alt);border-top:1px solid var(--line)}
.access-row{display:flex;flex-wrap:wrap;gap:40px}
.access-dl{flex:1 1 380px;min-width:300px;margin:0;display:grid;gap:24px}
.access-dl dt{font-size:12px;letter-spacing:.28em;color:var(--gold-d)}
.access-dl dd{margin:8px 0 0;font-size:15px;line-height:1.9;color:var(--body1)}
.mp-addr{font-size:16px;color:#f0e6d2}
.mp-note{font-size:13px;color:var(--body3)}
.map-link{font-size:14px;letter-spacing:.06em;border-bottom:1px solid rgba(211,171,97,.5);padding-bottom:2px}
.map-frame{flex:1 1 420px;min-width:300px;border:1px solid rgba(211,171,97,.3)}
.map-frame iframe{width:100%;height:320px;border:0;display:block;filter:grayscale(.5) contrast(.95)}

/* ==== FAQ ==== */
.faqsec{background:var(--bg);border-top:1px solid var(--line)}
.faq-inner{max-width:820px;margin:0 auto;padding:100px clamp(20px,4vw,48px)}
.faq-list{display:grid;gap:14px}
.faq-item{border:1px solid rgba(211,171,97,.25);background:var(--card2)}
.faq-q{all:unset;box-sizing:border-box;display:flex;gap:16px;align-items:baseline;width:100%;padding:20px 22px;cursor:pointer;transition:background .18s}
.faq-q:hover{background:rgba(211,171,97,.06)}
.fq-mark{font-size:16px;color:var(--gold-d)}
.fq-text{flex:1;font-size:15px;font-weight:500;letter-spacing:.04em;color:var(--ink);line-height:1.7}
.fq-toggle{font-family:monospace;font-size:16px;color:var(--gold-d)}
.faq-a{display:flex;gap:16px;padding:0 22px 22px;border-top:1px solid rgba(211,171,97,.14)}
.fa-mark{font-size:16px;color:var(--red);padding-top:16px}
.faq-a p{margin:16px 0 0;font-size:14px;line-height:2;color:var(--body3)}

/* ==== CONTACT ==== */
.contactsec{background:var(--bg-alt);border-top:1px solid var(--line)}
.contact-inner{max-width:640px;margin:0 auto;padding:100px clamp(20px,4vw,48px)}
.contact-lead{margin:0 0 48px;font-size:14px;line-height:2;color:var(--body3);text-align:center}
.cform{display:grid;gap:24px}
.cform label{display:grid;gap:8px}
.cform label>span{font-size:13px;letter-spacing:.1em;color:var(--body2)}
.req{font-size:10px;letter-spacing:.12em;color:var(--gold-l);border:1px solid rgba(211,171,97,.5);padding:2px 7px;margin-left:8px;vertical-align:1px}
.cform input,.cform select,.cform textarea{background:var(--card);border:1px solid rgba(211,171,97,.3);color:var(--ink);padding:13px 14px;font-size:14px}
.cform textarea{resize:vertical}
.form-err{margin:0;font-size:13px;line-height:1.9;color:#e0704f;border:1px solid rgba(224,112,79,.5);padding:12px 16px}
.form-err a{color:#e0704f;border-bottom:1px solid #e0704f}
.form-submit{all:unset;box-sizing:border-box;text-align:center;font-size:14px;font-weight:700;letter-spacing:.24em;color:#120d08;background:linear-gradient(160deg,#e2bf7a,#b98f45);padding:16px;cursor:pointer;border-radius:2px;transition:filter .18s}
.form-submit:hover{filter:brightness(1.08)}
.form-submit:disabled{opacity:.55;cursor:wait}
.form-note{margin:0;font-size:12px;line-height:1.9;color:var(--cap2);text-align:center}
.sent-box{border:1px solid rgba(211,171,97,.35);background:var(--card);padding:48px 32px;text-align:center}
.sent-box p{margin:0;font-size:14px;line-height:2.2;color:var(--body1)}
.sent-back{all:unset;box-sizing:border-box;margin-top:28px;font-size:13px;letter-spacing:.14em;color:var(--gold);border:1px solid rgba(211,171,97,.5);padding:11px 26px;cursor:pointer;transition:background .18s}
.sent-back:hover{background:rgba(211,171,97,.1)}

/* ==== フッター ==== */
.foot{background:var(--bg-foot);border-top:1px solid rgba(211,171,97,.22)}
.foot-inner{max-width:1020px;margin:0 auto;padding:72px clamp(20px,4vw,48px) 40px;text-align:center}
.foot-cta{font-size:14px;padding:15px 44px 15px 48px}
.foot-logo{width:200px;height:auto;display:block;margin:56px auto 8px}
.foot-credits{font-size:13px;line-height:2.2;color:var(--cap);margin-top:24px}
.foot-copy{margin:40px 0 0;font-size:11px;letter-spacing:.18em;color:#6b5d47}

/* ==== スクロールリビール（uwasabanashi と同じ控えめなフェードアップ） ==== */
.rv{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease}
.rv.vis{opacity:1;transform:none}

/* 和文見出し・質問文は文節単位で折り返す（対応ブラウザのみ） */
.sec-title,.about-card h3,.flow-list h3,.notice-block h3,.fq-text{word-break:auto-phrase}

/* ==== レスポンシブ ==== */
@media (max-width:820px){
  /* ヘッダーは uwasabanashi と同じく折返しレイアウトに。
     ブランドを中央1行目に置き、その下にリンクを小さく並べる。 */
  .topnav{flex-wrap:wrap;height:auto;padding:10px 12px 12px;gap:8px 14px;justify-content:center}
  .brand{order:-1;flex-basis:100%;justify-content:center}
  .brand-en{font-size:13px}
  .brand-ja{white-space:nowrap}
  .topnav-right{flex-wrap:wrap;justify-content:center;gap:8px 12px}
  .topnav-links{flex-wrap:wrap;justify-content:center;gap:6px 12px}
  .topnav-links a{font-size:11px;letter-spacing:.1em}
  /* ヘッダー内のチケットボタンは非表示（右下の固定CTAが常時ある） */
  .topnav-ticket{display:none}
  section[id],header[id]{scroll-margin-top:104px}

  /* ヒーローは中央揃えの1カラム。KVポスターを最上部に置き、
     KV内に含まれるロゴ・題字と重複する透過ロゴは非表示にする */
  #heroinner{padding-top:116px;padding-bottom:64px;gap:28px}
  .hero-copy{text-align:center}
  .hero-logo{display:none}
  .hero-meta{justify-content:center}
  .hero-poster{order:-1;flex:0 1 auto;min-width:0;width:min(320px,82%);margin:0 auto}

  /* キャストは uwasabanashi と同じ3列 */
  .cast-grid{gap:16px 10px}
  .cast-card{width:calc((100% - 20px)/3)}
  .cast-name{font-size:11.5px;letter-spacing:.06em}

  /* セクションの余白リズムを詰める */
  .wide-inner,.team-inner,.flow-inner,.faq-inner,.contact-inner,.ticket-inner{padding-top:72px;padding-bottom:72px}
  .story-inner{padding-top:80px;padding-bottom:88px}

  .fab{right:14px;bottom:14px;padding:13px 22px;font-size:13px;letter-spacing:.18em}
  .dlgbody{grid-template-columns:1fr}
  .dlgimg{min-height:0;height:300px}
  .dlginfo{padding:24px 22px 30px}
}
@media (max-width:600px){
  /* 指定の改行位置がそのまま収まるよう、字間とサイズを詰める
     （uwasabanashi と同じ対処） */
  .story-p{font-size:14px;letter-spacing:.04em}
  .story-close{font-size:17px;letter-spacing:.08em}
  .letter{padding:36px 24px 28px}
}
@media (max-width:380px){
  .story-p{font-size:13px;letter-spacing:.02em}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .hero-copy,.hero-poster{animation:none}
  .fab{animation:none}
  .fab-sheen{animation:none;display:none}
  .rv{opacity:1;transform:none;transition:none}
  .cast-card{opacity:1;animation:none;transition:none}
}
</style>

<script is:inline>
(function () {
  // スクロールリビール（uwasabanashi と同じ実装）。
  var els = document.querySelectorAll('.rv');
  if (els.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('vis'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('vis');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0 }); // 縦長要素で発火しない問題を避けるため割合しきい値は使わない
      els.forEach(function (el) { io.observe(el); });
    }
  }

  // チケット購入（販売ページ準備中のためダミー。URL 確定後は
  // frontmatter の ticketUrl に入れるだけで実リンクに切り替わる）
  var ticket = document.querySelector('[data-ticket]');
  if (ticket) {
    ticket.addEventListener('click', function (e) {
      e.preventDefault();
      alert('チケット販売ページは準備中です');
    });
  }

  // FAQ アコーディオン（1つだけ開く挙動）
  var faqBtns = document.querySelectorAll('.faq-q');
  function closeFaq(btn) {
    btn.setAttribute('aria-expanded', 'false');
    btn.querySelector('.fq-toggle').textContent = '+';
    btn.parentElement.querySelector('.faq-a').hidden = true;
  }
  faqBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var wasOpen = btn.getAttribute('aria-expanded') === 'true';
      faqBtns.forEach(closeFaq);
      if (!wasOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.querySelector('.fq-toggle').textContent = '−';
        btn.parentElement.querySelector('.faq-a').hidden = false;
      }
    });
  });

  // お問い合わせフォーム。自前エンドポイント /api/contact に AJAX 送信し、
  // 成功したらデザイン通りの完了表示に切り替える。JS 無効時は通常 POST
  // （_next で本ページへ戻る）。
  var form = document.getElementById('cform');
  var sent = document.getElementById('sentbox');
  var back = document.getElementById('sentback');
  var err = document.getElementById('formerr');
  if (form && sent) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (err) err.hidden = true;
      var btn = form.querySelector('.form-submit');
      if (btn) { btn.disabled = true; btn.textContent = '送信中…'; }
      fetch(form.action, { method: 'POST', body: new FormData(form), redirect: 'follow' })
        .then(function (res) {
          if (!res.ok) throw new Error('contact ' + res.status);
          form.hidden = true;
          sent.hidden = false;
        })
        .catch(function () {
          if (err) err.hidden = false;
        })
        .finally(function () {
          if (btn) { btn.disabled = false; btn.textContent = '送信する'; }
        });
    });
  }
  if (back && form && sent) {
    back.addEventListener('click', function () {
      sent.hidden = true;
      form.hidden = false;
      form.reset();
    });
  }
})();
</script>

<script is:inline define:vars={{ cast }}>
(function () {
  // キャストカードのクリックで、プロフィールをモーダル表示する。
  var dlg = document.getElementById('castdlg');
  if (!dlg || typeof dlg.showModal !== 'function') return;
  var img = document.getElementById('dlgimg');
  var name = document.getElementById('dlgname');
  var bio = document.getElementById('dlgbio');
  var x = document.getElementById('dlgx');
  document.querySelectorAll('.cast-card').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var c = cast[Number(btn.dataset.cast)];
      if (!c) return;
      img.src = '/assets/kaitou/cast/' + c.slug + '.jpg';
      img.alt = c.name + ' 宣材写真';
      name.textContent = c.name;
      bio.textContent = c.bio;
      x.textContent = '@' + c.x;
      x.href = 'https://x.com/' + c.x;
      dlg.showModal();
    });
  });
  dlg.querySelector('.dlgclose').addEventListener('click', function () { dlg.close(); });
  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
})();
</script>

</body>
