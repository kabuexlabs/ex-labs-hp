---
import SiteGuard from '../../components/SiteGuard.astro';
// 公演「怪盗と秘密の試験」（IMMERSIVE ILLUSION）公式サイト。
// design_handoff_kaitou の HTML リファレンス（ノワール×ゴールド）を
// Astro に移植した再構築版。文言はハンドオフの確定コピーが正。
// 検索インデックス許可済み（sitemap.xml の STATIC_PATHS にも掲載）。
// コーポレートサイトとはデザイン系統が別物なので BaseLayout は
// 使わず、このファイルだけで完結させている。

const title = '【公式】怪盗と秘密の試験 | イマーシブイリュージョン';
const description =
  'イマーシブ×マジック公演「怪盗と秘密の試験」公式サイト。義賊組織「レイヴン怪盗団」からの招待状を手に、会員制バーで団員候補として"秘密の試験"へ挑むイマーシブ体験。日本一・世界7位のプロマジシャン・才藤大芽が監修・出演。2026年9月〜10月、東京・六本木にて開催。';
const canonical = 'https://kabuexlabs.com/kaitou/';
const ogImage = 'https://kabuexlabs.com/assets/kaitou/kv.webp';

// チケット販売ページのURL。
const ticketUrl = 'https://escape.id/ImmersiveIllusion-org/e-kaitou/';

const navItems = ['story', 'about', 'team', 'cast', 'ticket', 'flow', 'access', 'faq', 'contact']
  .map((s) => ({ label: s.toUpperCase(), href: '#' + s }));

const news = [
  { date: '2026.07.22', text: '出演者情報を公開しました' },
  { date: '2026.07.11', text: '出演マジシャンに才藤大芽の出演が決定しました' },
  { date: '2026.07.11', text: 'ティザーサイトを公開しました' },
];

const aboutItems = [
  { num: '01', title: '「会員制バー」が物語の舞台。', body: '舞台は、通常は会員しか足を踏み入れることのできない会員制バー。限られた人だけが扉を開くことを許される、非日常的で秘密めいた空間そのものが、レイヴン怪盗団の物語を構成する一部となります。' },
  { num: '02', title: 'あなた自身が“怪盗候補”に。', body: '物語を外から観るだけではありません。あなたはレイヴン怪盗団の団員候補となり、登場人物と実際に会話しながら秘密の試験へ挑戦します。仲間との協力、駆け引き、そして自らの選択が、あなただけの体験を形づくります。' },
  { num: '03', title: '日本一・世界7位の本格イリュージョン。', body: 'イリュージョンを監修・実演するのは、プロマジシャン・才藤大芽。世界大会で評価された技術と、至近距離だからこそ味わえる驚きを、イマーシブストーリーの中で目の前で体感していただきます。' },
];

// 出演者（才藤大芽は TEAM セクションで別掲）。bio と X はプロフィール
// モーダルで表示する。
const cast = [
  { slug: 'shiera', name: 'しえら', x: 'shierrrrrrra', bio: 'ダンサー、アクターなどをメインに活動しています。たまに歌って踊ったりもします。' },
  { slug: 'ono-ai', name: '大野愛', x: 'madoka145', bio: '舞台やイマーシブシアターを中心に、俳優・ダンサーとして活動中。マーダーミステリーのGMとしての経験も重ね、エンターテイメントの現場で幅広く活躍している。' },
  { slug: 'sugita-maho', name: '杉田真帆', x: 'Maho__0407', bio: '舞台役者、フリーランスで都内で活動中。' },
  { slug: 'kanade-waon', name: '花奏和音', x: 'waonnu', bio: '山形県出身。東北芸術工科大学デザイン工学部卒。18歳から地元劇団で芝居を学び、2020年より東京での活動を開始。小劇場やテーマパークを中心に、現在イマーシブシアター・体験型コンテンツに多く出演中。' },
  { slug: 'mayuri', name: 'まゆり（楯真由子）', x: 'MayuliG_G6', bio: '出てくる度、物騒な事件を起こしがちなお姉さんです。今日はどんな風に君たちを可愛がろうかな。なんてね。' },
  { slug: 'sasano-ami', name: '佐々野愛美', x: 'Ami_Sasano', bio: '俳優、タレント、モデルなどマルチに活動中。現在はイマーシブシアターを中心に活動しており、マダミスや謎解きなど体験型コンテンツが大好き。' },
  { slug: 'miyasaka-rino', name: '宮坂莉乃', x: 'MiyasakaRino', bio: '長野県出身。2020年、舞台を中心に活動を開始。近年はイマーシブ作品に出演する。趣味はマーダーミステリー、人狼ゲーム、シナリオ制作。' },
  { slug: 'kameda-risa', name: '亀田理紗', x: 'kame_yuto', bio: '俳優・MC。謎解きゲームやイマーシブシアターなど、体験型エンターテインメントを中心に活動。芝居歴18年、キャスト歴12年。演技と進行を通して、物語への没入感を支えることを得意としている。' },
];

// 開催日チップ。曜日は2026年カレンダーで検証済み。
const dates = ['9/6（日）', '9/13（日）', '9/26（土）', '9/27（日）', '10/3（土）', '10/4（日）', '10/11（日）'];

// 参加費用（グループごとの合計金額・税込）。
const prices = [
  { label: '2人参加', price: '¥13,000' },
  { label: '3人参加', price: '¥16,500' },
  { label: '4人参加', price: '¥19,600' },
];

const flowSteps = [
  { title: '受付', body: '指定された受付場所へ、チケットに記載された受付時間までにお越しください。受付時にチケットを確認いたします。会員制バーという会場の性質上、受付時間より前に店内へ入ることはできません。スタッフの案内があるまで、指定された場所でお待ちください。' },
  { title: '事前説明', body: 'イベントへの参加方法や注意事項について、スタッフからご案内します。' },
  { title: '会員制バーへの入場', body: 'スタッフの案内に従い、秘密の試験会場となる会員制バーへ入場していただきます。扉を開けた瞬間から、皆様は「レイヴン怪盗団」の団員候補です。' },
  { title: '秘密の試験へ', body: '登場人物との会話や仲間との協力、さまざまな試練を通して、怪盗としての資質を示してください。試験の中では、才藤大芽氏による本格的なイリュージョンも目の前で繰り広げられます。' },
];

const notices = [
  { title: 'キャンセル・日時変更について', items: ['チケット購入後のお客様都合によるキャンセル、払い戻しおよび日時変更は、システムの都合上お受けできません。', 'ご購入前に、参加日時や枚数を十分にご確認ください。'] },
  { title: 'イベント参加について', items: ['本イベントは、参加者自身が物語の登場人物となって楽しむ体験型イベントです。', '各回2〜4名様でのご参加となります。お1人でのお申し込みはできません。', 'イベント中、キャストとの会話や参加者同士で協力する場面があります。', '受付時間に遅れた場合、演出および進行の都合上、ご参加いただけません。', '18歳以上の方を対象としたイベントです。', '日本語で進行するイベントです。', '飲酒により正常な判断や行動が難しいとスタッフが判断した場合、参加をお断りします。', 'スタッフおよびキャストの指示に従っていただけない場合、イベントの途中でも退場をお願いすることがあります。その場合の返金はいたしかねます。', '本イベントはフィクションです。実在する人物、団体、事件等とは関係ありません。'] },
  { title: '写真撮影・動画撮影・録音について', items: ['主催者またはスタッフから明確な許可がある場合を除き、会場内での写真撮影、動画撮影および録音はすべて禁止です。', '撮影許可が出た場合も、指定された時間・場所・内容の範囲内でのみ撮影可能です。', 'ネタバレとなる内容や、ほかの参加者が映り込んだ写真・動画を無断で公開することは禁止です。'] },
  { title: '体験中の行為について', items: ['キャストやほかの参加者に触れる行為は禁止です。', '会場内の備品や装飾品には、スタッフまたはキャストから案内があった場合を除き、触れないでください。', 'キャストやほかの参加者に対する暴言、威圧的な行為、過度な接触は禁止です。', 'イベントの進行を妨げる行為や、ほかの参加者の体験を損なう行為はお控えください。'] },
  { title: 'ネタバレについて', items: ['イベントの内容、仕掛け、試験の詳細、物語の結末など、ネタバレとなる情報をインターネットやSNS上で公開することはお控えください。', 'これから参加される方の体験を損なわないよう、ご配慮をお願いいたします。'] },
  { title: '持ち物・手荷物について', items: ['スマートフォンを必ずお持ちください（体験の進行に使用します）。', 'イヤホンを必ずお持ちください（体験の進行に使用します）。', '徒歩での移動がありますので、水分を必ずお持ちください。', '会場にクロークはございません。', '大きな荷物を保管するスペースもございませんので、駅周辺のコインロッカーなどへお預けのうえ、できる限り身軽な状態でお越しください。', '貴重品は必ずご自身で管理してください。紛失、盗難または破損について、主催者および会場は責任を負いかねます。', 'イベント開始前に、お手洗いなどをお済ませください。'] },
];

// 検索結果のリッチリザルト用イベント構造化データ（uwasabanashi と同じ慣例）。
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'TheaterEvent',
  name: '怪盗と秘密の試験',
  alternateName: 'THE PHANTOM THIEF AND THE SECRET EXAMINATION',
  description,
  url: canonical,
  image: ogImage,
  startDate: '2026-09-06',
  endDate: '2026-10-11',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  typicalAgeRange: '18-',
  location: {
    '@type': 'Place',
    name: 'BAR とかね（会員制バー）',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '六本木4-8-5 和幸ビル B1',
      addressLocality: '港区',
      addressRegion: '東京都',
      addressCountry: 'JP',
    },
  },
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '13000',
    highPrice: '19600',
    priceCurrency: 'JPY',
    url: ticketUrl,
    availability: 'https://schema.org/InStock',
  },
  performer: [
    { '@type': 'Person', name: '才藤大芽' },
  ],
  author: [
    { '@type': 'Person', name: '木皿儀隼一' },
  ],
  organizer: {
    '@type': 'Organization',
    name: '株式会社ex Labs',
    url: 'https://kabuexlabs.com/',
  },
};

// FAQリッチリザルト用。ページ内のFAQと同一内容を機械可読で宣言する。
const faqLd = (faqList: { q: string; a: string }[]) => ({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
});

const faqs = [
  { q: '会場はどんな場所ですか？', a: '通常は会員しか入ることのできない会員制バーが舞台です。閉ざされた秘密めいた空間そのものが、物語を構成する一部となります。' },
  { q: 'マジックショーとの違いは何ですか？', a: '客席から観るショーではなく、あなた自身が団員候補として物語に参加するイマーシブ（没入型）体験です。マジックは物語の中で、目の前で繰り広げられます。' },
  { q: 'イマーシブ体験や謎解きが初めてでも楽しめますか？', a: 'はい。特別な知識や経験は必要ありません。体験中は登場人物やスタッフが必要に応じて進行をサポートしますので、はじめての方もお楽しみいただけます。' },
  { q: '1人でも参加できますか？', a: '本イベントは各回2〜4名様でのご参加となるため、お1人でのご参加はいただけません。お誘い合わせのうえ、2名様以上でお申し込みください。' },
  { q: 'お酒は飲めますか？', a: '本イベントでは、お酒の提供はございません。なお、飲酒により正常な判断や行動が難しいとスタッフが判断した場合は、ご参加をお断りすることがあります。' },
  { q: '服装の指定はありますか？', a: '特に指定はございません。会員制バーの雰囲気に合わせた服装で、物語の世界をお楽しみください。' },
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="怪盗と秘密の試験">
<meta property="og:locale" content="ja_JP">
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd(faqs))} />
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Shippori+Mincho+B1:wght@400;500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
{/* JS無効環境でもリビール対象が隠れたままにならないための保険 */}
<noscript><style>.rv{opacity:1!important;transform:none!important}.cast-card{opacity:1!important}</style></noscript>
<SiteGuard />
</head>
<body>

<nav class="topnav">
  <a class="brand" href="#top">
    <span class="brand-en cinzel">IMMERSIVE ILLUSION</span>
    <span class="brand-ja">怪盗と秘密の試験</span>
  </a>
  <div class="topnav-right">
    <div class="topnav-links" id="navlinks">
      {navItems.map((nv) => <a class="cinzel" href={nv.href}>{nv.label}</a>)}
    </div>
    <a class="topnav-ticket serif" href="#ticket">チケット</a>
  </div>
</nav>

<a class="fab serif" href={ticketUrl} target="_blank" rel="noopener"><span class="fab-sheen" aria-hidden="true"></span>チケットを購入する</a>

<main>

<header id="top" class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>
  <div class="hero-inner" id="heroinner">
    <div class="hero-copy">
      <img class="hero-logo" src="/assets/kaitou/logo.webp" alt="IMMERSIVE ILLUSION イマーシブイリュージョン" width="640" height="578" loading="eager" fetchpriority="high" decoding="async">
      <p class="hero-presents cinzel">IMMERSIVE ILLUSION PRESENTS</p>
      {/* 題字・英題はKVポスター内に含まれるためテキストでは出さない。
          h1 は検索・読み上げ用に視覚非表示で維持する。 */}
      <h1 class="sr-only">怪盗と秘密の試験</h1>
      <div class="hero-genre"><span class="serif">会員制バー × イマーシブ × マジック</span></div>
      <div class="hero-meta serif">
        <div><div class="hm-label">DATE</div><div class="hm-value">2026年9月〜10月 開催</div></div>
        <div><div class="hm-label">PLACE</div><div class="hm-value">東京・六本木</div></div>
        <div><div class="hm-label">MAGICIAN</div><div class="hm-value">出演マジシャン：才藤大芽</div></div>
      </div>
      <a class="btn-gold serif" href={ticketUrl} target="_blank" rel="noopener">チケットを購入する</a>
    </div>
    <figure class="hero-poster">
      <img src="/assets/kaitou/kv.webp" alt="怪盗と秘密の試験 キービジュアル" width="1100" height="1561" loading="eager" decoding="async">
    </figure>
  </div>
</header>

<section id="news" class="news">
  <div class="news-inner rv">
    <h2 class="news-h cinzel">NEWS</h2>
    <ul class="news-list">
      {news.map((n) => (
        <li><span class="news-date cinzel">{n.date}</span><span class="news-text">{n.text}</span></li>
      ))}
    </ul>
  </div>
</section>

<section id="story" class="story">
  <div class="story-inner rv">
    <p class="sec-label cinzel">STORY</p>
    <h2 class="sec-title serif">ストーリー</h2>
    <p class="story-p serif">ある日、あなたのもとへ一通の招待状が届く。<br>差出人は、都市伝説として語られる義賊組織<br>「レイヴン怪盗団」。</p>
    <div class="letter">
      <div class="letter-frame" aria-hidden="true"></div>
      <p class="letter-main serif">秘密の試験に<br>招待する</p>
      <p class="letter-sign serif">レイヴン怪盗団より</p>
    </div>
    <p class="story-p serif">招待状に記されていたのは、ただ一文。<br>それが何を意味するのかは、誰も知らない。</p>
    <p class="story-p serif" style="margin-top:40px">興味をひかれたあなたが指定された場所へ向かうと、<br>そこにあったのは、普段は会員しか<br>入ることのできない秘密のバー。</p>
    <p class="story-p serif" style="margin-top:64px">重い扉の向こうで、<br>あなたを待ち受けていたものとは──。</p>
    <p class="story-close serif">その扉を開けた瞬間から、<br>あなたの日常は終わりを告げる。</p>
  </div>
</section>

<section id="about" class="about">
  <div class="wide-inner rv">
    <p class="sec-label cinzel center">ABOUT</p>
    <h2 class="sec-title serif center" style="margin-bottom:64px">本公演の楽しみ方</h2>
    <div class="about-grid">
      {aboutItems.map((ab) => (
        <article class="about-card">
          <div class="about-num cinzel">{ab.num}</div>
          <h3 class="serif">{ab.title}</h3>
          <p>{ab.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="team" class="team">
  <div class="team-inner rv">
    <p class="sec-label cinzel center">TEAM</p>
    <h2 class="sec-title serif center" style="margin-bottom:64px">チーム</h2>
    <div class="team-row">
      <img class="team-photo" src="/assets/kaitou/cast/saito-taiga.jpg" alt="才藤大芽 宣材写真" width="720" height="960" loading="lazy" decoding="async">
      <div class="team-body">
        <p class="team-role cinzel">MAGICIAN / SUPERVISOR</p>
        <p class="team-role-ja serif">イリュージョン監修・出演</p>
        <h3 class="team-name serif">才藤大芽</h3>
        <p class="team-en cinzel">SAITO TAIGA</p>
        <p class="team-bio">京都大学卒業後、プロマジシャンとして活動を開始。マジック界最高峰の世界大会「FISM」に日本代表として2度選出され、2018年大会では世界7位を記録。2021年には「Japan National Championship of Magic」で優勝を果たした、日本一・世界7位の実績を持つマジシャンです。ハリウッドにあるマジック界の殿堂「マジックキャッスル」への出演歴も持ち、『ヒルナンデス！』『チコちゃんに叱られる！』『開運！なんでも鑑定団』など数々のテレビ番組にも出演。本イベントではイリュージョンを監修するだけでなく、才藤氏本人が物語の登場人物として出演し、至近距離ならではの驚きを体感していただきます。</p>
        <div class="team-links">
          <a class="cinzel" href="https://www.saitotaiga.com/" target="_blank" rel="noopener">OFFICIAL SITE</a>
          <a class="cinzel" href="https://x.com/taiga365ib" target="_blank" rel="noopener">X (TWITTER)</a>
        </div>
      </div>
    </div>
    <div class="team-row team-row2">
      <div class="team-body">
        <p class="team-role cinzel">SCRIPT / PRODUCTION</p>
        <p class="team-role-ja serif">脚本／制作</p>
        <h3 class="team-name serif">木皿儀隼一</h3>
        <p class="team-bio">有限会社ワンドローの代表取締役。体験型コンテンツクリエイター。ボードゲーム、TCGのゲームデザイン、およびマーダーミステリーや推理イベント、体験型コンテンツの制作・脚本などを担当。</p>
        <p class="works-label cinzel">MAJOR WORKS ── 代表作</p>
        <p class="works-text serif">『ニューロストレガシー』『グリモワール』<br>『あなたの原罪』『夏色漂流詩』<br>『あなたが犯人かも展』など</p>
      </div>
    </div>
  </div>
</section>

<section id="cast" class="castsec">
  <div class="wide-inner rv">
    <p class="sec-label cinzel center">CAST</p>
    <h2 class="sec-title serif center" style="margin-bottom:64px">キャスト</h2>
    <div class="cast-grid">
      {cast.map((c, i) => (
        <button class="cast-card" type="button" data-cast={i}>
          <img src={`/assets/kaitou/cast/${c.slug}.jpg`} alt={`${c.name} 宣材写真`} width="720" height="960" loading="lazy" decoding="async">
          <span class="cast-name serif">{c.name}</span>
        </button>
      ))}
    </div>
    <p class="cast-hint">※ 写真をタップするとプロフィールをご覧いただけます</p>
  </div>
</section>

<dialog class="castdlg" id="castdlg">
<button class="dlgclose" type="button" aria-label="閉じる">×</button>
<div class="dlgbody">
<img class="dlgimg" id="dlgimg" src="" alt="">
<div class="dlginfo">
<p class="dlgname serif" id="dlgname"></p>
<a class="dlgx cinzel" id="dlgx" href="#" target="_blank" rel="noopener"></a>
<p class="dlgbio" id="dlgbio"></p>
</div>
</div>
</dialog>

<section id="ticket" class="ticket">
  <div class="ticket-inner rv">
    <p class="sec-label cinzel">TICKET</p>
    <h2 class="sec-title serif" style="margin-bottom:48px">チケット情報</h2>
    <div class="ticket-card">
      <div class="price-grid">
        {prices.map((p) => (
          <div class="price-cell">
            <div class="price-label serif">{p.label}</div>
            <div class="price-value serif">{p.price}</div>
          </div>
        ))}
      </div>
      <p class="price-note">※グループごとの合計金額（税込）です</p>
      <p class="ticket-type serif">日時指定チケット制</p>
      <div class="ticket-specs">
        <div><div class="ts-label cinzel">CAPACITY</div><div class="ts-value serif">各回 2〜4名様</div></div>
        <div><div class="ts-label cinzel">DURATION</div><div class="ts-value serif">約70分</div></div>
        <div><div class="ts-label cinzel">AGE</div><div class="ts-value serif">18歳以上</div></div>
      </div>
      <div class="bring-box">
        <div class="ts-label cinzel">BRING ── 必ずお持ちください</div>
        <div class="bring-items serif"><span>スマートフォン</span> ・ <span>イヤホン</span> ・ <span>水分</span></div>
      </div>
      <div class="ticket-sched">
        <div class="ts-label cinzel">SCHEDULE</div>
        <div class="date-chips">
          {dates.map((d) => <span class="serif">{d}</span>)}
        </div>
      </div>
      {ticketUrl
        ? <a class="btn-gold serif" style="margin-top:32px" href={ticketUrl} target="_blank" rel="noopener">チケットを購入する</a>
        : <a class="btn-gold serif" style="margin-top:32px" href="#ticket" data-ticket>チケットを購入する</a>}
      <div class="ticket-notes">
        <div>※外部チケットサイト（escape.id）が開きます</div>
        <div>※購入後のお客様都合によるキャンセル・払い戻し・日時変更はお受けできません</div>
        <div>※表示価格のほか、別途手数料がかかる場合があります</div>
      </div>
    </div>
  </div>
</section>

<section id="flow" class="flow">
  <div class="flow-inner rv">
    <p class="sec-label cinzel center">FLOW</p>
    <h2 class="sec-title serif center" style="margin-bottom:64px">当日の流れ</h2>
    <ol class="flow-list">
      {flowSteps.map((f, i) => (
        <li>
          <div class="flow-rail">
            <div class="flow-no cinzel">{i + 1}</div>
            {i < flowSteps.length - 1 && <div class="flow-line" aria-hidden="true"></div>}
          </div>
          <div>
            <h3 class="serif">{f.title}</h3>
            <p>{f.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="notice" class="notice">
  <div class="flow-inner rv">
    <p class="sec-label cinzel center">NOTICE</p>
    <h2 class="sec-title serif center" style="margin-bottom:56px">注意事項</h2>
    <div class="notice-list">
      {notices.map((nt) => (
        <div class="notice-block">
          <h3 class="serif">{nt.title}</h3>
          <ul>
            {nt.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="access" class="access">
  <div class="team-inner rv">
    <p class="sec-label cinzel center">ACCESS</p>
    <h2 class="sec-title serif center" style="margin-bottom:56px">アクセス</h2>
    <div class="access-row">
      <dl class="access-dl">
        <div><dt class="cinzel">AREA</dt><dd>東京・六本木エリアの会員制バー</dd></div>
        <div><dt class="cinzel">MEETING POINT</dt><dd>集合場所はこちら<br><span class="mp-addr serif">東京都港区六本木4-8-5 和幸ビル B1<br>BAR とかね</span><br><span class="mp-note">開演時間丁度にお越しください。</span></dd></div>
        <div><dt class="cinzel">NEAREST STATION</dt><dd>東京メトロ日比谷線・都営大江戸線「六本木駅」周辺</dd></div>
        <div><dt class="cinzel">MAP</dt><dd><a class="map-link" href="https://www.google.com/maps/search/?api=1&query=BAR+とかね+東京都港区六本木4-8-5+和幸ビル" target="_blank" rel="noopener">Google Mapはこちら</a></dd></div>
      </dl>
      <div class="map-frame">
        <iframe src="https://maps.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E6%B8%AF%E5%8C%BA%E5%85%AD%E6%9C%AC%E6%9C%A84-8-5%20%E5%92%8C%E5%B9%B8%E3%83%93%E3%83%AB&t=&z=17&ie=UTF8&iwloc=B&output=embed" loading="lazy" title="六本木駅周辺の地図"></iframe>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="faqsec">
  <div class="faq-inner rv">
    <p class="sec-label cinzel center">FAQ</p>
    <h2 class="sec-title serif center" style="margin-bottom:56px">よくある質問</h2>
    <div class="faq-list">
      {faqs.map((f, i) => (
        <div class="faq-item">
          <button class="faq-q" type="button" data-faq={i} aria-expanded="false">
            <span class="fq-mark cinzel">Q</span>
            <span class="fq-text">{f.q}</span>
            <span class="fq-toggle">+</span>
          </button>
          <div class="faq-a" hidden>
            <span class="fa-mark cinzel">A</span>
            <p>{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="contact" class="contactsec">
  <div class="contact-inner rv">
    <p class="sec-label cinzel center">CONTACT</p>
    <h2 class="sec-title serif center" style="margin-bottom:24px">お問い合わせ</h2>
    <p class="contact-lead">公演に関するお問い合わせは、下記フォームよりご連絡ください。</p>
    {/* 本体サイト（トップの CONTACT）と同じ設計:
        自前 /api/contact への POST + _subject/_gotcha + _next で
        サンクスページへ遷移（JS有効時はその前に AJAX で完了表示）。 */}
    <form class="cform" id="cform" action="/api/contact" method="POST">
      <input type="hidden" name="_subject" value="【怪盗と秘密の試験】サイトからのお問い合わせ">
      <input type="hidden" name="_next" value="/kaitou/contact/thanks/">
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label><span>お名前<span class="req">必須</span></span><input type="text" name="お名前" required autocomplete="name"></label>
      <label><span>メールアドレス<span class="req">必須</span></span><input type="email" name="email" required autocomplete="email"></label>
      <label><span>件名</span>
        <select name="件名">
          <option>チケットについて</option><option>団体・貸切について</option><option>取材・掲載について</option><option>その他</option>
        </select></label>
      <label><span>お問い合わせ内容<span class="req">必須</span></span><textarea name="お問い合わせ内容" rows="6" required></textarea></label>
      <p class="form-err" id="formerr" hidden>送信に失敗しました。お手数ですが時間をおいて再度お試しいただくか、<a href="mailto:info@kabuexlabs.com">info@kabuexlabs.com</a> まで直接ご連絡ください。</p>
      <button class="form-submit" type="submit">送信する</button>
      <p class="form-note">ご入力いただいた情報は、お問い合わせへの回答のみに使用いたします。</p>
    </form>
    <div class="sent-box" id="sentbox" hidden>
      <p>内容を確認のうえ、担当者よりご連絡いたします。<br>数日経っても返信がない場合は、お手数ですが再度お問い合わせください。</p>
      <button class="sent-back" id="sentback" type="button">フォームに戻る</button>
    </div>
  </div>
</section>

</main>

<footer class="foot">
  <div class="foot-inner">
    <a class="btn-gold serif foot-cta" href={ticketUrl} target="_blank" rel="noopener">チケットを購入する</a>
