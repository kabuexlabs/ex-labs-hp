---
// 「怪盗と秘密の試験」参加者向けの限定映像ページ（/kaitou/secret/）。
// 合言葉を知っている人だけが約8分の映像を視聴できる。
//
// 合言葉は POST でのみ受け取り、以降は HttpOnly Cookie（合言葉そのもの
// ではなくハッシュ値）で認証する — URL・クエリでは絶対に受けない
// （bihin / yoyaku/admin と同じ方式）。判定はサーバ側で行うため、
// 未解錠のレスポンスに動画URLは一切含まれない。
export const prerender = false;

import { createHash } from 'node:crypto';
import SiteGuard from '../../../components/SiteGuard.astro';
import { loginAllowed, recordLoginFailure } from '../../../lib/contact';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

// 合言葉。変更するときはこの1行を書き換えてデプロイするだけでよい。
const PASSWORD = 'ネックレス';

// 本編動画（Google Drive: ED_v6.mp4 / 約8分）。
// 共有設定「リンクを知っている全員が閲覧可」の preview 埋め込みで再生する。
const VIDEO_EMBED = 'https://drive.google.com/file/d/15c8_D8JuA-7bu3YM3qoByn3RdOhGu5qQ/preview';

const COOKIE = 'kaitou_secret';
// Cookie には合言葉の SHA-256 を入れる（値が漏れても合言葉は割れない）。
const TOKEN = createHash('sha256').update(`kaitou-secret:${PASSWORD}`).digest('hex');

// 当日のスマホ入力ゆらぎを吸収する：前後空白・途中の空白を除去し、
// ひらがな入力もカタカナに寄せて比較する（英字は小文字化）。
const norm = (s: string) =>
  s
    .replace(/\s+/g, '')
    .replace(/[ぁ-ゖ]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60))
    .toLowerCase();

let authed = Astro.cookies.get(COOKIE)?.value === TOKEN;
let error = '';

if (!authed && Astro.request.method === 'POST') {
  let ip = '';
  try {
    ip = Astro.clientAddress;
  } catch {
    /* アダプタがIPを渡さない環境では制限なしで進める */
  }

  // 総当たり対策（10分間に5回まで）。KV障害時は公演を止めないため通す。
  let allowed = true;
  try {
    if (ip) allowed = await loginAllowed(ip);
  } catch {
    allowed = true;
  }

  if (!allowed) {
    error = '試行回数が上限に達しました。しばらく時間をおいてからお試しください。';
  } else {
    const form = await Astro.request.formData().catch(() => null);
    const code = String(form?.get('code') ?? '');
    if (code && norm(code) === norm(PASSWORD)) {
      Astro.cookies.set(COOKIE, TOKEN, {
        path: '/kaitou/secret/',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24, // 当日中もう一度開いても再入力不要
      });
      authed = true;
    } else {
      error = '合言葉が違います。';
      try {
        if (ip) await recordLoginFailure(ip);
      } catch {
        /* 記録に失敗しても致命ではない */
      }
    }
  }
}

const title = authed ? '秘密の映像｜怪盗と秘密の試験' : '合言葉｜怪盗と秘密の試験';
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Shippori+Mincho+B1:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap" rel="stylesheet">
<SiteGuard />
</head>
<body>

<main class="secret">
  <p class="label cinzel">CONFIDENTIAL</p>
  <h1 class="serif">{authed ? '秘密の映像' : '合言葉'}</h1>

  {authed ? (
    <div class="theater">
      <div class="screen">
        <iframe src={VIDEO_EMBED} title="秘密の映像（約8分）" allow="autoplay; fullscreen" allowfullscreen loading="eager"></iframe>
      </div>
      <p class="note">約8分の映像です。イヤホンでの視聴をおすすめします。<br>再生できない場合はページを再読み込みしてください。</p>
      <p class="back"><a href="/kaitou/">トップページへ戻る</a></p>
    </div>
  ) : (
    <div class="card">
      <p class="lead serif">この先は、選ばれた者だけが目にできる。</p>
      <p class="desc">案内された「合言葉」を入力してください。</p>
      <form method="post" class="gate">
        <input class="code" type="text" name="code" inputmode="text" autocomplete="off" autocapitalize="off" placeholder="合言葉" required>
        <button class="unlock serif" type="submit">解錠する</button>
      </form>
      {error && <p class="err" role="alert">{error}</p>}
    </div>
  )}
</main>

<style is:global>
body{margin:0;background:#0c0907;color:#ece3d3;font-family:'Zen Kaku Gothic New',sans-serif;-webkit-font-smoothing:antialiased}
a{color:#d3ab61;text-decoration:none}
a:hover{color:#e8c987}
.serif{font-family:'Shippori Mincho B1',serif}
.cinzel{font-family:'Cinzel',serif}
.secret{max-width:860px;margin:0 auto;padding:110px 20px 100px;text-align:center;min-height:70vh}
.label{margin:0;font-size:13px;letter-spacing:.4em;color:#c2a468}
h1{margin:10px 0 0;font-family:'Shippori Mincho B1',serif;font-size:clamp(26px,3.4vw,36px);font-weight:700;letter-spacing:.2em;color:#f3ead9}

/* --- 解錠前 --- */
.card{margin:52px auto 0;max-width:520px;border:1px solid rgba(211,171,97,.35);background:#140e09;padding:44px 28px 40px}
.lead{font-size:16px;letter-spacing:.14em;margin:0 0 14px;color:#f0e6d2}
.desc{font-size:13px;line-height:2;color:#c8bda6;margin:0 0 28px}
.gate{display:flex;flex-direction:column;gap:14px;max-width:340px;margin:0 auto}
.code{background:#0f0b08;border:1px solid rgba(211,171,97,.3);color:#f0e6d2;padding:13px 16px;font-size:16px;letter-spacing:.12em;text-align:center;font-family:inherit}
.code:focus{outline:none;border-color:#d3ab61}
.code::placeholder{color:#7a6f5c}
.unlock{background:linear-gradient(180deg,#e8c987,#d3ab61);color:#1a120a;border:0;padding:14px 16px;font-size:15px;font-weight:700;letter-spacing:.24em;cursor:pointer}
.unlock:hover{filter:brightness(1.06)}
.err{margin:22px 0 0;font-size:13px;color:#e08a8a;letter-spacing:.08em}

/* --- 解錠後 --- */
.theater{margin-top:44px}
.screen{position:relative;width:100%;aspect-ratio:16/9;background:#080604;border:1px solid rgba(211,171,97,.3)}
.screen iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.note{margin:22px 0 0;font-size:12.5px;line-height:2;color:#c8bda6;letter-spacing:.06em}
.back{margin-top:40px}
.back a{border-bottom:1px solid rgba(211,171,97,.5);padding-bottom:2px;letter-spacing:.1em;font-size:13px}

@media (max-width:600px){
  .secret{padding:84px 16px 80px}
  .card{padding:36px 18px 34px}
}
</style>

</body>
</html>
