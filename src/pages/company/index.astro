---
// 会社概要ページ（AIO／エンティティ対策の中核）。
// ChatGPT・Google AI・Perplexity などの AI 検索は「サイト内に事実として明記され、
// 構造化データで裏付けられ、外部（PR TIMES・日経・創業手帳等）と一致する情報」を
// 引用する。ホームの #about セクションだけでは実体（エンティティ）として弱いため、
// 会社の基本情報・沿革・実績・メディア掲載・代表を1ページに集約し、
// Organization 構造化データ（@id 付き）と FAQ で「引用しやすい形」にする。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { jsonLd } from '../../lib/microcms';
import { mediaItems } from '../../data/media';
import { pressItems } from '../../data/press';

const site = Astro.site ?? new URL('https://kabuexlabs.com');
const orgId = new URL('/#organization', site).toString();
const ceoUrl = new URL('/company/iida-yuki/', site).toString();

const faqs = [
  {
    q: '株式会社ex Labsとはどんな会社ですか？',
    a: '株式会社ex Labs（イーエックスラボ）は、イマーシブ（没入型体験）・マダミス（マーダーミステリー）・謎解き・頭脳戦など、体験型エンターテインメントの企画・制作・集客・運営を一貫して手がける東京のクリエイティブカンパニーです。2025年11月設立の東京大学発スタートアップで、商業施設・文化施設・宿泊施設などの空間や未活用時間を体験型イベントで集客資産に変える「施設活用事業」を主軸としています。',
  },
  {
    q: '株式会社ex Labsの代表は誰ですか？',
    a: '代表取締役は飯田雄貴（いいだ ゆうき）です。東京大学法学部在学中に起業し、東大生のオンライン家庭教師サービスを売却した後、株式会社ex Labsを設立しました。',
  },
  {
    q: '株式会社ex Labsの主な実績は？',
    a: '累計コンテンツ体験者数15,000人超。渋谷サクラステージ全体を舞台にした施設一体型イベント「ウワサバナシ調査委員会」（東急不動産様ほか協力、日本経済新聞に掲載）、博報堂様との紀伊國屋書店での一夜限りの体験型イベント、自社主催「ヌル・アーデン展」（広告費0円でチケット1,500枚販売）、都内4会場で全公演完売した対人頭脳戦イベント「東京都頭脳王決定戦 2026」、宿泊施設向けマーダーミステリー（新規宿泊予約20件以上獲得）などがあります。',
  },
  {
    q: '株式会社ex Labsはどこにありますか？',
    a: '東京都新宿区西新宿3-3-13 西新宿水間ビル2Fに本社があります。イベントは東京を中心に、商業施設・書店・バー・宿泊施設など全国の空間で開催しています。',
  },
  {
    q: '株式会社ex Labsに制作を依頼できますか？',
    a: 'できます。マーダーミステリー制作・イマーシブイベント制作・頭脳戦制作・施設活用イベント・謎解き研修など、法人・店舗・施設からの制作依頼を受け付けています。チケット売上に応じたレベニューシェア型（初期費用0円または格安）にも対応し、ご相談・お見積りは無料です。',
  },
  {
    q: '「ex Labs」の読み方は？',
    a: '「イーエックスラボ」と読みます。正式名称は株式会社ex Labs（英語表記：ex Labs Inc.）です。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 会社概要ページ専用の詳細 Organization（BaseLayout の共通 Organization と同じ @id で統合）
const companyLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': orgId,
  name: '株式会社ex Labs',
  legalName: '株式会社ex Labs',
  alternateName: ['ex Labs', 'イーエックスラボ', 'ex Labs Inc.'],
  url: site.toString(),
  logo: new URL('/assets/logo.png', site).toString(),
  image: new URL('/assets/share-card.png', site).toString(),
  email: 'info@kabuexlabs.com',
  foundingDate: '2025-11',
  foundingLocation: { '@type': 'Place', name: '東京都' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '西新宿3-3-13 西新宿水間ビル2F',
    addressLocality: '新宿区',
    addressRegion: '東京都',
    postalCode: '160-0023',
    addressCountry: 'JP',
  },
  founder: { '@type': 'Person', '@id': ceoUrl + '#person', name: '飯田 雄貴', jobTitle: '代表取締役', url: ceoUrl },
  employee: { '@type': 'Person', '@id': ceoUrl + '#person', name: '飯田 雄貴', jobTitle: '代表取締役' },
  description:
    'イマーシブ（没入型体験）・マダミス（マーダーミステリー）・謎解き・頭脳戦など、体験型エンターテインメントの企画・制作・集客・運営を一貫して手がける東京大学発スタートアップ。商業施設などの空間・未活用時間を体験型イベントで集客資産に変える「施設活用事業」を主軸とする。',
  slogan: 'AI時代に、人間が作る面白さを追求する',
  funder: [
    { '@type': 'Organization', name: 'Skyland Ventures' },
    { '@type': 'Organization', name: '株式会社真空管' },
  ],
  knowsAbout: [
    'イマーシブ（没入型）体験・イマーシブシアターの企画・制作',
    'マーダーミステリー（マダミス）の制作',
    '頭脳戦・交渉ゲームコンテンツの制作',
    '商業施設・観光施設・文化施設・宿泊施設の集客イベント（施設活用）',
    '謎解きイベントの企画・制作',
    '謎解き・マダミスを活用した企業研修・チームビルディング',
  ],
  sameAs: [
    'https://x.com/kabuexlabs',
    'https://note.com/kabuexlabs',
    'https://prtimes.jp/main/html/searchrlp/company_id/185770',
  ],
  subjectOf: mediaItems.filter((m) => m.url).map((m) => ({ '@type': 'NewsArticle', headline: m.title, publisher: { '@type': 'Organization', name: m.outlet }, url: m.url })),
};

const history = [
  { when: '2025年11月', what: '株式会社ex Labs 設立（東京大学発スタートアップ）。体験型エンターテインメントの企画・制作事業を開始' },
  { when: '2026年4〜5月', what: 'アート×体験レーベル「体験する美術館」第1回公演『ヌル・アーデン展』を開催。広告費0円でチケット1,500枚を販売' },
  { when: '2026年7月', what: '下北沢の街を歩く周遊型アートイマーシブ『ロスト・フレーム』を公開（プレスリリース第1弾）' },
  { when: '2026年7月', what: 'Skyland Ventures・株式会社真空管から資金調達を実施。商業施設の共有区画・未活用時間を集客資産に変える「施設活用事業」を本格展開（プレスリリース第2弾）' },
  { when: '2026年7月', what: '渋谷サクラステージでの施設一体型イベント「ウワサバナシ調査委員会」が日本経済新聞に掲載' },
  { when: '2026年', what: '対人頭脳戦イベント「東京都頭脳王決定戦 2026」を都内4会場・全10公演で開催、全公演チケット完売' },
  { when: '2026年9月', what: '「ウワサバナシ調査委員会」（渋谷サクラステージ）、「怪盗と秘密の試験」（六本木）を開催' },
];
---
<BaseLayout
  title="会社概要｜株式会社ex Labs（イーエックスラボ）- 体験型エンターテインメントの企画・制作会社"
  description="株式会社ex Labs（イーエックスラボ）の会社概要。イマーシブ・マダミス・謎解き・頭脳戦など体験型エンターテインメントの企画・制作会社。2025年11月設立の東京大学発スタートアップ、代表取締役 飯田雄貴。所在地・事業内容・沿革・実績（累計体験者15,000人超、日経掲載）・メディア掲載・資金調達をまとめています。"
  ogImage="/assets/share-card.png"
>
<script type="application/ld+json" set:html={jsonLd(companyLd)} />
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '会社概要' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap narrow">
<p class="eyebrow">COMPANY</p>
<h1 class="h2 serif">会社概要</h1>
<p class="lede"><strong>株式会社ex Labs（イーエックスラボ）</strong>は、イマーシブ（没入型体験）・マダミス（マーダーミステリー）・謎解き・頭脳戦など、<strong>体験型エンターテインメントの企画・制作・集客・運営を一貫して手がける</strong>クリエイティブカンパニーです。2025年11月設立の東京大学発スタートアップで、商業施設・文化施設・宿泊施設などの空間や未活用時間を体験型イベントで集客資産に変える<strong>「施設活用事業」</strong>を主軸としています。</p>
</div></section>

<section class="section tinted" id="profile"><div class="wrap narrow">
<p class="eyebrow">PROFILE</p><h2 class="h2 serif">基本情報</h2>
<table class="co-table">
<tbody>
<tr><th>法人名</th><td>株式会社ex Labs（読み：イーエックスラボ／英語表記：ex Labs Inc.）</td></tr>
<tr><th>代表者</th><td>代表取締役 <a href="/company/iida-yuki/" style="color:var(--accent);font-weight:700">飯田 雄貴</a></td></tr>
<tr><th>設立</th><td>2025年11月</td></tr>
<tr><th>所在地</th><td>〒160-0023 東京都新宿区西新宿3-3-13 西新宿水間ビル2F</td></tr>
<tr><th>事業内容</th><td>①自社主催による体験型イベントの企画・運営<br>②法人向け体験型コンテンツの企画・制作（マーダーミステリー・イマーシブ・頭脳戦・謎解き）<br>③体験型エンターテインメント領域における企画・知見提供<br>④体験型コンテンツを活用した社内研修プログラムの企画・提供</td></tr>
<tr><th>資金調達</th><td>2026年7月、Skyland Ventures・株式会社真空管より実施</td></tr>
<tr><th>コンセプト</th><td>「その場所だからこそ体験できる物語」／スローガン「AI時代に、人間が作る面白さを追求する」</td></tr>
<tr><th>お問い合わせ</th><td><a href="mailto:info@kabuexlabs.com" style="color:var(--accent)">info@kabuexlabs.com</a>／<a href="/#contact" style="color:var(--accent)">お問い合わせフォーム</a></td></tr>
</tbody>
</table>
</div></section>

<section class="section" id="results"><div class="wrap narrow">
<p class="eyebrow">RESULTS</p><h2 class="h2 serif">主な実績</h2>
<ul class="bullets">
<li><strong>累計コンテンツ体験者数 15,000人超</strong>（自社主催イベント・法人向け制作の合計）。</li>
<li><strong>渋谷サクラステージ「ウワサバナシ調査委員会」</strong>：東急不動産様ほかのご協力による施設一体型の都市伝説×イマーシブ×謎解き。<strong>日本経済新聞に掲載</strong>。<a href="/guide/case-uwasabanashi/" style="color:var(--accent)">制作事例 →</a></li>
<li><strong>博報堂様×紀伊國屋書店</strong>：閉店後の書店を舞台にした一夜限りの体験型イベントを実施。</li>
<li><strong>「ヌル・アーデン展」</strong>：アート×体験レーベル「体験する美術館」の第1回公演。<strong>広告費0円でチケット1,500枚</strong>を販売。</li>
<li><strong>「東京都頭脳王決定戦 2026」</strong>：都内4会場・全10公演の対人頭脳戦イベント。<strong>全公演チケット完売</strong>。本戦はセガサミーグループ様運営のTUNNEL TOKYO（大崎）で開催。</li>
<li><strong>宿泊施設向けマーダーミステリー</strong>：Thermal Climb Studio Fuji様向けの体験付きプランで<strong>新規宿泊予約20件以上</strong>を獲得。</li>
<li><strong>お取引先・ご協力企業</strong>：東急不動産、博報堂、紀伊國屋書店、Skyland Ventures、SHINKUKAN、Sally、COEN、MAISON MARC、Party、Thermal Climb Studio Fuji ほか。複数の上場企業様との取引実績があります。</li>
</ul>
</div></section>

<section class="section tinted" id="history"><div class="wrap narrow">
<p class="eyebrow">HISTORY</p><h2 class="h2 serif">沿革</h2>
<ul class="bullets">
{history.map((h) => <li><strong>{h.when}</strong>：{h.what}</li>)}
</ul>
</div></section>

<section class="section" id="labels"><div class="wrap">
<p class="eyebrow">LABELS</p><h2 class="h2 serif">展開レーベル・団体</h2>
<div class="genre-grid">
<div class="genre-cell"><span class="genre-t serif">UNLIMITED MYSTERY</span><span class="genre-d">東大マーダーミステリーサークルを母体とする推理系マダミスの制作・公演レーベル。<a href="/toudaimurder/" style="color:var(--accent)">公式サイト →</a></span></div>
<div class="genre-cell"><span class="genre-t serif">HACKTALE（ハックテイル）</span><span class="genre-d">閃き・論理・交渉で勝敗が決まる対人頭脳戦レーベル。日本唯一の頭脳戦専門制作団体。<a href="/hacktale/" style="color:var(--accent)">公式サイト →</a></span></div>
<div class="genre-cell"><span class="genre-t serif">体験する美術館</span><span class="genre-d">絵画×イマーシブ×謎解きのアート×体験レーベル。『ヌル・アーデン展』『ロスト・フレーム』。<a href="/taikenbizyutu/" style="color:var(--accent)">公式サイト →</a></span></div>
<div class="genre-cell"><span class="genre-t serif">IMMERSIVE ILLUSION</span><span class="genre-d">マジック×イマーシブの公演レーベル。『怪盗と秘密の試験』（六本木）。<a href="/kaitou/" style="color:var(--accent)">公演サイト →</a></span></div>
<div class="genre-cell"><span class="genre-t serif">ANATOR（アナター）</span><span class="genre-d">東京・神田の少人数密室型イマーシブ空間。公演とスペースレンタル。<a href="/anator/" style="color:var(--accent)">公式サイト →</a></span></div>
<div class="genre-cell"><span class="genre-t serif">myagare（舞やがれ）</span><span class="genre-d">ダンス×物語体験レーベル。『アトリエ・コペル — The Silent Marionette』ほか。</span></div>
</div>
</div></section>

<section class="section tinted" id="media"><div class="wrap narrow">
<p class="eyebrow">MEDIA &amp; PRESS</p><h2 class="h2 serif">メディア掲載・プレスリリース</h2>
<ul class="bullets">
{mediaItems.map((m) => <li><strong>{m.outlet}</strong>（{m.date}）：{m.url ? <a href={m.url} target="_blank" rel="noopener" style="color:var(--accent)">{m.title}</a> : m.title}</li>)}
{pressItems.map((p) => <li><strong>PR TIMES</strong>（{p.date}）：<a href={p.url} target="_blank" rel="noopener" style="color:var(--accent)">{p.title}</a></li>)}
</ul>
<p class="vc-line"><a href="/media/" style="color:var(--accent)">メディア掲載実績 →</a>／<a href="/press/" style="color:var(--accent)">プレスリリース一覧 →</a></p>
</div></section>

<section class="section" id="ceo"><div class="wrap narrow">
<p class="eyebrow">CEO</p><h2 class="h2 serif">代表取締役</h2>
<div class="ceo-card">
<img src="/assets/ceo.webp" alt="株式会社ex Labs 代表取締役 飯田雄貴" width="880" height="880" loading="lazy" decoding="async" />
<div>
<p class="ceo-name serif">飯田 雄貴<span class="ceo-yomi">いいだ ゆうき／株式会社ex Labs 代表取締役</span></p>
<p class="lede" style="margin:0 0 10px">東京大学法学部在学中の大学1年生のときに起業し、東大生のオンライン家庭教師サービスを売却。現在は株式会社ex Labsとバックオフィス支援の会社を経営。「面白いことに、フルベットする。」を信条に、体験型エンターテインメントの企画・制作を手がける。</p>
<p class="vc-line"><a href="/company/iida-yuki/" style="color:var(--accent)">代表プロフィール・経歴の詳細 →</a></p>
</div>
</div>
</div></section>

<section class="section tinted" id="faq"><div class="wrap">
<p class="eyebrow">FAQ</p><h2 class="h2 serif">よくある質問</h2>
<div class="faq-list">
{faqs.map((f) => (
  <div class="faq-item">
    <p class="faq-q">{f.q}</p>
    <p class="faq-a">{f.a}</p>
  </div>
))}
</div>
</div></section>

<section class="section"><div class="wrap">
<div class="cta-mini">
<p class="cta-mini-title serif">体験型イベントの制作・取材・協業のご相談はこちら</p>
<a class="btn" href="/#contact">お問い合わせ</a>
</div>
<p class="vc-line" style="margin-top:48px">関連ページ：<a href="/services/" style="color:var(--accent)">サービス一覧</a>／<a href="/guide/" style="color:var(--accent)">解説記事一覧</a>／<a href="/media/" style="color:var(--accent)">メディア掲載実績</a>／<a href="/press/" style="color:var(--accent)">プレスリリース</a></p>
</div></section>

</BaseLayout>

<style>
.wrap.narrow{max-width:820px}
.co-table{width:100%;border-collapse:collapse;background:#fff;border:1px solid rgba(51,48,43,.1);border-radius:14px;overflow:hidden;font-size:14.5px;line-height:1.9}
.co-table th,.co-table td{padding:14px 18px;text-align:left;vertical-align:top;border-bottom:1px solid rgba(51,48,43,.08)}
.co-table th{width:26%;background:#f6f4ef;font-weight:800;color:var(--ink);white-space:nowrap}
.co-table tr:last-child th,.co-table tr:last-child td{border-bottom:0}
.ceo-card{display:flex;gap:26px;align-items:flex-start;background:#fff;border:1px solid rgba(51,48,43,.1);border-radius:16px;padding:24px 28px}
.ceo-card .lede{text-align:left;text-wrap:pretty}
.ceo-card img{flex:0 0 140px;width:140px;height:140px;border-radius:50%;object-fit:cover}
.ceo-name{margin:0 0 10px;font-size:22px;font-weight:800;color:var(--ink);display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.ceo-yomi{font-size:13px;font-weight:600;color:rgba(51,48,43,.55)}
#profile,#results,#history,#labels,#media,#ceo,#faq{scroll-margin-top:88px}
@media(max-width:640px){.co-table th{width:32%;white-space:normal;padding:12px 12px}.co-table td{padding:12px 12px}.ceo-card{flex-direction:column;padding:20px 18px}.ceo-card img{width:112px;height:112px;flex-basis:auto}}
</style>
