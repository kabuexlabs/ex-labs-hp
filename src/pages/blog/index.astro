---
// ブログ・解説記事一覧（2026-09 リニューアル。デザイン元 ListPage.dc.html の blog）。
// 解説記事は src/data/guides.ts、ブログ記事は microCMS から取得（公開直後の記事も再デプロイなしで出す）。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHero from '../../components/x/ListHero.astro';
import GuideList from '../../components/x/GuideList.astro';
import SecHead from '../../components/x/SecHead.astro';
import Cls from '../../components/x/Cls.astro';
import { getPostList, isMicrocmsConfigured } from '../../lib/microcms';
import { BLOG_REDIRECTS } from '../../data/redirects';

const configured = isMicrocmsConfigured();
const { contents: rawContents } = configured ? await getPostList(0, 30) : { contents: [] };
// 解説記事へ統合（301）した記事は一覧に出さない
const posts = rawContents.filter((p) => !BLOG_REDIRECTS[p.id]).map((p) => {
  const d = new Date(p.publishedAt);
  const i = p.title.indexOf('｜');
  return { id: p.id, img: p.eyecatch?.url, date: `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`, main: i < 0 ? p.title : p.title.slice(0, i), sub: i < 0 ? '' : p.title.slice(i + 1), title: p.title };
});
---
<BaseLayout
  renewal
  title="ブログ・解説記事｜謎解き研修・マダミス・イマーシブ・施設活用 - 株式会社ex Labs"
  description="マダミス（マーダーミステリー）・イマーシブ・施設活用イベントの解説記事と、体験型エンターテインメントの実務ノウハウを制作会社の視点で発信。制作依頼の費用相場・会社の選び方・施設集客の事例まで網羅しています。"
  cutin={[['マダミス・イマーシブ・', '施設活用の'], ['基礎知識から', '制作依頼の実務まで']]}
  contact={{ title: ['体験型イベントの', 'ご相談はこちら'] }}
  footer="short"
>
<ListHero crumb="ブログ" en="Guide & Blog" ja="解説記事・ブログ" lead="マダミス・イマーシブ・施設活用の基礎知識から、制作依頼の実務まで、制作会社の視点で解説しています。" />
<section class="xb-sec"><GuideList /></section>
{posts.length > 0 && (
  <section class="xb-posts">
    <div style="max-width:1100px;margin:0 auto">
      <SecHead en="Blog" size="m" />
      <p class="x-sh-ja is-b" style="font-size:clamp(18px,2.4vw,22px)">ブログ記事</p>
      <div class="x-hscroll" style="margin-top:40px;gap:16px">
        {posts.map((b) => (
          <a href={`/blog/${b.id}/`} class="xb-post">
            {b.img ? <img src={b.img} alt="" loading="lazy" decoding="async"> : <div class="xb-noimg"></div>}
            <span class="xb-date">{b.date}</span>
            <p class="xb-t"><Cls text={b.main} emph={false} /></p>
            {b.sub && <p class="xb-sub"><Cls text={b.sub} emph={false} /></p>}
          </a>
        ))}
      </div>
    </div>
  </section>
)}
</BaseLayout>
<style>
.xb-sec{padding:0 16px 96px}
.xb-posts{padding:0 16px 120px}
.xb-post{flex:0 0 clamp(250px,70vw,300px);background:var(--x-panel);padding:12px 12px 20px;display:grid;gap:12px;align-content:start}
.xb-post img,.xb-noimg{width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;display:block;background:var(--x-blue)}
.xb-date{white-space:nowrap;font-family:var(--x-en);font-size:15px;color:var(--x-lime)}
.xb-t{margin:0;font-family:var(--x-min);font-weight:700;font-size:16px;line-height:1.6}
.xb-sub{margin:-4px 0 0;font-size:13px;line-height:1.6;color:var(--x-pale2)}
</style>
