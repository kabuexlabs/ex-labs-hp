---
// 「イマーシブ デート 東京」「イマーシブ体験 二人」「イマーシブ 二人 貸切」の受け皿。
// 東京ガイド（/guide/immersive-tokyo/）の補助ページ。「二人で申し込める」と「二人だけの貸切」を区別し、
// 二人分の総額・同じ組で行動できるか・交流・屋外移動で判断できるようにする。条件は src/data/events/ から生成。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { buildGuideRows, fmtYen } from '../../lib/tokyoGuide';
import { jsonLd } from '../../lib/microcms';
import { EXPERIENCE_DATE_PUBLISHED } from '../../data/experienceDate';

const now = new Date();
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const pageUrl = new URL('/guide/immersive-tokyo-date/', site).toString();
const rows = buildGuideRows(now).filter((r) => r.status !== 'ended');
const pair = rows.filter((r) => r.w.party.min <= 2 && (r.w.party.max === undefined || r.w.party.max >= 2));
const pairPrivate = pair.filter((r) => r.w.party.format === 'private');
const pairShared = pair.filter((r) => r.w.party.format === 'shared');
const actor = pair.filter((r) => r.w.info.actorInteraction === true);
const outdoor = pair.filter((r) => r.venue?.setting === 'mixed' || r.venue?.setting === 'outdoor');
const names = (xs: typeof rows) => xs.map((r) => r.w.title).join('、');
const latest = rows.map((r) => r.w.verified.at).sort().pop();
const latestText = rows.find((r) => r.w.verified.at === latest)?.verifiedText ?? '';
const SETTING: Record<string, string> = { indoor: '屋内で完結', outdoor: '屋外', mixed: '屋外の徒歩移動あり' };
/** 同じ組で行動できるか（公式の案内から判定。分からなければ「公式で確認」） */
const togetherText = (r: (typeof rows)[number]) => r.w.party.format === 'private' ? '同じ組で最後まで行動（貸切）' : r.w.party.text.includes('離れる') ? '同じ回に参加できるが、途中で一時的に離れる場面あり' : r.w.party.format === 'shared' ? '同じ回に参加（他の参加者も一緒）。途中の扱いは公式で確認' : '公式ページで確認';
const total2 = (r: (typeof rows)[number]) => { const t = r.totalFor(2); return t === undefined ? '2名では申込不可' : `${fmtYen(t)}`; };

const faqs = [
  { q: '二人で申し込めば、二人だけで体験できますか？', a: `${pairPrivate.length ? `${names(pairPrivate)}は申込単位で貸切なので、2名で申し込めば2名だけで体験できます。` : '2名だけで貸切にできる公演は確認できていません。'}${pairShared.length ? `${names(pairShared)}は1名ずつのチケットで、同じ回の他の参加者と一緒に体験します。` : ''}` },
  { q: '二人分の料金はいくらですか？', a: pair.map((r) => `${r.w.title}は2名で${total2(r)}（1人あたり${r.perPersonFor(2) !== undefined ? fmtYen(r.perPersonFor(2)!) : '—'}、税込、${r.w.price.feeNote}）`).join('。') + '。' },
  { q: '二人が別々の回になることはありますか？', a: `${pairShared.length ? `${names(pairShared)}は1枚ずつのチケットなので、同じ回を選んで代表者がまとめて購入するよう案内されています。` : ''}${pairPrivate.length ? `${names(pairPrivate)}は1組で申し込むため同じ回になります。` : ''}予約時に回（日付・時刻）と枚数を確認してから決済してください。` },
  { q: '服装や待ち合わせ場所はどう決めればいいですか？', a: '集合場所と受付時間は各公式ページに記載があります（下の「予定の組み方」参照）。服装・靴・持ち物は「イマーシブ体験の服装・持ち物」の記事にまとめています。' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const title = '東京のイマーシブ体験を二人で楽しむには？貸切・料金・会話量で選ぶ';
const desc = '東京のイマーシブ体験に二人・デートで参加したい人向けに、「二人で申し込める」と「二人だけの貸切」の違い、二人分の総額と1人あたり料金、同じ組で行動できるか、キャストや他の参加者との交流、屋外移動、所要時間を公演ごとの公式情報で比較。予定の組み方と予約前チェックをまとめました。';
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description: desc, inLanguage: 'ja',
  image: [new URL('/assets/guide/immersive-tokyo-date.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-09-18', dateModified: '2026-09-18', mainEntityOfPage: pageUrl,
};
---
<BaseLayout
  title="東京のイマーシブ体験を二人で楽しむには？貸切・料金・会話量で選ぶ - 株式会社ex Labs"
  description="東京のイマーシブ体験に二人・デートで参加したい人向けに、「二人で申し込める」と「二人だけの貸切」の違い、二人分の総額と1人あたり料金、同じ組で行動できるか、キャストや他の参加者との交流、屋外移動、所要時間を公演ごとの公式情報で比較。予定の組み方と予約前チェックをまとめました。"
  ogImage="/assets/guide/immersive-tokyo-date.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '東京のイマーシブ体験', href: '/guide/immersive-tokyo/' },
  { name: '二人で楽しむには' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">FOR TWO</p>
<h1 class="h2 serif"><span class="nobr">東京のイマーシブ体験を</span><span class="nobr">二人で楽しむには？</span><span class="nobr">貸切・料金・会話量で選ぶ</span></h1>
<p class="lede">イマーシブ体験とは、参加者が客席から観るのではなく、物語の当事者として空間の中で体験する没入型のイベントのことです。<strong>二人で申し込める公演でも、二人だけの貸切とは限りません。</strong>1名ずつのチケットで同じ回に入る公演では、他の参加者も一緒に体験し、途中で一時的に離れる場面がある場合もあります。このページでは、東京で開催中の公演について、二人分の総額、1人あたり料金、相席か貸切か、同じ組で行動できるか、キャストや他の参加者との交流、屋外移動、所要時間を公式情報から比較し、二人で参加するときの予定の組み方と予約前の確認点をまとめています。</p>
<div class="key-points"><p class="key-points-h">この記事の要点</p><ul>
<li>{pairPrivate.length ? `${names(pairPrivate)}は申込単位で貸切。2名で申し込めば2名だけで体験できます（料金は1組単位）。` : '2名だけで貸切にできる公演は確認できていません。'}</li>
<li>{pairShared.length ? `${names(pairShared)}は1名ずつのチケットで同じ回に参加する相席形式。同じ回を選んで代表者がまとめて購入します。` : ''}</li>
<li>二人分の総額は1組料金と1人料金で計算が違います。表では総額と1人あたりを両方載せています（税込、手数料は予約サイトで確認）。</li>
</ul></div>
</div></section>

<section class="section tinted" id="table"><div class="wrap">
<p class="eyebrow">COMPARE</p><h2 class="h2 serif">二人で参加する場合の比較</h2>
<p class="lede">各公演の公式ページで確認した条件です（最終確認 {latestText}）。2名で申し込めない公演は総額を「申込不可」と表示します。空席・残席は公式予約ページの表示が最新です。</p>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>公演</th><th>二人分の総額</th><th>1人あたり</th><th>相席・貸切</th><th>同じ組で行動できるか</th><th>交流</th><th>屋外移動</th><th>所要時間</th><th>開催日</th><th>公式</th></tr></thead><tbody>
{rows.map((r) => (
  <tr>
    <th scope="row"><span class="cmp-title">{r.w.title}</span><span class="cmp-sub">{r.venue ? `${r.venue.listName ?? r.venue.name}` : '会場は公式で確認'}</span></th>
    <td>{total2(r)}<br><span class="cmp-note">{r.w.price.unit === 'per-group' ? '1組料金' : r.w.price.unit === 'per-person' ? '1人料金×2' : '貸切総額'}。税込、{r.w.price.feeNote}</span></td>
    <td>{r.perPersonFor(2) !== undefined ? fmtYen(r.perPersonFor(2)!) : '—'}</td>
    <td>{r.formatLabel}</td>
    <td>{togetherText(r)}</td>
    <td>{r.w.info.actorInteraction === true ? 'キャストとの会話あり' : ''}{r.w.info.participation ? `${r.w.info.actorInteraction === true ? '。' : ''}${r.w.info.participation}` : '公式ページで確認'}</td>
    <td>{r.venue?.setting ? SETTING[r.venue.setting] : '公式で確認'}</td>
    <td>{r.w.duration.text}</td>
    <td>{r.datesText}</td>
    <td><a href={r.w.officialUrl} data-track="show" data-show={r.w.id} data-place="date-table" style="color:var(--accent);font-weight:700">公演内容</a>{r.ticketUrl && <><br><a href={r.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={r.w.id} data-place="date-table" style="color:var(--accent);font-weight:700">予約サイト（{r.ticketSite}）→</a></>}</td>
  </tr>
))}
</tbody></table></div>
<p class="cmp-note-p">総額は公式の料金表から計算しています（1組料金は2名分の金額、1人料金は2倍）。予約サイトの手数料は含みません。開催日は公式ページに掲載された日付（日本時間）です。</p>
</div></section>

<section class="section" id="choose"><div class="wrap narrow">
<p class="eyebrow">HOW TO CHOOSE</p><h2 class="h2 serif">二人の過ごし方で確認する条件が変わる</h2>
<ul class="bullets">
<li><strong>二人で相談しながら進めたい</strong>：「同じ組で行動できるか」を確認します。{pairPrivate.length ? `${names(pairPrivate)}は貸切で最後まで同じ組です。` : ''}{pairShared.length ? `${names(pairShared)}は同じ回に参加できますが、公式に「途中で一時的に離れる場面がある」と案内されています。` : ''}</li>
<li><strong>演者との交流を楽しみたい</strong>：「交流」の欄でキャストとの会話の有無を確認します。{actor.length ? `${names(actor)}はキャストとの会話が進行の一部です。` : '現在の公演で、キャストとの会話を公式に案内しているものは確認できていません。'}</li>
<li><strong>会話の負担を抑えたい</strong>：会話が進行の一部になる公演は避け、証言や手がかりを集めて整理する型を選びます。{rows.filter((r) => r.w.info.actorInteraction !== true).length ? `${names(rows.filter((r) => r.w.info.actorInteraction !== true))}は「${rows.filter((r) => r.w.info.actorInteraction !== true).map((r) => r.w.info.participation).join('」「')}」と案内されています。` : ''}会話量を公式に明記した公演はないため、気になる場合は主催者に確認してください。</li>
<li><strong>雨の日や歩きやすさが気になる</strong>：「屋外移動」の欄を確認します。{outdoor.length ? `${names(outdoor)}は受付後に屋外の徒歩移動があります。` : ''}{rows.filter((r) => r.venue?.setting === 'indoor').length ? `${names(rows.filter((r) => r.venue?.setting === 'indoor'))}は商業施設内で完結します。` : ''}</li>
</ul>
{EXPERIENCE_DATE_PUBLISHED && <p class="vc-line">イマーシブ以外の体験（ものづくり・展示・謎解き）も含めて比べるなら<a href="/guide/tokyo-experience-date/" style="color:var(--accent)">東京の非日常デート →</a></p>}
<p class="vc-line">一人で参加する場合の条件（1名で申し込めるか・1名だけで成立するか）は<a href="/guide/immersive-tokyo-solo/" style="color:var(--accent)">東京のイマーシブ体験に一人で参加するには →</a></p>
</div></section>

<section class="section tinted" id="plan"><div class="wrap narrow">
<p class="eyebrow">PLANNING</p><h2 class="h2 serif">移動・集合・公演時間を踏まえた予定の組み方</h2>
<p class="lede">公式ページに記載のある集合・受付の条件だけを載せています。周辺の店や前後の過ごし方は、公演によって会場が非公開の場合もあるため、ここでは提案していません。</p>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>公演</th><th>集合・受付</th><th>所要時間</th><th>移動・荷物</th><th>年齢・言語</th></tr></thead><tbody>
{rows.map((r) => (
  <tr>
    <th scope="row">{r.w.title}</th>
    <td>{(r.w.info.requirements ?? []).filter((x) => /遅れ|入場|集合/.test(x)).join('。') || '公式ページで確認'}{r.venue?.access ? `。${r.venue.access}` : ''}{r.venue?.station ? `（${r.venue.station}）` : ''}</td>
    <td>{r.w.duration.text}</td>
    <td>{r.w.info.walking ?? '—'}{(r.w.info.requirements ?? []).filter((x) => /ロッカー|クローク|持参|イヤホン|靴/.test(x)).map((x) => `。${x}`).join('')}</td>
    <td>{r.w.info.ageRule ?? '公式で確認'}／{r.w.info.language ?? '公式で確認'}</td>
  </tr>
))}
</tbody></table></div>
<p class="lede">所要時間が「チケットページで確認」の公演は、当社でも公式の所要時間を確認できていません。前後の予定は余裕を持たせてください。</p>
</div></section>

<section class="section" id="check"><div class="wrap narrow">
<p class="eyebrow">BEFORE BOOKING</p><h2 class="h2 serif">二人で予約する前のチェック</h2>
<ol class="bullets">
<li><strong>同じ回・同じ組か</strong>：1名ずつのチケットの公演は、同じ日付・時刻の回を選び、代表者がまとめて購入します。1組単位の公演は人数を2名にして申し込みます。</li>
<li><strong>途中で離れる場面の有無</strong>：{pairShared.length ? `${names(pairShared)}は公式に「途中で一時的に離れる場合がある」と案内されています。` : '各公式ページの注意事項で確認してください。'}</li>
<li><strong>集合時刻</strong>：{rows.map((r) => `${r.w.title}は${(r.w.info.requirements ?? []).find((x) => /遅れ|入場/.test(x)) ?? '公式で確認'}`).join('。')}。</li>
<li><strong>遅刻・キャンセル条件</strong>：遅刻時の扱いは上記のとおり。キャンセル・日時変更の可否は各予約サイトの規約に従います（公演によっては決済後の変更・返金不可と案内されています）。</li>
<li><strong>年齢・持ち物</strong>：年齢条件（{rows.map((r) => `${r.w.title} ${r.w.info.ageRule ?? '公式で確認'}`).join('、')}）と、スマートフォン・イヤホンなど必須の持ち物を二人とも満たしているか確認します。</li>
</ol>
</div></section>

<section class="section tinted" id="faq"><div class="wrap">
<p class="eyebrow">FAQ</p><h2 class="h2 serif">よくある質問</h2>
<div class="faq-list tag-immersive">
{faqs.map((f) => (<div class="faq-item"><p class="faq-q">{f.q}</p><p class="faq-a">{f.a}</p></div>))}
</div>
</div></section>

<section class="section"><div class="wrap">
<div class="cta-mini">
<p class="cta-mini-title serif">東京のイマーシブ公演・開催日を一覧で見る</p>
<a class="btn" href="/guide/immersive-tokyo/" data-track="show" data-show="guide-tokyo" data-place="date-cta">開催日カレンダーと比較表を見る</a>
<p class="svc-cta-sub">日付・人数・予算で絞り込むなら<a href="/events/" style="color:var(--accent)" data-track="show" data-show="events" data-place="date-cta">公演を探す</a>。服装・持ち物は<a href="/guide/immersive-preparation/" style="color:var(--accent)">イマーシブ体験の服装・持ち物</a>をご覧ください。</p>
</div>
<p class="cmp-note-p">紹介範囲：このページで扱っているのは、株式会社ex Labsが企画・制作し、公式ページで申込条件と料金を確認できた公演です。東京の全公演を網羅した比較や第三者によるランキングではありません。他社公演は、主催者の公式情報で条件を確認できたものから追加します。</p>
<p class="vc-line" style="margin-top:32px">関連ページ：<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京で体験できるイマーシブイベント</a>／<a href="/guide/immersive-tokyo-solo/" style="color:var(--accent)">一人で参加するには</a>／<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物</a>／<a href="/guide/magic-show-immersive-chigai/" style="color:var(--accent)">マジックショーとイマーシブ体験の違い</a>／<a href="/guide/immersive/" style="color:var(--accent)">イマーシブとは</a>／<a href="/events/" style="color:var(--accent)">公演を探す</a></p>
</div></section>

<AuthorBox />
<LatestPosts category="immersive" />
</BaseLayout>

<style>
.wrap.narrow{max-width:820px}
.wrap.narrow .lede{text-align:left}
.cmp-wrap{margin-top:22px}
.cmp-table th[scope=row]{min-width:150px;white-space:normal}
.cmp-table td{min-width:130px;vertical-align:top}
.cmp-title{display:block;font-weight:800;color:var(--ink)}
.cmp-sub{display:block;font-size:12px;font-weight:500;color:rgba(51,48,43,.65);margin-top:2px}
.cmp-note{display:inline-block;font-size:11.5px;font-weight:500;color:rgba(51,48,43,.65);line-height:1.6;margin-top:2px}
.cmp-note-p{max-width:920px;margin:14px auto 0;font-size:12.5px;line-height:1.8;color:rgba(51,48,43,.62);text-align:left}
ol.bullets{padding-left:1.4em}
#table,#choose,#plan,#check,#faq{scroll-margin-top:88px}
</style>
