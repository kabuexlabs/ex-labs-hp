---
// 「イマーシブ デート 東京」「イマーシブ体験 二人」「イマーシブ 二人 貸切」の受け皿。
// 東京ガイド（/guide/immersive-tokyo/）の補助ページ。最初に「2名で申し込める公演の開催日カレンダー」を出し、
// ◯の日付から予約サイトへ直行できるようにする。貸切か相席か・二人分の総額は表、説明は折りたたみに置く。
// 条件は src/data/events/ から生成し、手書きしない。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ShowCalendar from '../../components/ShowCalendar.astro';
import { buildGuideRows, fmtYen } from '../../lib/tokyoGuide';
import { shows } from '../../data/shows';
import { jsonLd } from '../../lib/microcms';
import { EXPERIENCE_DATE_PUBLISHED } from '../../data/experienceDate';

const now = new Date();
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const pageUrl = new URL('/guide/immersive-tokyo-date/', site).toString();
const rows = buildGuideRows(now).filter((r) => r.status !== 'ended');
const pair = rows.filter((r) => r.w.party.min <= 2 && (r.w.party.max === undefined || r.w.party.max >= 2));
const pairPrivate = pair.filter((r) => r.w.party.format === 'private');
const pairShared = pair.filter((r) => r.w.party.format === 'shared');
const actor = pair.filter((r) => r.w.info.actorInteraction === true);
const outdoor = pair.filter((r) => r.venue?.setting === 'mixed' || r.venue?.setting === 'outdoor');
const names = (xs: typeof rows) => xs.map((r) => r.w.title).join('、');
const latest = rows.map((r) => r.w.verified.at).sort().pop();
const latestText = rows.find((r) => r.w.verified.at === latest)?.verifiedText ?? '';
const SETTING: Record<string, string> = { indoor: '屋内で完結', outdoor: '屋外', mixed: '屋外の徒歩移動あり' };
/** 同じ組で行動できるか（公式の案内から判定。分からなければ「公式で確認」） */
const togetherText = (r: (typeof rows)[number]) => r.w.party.format === 'private' ? '最後まで同じ組（貸切）' : r.w.party.text.includes('離れる') ? '同じ回。途中で一時的に離れる場面あり' : r.w.party.format === 'shared' ? '同じ回（他の参加者も一緒）' : '公式ページで確認';
/** 2名で申し込めるかと料金が分かるかは別。人数条件外→「2名では申込不可」、料金単位未確認→「公式ページで確認」 */
const canPair = (r: (typeof rows)[number]) => r.w.party.min <= 2 && (r.w.party.max === undefined || r.w.party.max >= 2);
const total2 = (r: (typeof rows)[number]) => { if (!canPair(r)) return '2名では申込不可'; const t = r.totalFor(2); return t === undefined ? '公式ページで確認' : `${fmtYen(t)}`; };
// カレンダー：2名で申し込める公演だけ。見出し下は「2名で総額（1人あたり）｜貸切・相席｜所要時間」
const pairCal = pair.map((r) => ({ r, s: shows.find((s) => s.id === r.w.id && s.published) })).filter((x): x is { r: (typeof rows)[number]; s: NonNullable<typeof x.s> } => !!x.s);
const calMeta = (r: (typeof rows)[number]) => `${r.totalFor(2) !== undefined ? `2名で${total2(r)}（1人 ${fmtYen(r.perPersonFor(2)!)}）` : '2名分の料金は公式ページで確認'}｜${r.formatLabel}｜${r.w.duration.text}`;

const faqs = [
  { q: '二人で申し込めば、二人だけで体験できますか？', a: `${pairPrivate.length ? `${names(pairPrivate)}は申込単位で貸切なので、2名で申し込めば2名だけで体験できます。` : '2名だけで貸切にできる公演は確認できていません。'}${pairShared.length ? `${names(pairShared)}は1名ずつのチケットで、同じ回の他の参加者と一緒に体験します。` : ''}` },
  { q: '二人分の料金はいくらですか？', a: pair.map((r) => r.totalFor(2) !== undefined ? `${r.w.title}は2名で${total2(r)}（1人あたり${fmtYen(r.perPersonFor(2)!)}、税込、${r.w.price.feeNote}）` : `${r.w.title}は料金単位を確認できていないため公式チケットページで確認`).join('。') + '。' },
  { q: '二人が別々の回になることはありますか？', a: `${pairShared.length ? `${names(pairShared)}は1枚ずつのチケットなので、同じ回を選んで代表者がまとめて購入するよう案内されています。` : ''}${pairPrivate.length ? `${names(pairPrivate)}は1組で申し込むため同じ回になります。` : ''}予約時に回（日付・時刻）と枚数を確認してから決済してください。` },
  { q: '服装や待ち合わせ場所はどう決めればいいですか？', a: '集合場所と受付時間は各公式ページに記載があります（「予定の組み方」参照）。服装・靴・持ち物は「イマーシブ体験の服装・持ち物」の記事にまとめています。' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const title = '東京のイマーシブ体験を二人で楽しむには？貸切・料金・会話量で選ぶ';
const desc = '東京のイマーシブ体験に二人・デートで参加したい人向けに、「二人で申し込める」と「二人だけの貸切」の違い、二人分の総額と1人あたり料金、同じ組で行動できるか、キャストや他の参加者との交流、屋外移動、所要時間を公演ごとの公式情報で比較。予定の組み方と予約前チェックをまとめました。';
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description: desc, inLanguage: 'ja',
  image: [new URL('/assets/guide/immersive-tokyo-date.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-09-18', dateModified: '2026-09-18', mainEntityOfPage: pageUrl,
};
---
<BaseLayout
  title="東京のイマーシブ体験を二人で楽しむには？貸切・料金・会話量で選ぶ - 株式会社ex Labs"
  description="東京のイマーシブ体験に二人・デートで参加したい人向けに、「二人で申し込める」と「二人だけの貸切」の違い、二人分の総額と1人あたり料金、同じ組で行動できるか、キャストや他の参加者との交流、屋外移動、所要時間を公演ごとの公式情報で比較。予定の組み方と予約前チェックをまとめました。"
  ogImage="/assets/guide/immersive-tokyo-date.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<script is:inline>
// 折りたたみ節へのリンク（#faq 等）で開いた場合は自動で展開する
(function(){function o(){try{var h=location.hash.slice(1);if(!h)return;var el=document.getElementById(h);if(el&&el.tagName==='DETAILS'){el.open=true}}catch(e){}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',o)}else{o()}window.addEventListener('hashchange',o)})();
</script>
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '東京のイマーシブ体験', href: '/guide/immersive-tokyo/' },
  { name: '二人で楽しむには' },
]} />

<section class="section" style="padding-top:40px;padding-bottom:8px"><div class="wrap">
<p class="eyebrow">FOR TWO</p>
<h1 class="h2 serif"><span class="nobr">東京のイマーシブ体験を</span><span class="nobr">二人で楽しむには？</span><span class="nobr">貸切・料金・会話量で選ぶ</span></h1>
<p class="lede"><strong>2名で申し込める公演の開催日</strong>です。◯の日付をタップすると予約サイトで空席を確認できます。二人分の総額と、貸切か相席かは各カードと下の表で。</p>
<div class="key-points"><p class="key-points-h">要点</p><ul>
<li>イマーシブ体験とは、客席から観るのではなく物語の当事者として空間の中で体験する没入型イベントのことです。</li>
<li>{pairPrivate.length ? `${names(pairPrivate)}は申込単位で貸切（2名だけで体験）。` : '2名だけで貸切にできる公演は確認できていません。'}{pairShared.length ? `${names(pairShared)}は同じ回に入る相席。` : ''}</li>
<li>総額は1組料金と1人料金で計算が違うので、カードと表に2名分の総額と1人あたりを両方載せています。</li>
</ul></div>
</div></section>

<section class="section tinted" id="pair-cal"><div class="wrap">
<p class="eyebrow">THIS WEEK</p><h2 class="h2 serif">2名で申し込める公演の開催日</h2>
<p class="cal-legend"><span class="lg lg-open">◯</span> 開催日（タップで予約サイトへ）　<span class="lg lg-sold">×</span> 完売　<span class="lg lg-none">–</span> 開催なし　<span class="lg lg-ended">薄字</span> 終了</p>
{pairCal.length ? (
  <div class="cal-grid">{pairCal.map(({ r, s }) => <ShowCalendar show={s} place="date-cal" now={now} meta={calMeta(r)} />)}</div>
) : (
  <p class="lede">確認できた範囲で、2名で申し込める公演は現在ありません。開催中の公演は<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京ガイドのカレンダー</a>をご覧ください。</p>
)}
<p class="cmp-note-p">開催日は公式ページで確認した日付（最終確認 {latestText}）。空席は予約サイトの表示が最新です。総額は税込で、予約サイトの手数料は含みません。</p>
</div></section>

<section class="section" id="table"><div class="wrap">
<p class="eyebrow">COMPARE</p><h2 class="h2 serif">二人で参加する条件を見比べる</h2>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>公演</th><th>二人分の総額</th><th>貸切・相席</th><th>同じ組で行動</th><th>交流</th><th>屋外移動</th><th>所要時間</th><th>予約</th></tr></thead><tbody>
{rows.map((r) => (
  <tr>
    <th scope="row"><span class="cmp-title">{r.w.title}</span><span class="cmp-sub">{r.venue ? `${r.venue.listName ?? r.venue.name}` : '会場は公式で確認'}</span></th>
    <td>{total2(r)}<br><span class="cmp-note">{r.totalFor(2) !== undefined ? `1人 ${fmtYen(r.perPersonFor(2)!)}。${r.w.price.unit === 'per-group' ? '1組料金' : r.w.price.unit === 'per-person' ? '1人料金×2' : '貸切総額'}、税込` : r.w.price.text}</span></td>
    <td>{r.formatLabel}</td>
    <td>{togetherText(r)}</td>
    <td>{r.w.info.actorInteraction === true ? 'キャストとの会話あり' : ''}{r.w.info.participation ? `${r.w.info.actorInteraction === true ? '。' : ''}${r.w.info.participation}` : '公式ページで確認'}</td>
    <td>{r.venue?.setting ? SETTING[r.venue.setting] : '公式で確認'}</td>
    <td>{r.w.duration.text}</td>
    <td>{r.ticketUrl ? <a class="cmp-btn" href={r.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={r.w.id} data-place="date-table">予約サイト →</a> : <span class="cmp-note">公式で確認</span>}<br><a href={r.w.officialUrl} data-track="show" data-show={r.w.id} data-place="date-table" style="color:var(--accent);font-weight:700;font-size:12.5px">公演内容</a></td>
  </tr>
))}
</tbody></table></div>
<p class="cmp-note-p">総額は公式の料金表から計算（1組料金は2名分、1人料金は2倍。手数料は予約サイトで確認）。{EXPERIENCE_DATE_PUBLISHED && <>イマーシブ以外の体験（ものづくり・展示・謎解き）も含めて比べるなら<a href="/guide/tokyo-experience-date/" style="color:var(--accent)">東京の非日常デート</a>。</>}一人で参加する条件は<a href="/guide/immersive-tokyo-solo/" style="color:var(--accent)">一人で参加するには</a>へ。</p>
</div></section>

<section class="section tinted acc-wrap"><div class="wrap">
<p class="eyebrow">MORE</p><h2 class="h2 serif">選び方・予定の組み方・予約前チェック・よくある質問</h2>

<details class="acc" id="choose">
<summary><span class="acc-t">二人の過ごし方で確認する条件が変わる</span><span class="acc-s">相談しながら進める／演者と交流／会話を抑える／雨の日</span></summary>
<div class="acc-b">
<ul class="bullets">
<li><strong>二人で相談しながら進めたい</strong>：「同じ組で行動」を確認します。{pairPrivate.length ? `${names(pairPrivate)}は貸切で最後まで同じ組です。` : ''}{pairShared.length ? `${names(pairShared)}は同じ回に参加できますが、公式に「途中で一時的に離れる場面がある」と案内されています。` : ''}</li>
<li><strong>演者との交流を楽しみたい</strong>：{actor.length ? `${names(actor)}はキャストとの会話が進行の一部です。` : '現在の公演で、キャストとの会話を公式に案内しているものは確認できていません。'}</li>
<li><strong>会話の負担を抑えたい</strong>：会話が進行の一部になる公演は避け、証言や手がかりを集めて整理する型を選びます。{rows.filter((r) => r.w.info.actorInteraction !== true).length ? `${names(rows.filter((r) => r.w.info.actorInteraction !== true))}は「${rows.filter((r) => r.w.info.actorInteraction !== true).map((r) => r.w.info.participation).join('」「')}」と案内されています。` : ''}会話量を公式に明記した公演はないため、気になる場合は主催者に確認してください。</li>
<li><strong>雨の日や歩きやすさが気になる</strong>：{outdoor.length ? `${names(outdoor)}は受付後に屋外の徒歩移動があります。` : ''}{rows.filter((r) => r.venue?.setting === 'indoor').length ? `${names(rows.filter((r) => r.venue?.setting === 'indoor'))}は商業施設内で完結します。` : ''}</li>
</ul>
</div>
</details>

<details class="acc" id="plan">
<summary><span class="acc-t">移動・集合・公演時間を踏まえた予定の組み方</span><span class="acc-s">集合・受付／所要時間／荷物／年齢・言語（公式案内より）</span></summary>
<div class="acc-b">
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>公演</th><th>集合・受付</th><th>所要時間</th><th>移動・荷物</th><th>年齢・言語</th></tr></thead><tbody>
{rows.map((r) => (
  <tr>
    <th scope="row">{r.w.title}</th>
    <td>{(r.w.info.requirements ?? []).filter((x) => /遅れ|入場|集合/.test(x)).join('。') || '公式ページで確認'}{r.venue?.access ? `。${r.venue.access}` : ''}{r.venue?.station ? `（${r.venue.station}）` : ''}</td>
    <td>{r.w.duration.text}</td>
    <td>{r.w.info.walking ?? '—'}{(r.w.info.requirements ?? []).filter((x) => /ロッカー|クローク|持参|イヤホン|靴/.test(x)).map((x) => `。${x}`).join('')}</td>
    <td>{r.w.info.ageRule ?? '公式で確認'}／{r.w.info.language ?? '公式で確認'}</td>
  </tr>
))}
</tbody></table></div>
<p class="cmp-note-p">公式ページに記載のある集合・受付の条件だけを載せています。会場が非公開の公演もあるため、周辺の店や前後の過ごし方は提案していません。所要時間が「チケットページで確認」の公演は前後の予定に余裕を持たせてください。</p>
</div>
</details>

<details class="acc" id="check">
<summary><span class="acc-t">二人で予約する前のチェック</span><span class="acc-s">同じ回か・離れる場面・集合時刻・キャンセル・年齢と持ち物</span></summary>
<div class="acc-b">
<ol class="bullets">
<li><strong>同じ回・同じ組か</strong>：1名ずつのチケットの公演は、同じ日付・時刻の回を選び、代表者がまとめて購入します。1組単位の公演は人数を2名にして申し込みます。</li>
<li><strong>途中で離れる場面の有無</strong>：{pairShared.length ? `${names(pairShared)}は公式に「途中で一時的に離れる場合がある」と案内されています。` : '各公式ページの注意事項で確認してください。'}</li>
<li><strong>集合時刻</strong>：{rows.map((r) => `${r.w.title}は${(r.w.info.requirements ?? []).find((x) => /遅れ|入場/.test(x)) ?? '公式で確認'}`).join('。')}。</li>
<li><strong>キャンセル条件</strong>：日時変更・返金の可否は各予約サイトの規約に従います（決済後の変更・返金不可と案内されている公演があります）。</li>
<li><strong>年齢・持ち物</strong>：年齢条件（{rows.map((r) => `${r.w.title} ${r.w.info.ageRule ?? '公式で確認'}`).join('、')}）と、スマートフォン・イヤホンなど必須の持ち物を二人とも満たしているか。<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物（公演別チェック表）</a></li>
</ol>
</div>
</details>

<details class="acc" id="faq">
<summary><span class="acc-t">よくある質問</span><span class="acc-s">二人だけで体験できるか・二人分の料金・別々の回・服装</span></summary>
<div class="acc-b">
<div class="faq-list tag-immersive">
{faqs.map((f) => (<div class="faq-item"><p class="faq-q">{f.q}</p><p class="faq-a">{f.a}</p></div>))}
</div>
</div>
</details>

<p class="cmp-note-p">紹介範囲：このページで扱っているのは、公式ページで申込条件と料金を確認できた公演です（現在は株式会社ex Labsが企画・制作した公演）。東京の全公演を網羅した比較や第三者によるランキングではありません。他社公演は、主催者の公式情報で条件を確認できたものから追加します。</p>
<p class="vc-line" style="margin-top:24px">関連ページ：<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京で体験できるイマーシブイベント</a>／<a href="/guide/immersive-tokyo-solo/" style="color:var(--accent)">一人で参加するには</a>／<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物</a>／<a href="/guide/magic-show-immersive-chigai/" style="color:var(--accent)">マジックショーとイマーシブ体験の違い</a>／<a href="/guide/immersive/" style="color:var(--accent)">イマーシブとは</a>／<a href="/events/" style="color:var(--accent)" data-track="show" data-show="events" data-place="date-cta">公演を探す</a></p>
</div></section>

<AuthorBox />
<LatestPosts category="immersive" />
</BaseLayout>

<style>
#pair-cal,#table{scroll-margin-top:88px}
.cal-legend{max-width:920px;margin:14px auto 0;font-size:12.5px;line-height:2;color:rgba(51,48,43,.75);text-align:left}
.lg{display:inline-block;min-width:22px;text-align:center;font-weight:800}
.lg-open{color:#d9480f}.lg-sold{color:rgba(51,48,43,.5)}.lg-none{color:rgba(51,48,43,.4)}.lg-ended{color:rgba(51,48,43,.35)}
.cal-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),1fr));gap:22px;max-width:1000px;margin:22px auto 0}
.cmp-wrap{margin-top:22px}
.cmp-table th[scope=row]{min-width:150px;white-space:normal}
.cmp-table td{min-width:130px;vertical-align:top}
.cmp-title{display:block;font-weight:800;color:var(--ink)}
.cmp-sub{display:block;font-size:12px;font-weight:500;color:rgba(51,48,43,.65);margin-top:2px}
.cmp-note{display:inline-block;font-size:11.5px;font-weight:500;color:rgba(51,48,43,.65);line-height:1.6;margin-top:2px}
.cmp-note-p{max-width:920px;margin:14px auto 0;font-size:12.5px;line-height:1.8;color:rgba(51,48,43,.62);text-align:left}
.cmp-btn{display:inline-block;background:var(--accent);color:#fff !important;font-weight:800;font-size:12.5px;padding:8px 12px;border-radius:999px;text-decoration:none !important;white-space:nowrap;margin-bottom:6px}
.acc{max-width:920px;margin:14px auto 0;background:#fff;border:var(--bd);border-radius:var(--r-l);box-shadow:var(--shadow-1);scroll-margin-top:88px}
.acc summary{list-style:none;cursor:pointer;padding:18px 22px;display:flex;flex-direction:column;gap:3px;position:relative}
.acc summary::-webkit-details-marker{display:none}
