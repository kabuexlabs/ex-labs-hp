---
// 2026年11月の京都で過ごす人に向けた、体験する美術館「7枚目のコンポジション」の紹介記事（2026-10-22 予約促進）。
// 役割は「休日の候補として興味を持ってもらう」こと。日程・チケット・行き方の詳細は /guide/kyoto-kyocera-museum-7th/、
// 禅とジブリ展・永観堂と同じ日に回す組み立ては /guide/kyoto-okazaki-november/ に任せ、ここでは重複させない。
// 書いてよい事実は公式ページ（/taikenbizyutu/7th-composition/）と公演データ（src/data/events/）の記載だけ。参加者の行動や演出を推測で足さない。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import StickyReserve from '../../components/StickyReserve.astro';
import { jsonLd } from '../../lib/microcms';
import { jstDateString } from '../../lib/thisWeek';
import { eventsData } from '../../data/events/index';

const site = Astro.site ?? new URL('https://kabuexlabs.com');
const w = eventsData.works.find((x) => x.id === '7th-composition');
const TICKET = w?.ticketUrl ?? 'https://escape.id/kyoukaiart-org/e-7th/';
const LP = '/taikenbizyutu/7th-composition/';
const GUIDE = '/guide/kyoto-kyocera-museum-7th/';
const OKAZAKI = '/guide/kyoto-okazaki-november/';
const occ = eventsData.occurrences.filter((o) => o.workId === '7th-composition' && o.published && !o.test && o.eventStatus !== 'cancelled');
const dates = [...new Set(occ.map((o) => o.date))].sort();
const FROM = dates[0] ?? '2026-11-21';
const TO = dates[dates.length - 1] ?? '2026-11-23';
const today = jstDateString(new Date());
const phase = today > TO ? 'ended' : today >= FROM ? 'live' : 'before';
// 各回の開始・終了（公演データ。3日間共通）
const sessions = [...new Map(occ.map((o) => [o.startTime, o])).values()].sort((a, b) => a.startTime.localeCompare(b.startTime)).map((o, i) => [`第${i + 1}回`, o.startTime, o.endTime ?? ''] as const);
const toc = [
  { id: 'about', label: 'どんな体験か' },
  { id: 'diff', label: '通常の美術鑑賞との違い' },
  { id: 'info', label: '参加を決めるための情報' },
  { id: 'day', label: '休日の予定に組み込むイメージ' },
  { id: 'faq', label: 'よくある質問' },
];
const faqs = [
  { q: '初めてでも参加できますか？', a: 'はい。各回の最初に受付と事前説明があり、その後に60分の体験が始まります（受付・事前説明・退場を含めて60分）。演技の経験や予習は不要です。' },
  { q: '一人でも参加できますか？', a: '1名から参加できます。同じ回に申し込んだほかの参加者と一緒に体験し、各回の定員は最大18名です。' },
  { q: '美術館の展覧会も一緒に見られますか？', a: 'この公演のチケット（1名4,500円）に展覧会の入場は含まれません。同じ美術館の新館で開催中の「禅とジブリ」京都展は別のチケット（一般・大学生1,900円）が必要です。' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '2026年11月の京都で楽しむ物語体験「7枚目のコンポジション」',
  about: '京都市京セラ美術館で行う物語体験「7枚目のコンポジション」の紹介',
  inLanguage: 'ja',
  image: [new URL('/assets/events/7th-composition-kv.webp', site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-10-22',
  dateModified: '2026-10-22',
  mainEntityOfPage: new URL('/guide/kyoto-november-experience/', site).toString(),
};
---
<BaseLayout
  title="2026年11月の京都で楽しむ物語体験｜7枚目のコンポジション - 株式会社ex Labs"
  description="2026年11月21日〜23日、京都市京セラ美術館の本館地下1階で行う60分の物語体験「7枚目のコンポジション」。絵画を鑑賞することが物語に参加するきっかけになる体験を初めての人向けに説明し、料金・対象・各回の時間と、休日の予定への組み込み方を紹介します。"
  ogImage="/assets/events/7th-composition-kv.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '京都市京セラ美術館の物語体験', href: GUIDE },
  { name: '2026年11月の京都で楽しむ物語体験' },
]} />

<section class="section yn-hero" style="padding-top:36px"><div class="wrap">
<div class="yn-top">
  <a class="yn-kv" href={LP} data-track="show" data-show="7th-composition" data-place="kyoto-nov-hero"><img src="/assets/events/7th-composition-kv.webp" alt="体験する美術館「7枚目のコンポジション」京都市京セラ美術館" width="880" height="1247" fetchpriority="high" decoding="async" /></a>
  <div>
    <p class="yn-eyebrow">{phase === 'live' ? '開催中｜11月23日まで' : phase === 'ended' ? '2026年11月に開催' : '2026年11月21日〜23日 開催'}</p>
    <h1 class="yn-h1 serif"><span class="nobr">2026年11月の京都で</span><span class="nobr">楽しむ物語体験</span><br><span class="nobr">「7枚目のコンポジション」</span></h1>
    <p class="lede">11月21日（土）〜23日（月・祝）の3日間、<span class="nobr">京都市京セラ美術館</span>の本館地下1階で、絵画を鑑賞することが物語に参加するきっかけになる<strong>60分の物語体験</strong>を行います。美術館や物語が好きな方、いつもと違うデートや友人との休日を探している方に向けて、どんな体験かと予約前に知っておきたいことをまとめました。</p>
    <ul class="yn-keys">
      <li><span>開催</span><span>11月21日（土）・22日（日）・23日（月・祝）。各日7回（12:00〜16:30開始）</span></li>
      <li><span>料金</span><span>1名4,500円（税込）。この公演への参加に別途入館料はかかりません</span></li>
      <li><span>対象</span><span>18歳以上。1名から参加でき、各回最大18名</span></li>
      <li><span>会場</span><span><span class="nobr">京都市京セラ美術館</span> 本館地下1階（東山駅から徒歩約8分）</span></li>
    </ul>
    {phase !== 'ended' && <p class="yn-cta"><a class="yn-btn" href={TICKET} target="_blank" rel="noopener" data-track="ticket" data-show="7th-composition" data-place="kyoto-nov-top">11/21〜23の開催回・空席を見る（escape.id）↗</a><a class="yn-sub" href={GUIDE} data-track="show" data-show="guide-kyoto7" data-place="kyoto-nov-top">日程・チケット・行き方の案内 →</a></p>}
  </div>
</div>
<nav class="toc" aria-label="目次"><p class="toc-h">目次</p><ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol></nav>
</div></section>

<section class="section tinted" id="about"><div class="wrap narrow">
<p class="eyebrow">ABOUT</p><h2 class="h2 serif">どんな体験か</h2>
<p class="lede">「7枚目のコンポジション」は、株式会社ex Labsのレーベル「体験する美術館」の公演です。テーマは<strong>「『鑑賞するアート』から『体験するアート』へ」</strong>。絵画を鑑賞することが、そのまま物語に参加するきっかけになります。</p>
<p class="lede">物語の入口は、<span class="nobr">京都市京セラ美術館</span>の一角にある「三雲彼方展」と記された展示。そのパンフレットを開いた瞬間、自分の中に知らない記憶が流れ込んでくる——というところから始まります。</p>
<p class="lede">「イマーシブ」と呼ばれる種類の体験ですが、むずかしく考える必要はありません。<strong>客席から舞台を観るのではなく、参加者自身が物語の中に入り、絵画を観ることで話が進んでいく</strong>と考えてください。所要は受付・事前説明・退場を含めて60分です。</p>
<p class="vc-line"><a href={`${LP}#story`} style="color:var(--accent)" data-track="show" data-show="7th-composition" data-place="kyoto-nov-about">ストーリーと制作チーム（公式サイト）→</a></p>
</div></section>

<section class="section" id="diff"><div class="wrap narrow">
<p class="eyebrow">DIFFERENCE</p><h2 class="h2 serif">通常の美術鑑賞との違い</h2>
<div class="cmp-wrap"><table class="cmp">
<thead><tr><th scope="col">項目</th><th scope="col">通常の美術鑑賞</th><th scope="col">7枚目のコンポジション</th></tr></thead>
<tbody>
<tr><th scope="row">作品との関わり</th><td>作品を前に、自分のペースで観る</td><td>絵画を観ることが、物語に参加するきっかけになる</td></tr>
<tr><th scope="row">時間</th><td>自由</td><td>60分（受付・事前説明・退場を含む）。各回の開始時刻が決まっている</td></tr>
<tr><th scope="row">場所</th><td>展示室を自由に回る</td><td>本館地下1階の「講演室」と「多目的室」の2部屋。体験中に上下の階へ移動することはない</td></tr>
<tr><th scope="row">一緒にいる人</th><td>その場にいる来館者</td><td>同じ回に申し込んだ参加者（各回最大18名）</td></tr>
<tr><th scope="row">記録</th><td>展覧会のルールによる</td><td>体験中の撮影・録音はできない。途中退出・再入場もできない</td></tr>
</tbody>
</table></div>
<p class="lede" style="margin-top:18px">物語の詳しい内容は、参加する方のために公式サイトでも伏せられています。このページでも、公式に公開されている範囲だけを書いています。</p>
</div></section>

<section class="section tinted" id="info"><div class="wrap narrow">
<p class="eyebrow">INFO</p><h2 class="h2 serif">参加を決めるための情報</h2>
<ul class="bullets">
<li><strong>開催日</strong>：2026年11月21日（土）・22日（日）・23日（月・祝）の3日間。11月23日は祝日ですが美術館は開館しています</li>
<li><strong>料金</strong>：1名4,500円（税込）。この公演への参加に美術館の入館料は不要です</li>
<li><strong>所要時間</strong>：60分（受付・事前説明・退場を含む）</li>
<li><strong>対象・人数</strong>：18歳以上。1名から参加でき、各回最大18名（最少催行12名）</li>
<li><strong>会場・集合場所</strong>：<span class="nobr">京都市京セラ美術館</span> 本館地下1階。受付は「講演室」の扉前で、各回開始の10分前から。指定時刻に1分でも遅れると参加できません</li>
<li><strong>チケット</strong>：各回の開演1時間前まで販売。購入後のお客様都合によるキャンセル・日時変更はできません</li>
</ul>
<h3 class="kd-h3">各回の開催時間（3日間共通）</h3>
<div class="cmp-wrap"><table class="cmp cmp-s">
<thead><tr><th scope="col">回</th><th scope="col">開始</th><th scope="col">終了</th></tr></thead>
<tbody>{sessions.map(([n, a, b]) => <tr><th scope="row">{n}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
</table></div>
{phase !== 'ended' && <p class="yn-cta" style="margin-top:22px"><a class="btn" href={TICKET} target="_blank" rel="noopener" data-track="ticket" data-show="7th-composition" data-place="kyoto-nov-body">11/21〜23の開催回・空席を見る（escape.id）↗</a><a class="yn-sub2" href={GUIDE} data-track="show" data-show="guide-kyoto7" data-place="kyoto-nov-body">行き方・館内の経路・持ち物 →</a></p>}
<p class="lede" style="margin-top:16px">空席は予約サイトの表示が最新です。開催日と空席は別の情報なので、日付が合っても満席の場合があります。</p>
</div></section>

<section class="section" id="day"><div class="wrap narrow">
<p class="eyebrow">A DAY OFF</p><h2 class="h2 serif">休日の予定に組み込むイメージ</h2>
<p class="lede">60分の体験を軸に、各回の開始時刻だけで組んだ例です。移動時間は含めていないので、来館の予定に合わせて回を選んでください。</p>
<ol class="yn-flow">
<li><span>昼食後</span><span class="t">第3回（13:30〜14:30）か第4回（14:15〜15:15）に参加。受付は開始10分前からなので、その時刻に本館地下1階へ。</span></li>
<li><span>午後から</span><span class="t">午前に別の予定がある日は、第5回（15:00〜16:00）・第6回（15:45〜16:45）・第7回（16:30〜17:30）が候補です。</span></li>
<li><span>展覧会と</span><span class="t">同じ美術館の新館では「禅とジブリ」京都展（10月3日〜12月6日、10:00〜18:00、一般・大学生1,900円、10月31日から予約優先制）を開催中。別のチケットが必要で、建物も別です。徒歩圏の永観堂ライトアップ（11月20日〜12月6日、17:30〜20:30）と合わせた組み立ては<a href={OKAZAKI} style="color:var(--accent)">「禅とジブリ」京都展と同じ日に回る岡崎の半日</a>にまとめています。</span></li>
</ol>
<p class="lede" style="margin-top:18px">二人で行く場合も友人同士でも、料金は1人1枚ずつ（1名4,500円）です。同じ回に申し込めば一緒に体験できます。</p>
</div></section>

<section class="section tinted" id="faq"><div class="wrap narrow">
<p class="eyebrow">FAQ</p><h2 class="h2 serif">よくある質問</h2>
<div class="faq-list">
{faqs.map((f) => (
  <div class="faq-item">
    <p class="faq-q">{f.q}</p>
    <p class="faq-a">{f.a}</p>
  </div>
))}
</div>
{phase !== 'ended' && (
<div class="cta-mini" style="margin-top:36px">
<p class="cta-mini-title serif"><span class="nobr">京都市京セラ美術館</span>の物語体験「7枚目のコンポジション」</p>
<a class="btn" href={TICKET} target="_blank" rel="noopener" data-track="ticket" data-show="7th-composition" data-place="kyoto-nov-bottom">11/21〜23の開催回・空席を見る（escape.id）↗</a>
</div>
)}
<p class="vc-line" style="margin-top:32px">関連ページ：<a href={LP} style="color:var(--accent)">7枚目のコンポジション 公式サイト</a>／<a href={GUIDE} style="color:var(--accent)">日程・チケット・行き方（大阪・神戸からも）</a>／<a href={OKAZAKI} style="color:var(--accent)">「禅とジブリ」京都展と同じ日に回る岡崎の半日</a>／<a href="/taikenbizyutu/" style="color:var(--accent)">体験する美術館</a></p>
</div></section>

<AuthorBox />

<LatestPosts category="immersive" />

<StickyReserve href={TICKET} label="11/21〜23の開催回・空席を見る" show="7th-composition" place="kyoto-nov-sticky" until={TO} />

</BaseLayout>

<style>
.wrap.narrow{max-width:820px}
.yn-top{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:32px;align-items:start;max-width:1000px;margin:0 auto}
.yn-kv img{width:100%;height:auto;display:block;border-radius:10px;box-shadow:0 10px 30px rgba(60,20,30,.35)}
.yn-eyebrow{margin:0;display:inline-block;padding:4px 12px;background:#F6EFE6;color:#7A1F35;font-weight:800;font-size:13px;letter-spacing:.08em;border-radius:4px}
.yn-h1{margin:14px 0 0;font-size:clamp(24px,3.6vw,36px);line-height:1.45;color:#fff;text-wrap:balance}
.yn-keys{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:8px;font-size:14.5px;line-height:1.75;color:#fff}
.yn-keys li{display:grid;grid-template-columns:3em minmax(0,1fr);gap:10px}
.yn-keys li > span:first-child{font-weight:800;color:var(--x-lime,#E1F73E)}
.yn-cta{margin:22px 0 0;display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center}
.yn-btn{display:inline-block;padding:14px 22px;background:#7A1F35;color:#fff!important;font-weight:800;font-size:15px;border-radius:999px;text-decoration:none!important;border:1px solid #F6EFE6}
.yn-sub{font-weight:700;font-size:14.5px;color:#fff!important;border-bottom:1px solid currentColor}
.yn-sub2{font-weight:700;font-size:14.5px;color:var(--accent);border-bottom:1px solid currentColor}
.toc{max-width:520px;margin:40px auto 0;background:#fff;border:1px solid rgba(51,48,43,.08);border-radius:18px;padding:24px 28px}
.toc-h{margin:0 0 12px;font-size:13px;font-weight:800;letter-spacing:.12em;color:var(--accent)}
.toc ol{margin:0;padding-left:1.3em;display:flex;flex-direction:column;gap:8px}
.toc a{font-size:14.5px;font-weight:700;color:rgba(51,48,43,.8)}
.cmp-wrap{margin:18px 0 0;overflow-x:auto;-webkit-overflow-scrolling:touch}
.cmp{width:100%;min-width:520px;border-collapse:collapse;background:#fff;font-size:14px;line-height:1.75}
.cmp.cmp-s{min-width:0;max-width:520px}
.cmp th,.cmp td{border:1px solid rgba(51,48,43,.12);padding:11px 12px;vertical-align:top;text-align:left}
.cmp thead th{background:#F4F1EC;font-weight:800;font-size:13px}
.cmp tbody th{white-space:nowrap;font-weight:800}
.kd-h3{margin:28px 0 0;font-size:17px;font-weight:800}
.yn-flow{list-style:none;margin:20px 0 0;padding:0;counter-reset:f;display:grid}
.yn-flow li{counter-increment:f;display:grid;grid-template-columns:2em 4.2em minmax(0,1fr);gap:10px;align-items:baseline;padding:13px 0;border-bottom:1px solid rgba(51,48,43,.12);font-size:14.5px;line-height:1.8}
.yn-flow li::before{content:counter(f);font-weight:800;color:var(--accent)}
.yn-flow span{font-weight:800}.yn-flow .t{font-weight:400}
#about,#diff,#info,#day,#faq{scroll-margin-top:88px}
@media(max-width:700px){.yn-top{grid-template-columns:120px minmax(0,1fr);gap:16px}.yn-top > div{display:contents}.yn-eyebrow,.yn-h1{grid-column:2}.yn-kv{grid-row:1 / span 2}.yn-top .lede,.yn-keys,.yn-cta{grid-column:1 / -1}}
</style>
