---
// 「謎解き 研修」「チームビルディング 謎解き」系クエリの受け皿。
// マダミス研修ガイド（madamis-kenshu）と対になるスポーク記事で、
// 研修LP（/services/nazotoki-kenshu/）へ送客する。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
