const definedTermLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: 'イマーシブ制作',
  description:
    'イマーシブ制作とは、参加者が物語や空間に没入する体験（イマーシブ体験）を企画・設計・実装すること。物語・空間・キャストを一体で設計するリアル体験型と、VR・映像技術で没入空間を作るデジタル型に大別される。',
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: '体験型エンターテインメント用語集',
    publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
