const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '大人数の頭脳戦イベント・大会の企画方法｜対戦形式と運営の設計',
  description: '大人数で頭脳戦・心理戦イベントを開催するための対戦形式、予選・決勝、進行・審判・集計の設計を解説。仮の48名・90分構成、複数卓の得点比較、待ち時間の扱い、制作会社へ伝える条件を、東京都頭脳王決定戦を運営する株式会社ex Labsが紹介します。',
