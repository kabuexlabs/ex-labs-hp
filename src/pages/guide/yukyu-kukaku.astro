  about: '商業施設の遊休区画・遊休スペースの活用',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/yukyu-kukaku.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs' },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs' },
