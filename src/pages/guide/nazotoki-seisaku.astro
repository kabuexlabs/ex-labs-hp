const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: TITLE,
  description: DESC,
  about: '謎解き制作の依頼（依頼前の準備・工程・費用の内訳）',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/nazotoki-seisaku.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-11-19',
  dateModified: '2026-11-19',
  mainEntityOfPage: pageUrl,
};
---
<BaseLayout
  title="謎解き制作の依頼ガイド｜依頼前に決めること・工程・費用の内訳 - 株式会社ex Labs"
  description="謎解き制作を依頼する前に決める4つのこと（目的・対象と人数・会場と時間・形式）、制作の工程と依頼側の確認事項、難易度と所要時間の決め方、費用の内訳を、体験型イベントの制作会社・株式会社ex Labsが解説します。"
  ogImage="/assets/guide/nazotoki-seisaku.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '謎解きイベントの企画・制作', href: '/guide/nazotoki-event/' },
  { name: '謎解き制作の依頼ガイド' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">PRODUCTION GUIDE</p>
<h1 class="h2 serif"><span class="nobr">謎解き制作の依頼ガイド</span><br><span class="nobr">依頼前に決めること・</span><span class="nobr">工程・費用の内訳</span></h1>
<p class="lede">謎解き制作を依頼するときは、謎そのものより先に<strong>「誰に、どこで、何分で体験してもらうか」</strong>を決めます。同じ謎解きでも、商業施設で来館者に配る形と、研修で1時間かけて取り組む形では、作るものも当日の人手も変わります。</p>
<p class="lede">この記事では、依頼前に決めておくこと、制作の工程と依頼側が確認すること、費用の内訳をまとめます。会社の選び方と費用相場は<a href="/guide/nazotoki-company/" style="color:var(--accent)">謎解き制作会社の選び方と費用相場</a>で解説しています。</p>
<p class="pub-date">公開日：2026年11月19日</p>
<div class="key-points"><p class="key-points-h">この記事の要点</p><ul><li>謎解き制作とは、謎（問題）、物語、冊子やキットなどの制作物、ヒントと答え合わせの仕組み、当日の運営資料までを、目的と会場に合わせて作ることを指します。</li><li>依頼前に決めるのは「目的」「対象と人数」「会場と時間」「形式」の4つです。</li><li>見積もりは「初期制作」と「開催中の運営」に分けて、どこまで含むかを確認します。</li></ul></div>
<nav class="toc" aria-label="目次">
<p class="toc-h">目次</p>
<ol>
{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
<li><a href="#faq">よくある質問</a></li>
</ol>
</nav>
</div></section>

<section class="section tinted" id="what"><div class="wrap narrow">
<p class="eyebrow">WHAT TO MAKE</p><h2 class="h2 serif">謎解き制作で作るもの</h2>
<p class="lede">謎解き制作で作るのは、問題だけではありません。参加者が迷わず最後まで進めるように、次の5つをひとまとまりで作ります。</p>
<div class="cmp-wrap"><table class="cmp-table cmp-stack"><thead><tr><th>作るもの</th><th>内容</th><th>依頼側が確認すること</th></tr></thead><tbody>
<tr><th scope="row">物語・設定</th><td data-label="内容">参加者が何者として、何を解決するのか</td><td data-label="依頼側の確認">施設・商品・企業の伝えたい内容と合っているか</td></tr>
<tr><th scope="row">謎（問題）</th><td data-label="内容">手がかりと答え、解く順番</td><td data-label="依頼側の確認">対象者の年齢や経験に合う難しさか</td></tr>
<tr><th scope="row">制作物</th><td data-label="内容">冊子、キット、掲示物、Webページなど</td><td data-label="依頼側の確認">設置場所、サイズ、表記、ロゴの使い方</td></tr>
<tr><th scope="row">ヒント・答え合わせ</th><td data-label="内容">詰まった人を助ける仕組みと、正解の確認方法</td><td data-label="依頼側の確認">誰が対応するか（スタッフ・Web・冊子）</td></tr>
<tr><th scope="row">運営資料</th><td data-label="内容">受付、進行、よくある質問への回答</td><td data-label="依頼側の確認">当日の担当者と連絡先</td></tr>
</tbody></table></div>
<p class="lede">謎解きイベントそのものの種類や活用例は、<a href="/guide/nazotoki-event/" style="color:var(--accent)">謎解きイベントとは</a>にまとめています。</p>
</div></section>

<section class="section" id="format"><div class="wrap narrow">
<p class="eyebrow">FORMAT</p><h2 class="h2 serif">形式を先に決める</h2>
<p class="lede">形式によって、作るものと当日の人手が大きく変わります。目的と会場から、まず次の4つのどれに近いかを決めます。</p>
<div class="cmp-wrap"><table class="cmp-table cmp-stack"><thead><tr><th>形式</th><th>向いている目的</th><th>主な制作物</th><th>当日の人手</th></tr></thead><tbody>
<tr><th scope="row">会場型<br>（1つの会場で一斉に解く）</th><td data-label="向く目的">社内イベント、研修、ファン向けの催し</td><td data-label="制作物">問題用紙、スライド、進行台本</td><td data-label="人手">司会と補助スタッフ</td></tr>
<tr><th scope="row">周遊型<br>（施設や街を歩いて解く）</th><td data-label="向く目的">商業施設・商店街・観光地での回遊</td><td data-label="制作物">冊子やキット、掲示物、チェックポイント</td><td data-label="人手">受付、巡回、問い合わせ対応</td></tr>
<tr><th scope="row">常設・持ち帰り型<br>（好きな時間に自分で進める）</th><td data-label="向く目的">宿泊施設、店舗、長い会期の催し</td><td data-label="制作物">キット、Webのヒントページ</td><td data-label="人手">受付や販売が中心</td></tr>
<tr><th scope="row">公演型<br>（キャストや演出と組み合わせる）</th><td data-label="向く目的">物語への没入を重視する有料公演</td><td data-label="制作物">台本、小道具、会場の演出</td><td data-label="人手">キャスト、進行スタッフ</td></tr>
</tbody></table></div>
<p class="lede">形式ごとの企画例は、<a href="/guide/nazotoki-idea/" style="color:var(--accent)">謎解きイベントの企画アイデア10選</a>で紹介しています。</p>
</div></section>

<section class="section tinted" id="prepare"><div class="wrap narrow">
<p class="eyebrow">PREPARE</p><h2 class="h2 serif">依頼前に用意するとよい情報</h2>
<ul class="bullets">
<li><strong>開催の目的</strong>：集客、回遊、宿泊や来店の理由づくり、研修、ファン向けの催しなど。</li>
<li><strong>対象と人数</strong>：年齢層、謎解きの経験、1組の人数、想定する参加人数。</li>
<li><strong>会場</strong>：使える場所と時間帯、掲示や音に関する制限。</li>
<li><strong>日程</strong>：開催日と期間、設営・撤収に使える時間。</li>
<li><strong>希望する所要時間</strong>：30分、60分、半日など。</li>
<li><strong>費用の条件</strong>：有料か無料か、予算の上限、費用分担の希望。</li>
<li><strong>入れたい要素</strong>：施設の歴史、商品、キャラクターなど。あわせて、使えない表現も共有します。</li>
</ul>
<p class="lede">すべて決まっていなくても相談できます。決まっていることと未定のことを分けて伝えると、提案が具体的になります。</p>
</div></section>

<section class="section" id="process"><div class="wrap narrow">
<p class="eyebrow">PROCESS</p><h2 class="h2 serif">制作の進め方と依頼側の確認</h2>
<div class="cmp-wrap"><table class="cmp-table cmp-stack"><thead><tr><th>工程</th><th>制作会社の主な作業</th><th>依頼側の確認</th></tr></thead><tbody>
<tr><th scope="row">ヒアリング・現地確認</th><td data-label="制作会社">目的、対象、会場条件の確認</td><td data-label="依頼側の確認">使える場所と時間、禁止事項</td></tr>
<tr><th scope="row">企画提案</th><td data-label="制作会社">コンセプト、体験の流れ、見積もり</td><td data-label="依頼側の確認">目的との一致、予算、日程</td></tr>
<tr><th scope="row">謎・物語の制作</th><td data-label="制作会社">謎の設計、物語、解く順番</td><td data-label="依頼側の確認">固有名詞、表現、施設情報</td></tr>
<tr><th scope="row">制作物のデザイン・入稿</th><td data-label="制作会社">冊子、キット、掲示物、Webページ</td><td data-label="依頼側の確認">表記、ロゴ、設置場所</td></tr>
<tr><th scope="row">テストプレイ</th><td data-label="制作会社">難易度、所要時間、詰まる箇所を確認して修正</td><td data-label="依頼側の確認">通常の営業や業務と両立できるか</td></tr>
<tr><th scope="row">運営準備・開催</th><td data-label="制作会社">スタッフ資料、ヒント対応、当日運営</td><td data-label="依頼側の確認">連絡窓口、告知、備品</td></tr>
</tbody></table></div>
<p class="lede">納期の目安は、施設との調整を含むオリジナル企画で<strong>2〜4ヶ月程度</strong>、既存コンテンツの導入は2〜4週間、小規模なオリジナル制作は最短1ヶ月です（株式会社ex Labsの目安）。</p>
<p class="lede">遅れの原因になりやすいのは、会場側の確認待ち、テストプレイ後の修正、制作物の印刷待ちの3つです。開催日から逆算して「テストプレイ日」「入稿日」「会場確認日」を先に決めておくと防げます。</p>
</div></section>

<section class="section tinted" id="level"><div class="wrap narrow">
<p class="eyebrow">TEST PLAY</p><h2 class="h2 serif">難易度と所要時間はテストプレイで決める</h2>
<p class="lede">謎の難しさは、作った本人には判断できません。対象者に近い人に実際に解いてもらい、<strong>詰まった箇所・かかった時間・途中でやめた箇所</strong>を記録して直します。</p>
<ul class="bullets">
<li><strong>難しさはヒントで調整する</strong>：問題を易しく作り直すより、段階的なヒントを用意するほうが、得意な人の楽しさを残したまま、苦手な人も最後まで進めます。</li>
<li><strong>所要時間は遅い組を基準にする</strong>：平均ではなく、時間のかかった組でも収まるように枠を決めます。</li>
<li><strong>周遊型は現地で確かめる</strong>：移動にかかる時間、混雑しやすい場所、案内の分かりやすさは、実際に歩かないと分かりません。</li>
</ul>
<p class="lede">依頼するときは、テストプレイを何回行うか、誰が参加するかを確認しておくと安心です。</p>
</div></section>

<section class="section" id="cost"><div class="wrap narrow">
<p class="eyebrow">COST</p><h2 class="h2 serif">費用は初期制作と開催中の運営に分ける</h2>
<p class="lede"><strong>初期制作</strong>には、企画、謎と物語、デザイン、印刷物やキット、Webページ、テストプレイ、運営資料が含まれます。<strong>開催中の運営</strong>には、受付、進行や巡回のスタッフ、ヒント対応、消耗品の補充、設営・撤収の費用がかかります。</p>
<ul class="bullets">
<li><strong>ワークショップ型・研修型（1会場完結）</strong>：数十万円台〜</li>
<li><strong>会場型イベント（オリジナル制作）</strong>：50万〜200万円程度</li>
<li><strong>商業施設・街なかの周遊型</strong>：100万円前後〜数百万円規模</li>
</ul>
<p class="lede">上記は株式会社ex Labsの目安で、会場数・開催期間・スタッフ数によって変わります。費用を抑えるには、既存コンテンツの活用、施設の空間をそのまま舞台に使う設計、チケット収益から制作費を回収する<a href="/guide/event-revenue-share/" style="color:var(--accent)">レベニューシェア型</a>があります。</p>
<p class="lede">相場の考え方は<a href="/guide/nazotoki-company/#cost" style="color:var(--accent)">謎解き制作の費用相場と抑え方</a>、体験型イベント全体の費用は<a href="/guide/event-hiyou/" style="color:var(--accent)">体験型イベントの費用ガイド</a>をご覧ください。</p>
</div></section>

<section class="section tinted" id="purpose"><div class="wrap narrow">
<p class="eyebrow">BY PURPOSE</p><h2 class="h2 serif">目的別に変わるポイント</h2>
<ul class="bullets">
<li><strong>施設の集客・回遊</strong>：行ってほしい場所に手がかりを置きます。受付と待機の場所、通常の来館者と動線が重ならないかを先に確認します。詳しくは<a href="/guide/shuyu-event-seisaku/" style="color:var(--accent)">周遊イベントの制作依頼</a>へ。</li>
<li><strong>研修・チームビルディング</strong>：協力しないと解けない構造にし、体験後の振り返りまで含めて設計します。詳しくは<a href="/guide/nazotoki-kenshu/" style="color:var(--accent)">謎解き研修とは</a>へ。</li>
<li><strong>宿泊施設・店舗</strong>：滞在中の好きな時間に進められる形にすると、通常の業務と両立しやすくなります。宿泊と組み合わせる考え方は<a href="/guide/hotel-event/" style="color:var(--accent)">ホテル・宿泊施設の集客イベントアイデア</a>へ。</li>
<li><strong>社内イベント・懇親会</strong>：人数と会場の広さに合わせて、チーム対抗か全員協力かを決めます。詳しくは<a href="/guide/shanai-quiz/" style="color:var(--accent)">社内イベントで盛り上がるクイズ・ゲーム企画</a>へ。</li>
</ul>
</div></section>

<section class="section" id="order"><div class="wrap narrow">
<p class="eyebrow">ORDER</p><h2 class="h2 serif">ex Labsへの制作相談</h2>
<p class="lede">株式会社ex Labsは、渋谷サクラステージでの施設一体型イベント（日本経済新聞掲載）や、博報堂×紀伊國屋書店様の体験型イベントなどを手がけています。企画・謎の制作・制作物・テストプレイ・当日運営まで、まとめてご相談いただけます。</p>
<p class="lede">目的と会場が決まっていれば、形式や内容が未定の段階でもご相談いただけます。制作事例は<a href="/works/" style="color:var(--accent)">制作事例の一覧</a>をご覧ください。</p>
</div></section>

