---
// 「謎解きイベントとは」を正面に据えた謎解きジャンルの定義ハブ。
// 公開2週間、企画・制作の切り口では20〜31位に停滞したため（会社選び記事・
// アイデア記事と役割が重複）、勝ちパターンの「とは記事」に再フォーカスした。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZeroCostBanner from '../../components/ZeroCostBanner.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { jsonLd } from '../../lib/microcms';

const site = Astro.site ?? new URL('https://kabuexlabs.com');

const toc = [
  { id: 'about', label: '謎解きイベントとは' },
  { id: 'usecase', label: '企業・施設の活用シーン5選' },
  { id: 'point', label: '成功する謎解きイベントの条件' },
  { id: 'examples', label: '事例（チケット完売・日経掲載ほか）' },
  { id: 'flow', label: '制作依頼の流れと費用' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: '謎解きイベントとはどんなイベントですか？',
    a: '参加者が配布された謎やパズルを解きながら、物語のゴールを目指す体験型イベントです。会場を歩き回りながら手がかりを探す周遊型、1つの空間で完結するホール型、施設全体を舞台にした施設一体型など、規模に応じてさまざまな形式があります。',
  },
  {
    q: '謎解きイベントは集客に効果がありますか？',
    a: 'あります。謎解きは体験型イベントの中でも最も間口が広く、ファミリー・カップル・友人グループまで幅広い層が参加できます。施設を巡る周遊型にすれば、館内回遊・滞在時間の延長・店舗への送客まで設計できます。',
  },
  {
    q: '謎解きイベントの制作を依頼するといくらかかりますか？',
    a: '規模により、小規模な単発イベントで数十万円台から、施設全体を使う長期開催で数百万円規模になることがあります。株式会社ex Labsではレベニューシェア型（成果報酬型）に対応しており、案件によっては初期費用0円または格安で開催できます。',
  },
  {
    q: '謎解きの難易度はどう決めればいいですか？',
    a: 'ターゲット次第です。ファミリー向けは「全員で少しずつ進める」設計、謎解きファン向けは歯ごたえのある多段構成が向きます。制作会社は客層に合わせた難易度調整とテストプレイを行うため、企画段階でターゲットを共有することが重要です。',
  },
  {
    q: '研修としても使えますか？',
    a: '使えます。謎解きは情報共有・役割分担・時間管理の要素を自然に含むため、チームビルディング研修と好相性です。当社は謎解き研修の専門プログラムも提供しています。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 用語定義の構造化データ：「謎解きイベントとは」への引用元として明示する。
const definedTermLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: '謎解きイベント',
  description:
    '謎解きイベントとは、参加者が謎やパズルを解きながら物語のゴールを目指す体験型イベント。周遊型・ホール型・施設一体型など形式が多様で、商業施設の集客や企業研修にも活用される。',
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: '体験型エンターテインメント用語集',
    publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  },
  url: new URL('/guide/nazotoki-event/', Astro.site).toString(),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '謎解きイベントとは？種類・活用事例・費用まで完全ガイド',
  about: '謎解きイベントの企画・制作',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/nazotoki-event.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-08-10',
  dateModified: '2026-08-27',
  mainEntityOfPage: new URL('/guide/nazotoki-event/', Astro.site).toString(),
};
