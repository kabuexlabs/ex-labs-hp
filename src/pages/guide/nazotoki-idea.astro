---
// 「イベント 企画 謎解き（アイデア/目的/集客/研修…）」「謎解き イベント 種類」
// 系のロングテール群の受け皿となる目的別アイデア集。
// nazotoki-event（企画・制作ガイド）/nazotoki-company（会社選び）と三角を組む。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZeroCostBanner from '../../components/ZeroCostBanner.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { jsonLd } from '../../lib/microcms';

const site = Astro.site ?? new URL('https://kabuexlabs.com');

const toc = [
  { id: 'types', label: '謎解きイベントの種類（形式4タイプ）' },
  { id: 'purpose', label: '目的から企画を決める' },
  { id: 'ideas', label: '謎解きイベントの企画アイデア10選' },
  { id: 'success', label: '企画を成功させる3つの条件' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: '少人数・小規模でも謎解きイベントはできますか？',
    a: 'できます。会議室1室で完結するホール型や、キット配布型なら小規模でも実施可能です。数十名の研修から数万人規模の商業イベントまで、規模に合わせて形式を選べるのが謎解きの強みです。',
  },
  {
    q: '企画から開催までどのくらいの準備期間が必要ですか？',
    a: 'オリジナル制作の場合、企画・制作・テストプレイ・運営準備まで含めて2〜4ヶ月程度が目安です。既存コンテンツを活用すれば、より短い期間でも開催できます。',
  },
  {
    q: '謎解きの企画は自社でも作れますか？',
    a: '簡単なものは自作も可能ですが、参加者の満足度は「難易度調整」で決まるため、テストプレイを重ねられる制作会社への依頼が確実です。企画の目的整理から一緒に進められます。',
  },
  {
    q: 'どの形式を選べばいいかわかりません。',
    a: '「目的」から逆算するのが近道です。集客なら周遊型、研修・懇親ならホール型、話題化ならイマーシブ融合型が定石です。目的をお聞かせいただければ、最適な形式からご提案します。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '謎解きイベントの企画アイデア10選｜種類・目的別の選び方',
  about: '謎解きイベントの企画アイデア・種類・目的別の選び方',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/nazotoki-idea.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  reviewedBy: { '@type': 'Person', '@id': new URL('/company/iida-yuki/#person', site).toString(), name: '飯田 雄貴', jobTitle: '代表取締役', url: new URL('/company/iida-yuki/', site).toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
  mainEntityOfPage: new URL('/guide/nazotoki-idea/', Astro.site).toString(),
};
---
<BaseLayout
  title="謎解きイベントの企画アイデア10選｜種類・目的別の選び方 - 株式会社ex Labs"
  description="謎解きイベントの企画アイデアを目的別に10個紹介。形式4タイプ（ホール型・ルーム型・周遊型・キット型）の整理から、集客・プロモーション・研修それぞれに効く企画の選び方、成功の3条件まで、制作会社の実務知見で解説します。"
  ogImage="/assets/guide/nazotoki-idea.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '謎解きイベントの企画・制作', href: '/guide/nazotoki-event/' },
  { name: '企画アイデア10選' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">IDEAS</p>
<h1 class="h2 serif"><span class="nobr">謎解きイベントの</span><span class="nobr">企画アイデア10選</span><br><span class="nobr">種類・目的別の選び方</span></h1>
<p class="lede">謎解きイベントと一口に言っても、形式は<strong>ホール型・ルーム型・周遊型・キット型</strong>とさまざま。大切なのは、アイデアの奇抜さよりも<strong>「目的に合った形式を選ぶこと」</strong>です。この記事では、謎解きイベントの種類の整理から、目的別の企画アイデア10選、成功の条件までを、体験型イベント制作会社の株式会社ex Labsが解説します。</p>

<nav class="toc" aria-label="目次">
<p class="toc-h">目次</p>
<ol>
{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
</ol>
</nav>
</div></section>

<section class="section tinted" id="types"><div class="wrap">
<p class="eyebrow">TYPES</p><h2 class="h2 serif">謎解きイベントの種類（形式4タイプ）</h2>
<p class="h2sub">まずは形式の全体像から。どのアイデアも、この4タイプのいずれか（または組み合わせ）に整理できます。</p>
<div class="genre-grid">
<div class="genre-cell"><span class="genre-t serif">ホール型</span><span class="genre-d">会議室・宴会場などに集まり、チーム対抗で謎に挑む形式。研修・懇親会に最適で、人数の融通が利きます。</span></div>
<div class="genre-cell"><span class="genre-t serif">ルーム型（脱出型）</span><span class="genre-d">閉ざされた部屋から脱出する形式。没入感が高く、少人数の濃い体験を作れます。</span></div>
<div class="genre-cell"><span class="genre-t serif">周遊型</span><span class="genre-d">施設や街を歩き回り、スポットを巡りながら謎を解く形式。集客・回遊促進に最も効果的です。</span></div>
<div class="genre-cell"><span class="genre-t serif">キット型</span><span class="genre-d">冊子やキットを配布して各自のペースで遊ぶ形式。低コストで長期間展開でき、販促ノベルティにも使えます。</span></div>
</div>
</div></section>

<section class="section" id="purpose"><div class="wrap narrow">
<p class="eyebrow">PURPOSE</p><h2 class="h2 serif">目的から企画を決める</h2>
<ul class="bullets">
<li><strong>集客・回遊促進が目的</strong>：周遊型が定石。施設全体を会場化し、普段行かないフロアやテナントへ足を運ばせます。</li>
<li><strong>プロモーション・話題化が目的</strong>：物語性の強いイマーシブ融合型やシーズン企画。SNSで語りたくなる「体験の山場」を設計します。</li>
<li><strong>研修・チームビルディングが目的</strong>：ホール型。協力しないと解けない構造で、部署を越えたコミュニケーションを生みます。</li>
<li><strong>低予算・長期間の展開が目的</strong>：キット型。制作物中心なので運営コストを抑えられます。</li>
</ul>
</div></section>

<section class="section tinted" id="ideas"><div class="wrap narrow">
<p class="eyebrow">10 IDEAS</p><h2 class="h2 serif">謎解きイベントの企画アイデア10選</h2>
<ul class="bullets">
<li><strong>①館内周遊謎解き（商業施設）</strong>：フロアやテナントを巡って手がかりを集める形式。回遊・滞在時間の延長に直結します。<a href="/guide/shogyoshisetsu-event/" style="color:var(--accent)">商業施設の集客イベント →</a></li>
<li><strong>②閉店後のナイト謎解き</strong>：営業終了後の施設を「夜だけの特別な舞台」に。閉店後の紀伊國屋書店で物語体験を開催した実績があります。<a href="/guide/eigyo-jikangai/" style="color:var(--accent)">営業時間外の施設活用 →</a></li>
<li><strong>③店舗連動スタンプラリー型</strong>：各店舗に謎を設置し、買い回りと連動させる形式。テナントの送客に効きます。</li>
<li><strong>④展示連動型（美術館・博物館）</strong>：展示品を「観る」から「調べる」に変え、鑑賞の解像度を上げる形式。<a href="/guide/museum-event/" style="color:var(--accent)">ミュージアムの集客イベント →</a></li>
<li><strong>⑤街歩き周遊型</strong>：商店街や街全体を舞台に、実在の風景と物語を重ねる形式。下北沢での周遊型イベント制作実績があります。</li>
<li><strong>⑥チーム対抗ホール型（研修・懇親会）</strong>：制限時間内の協力プレイで、役職や部署を越えた会話が自然に生まれます。<a href="/services/nazotoki-kenshu/" style="color:var(--accent)">謎解き研修 →</a></li>
<li><strong>⑦オンライン謎解き</strong>：遠隔拠点をつないで実施。全国に拠点がある企業の全社イベントに向きます。</li>
<li><strong>⑧キット配布・持ち帰り型</strong>：来場ノベルティや商品同梱で配る形式。イベント期間後も体験が拡散し続けます。</li>
<li><strong>⑨シーズン連動型</strong>：ハロウィン・クリスマスなど季節催事と組み合わせ、毎年の恒例企画に育てる形式。</li>
<li><strong>⑩物語没入型（イマーシブ融合）</strong>：謎解きに物語とキャストを重ね、参加者を「登場人物」にする形式。渋谷サクラステージの施設一体型イベント（日本経済新聞掲載）はこのタイプです。<a href="/guide/case-uwasabanashi/" style="color:var(--accent)">制作事例を読む →</a></li>
</ul>
</div></section>

<section class="section" id="success"><div class="wrap narrow">
<p class="eyebrow">SUCCESS</p><h2 class="h2 serif">企画を成功させる3つの条件</h2>
<ul class="bullets">
<li><strong>①集客フックの設計</strong>：「面白そう」が伝わるタイトル・ビジュアルと、SNSで語りたくなる体験の山場。企画段階から集客を織り込みます。</li>
<li><strong>②難易度の調整</strong>：解けなすぎても簡単すぎても満足度は下がります。テストプレイを重ねた調整が品質の生命線です。</li>
<li><strong>③運営オペレーション</strong>：混雑・滞留への対応、スタッフ配置、施設営業との共存動線。当日の体験品質は運営設計で決まります。</li>
</ul>
<p class="vc-line"><a href="/guide/nazotoki-event/" style="color:var(--accent)">謎解きイベントの企画・制作ガイド →</a>／<a href="/guide/nazotoki-company/" style="color:var(--accent)">制作会社の選び方と費用相場 →</a></p>
</div></section>

<ZeroCostBanner />

<section class="section" id="faq"><div class="wrap">
<p class="eyebrow">FAQ</p><h2 class="h2 serif">よくある質問</h2>
<div class="faq-list tag-nazotoki">
{faqs.map((f) => (
  <div class="faq-item">
    <p class="faq-q">{f.q}</p>
    <p class="faq-a">{f.a}</p>
  </div>
))}
</div>
</div></section>

<section class="section tinted"><div class="wrap">
<div class="cta-mini">
<p class="cta-mini-title serif">目的に合わせた謎解きイベントをご提案します（相談無料）</p>
<a class="btn" href="/#contact">企画について相談する</a>
</div>
<p class="vc-line" style="margin-top:48px">関連ページ：<a href="/guide/nazotoki-event/" style="color:var(--accent)">謎解きイベントの企画・制作ガイド</a>／<a href="/guide/nazotoki-company/" style="color:var(--accent)">謎解き制作会社の選び方</a>／<a href="/guide/taikengata-event/" style="color:var(--accent)">体験型イベントとは</a>／<a href="/guide/shuyu-event/" style="color:var(--accent)">周遊型イベントとは</a></p>
</div></section>

<AuthorBox />

<LatestPosts category="nazotoki" />

</BaseLayout>

<style>
.wrap.narrow{max-width:820px}
.toc{max-width:520px;margin:44px auto 0;background:#fff;border:1px solid rgba(51,48,43,.08);border-radius:18px;padding:26px 30px;box-shadow:0 6px 22px rgba(51,48,43,.06)}
.toc-h{margin:0 0 14px;font-size:13px;font-weight:800;letter-spacing:.12em;color:var(--accent)}
.toc ol{margin:0;padding-left:1.3em;display:flex;flex-direction:column;gap:10px}
.toc a{font-size:14.5px;font-weight:700;color:rgba(51,48,43,.8);border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
.toc a:hover{color:var(--accent);border-color:var(--accent)}
#types,#purpose,#ideas,#success,#faq{scroll-margin-top:88px}
@media(max-width:640px){.toc{padding:22px 22px}}
</style>
