export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZeroCostBanner from '../../components/ZeroCostBanner.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { jsonLd } from '../../lib/microcms';

const site = Astro.site ?? new URL('https://kabuexlabs.com');

const toc = [
  { id: 'problem', label: '商業施設の集客イベントの課題' },
  { id: 'taiken', label: 'なぜ「体験型」が効くのか' },
  { id: 'idea', label: 'イベントアイデア10選' },
  { id: 'success', label: '成功させる3つのポイント' },
  { id: 'example', label: '商業施設・店舗での実施事例3選' },
  { id: 'cost', label: '費用（初期費用0円の形も）' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: '商業施設の集客イベントにはどんな種類がありますか？',
    a: '物販催事・キャラクターショー・ワークショップなどの従来型に加え、近年は施設全体を舞台にした謎解き・イマーシブなどの「体験型イベント」が広がっています。体験型は施設への来館そのものが目的になり、館内回遊・滞在時間の延長に直結するのが特徴です。',
  },
  {
    q: '体験型イベントは施設のどこで開催するのですか？',
    a: '共有区画・通路・空き区画・催事スペースなど、既存の空間をそのまま「物語の舞台」として使います。大規模な造作は必須ではなく、施設の通常営業と共存する設計が可能です。',
  },
  {
    q: 'テナントへの効果はありますか？',
    a: '周遊型の設計により、来館者が普段通らないフロアやテナントの前を通る動線を作れます。参加特典とテナントの購買を連動させる設計も可能です。',
  },
  {
    q: '施設側の費用負担を抑える方法はありますか？',
    a: 'あります。株式会社ex Labsはチケット売上などに応じたレベニューシェア型（成果報酬型）に対応しており、案件によっては施設側の初期費用0円または格安で開催できます。',
  },
  {
    q: 'どのくらいの期間開催できますか？',
    a: '週末だけの短期から、数週間〜数ヶ月の長期開催まで設計できます。長期開催は「何度も来る理由」を作りやすく、施設の定番コンテンツ化も狙えます。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '商業施設の集客イベントアイデア10選｜体験型で回遊・滞在を伸ばす',
  about: '商業施設の集客イベント企画',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/shogyoshisetsu-event.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  reviewedBy: { '@type': 'Person', '@id': new URL('/company/iida-yuki/#person', site).toString(), name: '飯田 雄貴', jobTitle: '代表取締役', url: new URL('/company/iida-yuki/', site).toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-08-07',
  dateModified: '2026-08-31',
  mainEntityOfPage: new URL('/guide/shogyoshisetsu-event/', Astro.site).toString(),
};
