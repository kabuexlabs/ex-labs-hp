---
// 「マダミス 制作 費用」「マーダーミステリー 制作 依頼」系の商用クエリの
// 受け皿となる記事ページ。相場の結論を冒頭で明言し（AI検索の引用対策）、
// 制作LP（/services/murder-mystery/）へ送客する。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import { jsonLd } from '../../lib/microcms';

const toc = [
  { id: 'summary', label: '費用の目安（結論）' },
  { id: 'factors', label: '費用が決まる5つの要素' },
  { id: 'save', label: '費用を抑える3つの方法' },
  { id: 'flow', label: '依頼の流れと制作期間' },
  { id: 'choose', label: '制作会社の選び方' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: 'マダミス制作の費用相場はどのくらいですか？',
    a: '一般的な目安として、シナリオ制作のみで数十万円台から、テストプレイ・小道具・運営設計まで含むフルパッケージで100万円前後から、大型イベントやブランドコラボでは数百万円規模になることがあります。形式・人数・利用範囲で大きく変わるため、まずは目的を添えて見積りを取るのが確実です。',
  },
  {
    q: '予算が少なくてもマダミス制作を依頼できますか？',
    a: '相談可能です。株式会社ex Labsでは、案件によって初期費用を抑えたご提案や、売上に応じて費用をお支払いいただくレベニューシェア型での実施に対応しています。',
  },
  {
    q: 'シナリオだけの制作を依頼することはできますか？',
    a: '可能です。シナリオ制作のみのご依頼から、企画・制作・テストプレイ・当日の公演運営までの一括のご依頼まで、必要な範囲に合わせて対応します。',
  },
  {
    q: 'マダミスの制作期間はどのくらいかかりますか？',
    a: '作品の規模により数週間から数ヶ月が目安です。実施希望日が決まっている場合は、お問い合わせの際にお伝えいただければ、間に合うスケジュールと構成をご提案します。',
  },
  {
    q: '見積りは無料ですか？',
    a: 'はい、無料です。目的（動画企画・店舗集客・イベント・研修など）とおおよその人数・時期をお知らせいただければ、概算をご案内します。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'マダミス制作の費用相場は？料金の内訳・安く抑える方法まで解説',
  about: 'マーダーミステリー（マダミス）制作の費用',
  inLanguage: 'ja',
  author: { '@type': 'Organization', name: '株式会社ex Labs' },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs' },
  datePublished: '2026-07-30',
  dateModified: '2026-07-30',
  mainEntityOfPage: new URL('/guide/madamis-cost/', Astro.site).toString(),
};
---
<BaseLayout
  title="マダミス制作の費用相場は？料金の内訳・安く抑える方法まで解説 - 株式会社ex Labs"
  description="マダミス（マーダーミステリー）制作の費用相場を制作会社が解説。シナリオのみなら数十万円台〜、運営まで含むフルパッケージは100万円前後〜が一般的な目安です。料金が決まる要素・費用を抑える方法・依頼の流れまで紹介。見積り無料。"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: 'マダミス完全ガイド', href: '/guide/madamis/' },
  { name: 'マダミス制作の費用相場' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">MURDER MYSTERY COST GUIDE</p>
<h1 class="h2 serif"><span class="nobr">マダミス制作の</span><span class="nobr">費用・料金相場ガイド</span></h1>
<p class="lede"><strong>マダミス（マーダーミステリー）制作の費用</strong>は、一般的な目安として<strong>シナリオ制作のみで数十万円台から、テストプレイ・運営設計まで含むフルパッケージで100万円前後から</strong>、大型イベントやブランドコラボでは数百万円規模になることがあります。この記事では、料金が決まる要素・費用を抑える方法・依頼の流れを、マダミス制作会社の株式会社ex Labsが解説します。</p>

<nav class="toc" aria-label="目次">
<p class="toc-h">目次</p>
<ol>
{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
</ol>
</nav>
</div></section>

<section class="section tinted" id="summary"><div class="wrap">
<p class="eyebrow">SUMMARY</p><h2 class="h2 serif">費用の目安（結論）</h2>
<p class="h2sub">依頼する範囲によって、おおまかに3つの価格帯に分かれます。</p>
<div class="genre-grid">
<div class="genre-cell"><span class="genre-t serif">シナリオ制作のみ</span><span class="genre-d">数十万円台〜が目安。物語・キャラクター資料・進行資料の執筆まで。すでに運営体制がある店舗・団体向けです。</span></div>
<div class="genre-cell"><span class="genre-t serif">フルパッケージ</span><span class="genre-d">100万円前後〜が目安。企画・シナリオ・テストプレイ・小道具・当日の運営設計まで一括で依頼する形です。</span></div>
<div class="genre-cell"><span class="genre-t serif">大型・ブランドコラボ</span><span class="genre-d">数百万円規模になることも。商業施設での長期開催や、ブランドの世界観と連動した大規模企画などです。</span></div>
</div>
<p class="vc-line" style="margin-top:28px">※上記は業界の一般的な相場観であり、当社の料金表ではありません。条件次第で大きく上下するため、正式な金額は<strong>無料見積り</strong>でご確認ください。</p>
</div></section>

<section class="section" id="factors"><div class="wrap narrow">
<p class="eyebrow">FACTORS</p><h2 class="h2 serif">費用が決まる5つの要素</h2>
<ul class="bullets">
<li><strong>プレイ人数と時間</strong>：人数が多く、プレイ時間が長い作品ほどシナリオの分量とテストプレイの工数が増えます。</li>
<li><strong>GM（進行役）の有無</strong>：GMなしで回る設計にするか、当日の進行スタッフまで依頼するかで費用が変わります。</li>
<li><strong>利用範囲</strong>：1回きりの社内イベントか、店舗で継続的に公演するか、動画・配信で使うかなど、使い方によって条件が変わります。</li>
<li><strong>小道具・空間演出</strong>：紙資料中心のシンプルな構成か、小道具や会場装飾まで作り込むかで制作物の量が変わります。</li>
<li><strong>運営まで含むか</strong>：納品して終わりか、当日の公演運営・スタッフ手配まで任せるかも大きな分かれ目です。</li>
</ul>
</div></section>

<section class="section tinted" id="save"><div class="wrap narrow">
<p class="eyebrow">SAVE</p><h2 class="h2 serif">費用を抑える3つの方法</h2>
<ul class="bullets">
<li><strong>レベニューシェア型を検討する</strong>：ex Labsでは、チケット売上などに応じて費用をお支払いいただく成果報酬型に対応しており、案件によっては初期費用を大きく抑えて実施できます。</li>
<li><strong>既存作品を活用する</strong>：ゼロからのオリジナル制作ではなく、既存作品の貸切公演やカスタマイズで目的を達成できるケースもあります。</li>
<li><strong>形式・規模を調整する</strong>：オンライン形式にする、人数・時間をコンパクトにするなど、目的を保ったまま工数を減らす設計が可能です。</li>
</ul>
</div></section>

<section class="section" id="flow"><div class="wrap narrow">
<p class="eyebrow">FLOW</p><h2 class="h2 serif">依頼の流れと制作期間</h2>
<ul class="bullets">
<li><strong>1. お問い合わせ</strong>：目的（動画・店舗集客・イベント・研修など）、おおよその人数・時期・ご予算をお知らせください。</li>
<li><strong>2. ヒアリング・企画提案</strong>：内容を伺ったうえで、構成と概算お見積りをご提案します。ここまでは無料です。</li>
<li><strong>3. シナリオ制作・テストプレイ</strong>：執筆と並行してテストプレイを重ね、体験の完成度を高めます。</li>
<li><strong>4. 納品・公演運営</strong>：資料一式を納品します。ご希望に応じて、当日の公演運営までex Labsが担当します。</li>
</ul>
<p class="vc-line">制作期間は規模により数週間〜数ヶ月が目安です。実施日が決まっている場合は早めにご相談ください。</p>
</div></section>

<section class="section tinted" id="choose"><div class="wrap narrow">
<p class="eyebrow">HOW TO CHOOSE</p><h2 class="h2 serif">制作会社の選び方</h2>
<p class="lede">マダミスは「完成した瞬間」ではなく「遊ばれた瞬間」に価値が決まるコンテンツです。制作会社を選ぶ際は、<strong>テストプレイを重ねる体制があるか</strong>、<strong>公演運営まで自社で経験しているか</strong>、<strong>集客や研修など目的側の設計まで踏み込めるか</strong>を確認するのがおすすめです。</p>
<p class="lede">株式会社ex Labsは、マダミスアンケート1位作品を手がけたチームが、企画からシナリオ・テストプレイ・公演運営まで一貫して担当。宿泊施設向けのマダミスで新規宿泊予約20件以上の獲得につながった実績など、「目的の達成」まで含めた制作を行っています。累計コンテンツ体験者数は15,000人を超えました。</p>
<p class="vc-line"><a href="/services/murder-mystery/" style="color:var(--accent)">マダミスの制作依頼・お見積り（無料）はこちら →</a></p>
</div></section>

<section class="section" id="faq"><div class="wrap">
<p class="eyebrow">FAQ</p><h2 class="h2 serif">よくある質問</h2>
<div class="faq-list tag-murder">
{faqs.map((f) => (
  <div class="faq-item">
    <p class="faq-q">{f.q}</p>
    <p class="faq-a">{f.a}</p>
  </div>
))}
</div>
</div></section>

<section class="section tinted"><div class="wrap">
<div class="cta-mini">
<p class="cta-mini-title serif">マダミス制作の無料見積りはこちら</p>
<a class="btn" href="/#contact">マダミス制作について相談する</a>
</div>
<p class="vc-line" style="margin-top:48px">関連ページ：<a href="/services/murder-mystery/" style="color:var(--accent)">マダミス制作サービス</a>／<a href="/guide/madamis/" style="color:var(--accent)">マダミスとは？完全ガイド</a>／<a href="/toudaimurder/" style="color:var(--accent)">UNLIMITED MYSTERY（制作レーベル）</a></p>
</div></section>

<LatestPosts category="murder" />

</BaseLayout>

