.cmp-table td{min-width:180px;vertical-align:top}
ol.bullets,ul.bullets{text-align:left}
.toc{max-width:520px;margin:28px auto 0;background:#fff;border:1px solid rgba(51,48,43,.08);border-radius:18px;padding:26px 30px;box-shadow:0 6px 22px rgba(51,48,43,.06);text-align:left}
.toc-h{margin:0 0 10px;font-weight:800}
.toc ol{margin:0;padding-left:1.3em;line-height:2}
.toc a{color:var(--ink)}
#issues,#experience,#model,#roles,#money,#measure,#steps,#diff,#track,#contact,#faq{scroll-margin-top:88px}
</style>
