---
// 「東京 非日常 デート」「東京 体験 デート」「東京 体験型 デート」の受け皿。
// イマーシブという言葉を知らない人にも、体験ジャンル（ものづくり／没入型アート／謎解き／物語参加型）を比較して
// 行き先を選べる入口。物語参加型は src/data/events/（東京ガイドと共通）から、他社の施設・体験は
// src/data/experienceDate.ts（公式確認済みのものだけ published）から生成する。
// 他社項目が公式確認できず2ジャンル未満の間は下書き扱い（noindex、記事一覧・サイトマップ・内部リンクに出さない）。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ShowCalendar from '../../components/ShowCalendar.astro';
import VisualHero from '../../components/VisualHero.astro';
import { shows } from '../../data/shows';
import { jstDateString } from '../../lib/thisWeek';
import { buildGuideRows, fmtYen } from '../../lib/tokyoGuide';
import { publishedItems, EXPERIENCE_DATE_PUBLISHED, GENRE_LABEL, type Genre } from '../../data/experienceDate';
import { jsonLd } from '../../lib/microcms';

const now = new Date();
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const pageUrl = new URL('/guide/tokyo-experience-date/', site).toString();
const draft = !EXPERIENCE_DATE_PUBLISHED;
if (draft) Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

// 物語参加型の実例：開催中で、二人での参加形式（貸切／相席）と料金単位が公式で確認できた公演だけ（未確認の公演は二人向けの実例に含めない）
const story = buildGuideRows(now).filter((r) => r.status !== 'ended' && r.w.party.format !== 'unknown' && r.totalFor(2) !== undefined);
const today = jstDateString(now);
const storyShows = shows.filter((s) => s.published && story.some((r) => r.w.id === s.id) && s.occurrences.some((o) => o.date >= today));
// 申込可否（人数条件）と料金の有無は別の状態として扱う
const canPair = (r: (typeof story)[number]) => r.w.party.min <= 2 && (r.w.party.max === undefined || r.w.party.max >= 2);
const total2 = (r: (typeof story)[number]) => { if (!canPair(r)) return '2名では申込不可'; const t = r.totalFor(2); return t === undefined ? '料金は公式で確認' : fmtYen(t); };
const SETTING: Record<string, string> = { indoor: '屋内で完結', outdoor: '屋外', mixed: '屋外の徒歩移動あり' };
const byGenre = (g: Genre) => publishedItems.filter((i) => i.genre === g);
// 見出し・比較表は「実例を掲載できているジャンル」だけに揃える（実例のないジャンルの傾向だけを書かない）
const genres: Genre[] = (['craft', 'art', 'puzzle', 'story'] as Genre[]).filter((g) => (g === 'story' ? story.length > 0 : byGenre(g).length > 0));
const genreNames = genres.map((g) => GENRE_LABEL[g]).join('・');
const exampleCount = publishedItems.length + story.length;
// 公式URLを実際に開いて確認できていない項目は、URLを直接リンクせず公式サイト名での検索リンクにする（誤ったURLを載せない）
const extHref = (i: (typeof publishedItems)[number]) => i.urlChecked ? (i.bookingUrl ?? i.officialUrl) : `https://www.google.com/search?q=${encodeURIComponent(`${i.name.replace(/（[^）]*）/g, '').trim()} 公式`)}`;
const genreInfo: Record<Genre, { doing: string; talk: string; check: string }> = {
  craft: { doing: '指輪や絵などを、講師の説明を受けながら二人がそれぞれ（または一緒に）作る', talk: '講師とのやり取りが中心。他の参加者と同席するか、協力する場面があるかは各体験の案内で確認', check: '同じ席・同じ回で作れるか、焼成や仕上げで完成品の受け取りが後日になるか、素材・送料などの追加料金' },
  art: { doing: '作品空間を歩いて鑑賞する。日時指定チケットで入場し、順路や滞在時間は自由なことが多い', talk: '他の来場者も一緒で貸切にはならない。会話や撮影の制限は展示ごとに確認', check: '日時指定か、混雑する時間帯、裸足や水に入る作品の有無、再入場の可否' },
  puzzle: { doing: '制限時間内に二人で（または他の参加者とチームで）謎を解き、脱出やミッション達成を目指す', talk: '二人の相談が中心。公演によっては他のチームと合流し、初対面の人と協力する', check: '二人だけで1チームになれるか、他の参加者と同じチームになるか、難易度、途中退出の扱い' },
  story: { doing: '物語の登場人物として空間に入り、キャストとの会話や選択で物語を進める', talk: 'キャストとの会話が進行の一部。相席形式では他の参加者も一緒に進む', check: '二人が同じ組か（貸切か相席か）、途中で離れる場面の有無、年齢条件、集合時刻と遅刻の扱い' },
};

const faqs = [
  { q: '「二人で申し込める」と「二人だけで体験できる」は同じですか？', a: '違います。1名ずつのチケットで同じ回に入る体験は他の参加者も一緒で、途中で離れる場面がある公演もあります。二人だけで体験したい場合は、申込単位で貸切になる体験を選び、公式ページの「貸切」「申込人数」の欄で確認してください。' },
  { q: '料金は二人分でいくらと考えればいいですか？', a: '体験によって「1人料金×2」と「1組料金」があり、素材費・焼成費・送料・手数料が別になる場合があります。このページの各項目には二人分の総額と単位、追加料金の条件を載せています。空き状況と最終的な金額は公式予約ページでご確認ください。' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const title = '東京の非日常デート｜二人で楽しむ体験を料金・時間・過ごし方で比較';
const desc = '東京で楽しむ体験デートを、ものづくり・謎解き・物語参加型の3ジャンルから比較。二人分の料金と単位、所要時間、二人の会話と他の参加者との協力の量、貸切か相席か、予約前に確認する点を公式情報で整理し、公式予約ページへ進めます。';
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description: desc, inLanguage: 'ja',
  image: [new URL('/assets/guide/tokyo-experience-date.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-09-20', dateModified: '2026-09-20', mainEntityOfPage: pageUrl,
};
// 予算・時間・二人だけか・屋外移動で横断して選ぶための行（他社＝compare、自社＝公演データ。未確認は「公式で確認」のまま）
type CmpRow = { id: string; name: string; genre: string; pairTotal: string; pairTotalMin?: number; time: string; minutes?: number; place: string; together: string; privateForTwo?: boolean; outdoor: string; href: string; ext: boolean };
const cmpRows: CmpRow[] = [
  ...publishedItems.filter((i) => i.compare).map<CmpRow>((i) => ({ id: i.id, name: i.name, genre: GENRE_LABEL[i.genre], ...i.compare!, href: `#item-${i.id}`, ext: true })),
  ...story.map<CmpRow>((r) => ({
    id: r.w.id, name: r.w.title, genre: `${GENRE_LABEL.story}（当社制作）`,
    pairTotal: `${total2(r)}（${r.w.price.unit === 'per-group' ? '1組料金' : '1人料金×2'}、税込・手数料別）`, pairTotalMin: r.totalFor(2),
    time: r.w.duration.minutes ? `約${r.w.duration.minutes}分（本編。集合・受付は別）` : '公式で確認', minutes: r.w.duration.minutes,
    place: `${shows.find((s) => s.id === r.w.id)?.area ?? r.venue?.listName ?? '公式で確認'}${r.venue?.station ? `（${r.venue.station.replace(/（[^）]*）/g, '')}）` : ''}`,
    together: r.w.party.format === 'private' ? '二人だけで体験（申込単位で貸切）' : r.w.party.format === 'shared' ? '同じ回に他の参加者も一緒' : '公式で確認', privateForTwo: r.w.party.format === 'private' ? true : r.w.party.format === 'shared' ? false : undefined,
    outdoor: r.venue?.setting === 'indoor' ? '屋内で完結' : r.venue?.setting === 'mixed' ? '受付後に屋外の徒歩移動あり' : r.venue?.setting === 'outdoor' ? '屋外' : '公式で確認',
    href: `#item-${r.w.id}`, ext: false,
  })),
];
const yen = (n: number) => `${n.toLocaleString('ja-JP')}円`;
const byBudget = (lo: number, hi: number) => cmpRows.filter((c) => c.pairTotalMin !== undefined && c.pairTotalMin >= lo && c.pairTotalMin <= hi).sort((a, b) => a.pairTotalMin! - b.pairTotalMin!);
const budgetUnknown = cmpRows.filter((c) => c.pairTotalMin === undefined);
const byTime = (lo: number, hi: number) => cmpRows.filter((c) => c.minutes !== undefined && c.minutes >= lo && c.minutes <= hi);
const timeUnknown = cmpRows.filter((c) => c.minutes === undefined);
const privateRows = cmpRows.filter((c) => c.privateForTwo === true);
const sharedRows = cmpRows.filter((c) => c.privateForTwo === false);
const togetherUnknown = cmpRows.filter((c) => c.privateForTwo === undefined);
const nameLinks = (xs: CmpRow[]) => xs.map((c) => ({ name: c.name, href: c.href, extra: c.pairTotalMin !== undefined ? yen(c.pairTotalMin) + (c.pairTotal.includes('〜') ? '〜' : '') : '' }));
const latestStory = story.map((r) => r.w.verified.at).sort().pop();
const latestStoryText = story.find((r) => r.w.verified.at === latestStory)?.verifiedText ?? '';
---
<BaseLayout
  title="東京の非日常デート｜二人で楽しむ体験を料金・時間・過ごし方で比較 - 株式会社ex Labs"
  description="東京で楽しむ体験デートを、ものづくり・謎解き・物語参加型の3ジャンルから比較。二人分の料金と単位、所要時間、二人の会話と他の参加者との協力の量、貸切か相席か、予約前に確認する点を公式情報で整理し、公式予約ページへ進めます。"
  ogImage="/assets/guide/tokyo-experience-date.webp"
>
{!draft && <script type="application/ld+json" set:html={jsonLd(faqLd)} />}
{!draft && <script type="application/ld+json" set:html={jsonLd(articleLd)} />}
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '解説記事一覧', href: '/guide/' },
  { name: '東京の非日常デート' },
]} />

{draft && (
  <section class="section" style="padding-top:24px;padding-bottom:0"><div class="wrap">
  <p class="draft-note"><strong>下書き（公開前）</strong>：他社の施設・体験は主催者の公式ページで料金・所要時間・二人での参加条件を確認でき次第、掲載します。現在は公式確認済みの項目が足りないため、検索エンジンには登録せず、記事一覧・サイトマップにも載せていません。</p>
  </div></section>
)}

<VisualHero image="/assets/events/kaitou-kv.webp" imagePos="center 45%" eyebrow="EXPERIENCE DATE" catchText="食事と映画の次は、二人で体験を" chips={[`実例 ${exampleCount}件`, `${genres.length}ジャンルを比較`, '二人分の料金・時間・貸切か相席か']} alt="東京で開催中のイマーシブ公演のキービジュアル">
  <h1 class="h2 serif"><span class="nobr">東京でいつもと違うデートをするなら？</span><span class="nobr">二人で楽しむ非日常の体験</span></h1>
</VisualHero>

<section class="section" style="padding-top:28px"><div class="wrap">
<p class="lede">東京で二人で楽しめる体験を、<strong>{genreNames}</strong>から比べます。<strong>料金だけでなく、二人だけで進められるか、他の参加者やキャストと関わるかも比べて選びましょう。</strong></p>
<div class="key-points"><p class="key-points-h">要点</p><ul>
<li>二人だけで話せる時間の長さは体験ごとに違います。各実例の「二人での参加」欄で、同席・貸切・他の参加者やキャストとの関わりを確認できます。</li>
<li>料金は「1人料金×2」と「1組料金」を区別。焼成費・素材費・手数料は別の場合あり。</li>
<li>「二人で申し込める」と「二人だけで体験できる（貸切）」は別の条件。</li>
</ul></div>
</div></section>

<section class="section tinted" id="pick"><div class="wrap">
<h2 class="cards-h">条件から選ぶ<span>二人分の予算・使える時間・二人だけで過ごしたいか</span></h2>
<div class="pick-grid">
<div class="pick-col"><p class="pick-h">二人分の予算で</p><ul class="pick-list">
{[['1万円まで', 0, 10000], ['1〜2万円', 10001, 20000], ['2万円以上', 20001, 999999]].map(([label, lo, hi]) => { const xs = byBudget(lo as number, hi as number); return xs.length > 0 && <li><span class="pick-k">{label}</span>{nameLinks(xs).map((n, i) => <>{i > 0 && '／'}<a href={n.href}>{n.name}</a><small>{n.extra}</small></>)}</li>; })}
{budgetUnknown.length > 0 && <li><span class="pick-k">料金は公式で確認</span>{budgetUnknown.map((c, i) => <>{i > 0 && '／'}<a href={c.href}>{c.name}</a></>)}</li>}
</ul></div>
<div class="pick-col"><p class="pick-h">使える時間で</p><ul class="pick-list">
{[['約1時間', 0, 75], ['約1.5〜2時間', 76, 130], ['2時間超', 131, 999]].map(([label, lo, hi]) => { const xs = byTime(lo as number, hi as number); return xs.length > 0 && <li><span class="pick-k">{label}</span>{xs.map((c, i) => <>{i > 0 && '／'}<a href={c.href}>{c.name}</a></>)}</li>; })}
{timeUnknown.length > 0 && <li><span class="pick-k">所要時間は公式で確認</span>{timeUnknown.map((c, i) => <>{i > 0 && '／'}<a href={c.href}>{c.name}</a></>)}</li>}
</ul></div>
<div class="pick-col"><p class="pick-h">二人だけで過ごしたいか</p><ul class="pick-list">
{privateRows.length > 0 && <li><span class="pick-k">二人だけ（貸切）</span>{privateRows.map((c, i) => <>{i > 0 && '／'}<a href={c.href}>{c.name}</a></>)}</li>}
{sharedRows.length > 0 && <li><span class="pick-k">他の参加者も一緒</span>{sharedRows.map((c, i) => <>{i > 0 && '／'}<a href={c.href}>{c.name}</a></>)}</li>}
{togetherUnknown.length > 0 && <li><span class="pick-k">公式で確認</span>{togetherUnknown.map((c, i) => <>{i > 0 && '／'}<a href={c.href}>{c.name}</a></>)}</li>}
</ul></div>
</div>
<p class="cards-note">金額は公式料金からの二人分の計算（税込・手数料や追加料金の条件は各項目に記載）で、特定日時の予約可能価格ではありません。時間は公式の所要時間で、集合・受付や移動の時間は含みません。前後の予定には余裕を持たせてください。</p>
<div class="cmp-wrap"><table class="cmp-table cmp-x"><thead><tr><th>体験</th><th>ジャンル</th><th>二人分の総額</th><th>所要時間</th><th>場所・最寄り</th><th>二人だけか相席か</th><th>屋外移動</th></tr></thead><tbody>
{cmpRows.map((c) => (
  <tr>
    <th scope="row"><a href={c.href} style="color:var(--ink)">{c.name}</a></th>
    <td>{c.genre}</td><td>{c.pairTotal}</td><td>{c.time}</td><td>{c.place}</td><td>{c.together}</td><td>{c.outdoor}</td>
  </tr>
))}
</tbody></table></div>
<p class="cards-note">「公式で確認」は、公式ページの記載を確認できていない項目です。雨の日は「屋外移動」欄で、受付から会場までの移動の有無を確認してください（会場が屋内でも、駅から受付までの移動は含みません）。</p>
</div></section>

<section class="section tinted" id="genres"><div class="wrap">
<p class="eyebrow">GENRES</p><h2 class="h2 serif">ジャンルで比べる：二人で何をするか・会話と協力・費用・時間</h2>
<p class="lede">ジャンルの傾向と、予約前に確認する点です。費用と時間は実例の項目に載せています（ジャンル全体の相場は作っていません）。</p>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>ジャンル</th><th>二人で何をするか</th><th>会話・協力の場面</th><th>費用・時間の実例</th><th>予約前に確認すること</th></tr></thead><tbody>
{genres.map((g) => {
  const items = byGenre(g);
  const example = g === 'story'
    ? story.map((r) => `${r.w.title}：2名で${total2(r)}・${r.w.duration.text}`).join('／')
    : items.length ? items.map((i) => `${i.name}：${i.price}・${i.time}`).join('／') : '公式確認後に記載';
  return (
    <tr>
      <th scope="row">{GENRE_LABEL[g]}</th>
      <td>{genreInfo[g].doing}</td>
      <td>{genreInfo[g].talk}</td>
      <td>{example}</td>
      <td>{genreInfo[g].check}</td>
    </tr>
  );
})}
</tbody></table></div>
</div></section>

<section class="section" id="items"><div class="wrap">
<p class="eyebrow">EXAMPLES</p><h2 class="h2 serif">実例：公式情報で条件を確認できた体験</h2>
<p class="lede">各項目の重要な条件（二人での参加・費用・時間・開催状況・注意点）を同じ項目で並べています。出典と確認日を各項目に記載し、空き状況は公式予約ページでご確認ください。</p>

{genres.filter((g) => g !== 'story').map((g) => byGenre(g).length > 0 && (
  <div class="genre-block">
    <h3 class="def-sub serif">{GENRE_LABEL[g]}</h3>
    <div class="sc-grid">
    {byGenre(g).map((i) => (
      <article class="sc-card" id={`item-${i.id}`}>
        <p class="tw-area">{i.area}</p>
        <h4 class="tw-name serif">{i.name}</h4>
        <dl class="tw-dl">
          <div><dt>体験内容</dt><dd class="dd-normal">{i.what}</dd></div>
          <div><dt>二人での参加</dt><dd class="dd-normal">{i.forTwo}</dd></div>
          <div><dt>費用（二人分）</dt><dd class="dd-normal">{i.price}</dd></div>
          <div><dt>時間</dt><dd class="dd-normal">{i.time}</dd></div>
          <div><dt>開催状況</dt><dd class="dd-normal">{i.status}</dd></div>
          <div><dt>選ぶ理由</dt><dd class="dd-normal">{i.fit}</dd></div>
          <div><dt>注意点</dt><dd class="dd-normal">{i.notes}</dd></div>
        </dl>
        <p class="tw-meta" style="margin-top:10px">出典：{i.urlChecked ? <a href={i.officialUrl} target="_blank" rel="noopener nofollow" style="color:var(--accent)">公式ページ</a> : '公式ページの記載'}（{i.checkedAt} 確認）{i.confirmation.unconfirmed.length > 0 && `。未確認：${i.confirmation.unconfirmed.filter((u) => !/URL/.test(u)).join('・')}`}</p>
        <div class="tw-actions">
          <a class="btn tw-btn ghost" href={extHref(i)} target="_blank" rel="noopener nofollow" data-track="ev-ext" data-show={i.siteId} data-place="xdate-card">{i.urlChecked ? '公式ページで詳細・予約を見る' : '公式サイトを検索して予約ページへ'}</a>
        </div>
      </article>
    ))}
    </div>
  </div>
))}

<div class="genre-block">
  <h3 class="def-sub serif">{GENRE_LABEL.story}</h3>
  <p class="lede">キャストとの会話や選択で物語が進む体験です。以下は株式会社ex Labsが企画・制作した公演（公式確認 {latestStoryText}）。◯の日付をタップすると予約サイトで空席を確認できます。</p>
{storyShows.length > 0 && <div class="cal-grid">{storyShows.map((s) => <ShowCalendar show={s} place="xdate-cal" now={now} priceMain={(() => { const r = story.find((x) => x.w.id === s.id)!; return r.totalFor(2) !== undefined ? total2(r) : '料金は公式で確認'; })()} priceSub={(() => { const r = story.find((x) => x.w.id === s.id)!; return `2名の総額｜${r.formatLabel}`; })()} />)}</div>}
  <div class="sc-grid">
  {story.map((r) => (
    <article class="sc-card" id={`item-${r.w.id}`}>
      <p class="tw-area">{r.venue ? `${r.venue.listName ?? r.venue.name}${r.venue.station ? `（${r.venue.station}）` : ''}` : '会場は公式ページで確認'}　｜　当社主催・制作</p>
      <h4 class="tw-name serif">{r.w.title}</h4>
      <dl class="tw-dl">
        <div><dt>体験内容</dt><dd class="dd-normal">{r.w.summary}</dd></div>
        <div><dt>二人での参加</dt><dd class="dd-normal">{r.w.party.text}（{r.formatLabel}）{r.w.party.text.includes('離れる') ? '' : ''}</dd></div>
        <div><dt>費用（二人分）</dt><dd class="dd-normal">2名で{total2(r)}（{r.w.price.unit === 'per-group' ? '1組料金' : '1人料金×2'}、税込）。{r.w.price.feeNote}</dd></div>
        <div><dt>時間</dt><dd class="dd-normal">{r.w.duration.text}。{(r.w.info.requirements ?? []).find((x) => /遅れ|入場/.test(x)) ?? ''}</dd></div>
        <div><dt>開催状況</dt><dd class="dd-normal">期間限定。確認できた開催日 {r.datesText}。空き状況は公式予約ページで確認</dd></div>
        <div><dt>選ぶ理由</dt><dd class="dd-normal">{r.w.info.actorInteraction === true ? 'キャストと会話しながら進めたい二人向け。' : ''}{r.w.party.format === 'private' ? '申込単位で貸切のため、二人だけで体験できます。' : r.w.party.format === 'shared' ? '1名ずつのチケットで同じ回に参加します（他の参加者も一緒）。' : ''}{r.w.info.participation ?? ''}</dd></div>
        <div><dt>注意点</dt><dd class="dd-normal">{r.w.info.ageRule ?? '年齢条件は公式で確認'}。{r.venue?.setting ? SETTING[r.venue.setting] : ''}{r.w.info.walking ? `。${r.w.info.walking}` : ''}{r.w.info.scary ? `。${r.w.info.scary}` : ''}</dd></div>
      </dl>
      <p class="tw-meta" style="margin-top:10px">出典：<a href={r.w.officialUrl} style="color:var(--accent)" data-track="show" data-show={r.w.id} data-place="xdate-card">公式ページ</a>（{r.verifiedText} 確認）</p>
