---
// 「東京 友達 遊ぶ」「東京 大人 遊び場」「東京 体験 友達」の受け皿（需要量は未計測の仮説）。
// 役割：2〜4人の友達グループが、人数ごとの総額・全員が同じ組か・貸切か相席か・会話の多さ・時間・雨の日で体験を選ぶ。
// デート（2人）向けは /guide/tokyo-experience-date/ ほか、公演の日程は /guide/immersive-tokyo/ に任せる。
// 自社公演は src/data/events/、他社は src/data/nazoDate.ts から生成し、料金を手書きしない（未確認は「公式で確認」）。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import DateCta from '../../components/guide/DateCta.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import VisualHero from '../../components/VisualHero.astro';
import { buildGuideRows, fmtYen } from '../../lib/tokyoGuide';
import { publishedNazoItems } from '../../data/nazoDate';
import { jsonLd } from '../../lib/microcms';
import DateInfo from '../../components/guide/DateInfo.astro';
import DateChecklist from '../../components/guide/DateChecklist.astro';
import OutingCards from '../../components/guide/OutingCards.astro';
import { buildOutings, type Outing } from '../../lib/outingCatalog';

const now = new Date();
const MODIFIED = '2026-10-01';
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const pageUrl = new URL('/guide/tokyo-friends-activities/', site).toString();
const SIZES = [2, 3, 4];

type Row = { id: string; name: string; area: string; kind: string; party: string; totals: string[]; priceOne?: string; together: string; groupShort: string; timeShort: string; talk: string; time: string; weather: string; note: string; href: string; own: boolean; siteId: string; privateGroup?: boolean; talkHeavy?: boolean };

const own: Row[] = buildGuideRows(now).filter((r) => r.status !== 'ended').map((r) => ({
  id: r.w.id, name: r.w.title, area: r.venue?.listName ?? r.venue?.name ?? '東京', kind: `物語参加型（${r.organizer.relationLabel}）`,
  party: r.w.party.text,
  totals: SIZES.map((n) => { const t = r.totalFor(n); return t !== undefined ? fmtYen(t) : r.w.party.min > n || (r.w.party.max !== undefined && r.w.party.max < n) ? '申込不可' : '公式で確認'; }),
  // 人数ごとの総額が1つも計算できない（料金単位が未確認）ときは、「公式で確認」を3回並べず料金の案内を1つだけ出す
  priceOne: [2, 3, 4].every((n) => r.totalFor(n) === undefined) ? r.w.price.text : undefined,
  together: r.w.party.format === 'private' ? '全員が同じ組（申込単位で貸切）' : r.w.party.format === 'shared' ? '同じ回に参加（他の参加者と相席）' : r.formatLabel,
  groupShort: r.w.party.format === 'private' ? '申込単位で貸切' : r.w.party.format === 'shared' ? '他の参加者と相席' : '',
  talk: r.w.info.participation ?? '公式ページで確認',
  time: r.w.duration.minutes ? `約${r.w.duration.minutes}分（集合・受付は別）` : r.w.duration.text,
  timeShort: r.w.duration.minutes ? `約${r.w.duration.minutes}分` : '',
  weather: r.venue?.setting === 'indoor' ? '屋内で完結' : r.venue?.setting === 'mixed' ? '受付後に屋外の徒歩移動あり' : '公式ページで確認',
  note: [r.w.info.ageRule, r.w.info.scary].filter(Boolean).join('。'),
  href: r.ticketUrl ?? r.w.officialUrl, own: true, siteId: r.w.id,
  privateGroup: r.w.party.format === 'private', talkHeavy: r.w.info.actorInteraction === true,
}));
const ext: Row[] = publishedNazoItems.filter((i) => i.privacy === 'room').map((i) => ({
  id: i.id, name: i.name, area: i.area.replace('東京・', ''), kind: '室内の脱出ゲーム', party: i.players,
  totals: SIZES.map((n) => {
    if (n === 2) return i.perPerson2 ? `${(i.perPerson2.low * 2).toLocaleString('ja-JP')}〜${(i.perPerson2.high * 2).toLocaleString('ja-JP')}円` : '公式で確認';
    return i.id === 'zettai-kukan-ikebukuro' && i.perPerson2 ? `${(i.perPerson2.low * n).toLocaleString('ja-JP')}〜${(i.perPerson2.high * n).toLocaleString('ja-JP')}円（1人料金×人数）` : '公式の料金表で確認';
  }),
  together: '全員が同じチーム（部屋を一組で貸切）', groupShort: '部屋を一組で貸切',
  talk: '全員で相談しながら謎を解く（キャストとの会話はなし）', time: i.totalMinutes !== undefined ? i.totalTime : `${i.timeLimit.startsWith('本編') ? '' : '本編 '}${i.timeLimit}（受付を含む時間は公式で確認）`,
  timeShort: i.totalMinutes !== undefined ? `全体 約${i.totalMinutes}分` : `${i.timeLimit.startsWith('本編') ? '' : '本編 '}${i.timeLimit}`,
  weather: i.indoor, note: i.tax, href: i.officialUrl, own: false, siteId: i.siteId, privateGroup: true, talkHeavy: false,
}));
const rows = [...own, ...ext];
// 4人以上・グループで遊ぶゲーム（HACKTALE の頭脳戦、UNLIMITED MYSTERY のマダミス）。作品データから
const groupGames = buildOutings(now).filter((o) => o.kind === 'madamis' || o.kind === 'zunousen');
const groupFit = (o: Outing) => o.kind === 'madamis' ? `ちょうど${o.partyText}そろうグループ。推理と会話をじっくり楽しみたい人向け` : '2〜4人で申し込み、他の参加者とも同じ卓で交渉・推理を楽しみたい人向け';
const checkedRows = [...buildOutings(now).filter((o) => o.checked).map((o) => ({ checked: o.checked }))];
// 同じ値が続く人数（例：3名・4名とも「公式の料金表で確認」）はまとめて1回だけ出す
const runs = (ts: string[]) => ts.reduce<{ t: string; i: number; n: number }[]>((a, t, i) => { const l = a[a.length - 1]; if (l && l.t === t && !/円|¥/.test(t)) l.n++; else a.push({ t, i, n: 1 }); return a; }, []);
const names = (xs: Row[]) => xs.map((r) => r.name).join('、');
const privateRows = rows.filter((r) => r.privateGroup);
const castRows = rows.filter((r) => r.talkHeavy);
const indoorRows = rows.filter((r) => /屋内/.test(r.weather));

const faqs = [
  { q: '友達3〜4人で、全員同じ組で遊べますか？', a: `${privateRows.length ? `${names(privateRows)}は、申込単位または部屋ごとの貸切なので、申し込んだ全員が同じ組で遊べます。` : ''}${rows.filter((r) => !r.privateGroup).length ? `${names(rows.filter((r) => !r.privateGroup))}は同じ回の他の参加者と一緒になる、または貸切かどうかを公式で確認する必要があります。` : ''}` },
  { q: '人数で料金は変わりますか？', a: `体験によって違います。${own.filter((r) => r.totals.every((t) => /¥/.test(t))).map((r) => `${r.name}は2名${r.totals[0]}・3名${r.totals[1]}・4名${r.totals[2]}`).join('。')}${own.some((r) => r.totals.every((t) => /¥/.test(t))) ? '。' : ''}人数で1人あたりの料金が変わる施設もあるため、表の「公式の料金表で確認」は予約前に確認してください。` },
  { q: '会話が得意でない人がいても楽しめますか？', a: `${castRows.length ? `${names(castRows)}はキャストとの会話が進行の一部です。` : ''}脱出ゲームは仲間内の相談が中心で、キャストと話す場面はありません。グループの雰囲気に合わせて選んでください。` },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const title = '東京で友達と遊ぶ体験｜2〜4人で楽しめる屋内・謎解き・物語体験を比較';
const desc = '東京で友達2〜4人と遊べる体験を、人数ごとの総額、全員が同じ組か、貸切か相席か、会話の多さ、所要時間、雨の日の屋内外で比較。物語に参加する公演と、部屋を貸し切る脱出ゲームを並べ、予約先へ直接進めます。';
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description: desc, inLanguage: 'ja',
  image: [new URL('/assets/guide/tokyo-friends-activities.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-09-27', dateModified: MODIFIED, mainEntityOfPage: pageUrl,
};
const chips = [`${rows.length}件を比較`, '2〜4人の総額', ...(privateRows.length ? [`全員同じ組で遊べる ${privateRows.length}件`] : [])];
---
<BaseLayout
  title="東京で友達と遊ぶ体験｜2〜4人で楽しめる屋内・謎解き・物語体験を比較 - 株式会社ex Labs"
  description="東京で友達2〜4人と遊べる体験を、人数ごとの総額、全員が同じ組か、貸切か相席か、会話の多さ、所要時間、雨の日の屋内外で比較。物語に参加する公演と、部屋を貸し切る脱出ゲームを並べ、予約先へ直接進めます。"
  ogImage="/assets/guide/tokyo-friends-activities.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '解説記事一覧', href: '/guide/' },
  { name: '東京で友達と遊ぶ体験' },
]} />

<VisualHero image="/assets/events/kaitou-kv.webp" imagePos="center 45%" eyebrow="WITH FRIENDS" catchText="いつもの集まりを、体験に変える" chips={chips} alt="東京で開催中の体験型公演のキービジュアル">
  <h1>東京で友達と遊ぶ体験｜2〜4人で楽しめる屋内・謎解き・物語体験</h1>
</VisualHero>

<section class="section" style="padding-top:28px"><div class="wrap">
<p class="lede">体験型の遊びとは、食事やカラオケのように「過ごす場所」を選ぶのではなく、みんなで何かに挑戦する時間そのものを楽しむ遊び方のことです。友達2〜4人で遊ぶときに気になる<strong>「人数で総額はいくらか」「全員が同じ組になれるか」「会話が多いか少ないか」</strong>を、体験ごとに並べました。</p>
<div class="key-points"><p class="key-points-h">このページでできること</p><ul>
<li>2名・3名・4名それぞれの総額を見比べられます。</li>
<li>全員が同じ組か、貸切か相席か、会話の多さ、雨の日の屋内外から選べます。</li>
<li>気になった体験は、そのまま予約ページへ進めます。</li>
</ul></div>
<DateInfo modified={MODIFIED} rows={checkedRows} />
</div></section>

<section class="section tinted" id="compare"><div class="wrap">
<h2 class="cards-h">比較表<span>人数ごとの総額・同じ組か・時間・雨の日</span></h2>
<div class="cmp-wrap"><table class="cmp-table cmp-x"><thead><tr><th>体験</th><th>人数</th><th>2名の総額</th><th>3名の総額</th><th>4名の総額</th><th>全員が同じ組か</th><th>会話の多さ</th><th>所要時間</th><th>雨の日</th><th>予約</th></tr></thead><tbody>
{rows.map((r) => (
  <tr>
    <th scope="row"><a href={`#item-${r.id}`} style="color:var(--ink)">{r.name}</a><span class="cmp-sub">{r.area}／{r.kind}</span></th>
    <td>{r.party}</td>{r.priceOne ? <td colspan="3">{r.priceOne}</td> : runs(r.totals).map((g) => <td colspan={g.n > 1 ? String(g.n) : undefined}>{g.n > 1 && /確認/.test(g.t) ? `${SIZES.slice(g.i, g.i + g.n).join('・')}名は${g.t}` : g.t}</td>)}<td>{r.together}</td><td>{r.talk}</td><td>{r.time}</td><td>{r.weather}</td>
    <td><a class="cmp-btn" href={r.href} target="_blank" rel={r.own ? 'noopener' : 'noopener nofollow'} data-track={r.own ? 'ticket' : 'ev-ext'} data-show={r.siteId} data-place="friends-table">{r.own ? '予約サイト →' : '公式ページ →'}</a></td>
  </tr>
))}
</tbody></table></div>
<p class="cards-note">総額は通常料金で、手数料や税区分は各予約ページでご確認ください。「申込不可」はその人数では申し込めないという意味です。「公式で確認」の人数は、料金を各予約ページでご確認ください。</p>
</div></section>

<section class="section" id="pick"><div class="wrap">
<h2 class="cards-h">グループに合わせて選ぶ<span>目的別</span></h2>
<div class="pick-grid">
<div class="pick-col"><p class="pick-h">仲間内だけで遊びたい</p><p class="pick-p">{privateRows.length ? <>{privateRows.map((r, i) => <>{i > 0 && '／'}<a href={`#item-${r.id}`}>{r.name}</a></>)}は、申し込んだ全員だけで遊べます。</> : '現在掲載していません。'}</p></div>
<div class="pick-col"><p class="pick-h">物語やキャストとの会話を楽しみたい</p><p class="pick-p">{castRows.length ? <>{castRows.map((r, i) => <>{i > 0 && '／'}<a href={`#item-${r.id}`}>{r.name}</a></>)}はキャストとの会話が進行の一部です。演技は求められません。</> : '現在掲載していません。'}</p></div>
<div class="pick-col"><p class="pick-h">会話が苦手な人もいる</p><p class="pick-p">{ext.length ? <>{ext.map((r, i) => <>{i > 0 && '／'}<a href={`#item-${r.id}`}>{r.name}</a></>)}は仲間内の相談が中心で、キャストと話す場面はありません。</> : ''}</p></div>
<div class="pick-col"><p class="pick-h">雨の日</p><p class="pick-p">{indoorRows.length ? <>{indoorRows.map((r, i) => <>{i > 0 && '／'}<a href={`#item-${r.id}`}>{r.name}</a></>)}は屋内で完結します。駅からの移動は各公式ページでご確認ください。</> : ''}</p></div>
</div>
</div></section>

<section class="section tinted" id="items"><div class="wrap">
<h2 class="cards-h">体験ごとの詳細</h2>
<div class="sc-grid">
{rows.map((r) => (
  <article class="sc-card" id={`item-${r.id}`}>
    <p class="tw-area">{r.area}　｜　{r.kind}</p>
    <h3 class="tw-name serif">{r.name}</h3>
    <dl class="tw-dl">
      <div><dt>人数・同じ組か</dt><dd class="dd-normal">{r.party}。{r.together}</dd></div>
      {r.priceOne ? <div><dt>料金</dt><dd class="dd-normal">{r.priceOne}</dd></div> : <div><dt>総額（2名／3名／4名）</dt><dd class="dd-normal">{runs(r.totals).map((g) => /確認/.test(g.t) ? `${SIZES.slice(g.i, g.i + g.n).join('・')}名は${g.t}` : SIZES.slice(g.i, g.i + g.n).map((n) => `${n}名 ${g.t}`).join('／')).join('／')}</dd></div>}
      <div><dt>参加者がすること</dt><dd class="dd-normal">{r.talk}</dd></div>
      <div><dt>時間／雨の日</dt><dd class="dd-normal">{r.time}／{r.weather}</dd></div>
      {r.note && <div><dt>注意点</dt><dd class="dd-normal">{r.note}</dd></div>}
    </dl>
    <p class="fr-sum">{[r.priceOne ? r.priceOne.replace(/（.*$/, '') : /確認|不可/.test(r.totals[0]) ? '' : `2名 ${r.totals[0]}`, r.timeShort, r.groupShort].filter(Boolean).join('・')}</p>
    <div class="tw-actions"><a class={`btn tw-btn${r.own ? '' : ' ghost'}`} href={r.href} target="_blank" rel={r.own ? 'noopener' : 'noopener nofollow'} data-track={r.own ? 'ticket' : 'ev-ext'} data-show={r.siteId} data-place="friends-card">{r.own ? '予約サイトで空席を見る' : '公式ページで料金・予約を見る'}</a></div>
  </article>
))}
</div>
<DateCta place="friends-mid" links={[{ title: 'HACKTALE（頭脳戦・心理戦の公演）', href: '/hacktale/' }, { title: 'UNLIMITED MYSTERY（東大マーダーミステリーサークルのマダミス）', href: '/toudaimurder/' }]} />
</div></section>

{groupGames.length > 0 && (
<section class="section" id="group"><div class="wrap">
<h2 class="cards-h">4人以上で集まるなら<span>マダミス・頭脳戦（株式会社ex Labs制作）</span></h2>
<p class="lede" style="text-align:left">マーダーミステリー（マダミス）は、作品ごとに遊ぶ人数が決まっていて、ちょうどの人数で貸し切って遊びます。HACKTALE の頭脳戦は1人から予約でき、他の参加者と同じ卓で交渉や推理を楽しみます。予算は4人で申し込んだときの総額です（その人数で遊べない作品は1人あたりの料金）。</p>
<OutingCards items={groupGames} party={4} place="friends-group" fit={groupFit} />
</div></section>
)}

<section class="section" id="check"><div class="wrap narrow">
<h2 class="cards-h">予約前に確認すること</h2>
<ul class="bullets">
<li><strong>人数の上限・下限</strong>：申し込める人数が決まっている体験があります。当日に人数が変わる可能性があるなら、変更の扱いも確認します。</li>
<li><strong>料金の単位</strong>：1人料金か、1組料金か。人数で1人あたりが変わる料金もあります。</li>
<li><strong>年齢と内容</strong>：18歳以上の公演や、怖い描写を含む作品があります。全員が参加できるかを確認します。</li>
<li><strong>集合時刻</strong>：受付に遅れると参加できない体験があります。待ち合わせは早めに。</li>
</ul>
<DateChecklist />
</div></section>

<section class="section tinted" id="faq"><div class="wrap">
<h2 class="cards-h">よくある質問</h2>
<div class="faq-list tag-immersive">
{faqs.map((f) => (<div class="faq-item"><p class="faq-q">{f.q}</p><p class="faq-a">{f.a}</p></div>))}
</div>
<DateCta place="friends-end" links={[{ title: 'HACKTALE（頭脳戦・心理戦の公演）', href: '/hacktale/' }, { title: 'UNLIMITED MYSTERY（東大マーダーミステリーサークルのマダミス）', href: '/toudaimurder/' }]} />
</div></section>

<section class="section"><div class="wrap">
<p class="cmp-note-p">物語参加型の公演は、各行に記載のとおり株式会社ex Labsが企画・制作またはプロデュースしています。</p>
<p class="vc-line" style="margin-top:20px">あわせて読む：<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京で体験できるイマーシブイベント</a>／<a href="/guide/tokyo-nazo-date/" style="color:var(--accent)">二人で楽しめる謎解き・脱出ゲーム</a>／<a href="/guide/tokyo-experience-date/" style="color:var(--accent)">東京の非日常デート</a>／<a href="/guide/madamis-tokyo/" style="color:var(--accent)">東京でマダミスを遊ぶには</a>／<a href="/hacktale/" style="color:var(--accent)">8人で遊ぶ頭脳戦（HACKTALE）</a></p>
</div></section>

<AuthorBox />
<LatestPosts category="immersive" />
</BaseLayout>

<style>
.wrap.narrow{max-width:820px}
.cards-h{margin:0;font-size:20px;font-weight:800;letter-spacing:.06em;color:var(--ink);text-align:left;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px}
.cards-h span{font-size:12.5px;font-weight:700;color:#0B35C8}
.cards-note{margin:14px 0 0;font-size:11.5px;line-height:1.7;color:rgba(29,29,31,.55);text-align:left}
.cmp-wrap{margin-top:16px}
.cmp-x th[scope=row]{min-width:170px;white-space:normal}
.cmp-x td{min-width:100px;vertical-align:top;font-size:13px}
.cmp-sub{display:block;font-size:11px;font-weight:700;color:var(--accent);margin-top:2px}
.cmp-btn{display:inline-block;background:var(--accent);color:#fff !important;font-weight:800;font-size:12.5px;padding:8px 12px;border-radius:999px;text-decoration:none !important;white-space:nowrap}
.cmp-note-p{max-width:920px;margin:0 auto;font-size:12.5px;line-height:1.8;color:rgba(51,48,43,.62);text-align:left}
.pick-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:14px;margin-top:16px}
.pick-col{background:#fff;border:var(--bd);border-radius:12px;box-shadow:var(--shadow-1);padding:16px 18px;text-align:left}
