const site = Astro.site ?? new URL('https://kabuexlabs.com');

const toc = [
  { id: 'about', label: '体験型イベントとは' },
  { id: 'types', label: '種類と選び方（ジャンル別）' },
  { id: 'merit', label: '企業・施設が導入するメリット' },
  { id: 'examples', label: '事例（日経掲載の周遊型イマーシブほか）' },
  { id: 'flow', label: '企画・開催の流れと費用' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: '体験型イベントとは何ですか？',
    a: '来場者が「観る・買う」だけでなく、謎解き・推理・物語への没入などを通じて自ら参加して楽しむイベントの総称です。謎解きイベント・マーダーミステリー・イマーシブ（没入型体験）・参加型の対戦イベントなどが代表的な形式です。',
  },
  {
    q: '体験型イベントにはどんな種類がありますか？',
    a: '大きく、謎解き型（協力してパズルや謎を解く）、マダミス型（登場人物になりきり推理する）、イマーシブ型（物語世界に入り込む）、頭脳戦型（交渉・心理戦で競う）に分かれます。目的と客層によって最適な形式が変わります。',
  },
  {
    q: '体験型イベントはなぜ集客に効果があるのですか？',
    a: '「そこでしか体験できないこと」自体が来場の目的になるためです。体験時間が長く滞在・消費が伸びること、感想を語りたくなるためSNS・口コミで広がりやすいことも、従来型の販促イベントとの大きな違いです。',
  },
  {
    q: '開催費用はどのくらいかかりますか？',
    a: '形式と規模により、小規模で数十万円台から、施設全体を使う大型企画で数百万円規模までさまざまです。株式会社ex Labsではレベニューシェア型（成果報酬型）に対応しており、案件によっては初期費用0円または格安で開催できます。',
  },
  {
    q: '企画から運営まで任せられますか？',
    a: '任せられます。株式会社ex Labsは謎解き・マダミス・イマーシブ・頭脳戦の全ジャンルを自社制作しており、企画・制作・集客・当日運営まで一貫対応します。ご相談・お見積りは無料です。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const definedTermLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: '体験型イベント',
