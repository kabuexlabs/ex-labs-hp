const toc = [
  { id: 'flow', label: '遊び方・当日の流れ6ステップ' },
  { id: 'time', label: '所要時間の目安（何時間かかる？）' },
  { id: 'items', label: 'マダミスに必要なもの' },
  { id: 'choose', label: '初心者向け作品の選び方と初参加のコツ' },
  { id: 'nigate', label: '演技が苦手・人見知りでも大丈夫？' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: 'マダミスは何時間かかりますか？',
    a: '作品により60分〜4時間以上まで幅があります。初心者向けの短編は60〜90分、店舗公演で主流の中編は2〜3時間が目安です。読み込み・議論・解説まで含めた時間なので、当日は余裕を持って予定を空けておくのがおすすめです。',
  },
  {
    q: 'マダミスに必要なものは何ですか？',
    a: '店舗公演なら基本的に手ぶらで参加できます。資料・小道具はすべて用意されています。オンラインの場合はPCまたはスマホと通話環境（Discordなど）が必要です。',
  },
  {
    q: '一人でも参加できますか？',
    a: 'できます。店舗公演には一人参加の枠があり、当日集まった参加者と一緒に遊ぶスタイルが一般的です。マダミスは全員が「登場人物」として役をもらうので、初対面でも自然に会話が始まります。',
  },
  {
    q: '演技が苦手でも楽しめますか？',
    a: '楽しめます。マダミスの「演技」は上手に演じることではなく、キャラクターの目的に沿って考え、話すことです。口数が少ない役や聞き役に回れるキャラクターもあり、人見知りの方でも問題ありません。',
  },
  {
    q: '同じ作品をもう一度遊べますか？',
    a: '原則として同じ作品は一度しか遊べません。真相を知った状態では成立しないためです。だからこそ一回一回の体験が特別なものになります。ネタバレは厳禁というのがマダミスの共通マナーです。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'マダミスの遊び方｜初心者向けに流れ・所要時間・必要なものを解説',
  about: 'マーダーミステリー（マダミス）の遊び方・初心者ガイド',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/madamis-asobikata.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs' },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs' },
