const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '動画・配信用マダミスの制作依頼｜視聴者も楽しめる企画と準備',
  description: '動画やライブ配信に使うマダミス制作を、出演者・視聴者の情報設計、収録時間、画面素材、進行、配信・アーカイブの公開範囲から解説。シナリオ制作と映像制作の分担、リハーサルの確認事項を、マダミス制作会社の株式会社ex Labsが整理します。',
  inLanguage: 'ja',
