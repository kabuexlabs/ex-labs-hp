const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '東京で夜の植物園を楽しむ｜夢の島熱帯植物館の特別な夜間体験',
  about: [
    { '@type': 'Thing', name: '東京の植物園・庭園の夜間開園' },
    { '@type': 'Place', name: '夢の島熱帯植物館', url: 'https://www.yumenoshima.jp/botanicalhall', address: { '@type': 'PostalAddress', streetAddress: '夢の島2-1-2', addressLocality: '江東区', addressRegion: '東京都', addressCountry: 'JP' } },
  ],
  inLanguage: 'ja',
  image: [new URL('/assets/events/gensou-kv.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-10-27',
  dateModified: '2026-10-27',
  mainEntityOfPage: new URL(PATH, site).toString(),
