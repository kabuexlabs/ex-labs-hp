const site = Astro.site ?? new URL('https://kabuexlabs.com');
const PATH = '/guide/tokyo-night-botanical-garden/';
const TICKET = 'https://escape.id/gensou-org/e-ichi/';
const LP = '/gensou/';
const VENUE_GUIDE = '/guide/yumenoshima-night/';
const FROM = '2026-11-05';
const TO = '2026-11-22';
const today = jstDateString(new Date());
const phase = today > TO ? 'ended' : today >= FROM ? 'live' : 'before';

// 通常時の閉園時刻（各施設の公式サイトの記載。2026-10-26 確認）
const gardens = [
  { name: '夢の島熱帯植物館', where: '江東区・東京都の施設', hours: '9:30〜17:00（入館は16:00まで）', url: 'https://www.yumenoshima.jp/botanicalhall' },
  { name: '神代植物公園', where: '調布市・都立公園', hours: '9:30〜17:00（入園は16:00まで）。大温室は16:30閉門', url: 'https://www.tokyo-park.or.jp/park/jindai/index.html' },
  { name: '小石川植物園', where: '文京区・東京大学の附属植物園', hours: '9:00〜16:30（入園は16:00まで）', url: 'https://koishikawa-bg.jp/overview/guide/' },
  { name: '新宿御苑', where: '新宿区・環境省', hours: '10月1日〜3月14日は9:00〜16:30（入園は16:00まで）。温室は9:30〜16:00', url: 'https://policies.env.go.jp/national-garden/shinjukugyoen/guide/information/' },
  { name: '板橋区立熱帯環境植物館', where: '板橋区', hours: '10:00〜18:00（入館は17:30まで）', url: 'https://www.city.itabashi.tokyo.jp/kusei/chosha/1043016/1042967/1043209.html' },
  { name: '渋谷区ふれあい植物センター', where: '渋谷区', hours: '10:00〜21:00（入園は20:30まで）', url: 'https://www.city.shibuya.tokyo.jp/shisetsu/bunka-shisetsu/bunka-shisetsu/fureai.html' },
];
// 2026年11月に夜（17時以降）に入れる機会（公式サイトの記載。2026-10-26 確認）
const nights = [
  { name: '夢の島熱帯植物館', kind: '植物館（閉館後の公演）', when: '11月5日〜22日の木〜日曜。17:00〜20:00に12分おきに開始（最終回は20:50終了予定）', entry: '公演チケット（個別3,500円・グループ14,000円。税込・入館料込み）', own: true },
  { name: '渋谷区ふれあい植物センター', kind: '植物園（通常の開園時間）', when: '毎日21:00まで（入園は20:30まで）。月曜休園（祝日・振替休日の場合は翌平日）', entry: '入園料100円（小学生以上）', own: false },
  { name: '小石川後楽園「深山“光”葉を楽しむ」', kind: '庭園（夜間特別開園）', when: '11月13日〜24日。18:00〜21:00（最終入園20:00）', entry: '夜間特別観賞券が必要（通常の入園券では入れない）', own: false },
  { name: '六義園「庭紅葉の六義園 夜間特別観賞」', kind: '庭園（夜間特別観賞）', when: '11月25日〜12月6日。18:00〜20:30（最終入園19:30）', entry: '前売1,000円（11月1日9:00からオンライン販売）・当日1,200円', own: false },
