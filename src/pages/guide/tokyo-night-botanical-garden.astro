  { id: 'diff', label: '通常の植物館見学との違い' },
  { id: 'info', label: '開催日・料金・所要時間' },
  { id: 'access', label: 'アクセス・服装・参加条件' },
  { id: 'ticket', label: 'チケット予約' },
  { id: 'faq', label: 'よくある質問' },
];
const faqs = [
  { q: '東京で夜まで開いている植物園はありますか？', a: '渋谷区ふれあい植物センターは通常の開園時間が10:00〜21:00（入園は20:30まで）で、夜も入れます（月曜休園）。神代植物公園・小石川植物園・新宿御苑・夢の島熱帯植物館は16:30〜17:00ごろ、板橋区立熱帯環境植物館は18:00に閉まります（各施設の公式サイトの記載）。' },
  { q: '夢の島熱帯植物館は夜も開いていますか？', a: '通常の開館時間は9:30〜17:00（入館は16:00まで）です。2026年11月5日〜22日の木〜日曜は、閉館後の館内で物語体験「午前零時の幻想集 第一夜『草陰の夢』」を行い、17:00〜20:00に12分おきに回が始まります。参加には公演チケットが必要です。' },
  { q: '二人で参加する場合、チケットはどう選べばいいですか？', a: '個別チケット（1名3,500円）を2枚買うと合計7,000円で、ほかのお客様と同じ組になる場合があります。二人だけで回りたい場合は、最大4名で貸切になるグループチケット（1組14,000円）を選びます。どちらも税込・入館料込みです。' },
  { q: '雨の日も開催しますか？', a: '「午前零時の幻想集」は植物館の屋内で行うため、雨の日も開催します。集合は植物館の正面入口で、受付が始まるまでは植物館前（屋外）で待ちます。' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
