---
// 「イマーシブ 一人」「イマーシブ体験 東京 一人」「イマーシブシアター 一人参加」の受け皿。
// 東京ガイド（/guide/immersive-tokyo/）の補助ページ。最初に「1名で申し込める公演の開催日カレンダー」を出し、
// ◯の日付から予約サイトへ直行できるようにする。「一人で予約できる」と「一人だけで体験する」の区別などの
// 説明は折りたたみに置く。公演の条件は src/data/events/（/events/ と共通）から生成し、手書きしない。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ShowCalendar from '../../components/ShowCalendar.astro';
import { buildGuideRows } from '../../lib/tokyoGuide';
import { shows } from '../../data/shows';
import { jsonLd } from '../../lib/microcms';

const now = new Date();
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const pageUrl = new URL('/guide/immersive-tokyo-solo/', site).toString();
const rows = buildGuideRows(now).filter((r) => r.status !== 'ended');
const soloBook = rows.filter((r) => r.w.party.soloAllowed);
const soloRun = rows.filter((r) => r.w.party.soloRuns === true);
const needsTwo = rows.filter((r) => !r.w.party.soloAllowed);
const names = (xs: typeof rows) => xs.map((r) => r.w.title).join('、');
const soloShared = rows.filter((r) => r.w.party.soloAllowed && r.w.party.format === 'shared');
const soloOther = rows.filter((r) => r.w.party.soloAllowed && r.w.party.format !== 'shared');
const latest = rows.map((r) => r.w.verified.at).sort().pop();
const latestText = rows.find((r) => r.w.verified.at === latest)?.verifiedText ?? '';
// カレンダー：1名で申し込める公演だけ（Show 形式は shows.ts の変換層）
const soloShows = soloBook.map((r) => shows.find((s) => s.id === r.w.id && s.published)).filter((s): s is NonNullable<typeof s> => !!s);
const soloRunText = (r: (typeof rows)[number]) => r.w.party.soloRuns === true ? '1名だけで成立' : r.w.party.soloRuns === false ? '相席（他の参加者と同じ回）' : r.w.party.soloAllowed ? '相席（公式に記載なし）' : '2名以上の申込が必要';

const faqs = [
  { q: '一人分だけ予約すれば、一人で体験できますか？', a: `公演によります。${soloBook.length ? `${soloShared.length ? `${names(soloShared)}は1名から申し込めますが、他の参加者と同じ回で体験する相席形式です。` : ''}${soloOther.length ? `${names(soloOther)}も1名から申し込めます（相席か貸切かは公式ページで確認）。` : ''}` : '確認できた範囲で1名から申し込める公演はありません。'}${soloRun.length ? `${names(soloRun)}は1名だけで回が成立します。` : '1名だけで回が成立する（相席なし）公演は確認できていません。'}` },
  { q: '知らない人と組むのが不安です。会話は必要ですか？', a: rows.map((r) => `${r.w.title}：${r.w.info.participation ?? '体験中の交流は公式ページで確認'}`).join('。') + '。演技は求められませんが、会話や協力が進行の一部になる公演では、その場で反応する場面があります。' },
  { q: '遅刻や途中退出はできますか？', a: rows.map((r) => `${r.w.title}：${(r.w.info.requirements ?? []).filter((x) => /遅れ|入場/.test(x)).join('、') || '遅刻・途中入場の扱いは公式ページで確認'}`).join('。') + '。途中退出の扱いは各公式ページに記載がないため、予約前に主催者へ確認してください。' },
  { q: '服装や持ち物はどうすればいいですか？', a: '公演の形式ごとの服装・靴・持ち物は「イマーシブ体験の服装・持ち物」の記事にまとめています。スマートフォンとイヤホンを必須にしている公演があるので、そこだけは先に確認してください。' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const title = '東京のイマーシブ体験に一人で参加するには？申込条件・相席・選び方';
const desc = '東京のイマーシブ体験に一人で参加したい人向けに、「一人分で予約できる」と「一人だけで体験する」の違い、申込人数・公演成立人数・相席か貸切か・体験中の交流を公演ごとの公式情報で整理。予約前に確認する点と、一人参加の形式の選び方をまとめました。';
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description: desc, inLanguage: 'ja',
  image: [new URL('/assets/guide/immersive-tokyo-solo.webp', site).toString()],
  author: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', '@id': new URL('/#organization', site).toString(), name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-09-18', dateModified: '2026-09-18', mainEntityOfPage: pageUrl,
};
---
<BaseLayout
  title="東京のイマーシブ体験に一人で参加するには？申込条件・相席・選び方 - 株式会社ex Labs"
  description="東京のイマーシブ体験に一人で参加したい人向けに、「一人分で予約できる」と「一人だけで体験する」の違い、申込人数・公演成立人数・相席か貸切か・体験中の交流を公演ごとの公式情報で整理。予約前に確認する点と、一人参加の形式の選び方をまとめました。"
  ogImage="/assets/guide/immersive-tokyo-solo.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<script is:inline>
// 折りたたみ節へのリンク（#faq 等）で開いた場合は自動で展開する
(function(){function o(){try{var h=location.hash.slice(1);if(!h)return;var el=document.getElementById(h);if(el&&el.tagName==='DETAILS'){el.open=true}}catch(e){}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',o)}else{o()}window.addEventListener('hashchange',o)})();
</script>
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '東京のイマーシブ体験', href: '/guide/immersive-tokyo/' },
  { name: '一人で参加するには' },
]} />

<section class="section" style="padding-top:40px;padding-bottom:8px"><div class="wrap">
<p class="eyebrow">SOLO</p>
<h1 class="h2 serif"><span class="nobr">東京のイマーシブ体験に</span><span class="nobr">一人で参加するには？</span><span class="nobr">申込条件・相席・選び方</span></h1>
<p class="lede"><strong>1名で申し込める公演の開催日</strong>です。◯の日付をタップすると予約サイトで空席を確認できます。「一人で予約できる」と「一人だけで体験する」は別なので、相席か貸切かは下の表で。</p>
<div class="key-points"><p class="key-points-h">要点</p><ul>
<li>イマーシブ体験とは、客席から観るのではなく物語の当事者として空間の中で体験する没入型イベントのことです。</li>
<li>{soloBook.length ? `1名で申し込める公演：${names(soloBook)}${soloShared.length ? '（相席）' : ''}。` : '1名で申し込める公演は確認できていません。'}{needsTwo.length ? `${names(needsTwo)}は2名以上。` : ''}</li>
<li>確認する条件は「1名で申し込めるか」「1名だけで成立するか（相席か）」「会話が必要か」の3つ。</li>
</ul></div>
</div></section>

<section class="section tinted" id="solo-cal"><div class="wrap">
<p class="eyebrow">THIS WEEK</p><h2 class="h2 serif">1名で申し込める公演の開催日</h2>
<p class="cal-legend"><span class="lg lg-open">◯</span> 開催日（タップで予約サイトへ）　<span class="lg lg-sold">×</span> 完売　<span class="lg lg-none">–</span> 開催なし　<span class="lg lg-ended">薄字</span> 終了</p>
{soloShows.length ? (
  <div class="cal-grid">{soloShows.map((s) => <ShowCalendar show={s} place="solo-cal" now={now} meta={`${s.duration}｜${s.capacity}｜${s.price.text}（${s.price.unit}）`} />)}</div>
) : (
  <p class="lede">確認できた範囲で、1名から申し込める公演は現在ありません。開催中の公演は<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京ガイドのカレンダー</a>をご覧ください。</p>
)}
<p class="cmp-note-p">開催日は公式ページで確認した日付（最終確認 {latestText}）。空席は予約サイトの表示が最新です。{needsTwo.length ? `${names(needsTwo)}は2名以上での申込のため、ここには載せていません。` : ''}</p>
</div></section>

<section class="section" id="table"><div class="wrap">
<p class="eyebrow">COMPARE</p><h2 class="h2 serif">一人参加の条件を見比べる</h2>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>公演</th><th>1申込の人数</th><th>相席・貸切</th><th>体験中の交流</th><th>所要時間</th><th>1人あたり</th><th>予約</th></tr></thead><tbody>
{rows.map((r) => (
  <tr>
    <th scope="row"><span class="cmp-title">{r.w.title}</span><span class="cmp-sub">{r.venue ? `${r.venue.listName ?? r.venue.name}` : '会場は公式で確認'}</span></th>
    <td>{r.w.party.text}</td>
    <td>{soloRunText(r)}</td>
    <td>{r.w.info.participation ?? '公式ページで確認'}{r.w.info.actorInteraction === true ? '（キャストとの会話あり）' : ''}</td>
    <td>{r.w.duration.text}</td>
    <td>{r.perPersonText}<br><span class="cmp-note">{r.w.price.feeNote}</span></td>
    <td>{r.ticketUrl ? <a class="cmp-btn" href={r.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={r.w.id} data-place="solo-table">予約サイト →</a> : <span class="cmp-note">公式で確認</span>}<br><a href={r.w.officialUrl} data-track="show" data-show={r.w.id} data-place="solo-table" style="color:var(--accent);font-weight:700;font-size:12.5px">公演内容</a></td>
  </tr>
))}
</tbody></table></div>
<p class="cmp-note-p">1組料金の公演は人数で割った1人あたりの金額（税込、手数料は予約サイトで確認）。二人で参加する条件は<a href="/guide/immersive-tokyo-date/" style="color:var(--accent)">二人で楽しむには</a>へ。</p>
</div></section>

<section class="section tinted acc-wrap"><div class="wrap">
<p class="eyebrow">MORE</p><h2 class="h2 serif">一人参加の形式・予約前の確認・よくある質問</h2>

<details class="acc" id="types">
<summary><span class="acc-t">一人参加の3つの形式と選び方</span><span class="acc-s">相席で申し込む／一人で巡る／複数名が必要</span></summary>
<div class="acc-b">
<ul class="bullets">
<li><strong>一人分で申し込み、他の参加者と同じ回で体験する（相席）</strong>：チケット1枚につき1名で販売され、同じ回に申し込んだ人たちと一緒に進みます。{soloBook.length ? `現在は${names(soloBook)}。` : '現在は確認できた公演がありません。'}</li>
<li><strong>一人で巡る（相席なし）</strong>：1名だけで回が成立し、自分のペースで進めます。{soloRun.length ? `現在は${names(soloRun)}。` : '現在の東京の公演では公式に案内しているものを確認できていません（過去には下北沢の周遊型アート体験、1〜4名、終了）。'}</li>
<li><strong>複数名の予約が必要</strong>：申込の下限が2名以上で、一人では申し込めません。{needsTwo.length ? `現在は${names(needsTwo)}（${needsTwo.map((r) => r.w.party.text).join('、')}）。` : ''}</li>
<li><strong>会話や交流を少なくしたい</strong>：上の表の「体験中の交流」を確認します。{rows.filter((r) => r.w.info.actorInteraction === true).length ? `${names(rows.filter((r) => r.w.info.actorInteraction === true))}はキャストとの会話が進行の一部です。` : ''}演技は求められません。</li>
</ul>
</div>
</details>

<details class="acc" id="check">
<summary><span class="acc-t">一人で予約する前に確認すること</span><span class="acc-s">進行役・会話・遅刻・年齢・持ち物（公式案内より）</span></summary>
<div class="acc-b">
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>確認する点</th>{rows.map((r) => <th>{r.w.title}</th>)}</tr></thead><tbody>
<tr><th scope="row">進行役・サポート</th>{rows.map((r) => <td>{r.w.info.beginner ?? '公式ページで確認'}</td>)}</tr>
<tr><th scope="row">会話の必要性</th>{rows.map((r) => <td>{r.w.info.actorInteraction === true ? 'キャストとの会話が進行の一部' : r.w.info.participation ?? '公式ページで確認'}</td>)}</tr>
<tr><th scope="row">遅刻・途中入場</th>{rows.map((r) => <td>{(r.w.info.requirements ?? []).filter((x) => /遅れ|入場/.test(x)).join('。') || '公式ページで確認'}</td>)}</tr>
<tr><th scope="row">途中退出</th>{rows.map(() => <td>公式に記載なし。予約前に主催者へ確認</td>)}</tr>
<tr><th scope="row">年齢・言語</th>{rows.map((r) => <td>{r.w.info.ageRule ?? '公式で確認'}／{r.w.info.language ?? '公式で確認'}</td>)}</tr>
<tr><th scope="row">移動・持ち物</th>{rows.map((r) => <td>{r.w.info.walking ?? '—'}{(r.w.info.requirements ?? []).filter((x) => /持参|イヤホン|ロッカー/.test(x)).map((x) => `。${x}`).join('')}</td>)}</tr>
</tbody></table></div>
<p class="cmp-note-p">「公式ページで確認」は公式に記載がない、または当社が確認できていない条件です。一般論で補っていません。服装・持ち物は<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物（公演別チェック表）</a>へ。</p>
</div>
</details>

<details class="acc" id="faq">
<summary><span class="acc-t">よくある質問</span><span class="acc-s">一人で体験できるか・会話・遅刻・服装</span></summary>
<div class="acc-b">
<div class="faq-list tag-immersive">
{faqs.map((f) => (<div class="faq-item"><p class="faq-q">{f.q}</p><p class="faq-a">{f.a}</p></div>))}
</div>
</div>
</details>

<p class="cmp-note-p">紹介範囲：このページで扱っているのは、公式ページで申込条件を確認できた公演です（現在は株式会社ex Labsが企画・制作した公演）。東京の全公演を網羅した比較や第三者によるランキングではありません。他社公演は、主催者の公式情報で条件を確認できたものから追加します。</p>
<p class="vc-line" style="margin-top:24px">関連ページ：<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京で体験できるイマーシブイベント</a>／<a href="/guide/immersive-tokyo-date/" style="color:var(--accent)">二人で楽しむには</a>／<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物</a>／<a href="/guide/immersive-theater/" style="color:var(--accent)">イマーシブシアターとは</a>／<a href="/guide/immersive/" style="color:var(--accent)">イマーシブとは</a>／<a href="/events/" style="color:var(--accent)" data-track="show" data-show="events" data-place="solo-cta">公演を探す</a></p>
</div></section>

<AuthorBox />
<LatestPosts category="immersive" />
</BaseLayout>

<style>
#solo-cal,#table{scroll-margin-top:88px}
.cal-legend{max-width:920px;margin:14px auto 0;font-size:12.5px;line-height:2;color:rgba(51,48,43,.75);text-align:left}
.lg{display:inline-block;min-width:22px;text-align:center;font-weight:800}
.lg-open{color:#d9480f}.lg-sold{color:rgba(51,48,43,.5)}.lg-none{color:rgba(51,48,43,.4)}.lg-ended{color:rgba(51,48,43,.35)}
.cal-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),1fr));gap:22px;max-width:1000px;margin:22px auto 0}
.cmp-wrap{margin-top:22px}
.cmp-table th[scope=row]{min-width:150px;white-space:normal}
.cmp-table td{min-width:130px;vertical-align:top}
.cmp-title{display:block;font-weight:800;color:var(--ink)}
.cmp-sub{display:block;font-size:12px;font-weight:500;color:rgba(51,48,43,.65);margin-top:2px}
.cmp-note{display:inline-block;font-size:11.5px;font-weight:500;color:rgba(51,48,43,.65);line-height:1.6;margin-top:2px}
.cmp-note-p{max-width:920px;margin:14px auto 0;font-size:12.5px;line-height:1.8;color:rgba(51,48,43,.62);text-align:left}
.cmp-btn{display:inline-block;background:var(--accent);color:#fff !important;font-weight:800;font-size:12.5px;padding:8px 12px;border-radius:999px;text-decoration:none !important;white-space:nowrap;margin-bottom:6px}
.acc{max-width:920px;margin:14px auto 0;background:#fff;border:var(--bd);border-radius:var(--r-l);box-shadow:var(--shadow-1);scroll-margin-top:88px}
.acc summary{list-style:none;cursor:pointer;padding:18px 22px;display:flex;flex-direction:column;gap:3px;position:relative}
.acc summary::-webkit-details-marker{display:none}
.acc summary::after{content:'＋';position:absolute;right:20px;top:16px;font-size:20px;font-weight:800;color:var(--accent)}
.acc[open] summary::after{content:'−'}
.acc-t{font-size:16.5px;font-weight:800;color:var(--ink);padding-right:32px}
.acc-s{font-size:12.5px;color:rgba(51,48,43,.62)}
.acc-b{padding:0 22px 22px;text-align:left}
.acc-b .lede{text-align:left}
.acc-b .cmp-wrap{margin-top:8px}
.acc-b .bullets{margin-top:8px}
@media(max-width:640px){.acc summary{padding:16px 18px}.acc-b{padding:0 16px 18px}}
</style>
