---
// 「夢の島熱帯植物館」「夢の島熱帯植物館 夜」「夢の島熱帯植物館 イベント」で探す人に向けた案内（2026-10-16 新規）。
// 2026年11月の自社公演「午前零時の幻想集 第一夜『草陰の夢』」を、日程・チケットの選び方・当日の流れ・行き方の順で案内し、
// 公式ページ（/gensou/）と予約サイト（escape.id）へ送る。内容は /gensou/ と公演データ（src/data/events/）の記載だけ。
// 施設の通常の開館時間・入館料は確認できていないため書かない（施設の公式サイトで確認と案内する）。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { jsonLd } from '../../lib/microcms';
import { jstDateString } from '../../lib/thisWeek';

const site = Astro.site ?? new URL('https://kabuexlabs.com');
const TICKET = 'https://escape.id/gensou-org/e-ichi/';
const FROM = '2026-11-05';
const TO = '2026-11-22';
const today = jstDateString(new Date());
const phase = today > TO ? 'ended' : today >= FROM ? 'live' : 'before';
const weeks = [
  { label: '第1週', days: [['11/5', '木'], ['11/6', '金'], ['11/7', '土'], ['11/8', '日']] },
  { label: '第2週', days: [['11/12', '木'], ['11/13', '金'], ['11/14', '土'], ['11/15', '日']] },
  { label: '第3週', days: [['11/19', '木'], ['11/20', '金'], ['11/21', '土'], ['11/22', '日']] },
];
const party = [
  { n: '1人', solo: '3,500円', group: '14,000円', note: '個別チケット。ほかのお客様と同じ組になる場合があります' },
  { n: '2人', solo: '7,000円', group: '14,000円', note: '二人だけの組にしたいならグループチケット' },
  { n: '3人', solo: '10,500円', group: '14,000円', note: '仲間だけで回りたいならグループチケット' },
  { n: '4人', solo: '14,000円', group: '14,000円', note: '同じ金額なので、貸切になるグループチケットが選びやすい' },
];
const toc = [
  { id: 'what', label: '夜の植物館で何をするのか' },
  { id: 'dates', label: '開催日と開始時刻' },
  { id: 'ticket', label: 'チケットの選び方（人数別の総額）' },
  { id: 'flow', label: '当日の流れ' },
  { id: 'access', label: '行き方と帰りの時間' },
  { id: 'before', label: '参加前に知っておきたいこと' },
];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '夜の夢の島熱帯植物館で行われる物語体験',
  about: { '@type': 'Place', name: '夢の島熱帯植物館', address: { '@type': 'PostalAddress', streetAddress: '夢の島2-1-2', addressLocality: '江東区', addressRegion: '東京都', addressCountry: 'JP' } },
  inLanguage: 'ja',
  image: [new URL('/assets/events/gensou-kv.webp', site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-10-16',
  dateModified: '2026-10-16',
  mainEntityOfPage: new URL('/guide/yumenoshima-night/', site).toString(),
};
---
<BaseLayout
  title="夢の島熱帯植物館の夜イベント｜物語体験「午前零時の幻想集」の日程・チケット・行き方（2026年11月） - 株式会社ex Labs"
  description="2026年11月5日〜22日の木〜日曜、夜の夢の島熱帯植物館で物語体験「午前零時の幻想集 第一夜『草陰の夢』」を開催。各日17:00〜20:00に12分おきに開始、約50分。個別3,500円・グループ14,000円（税込・入館料込み）の選び方、当日の流れ、新木場駅からの行き方をまとめました。"
  ogImage="/assets/events/gensou-kv.webp"
>
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: '東京のイマーシブ体験', href: '/guide/immersive-tokyo/' },
  { name: '夜の夢の島熱帯植物館の物語体験' },
]} />

<section class="section yn-hero" style="padding-top:36px"><div class="wrap">
<div class="yn-top">
  <a class="yn-kv" href="/gensou/" data-track="show" data-show="gensou" data-place="yumenoshima-hero"><img src="/assets/events/gensou-kv.webp" alt="午前零時の幻想集 第一夜「草陰の夢」夢の島熱帯植物館" width="880" height="1246" fetchpriority="high"></a>
  <div>
    <p class="yn-eyebrow">{phase === 'live' ? '開催中｜11月22日まで' : phase === 'ended' ? '2026年11月に開催' : '2026年11月5日〜22日 開催'}</p>
    <h1 class="yn-h1 serif"><span class="nobr">夜の夢の島熱帯植物館で</span><span class="nobr">行われる物語体験</span></h1>
    <p class="lede">2026年11月5日から22日までの木〜日曜、普段は入れない夜の夢の島熱帯植物館を巡る物語体験<strong>「午前零時の幻想集 第一夜『草陰の夢』」</strong>を開催します。各日17:00〜20:00に12分おきに始まり、所要時間は約50分。館内を歩きながら、キャストとの会話を通して物語に入り込みます。</p>
    <ul class="yn-keys">
      <li><span>料金</span>個別3,500円／グループ14,000円（最大4名で貸切）。税込・入館料込み</li>
      <li><span>対象</span>中学生以上（18歳未満は保護者同伴）。怖さは控えめ</li>
      <li><span>会場</span>夢の島熱帯植物館（東京都江東区）。新木場駅から徒歩約15分</li>
    </ul>
    {phase !== 'ended' && <p class="yn-cta"><a class="yn-btn" href={TICKET} target="_blank" rel="noopener" data-track="ticket" data-show="gensou" data-place="yumenoshima-hero">日時を選んでチケットを購入（escape.id）↗</a><a class="yn-sub" href="/gensou/" data-track="show" data-show="gensou" data-place="yumenoshima-hero">公式サイトであらすじを見る →</a></p>}
  </div>
</div>
<nav class="toc" aria-label="目次"><p class="toc-h">目次</p><ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol></nav>
</div></section>

<section class="section tinted" id="what"><div class="wrap narrow">
<p class="eyebrow">WHAT</p><h2 class="h2 serif">夜の植物館で何をするのか</h2>
<p class="lede">参加者は、最大4人の組で夜の植物館を巡ります。展示を眺めて回るのではなく、館内にいるキャストと言葉を交わしながら、植物館を舞台にした物語の続きを見届ける体験です。</p>
<p class="lede">暗い場所やキャストとの会話はありますが、怖さは控えめです。キャストが肘から下に触れる場合があります。物語の内容は、参加する方のために公式サイトでも伏せています。</p>
<p class="vc-line"><a href="/gensou/#story" style="color:var(--accent)" data-track="show" data-show="gensou" data-place="yumenoshima-what">あらすじと体験の特徴（公式サイト）→</a></p>
</div></section>

<section class="section" id="dates"><div class="wrap narrow">
<p class="eyebrow">DATES</p><h2 class="h2 serif">開催日と開始時刻</h2>
<p class="lede">開催は木・金・土・日曜の全12日間です。各日17:00から20:00まで、12分おきに回が始まります。</p>
<div class="yn-weeks">
{weeks.map((w) => (
  <div class="yn-week"><p class="yn-wl">{w.label}</p><ul>{w.days.map(([d, wd]) => <li><strong>{d}</strong><span>（{wd}）</span></li>)}</ul></div>
))}
</div>
<p class="lede" style="margin-top:20px"><strong>開始時刻</strong>：17:00、17:12、17:24……と12分おき。最終回は20:00開始で、20:50に終わる予定です。チケットは各回の開始2時間前まで販売します。空き状況は予約サイトで確認できます。</p>
</div></section>

<section class="section tinted" id="ticket"><div class="wrap narrow">
<p class="eyebrow">TICKET</p><h2 class="h2 serif">チケットの選び方（人数別の総額）</h2>
<p class="lede">チケットは2種類です。<strong>個別チケット</strong>（1名3,500円）は1人ずつ購入し、ほかのお客様と同じ組になる場合があります。<strong>グループチケット</strong>（1組14,000円）は最大4名で、仲間だけの貸切で参加できます。どちらも税込・入館料込みです。</p>
<div class="cmp-wrap"><table class="cmp">
<thead><tr><th scope="col">人数</th><th scope="col">個別チケットの合計</th><th scope="col">グループチケット</th><th scope="col">選び方</th></tr></thead>
<tbody>{party.map((p) => <tr><th scope="row">{p.n}</th><td>{p.solo}</td><td>{p.group}</td><td>{p.note}</td></tr>)}</tbody>
</table></div>
<p class="lede" style="margin-top:20px">2回目以降に参加する場合は、グループチケットを購入する決まりです。お客様の都合によるキャンセル・日時変更はできません。</p>
</div></section>

<section class="section" id="flow"><div class="wrap narrow">
<p class="eyebrow">FLOW</p><h2 class="h2 serif">当日の流れ</h2>
<ol class="yn-flow">
<li><span>集合</span><span class="t">開始時刻の5分前までに、夢の島熱帯植物館の正面入口へ。受付が始まるまでは植物館前（屋外）で待ちます。</span></li>
<li><span>受付</span><span class="t">開始時刻の5分前から。escape.idの購入済みチケット画面を見せます。</span></li>
<li><span>体験</span><span class="t">約50分。開始時刻に遅れると参加できません。体験中はお手洗いを使えないため、先に済ませておきます。</span></li>
<li><span>終了</span><span class="t">最終回は20:50終了予定です。</span></li>
</ol>
</div></section>

<section class="section tinted" id="access"><div class="wrap narrow">
<p class="eyebrow">ACCESS</p><h2 class="h2 serif">行き方と帰りの時間</h2>
<p class="lede"><strong>住所</strong>：東京都江東区夢の島2-1-2（夢の島公園内）<br><strong>最寄り駅</strong>：新木場駅（JR京葉線・東京メトロ有楽町線・りんかい線）から徒歩約15分</p>
<p class="lede">集合は開始5分前なので、新木場駅には開始の20分以上前に着くと安心です。最終回（20:00開始）でも20:50に終わる予定で、駅まで歩いて21時過ぎに着く計算です。</p>
<p class="lede">夢の島熱帯植物館は東京都の施設です。このページで案内しているのは夜の物語体験の時間帯で、通常の開館時間・入館料・休館日は施設の公式サイトで確認してください。</p>
<p class="vc-line"><a href="/gensou/#access" style="color:var(--accent)" data-track="show" data-show="gensou" data-place="yumenoshima-access">地図（公式サイトのアクセス）→</a></p>
</div></section>

<section class="section" id="before"><div class="wrap narrow">
<p class="eyebrow">BEFORE</p><h2 class="h2 serif">参加前に知っておきたいこと</h2>
<ul class="bullets">
<li><strong>持ち物</strong>：通信できるスマートフォン。イヤホン、アプリのダウンロード、事前登録は不要です。</li>
<li><strong>服装・荷物</strong>：歩きやすい服装で。荷物は預けられないため、大きな荷物は持たずに行きます。</li>
<li><strong>参加できない場合</strong>：階段の上り下りがあるため、車椅子では入場できません。飲酒した状態では参加できません。</li>
<li><strong>撮影・投稿</strong>：体験中の撮影は禁止です。ネタバレを含まない感想はSNSに投稿できます。</li>
<li><strong>天候</strong>：屋内で行うため、雨の日も開催します。</li>
</ul>
<p class="lede" style="margin-top:18px">二人で行く場合や、ほかの夜の予定と組み合わせる場合は、<a href="/guide/tokyo-night-date/" style="color:var(--accent)">東京の夜デート</a>や<a href="/guide/immersive-tokyo-date/" style="color:var(--accent)">二人で参加できる東京のイマーシブ</a>も参考になります。</p>
{phase !== 'ended' && (
<div class="cta-mini" style="margin-top:36px">
<p class="cta-mini-title serif">夜の夢の島熱帯植物館の物語体験「午前零時の幻想集」</p>
<a class="btn" href={TICKET} target="_blank" rel="noopener" data-track="ticket" data-show="gensou" data-place="yumenoshima-bottom">日時を選んでチケットを購入（escape.id）↗</a>
</div>
)}
<p class="vc-line" style="margin-top:32px">関連ページ：<a href="/gensou/" style="color:var(--accent)">午前零時の幻想集 公式サイト</a>／<a href="/events/gensou/" style="color:var(--accent)">開催日程・料金・予約先の一覧</a>／<a href="/guide/immersive-tokyo/" style="color:var(--accent)">東京で体験できるイマーシブイベント</a>／<a href="/guide/kyoto-kyocera-museum-7th/" style="color:var(--accent)">京都市京セラ美術館で行われる、絵画の物語体験</a></p>
</div></section>

<AuthorBox />

<LatestPosts category="immersive" />

</BaseLayout>

<style>
.wrap.narrow{max-width:820px}
.yn-top{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:32px;align-items:start;max-width:1000px;margin:0 auto}
.yn-kv img{width:100%;height:auto;display:block;border-radius:10px;box-shadow:0 10px 30px rgba(14,20,36,.35)}
.yn-eyebrow{margin:0;display:inline-block;padding:4px 12px;background:#0E1424;color:#C9A961;font-weight:800;font-size:13px;letter-spacing:.08em;border-radius:4px}
.yn-h1{margin:14px 0 0;font-size:clamp(26px,4vw,38px);line-height:1.45;color:#fff;text-wrap:balance}
.yn-keys{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:8px;font-size:14.5px;line-height:1.75;color:#fff}
.yn-keys li{display:grid;grid-template-columns:3em minmax(0,1fr);gap:10px}
.yn-keys span{font-weight:800;color:var(--x-lime,#E1F73E)}
.yn-cta{margin:22px 0 0;display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center}
.yn-btn{display:inline-block;padding:14px 22px;background:#0E1424;color:#fff!important;font-weight:800;font-size:15px;border-radius:999px;text-decoration:none!important;border:1px solid #C9A961}
.yn-sub{font-weight:700;font-size:14.5px;color:#fff!important;border-bottom:1px solid currentColor}
.toc{max-width:520px;margin:40px auto 0;background:#fff;border:1px solid rgba(51,48,43,.08);border-radius:18px;padding:24px 28px}
.toc-h{margin:0 0 12px;font-size:13px;font-weight:800;letter-spacing:.12em;color:var(--accent)}
.toc ol{margin:0;padding-left:1.3em;display:flex;flex-direction:column;gap:8px}
.toc a{font-size:14.5px;font-weight:700;color:rgba(51,48,43,.8)}
.yn-weeks{margin-top:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:12px}
.yn-week{background:#fff;border:1px solid rgba(51,48,43,.12);border-radius:12px;padding:14px 16px}
.yn-wl{margin:0 0 8px;font-weight:800;font-size:13px;color:var(--accent);letter-spacing:.06em}
.yn-week ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 10px;font-variant-numeric:tabular-nums}
.yn-week strong{font-size:16px}.yn-week span{font-size:13px;color:rgba(51,48,43,.7)}
.cmp-wrap{margin:20px 0 0;overflow-x:auto;-webkit-overflow-scrolling:touch}
.cmp{width:100%;min-width:520px;border-collapse:collapse;background:#fff;font-size:14px;line-height:1.75}
.cmp th,.cmp td{border:1px solid rgba(51,48,43,.12);padding:11px 12px;vertical-align:top;text-align:left}
.cmp thead th{background:#F4F1EC;font-weight:800;font-size:13px}
.cmp tbody th{white-space:nowrap;font-weight:800}
.cmp td:nth-child(2),.cmp td:nth-child(3){font-variant-numeric:tabular-nums;white-space:nowrap}
.yn-flow{list-style:none;margin:20px 0 0;padding:0;counter-reset:f;display:grid}
.yn-flow li{counter-increment:f;display:grid;grid-template-columns:2em 3.4em minmax(0,1fr);gap:10px;align-items:baseline;padding:13px 0;border-bottom:1px solid rgba(51,48,43,.12);font-size:14.5px;line-height:1.85}
.yn-flow li::before{content:counter(f);font-weight:800;color:var(--accent)}
.yn-flow span{font-weight:800}.yn-flow .t{font-weight:400}
#what,#dates,#ticket,#flow,#access,#before{scroll-margin-top:88px}
@media(max-width:700px){.yn-top{grid-template-columns:120px minmax(0,1fr);gap:16px}.yn-top > div{display:contents}.yn-eyebrow,.yn-h1{grid-column:2}.yn-kv{grid-row:1 / span 2}.yn-top .lede,.yn-keys,.yn-cta{grid-column:1 / -1}.yn-h1{font-size:22px;margin-top:0}.toc{padding:20px}}
</style>
