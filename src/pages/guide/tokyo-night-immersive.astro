.yn-top{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:32px;align-items:start;max-width:1000px;margin:0 auto}
.yn-kv img{width:100%;height:auto;display:block;border-radius:10px;box-shadow:0 10px 30px rgba(20,30,60,.35)}
.yn-eyebrow{margin:0;display:inline-block;padding:4px 12px;background:#EEF6E8;color:#24502A;font-weight:800;font-size:13px;letter-spacing:.08em;border-radius:4px}
.yn-h1{margin:14px 0 0;font-size:clamp(24px,3.6vw,36px);line-height:1.45;color:#fff;text-wrap:balance}
.yn-h1s{display:inline-block;margin-top:6px;font-size:.62em;line-height:1.5}
.yn-keys{list-style:none;margin:16px 0 0;padding:0;display:grid;gap:8px;font-size:14.5px;line-height:1.75;color:#fff}
.yn-keys li{display:grid;grid-template-columns:3.6em minmax(0,1fr);gap:10px}
.yn-keys li > span:first-child{font-weight:800;color:var(--x-lime,#E1F73E)}
.yn-cta{margin:22px 0 0;display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center}
.yn-btn{display:inline-block;padding:14px 22px;background:#24502A;color:#fff!important;font-weight:800;font-size:15px;border-radius:999px;text-decoration:none!important;border:1px solid #EEF6E8}
.yn-sub{font-weight:700;font-size:14.5px;color:#fff!important;border-bottom:1px solid currentColor}
.yn-sub2{font-weight:700;font-size:14.5px;color:var(--accent);border-bottom:1px solid currentColor}
.toc{max-width:520px;margin:40px auto 0;background:#fff;border:1px solid rgba(51,48,43,.08);border-radius:18px;padding:24px 28px}
.toc-h{margin:0 0 12px;font-size:13px;font-weight:800;letter-spacing:.12em;color:var(--accent)}
.toc ol{margin:0;padding-left:1.3em;display:flex;flex-direction:column;gap:8px}
.toc a{font-size:14.5px;font-weight:700;color:rgba(51,48,43,.8)}
.ni-list{margin:22px 0 0;display:grid;gap:14px}
.ni-card{background:#fff;border:1px solid rgba(51,48,43,.12);border-radius:12px;padding:18px 20px}
.ni-kind{margin:0;font-size:12.5px;font-weight:800;color:var(--accent);letter-spacing:.04em}
.ni-name{margin:6px 0 0;font-size:17px;font-weight:800;line-height:1.5}
.ni-name a{color:var(--ink,#0B0B14);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
.ni-dl{margin:12px 0 0;display:grid;gap:6px;font-size:14px;line-height:1.75}
.ni-dl div{display:grid;grid-template-columns:5em minmax(0,1fr);gap:10px}
.ni-dl dt{font-weight:800;color:rgba(51,48,43,.7)}
.ni-dl dd{margin:0}
.ni-own{margin:10px 0 0;font-size:12.5px;color:rgba(51,48,43,.65)}
.cmp-wrap{margin:18px 0 0;overflow-x:auto;-webkit-overflow-scrolling:touch}
.cmp{width:100%;min-width:600px;border-collapse:collapse;background:#fff;font-size:14px;line-height:1.75}
.cmp th,.cmp td{border:1px solid rgba(51,48,43,.12);padding:11px 12px;vertical-align:top;text-align:left}
.cmp thead th{background:#F4F1EC;font-weight:800;font-size:13px}
.cmp tbody th{font-weight:800;min-width:7em}
.cmp-src{margin:10px 0 0;font-size:12.5px;line-height:1.8;color:rgba(51,48,43,.65)}
#what,#list,#gensou,#who,#compare,#check,#faq{scroll-margin-top:88px}
@media(max-width:700px){.yn-top{grid-template-columns:120px minmax(0,1fr);gap:16px}.yn-top > div{display:contents}.yn-eyebrow,.yn-h1{grid-column:2}.yn-kv{grid-row:1 / span 2}.yn-top .lede,.yn-keys,.yn-cta{grid-column:1 / -1}}
</style>
