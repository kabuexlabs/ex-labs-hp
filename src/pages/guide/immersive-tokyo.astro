---
// 「イマーシブ 東京」「イマーシブイベント 東京」「イマーシブ体験」系の
// 集客クエリの受け皿。自社公演の紹介＋選び方で「イマーシブ」単体の
// トピック網羅性も高める。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZeroCostBanner from '../../components/ZeroCostBanner.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { shows } from '../../data/shows';
import { thisWeekShows, nextOccurrence, weekRange, fmtDateJa, fmtDateShort, fmtVerified, jstDateString, addDays } from '../../lib/thisWeek';

// 「今週遊べる」欄：リクエスト時刻（日本時間）で評価する。データの正本は src/data/shows.ts
const now = new Date();
const week = weekRange(now);
const weekLast = addDays(week.end, -1); // 表示用：週の最終日（日曜）
const weekShows = thisWeekShows(shows, now);
const upcoming = shows.filter((s) => s.published && !weekShows.some((w) => w.show.id === s.id)).map((s) => ({ show: s, next: nextOccurrence(s, now) })).filter((x) => x.next);
const latestVerified = shows.filter((s) => s.published).map((s) => s.verifiedAt).sort().pop() ?? '';
const anyStale = weekShows.some((w) => w.stale);
import { jsonLd } from '../../lib/microcms';

const site = Astro.site ?? new URL('https://kabuexlabs.com');

const toc = [
  { id: 'this-week', label: '今週遊べる東京のイマーシブイベント（ex Labsの開催予定）' },
  { id: 'types', label: '東京のイマーシブ体験の種類' },
  { id: 'trend2026', label: '2026年の東京イマーシブ動向' },
  { id: 'now', label: 'ex Labsの東京イマーシブ体験' },
  { id: 'choose', label: '初めての選び方3つのポイント' },
  { id: 'biz', label: '開催したい企業・施設の方へ' },
  { id: 'faq', label: 'よくある質問' },
];

const faqs = [
  {
    q: '東京ではどんなイマーシブ体験ができますか？',
    a: '劇場・施設の中を歩き回るイマーシブシアター型、商業施設や街全体を巡る周遊型、バーやレストランでの少人数没入型など、さまざまな形式があります。渋谷・六本木・下北沢など、エリアごとに個性の異なる公演が開催されています。',
  },
  {
    q: 'イマーシブ体験は一人でも参加できますか？',
    a: '作品によります。少人数制の公演は1名から参加できるものも多く、周遊型は友人・家族と一緒に楽しむ設計が一般的です。各公演の案内で推奨人数を確認しましょう。',
  },
  {
    q: '演技をしたことがなくても大丈夫ですか？',
    a: '大丈夫です。イマーシブ体験の多くは、特別な演技力を求めず「その場にいて、物語に反応する」だけで成立するよう設計されています。初めてなら、謎解き要素のある周遊型が参加しやすいです。',
  },
  {
    q: '所要時間はどのくらいですか？',
    a: '形式によりますが、周遊型で60〜120分程度、公演型で1〜3時間程度が一般的です。',
  },
  {
    q: '企業や施設でイマーシブイベントを開催してもらうことはできますか？',
    a: 'できます。株式会社ex Labsでは、商業施設・店舗・街を舞台にしたオリジナルのイマーシブイベントを企画から運営まで一貫して制作しています。制作依頼・お見積りは無料です。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '東京で体験できるイマーシブイベント｜種類・選び方・注目公演',
  about: '東京のイマーシブ体験・イマーシブイベント',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/immersive-tokyo.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  reviewedBy: { '@type': 'Person', '@id': new URL('/company/iida-yuki/#person', site).toString(), name: '飯田 雄貴', jobTitle: '代表取締役', url: new URL('/company/iida-yuki/', site).toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-08-07',
  dateModified: '2026-09-13',
  mainEntityOfPage: new URL('/guide/immersive-tokyo/', Astro.site).toString(),
};
---
<BaseLayout
  title="東京で体験できるイマーシブイベント【2026年最新】｜種類・選び方・注目公演 - 株式会社ex Labs"
  description="【2026年最新】東京のイマーシブ体験（没入型イベント）を制作会社が解説。渋谷サクラステージの周遊型「ウワサバナシ調査委員会」、六本木の会員制バーで開催する「怪盗と秘密の試験」、下北沢の「ロスト・フレーム」など注目公演と、初めての選び方を紹介。"
  ogImage="/assets/guide/immersive-tokyo.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: 'イマーシブ完全ガイド', href: '/guide/immersive/' },
  { name: '東京のイマーシブ体験' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">IMMERSIVE TOKYO GUIDE</p>
<h1 class="h2 serif"><span class="nobr">東京で体験できる</span><span class="nobr">イマーシブイベント</span><span class="nobr">【2026年最新】</span></h1>
<p class="lede"><strong>東京は、日本で最もイマーシブ体験（没入型イベント）が充実している街</strong>です。劇場型の大型公演から、商業施設や街全体を巡る周遊型、バーの一夜を舞台にした少人数公演まで、形式もエリアも多彩に広がっています。この記事では、東京のイマーシブ体験の種類と選び方、<strong>2026年のいま体験できる注目公演</strong>を、イマーシブ制作会社の株式会社ex Labsが紹介します。</p>

<nav class="toc" aria-label="目次">
<p class="toc-h">目次</p>
<ol>
{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
</ol>
</nav>
</div></section>

<section class="section" id="this-week" data-week-end={week.end} data-today={jstDateString(now)}><div class="wrap">
<p class="eyebrow">THIS WEEK</p><h2 class="h2 serif">今週遊べる東京のイマーシブイベント｜ex Labsの開催予定</h2>
<p class="lede">今週、東京でイマーシブ体験を探している方へ。<strong>株式会社ex Labsが企画・制作する公演</strong>のうち、今週（{fmtDateJa(week.start)}〜{fmtDateJa(weekLast)}、日本時間）の開催予定を確認できたものをご紹介します。第三者のランキングではなく自社公演の案内です。参加人数や所要時間を比較して、気になる公演の日時・空席はチケットサイトでご確認ください。</p>
<p class="tw-meta">開催情報の最終確認：{fmtVerified(latestVerified)}（自社公式ページで確認。開演時刻・空席はチケットサイトで確認してください）{anyStale && <strong>。確認から2週間以上経過しているため、最新情報はチケットサイトを優先してください</strong>}</p>
{weekShows.length === 0 ? (
  <div class="tw-empty">
    <p class="tw-empty-t serif">今週の開催予定は確認できていません</p>
    <p class="tw-empty-d">今週開催なしと断定するものではありません。次回の開催日は各公演ページ・チケットサイトでご確認ください。</p>
  </div>
) : (
  <div class="tw-grid">
  {weekShows.map((w) => (
    <article class="tw-card" data-show={w.show.id}>
      <p class="tw-area">{w.show.area}</p>
      <h3 class="tw-name serif">{w.show.name}</h3>
      <p class="tw-feature">{w.show.feature}</p>
      <div class="tw-dates">
        <p class="tw-k">今週の開催日</p>
        <ul class="tw-chips">
        {w.occurrences.map((o) => (
          <li class={`tw-chip is-${o.state}`} data-date={o.date} data-time={o.time ?? ''}>{fmtDateShort(o.date)}{o.time ? ` ${o.time}開演` : ' 開演時刻はチケットサイトで確認'}{o.state === 'soldout' ? '（完売）' : ''}{o.state === 'started' ? '（開演済み）' : ''}{o.isWeekend ? <span class="tw-we">今週末</span> : null}</li>
        ))}
        </ul>
        <p class="tw-stock">{w.bookable ? (w.stale ? '開催予定は確認済みですが確認から時間が経っています。空席・最新の日時はチケットサイトでご確認ください' : '開催予定は確認済み。空席はチケットサイトでご確認ください') : '今週の回は完売または開演済みです。予約可能な公演としてはご案内していません'}</p>
      </div>
      <dl class="tw-dl">
        <div><dt>所要時間</dt><dd>{w.show.duration}</dd></div>
        <div><dt>参加人数</dt><dd>{w.show.capacity}</dd></div>
        <div><dt>年齢条件</dt><dd>{w.show.age}</dd></div>
        <div><dt>料金（{w.show.price.unit}）</dt><dd>{w.show.price.text}<br><span class="tw-note">{w.show.price.note}</span></dd></div>
      </dl>
      <p class="tw-k">参加前に確認したい条件</p>
      <ul class="tw-cond">{w.show.conditions.map((c) => <li>{c}</li>)}</ul>
      <div class="tw-actions">
        {w.bookable
          ? <a class="btn tw-btn" href={w.show.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={w.show.id} data-place="this-week">開催日時・空席を確認する（{w.show.ticketSite}）</a>
          : <a class="btn tw-btn ghost" href={w.show.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={w.show.id} data-place="this-week">次回以降の日程を確認する（{w.show.ticketSite}）</a>}
        <a class="tw-sub" href={w.show.url} data-track="show" data-show={w.show.id} data-place="this-week">公演内容を見る →</a>
      </div>
    </article>
  ))}
  </div>
)}
{upcoming.length > 0 && (
  <div class="tw-next">
    <p class="tw-k">次回の開催日を確認する（今週は開催予定なし）</p>
    <ul class="tw-next-list">
    {upcoming.map((u) => (
      <li><strong>{u.show.name}</strong>（{u.show.area}）：次回 {fmtDateJa(u.next!.date)}{u.next!.time ? ` ${u.next!.time}開演` : ''}。<a href={u.show.url} data-track="show" data-show={u.show.id} data-place="this-week-next">公演内容 →</a>／<a href={u.show.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={u.show.id} data-place="this-week-next">日程・空席を確認（{u.show.ticketSite}）→</a></li>
    ))}
    </ul>
  </div>
)}
<p class="tw-meta">日付・人数・エリアから公演回を絞り込んで探すには<a href="/events/" style="color:var(--accent)">公演を探す（今日・明日・今週末）</a>をご利用ください。</p>
<p class="tw-meta">過去の公演（下北沢「ロスト・フレーム」など）は<a href="/works/" style="color:var(--accent)">制作事例</a>としてご覧ください。参加前の服装・持ち物は<a href="/guide/immersive-preparation/" style="color:var(--accent)">イマーシブ体験の服装・持ち物</a>、観るマジックショーとの違いは<a href="/guide/magic-show-immersive-chigai/" style="color:var(--accent)">マジックショーとイマーシブ体験の違い</a>で整理しています。</p>
<script is:inline>
// 開いたまま日付が変わった場合のフォールバック：日本時間の今日より前の回を非表示にし、
// 残る回がないカードは予約導線を「次回以降の日程を確認する」に切り替える。
(function(){try{
  var sec=document.getElementById('this-week');if(!sec)return;
  var today=new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  if(today===sec.getAttribute('data-today'))return;
  var stale=today>=sec.getAttribute('data-week-end');
  sec.querySelectorAll('.tw-card').forEach(function(card){
    var left=0;card.querySelectorAll('.tw-chip').forEach(function(c){var d=c.getAttribute('data-date');if(stale||d<today){c.style.display='none'}else{left++}});
    if(!left){var s=card.querySelector('.tw-stock');if(s)s.textContent='この週の回は終了しました。次回以降の日程はチケットサイトでご確認ください';var b=card.querySelector('.tw-btn');if(b){b.textContent='次回以降の日程を確認する';b.classList.add('ghost')}}
  });
  var m=sec.querySelector('.tw-meta');if(m&&stale){m.insertAdjacentHTML('afterbegin','<strong>表示している週は終了しています。最新の開催予定はチケットサイトでご確認ください。</strong> ')}
}catch(e){}})();
</script>
</div></section>

<section class="section tinted" id="types"><div class="wrap">
<p class="eyebrow">TYPES</p><h2 class="h2 serif">東京のイマーシブ体験の種類</h2>
<div class="genre-grid">
<div class="genre-cell"><span class="genre-t serif">劇場・施設型</span><span class="genre-d">建物の中を自由に歩き、同時進行する物語を追うイマーシブシアター。<a href="/guide/immersive-theater/" style="color:var(--accent)">イマーシブシアターとは →</a></span></div>
<div class="genre-cell"><span class="genre-t serif">街なか周遊型</span><span class="genre-d">渋谷・下北沢など実在の街や商業施設を巡りながら物語を体験する形式。謎解きと相性抜群。</span></div>
<div class="genre-cell"><span class="genre-t serif">店舗・少人数型</span><span class="genre-d">バーやレストランの空間ごと物語に変わる、距離の近い濃密な没入体験。</span></div>
<div class="genre-cell"><span class="genre-t serif">ミステリー融合型</span><span class="genre-d">マダミス・謎解きと融合し、推理しながら物語に入り込む形式。<a href="/guide/madamis/" style="color:var(--accent)">マダミスとは →</a></span></div>
</div>
</div></section>

<section class="section" id="trend2026"><div class="wrap narrow">
<p class="eyebrow">2026 TREND</p><h2 class="h2 serif">2026年の東京イマーシブ動向</h2>
<p class="lede">2026年の東京イマーシブシーンは、大きな転換点を迎えています。世界最大級のイマーシブ・テーマパークとして2024年に開業した<strong>「イマーシブ・フォート東京」（お台場）が、2026年2月28日をもって閉業</strong>しました。運営側は理由を「施設規模が過大だったため」と説明しており、実際に人気が集中したのは大人数向けのライトな体験ではなく、<strong>人数限定の濃密な没入体験</strong>だったと報じられています。</p>
<p class="lede">つまり、常設の大型パークが終わった一方で、<strong>イマーシブ体験そのものの需要はむしろ「少人数×高密度」に集中している</strong>のが2026年の実態です。東京では、期間限定公演・店舗型・街なか周遊型など、物語との距離が近い小規模高密度のイマーシブが主流になりつつあります。これから体験するなら、この「距離の近さ」を基準に選ぶのがおすすめです。</p>
</div></section>

<section class="section tinted" id="now"><div class="wrap narrow">
<p class="eyebrow">PICK UP</p><h2 class="h2 serif">ex Labsの東京イマーシブ体験</h2>
<ul class="bullets">
<li><strong>ウワサバナシ調査委員会（渋谷）</strong>：渋谷サクラステージ全体を周遊する都市伝説×イマーシブ×謎解き。2026年9〜10月開催。東急不動産様ほかのご協力で実現した施設一体型で、<strong>日本経済新聞に掲載</strong>されました。<a href="/uwasabanashi/" style="color:var(--accent)">特設サイト →</a></li>
<li><strong>怪盗と秘密の試験（六本木）</strong>：会員制バーを舞台に、日本一になった実績のあるマジシャン様とコラボしたマジック×イマーシブ公演。2026年9月開催。<strong>電ファミニコゲーマーで紹介</strong>。<a href="/kaitou/" style="color:var(--accent)">公演サイト →</a></li>
<li><strong>ロスト・フレーム（下北沢）</strong>：街に散らばった絵画を探して歩く周遊型アートイマーシブ。体験時間75分・1〜4名。<a href="/taikenbizyutu/lostframe/" style="color:var(--accent)">ロスト・フレーム公式 →</a></li>
<li><strong>ANATOR（神田）</strong>：少人数密室型のイマーシブ空間。公演とスペースレンタルを行う自社劇場です。<a href="/anator/" style="color:var(--accent)">公式サイト →</a></li>
</ul>
<h3 class="def-sub serif">東京でイマーシブシアターを探すコツ</h3>
<ul class="bullets">
<li><strong>「常設」より「期間限定」を探す</strong>：2026年は大型常設施設が閉業し、東京のイマーシブシアターは期間限定公演・小規模劇場が主流です。公演情報は各劇団・レーベルの公式サイトやSNSで告知されるため、気になる作品は早めのチケット確保がおすすめです。</li>
<li><strong>人数と距離感で選ぶ</strong>：数十人規模で歩き回る劇場型か、数名で俳優と向き合う少人数型か。初めてなら少人数型のほうが「物語の当事者」になる感覚を掴みやすいです。</li>
<li><strong>形式の違いを知っておく</strong>：客席がない・視点を自分で選ぶ・一回では全体を見られない、がイマーシブシアターの基本。<a href="/guide/immersive-theater/" style="color:var(--accent)">イマーシブシアターとは？演劇との違い →</a></li>
</ul>
</div></section>

<section class="section" id="choose"><div class="wrap narrow">
<p class="eyebrow">HOW TO CHOOSE</p><h2 class="h2 serif">初めての選び方3つのポイント</h2>
<ul class="bullets">
<li><strong>没入の深さで選ぶ</strong>：がっつり演じたいなら公演型、気軽に楽しみたいなら謎解き付きの周遊型が入りやすいです。</li>
<li><strong>誰と行くかで選ぶ</strong>：友人・家族となら周遊型、デートなら少人数の店舗型、一人参加OKの公演も増えています。</li>
<li><strong>エリアで選ぶ</strong>：渋谷・六本木・下北沢・神田など、街の個性と物語の相性も楽しみのひとつです。</li>
</ul>
<p class="vc-line">参加前の準備：<a href="/guide/immersive-preparation/" style="color:var(--accent)">イマーシブ体験の服装・持ち物（公演別チェック表つき）→</a>／観るショーとの違い：<a href="/guide/magic-show-immersive-chigai/" style="color:var(--accent)">マジックショーとイマーシブ体験の違い →</a></p>
</div></section>

<section class="section tinted" id="biz"><div class="wrap narrow">
<p class="eyebrow">FOR BUSINESS</p><h2 class="h2 serif">開催したい企業・施設の方へ</h2>
<p class="lede">上で紹介した公演は、いずれも株式会社ex Labsが<strong>企画・制作・運営</strong>を手がけたものです。商業施設・店舗・街を舞台にしたオリジナルのイマーシブイベントを、<strong>レベニューシェア型（初期費用0円または格安）</strong>を含む柔軟な形で開催できます。</p>
<p class="vc-line"><a href="/services/immersive/" style="color:var(--accent)">イマーシブの制作依頼・お見積り（無料）はこちら →</a>／<a href="/guide/shisetsu-katsuyo/" style="color:var(--accent)">施設活用イベントとは →</a></p>
</div></section>

<ZeroCostBanner />

<section class="section tinted" id="faq"><div class="wrap">
<p class="eyebrow">FAQ</p><h2 class="h2 serif">よくある質問</h2>
<div class="faq-list tag-immersive">
{faqs.map((f) => (
  <div class="faq-item">
    <p class="faq-q">{f.q}</p>
