<p class="tw-meta">過去の公演（下北沢「ロスト・フレーム」など）は<a href="#past" style="color:var(--accent)">終了した公演</a>と<a href="/works/" style="color:var(--accent)">制作事例</a>でご覧ください。参加前の服装・持ち物は<a href="/guide/immersive-preparation/" style="color:var(--accent)">イマーシブ体験の服装・持ち物</a>、観るマジックショーとの違いは<a href="/guide/magic-show-immersive-chigai/" style="color:var(--accent)">マジックショーとイマーシブ体験の違い</a>で整理しています。</p>
<script is:inline>
// 開いたまま日付が変わった場合のフォールバック：日本時間の今日より前の回を非表示にし、
// 残る回がないカードは予約導線を「次回以降の日程を確認する」に切り替える。
(function(){try{
  var sec=document.getElementById('this-week');if(!sec)return;
  var today=new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  if(today===sec.getAttribute('data-today'))return;
  var stale=today>=sec.getAttribute('data-week-end');
  sec.querySelectorAll('.tw-card').forEach(function(card){
    var left=0;card.querySelectorAll('.tw-chip').forEach(function(c){var d=c.getAttribute('data-date');if(stale||d<today){c.style.display='none'}else{left++}});
    if(!left){var s=card.querySelector('.tw-stock');if(s)s.textContent='この週の回は終了しました。次回以降の日程はチケットサイトでご確認ください';var b=card.querySelector('.tw-btn');if(b){b.textContent='次回以降の日程を確認する';b.classList.add('ghost')}}
  });
  var m=sec.querySelector('.tw-meta');if(m&&stale){m.insertAdjacentHTML('afterbegin','<strong>表示している週は終了しています。最新の開催予定はチケットサイトでご確認ください。</strong> ')}
}catch(e){}})();
</script>
