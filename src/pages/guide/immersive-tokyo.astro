---
// 「イマーシブ 東京」「イマーシブ体験 東京」「イマーシブシアター 東京」系の集客クエリの受け皿。
// 役割：東京のイマーシブを「比較して選ぶ」中心ページ。日付・人数で探すのは /events/、意味・種類・服装は各解説記事。
// 比較表・公演カード・選び方は src/data/events/（公演検索と共通の正本）から生成し、ガイドと /events/ で
// 開催日・料金が食い違わないようにする。他社公演は works.ts で published: true になったものだけ載る
// （guideOnly: true は比較表だけに出し、/events/ の検索・詳細には出さない）。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZeroCostBanner from '../../components/ZeroCostBanner.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { shows } from '../../data/shows';
import { eventsData } from '../../data/events/index';
import { areaName, regionName, genreName } from '../../data/events/areas';
import { perPerson, fmtYen, FORMAT_LABEL } from '../../lib/events';
import { thisWeekShows, nextOccurrence, weekRange, fmtDateJa, fmtDateShort, fmtVerified, jstDateString, addDays } from '../../lib/thisWeek';
import { jsonLd } from '../../lib/microcms';

// 「今週遊べる」欄：リクエスト時刻（日本時間）で評価する。データの正本は src/data/events/（shows.ts は変換層）
const now = new Date();
const today = jstDateString(now);
const week = weekRange(now);
const weekLast = addDays(week.end, -1); // 表示用：週の最終日（日曜）
const weekShows = thisWeekShows(shows, now);
const upcoming = shows.filter((s) => s.published && !weekShows.some((w) => w.show.id === s.id)).map((s) => ({ show: s, next: nextOccurrence(s, now) })).filter((x) => x.next);
const latestVerified = shows.filter((s) => s.published).map((s) => s.verifiedAt).sort().pop() ?? '';
const anyStale = weekShows.some((w) => w.stale);

const site = Astro.site ?? new URL('https://kabuexlabs.com');

// ---- 比較表・公演カード用の行（公開作品のみ。終了した作品は「終了した公演」枠へ） ----
type Status = 'ongoing' | 'upcoming' | 'ended' | 'unknown';
const MOVEMENT_LABEL: Record<string, string> = { 'free-roam': '自分で歩き回る', guided: '案内に沿って進む', seated: '座って観る時間が中心', mixed: '歩く場面と座る場面がある' };
const SETTING_LABEL: Record<string, string> = { indoor: '屋内', outdoor: '屋外', mixed: '屋内＋屋外の移動あり' };
const rows = eventsData.works.filter((w) => w.published).map((w) => {
  const org = eventsData.organizers.find((o) => o.id === w.organizerId)!;
  const own = org.relation === 'ex-labs';
  const occ = eventsData.occurrences.filter((o) => o.workId === w.id && o.published && !o.test && o.eventStatus !== 'cancelled').sort((a, b) => a.date.localeCompare(b.date));
  const venue = eventsData.venues.find((v) => v.id === occ[0]?.venueId);
  const dates = occ.map((o) => o.date);
  const futureDates = dates.filter((d) => d >= today);
  const from = dates[0] ?? w.period?.from;
  const to = dates[dates.length - 1] ?? w.period?.to;
  const status: Status = !to ? 'unknown' : to < today ? 'ended' : from && from > today ? 'upcoming' : 'ongoing';
  const ticketUrl = occ.find((o) => o.date >= today)?.sales.channels[0]?.url ?? occ[0]?.sales.channels[0]?.url;
  const channel = eventsData.channels.find((c) => c.id === occ[0]?.sales.channels[0]?.channelId);
  const perPersonText = w.price.unit === 'per-person' ? `${fmtYen(w.price.amount!)}` : w.price.unit === 'per-group' ? (w.price.tiers ?? []).map((t) => `${t.party}人参加 1人${fmtYen(perPerson(w.price, t.party)!)}`).join('／') : `貸切総額 ${fmtYen(w.price.amount!)}`;
  const stale = Date.now() - Date.parse(w.verified.at) > w.verifyTtlDays * 86400000;
  const datesText = dates.length ? (futureDates.length ? `${fmtDateShort(futureDates[0])}〜${fmtDateShort(futureDates[futureDates.length - 1])}（確認できた開催日 ${futureDates.length}日）` : `${fmtDateShort(dates[0])}〜${fmtDateShort(dates[dates.length - 1])}`) : (w.period?.text ?? '公式ページで確認');
  return { w, org, own, venue, occ, dates, futureDates, from, to, status, ticketUrl, channel, perPersonText, stale, datesText };
});
const compareRows = rows.filter((r) => r.status !== 'ended');
const endedRows = rows.filter((r) => r.status === 'ended');
const hasThirdParty = compareRows.some((r) => !r.own);
const listedVerified = rows.map((r) => r.w.verified.at).sort().pop() ?? latestVerified;
const names = (xs: typeof rows) => xs.map((r) => r.w.title).join('、');
const none = '確認できた公演なし';
// 選び方（データから判定。未確認の項目は「該当なし」にせず「公式で確認」と書く）
const pick = {
  soloBook: compareRows.filter((r) => r.w.party.soloAllowed),
  soloRun: compareRows.filter((r) => r.w.party.soloRuns === true),
  pair: compareRows.filter((r) => r.w.party.min <= 2 && (r.w.party.max === undefined || r.w.party.max >= 2)),
  pairPrivate: compareRows.filter((r) => r.w.party.format === 'private' && r.w.party.min <= 2),
  actor: compareRows.filter((r) => r.w.info.actorInteraction === true),
  indoor: compareRows.filter((r) => r.venue?.setting === 'indoor'),
  outdoorMove: compareRows.filter((r) => r.venue?.setting === 'mixed' || r.venue?.setting === 'outdoor'),
  notScary: compareRows.filter((r) => r.w.info.scary && /なし/.test(r.w.info.scary)),
  beginner: compareRows.filter((r) => r.w.info.beginner),
};

const toc = [
  { id: 'compare', label: '開催中・開催予定の公演を比較する' },
  { id: 'this-week', label: '今週遊べる東京のイマーシブイベント（ex Labsの開催予定）' },
  { id: 'choose', label: '人数・好み・参加形式で選ぶ' },
  { id: 'now', label: '公演ごとの詳しい紹介' },
  { id: 'theater', label: 'イマーシブシアターを東京で探す' },
  { id: 'types', label: '東京のイマーシブ体験の種類' },
  { id: 'trend2026', label: '2026年の東京イマーシブ動向' },
  { id: 'past', label: '終了した公演・閉業した施設' },
  { id: 'flow', label: '受付から終了までの流れ（自社公演の案内）' },
  { id: 'faq', label: 'よくある質問' },
  { id: 'biz', label: '開催したい企業・施設の方へ' },
];

const soloAnswer = pick.soloBook.length ? `${names(pick.soloBook)}は1名から申し込めます（相席形式）。${compareRows.filter((r) => !r.w.party.soloAllowed).length ? `${names(compareRows.filter((r) => !r.w.party.soloAllowed))}は各回2名以上での申込です。` : ''}` : '確認できた範囲で1名から申し込める公演はありません。';
const pairAnswer = pick.pairPrivate.length ? `${names(pick.pairPrivate)}は申込単位で貸切のため、2名で申し込めば2名だけで体験できます。` : '2名だけで貸切にできる公演は確認できていません。';
const durationAnswer = compareRows.map((r) => `${r.w.title}は${r.w.duration.text}`).join('、') + '。形式の目安は周遊型で60〜120分、公演型で1〜3時間です。';
const faqs = [
  { q: '東京ではどんなイマーシブ体験ができますか？', a: '劇場・施設の中を歩き回るイマーシブシアター型、商業施設や街全体を巡る周遊型、バーやレストランでの少人数没入型、劇中セットを歩く展示型などがあります。このページでは、確認できた開催日・料金・参加人数を公演ごとに比較できます。' },
  { q: 'イマーシブ体験は一人でも参加できますか？', a: soloAnswer + '公演によって「1名から申し込めるか」と「1名だけで回が成立するか」は別なので、申込条件を確認してください。' },
  { q: '2人だけで参加できますか？', a: pairAnswer + (pick.pair.length ? `${names(pick.pair)}は2名での参加ができます。` : '') },
  { q: '演技をしたことがなくても大丈夫ですか？', a: `演技は求められません。${pick.beginner.map((r) => `${r.w.title}は「${r.w.info.beginner}」と案内しています`).join('。')}。会話や選択で物語が進む形式なので、その場で反応するだけで成立します。` },
  { q: '怖い演出はありますか？雨の日でも参加できますか？', a: `${pick.notScary.length ? `${names(pick.notScary)}はホラー演出なしと公式に案内しています。` : 'ホラー演出の有無は各公演の公式ページで確認してください。'}${pick.indoor.length ? `${names(pick.indoor)}は商業施設内で完結するため、雨天でも体験内容は変わりません。` : ''}${pick.outdoorMove.length ? `${names(pick.outdoorMove)}は受付後に屋外の徒歩移動があります。` : ''}` },
  { q: '所要時間はどのくらいですか？', a: durationAnswer },
  { q: '開催日で探すにはどうすればいいですか？', a: '公演を探す（/events/）で、今日・明日・今週末や特定の日付、人数・エリア・予算から開催予定の回を絞り込めます。掲載しているのは株式会社ex Labsが公式ページで確認した公演だけで、開演時刻や空席が未確認の回は「未確認」と表示します。' },
  { q: '企業や施設でイマーシブイベントを開催してもらうことはできますか？', a: 'できます。株式会社ex Labsでは、商業施設・店舗・街を舞台にしたオリジナルのイマーシブイベントを企画から運営まで一貫して制作しています。制作依頼・お見積りは無料です。' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '東京で体験できるイマーシブイベント｜種類・選び方・注目公演',
  about: '東京のイマーシブ体験・イマーシブイベント',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/immersive-tokyo.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  reviewedBy: { '@type': 'Person', '@id': new URL('/company/iida-yuki/#person', site).toString(), name: '飯田 雄貴', jobTitle: '代表取締役', url: new URL('/company/iida-yuki/', site).toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-08-07',
  dateModified: '2026-09-15',
  mainEntityOfPage: new URL('/guide/immersive-tokyo/', Astro.site).toString(),
};
---
<BaseLayout
  title="東京で体験できるイマーシブイベント【2026年最新】｜種類・選び方・注目公演 - 株式会社ex Labs"
  description="【2026年最新】東京のイマーシブ体験（没入型イベント）を制作会社が解説。渋谷サクラステージの周遊型「ウワサバナシ調査委員会」、六本木の会員制バーで開催する「怪盗と秘密の試験」、下北沢の「ロスト・フレーム」など注目公演と、初めての選び方を紹介。"
  ogImage="/assets/guide/immersive-tokyo.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: 'イマーシブ完全ガイド', href: '/guide/immersive/' },
  { name: '東京のイマーシブ体験' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">IMMERSIVE TOKYO GUIDE</p>
<h1 class="h2 serif"><span class="nobr">東京で体験できる</span><span class="nobr">イマーシブイベント</span><span class="nobr">【2026年最新】</span></h1>
<p class="lede"><strong>東京は、日本で最もイマーシブ体験（没入型イベント）が充実している街</strong>です。劇場型の大型公演から、商業施設や街全体を巡る周遊型、バーの一夜を舞台にした少人数公演まで、形式もエリアも多彩に広がっています。この記事では、東京のイマーシブ体験の種類と選び方、<strong>2026年のいま体験できる注目公演</strong>を、イマーシブ制作会社の株式会社ex Labsが紹介します。</p>
<p class="lede">このページは「候補を比較して、参加する公演を決める」ためのページです。開催日や人数から探すなら<a href="/events/" style="color:var(--accent)" data-track="show" data-show="events" data-place="guide-intro">公演を探す（今日・明日・今週末）</a>、言葉の意味や種類は<a href="/guide/immersive/" style="color:var(--accent)">イマーシブとは</a>、参加前の準備は<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物の記事</a>をご覧ください。</p>

<nav class="toc" aria-label="目次">
<p class="toc-h">目次</p>
<ol>
{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
</ol>
</nav>
</div></section>

<section class="section tinted" id="compare"><div class="wrap">
<p class="eyebrow">COMPARE</p><h2 class="h2 serif">開催中・開催予定の公演を比較する</h2>
<p class="lede">公式ページで確認できた項目だけを載せています（最終確認：{fmtVerified(listedVerified)}）。開演時刻・空席・最新の料金は各公式チケットページでご確認ください。{hasThirdParty ? '「ex Labs」の表示がある公演は当社の企画・制作、それ以外は他社の公演です。' : '現在掲載しているのは、株式会社ex Labsが企画・制作した公演です。他社公演は、主催者の公式ページで開催期間・料金・参加条件を確認でき次第、同じ表に追加します。'}</p>
<div class="cmp-wrap"><table class="cmp-table cmp-shows"><thead><tr><th>作品・会場</th><th>形式</th><th>エリア・最寄り駅</th><th>確認できた開催日</th><th>参加人数・形式</th><th>料金（1人あたり換算）</th><th>所要時間</th><th>屋内・屋外</th><th>詳細</th></tr></thead><tbody>
{compareRows.map((r) => (
  <tr>
    <th scope="row"><span class="cmp-title">{r.w.title}</span>{r.own && <span class="own-badge">ex Labs 企画・制作</span>}<span class="cmp-sub">{r.venue?.listName ?? r.venue?.name ?? '会場は公式ページで確認'}</span></th>
    <td>{r.w.genres.map(genreName).join('・')}</td>
    <td>{r.venue ? `${regionName(r.venue.regionId)}・${areaName(r.venue.areaId)}` : '東京'}<br><span class="cmp-note">{r.venue?.station ?? '最寄り駅は公式ページで確認'}</span></td>
    <td>{r.datesText}<br><span class="cmp-note">{r.status === 'upcoming' ? '開催予定' : r.status === 'ongoing' ? '開催中' : '開催状態は公式で確認'}{r.stale ? '（確認から時間が経過）' : ''}</span></td>
    <td>{r.w.party.text}<br><span class="cmp-note">{FORMAT_LABEL[r.w.party.format]}</span></td>
    <td>{r.perPersonText}<br><span class="cmp-note">{r.w.price.unit === 'per-group' ? `1組料金：${r.w.price.text}。` : ''}{r.w.price.feeNote}</span></td>
    <td>{r.w.duration.text}</td>
    <td>{r.venue?.setting ? SETTING_LABEL[r.venue.setting] : '公式ページで確認'}</td>
    <td><a href={`#card-${r.w.id}`} style="color:var(--accent);font-weight:700">紹介を読む</a>{r.ticketUrl && <><br><a href={r.ticketUrl} target="_blank" rel="noopener" style="color:var(--accent);font-weight:700" data-track="ticket" data-show={r.w.id} data-place={`guide-compare-${r.own ? 'own' : '3rd'}`}>公式チケット（{r.channel?.name ?? '公式'}）→</a></>}</td>
  </tr>
))}
</tbody></table></div>
<p class="cmp-note-p">1組料金の公演は、参加人数で割った1人あたりの金額を併記しています（税込。手数料は各販売ページで確認）。「確認できた開催日」は公式ページに掲載された日付で、開演時刻が未確認の回は公演回として数えていません。日付はすべて日本時間です。</p>
<p class="cmp-note-p"><a href="/events/" style="color:var(--accent);font-weight:700" data-track="show" data-show="events" data-place="guide-compare">日付・人数・エリア・予算で開催予定の回を絞り込む（公演を探す）→</a></p>
</div></section>

<section class="section" id="this-week" data-week-end={week.end} data-today={jstDateString(now)}><div class="wrap">
<p class="eyebrow">THIS WEEK</p><h2 class="h2 serif">今週遊べる東京のイマーシブイベント｜ex Labsの開催予定</h2>
<p class="lede">今週、東京でイマーシブ体験を探している方へ。<strong>株式会社ex Labsが企画・制作する公演</strong>のうち、今週（{fmtDateJa(week.start)}〜{fmtDateJa(weekLast)}、日本時間）の開催予定を確認できたものをご紹介します。第三者のランキングではなく自社公演の案内です。参加人数や所要時間を比較して、気になる公演の日時・空席はチケットサイトでご確認ください。</p>
<p class="tw-meta">開催情報の最終確認：{fmtVerified(latestVerified)}（自社公式ページで確認。開演時刻・空席はチケットサイトで確認してください）{anyStale && <strong>。確認から2週間以上経過しているため、最新情報はチケットサイトを優先してください</strong>}</p>
{weekShows.length === 0 ? (
  <div class="tw-empty">
    <p class="tw-empty-t serif">今週の開催予定は確認できていません</p>
    <p class="tw-empty-d">今週開催なしと断定するものではありません。次回の開催日は各公演ページ・チケットサイトでご確認ください。</p>
  </div>
) : (
  <div class="tw-grid">
  {weekShows.map((w) => (
    <article class="tw-card" data-show={w.show.id}>
      <p class="tw-area">{w.show.area}</p>
      <h3 class="tw-name serif">{w.show.name}</h3>
      <p class="tw-feature">{w.show.feature}</p>
      <div class="tw-dates">
        <p class="tw-k">今週の開催日</p>
        <ul class="tw-chips">
        {w.occurrences.map((o) => (
          <li class={`tw-chip is-${o.state}`} data-date={o.date} data-time={o.time ?? ''}>{fmtDateShort(o.date)}{o.time ? ` ${o.time}開演` : ' 開演時刻はチケットサイトで確認'}{o.state === 'soldout' ? '（完売）' : ''}{o.state === 'started' ? '（開演済み）' : ''}{o.isWeekend ? <span class="tw-we">今週末</span> : null}</li>
        ))}
        </ul>
        <p class="tw-stock">{w.bookable ? (w.stale ? '開催予定は確認済みですが確認から時間が経っています。空席・最新の日時はチケットサイトでご確認ください' : '開催予定は確認済み。空席はチケットサイトでご確認ください') : '今週の回は完売または開演済みです。予約可能な公演としてはご案内していません'}</p>
      </div>
      <dl class="tw-dl">
        <div><dt>所要時間</dt><dd>{w.show.duration}</dd></div>
        <div><dt>参加人数</dt><dd>{w.show.capacity}</dd></div>
        <div><dt>年齢条件</dt><dd>{w.show.age}</dd></div>
        <div><dt>料金（{w.show.price.unit}）</dt><dd>{w.show.price.text}<br><span class="tw-note">{w.show.price.note}</span></dd></div>
      </dl>
      <p class="tw-k">参加前に確認したい条件</p>
      <ul class="tw-cond">{w.show.conditions.map((c) => <li>{c}</li>)}</ul>
      <div class="tw-actions">
        {w.bookable
          ? <a class="btn tw-btn" href={w.show.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={w.show.id} data-place="this-week">開催日時・空席を確認する（{w.show.ticketSite}）</a>
          : <a class="btn tw-btn ghost" href={w.show.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={w.show.id} data-place="this-week">次回以降の日程を確認する（{w.show.ticketSite}）</a>}
        <a class="tw-sub" href={w.show.url} data-track="show" data-show={w.show.id} data-place="this-week">公演内容を見る →</a>
      </div>
    </article>
  ))}
  </div>
)}
{upcoming.length > 0 && (
  <div class="tw-next">
