---
// 「イマーシブ 東京」「イマーシブ体験 東京」「イマーシブシアター 東京」系の集客クエリの受け皿。
// 役割：東京のイマーシブを「開催日を見て、すぐ予約サイトへ進む」ための中心ページ。
// 上部＝今週・来週の開催日カレンダー（セルをタップすると公式予約サイト）＋比較表。下部の解説は折りたたみ。
// 開催日・料金・人数は src/data/events/（/events/ と共通の正本）から生成し、本文に手書きしない。
// 主催者名・制作会社名は公演カードに出さない（ユーザー判断 2026-09-16）。企業向けの案内は最下部の折りたたみに限る。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LatestPosts from '../../components/LatestPosts.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ShowCalendar from '../../components/ShowCalendar.astro';
import VisualHero from '../../components/VisualHero.astro';
import { shows } from '../../data/shows';
import { eventsData } from '../../data/events/index';
import { areaName, regionName, genreName } from '../../data/events/areas';
import { perPerson, fmtYen, FORMAT_LABEL } from '../../lib/events';
import { occurrenceState, weekRange, fmtDateJa, fmtDateShort, fmtVerified, jstDateString, jstWeekday, addDays } from '../../lib/thisWeek';
import { jsonLd } from '../../lib/microcms';
import { EXPERIENCE_DATE_PUBLISHED } from '../../data/experienceDate';

const now = new Date();
const today = jstDateString(now);
const week = weekRange(now);
const site = Astro.site ?? new URL('https://kabuexlabs.com');

// ---- 今週・来週の開催日カレンダー（正本：src/data/events/ → shows.ts 変換） ----
const DAYS = ['日', '月', '火', '水', '木', '金', '土'];
const days14 = Array.from({ length: 14 }, (_, i) => addDays(week.start, i));
type CellState = 'open' | 'today' | 'started' | 'soldout' | 'ended' | 'cancelled' | 'none';
const calShows = shows.filter((s) => s.published).map((s) => {
  const byDate = new Map(s.occurrences.map((o) => [o.date, o]));
  const cells = days14.map((d) => {
    const o = byDate.get(d);
    if (!o) return { date: d, state: 'none' as CellState, time: undefined as string | undefined };
    const st = occurrenceState(o, now);
    const state: CellState = st === 'upcoming' ? 'open' : st === 'today-time-unknown' ? 'today' : st === 'started' ? 'started' : st === 'soldout' ? 'soldout' : st === 'cancelled' ? 'cancelled' : 'ended';
    return { date: d, state, time: o.time };
  });
  const openCount = cells.filter((c) => c.state === 'open' || c.state === 'today').length;
  const nextAfter = s.occurrences.map((o) => o.date).filter((d) => d >= week.end).sort()[0];
  const stale = Date.now() - Date.parse(s.verifiedAt) > s.verifyTtlDays * 86400000;
  return { s, cells, openCount, nextAfter, stale };
});
const latestVerified = shows.filter((s) => s.published).map((s) => s.verifiedAt).sort().pop() ?? '';
const anyStale = calShows.some((c) => c.stale);
const ppKnown = eventsData.works.filter((w) => w.published && !w.guideOnly).map((w) => perPerson(w.price, w.party.min)).filter((v): v is number => v !== undefined);
// 「紹介している公演数」と「今週（月〜日）に確認済みの開催日がある公演数」を分ける。期間内でも日程未確認は今週に数えない
const thisWeekCount = calShows.filter((c) => c.cells.slice(0, 7).some((x) => x.state === 'open' || x.state === 'today')).length;
const heroChips = [`紹介 ${calShows.length}公演`, `今週に開催日あり ${thisWeekCount}公演`, ...(ppKnown.length ? [`1人 ${fmtYen(Math.min(...ppKnown))}〜`] : []), '◯をタップで予約サイトへ'];
const MARK: Record<CellState, string> = { open: '◯', today: '◯', started: '済', soldout: '×', ended: '–', cancelled: '中止', none: '–' };

// ---- 比較表・公演カード用 ----
type Status = 'ongoing' | 'upcoming' | 'ended' | 'unknown';
const MOVEMENT_LABEL: Record<string, string> = { 'free-roam': '自分で歩き回る', guided: '案内に沿って進む', seated: '座って観る時間が中心', mixed: '歩く場面と座る場面がある' };
const SETTING_LABEL: Record<string, string> = { indoor: '屋内', outdoor: '屋外', mixed: '屋内＋屋外の移動あり' };
const rows = eventsData.works.filter((w) => w.published).map((w) => {
  const occ = eventsData.occurrences.filter((o) => o.workId === w.id && o.published && !o.test && o.eventStatus !== 'cancelled').sort((a, b) => a.date.localeCompare(b.date));
  const venue = eventsData.venues.find((v) => v.id === (occ[0]?.venueId ?? w.venueId));
  const dates = occ.map((o) => o.date);
  const futureDates = dates.filter((d) => d >= today);
  const from = dates[0] ?? w.period?.from;
  const to = dates[dates.length - 1] ?? w.period?.to;
  const status: Status = !to ? 'unknown' : to < today ? 'ended' : from && from > today ? 'upcoming' : 'ongoing';
  const ticketUrl = occ.find((o) => o.date >= today)?.sales.channels[0]?.url ?? occ[0]?.sales.channels[0]?.url;
  const channel = eventsData.channels.find((c) => c.id === occ[0]?.sales.channels[0]?.channelId);
  const perPersonText = w.price.unit === 'per-person' && w.price.amount !== undefined ? `${fmtYen(w.price.amount)}` : w.price.unit === 'per-group' ? (w.price.tiers ?? []).map((t) => `${t.party}人 ${fmtYen(perPerson(w.price, t.party)!)}`).join('／') : w.price.unit === 'charter' && w.price.amount !== undefined ? `貸切 ${fmtYen(w.price.amount)}` : '公式ページで確認';
  const stale = Date.now() - Date.parse(w.verified.at) > w.verifyTtlDays * 86400000;
  const datesText = dates.length ? (futureDates.length ? `${fmtDateShort(futureDates[0])}〜${fmtDateShort(futureDates[futureDates.length - 1])}（${futureDates.length}日）` : `${fmtDateShort(dates[0])}〜${fmtDateShort(dates[dates.length - 1])}`) : (w.period?.text ?? '公式ページで確認');
  return { w, venue, occ, dates, futureDates, from, to, status, ticketUrl, channel, perPersonText, stale, datesText };
});
const compareRows = rows.filter((r) => r.status !== 'ended');
const endedRows = rows.filter((r) => r.status === 'ended');
const names = (xs: typeof rows) => xs.map((r) => r.w.title).join('、');
const none = '確認できた公演なし';
const pick = {
  soloBook: compareRows.filter((r) => r.w.party.soloAllowed),
  soloRun: compareRows.filter((r) => r.w.party.soloRuns === true),
  pair: compareRows.filter((r) => r.w.party.min <= 2 && (r.w.party.max === undefined || r.w.party.max >= 2)),
  pairPrivate: compareRows.filter((r) => r.w.party.format === 'private' && r.w.party.min <= 2),
  actor: compareRows.filter((r) => r.w.info.actorInteraction === true),
  indoor: compareRows.filter((r) => r.venue?.setting === 'indoor'),
  outdoorMove: compareRows.filter((r) => r.venue?.setting === 'mixed' || r.venue?.setting === 'outdoor'),
  notScary: compareRows.filter((r) => r.w.info.scary && /なし/.test(r.w.info.scary)),
  beginner: compareRows.filter((r) => r.w.info.beginner),
};

const soloShared = pick.soloBook.filter((r) => r.w.party.format === 'shared');
const soloOther = pick.soloBook.filter((r) => r.w.party.format !== 'shared');
const soloAnswer = pick.soloBook.length ? `${soloShared.length ? `${names(soloShared)}は1名から申し込めます（相席形式）。` : ''}${soloOther.length ? `${names(soloOther)}も1名から申し込めます（相席か貸切かは公式ページで確認）。` : ''}${compareRows.filter((r) => !r.w.party.soloAllowed).length ? `${names(compareRows.filter((r) => !r.w.party.soloAllowed))}は各回2名以上での申込です。` : ''}` : '確認できた範囲で1名から申し込める公演はありません。';
const pairAnswer = pick.pairPrivate.length ? `${names(pick.pairPrivate)}は申込単位で貸切のため、2名で申し込めば2名だけで体験できます。` : '2名だけで貸切にできる公演は確認できていません。';
const durationAnswer = compareRows.map((r) => `${r.w.title}は${r.w.duration.text}`).join('、') + '。形式の目安は周遊型で60〜120分、公演型で1〜3時間です。';
const faqs = [
  { q: '東京ではどんなイマーシブ体験ができますか？', a: '劇場・施設の中を歩き回るイマーシブシアター型、商業施設や街全体を巡る周遊型、バーやレストランでの少人数没入型、劇中セットを歩く展示型などがあります。このページでは、確認できた開催日・料金・参加人数を公演ごとに比較できます。' },
  { q: 'イマーシブ体験は一人でも参加できますか？', a: soloAnswer + '公演によって「1名から申し込めるか」と「1名だけで回が成立するか」は別なので、申込条件を確認してください。' },
  { q: '2人だけで参加できますか？', a: pairAnswer + (pick.pair.length ? `${names(pick.pair)}は2名での参加ができます。` : '') },
  { q: '演技をしたことがなくても大丈夫ですか？', a: `演技は求められません。${pick.beginner.map((r) => `${r.w.title}は「${r.w.info.beginner}」と案内しています`).join('。')}。会話や選択で物語が進む形式なので、その場で反応するだけで成立します。` },
  { q: '怖い演出はありますか？雨の日でも参加できますか？', a: `${pick.notScary.length ? `${names(pick.notScary)}はホラー演出なしと公式に案内しています。` : 'ホラー演出の有無は各公演の公式ページで確認してください。'}${pick.indoor.length ? `${names(pick.indoor)}は商業施設内で完結するため、雨天でも体験内容は変わりません。` : ''}${pick.outdoorMove.length ? `${names(pick.outdoorMove)}は受付後に屋外の徒歩移動があります。` : ''}` },
  { q: '所要時間はどのくらいですか？', a: durationAnswer },
  { q: '空席はどこで確認できますか？', a: 'カレンダーの◯は公式ページで確認できた開催日です。空席・残席は各予約サイト（escape.id など）の表示が最新なので、◯の日付をタップして予約サイトでご確認ください。' },
  { q: '開催日や人数で探すにはどうすればいいですか？', a: '公演を探す（/events/）で、今日・明日・今週末や特定の日付、人数・エリア・予算から開催予定の回を絞り込めます。' },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '東京で体験できるイマーシブイベント｜種類・選び方・注目公演',
  about: '東京のイマーシブ体験・イマーシブイベント',
  inLanguage: 'ja',
  image: [new URL('/assets/guide/immersive-tokyo.webp', Astro.site).toString()],
  author: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/logo.png', site).toString() } },
  datePublished: '2026-08-07',
  dateModified: '2026-09-18',
  mainEntityOfPage: new URL('/guide/immersive-tokyo/', Astro.site).toString(),
};
---
<BaseLayout
  title="東京で体験できるイマーシブイベント【2026年最新】｜種類・選び方・注目公演 - 株式会社ex Labs"
  description="【2026年最新】東京のイマーシブ体験（没入型イベント）を制作会社が解説。渋谷サクラステージの周遊型「ウワサバナシ調査委員会」、六本木の会員制バーで開催する「怪盗と秘密の試験」、下北沢の「ロスト・フレーム」など注目公演と、初めての選び方を紹介。"
  ogImage="/assets/guide/immersive-tokyo.webp"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(articleLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: 'イマーシブ完全ガイド', href: '/guide/immersive/' },
  { name: '東京のイマーシブ体験' },
]} />

<VisualHero image="/assets/events/kaitou-kv.webp" imagePos="center 60%" eyebrow="IMMERSIVE TOKYO GUIDE" catchText="東京のイマーシブ、開催日から予約へ" chips={heroChips} alt="東京で開催中のイマーシブ公演のキービジュアル">
  <h1 class="h2 serif"><span class="nobr">東京で体験できる</span><span class="nobr">イマーシブイベント</span><span class="nobr">【2026年最新】</span></h1>
</VisualHero>

<section class="section cards" id="this-week" data-week-end={week.end} data-today={today}><div class="wrap">
<h2 class="cards-h">今週・来週の開催日<span>◯の日付をタップで予約サイトへ</span></h2>
<div class="cal-grid">
{calShows.map(({ s }) => <ShowCalendar show={s} place="guide-cal" now={now} />)}
</div>
<p class="tw-meta">◯は開催日です。空席は予約サイトの表示が最新で、◯があっても満席の場合があります。{anyStale && <strong>最新の日程は予約サイトでご確認ください。</strong>}日付・人数で絞り込むなら<a href="/events/" style="color:var(--accent)" data-track="show" data-show="events" data-place="guide-this-week">公演を探す</a>。</p>
<script is:inline>
// 開いたまま日付が変わった場合：日本時間の今日より前のセルを「終了」にし、表示週が終わっていれば注意書きを出す。
(function(){try{
  var sec=document.getElementById('this-week');if(!sec)return;
  var today=new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  if(today===sec.getAttribute('data-today'))return;
  if(today>=sec.getAttribute('data-week-end')){var m=sec.querySelector('.tw-meta');if(m)m.insertAdjacentHTML('afterbegin','<strong>表示している週は終了しています。最新の開催予定は予約サイトでご確認ください。</strong> ')}
}catch(e){}})();
// 折りたたみ節へのリンク（#choose 等）で開いた場合は自動で展開する
(function(){function o(){try{var h=location.hash.slice(1);if(!h)return;var el=document.getElementById(h);if(el&&el.tagName==='DETAILS'){el.open=true}}catch(e){}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',o)}else{o()}window.addEventListener('hashchange',o)})();
</script>
</div></section>


<section class="section tinted acc-wrap"><div class="wrap">
<h2 class="cards-h">くわしく知りたい人は<span>タップで開きます</span></h2>

<details class="acc" id="compare">
<summary><span class="acc-t">開催中の公演を表で比較する</span><span class="acc-s">形式・エリア・開催日・人数・料金・所要時間</span></summary>
<div class="acc-b">
<div class="cmp-wrap"><table class="cmp-table cmp-shows"><thead><tr><th>作品・会場</th><th>形式</th><th>エリア・最寄り駅</th><th>開催日</th><th>人数・形式</th><th>料金（1人あたり）</th><th>所要時間</th><th>予約</th></tr></thead><tbody>
{compareRows.map((r) => (
  <tr>
    <th scope="row"><span class="cmp-title">{r.w.title}</span><span class="cmp-sub">{r.venue?.listName ?? r.venue?.name ?? '会場は公式ページで確認'}</span></th>
    <td>{r.w.genres.map(genreName).join('・')}</td>
    <td>{r.venue ? `${regionName(r.venue.regionId)}・${areaName(r.venue.areaId)}` : '東京'}<br><span class="cmp-note">{r.venue?.station ?? '最寄り駅は公式ページで確認'}</span></td>
    <td>{r.datesText}</td>
    <td>{r.w.party.text}<br><span class="cmp-note">{FORMAT_LABEL[r.w.party.format]}</span></td>
    <td>{r.perPersonText}<br><span class="cmp-note">{r.w.price.unit === 'per-group' ? `1組 ${r.w.price.text}。` : ''}税込・手数料は予約サイトで確認</span></td>
    <td>{r.w.duration.text}</td>
    <td>{r.ticketUrl && <a class="cmp-btn" href={r.ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show={r.w.id} data-place="guide-compare">予約サイト →</a>}<br><a href={`#card-${r.w.id}`} style="color:var(--accent);font-size:12.5px">詳しく</a></td>
  </tr>
))}
</tbody></table></div>
<p class="cmp-note-p">1組料金の公演は人数で割った1人あたりの金額を併記。開催日は公式ページに掲載された日付で、日本時間です。</p>
</div>
</details>

<details class="acc" id="choose">
<summary><span class="acc-t">人数・好み・参加形式で選ぶ</span><span class="acc-s">1人／2人／演者と会話／屋内・屋外／怖くない</span></summary>
<div class="acc-b">
<p class="lede">各公演の公式ページで確認できた条件から当てはめています。条件に合う公演が確認できない場合は「{none}」と表示します。</p>
<p class="lede">詳しい判断材料は、<a href="/guide/immersive-tokyo-solo/" style="color:var(--accent)">一人で参加する場合</a>（1名で申し込めるか・1名だけで成立するか・交流の有無）と<a href="/guide/immersive-tokyo-date/" style="color:var(--accent)">二人で参加する場合</a>（二人分の総額・貸切か・同じ組で行動できるか）に分けてまとめています。{EXPERIENCE_DATE_PUBLISHED && <>イマーシブに決めていない二人が、ものづくり・謎解きも含めて比べるなら<a href="/guide/tokyo-experience-date/" style="color:var(--accent)">東京の非日常デート</a>。</>}</p>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>条件</th><th>当てはまる公演</th><th>確認するポイント</th></tr></thead><tbody>
<tr><th scope="row">1人で申し込める</th><td>{pick.soloBook.length ? names(pick.soloBook) : none}</td><td>1名で申し込めても、他の参加者と一緒に体験する「相席」形式の場合があります</td></tr>
<tr><th scope="row">1人だけで体験する（相席なし）</th><td>{pick.soloRun.length ? names(pick.soloRun) : none}</td><td>1名だけで回が成立するかは公式ページの「申込人数」「貸切」の欄で確認</td></tr>
<tr><th scope="row">2人で参加できる</th><td>{pick.pair.length ? names(pick.pair) : none}</td><td>下限が2名の公演は1名では申し込めません</td></tr>
<tr><th scope="row">2人だけで貸切にできる</th><td>{pick.pairPrivate.length ? names(pick.pairPrivate) : none}</td><td>申込単位で貸切の公演は、2名で申し込めば2名だけで体験できます（料金は1組単位）</td></tr>
<tr><th scope="row">演者（キャスト）と会話する</th><td>{pick.actor.length ? names(pick.actor) : none}</td><td>会話が進行の一部になる公演は、その場で反応するだけで成立します。演技は求められません</td></tr>
<tr><th scope="row">鑑賞が中心（会話は少ない）</th><td>{compareRows.filter((r) => r.w.info.movement === 'seated').length ? names(compareRows.filter((r) => r.w.info.movement === 'seated')) : none}</td><td>劇中セットを歩く展示型や、座って観る時間が長い公演が該当します</td></tr>
<tr><th scope="row">謎解きが中心／物語への参加が中心</th><td>{compareRows.map((r) => `${r.w.title}：${r.w.info.puzzle ?? '公式ページで確認'}`).join('　')}</td><td>パズルを解く型と、証言や手がかりを整理する型があります</td></tr>
<tr><th scope="row">屋内で完結する</th><td>{pick.indoor.length ? names(pick.indoor) : none}</td><td>商業施設内で完結する公演は雨天でも体験内容が変わりません</td></tr>
<tr><th scope="row">屋外の移動がある</th><td>{pick.outdoorMove.length ? names(pick.outdoorMove) : none}</td><td>受付から会場までの徒歩移動がある公演は、歩きやすい靴と水分を用意</td></tr>
<tr><th scope="row">怖い演出がない</th><td>{pick.notScary.length ? names(pick.notScary) : none}</td><td>公式に「ホラー演出なし」と案内している公演だけを載せています</td></tr>
</tbody></table></div>
<ul class="bullets">
{pick.beginner.map((r) => <li><strong>{r.w.title}</strong>：{r.w.info.beginner}。{r.w.info.participation}</li>)}
</ul>
<p class="vc-line">参加前の準備：<a href="/guide/immersive-preparation/" style="color:var(--accent)">服装・持ち物（公演別チェック表）→</a>／<a href="/guide/magic-show-immersive-chigai/" style="color:var(--accent)">マジックショーとイマーシブ体験の違い →</a></p>
</div>
</details>

<details class="acc" id="now">
<summary><span class="acc-t">公演ごとの詳しい紹介</span><span class="acc-s">参加者がすること・条件・料金</span></summary>
<div class="acc-b">
<div class="sc-grid">
{compareRows.map((r) => (
