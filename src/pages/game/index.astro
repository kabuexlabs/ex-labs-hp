---
// ネタバレ公開済みイベント一覧（2026-09 リニューアル。デザイン元 ListPage.dc.html の game）。
// 各作品のネタバレ本文（/game/*/）は従来の GameLayout のまま。
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHero from '../../components/x/ListHero.astro';
import Cls from '../../components/x/Cls.astro';
import Ph from '../../components/x/Ph.astro';

const games = [
  { img: '/assets/game/null-arden.jpg', href: '/game/null-arden/', title: 'ヌル・アーデン展', date: '2026.4.15 – 5.17', tags: ['絵画', 'イマーシブ', '謎解き'], desc: '“名以外を持たぬ画家” ヌル・アーデンの個展を訪れたあなたたちは、絵画に隠された謎と、閉ざされた空間からの脱出に挑むことになる。「体験する美術館」第1回公演。' },
  { img: '/assets/game/auction.jpg', href: '/game/auction/', title: 'ヌル・アーデン展 オークション', date: '2026.5', tags: ['マーダーミステリー', 'オークション'], desc: '展示で使用された絵画の複製画を競り落とす特別公演。しかし会場には、怪盗［カラス］の影が――。30分の推理劇の顛末を記録する。' },
  { img: '/assets/events/lost-frame.webp', href: '/game/lost-frame/', title: 'ロスト・フレーム', date: '2026', tags: ['周遊型アートイマーシブ', '謎解き'], desc: '下北沢の街に散らばった絵画を探し、隠された物語を辿る。絵画と街が交差する周遊型アートイマーシブ。「体験する美術館」第2回公演。' },
];
---
<BaseLayout
  renewal
  title="ネタバレ公開特設サイト｜株式会社ex Labs"
  description="再演を予定していない謎解き・マーダーミステリー公演のネタバレ記録を公開する、株式会社ex Labs の特設サイトです。「ヌル・アーデン展」「ヌル・アーデン展 オークション」「ロスト・フレーム」の記録を掲載しています。"
  ogImage="/assets/game/null-arden.jpg"
  cutin={[['ネタバレ公開済み', 'イベント一覧']]}
  contact={{ title: ['このような体験の', '制作をご相談ください'] }}
  footer="short"
>
<ListHero crumb="過去コンテンツのネタバレ" en="Spoiler Archive" ja="ネタバレ公開済みイベント一覧" lead="謎解きやマーダーミステリーは、ネタバレが体験を損なうおそれがあります。そのため、再演の予定がないコンテンツに限って公開しています。" />
<section class="xg-sec">
  <div class="xg-in">
    <div class="xg-warn" role="note"><span class="xg-warn-i" aria-hidden="true">!</span><p><Ph list={['このページには', '各公演の結末や', '謎の答えが含まれます。']} /></p></div>
    <div class="x-rail is-bleed" style="--gtc:repeat(auto-fit,minmax(min(100%,320px),1fr));--gap:24px;--col:calc(100% - 52px)">
      {games.map((g) => (
        <article class="xg-card">
          <img src={g.img} alt={g.title} loading="lazy" decoding="async">
          <div class="xg-body">
            <div class="xg-tags">{g.tags.map((t) => <span>{t}</span>)}</div>
            <p class="xg-date">{g.date}</p>
            <h2 class="xg-t">{g.title}</h2>
            <p class="xg-d"><Cls text={g.desc} emph={false} /></p>
            <a href={g.href} class="xg-btn">ネタバレを見る →</a>
          </div>
        </article>
      ))}
    </div>
    <p class="xg-foot"><Ph list={['このような体験型イベントの', '制作のご相談は、']} /><a href="/#service" style="border-bottom:1px solid;color:#fff">サービス一覧</a><span class="x-c">からどうぞ。</span></p>
  </div>
</section>
</BaseLayout>
<style>
.xg-sec{padding:0 16px 120px}
.xg-in{max-width:1100px;margin:0 auto}
.xg-warn{max-width:720px;margin:0 auto 56px;background:var(--x-lime);color:var(--x-ink);padding:20px 24px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:center}
.xg-warn-i{white-space:nowrap;font-family:var(--x-en);font-size:28px;line-height:1}
.xg-warn p{margin:0;font-family:var(--x-min);font-weight:700;font-size:15px;line-height:1.8}
.xg-card{background:var(--x-panel);display:grid;grid-template-rows:auto 1fr;align-content:start}
.xg-card img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;display:block}
.xg-body{padding:24px 22px 28px;display:grid;gap:14px}
.xg-tags{display:flex;flex-wrap:wrap;gap:6px}
.xg-tags span{font-size:11px;font-weight:700;padding:4px 9px;background:var(--x-card);color:var(--x-blue)}
.xg-date{margin:0;font-family:var(--x-en);font-size:18px;letter-spacing:.06em;color:var(--x-lime)}
.xg-t{margin:0;font-family:var(--x-min);font-weight:700;font-size:clamp(22px,2.6vw,26px);line-height:1.4}
.xg-d{margin:0;font-size:14px;line-height:1.9;color:var(--x-pale)}
.xg-btn{margin-top:6px;justify-self:start;background:var(--x-lime);color:var(--x-ink)!important;border-radius:999px;padding:12px 22px;font-family:var(--x-min);font-weight:700;font-size:14px}
.xg-foot{margin:40px auto 0;max-width:720px;text-align:center;font-size:14px;line-height:2;color:var(--x-pale)}
</style>
