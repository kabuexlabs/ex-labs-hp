---
// ネタバレ公開特設サイト：ロスト・フレーム 詳細（ネタバレ記録）。
// TODO: 本文は note の記事（体験する美術館 ロスト・フレーム）から移植する。
// 記事内の写真は note (assets.st-note.com) 上の元画像を参照する想定。
import GameLayout from '../../../layouts/GameLayout.astro';

const img = 'https://assets.st-note.com/img';
---

<GameLayout
  title="ロスト・フレーム ネタバレ記録｜株式会社ex Labs"
  description="「体験する美術館」第2回公演『ロスト・フレーム』（2026・下北沢）のネタバレ記録。街に散らばった絵画と物語を辿る周遊型アートイマーシブの全容を掲載しています。"
  ogImage="/assets/events/lost-frame.webp"
>
<div data-screen-label="詳細：ロスト・フレーム">
<header class="dhero">
  <a class="back" href="/game/">← イベント一覧へ戻る</a>
  <h1 class="dtitle">ロスト・フレーム</h1>
  <div class="dsub">LOST FRAME</div>
  <img class="dposter frame" src="/assets/events/lost-frame.webp" alt="ロスト・フレーム キービジュアル" width="800" height="1138">
  <div class="meta">
    <span class="chip">2026</span>
    <span class="chip">体験する美術館 第2回公演</span>
    <span class="chip">周遊型アートイマーシブ × 謎解き</span>
    <span class="chip">再演なし</span>
  </div>
</header>

<div class="gate" id="gate">
  <h2 class="gtitle">⚠ ネタバレ注意</h2>
  <p class="gtext">この先には『ロスト・フレーム』の内容が記録されています。<br>本公演の再演予定はありませんが、<br>体験の記憶を大切にされたい方はご注意ください。</p>
  <button class="btn gbtn" id="revealBtn" type="button">ネタバレを表示する</button>
</div>

<article class="article" id="article" hidden>
{/* TODO: ここから note 記事の本文を移植する（<p class="p">…</p> / <h2 class="sec">◉…</h2> / figure）。 */}
<p class="p">本記事は、「体験する美術館」第2回公演『ロスト・フレーム』のネタバレ記事です。（本文準備中）</p>
<h2 class="sec">◆クレジット</h2>
{/* TODO: クレジットを note 記事から転記する。 */}
<p class="cr">（準備中）</p>
</article>

<nav class="bottomnav">
  <a class="btn" href="/game/null-arden/">第1回公演『ヌル・アーデン展』のネタバレを見る</a>
  <a class="btn" href="/game/">イベント一覧へ戻る</a>
</nav>
</div>

<script is:inline>
  (function () {
    var gate = document.getElementById('gate');
    var article = document.getElementById('article');
    var btn = document.getElementById('revealBtn');
    if (btn && gate && article) {
      btn.addEventListener('click', function () {
        gate.hidden = true;
        article.hidden = false;
        window.scrollTo(0, 0);
      });
    }
  })();
</script>
<noscript><style>#gate{display:none}#article{display:block !important}</style></noscript>
</GameLayout>
