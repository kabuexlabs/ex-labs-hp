---
// Rendered on request so the latest-posts section stays current
// without a redeploy.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SecHead from '../components/x/SecHead.astro';
import Ph from '../components/x/Ph.astro';
import Cls from '../components/x/Cls.astro';
import { eventsData } from '../data/events/index';
import { guideArticles } from '../data/guides';
import { jstDateString } from '../lib/thisWeek';



// 現在実施中のイベント。until（最終開催日、日本時間）を過ぎたものは自動で外し、実績（#works）にだけ残す。
// 最終日は時刻が分からないので「本日最終日」と表示し、翌日から外す。自社公演の最終日は公演データ（src/data/events/）から取る。
const todayJst = jstDateString(new Date());
const lastDateOf = (workId: string, fallback?: string) => eventsData.occurrences.filter((o) => o.workId === workId && o.published && o.eventStatus !== 'cancelled').map((o) => o.date).sort().pop() ?? eventsData.works.find((w) => w.id === workId)?.period?.to ?? fallback;
const allEvents = [
  {
    title: 'ウワサバナシ調査委員会',
    host: 'ex Labs主催',
    place: '渋谷サクラステージ',
    desc: '東急不動産株式会社様・\u200b404 Not Found様・\u200bTSUTAYA様のご協力のもと、\u200b渋谷サクラステージを周遊し\u200b都市伝説の謎を解き明かす\u200bイマーシブ体験。',
    url: 'https://kabuexlabs.com/uwasabanashi/',
    img: '/assets/events/uwasabanashi-kv.webp',
    w: 880, h: 1244,
    until: lastDateOf('uwasabanashi', '2026-10-04'),
  },
  {
    title: '怪盗と秘密の試験',
    host: 'IMMERSIVE ILLUSION',
    place: '東京・六本木',
    desc: '日本一になった実績のある\u200bマジシャン様との\u200bコラボレーションによる、\u200b怪盗の「秘密の試験」に挑む\u200bマジック×イマーシブ公演。\u200b舞台は六本木の会員制バー。',
    url: 'https://kabuexlabs.com/kaitou/',
    img: '/assets/events/kaitou-kv.webp',
    w: 880, h: 1248,
    until: lastDateOf('kaitou', '2026-10-11'),
  },
  {
    title: 'ロスト・フレーム',
    host: '体験する美術館',
    place: '下北沢',
    desc: '下北沢の街に散らばった\u200b絵画を探し、\u200b隠された物語を辿る──\u200b絵画と街が交差する\u200b周遊型アートイマーシブ。',
    url: 'https://kabuexlabs.com/taikenbizyutu/lostframe/',
    img: '/assets/events/lost-frame.webp',
    w: 800, h: 1138,
    until: '2026-08-31', // 全公演終了（制作事例に記載）
  },
];
const liveEvents = allEvents.filter((e) => !e.until || e.until >= todayJst);
const endedEvents = allEvents.filter((e) => e.until && e.until < todayJst);

// お取引先、ご協力企業様 — client/partner company logos shown above the 展開団体
// marquee. 1段構成（7社）。
const partnersRow1: { name: string; logo: string; h?: number }[] = [
  { name: 'Skyland Ventures', logo: '/assets/partners/skylandventures.webp', h: 64 },
  { name: 'COEN', logo: '/assets/partners/coen.webp', h: 40 },
  { name: 'MAISON MARC', logo: '/assets/partners/maisonmarc.webp', h: 46 },
  { name: 'Party', logo: '/assets/partners/party.webp', h: 50 },
  { name: 'Sally', logo: '/assets/partners/sally.webp', h: 44 },
  { name: 'Thermal Climb Studio Fuji', logo: '/assets/partners/thermalclimb.webp', h: 60 },
  { name: 'SHINKUKAN', logo: '/assets/partners/shinkukan.webp', h: 70 },
];
// 少ない枚数でも -50% ループが常に画面幅（4Kワイド含む）を超えるよう
// 十分に複製する。
const partnerRow1Items = Array(4).fill(partnersRow1).flat();

// 展開団体 — self-run labels/communities shown in the About marquee.
// Add `logo: '/assets/groups/xxx.png'` to an entry to show an image
// instead of the text name; `h` tunes the display height (px) since
// the logos have very different aspect ratios.
const groups: { name: string; logo?: string; h?: number }[] = [
  { name: 'ANAVKEY（アナアキー）', logo: '/assets/groups/anavkey.webp', h: 44 },
  { name: 'HACKTALE', logo: '/assets/groups/hacktale.png', h: 34 },
  { name: 'UNLIMITED MYSTERY（東大マーダーミステリーサークル）', logo: '/assets/groups/unlimited-mystery.webp', h: 48 },
  { name: '体験する美術館', logo: '/assets/groups/taiken-bijutsukan.png', h: 72 },
  { name: '午前零時の童話集', logo: '/assets/groups/gozen-reiji.webp', h: 76 },
  { name: 'ウワサバナシ調査委員会', logo: '/assets/groups/uwasabanashi.webp', h: 62 },
  { name: 'IMMERSIVE ILLUSION（イマーシブイリュージョン）', logo: '/assets/groups/immersive-illusion.webp', h: 58 },
  { name: 'myagare（舞やがれ）', logo: '/assets/groups/myagare.webp', h: 60 },
  { name: 'ANATOR', logo: '/assets/groups/anator.webp', h: 40 },
  { name: '体験型取調室 FACTROOM', logo: '/assets/groups/factroom.webp', h: 74 },
];
// Repeat the list so the marquee loop has no visible gap on wide
// screens.
const marqueeItems = Array(4).fill(groups).flat();

// ---- 2026-09 リニューアル：表示用の整形 ----
const liveCards = liveEvents.map((e) => ({ ...e, desc: e.desc.replace(/​/g, ''), id: e.url.split('/').filter(Boolean).pop() ?? 'event' }));

// 主な実績（トップはデザイン確定版の7件）
const works = [
  { img: '/assets/work-1.webp', cat: 'ミステリー原案', client: '博報堂 × 紀伊國屋書店', title: '月明かりの書店と呪われた原稿', desc: '閉店後の紀伊國屋書店を舞台に開催された、一夜限りの体験型イベントの制作を担当しました。' },
  { img: '/assets/work-2.webp', cat: '企画・制作', client: '自社主催', title: 'ヌル・アーデン展', desc: '東京藝術大学出身アーティストとのコラボレーション企画。アートと謎解きを融合した体験型イベントを実施し、公演終了後には作品オークションも開催しました。' },
  { img: '/assets/work-3.webp', cat: '企画・制作', client: '下北沢', title: 'ロスト・フレーム', desc: '下北沢の街全体を舞台としたアート体験型イベントを制作しました。全公演完売（2026年7月〜8月31日）。' },
  { img: '/assets/events/uwasabanashi-kv.webp', cat: '企画・制作', client: '渋谷サクラステージ', title: 'ウワサバナシ調査委員会', desc: '東急不動産株式会社様・404 Not Found様・TSUTAYA様のご協力のもと、渋谷サクラステージを周遊する都市伝説イマーシブ体験を企画・制作。' },
  { img: '/assets/events/kaitou-kv.webp', cat: '企画・制作', client: '六本木会員制バー', title: '怪盗と秘密の試験', desc: '日本一になった実績のあるマジシャン様とのコラボレーションによるマジック×イマーシブ公演を、六本木の会員制バーで企画・制作。' },
  { img: '/assets/work-5.webp', cat: 'コンテンツ制作', client: 'カラオケ館', title: '恣験', desc: '参加者が様々な試験へ挑戦する周遊型頭脳戦コンテンツを制作しました。' },
  { img: '/assets/work-8.webp', cat: '企画・制作', client: '自社主催', title: '東京都頭脳王決定戦', desc: '東京都内4会場を同時に活用し、「東京都で最も頭の良い人を決める」というコンセプトの大型イベントを企画・運営しました。' },
];
const services = [
  { no: '01', href: '/services/immersive/', title: 'イマーシブ制作', desc: '実在する街・空間・ブランドを舞台にした没入型体験を企画・制作。イマーシブの制作依頼・お見積りは無料です。' },
  { no: '02', href: '/services/shisetsu-event/', title: '施設活用イベント', desc: '商業施設・文化施設・観光施設の空間を活かした周遊型イベントで、新規集客と滞在価値向上を実現。' },
  { no: '03', href: '/services/murder-mystery/', title: 'マーダーミステリー制作', desc: '動画企画・店舗集客・イベント向けなど、目的に合わせたオリジナル作品を企画から制作まで一貫対応。マダミスの制作依頼・お見積りは無料です。' },
  { no: '04', href: '/services/nazotoki-kenshu/', title: '謎解き研修', desc: '謎解きを活用した体験型チームビルディング研修。コミュニケーション活性化と相互理解を促進します。' },
  { no: '05', href: '/services/zunousen/', title: '頭脳戦制作', desc: '交渉・心理戦・閃きのゲームに特化したレーベル「HACKTALE」を運営。ルール設計からバランス調整・運営までオリジナル頭脳戦コンテンツを制作。' },
];
// 最新の解説記事（旧トップの「最新記事」枠の代わり。内部リンクを保つ）
const latestGuides = [...guideArticles].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
// 東京で、次の休日に行きたい体験を探す（デート・お出かけの入口）。公開中の記事だけを、この順で出す
const outingCards = ['/guide/tokyo-experience-date/', '/guide/shibuya-rainy-date/', '/guide/tokyo-nazo-date/', '/guide/tokyo-date-under-5000/', '/guide/tokyo-friends-activities/']
  .map((h) => guideArticles.find((g) => g.href === h))
  .filter((g): g is (typeof guideArticles)[number] => !!g)
  .map((g) => { const i = g.title.indexOf('｜'); return { href: g.href, thumb: g.thumb, main: i < 0 ? g.title : g.title.slice(0, i), sub: i < 0 ? '' : g.title.slice(i + 1) }; });
const railStyle = (gtc: string, gap: string, col: string, mt?: string) => `--gtc:${gtc};--gap:${gap};--col:${col};${mt ? `margin-top:${mt};` : ''}`;

---
<BaseLayout renewal cutin={[['場所やIP、', 'ブランドに合った'], ['体験型イベントを', '実施しませんか？']]} contact={{}}>
<style is:global>.x-end.has-contact footer.x-foot{--foot-gap:120px}.xt-guides{margin-top:44px;border-top:1px solid rgba(255,255,255,.3)}
.xt-guides a{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px 18px;align-items:baseline;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.3)}
.xt-g-date{white-space:nowrap;font-family:var(--x-en);font-size:15px;color:var(--x-lime)}
.xt-g-t{font-family:var(--x-min);font-weight:600;font-size:15px;line-height:1.7}
@media(max-width:560px){.xt-guides a{grid-template-columns:minmax(0,1fr)}}
</style>

<section class="xt-hero">
  <div class="xt-hero-top">
    <div class="xt-hero-logo">
      <span class="x-sh-deco" aria-hidden="true">+<span class="x-sh-line"></span></span>
      <img src="/assets/exlabs-logo-w.png" alt="株式会社 ex Labs" width="2048" height="520" fetchpriority="high">
      <span class="x-sh-deco" aria-hidden="true"><span class="x-sh-line"></span>+</span>
    </div>
    <div class="xt-stat">
      <div>
        <div class="xt-stat-l">+ · 累計コンテンツ体験者数</div>
        <div class="xt-stat-n">15,000</div>
      </div>
      <div class="xt-stat-u">人超</div>
    </div>
  </div>
  <div class="xt-hero-body">
    <p class="xt-hero-kick"><span style="flex:0 1 auto"><Ph list={['AI時代に、', '人間が作る面白さを追求する']} /></span><span class="xt-hero-kick-line"></span></p>
    <h1 class="xt-h1"><Ph list={['場所やIP、', 'ブランドに合った']} /><br><Ph list={['体験型イベントを']} /><br><Ph list={['実施しませんか？']} /></h1>
    <p class="xt-hero-en">Experience Entertainment — ex Labs Inc.</p>
    <div class="xt-hero-ctas">
      <a href="#contact" class="x-btn is-lime xt-cta" data-track="cta" data-show="contact" data-place="home-hero">相談してみる</a>
      <a href="#works" class="x-btn is-line xt-cta">実績を見る</a>
    </div>
    <p class="xt-hero-visitor">参加したい方は <a href="/events/" class="x-link-lime" data-track="show" data-show="events" data-place="home-hero">開催中の公演を探す →</a></p>
    <a href="/media/" class="xt-media">
      <span class="xt-media-k">MEDIA</span>
      <span class="xt-media-t"><Ph list={['日本経済新聞様に', '掲載されました']} /></span>
      <span class="xt-media-d"><Cls text="「渋谷サクラステージで周遊型ミステリ体験 新興ex Labs」として紹介されました →" emph={false} /></span>
    </a>
  </div>
</section>

<section id="about" class="xt-pad16">
  <div class="x-wcard xt-card">
    <div class="x-kicker">About</div>
    <h2 class="xt-card-h">会社概要</h2>
    <p class="xt-card-en">ex Labs Inc.</p>
    <p class="xt-about-pre">株式会社ex Labs（イーエックスラボ）は、</p>
    <p class="xt-about-lead"><span class="x-c"><span class="xt-mk">体験型</span></span><span class="x-c"><span class="xt-mk">エンターテインメント</span></span><span class="x-c"><span class="xt-mk">領域</span>を</span><span class="x-c">主軸とする</span><span class="x-c">クリエイティブ</span><span class="x-c">カンパニーです。</span></p>

    <div class="xt-biz-h"><span class="xt-biz-en">Business</span><span class="xt-biz-ja">+ · 事業内容</span></div>
    <div class="x-rail xt-biz" style={railStyle('repeat(auto-fit,minmax(min(100%,300px),1fr))', '12px', '76%', '22px')}>
      {[['01', ['自社主催による', '体験型イベントの', '企画・運営']], ['02', ['法人向け', '体験型コンテンツの', '企画・制作']], ['03', ['体験型', 'エンターテインメント', '領域における', '企画・知見提供']], ['04', ['体験型コンテンツを', '活用した', '社内研修プログラムの', '企画・提供']]].map(([no, t]) => (
        <div class="xt-biz-c"><span class="xt-biz-no">{no}</span><p><Cls text={(t as string[]).join('')} emph={false} /></p></div>
      ))}
    </div>

    <div class="xt-concept">
      <p class="xt-concept-k">Concept</p>
      <p class="xt-concept-t"><span class="x-c">「その場所・</span><span class="x-c">モノに合った</span><span class="x-c">最高の体験を」</span></p>
      <p class="xt-concept-d"><Cls text="商業施設・文化施設・観光施設・IP・ブランドなどの魅力を活かした体験型コンテンツを企画・制作しています。" emph={false} /></p>
    </div>
    <p class="xt-about-note"><Cls text="設立からの期間はまだ長くありませんが、複数の上場企業様とのお取引実績を有しており、Skyland Ventures様をはじめとするベンチャーキャピタル様からのご支援もいただいております。" emph={false} /></p>

    <p class="xt-mq-label" style="margin-top:56px"><Ph list={['+ · お取引先、', 'ご協力企業様']} /></p>
    <div class="xt-mq-wrap"><div class="x-mq" style="--dur:40s;gap:28px">
      {partnerRow1Items.map((p, i) => <div class="xt-mq-cell"><img src={p.logo} alt={i < partnersRow1.length ? p.name : ''} decoding="async"></div>)}
    </div></div>
    <p class="xt-mq-label" style="margin-top:36px">+ · 展開団体</p>
    <div class="xt-mq-wrap"><div class="x-mq is-rev" style="--dur:60s;gap:28px">
      {marqueeItems.map((g, i) => <div class="xt-mq-cell is-round"><img src={g.logo} alt={i < groups.length ? g.name : ''} decoding="async"></div>)}
    </div></div>
  </div>
</section>

<section class="xt-pad16">
  <div style="max-width:1040px;margin:0 auto">
    <SecHead en="Now Showing" size="top" ja="現在実施中のイベント" />
    <p class="xt-sub"><Cls text="画像をタップすると、各イベントの特設サイトへ移動します。" emph={false} /></p>
    <div class="x-hscroll" style="margin-top:40px;gap:20px">
      {liveCards.map((e) => (
        <a href={e.url} class="xt-ev" data-track="show" data-show={e.id} data-place="home-now">
          <img src={e.img} alt={e.title} width={e.w} height={e.h} loading="lazy" decoding="async">
          <div>
            <p class="xt-ev-org"><span class="x-bl">{e.host}</span><span class="x-bl">開催地：{e.place}{e.until === todayJst && '｜本日最終日'}</span></p>
            <h3 class="xt-ev-t">{e.title} ↗</h3>
            <p class="xt-ev-d"><Cls text={e.desc} emph={false} /></p>
          </div>
        </a>
      ))}
    </div>
    {endedEvents.length > 0 && <p class="xt-ended">終了した公演：{endedEvents.map((e, i) => <>{i > 0 && '／'}<a href={e.url} style="border-bottom:1px solid">{e.title}</a>（{e.host}・{e.place}）</>)}。開催日・空席は<a href="/events/" style="border-bottom:1px solid" data-track="show" data-show="events" data-place="home-now">公演を探す</a>で確認できます。</p>}
    {endedEvents.length === 0 && <p class="xt-ended">開催日・空席は<a href="/events/" style="border-bottom:1px solid" data-track="show" data-show="events" data-place="home-now">公演を探す</a>で確認できます。</p>}
  </div>
</section>

{outingCards.length > 0 && (
<section id="outing" class="xt-pad16">
  <div style="max-width:1040px;margin:0 auto">
    <SecHead en="Outing" size="top" ja="東京で、次の休日に行きたい体験を探す" />
    <p class="xt-sub"><Cls text="食事や映画だけではない、東京のデート・お出かけ先を紹介。二人で楽しめる謎解き、イマーシブ体験、街歩き、ものづくり、物語参加型イベントを、料金・時間・アクセスから選べます。" emph={false} /></p>
    <div class="x-hscroll xt-out" style="margin-top:36px;gap:16px">
      {outingCards.map((g) => (
        <a href={g.href} class="xt-out-c" data-track="show" data-show={g.href.split('/')[2]} data-place="home-outing">
          <img src={g.thumb} alt="" width="1200" height="630" loading="lazy" decoding="async">
          <span class="xt-out-t"><Cls text={g.main} emph={false} /></span>
          {g.sub && <span class="xt-out-s"><Cls text={g.sub} emph={false} /></span>}
        </a>
      ))}
    </div>
    <div class="xt-works-more" style="margin-top:32px"><a href="/guide/#date" class="x-btn is-line xt-more" data-track="show" data-show="guide-date" data-place="home-outing">デート・お出かけの記事をすべて見る&nbsp;→</a></div>
  </div>
</section>
)}
<section id="strength" class="xt-pad24">
  <div style="max-width:1040px;margin:0 auto">
    <SecHead en="Strength" size="top" />
    <p class="x-sh-ja"><Ph list={['ex Labsが選ばれる、', '2つの理由']} /></p>
    <div class="x-rail is-bleed" style={railStyle('repeat(auto-fit,minmax(min(100%,420px),1fr))', '56px', 'calc(100% - 52px)', '64px')}>
      <div>
        <div class="xt-str-no">01</div>
        <h3 class="xt-str-h"><Ph list={['受注制作の形式ではなく、', 'レベニューシェア形式で', 'イベント実施が可能。']} /></h3>
        <div class="xt-str-body">
          <p><span class="x-c">弊社は法人様からではなく、</span><span class="x-c"><strong class="xt-lime">イベントのお客様から</strong></span><span class="x-c">収益回収するモデルを</span><span class="x-c">実現しております。</span></p>
          <p><span class="x-c">有料チケット型のイベントで、</span><span class="x-c">チケット売上から</span><span class="x-c">費用を回収する形式</span><span class="x-c">（レベニューシェア）では、</span><span class="x-c">施設側の<strong class="xt-lime">初期費用を抑えた開催</strong>が</span><span class="x-c">可能です。</span></p>
          <p><Ph list={['条件に応じて', '受託・併用でご提案します。']} /></p>
        </div>
        <a href="/services/shisetsu-event/#revenue" class="xt-str-link" data-track="cta" data-show="services-shisetsu" data-place="home-strength">適用条件を見る →</a>
        <ul class="xt-str-ul"><li><Cls text="+ · 企画の中身だけでなく、集客成果まで責任を持ちます。" emph={false} /></li><li><Cls text="+ · 「制作して終わり」ではなく「成功するところまで伴走する」そんな会社を目指しております。" emph={false} /></li></ul>
      </div>
      <div>
        <div class="xt-str-no">02</div>
        <h3 class="xt-str-h"><Ph list={['どんなコンテンツでも', '制作可能！']} /></h3>
