---
// 真凜会 会員限定書庫「捜査資料」：今回の捜査に使われた資料（PDF）のリンク集。パスワードなし。
// 一覧は src/data/karma/caseFiles.ts（リンク名＝元のファイル名、名前順）。PDF 本体は public/assets/karma/files/。
import ShinrinkaiLayout from '../../../../layouts/ShinrinkaiLayout.astro';
import { caseFiles } from '../../../../data/karma/caseFiles';

const files = [...caseFiles]
  .sort((a, b) => a.name.localeCompare(b.name, 'ja', { numeric: true }))
  .map((f) => ({ name: f.name, href: `/assets/karma/files/${f.file}` }));
---
<ShinrinkaiLayout title="捜査資料" path="/karma/shinrinkai/files/" description="真凜会 会員限定書庫「捜査資料」。今回の捜査に使われた資料。">
  <p class="eyebrow">CASE FILES</p>
  <h1 class="page-h1">捜査資料</h1>
  <p class="lead">今回の捜査に使われた資料。<br>ファイル名を押すと PDF が開きます。</p>
  {files.length === 0 ? (
    <p class="pending-box">ただいま公開の準備中です。<br>公開まで、いましばらくお待ちください。</p>
  ) : (
    <ol class="files">
      {files.map((f) => (
        <li><a href={f.href} target="_blank" rel="noopener">{f.name}</a></li>
      ))}
    </ol>
  )}
</ShinrinkaiLayout>
<style>
.files{list-style:none;padding:0;border-top:1px solid var(--rule)}
.files li{border-bottom:1px solid var(--rule)}
.files a{display:flex;align-items:center;gap:14px;padding:18px 4px;font-size:clamp(15px,3.9vw,17px);letter-spacing:.06em;word-break:break-all;line-height:1.7}
.files a::before{content:"PDF";flex:none;font-family:'Cormorant Garamond',serif;font-size:12px;letter-spacing:.12em;color:var(--red-soft);border:1px solid rgba(201,112,95,.6);padding:1px 6px;line-height:1.6}
.files a:hover{color:var(--pink)}
</style>
