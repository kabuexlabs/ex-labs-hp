<style is:global>
html{scroll-behavior:smooth}
body{margin:0;background:#070a0b;color:#e9e3d8;font-family:'Zen Kaku Gothic New','Hiragino Sans',sans-serif;line-height:1.9;font-size:15px;letter-spacing:.03em;-webkit-font-smoothing:antialiased;overflow-x:clip}
/* 粒状ノイズ（画面固定） */
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.10;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .9 0 0 0 0 .85 0 0 0 0 .8 0 0 0 .6 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
a{color:#e9e3d8;text-decoration:none}
