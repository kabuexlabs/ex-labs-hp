---
import SiteGuard from '../../components/SiteGuard.astro';
// 体験型取調室 FACT ROOM 新作公演「臓腑、或いはカルマ」公式LP。
// デザインハンドオフ（design_handoff_karma_lp / README.md）を Astro に移植したもの。
// スマートフォン前提の1カラム構成。PC では中央 600px 幅で表示し、外側は暗色背景。
// コーポレートサイトとはデザイン系統が別物なので BaseLayout は使わず、
// /uwasabanashi/ と同じくこのファイルだけで完結させている。
//
// 未確定（ハンドオフの「要確認」）：販売開始日時・当日券・決済方法／問い合わせ先／
// 役名表記（キャスト告知は「神崎真」、STORY は「新崎 真」）／NEWS 未掲載。

const assets = '/assets/karma';
const ticketUrl = 'https://escape.id/factroom-org/e-fact-karma/';
const organizerUrl = 'https://escape.id/factroom-org/';
const hashtagUrl = 'https://x.com/search?q=%23%E5%8F%96%E8%AA%BF%E5%AE%A4%E3%82%AB%E3%83%AB%E3%83%9E';
const mapEmbed =
  'https://maps.google.com/maps?q=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%8D%83%E4%BB%A3%E7%94%B0%E5%8C%BA%E7%A5%9E%E7%94%B0%E5%8F%B8%E7%94%BA2-15-11&t=&z=16&ie=UTF8&iwloc=B&output=embed';
const mapLink = 'https://www.google.com/maps/search/?api=1&query=%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%8D%83%E4%BB%A3%E7%94%B0%E5%8C%BA%E7%A5%9E%E7%94%B0%E5%8F%B8%E7%94%BA2-15-11';

const dateShort = '10.10 — 11.8';
const dateLabel = '2026.10.10（土）〜 11.8（日）';

// キャスト（表示順はハンドオフ cast.json 準拠）。
// 一覧写真は /public/assets/karma/cast/<id>.webp（450×600）、
// モーダルの告知カードは /public/assets/karma/cast/card-<n>.webp（900×1272）。
const cast = [
  { id: 'ogawa', card: 1, name: '小川 直彦', role: '神崎真 役', tag: '容疑者', desc: '新興宗教団体のカリスマ教祖。', comment: '皆さまと同じ空間を共有できることを楽しみにしております。' },
  { id: 'hayashi', card: 2, name: 'はやし ゆうへい', role: '神崎真 役', tag: '容疑者', desc: '新興宗教団体のカリスマ教祖。', comment: 'これまでの経験を生かし、今回の公演でも皆さまに心から楽しんでいただける物語体験をお届けできるよう、精いっぱい努めてまいります！よろしくお願いいたします！' },
  { id: 'ando', card: 3, name: '安藤 紫緒', role: '神崎真 役', tag: '容疑者', desc: '新興宗教団体のカリスマ教祖。', comment: 'プレイヤーの皆さまと果たしてどんな物語が紡げるのか、とても楽しみで仕方がありません！' },
  { id: 'tsukina', card: 4, name: '月那 珠梨', role: '神崎真 役', tag: '容疑者', desc: '新興宗教団体のカリスマ教祖。', comment: '皆さまとどんな舌戦ができるのか楽しみです。お待ちしております！' },
  { id: 'manabe', card: 5, name: '真辺 彩加', role: '神崎真 役', tag: '容疑者', desc: '新興宗教団体のカリスマ教祖。', comment: '今回はこれまでに演じたことのないタイプのお役をいただき楽しみにしております。皆様、ぜひ濃厚な時間をともに過ごしましょう。' },
  { id: 'kiritani', card: 6, name: '桐谷 紫月', role: '沖田ゆうき 役', tag: '特別捜査班', desc: 'あなたを導く、先輩刑事。', comment: 'この世界を一緒に楽しみましょうね。' },
  { id: 'shiraha', card: 7, name: '白羽 リナ', role: '沖田ゆうき 役', tag: '特別捜査班', desc: 'あなたを導く、先輩刑事。', comment: '真実とは何なのか。その目で、言葉で確かめてください。捜査へのご協力お待ちしております。' },
  { id: 'haruka', card: 8, name: '遥', role: '沖田ゆうき 役', tag: '特別捜査班', desc: 'あなたを導く、先輩刑事。', comment: '取調という普段では絶対にできないことを体験出来る…凄い！私自身もとても楽しみです！皆さんにお会い出来ることを楽しみにしております。' },
  { id: 'sankai', card: 9, name: '山海 まなり', role: '沖田ゆうき 役', tag: '特別捜査班', desc: 'あなたを導く、先輩刑事。', comment: '先輩捜査官としてバッチリサポートします。一緒に捜査を頑張りましょう！みなさんがどんな結末へたどり着くのか、心から楽しみにしています。' },
];

const faqs = [
  { q: '体験時間は？', a: '約50分です。' },
  { q: '来場前の準備は？', a: '大きな荷物は駅周辺のロッカー等へ預け、開始前にお手洗いを済ませてください。' },
  { q: '初めてでも参加できますか？', a: '初心者も参加できます。先輩刑事・沖田が案内します。' },
  { q: '1人でも参加できますか？', a: '1〜6人で参加できます。1人でも参加できます。' },
  { q: '写真や動画の撮影はできますか？', a: '明確な許可がない限り撮影・録音は禁止です。許可された場合も指定の時間・場所・内容に限ります。' },
  { q: '怖い演出はありますか？', a: '猟奇殺人・遺体・臓器を扱う物語です。ホラー演出の有無は主催者ページをご確認ください。' },
  { q: '年齢条件は？', a: '対象年齢は18歳以上。17歳以下は保護者同伴が必要です。' },
  { q: '購入後にキャンセルや日時変更はできますか？', a: 'お客様都合のキャンセル・払い戻し・日時変更はできません。' },
];

const notes = [
  { n: '01', h: '参加条件', items: ['対象年齢18歳以上。17歳以下は保護者同伴が必要です。', '日本語で進行します。', '飲酒で正常な判断・行動が難しいとスタッフが判断した場合は参加できません。', 'スタッフ・キャストの指示に従わない場合は途中退場となる場合があり、返金はありません。'] },
  { n: '02', h: '受付・持ち物', items: ['受付時間に遅れると、演出・進行の都合で参加できません。', 'クローク・大型荷物の保管場所はありません。大きな荷物は駅周辺のロッカー等へ預け、身軽にご来場ください。', '貴重品は自己管理。紛失・盗難・破損について主催者・会場は免責となります。', '開始前にお手洗いをお済ませください。'] },
  { n: '03', h: '撮影・SNS・禁止事項', items: ['ネタバレのネット・SNS公開は禁止です。', '明確な許可のない写真・動画撮影・録音は禁止。許可時も指定の時間・場所・内容に限ります。', '他の参加者が映った画像・動画の無断公開は禁止です。', 'キャスト・参加者への接触、暴言・威圧的行為、進行妨害は禁止です。', '備品・装飾には案内がある場合を除き触れないでください。'] },
  { n: '04', h: '演出について', items: ['密室の取調室でキャストと対話する体験型サスペンスです。', '猟奇殺人・遺体・臓器を扱う物語です。', 'フィクション作品です。実在の人物・団体・事件とは無関係です。'] },
];

const title = '【公式】臓腑、或いはカルマ | 体験型取調室 FACT ROOM';
const canonical = 'https://kabuexlabs.com/karma/';
const ogImage = `https://kabuexlabs.com${assets}/og.jpg`;
const description =
  '体験型取調室 FACT ROOM 新作「臓腑、或いはカルマ」公式サイト。2026年10月10日〜11月8日、神田・ANATORにて開催。「その言葉は、予言か。殺意か。」';

// 検索結果のリッチリザルト用イベント構造化データ
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'TheaterEvent',
  name: '臓腑、或いはカルマ',
  description,
  url: canonical,
  image: ogImage,
  startDate: '2026-10-10',
  endDate: '2026-11-08',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  inLanguage: 'ja',
  typicalAgeRange: '18-',
  location: {
    '@type': 'Place',
    name: 'ANATOR',
    url: 'https://kabuexlabs.com/anator/',
    address: {
      '@type': 'PostalAddress',
      postalCode: '101-0048',
      streetAddress: '神田司町2-15-11 HARVEY神田司町 4F',
      addressLocality: '千代田区',
      addressRegion: '東京都',
      addressCountry: 'JP',
    },
  },
  offers: {
    '@type': 'Offer',
    price: '4500',
    priceCurrency: 'JPY',
    url: ticketUrl,
    availability: 'https://schema.org/InStock',
  },
  organizer: {
    '@type': 'Organization',
    name: '体験型取調室 FACT ROOM',
    url: organizerUrl,
  },
  performer: cast.map((c) => ({ '@type': 'Person', name: c.name })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#0d1213">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="臓腑、或いはカルマ｜体験型取調室 FACT ROOM">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Cormorant:wght@600;700&display=swap" rel="stylesheet">
<SiteGuard />
</head>
<body>

<div class="page">

<header class="hdr">
  <div class="hdr-row">
    <a href="#kv" class="hdr-brand">
      <span class="hdr-org">体験型取調室 FACT ROOM</span>
      <span class="hdr-title">臓腑、或いはカルマ</span>
    </a>
    <span class="hdr-date">{dateShort}</span>
  </div>
  <nav class="karma-nav" aria-label="ページ内メニュー">
    <a href="#story">STORY</a>
    <a href="#about">ABOUT</a>
    <a href="#cast">CAST</a>
    <a href="#ticket">TICKET</a>
    <a href="#notes">NOTES</a>
    <a href="#access">ACCESS</a>
    <a href="#faq">FAQ</a>
  </nav>
</header>

<main>

<section class="kv" id="kv">
  <img class="kv-img" src={`${assets}/kv.webp`} alt="臓腑、或いはカルマ キービジュアル" width="1200" height="1695" fetchpriority="high">
  <div class="dateband">
    <span class="db-year">2026</span>
    <div class="db-row">
      <span class="db-num">10/10</span><span class="db-dow">Sat.</span>
      <span class="db-tilde">〜</span>
      <span class="db-num">11/8</span><span class="db-dow">Sun.</span>
    </div>
    <p class="db-venue">神田・ANATOR にて開催</p>
    <p class="db-spec">ルーム型／1〜6人／約50分／¥4,500</p>
  </div>
</section>

<section class="lead">
  <span class="lead-label">体験型取調室 FACT ROOM 新作</span>
  <h1 class="lead-h1">「その言葉は、予言か。殺意か。」</h1>
  <p class="lead-p">容疑者と向き合う密室の取調室。<br>あなた自身が刑事として問いを投げかけ、<br>会話を通じて事件の真相に迫ります。</p>
  <p class="lead-p">今回対峙するのは、<br>とある新興宗教の教祖。</p>
</section>

<section class="sec sec-story" id="story">
  <div class="sh"><h2 class="sh-en">STORY</h2><span class="sh-ja">ストーリー</span></div>
  <div class="story">
    <p>連続猟奇殺人事件で、<br>遺体から臓器が持ち去られる。</p>
    <p>容疑者は、人々を魅了する<br>新興宗教団体の教祖・新崎 真。</p>
    <p>事件前から被害者を名指ししていた彼は、<br>「悪のカルマ」が見える<span class="story-em">と語る。</span></p>
    <p>参加者は特別捜査班の刑事となり、<br>取調室で教祖と対話し、事件の真相を探る。</p>
  </div>
  <p class="note">※フィクション作品です。実在の人物・団体・事件とは無関係です。</p>
</section>

<section class="sec sec-alt sec-about" id="about">
  <div class="sh"><h2 class="sh-en">ABOUT</h2><span class="sh-ja">本作の楽しみ方</span></div>
  <div class="about-cards">
    <div class="ab-card">
      <span class="ab-num">01</span>
      <h3 class="ab-h">刑事として、<br>容疑者を取り調べる。</h3>
      <p class="ab-p">密室で自ら質問し、会話から真相を探る体験です。</p>
    </div>
    <div class="ab-card">
      <span class="ab-num">02</span>
      <h3 class="ab-h">対話する相手は、<br>カリスマ教祖。</h3>
      <p class="ab-p">目の前の演者の言葉を信じるか、疑うか。緊張感のある対話を体験します。</p>
    </div>
    <div class="ab-card">
      <span class="ab-num">03</span>
      <h3 class="ab-h">猟奇殺人と予言。<br>その関係を追う。</h3>
      <p class="ab-p">猟奇殺人と教祖の予言の関係を追うサスペンスです。</p>
    </div>
  </div>
  <div class="about-meta">
    <div class="chips">
      <span class="chip">ルーム型</span>
      <span class="chip">1〜6人</span>
      <span class="chip">約50分</span>
      <span class="chip">日本語進行</span>
    </div>
    <p class="about-p">参加者は物語の登場人物となり、キャストとの会話や参加者同士の協力を行います。<br>初心者歓迎。先輩刑事・沖田が案内します。</p>
  </div>
</section>

<section class="sec sec-cast" id="cast">
  <div class="sh"><h2 class="sh-en">CAST</h2><span class="sh-ja">出演者</span></div>
  <div class="castgrid">
    {cast.map((c, i) => (
      <button class="castcard" type="button" data-cast={i} aria-haspopup="dialog">
        <img class="castimg" src={`${assets}/cast/${c.id}.webp`} alt={c.name} loading="lazy" width="450" height="600">
        <span class="castmeta">
          <span class="castrole">{c.role}</span>
          <span class="castname">{c.name}</span>
        </span>
      </button>
    ))}
  </div>
  <p class="note">※ 写真をタップすると出演者コメントをご覧いただけます</p>
</section>

<dialog class="castdlg" id="castdlg" aria-label="出演者コメント">
<div class="dlgbody">
  <button class="dlgclose" type="button" aria-label="閉じる">×</button>
  <div class="dlgfig"><img class="dlgimg" id="dlgimg" src="" alt="" width="900" height="1272"></div>
  <div class="dlginfo">
    <span class="dlgtag" id="dlgtag"></span>
    <div class="dlgnames">
      <span class="dlgrole" id="dlgrole"></span>
      <h3 class="dlgname" id="dlgname"></h3>
    </div>
    <p class="dlgdesc" id="dlgdesc"></p>
    <div class="dlgcomment">
      <span class="dlgcomment-label">COMMENT</span>
      <p class="dlgcomment-p" id="dlgcomment"></p>
    </div>
  </div>
</div>
</dialog>

<section class="sec sec-ticket" id="ticket">
  <div class="sh"><h2 class="sh-en">TICKET</h2><span class="sh-ja sh-ja-dark">チケット</span></div>
  <div class="pricebox">
    <span class="pricelabel">全日程共通</span>
    <p class="priceval">¥4,500<span class="priceunit">／1枚</span></p>
    <a class="buy" href={ticketUrl} target="_blank" rel="noopener" data-track="ticket" data-show="karma" data-place="ticket">チケット購入（ESCAPE.ID）</a>
    <p class="pricenote">ESCAPE.IDの作品ページからご購入いただけます。</p>
  </div>
  <div class="tkt-table">
    <div class="tkt-th">開催日</div><div class="tkt-td">{dateLabel}</div>
    <div class="tkt-th">会場</div><div class="tkt-td">ANATOR<br><span class="tkt-addr">東京都千代田区神田司町2-15-11 4F</span></div>
    <div class="tkt-th">参加人数</div><div class="tkt-td">1〜6人</div>
    <div class="tkt-th">所要時間</div><div class="tkt-td">約50分</div>
    <div class="tkt-th tkt-last">変更・取消</div><div class="tkt-td tkt-last tkt-cancel">購入後の自己都合によるキャンセル・払い戻し・日時変更は不可。チケットの規定人数より少なく来場しても参加できますが、人数減による返金は不可。</div>
  </div>
</section>

<section class="sec sec-alt sec-team" id="team">
  <div class="sh"><h2 class="sh-en">TEAM</h2><span class="sh-ja">制作チーム</span></div>
  <div class="team-org">
    <span class="team-label">主催</span>
    <h3 class="team-name">体験型取調室 FACT ROOM</h3>
    <a class="team-link" href={organizerUrl} target="_blank" rel="noopener">主催者ページ →</a>
  </div>
  <dl class="team-dl">
    <dt>脚本・演出</dt><dd>久畑バク</dd>
    <dt>制作進行</dt><dd>かふ</dd>
    <dt>キービジュアル</dt><dd>荒牧まりの</dd>
    <dt>企画・プロデュース</dt><dd>樋口玄馬(HIGE)</dd>
    <dt>運営</dt><dd><a href="https://kabuexlabs.com/" target="_blank" rel="noopener">株式会社 exLabs</a></dd>
  </dl>
</section>

<section class="sec sec-notes" id="notes">
  <div class="sh"><h2 class="sh-en">NOTES</h2><span class="sh-ja">注意事項</span></div>
  <p class="notes-sub">ご購入前に必ずご確認ください</p>
  <div class="notes">
    {notes.map((n) => (
      <div class="note-card">
        <h3 class="note-h"><span class="note-num">{n.n}</span>{n.h}</h3>
        <ul>{n.items.map((t) => <li>{t}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<section class="sec sec-alt sec-access" id="access">
  <div class="sh"><h2 class="sh-en">ACCESS</h2><span class="sh-ja">会場案内</span></div>
  <div class="ac-info">
    <h3 class="ac-name">ANATOR</h3>
    <p class="ac-addr">〒101-0048<br>東京都千代田区神田司町2-15-11<br>HARVEY神田司町 4F</p>
    <p class="ac-station">小川町駅から徒歩2分<br>淡路町駅から徒歩2分</p>
  </div>
  <iframe class="map" title="ANATOR 地図" src={mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  <div class="ac-btns">
    <a class="btn-line" href={mapLink} target="_blank" rel="noopener">Google Map →</a>
    <a class="btn-line" href="https://kabuexlabs.com/anator/" target="_blank" rel="noopener">会場ページ →</a>
  </div>
</section>

<section class="sec sec-faq" id="faq">
  <div class="sh"><h2 class="sh-en">FAQ</h2><span class="sh-ja">よくある質問</span></div>
  <div class="faqlist">
    {faqs.map(({ q, a }) => (
      <div class="faq">
        <span class="faq-q">Q</span>
        <p class="faq-qp">{q}</p>
        <span class="faq-a">A</span>
