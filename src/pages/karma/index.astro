.castname{font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-size:13px;letter-spacing:.04em;color:#f3eee5}

/* キャストモーダル */
.castdlg{background:#0d1213;color:#e9e3d8;border:1px solid rgba(233,227,216,.15);max-width:560px;width:calc(100% - 32px);box-sizing:border-box;padding:0;max-height:92svh;overflow:auto;position:fixed;margin:auto;font-family:'Zen Kaku Gothic New','Hiragino Sans',sans-serif;letter-spacing:.03em;line-height:1.9}
.dlgbody{display:flex;flex-direction:column;gap:20px;padding:20px}
.castdlg::backdrop{background:rgba(5,8,9,.88);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.dlgclose{position:absolute;top:6px;right:10px;background:none;border:0;color:#c9c3b8;font-size:28px;cursor:pointer;line-height:1;z-index:2;text-shadow:0 0 6px #000;padding:0 2px}
.dlgclose:hover{color:#d33a33}
/* iOS Safari は縦並び flex の直下に置いた img を縦に引き伸ばすことがあるため、
   div で包んで flex の伸縮対象から外し、縦横比（900×1272）を CSS で固定する */
.dlgbody>*{flex:0 0 auto;min-height:0}
.dlgfig{width:100%;aspect-ratio:900/1272;border:1px solid rgba(233,227,216,.12);box-sizing:border-box;background:#0a0e0f}
.dlgimg{width:100%;height:100%;display:block;object-fit:contain}
.dlginfo{display:flex;flex-direction:column;gap:10px}
.dlgtag{font-size:11px;letter-spacing:.25em;color:#b8201f;font-weight:700}
.dlgnames{display:flex;flex-direction:column;gap:2px}
.dlgrole{font-size:12px;letter-spacing:.12em;color:#9aa29e}
.dlgname{font-size:24px;letter-spacing:.08em;color:#f3eee5}
.dlgdesc{font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-size:14px;color:#c9c3b8}
