/* TEAM */
.team-org{display:flex;flex-direction:column;gap:6px;align-items:center;text-align:center}
.team-label{font-size:11px;letter-spacing:.2em;color:#9aa29e}
.team-name{font-size:22px;letter-spacing:.1em;line-height:1.4}
.team-link{font-size:12px;letter-spacing:.15em;color:#c9c3b8;border-bottom:1px solid rgba(201,195,184,.4)}
.team-link:hover{color:#d33a33;border-color:#d33a33}
.team-dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:10px 20px;font-size:14px;width:100%;border-top:1px solid rgba(233,227,216,.12);padding-top:24px}
.team-dl dt{color:#9aa29e;letter-spacing:.12em;white-space:nowrap}
.team-dl dd{margin:0}

/* NOTES */
.notes-sub{font-size:12px;color:#9aa29e;text-align:center}
.notes{display:flex;flex-direction:column;gap:14px;width:100%;font-size:13px;color:#c9c3b8}
.note-card{background:#0a0e0f;border:1px solid rgba(233,227,216,.1);padding:22px 20px;display:flex;flex-direction:column;gap:10px}
.note-h{font-size:16px;letter-spacing:.1em;color:#f3eee5;display:flex;gap:10px;align-items:center}
