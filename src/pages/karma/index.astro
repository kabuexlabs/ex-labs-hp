.tkt-table{width:100%;border:1px solid rgba(233,227,216,.35);font-size:14px;display:grid;grid-template-columns:100px 1fr;box-sizing:border-box}
.tkt-th{padding:14px 14px;border-bottom:1px solid rgba(233,227,216,.35);border-right:1px solid rgba(233,227,216,.35);color:#f3eee5}
