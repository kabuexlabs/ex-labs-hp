.note{font-size:11px;color:#9aa29e;text-align:center}
/* 英字見出し＋日本語タグ（重なりは意図的） */
.sh{position:relative;display:inline-block;padding:0 12px 10px 0}
.sh-en{font-family:'Cormorant',serif;font-size:52px;font-weight:600;letter-spacing:.04em;color:#f3eee5;line-height:1}
