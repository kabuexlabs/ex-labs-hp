.priceunit{font-family:'Zen Kaku Gothic New','Hiragino Sans',sans-serif;font-size:13px;letter-spacing:.1em;margin-left:8px;color:#c9c3b8;font-weight:400}
.buy{display:block;width:100%;box-sizing:border-box;background:#b8201f;color:#fff;font-weight:700;letter-spacing:.14em;padding:16px;text-align:center;margin-top:8px;transition:background .2s ease}
