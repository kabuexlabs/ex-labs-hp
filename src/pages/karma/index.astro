.hdr-brand:hover{color:#e9e3d8}
.hdr-org{font-family:'Zen Kaku Gothic New','Hiragino Sans',sans-serif;font-size:9px;letter-spacing:.12em;color:#8a928e;font-weight:500}
.hdr-title{font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-size:15px;font-weight:700;letter-spacing:.04em;color:#f3eee5}
.hdr-date{font-family:'Cormorant',serif;font-size:14px;letter-spacing:.06em;color:#e9e3d8;font-weight:600}
.karma-nav{display:flex;gap:0;padding:0 8px;overflow-x:auto;scrollbar-width:none;font-family:'Cormorant',serif;font-size:13px;font-weight:600;letter-spacing:.08em;border-top:1px solid rgba(233,227,216,.06)}
.karma-nav::-webkit-scrollbar{display:none}
.karma-nav a{flex:none;padding:8px 10px;color:#c9c3b8}
