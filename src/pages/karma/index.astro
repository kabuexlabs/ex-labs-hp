/* KV */
@keyframes karma-fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.kv{animation:karma-fade .9s ease both}
.kv-img{width:100%;height:auto;display:block}
.dateband{background:#e9e3d8;color:#141a1b;padding:22px 20px 20px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
.db-year{font-family:'Cormorant',serif;font-size:15px;letter-spacing:.3em;font-weight:700}
.db-row{display:flex;align-items:baseline;justify-content:center;gap:6px;flex-wrap:wrap;font-family:'Cormorant','Shippori Mincho B1',serif;font-weight:700;line-height:1}
.db-num{font-size:clamp(48px,14vw,72px);letter-spacing:-.02em}
.db-dow{font-size:13px;letter-spacing:.1em;writing-mode:vertical-rl;align-self:center}
.db-tilde{font-size:clamp(28px,8vw,40px);color:#b8201f;margin:0 4px}
.db-venue{font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-weight:700;font-size:15px;letter-spacing:.2em;margin-top:6px}
