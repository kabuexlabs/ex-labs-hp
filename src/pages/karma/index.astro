.faq-q,.faq-a{font-family:'Cormorant',serif;font-size:20px;font-weight:700;line-height:1.3}
.faq-q{color:#b8201f}
.faq-a{color:#9aa29e}
.faq-qp{font-weight:700;color:#f3eee5;line-height:1.7}
.faq-ap{color:#c9c3b8;text-wrap:pretty;font-size:13px}

/* CONTACT / フッター */
.ftr{display:flex;flex-direction:column;gap:20px;border-top:1px solid rgba(233,227,216,.12);padding-top:32px;font-size:12px;color:#9aa29e;width:100%;text-align:center;align-items:center}
.ftr-brand{display:flex;flex-direction:column;gap:6px;align-items:center}
.ftr-title{font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-size:22px;color:#f3eee5;letter-spacing:.08em}
.ftr-org{font-size:11px;letter-spacing:.2em}
.ftr-tag{color:#d33a33;margin-top:6px}
.ftr-tag:hover{color:#f3eee5}
.ftr-credits{display:flex;flex-direction:column;gap:2px;line-height:1.8}
.ftr-link{color:#c9c3b8}
.ftr-notes{display:flex;flex-direction:column;gap:8px;line-height:1.8;font-size:11px}

/* 下部固定バー（常時表示） */
.bottombar{position:fixed;bottom:0;left:0;right:0;z-index:60;display:flex;justify-content:center;pointer-events:none}
.bottombar-in{display:grid;grid-template-columns:1fr 1.3fr;width:100%;max-width:600px;pointer-events:auto;box-shadow:0 -10px 30px rgba(0,0,0,.5)}
.bb-cast,.bb-buy{display:flex;align-items:center;justify-content:center;gap:8px;font-weight:700;padding:18px 12px;transition:background .2s ease}
.bb-cast{background:#e9e3d8;color:#141a1b;font-size:13px;letter-spacing:.12em}
.bb-cast:hover{background:#f3eee5;color:#141a1b}
.bb-buy{background:#b8201f;color:#fff;font-size:14px;letter-spacing:.14em}
.bb-buy:hover{background:#d33a33;color:#fff}

@media (prefers-reduced-motion: reduce){
html{scroll-behavior:auto}
.kv{animation:none}
}
</style>

<script is:inline define:vars={{ cast, assets }}>
(function () {
  var dlg = document.getElementById('castdlg');
  if (!dlg || typeof dlg.showModal !== 'function') return;
  var img = document.getElementById('dlgimg');
  var tag = document.getElementById('dlgtag');
  var role = document.getElementById('dlgrole');
  var name = document.getElementById('dlgname');
  var desc = document.getElementById('dlgdesc');
  var comment = document.getElementById('dlgcomment');
  document.querySelectorAll('.castcard').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var c = cast[Number(btn.dataset.cast)];
      if (!c) return;
      img.src = assets + '/cast/card-' + c.card + '.webp';
      img.alt = c.name + ' キャスト告知カード';
      tag.textContent = c.tag;
      role.textContent = c.role;
      name.textContent = c.name;
      desc.textContent = c.desc;
      comment.textContent = c.comment;
      dlg.scrollTop = 0;
      dlg.showModal();
    });
  });
  dlg.querySelector('.dlgclose').addEventListener('click', function () { dlg.close(); });
  // オーバーレイ（dialog 自身の外側）クリックで閉じる。パネル内のクリックは閉じない
  dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
})();
</script>

