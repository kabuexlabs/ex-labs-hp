p{margin:0}
h1,h2,h3{margin:0;font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-weight:700}
ul{margin:0;padding-left:1.2em}
li{margin:4px 0}
img{max-width:100%}
:where(a,button,summary):focus-visible{outline:2px solid #d33a33;outline-offset:3px}

/* ページ枡（スマホ前提の1カラム。PCは中央600px） */
.page{position:relative;z-index:1;max-width:600px;margin:0 auto;background:#0d1213;box-shadow:0 0 80px rgba(0,0,0,.7);padding-bottom:72px}

/* ヘッダー（sticky） */
.hdr{position:sticky;top:0;z-index:50;background:rgba(13,18,19,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid rgba(233,227,216,.12)}
