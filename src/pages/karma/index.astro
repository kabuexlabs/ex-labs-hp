.sh-ja-dark{background:#0d1213;color:#f3eee5}

/* STORY */
.story{font-family:'Shippori Mincho B1','Hiragino Mincho ProN',serif;font-size:clamp(15px,4.2vw,18px);line-height:2.3;text-align:center;text-wrap:pretty;display:flex;flex-direction:column;gap:28px}
