.ac-btns{display:flex;gap:10px;width:100%}
.btn-line{flex:1;text-align:center;border:1px solid rgba(233,227,216,.4);padding:12px;font-size:12px;letter-spacing:.12em;color:#e9e3d8;transition:color .2s ease,border-color .2s ease}
