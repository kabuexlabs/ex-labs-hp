      <span style="writing-mode:vertical-rl;font-weight:700;font-size:clamp(15px,2.4vw,20px);letter-spacing:.18em;line-height:1;color:#f0ece2;min-height:220px">取材相手の家へ</span>
    </div>
    <div style="direction:ltr;border:1px solid rgba(230,226,216,.55);padding:18px 8px 22px;display:flex;flex-direction:column;align-items:center;gap:14px;background:#e6e2d8;color:#0b0f0f">
