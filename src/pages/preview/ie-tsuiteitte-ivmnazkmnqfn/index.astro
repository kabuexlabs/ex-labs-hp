---
// 「本当に、家、ついて行ってイイですか？」LP（限定公開・関係者確認用）。
// 2026-11-06 デザイン書き出し（LP export：index.html／style.css／main.js／assets/kv.png）の再実装。
// 文言・レイアウト（style 属性）・冒頭演出（メール送信→独白→暗転）は書き出しのまま。コーポレートサイトとは
// デザイン系統が別なので BaseLayout は使わず、このファイルだけで完結させている。経緯・未確定事項は docs/ie-tsuiteitte-lp.md。
//
// 限定公開の仕組み：
//  - URL は推測しにくい /preview/ie-tsuiteitte-ivmnazkmnqfn/。sitemap・llms.txt・ナビ・他ページからのリンクには載せない。
//  - meta robots noindex,nofollow,noarchive ＋ レスポンスヘッダー X-Robots-Tag（このページと vercel.json の /preview/(.*)）。
//  - 環境変数 IE_PREVIEW_PASSWORD を設定すると Basic 認証がかかる（ユーザー名は任意、パスワードだけ照合）。
//    リポジトリが公開なので URL だけでは秘密にならない。未設定の間は URL を知っていれば誰でも見られる。
//  - CDN にキャッシュさせない（Cache-Control: private, no-store。middleware の PRIVATE にも /preview/ を追加済み）。
// 本公開するときは docs/ie-tsuiteitte-lp.md の「本番公開するとき」の手順で、本番URLへ移して noindex を外す。
export const prerender = false;
import { timingSafeEqual } from 'node:crypto';
import SiteGuard from '../../../components/SiteGuard.astro';

// ---- 合言葉（Basic 認証）。未設定なら認証なし ----
const readEnv = (name: string) => ((import.meta.env as Record<string, string | undefined>)[name] ?? process.env[name])?.trim() || undefined;
const PREVIEW_PASSWORD = readEnv('IE_PREVIEW_PASSWORD');
const safeEqual = (a: string, b: string) => { const x = Buffer.from(a); const y = Buffer.from(b); return x.length === y.length && timingSafeEqual(x, y); };
const noIndexHeaders = { 'X-Robots-Tag': 'noindex, nofollow, noarchive', 'Cache-Control': 'private, no-store' };
if (PREVIEW_PASSWORD) {
  const m = /^Basic\s+([A-Za-z0-9+/=]+)$/i.exec(Astro.request.headers.get('authorization') ?? '');
  let ok = false;
  if (m) {
    try {
      const decoded = Buffer.from(m[1], 'base64').toString('utf8');
      ok = safeEqual(decoded.slice(decoded.indexOf(':') + 1), PREVIEW_PASSWORD);
    } catch { ok = false; }
  }
  if (!ok) {
    return new Response('認証が必要です（関係者確認用ページ）', {
      status: 401,
      headers: { ...noIndexHeaders, 'WWW-Authenticate': 'Basic realm="preview", charset="UTF-8"', 'Content-Type': 'text/plain; charset=utf-8' },
    });
  }
}
for (const [k, v] of Object.entries(noIndexHeaders)) Astro.response.headers.set(k, v);

// ---- 差し替え・確定後に入力する項目（書き出しの README「差し替え・未確定箇所」） ----
// チケット販売先URL（https:// から）。未設定の間、「取材に行く」ボタン3か所はページ内の開催概要（#info）へ移動するだけ
const TICKET_URL = '';
// メインビジュアル（書き出しの assets/kv.png を WebP にしたもの。本番画像が届いたらファイル名を変えて差し替え）
const KV_SRC = '/assets/ie-tsuiteitte/kv.webp';
// 開催概要。date／time／meet は空の間、書き出しの仮表記（［…を記載］）をグレーで表示する。改行は \n
const INFO = {
  date: '',       // 開催日程
  time: '',       // 開催時刻
  meet: '',       // 集合場所（路線名・駅名・出口・集合位置）
  duration: '約60分', // 公演時間（書き出しのまま。当日の流れの REC 表記は 70:00 なので要確認）
  price: '1名 6,000円',
};

const hasUrl = /^https?:\/\//.test(TICKET_URL);
const ticketHref = hasUrl ? TICKET_URL : '#info';
const ticketAttrs = hasUrl ? { target: '_blank', rel: 'noopener', 'data-track': 'ticket', 'data-show': 'ie-tsuiteitte' } : {};

const title = '本当に、家、ついて行ってイイですか？';
const description = 'あなたが新人ディレクターとなり、住人の家を取材する体験型ホラー・ミステリー公演。';
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const pageUrl = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL('/assets/ie-tsuiteitte/og.jpg', site).toString();
