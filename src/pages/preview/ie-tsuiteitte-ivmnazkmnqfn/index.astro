    <div id="mail-toast" style="display:none;position:absolute;bottom:44px;left:50%;transform:translateX(-50%);padding:12px 22px;background:#1e2426;color:#e6ebe9;border-radius:8px;font-family:-apple-system,'Hiragino Sans','Noto Sans JP',sans-serif;font-size:14px;letter-spacing:.04em;animation:toastIn .4s ease both;box-shadow:0 8px 24px rgba(0,0,0,.5)">送信しました</div>
