    <div style="display:flex;align-items:center;gap:10px"><span style="width:11px;height:11px;border-radius:50%;background:#e0312b;animation:rec 1.2s infinite"></span><span>REC</span><span id="timecode" style="color:#c8c3b7">00:00:00:00</span></div>
    <span style="color:#c8c3b7">SP ▮▮▮▯</span>
  </div>
