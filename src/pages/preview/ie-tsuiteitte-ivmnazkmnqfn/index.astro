<section style="padding:96px 24px 40px;max-width:760px;margin:0 auto">
  <div data-reveal="0" style="display:inline-flex;align-items:center;gap:14px;font-family:'Zen Kurenaido',sans-serif;font-size:16px;letter-spacing:.24em;color:#4fd3cc"><span style="width:30px;height:1px;background:#4fd3cc"></span>NOTES<span style="width:30px;height:1px;background:#4fd3cc"></span></div>
  <h2 data-reveal="60" style="margin:10px 0 40px;font-weight:700;font-size:clamp(26px,5vw,38px);letter-spacing:.14em;line-height:1.5;color:#f0ece2">ご参加にあたって</h2>
  <div style="display:grid;gap:44px;font-size:clamp(13.5px,3.8vw,15px);line-height:2.1;color:#d8d3c7;text-wrap:pretty">
