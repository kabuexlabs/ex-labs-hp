<script is:inline>
/* ==========================================================
   本当に、家、ついて行ってイイですか？ LP
   - 冒頭演出（メール入力 → 送信 → 独白 → 暗転）
   - スクロール表示
   - タイムコード
   ========================================================== */
(function () {
  'use strict';

  var CONFIG = {
    showIntro: true,   // false で冒頭演出なし
    typingSpeed: 70    // 1文字あたりのms
  };

  var MAIL = 'かしこまりました。\nそれでは、××駅前で待ち合わせをお願いします。';
  var PC   = 'これで、取材の約束はできた。\nあとは当日、待ち合わせ場所へ向かうだけ。';
  var DARK = '——本当に、この人の家について行って\n大丈夫なのだろうか？';

  var $ = function (id) { return document.getElementById(id); };
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var timers = [];
  var finished = false;

  function wait(ms) { return new Promise(function (r) { timers.push(setTimeout(r, ms)); }); }
  function clearTimers() { timers.forEach(clearTimeout); timers = []; }
  function show(id, display) { $(id).style.display = display || 'flex'; }
  function hide(id) { $(id).style.display = 'none'; }

  function type(el, text, ms) {
    var i = 0;
    return new Promise(function (resolve) {
      (function step() {
        if (finished) return resolve();
        i++;
        el.textContent = text.slice(0, i);
        if (i >= text.length) return resolve();
        timers.push(setTimeout(step, /[。、？\n]/.test(text[i - 1]) ? ms * 5 : ms));
      })();
    });
  }

  function revealKv() {
    var kv = $('kv-frame');
    if (kv) kv.style.animation = 'revealIn 1.2s cubic-bezier(.2,.7,.2,1) .15s both';
  }

  function endIntro() {
    var intro = $('intro');
    if (intro) intro.remove();
    document.documentElement.classList.remove('intro-lock');
    $('floating-cta').style.display = 'block';
    revealKv();
  }

  function finish() {
    if (finished) return;
    finished = true;
    clearTimers();
    hide('intro-mail'); hide('intro-pc'); show('intro-dark');
    $('dark-wrap').style.animation = 'shake .22s linear infinite';
    show('intro-flash', 'block');
    setTimeout(function () { $('intro').style.opacity = '0'; }, 350);
    setTimeout(endIntro, 1250);
  }

  async function runIntro() {
    var s = CONFIG.typingSpeed;
    await wait(900);
    await type($('mail-text'), MAIL, s); if (finished) return;
    await wait(700);
    var send = $('mail-send');
    send.style.transform = 'scale(.88)';
    send.style.background = 'rgba(79,211,204,.28)';
    await wait(260);
    $('mail-panel').style.animation = 'flyUp .7s cubic-bezier(.5,0,.9,.4) forwards';
    show('mail-toast', 'block');
    await wait(1400); if (finished) return;
    hide('intro-mail'); show('intro-pc');
    await wait(600);
    await type($('pc-text'), PC, s); if (finished) return;
    await wait(1700);
    hide('intro-pc'); show('intro-dark');
    await wait(900);
    await type($('dark-text'), DARK, Math.round(s * 1.3)); if (finished) return;
    await wait(1800);
    finish();
  }

  function setupReveal() {
    var els = document.querySelectorAll('[data-reveal]');
    if (!('IntersectionObserver' in window) || reduced) {
      els.forEach(function (el) { el.style.opacity = '1'; });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var d = parseInt(e.target.getAttribute('data-reveal') || '0', 10);
        e.target.style.opacity = '1';
        e.target.style.animation = 'revealIn .9s cubic-bezier(.2,.7,.2,1) ' + d + 'ms both';
        io.unobserve(e.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    els.forEach(function (el) { io.observe(el); });
  }

  function setupTimecode() {
    var el = $('timecode');
    if (!el) return;
    var start = performance.now();
    var pad = function (n) { return String(n).padStart(2, '0'); };
    (function tick(now) {
      var t = Math.max(0, now - start);
      el.textContent = [Math.floor(t / 3600000), Math.floor(t / 60000) % 60, Math.floor(t / 1000) % 60, Math.floor(t / 1000 * 30) % 30].map(pad).join(':');
      requestAnimationFrame(tick);
    })(start);
  }

  // 長めの本文：画面に入ったまとまり（.rt）に in を付け、行（.rl）に順番（--i）を振る
  function setupLines() {
    var blocks = document.querySelectorAll('.rt');
    blocks.forEach(function (b) {
      var i = 0;
      b.querySelectorAll('.rl').forEach(function (l) { l.style.setProperty('--i', i++); });
    });
    if (!('IntersectionObserver' in window) || reduced) { blocks.forEach(function (b) { b.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (!e.isIntersecting) return; e.target.classList.add('in'); runType(e.target); io.unobserve(e.target); });
    }, { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
    blocks.forEach(function (b) { io.observe(b); });
  }

  // タイプ打ち（.fx-type）：文字を1つずつ <span class="ch"> に包み、画面に入ったら順に表示（装飾の .em は保つ）
  function setupType() {
    if (reduced) return;
    document.querySelectorAll('.fx-type').forEach(function (el) {
      var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), nodes = [], n;
      while ((n = walker.nextNode())) nodes.push(n);
      nodes.forEach(function (t) {
        var frag = document.createDocumentFragment();
        t.textContent.split('').forEach(function (c) { var sp = document.createElement('span'); sp.className = 'ch'; sp.textContent = c; frag.appendChild(sp); });
        t.parentNode.replaceChild(frag, t);
      });
    });
  }
  function runType(block) {
    block.querySelectorAll('.fx-type').forEach(function (el) {
      var chars = el.querySelectorAll('.ch'), i = 0;
      if (!chars.length) return;
      var delay = (parseInt(el.style.getPropertyValue('--i') || '0', 10)) * 110 + 350;
      setTimeout(function step() {
        if (i > 0) chars[i - 1].classList.remove('cur');
        if (i >= chars.length) return;
        chars[i].classList.add('on', 'cur');
        i++;
        setTimeout(step, /[。、？]/.test(chars[i - 1].textContent) ? 240 : 55);
      }, delay);
    });
  }
  // 文字化け（.fx-scramble）：数秒おきに約0.4秒だけ記号に化けて戻る
  function setupScramble() {
    var els = document.querySelectorAll('.fx-scramble');
    if (!els.length || reduced) return;
    var glyphs = '？?！#＃%&＠*＊†‡§■□▲△◆◇●○×';
    els.forEach(function (el) {
      var orig = el.textContent;
      setInterval(function () {
        var t = 0, iv = setInterval(function () {
          el.textContent = orig.split('').map(function (c) { return Math.random() < 0.7 ? glyphs[Math.floor(Math.random() * glyphs.length)] : c; }).join('');
          if (++t > 7) { clearInterval(iv); el.textContent = orig; }
        }, 55);
      }, 3800 + Math.random() * 1600);
    });
  }

  // 本文の初期化（タイプ打ちの文字分割・1行ずつの表示）は、節分け（下の <script>）が終わってから。読み込めなくても 1.5 秒後には出す
  var textReady = false;
  function initText() { if (textReady) return; textReady = true; setupType(); setupLines(); }
  document.addEventListener('ie:phrased', initText);
  setTimeout(initText, 1500);

  setupReveal();
  setupScramble();
  setupTimecode();

  if (CONFIG.showIntro && !reduced) {
    document.documentElement.classList.add('intro-lock');
    $('intro-skip').addEventListener('click', finish);
    runIntro();
  } else {
    finished = true;
    endIntro();
  }
})();
</script>
<script>
  // 改行ルール（2026-11-08 ユーザー指示「、。で改行する。入らなければ文字サイズを調整して全体のバランスを保つ」）
  //  1) 本文の各行（.rl）と見出し（.fit）を「、。？！」の直後（「」『』（）【】の中は除く）で節（.ph）に分ける。節は inline-block なので途中で折り返さない。
  //  2) 節が1行に入らないときだけ、節の中を文節（BudouX の区切り＝ゼロ幅スペース）で折り返す。
  //  3) 節が少しだけ入らないとき（元の 86% 以上の大きさで入る）は、同じセクションの本文（--fs）／見出し（--fst）を揃えて小さくし、1行に収める。
  //     画面幅が変わったとき・開閉式を開いたときに測り直す。
  import { loadDefaultJapaneseParser, HTMLProcessor } from 'budoux';
  const proc = new HTMLProcessor(loadDefaultJapaneseParser());
  const OPEN = '「『（(【［[', CLOSE = '」』）)】］]', CUT = '、。？！';
  const MIN = 0.86;

  function splitPhrases(el) {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const nodes = []; let n;
    while ((n = walker.nextNode())) nodes.push(n);
    const text = nodes.map((t) => t.data).join('');
    const first = text.search(/\S/); if (first < 0) return;
    const last = text.replace(/\s+$/, '').length;
    const cuts = []; let depth = 0;
    for (let i = first; i < last; i++) {
      const c = text[i];
      if (OPEN.includes(c)) depth++;
      else if (CLOSE.includes(c)) depth = Math.max(0, depth - 1);
      else if (depth === 0 && CUT.includes(c) && i + 1 < last) cuts.push(i + 1);
    }
    const bounds = [first, ...cuts, last];
    const locate = (off) => { let acc = 0; for (const t of nodes) { if (off <= acc + t.data.length) return [t, off - acc]; acc += t.data.length; } const t = nodes[nodes.length - 1]; return [t, t.data.length]; };
    // 後ろの節から包む（前の節の位置がずれないように）。装飾（.em 等）をまたぐ場合は extractContents が自動で分ける
    for (let k = bounds.length - 1; k > 0; k--) {
      const [sn, so] = locate(bounds[k - 1]); const [en, eo] = locate(bounds[k]);
      const r = document.createRange(); r.setStart(sn, so); r.setEnd(en, eo);
      const ph = document.createElement('span'); ph.className = 'ph';
      ph.appendChild(r.extractContents()); r.insertNode(ph);
    }
    el.querySelectorAll('.ph').forEach((ph) => { try { proc.applyToElement(ph); } catch (_) {} });
  }
  document.querySelectorAll('.rl, .fit').forEach(splitPhrases);
  document.dispatchEvent(new CustomEvent('ie:phrased'));

  // 節が折り返している（高さが 1.5 行分より大きい）ものを探し、1行に収まる倍率を求める
  function measure(section) {
    const want = { '--fs': 1, '--fst': 1 };
    section.querySelectorAll('.ph').forEach((ph) => {
      if (!ph.getClientRects().length) return; // 非表示（閉じている開閉式など）
      const lh = parseFloat(getComputedStyle(ph).lineHeight) || 0;
      if (!lh || ph.offsetHeight <= lh * 1.5) return;
      const host = ph.closest('.rl, .fit'); if (!host) return;
      const avail = host.getBoundingClientRect().width;
      // 必要な幅＝文字の実幅の合計（文字ノードだけを測る。要素の箱まで足すと二重に数えてしまう）
      let need = 0; const tw = document.createTreeWalker(ph, NodeFilter.SHOW_TEXT); let tn;
      while ((tn = tw.nextNode())) { const rr = document.createRange(); rr.selectNodeContents(tn); for (const rect of rr.getClientRects()) need += rect.width; }
      if (!need || !avail) return;
      const key = host.classList.contains('fit') ? '--fst' : '--fs';
      const cur = parseFloat(section.style.getPropertyValue(key) || '1');
      const target = cur * (avail / need) * 0.985;
      if (target >= MIN && target < want[key]) want[key] = target;
    });
    return want;
  }
  function fit() {
    document.querySelectorAll('section').forEach((sec) => {
      sec.style.removeProperty('--fs'); sec.style.removeProperty('--fst');
      for (let pass = 0; pass < 2; pass++) {
        const w = measure(sec); let changed = false;
        for (const k in w) {
          const cur = parseFloat(sec.style.getPropertyValue(k) || '1');
          if (w[k] < cur - 0.001) { sec.style.setProperty(k, w[k].toFixed(3)); changed = true; }
        }
        if (!changed) break;
      }
    });
  }
  fit();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  let t; addEventListener('resize', () => { clearTimeout(t); t = setTimeout(fit, 150); });
  document.querySelectorAll('details').forEach((d) => d.addEventListener('toggle', fit));
</script>
</body>
</html>
