---
// 全国学生 未来視察連盟 トップページ（仮・限定公開）。原稿：2026-11-27「LP 原稿（実装用・確定版）」1章。
// 正本メモ：docs/zengaku-lp.md。未確定の値は src/lib/zengaku.ts の VARS。
export const prerender = false;
import ZLayout from '../../../components/zengaku/ZLayout.astro';
import Head from '../../../components/zengaku/Head.astro';
import J from '../../../components/gensou/J.astro';
import { BASE, VARS, SHOW, isClosed, previewGuard, NOINDEX_HEADERS } from '../../../lib/zengaku';

const blocked = previewGuard(Astro.request);
if (blocked) return blocked;
for (const [k, v] of Object.entries(NOINDEX_HEADERS)) Astro.response.headers.set(k, v);
const closed = isClosed();

const activities = [
  { t: '視察', d: '国会、最高裁判所、スタジアムなど、ふだんは入れない現場を訪ねます。', icon: 'pillar' },
  { t: '勉強会', d: '国の取り組みや街づくりについて、担当の方に直接質問します。', icon: 'talk' },
  { t: '海外研修', d: '海外の建築と街を、現地で体感します。第1弾はミラノです。', icon: 'plane' },
  { t: '業種セミナー', d: '賛同企業の仕事を学生が調べ、ピッチ形式で紹介します。', icon: 'mic' },
];
// 活動報告。photo は1件1枚（無い項目は文字だけ）。label の「予定」は実施後に種類（視察・勉強会など）へ変える
const reports: { date: string; label: string; title: string; body: string; photo?: string }[] = [
  { date: '2026.11.09', label: '視察', title: '衆議院議員会館を訪問しました', body: '建築を学ぶ学生とともに衆議院議員会館を訪ね、国会を見学しました。' },
  { date: '2026.11.21', label: '視察', title: '味の素スタジアムを見学しました', body: '試合当日のスタジアムを訪ね、大規模な施設がどう使われているかを見学しました。' },
  { date: '2026.12', label: '予定', title: '最高裁判所・国会議事堂を視察します', body: '歴史ある建築を、建築を学ぶ学生の目で見学します。' },
  { date: SHOW.CAMPUS_SEMINAR, label: '予定', title: '東京大学・早稲田大学でセミナーを開催します', body: '詳細は決まり次第、お知らせします。' },
];
const merits = [
  { t: '本物の現場で、第一線の人から学べる', d: '個人では入れない場所を訪ね、そこで働く方の話を直接聞くことができます。' },
  { t: '海外研修などの機会を、優先して受け取れる', d: 'ミラノ建築短期留学ツアーをはじめ、連盟の企画を優先的にご案内します。' },
  { t: '全国の仲間と、団体を一からつくれる', d: '立ち上げ期のメンバーとして、企画や運営に関わることができます。' },
];
// お知らせ（新しい順。プレスリリースもここへ足す）
const news: { date: string; title: string; href?: string }[] = [
  { date: '2026.12.01', title: 'ミラノ建築短期留学ツアーの応募受付を開始しました', href: `${BASE}/milano/` },
  { date: '2026.11.15', title: '全国学生 未来視察連盟を設立しました' },
];
const repTasks = ['連盟の企画を、自分の大学の学生に伝える', '大学の仲間からの質問や参加の窓口になる', '視察や勉強会の企画に、運営側として関わる'];
const members = [{ role: '代表', name: '飯田 雄貴', aff: '東京大学 法学部' }, ...VARS.MEMBERS];
const KEEP = ['未来視察連盟', '最高裁判所', 'ミラノ建築短期留学ツアー', '学内代表', '業種セミナー', '賛同企業'];
---
<ZLayout
  page="top"
  title="全国学生 未来視察連盟｜教室の外に、未来の教科書がある。"
  description="全国の大学生が、国会・最高裁判所・スタジアム・海外の現場を視察し、未来の社会と仕事を学ぶ学生団体です。ミラノ建築短期留学ツアーの応募を受付中（2027年1月15日締切）。"
  ogTitle="全国学生 未来視察連盟"
  ogDesc="教室の外に、未来の教科書がある。全国の学生が現場を訪ねて学ぶ団体です。"
>
  <!-- 1.1 ファーストビュー -->
  <section class="fv" id="top">
    <div class="wrap fv-in">
      <p class="fv-org">全国学生 未来視察連盟</p>
      <h1 class="fv-catch"><span class="ln">教室の外に、</span><span class="ln"><span class="hl">未来の教科書</span>がある。</span></h1>
      <p class="fv-desc wb"><J t="全国の大学生が、国会・最高裁判所・スタジアム・海外の現場を視察し、未来の社会と仕事を学ぶ学生団体です。" keep={KEEP} /></p>
      <div class="fv-ctas">
        <div class="fv-main">
          {closed
            ? <span class="btn btn-red is-off" aria-disabled="true">応募受付は終了しました</span>
            : <a class="btn btn-red" href={`${BASE}/milano/`}>ミラノ建築短期留学ツアーに応募する<span class="ar" aria-hidden="true">→</span></a>}
          <p class="fv-note">応募締切　2027年1月15日（金）</p>
        </div>
        <a class="btn btn-line" href="#about">連盟について知る<span class="ar" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <!-- 1.2 私たちについて -->
  <section class="sec about" id="about">
    <div class="wrap about-in">
      <Head en="About us" ja="私たちについて" left />
      <div class="about-body">
        <p class="about-catch rv wb"><J t="現場に行かないと、わからないことがある。" /></p>
        <div class="about-txt">
          <p class="rv wb"><J t="社会を動かしている現場は、教室からは見えません。" /></p>
          <p class="rv wb"><J t="全国学生 未来視察連盟は、全国の学生が大学や学部の枠を越えて集まり、国の中枢から街づくりの最前線、そして海外まで、自分の足で訪ねて学ぶ団体です。" keep={KEEP} /></p>
          <p class="rv wb"><J t="見て、聞いて、考えたことを、学生自身の言葉で発信していきます。" /></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1.3 活動内容 -->
  <section class="sec acts" id="activities">
    <div class="wrap">
      <Head en="Activities" ja="活動内容" lead="4つの活動を通じて、未来の社会と仕事を学びます。" />
      <ol class="act-list">
        {activities.map((a, i) => (
          <li class={`act rv d${i + 1}`}>
            <span class="act-no">{String(i + 1).padStart(2, '0')}</span>
            <span class="act-ic" aria-hidden="true">
              {a.icon === 'pillar' && <svg viewBox="0 0 48 48"><path d="M6 18 24 7l18 11M9 18h30M11 22v15M19 22v15M29 22v15M37 22v15M7 41h34" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              {a.icon === 'talk' && <svg viewBox="0 0 48 48"><path d="M7 11h24v15H17l-7 6v-6H7zM35 18h6v14h-3v5l-6-5h-9v-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>}
              {a.icon === 'plane' && <svg viewBox="0 0 48 48"><path d="M5 27l9 2 7-7-12-9 4-2 17 5 7-7c2-2 5-2 6 0s0 4-2 6l-7 7 5 17-2 4-9-12-7 7 2 9-3 1-4-8-8-4z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg>}
              {a.icon === 'mic' && <svg viewBox="0 0 48 48"><rect x="18" y="5" width="12" height="22" rx="6" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M11 22a13 13 0 0 0 26 0M24 35v7M16 42h16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>}
            </span>
            <h3 class="act-t">{a.t}</h3>
            <p class="act-d wb"><J t={a.d} keep={KEEP} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 1.4 活動報告 -->
  <section class="sec reports" id="reports">
    <div class="wrap">
      <Head en="Reports" ja="活動報告" lead="これまでの活動と、これからの予定です。" />
      <ol class="rep-list">
        {reports.map((r) => (
          <li class={`rep rv${r.label === '予定' ? ' is-plan' : ''}${r.photo ? ' has-ph' : ''}`}>
            <div class="rep-meta"><time class="rep-date">{r.date}</time><span class="rep-lb">{r.label}</span></div>
            {r.photo && <figure class="rep-ph"><img src={r.photo} alt="" loading="lazy" /></figure>}
            <div class="rep-body">
              <h3 class="rep-t wb"><J t={r.title} keep={KEEP} /></h3>
              <p class="wb"><J t={r.body} /></p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 1.5 参加するメリット -->
  <section class="sec merits" id="merits">
    <div class="wrap">
      <Head en="Merits" ja="参加するメリット" />
      <ol class="mer-list">
        {merits.map((m, i) => (
          <li class={`mer rv d${i + 1}`}>
            <span class="mer-no" aria-hidden="true">{i + 1}</span>
            <h3 class="mer-t wb"><J t={m.t} keep={KEEP} /></h3>
            <p class="wb"><J t={m.d} keep={KEEP} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 1.6 開催中の企画 -->
  <section class="sec ev" id="event">
    <div class="wrap">
      <div class="ev-card rv">
        <svg class="ev-arch" viewBox="0 0 400 200" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.2">{[0,1,2,3,4,5,6,7].map((i) => <path d={`M${10 + i * 48} 200 V110 a24 24 0 0 1 48 0 V200`} />)}<path d="M0 98h400M0 92h400"/><path d="M120 92 200 30l80 62"/></g></svg>
        <p class="ev-lb">{closed ? '応募受付は終了しました' : '応募受付中'}</p>
        <h2 class="ev-t"><span>ミラノ建築</span><span>短期留学ツアー</span></h2>
        <p class="ev-d wb"><J t="2027年3月、ミラノで建築と街づくりを学ぶ短期留学ツアーです。建築業界に少しでも興味があれば、大学・学年・学部は問いません。" keep={KEEP} /></p>
        <ul class="ev-facts">
          <li><span>時期</span><b>2027年3月</b></li>
          <li><span>人数</span><b>6名</b></li>
          <li><span>応募締切</span><b>1月15日（金）</b></li>
        </ul>
        <a class="btn btn-red" href={`${BASE}/milano/`}>ツアーの詳細を見る<span class="ar" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 1.7 協力・後援（掲載の確認が取れた名前が入るまで出さない） -->
  {VARS.SUPPORTERS.length > 0 && (
    <section class="sec sup" id="supporters">
      <div class="wrap">
        <Head en="Supporters" ja="ご協力いただいている皆さま" />
        <ul class="sup-list">{VARS.SUPPORTERS.map((n) => <li class="rv">{n}</li>)}</ul>
      </div>
    </section>
  )}

  <!-- 1.8 お知らせ -->
  <section class="sec news" id="news">
    <div class="wrap news-in">
      <Head en="News" ja="お知らせ" left />
      <ul class="news-list">
        {news.map((n) => (
          <li class="rv">
            {n.href
              ? <a href={n.href}><time>{n.date}</time><span class="wb"><J t={n.title} keep={KEEP} /></span><i aria-hidden="true">→</i></a>
              : <div><time>{n.date}</time><span class="wb"><J t={n.title} keep={KEEP} /></span></div>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 1.9 学内代表の募集 -->
  <section class="sec repr" id="representative">
    <div class="wrap">
      <div class="repr-card">
        <Head en="Campus representative" ja="あなたの大学の代表になりませんか。" />
        <div class="repr-body rv">
          <p class="wb"><J t="全国の大学で、連盟の活動を広める「学内代表」を募集しています。" keep={KEEP} /></p>
          <p class="wb"><J t="自分の大学の仲間に企画を伝え、参加の窓口になる役割です。学年・学部は問いません。" /></p>
        </div>
        <p class="repr-h rv">学内代表がやること</p>
        <ol class="repr-tasks">
          {repTasks.map((t, i) => <li class={`rv d${i + 1}`}><span aria-hidden="true">{i + 1}</span><span class="wb"><J t={t} keep={KEEP} /></span></li>)}
        </ol>
        <div class="center rv"><a class="btn btn-blue" href={`${BASE}/representative/`}>学内代表に応募する<span class="ar" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <!-- 1.10 運営メンバー -->
  <section class="sec members" id="members">
    <div class="wrap">
      <Head en="Members" ja="運営メンバー" />
      <ul class="mem-list">
        {members.map((m) => (
          <li class="mem rv">
            <span class="mem-av" aria-hidden="true">{m.name.slice(0, 1)}</span>
            <p class="mem-role">{m.role}</p>
            <p class="mem-name">{m.name}</p>
            <p class="mem-aff">{m.aff}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 1.11 お問い合わせ -->
  <section class="sec contact" id="contact">
    <div class="wrap">
      <Head en="Contact" ja="お問い合わせ" lead="活動についてのご質問、取材やご協力のご相談は、下記までご連絡ください。" />
      <div class="ct-box rv">
        <p class="ct-l">メール</p>
        {VARS.CONTACT_EMAIL
          ? <a class="ct-mail" href={`mailto:${VARS.CONTACT_EMAIL}`}>{VARS.CONTACT_EMAIL}</a>
          : <p class="ct-mail"><span class="tbd">準備中</span><span class="tbd-note">未定</span></p>}
        {(VARS.SNS_INSTAGRAM || VARS.SNS_X) && (
          <p class="ct-sns">
            {VARS.SNS_INSTAGRAM && <a href={VARS.SNS_INSTAGRAM} target="_blank" rel="noopener">Instagram</a>}
            {VARS.SNS_X && <a href={VARS.SNS_X} target="_blank" rel="noopener">X</a>}
          </p>
        )}
      </div>
    </div>
  </section>
</ZLayout>

<style>
/* ---------- FV ---------- */
.fv{position:relative;overflow:hidden;background:linear-gradient(180deg,#fff 0%,var(--sky) 100%);padding:88px 0 104px}
.fv::before{content:"";position:absolute;right:-18%;top:-30%;width:80vw;max-width:900px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(37,87,176,.10),rgba(37,87,176,0) 65%)}
.fv::after{content:"";position:absolute;left:-12%;bottom:-40%;width:60vw;max-width:700px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(215,52,60,.08),rgba(215,52,60,0) 65%)}
.fv-in{position:relative;z-index:1;padding-top:40px}
.fv-org{display:inline-block;font-weight:700;font-size:14px;letter-spacing:.28em;color:var(--blue);border-bottom:2px solid var(--red);padding-bottom:4px}
.fv-catch{font-family:var(--mincho);font-weight:800;font-size:clamp(28px,8.2vw,76px);line-height:1.35;letter-spacing:.06em;margin-top:22px}
.fv-catch .ln{display:block;white-space:nowrap}
.js .fv-catch .ln{opacity:0;transform:translateY(18px);animation:up .9s cubic-bezier(.2,.7,.2,1) forwards}
.js .fv-catch .ln:nth-child(2){animation-delay:.25s}
@keyframes up{to{opacity:1;transform:none}}
.hl{position:relative;display:inline-block;z-index:0}
.hl::after{content:"";position:absolute;left:-2%;right:-2%;bottom:.06em;height:.32em;z-index:-1;border-radius:.2em;background:linear-gradient(90deg,rgba(215,52,60,.35),rgba(37,87,176,.35));transform:scaleX(0);transform-origin:left}
.js .hl::after{animation:hl 1s .9s cubic-bezier(.3,.7,.2,1) forwards}
html:not(.js) .hl::after{transform:none}
@keyframes hl{to{transform:scaleX(1)}}
.fv-desc{max-width:30em;margin-top:24px;font-size:clamp(15px,1.6vw,17px);color:var(--ink-2)}
.fv-ctas{display:flex;flex-wrap:wrap;align-items:flex-start;gap:16px 20px;margin-top:36px}
.fv-main{display:flex;flex-direction:column;align-items:center}
.fv-note{margin-top:10px;font-size:13px;font-weight:700;color:var(--red);letter-spacing:.08em}
@media (max-width:760px){
  .fv{padding:48px 0 64px}
  .fv-ctas .btn-red{font-size:15px;letter-spacing:.02em;padding:14px 16px;gap:10px}
  .fv-in{padding-top:0}
  .fv-ctas{flex-direction:column;align-items:stretch}
  .fv-ctas .btn{width:100%;padding:14px 20px}
  .fv-main{align-items:stretch;text-align:center}
}

/* ---------- about ---------- */
.about-in{display:grid;grid-template-columns:280px 1fr;gap:40px}
.about-catch{font-family:var(--mincho);font-weight:800;font-size:clamp(24px,3.4vw,34px);line-height:1.6;letter-spacing:.06em;margin-bottom:26px}
.about-txt p+p{margin-top:1.1em}
.about-txt{font-size:16.5px;line-height:2.1}
@media (max-width:820px){.about-in{grid-template-columns:1fr;gap:0}}

/* ---------- activities ---------- */
.acts{background:var(--sky);position:relative}
.acts::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(37,87,176,.12) 1px,transparent 1.2px);background-size:22px 22px;pointer-events:none}
.acts .wrap{position:relative}
.act-list{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.act{background:#fff;border-radius:var(--r);padding:30px 22px 28px;box-shadow:var(--sh);position:relative;overflow:hidden}
.act::after{content:"";position:absolute;left:0;top:0;width:100%;height:4px;background:linear-gradient(90deg,var(--red),var(--blue))}
.act-no{font-family:var(--en);font-style:italic;font-size:30px;color:var(--red);line-height:1}
.act-ic{display:block;width:52px;height:52px;color:var(--blue);margin:16px 0 10px}
.act-t{font-family:var(--mincho);font-weight:800;font-size:22px;letter-spacing:.08em;margin-bottom:8px}
.act-d{font-size:15px;line-height:1.85;color:var(--ink-2)}
@media (max-width:960px){.act-list{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.act-list{grid-template-columns:1fr}.act{display:grid;grid-template-columns:52px 1fr;column-gap:16px;padding:22px 20px}.act-no{grid-column:1/-1;font-size:24px}.act-ic{grid-row:2/4;margin:8px 0 0}.act-t{margin-top:6px}}

/* ---------- reports ---------- */
.rep-list{max-width:820px;margin:0 auto;position:relative}
.rep-list::before{content:"";position:absolute;left:7px;top:10px;bottom:10px;width:2px;background:linear-gradient(180deg,var(--red),var(--blue))}
.rep{position:relative;padding:0 0 38px 40px}
.rep::before{content:"";position:absolute;left:0;top:6px;width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid var(--red)}
.rep.is-plan::before{border-color:var(--blue);border-style:dashed}
.rep-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.rep-date{font-family:var(--en);font-size:24px;font-weight:600;letter-spacing:.04em;line-height:1.2}
.rep-lb{font-size:12px;font-weight:700;padding:2px 12px;border-radius:999px;background:var(--red);color:#fff;letter-spacing:.1em}
.is-plan .rep-lb{background:var(--sky);color:var(--blue)}
.rep-t{font-family:var(--mincho);font-weight:700;font-size:20px;line-height:1.6;margin:8px 0 4px;letter-spacing:.04em}
.rep-body p{color:var(--ink-2);font-size:15px}
.rep-ph{margin:12px 0 0;border-radius:10px;overflow:hidden;max-width:520px}
.rep-ph img{display:block;width:100%;height:auto}

/* ---------- merits ---------- */
.merits{background:var(--cream)}
.mer-list{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.mer{background:#fff;border-radius:var(--r);padding:34px 26px 30px;border:1px solid var(--line);position:relative}
.mer-no{position:absolute;right:18px;top:6px;font-family:var(--en);font-weight:500;font-size:84px;line-height:1;color:var(--sky-2)}
.mer-t{position:relative;font-family:var(--mincho);font-weight:800;font-size:20px;line-height:1.6;letter-spacing:.04em;margin-bottom:12px;padding-top:28px}
.mer-t::before{content:"";position:absolute;left:0;top:0;width:28px;height:4px;border-radius:2px;background:var(--red)}
.mer p{color:var(--ink-2);font-size:15px;position:relative}
@media (max-width:860px){.mer-list{grid-template-columns:1fr}}

/* ---------- event ---------- */
.ev{padding-top:40px}
.ev-card{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--blue-d),var(--blue) 60%,#3b78d1);color:#fff;border-radius:22px;padding:56px 48px;text-align:center}
.ev-arch{position:absolute;left:50%;bottom:-4px;transform:translateX(-50%);width:min(900px,140%);color:rgba(255,255,255,.14)}
.ev-card>*:not(.ev-arch){position:relative}
