<div class="op" id="op">
  <div class="op-scene" aria-hidden="true">
    {[{ c: 'l', d: '1.9s', n: 2, seed: 1 }, { c: 'c', d: '2.35s', n: 4, seed: 2 }, { c: 'r', d: '2.1s', n: 2, seed: 3 }].map((t) => (
      <div class={`tank ${t.c}`} style={`--d:${t.d}`}>
        {fish(t.n, t.seed).map((f) => <span class={`fs${f.r ? ' r' : ''}`} style={`top:${f.y}%;width:${f.s}px;animation-duration:${f.d}s;animation-delay:${f.dl}s`}><svg viewBox="0 0 36 20" width={f.s} height={Math.round(f.s * 20 / 36)}><use href="#fish"/></svg></span>)}
