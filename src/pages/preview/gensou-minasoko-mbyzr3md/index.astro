//
// 限定公開の仕組み（/preview/ie-tsuiteitte-ivmnazkmnqfn/ と同じ）：
//  - URL は推測しにくい /preview/gensou-minasoko-mbyzr3md/。sitemap・llms.txt・ナビ・他ページからリンクしない。
//  - meta robots noindex ＋ レスポンスヘッダー X-Robots-Tag（このページと vercel.json の /preview/(.*)）。
//  - 環境変数 GENSOU2_PREVIEW_PASSWORD を設定すると Basic 認証（ユーザー名は任意）。未設定なら URL を知っていれば見られる。
//  - CDN にキャッシュさせない（Cache-Control: private, no-store。middleware の PRIVATE に /preview/ あり）。
export const prerender = false;
import { timingSafeEqual } from 'node:crypto';
import SiteGuard from '../../../components/SiteGuard.astro';
import J from '../../../components/gensou/J.astro';
