//  - 環境変数 GENSOU2_PREVIEW_PASSWORD を設定すると Basic 認証（ユーザー名は任意）。未設定なら URL を知っていれば見られる。
//  - CDN にキャッシュさせない（Cache-Control: private, no-store。middleware の PRIVATE に /preview/ あり）。
export const prerender = false;
