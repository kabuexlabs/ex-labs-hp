<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@500;600;700;800&family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Italiana&family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">
<SiteGuard />
<script is:inline>
// js：スクロールで出るアニメーションを有効に。op-on：オープニングを流す（視差効果を減らす設定では流さず、すぐ ready）
(function(){var d=document.documentElement;d.classList.add('js');
var rm=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
if(rm){d.classList.add('ready')}else{d.classList.add('op-on')}
setTimeout(function(){d.classList.add('ready');d.classList.remove('op-on')},9000);})();
</script>
<style is:global>
:root{
  --b1:#1739c6; --b2:#1430b0; --b3:#0e248f; --b4:#0a1a6e; --b5:#071352;
  --ink:#1739c6; --w:#fff; --w8:rgba(255,255,255,.86); --w4:rgba(255,255,255,.38); --w2:rgba(255,255,255,.18);
  --lime:#e6f55c; --black:#0b0b14; --tbd:#ff4d6d;
  --mincho:"Shippori Mincho B1",serif; --goth:"Zen Kaku Gothic New",sans-serif; --en:"Italiana","Cormorant Garamond",serif; --en2:"Cormorant Garamond",serif;
  --ease:cubic-bezier(.2,.7,.2,1);
}
*{box-sizing:border-box;font-variant-numeric:lining-nums !important}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
html.op-on,html.op-on body{overflow:hidden}
body{margin:0;background:var(--b1);color:var(--w);font-family:var(--goth);font-weight:500;-webkit-font-smoothing:antialiased;word-break:keep-all;overflow-wrap:anywhere;line-break:strict}
main{overflow-x:clip}
img{max-width:100%;display:block}
a{color:inherit}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{position:relative;max-width:640px;margin:0 auto;padding:0 24px}

/* ===== オープニング：水槽の明かりが消え、コピーが浮かぶ ===== */
.op{display:none;position:fixed;inset:0;z-index:200;background:#020615;overflow:hidden;transition:opacity 1s ease,filter 1s ease}
.op-on .op{display:block}
.op.out{opacity:0;filter:blur(8px);pointer-events:none}
.op-scene{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:center;gap:12px;padding:0 4vw 30vh;animation:opIn .8s ease both}
.tank{position:relative;flex:none;border-radius:16px 16px 4px 4px;overflow:hidden;background:radial-gradient(120% 70% at 50% 0%,#a5f0ff 0%,#3aa6ec 30%,#1250c4 70%,#0a2a7a 100%);box-shadow:0 0 70px rgba(90,200,255,.55),inset 0 0 40px rgba(255,255,255,.25);animation:off 1.1s linear var(--d) both}
.tank.l,.tank.r{width:min(24vw,200px);height:min(32vh,300px)}
.tank.c{width:min(40vw,320px);height:min(48vh,440px);border-radius:999px 999px 6px 6px}
.tank::before{content:"";position:absolute;inset:0;background:radial-gradient(30px 10px at 20% 30%,rgba(255,255,255,.45),transparent 70%),radial-gradient(44px 12px at 70% 20%,rgba(255,255,255,.4),transparent 70%),radial-gradient(36px 11px at 45% 62%,rgba(255,255,255,.3),transparent 70%),radial-gradient(52px 14px at 85% 78%,rgba(255,255,255,.28),transparent 70%);background-size:140px 120px;animation:causMove 5s linear infinite;mix-blend-mode:screen}
.tank::after{content:"";position:absolute;inset:auto 0 0;height:18%;background:linear-gradient(180deg,transparent,rgba(4,20,60,.55))}
.tank .fs{position:absolute;left:-20%;color:rgba(6,22,70,.75);animation:swim linear infinite}
.tank .fs.r{animation-name:swimR;left:auto;right:-20%}
.tank .fs.r svg{transform:scaleX(-1)}
.op-floor{position:absolute;left:0;right:0;bottom:0;height:30vh;background:radial-gradient(60% 90% at 50% 0%,rgba(90,190,255,.4),transparent 70%);animation:off 1.1s linear 2.5s both}
.op-flash{position:absolute;inset:0;background:#cfe6ff;opacity:0;animation:flash .5s ease 2.55s both;pointer-events:none}
.op-p{position:absolute;inset:0;opacity:0;animation:fadeIn 1.6s ease 2.9s both}
.op-p i{position:absolute;bottom:-10px;width:3px;height:3px;border-radius:50%;background:#bfe6ff;box-shadow:0 0 8px 2px rgba(150,210,255,.7);animation:rise linear infinite}
.op-copy{position:absolute;inset:0;margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center;font:700 clamp(22px,7vw,46px)/1.8 var(--mincho);letter-spacing:.14em;color:#fff}
.op-copy .l{display:block;white-space:nowrap}
.op-copy .ch{display:inline-block;opacity:0;filter:blur(10px);transform:translateY(10px);text-shadow:0 0 10px rgba(255,255,255,.9),0 0 28px rgba(180,200,255,.8),0 0 60px rgba(120,160,255,.6);animation:ch 1.3s ease forwards;animation-delay:calc(3.1s + var(--i) * 75ms)}
.op-line{position:absolute;left:50%;top:calc(50% + clamp(56px,15vw,96px));width:min(70vw,420px);height:1px;background:linear-gradient(90deg,transparent,#fff,transparent);transform:translateX(-50%) scaleX(0);animation:line 1.6s var(--ease) 4.4s both}
.op-skip{position:absolute;right:16px;bottom:calc(16px + env(safe-area-inset-bottom));padding:8px 16px;border:1px solid rgba(255,255,255,.45);border-radius:999px;background:rgba(255,255,255,.04);color:rgba(255,255,255,.85);font:500 12px/1 var(--goth);letter-spacing:.24em;cursor:pointer}
@keyframes opIn{from{opacity:0}to{opacity:1}}
@keyframes off{0%{opacity:1}12%{opacity:.25}20%{opacity:1}34%{opacity:.1}44%{opacity:.85}60%{opacity:.05}100%{opacity:.03}}
@keyframes flash{0%{opacity:0}30%{opacity:.18}100%{opacity:0}}
@keyframes swim{from{transform:translateX(0)}to{transform:translateX(min(60vw,500px))}}
@keyframes swimR{from{transform:translateX(0)}to{transform:translateX(max(-60vw,-500px))}}
@keyframes ch{to{opacity:1;filter:none;transform:none}}
@keyframes line{to{transform:translateX(-50%) scaleX(1)}}
@keyframes fadeIn{to{opacity:1}}

/* ===== スクロールで出るアニメーション（種類） ===== */
/* fi：下から／a-l：左から／a-r：右から／a-z：拡大／a-b：ぼかしから／a-w：左から拭き取り／a-f：めくり */
.js .fi{opacity:0;transform:translateY(28px);transition:opacity 1s ease,transform 1s var(--ease),filter 1.2s ease,clip-path 1.1s var(--ease)}
.js .fi.a-l{transform:translateX(-40px)}
.js .fi.a-r{transform:translateX(40px)}
.js .fi.a-z{transform:scale(.88)}
.js .fi.a-b{transform:none;filter:blur(14px)}
.js .fi.a-w{opacity:1;transform:none;clip-path:inset(0 100% 0 0)}
.js .fi.a-f{transform:perspective(800px) rotateX(55deg);transform-origin:50% 0}
.js .fi.in{opacity:1;transform:none;filter:none;clip-path:inset(0 0 0 0)}
/* stg：子要素が順番に（--i で遅らせる） */
.js .stg > *{opacity:0;transform:translateY(16px) scale(.92);transition:opacity .7s ease,transform .8s var(--ease);transition-delay:calc(var(--i,0) * 80ms)}
.js .stg.in > *{opacity:1;transform:none}
/* 1行ずつ浮かび上がる */
.js .lines .ln{opacity:0;filter:blur(10px);transform:translateY(10px);transition:opacity 1.2s ease,filter 1.2s ease,transform 1.2s var(--ease);transition-delay:calc(var(--i,0) * 320ms)}
.js .lines.in .ln{opacity:1;filter:none;transform:none}
.lines .ln{display:block;white-space:nowrap}

/* 下線の強調（**語句**）。画面に入ると左から引かれる */
.mk{background-image:linear-gradient(transparent 64%,rgba(230,245,92,.62) 64%,rgba(230,245,92,.62) 92%,transparent 92%);background-repeat:no-repeat;background-size:100% 100%;font-weight:700}
.js .in .mk{transition:background-size 1s cubic-bezier(.6,0,.2,1) .5s}
.js .fi .mk,.js .lines .mk{background-size:0 100%}
.js .fi.in .mk,.js .lines.in .mk{background-size:100% 100%}
.glow .mk{color:var(--lime);font-weight:inherit;background-image:linear-gradient(transparent 88%,var(--lime) 88%);text-shadow:0 0 14px rgba(230,245,92,.65)}

/* 未確定（原稿の🟥）の印。本公開前に MARK_TBD=false で消える */
.tbd{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:var(--tbd);color:#fff;font:700 10px/1.6 var(--goth);letter-spacing:.06em;vertical-align:2px;white-space:nowrap}
.tbd-empty{display:inline-block;padding:2px 10px;border:1px dashed var(--tbd);border-radius:4px;color:#ffd6de;font:500 12px/1.7 var(--goth);background:rgba(255,77,109,.12)}
.card .tbd-empty,.tk .tbd-empty,.foot .tbd-empty,.tl-box .tbd-empty,.ov .tbd-empty{color:#c41f44}
.preview-bar{position:relative;z-index:60;background:var(--black);color:#fff;font:500 12px/1.6 var(--goth);text-align:center;padding:8px 16px;letter-spacing:.04em}
.preview-bar b{color:var(--tbd)}

/* 装飾：クラゲ・泡・光の筋・水のゆらめき */
.jelly{position:absolute;pointer-events:none;color:#fff;animation:sway 9s ease-in-out infinite}
.jelly svg{display:block;width:100%;height:auto;overflow:visible}
@keyframes sway{0%,100%{transform:translateY(0) rotate(var(--r,0deg))}50%{transform:translateY(-18px) rotate(calc(var(--r,0deg) + 3deg))}}
.bub{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.bub i{position:absolute;bottom:-20px;border-radius:50%;border:1px solid rgba(255,255,255,.55);background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.7),rgba(255,255,255,.08) 45%,transparent 70%);animation:rise linear infinite}
@keyframes rise{0%{transform:translate(0,0);opacity:0}10%{opacity:.9}50%{transform:translate(-10px,-55vh)}100%{transform:translate(14px,-110vh);opacity:0}}
.rays{position:absolute;inset:-10% -30% 0;pointer-events:none;background:repeating-conic-gradient(from 168deg at 50% -6%,rgba(255,255,255,.10) 0deg 1.6deg,transparent 1.6deg 6deg);-webkit-mask:linear-gradient(180deg,#000 0,rgba(0,0,0,.4) 45%,transparent 75%);mask:linear-gradient(180deg,#000 0,rgba(0,0,0,.4) 45%,transparent 75%);animation:rays 14s ease-in-out infinite alternate}
@keyframes rays{from{transform:rotate(-2deg)}to{transform:rotate(2deg)}}
.caus{position:absolute;inset:0;pointer-events:none;opacity:.35;mix-blend-mode:screen;background:radial-gradient(40px 14px at 20% 30%,rgba(255,255,255,.35),transparent 70%),radial-gradient(60px 18px at 70% 20%,rgba(255,255,255,.3),transparent 70%),radial-gradient(50px 16px at 45% 60%,rgba(255,255,255,.25),transparent 70%),radial-gradient(70px 20px at 85% 75%,rgba(255,255,255,.22),transparent 70%);background-size:300px 260px;animation:causMove 12s linear infinite}
@keyframes causMove{from{background-position:0 0}to{background-position:300px 260px}}

/* hero */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:88px 24px 96px;background:radial-gradient(120% 60% at 50% 0%,rgba(120,190,255,.35),transparent 60%),linear-gradient(180deg,#0c2aa0 0%,var(--b1) 55%,var(--b1) 100%);overflow:hidden;text-align:center}
.hero::after{content:"";position:absolute;top:-20%;bottom:-20%;left:0;width:35%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.13),transparent);transform:translateX(-150%) skewX(-12deg);animation:sweep 8s ease-in-out 3s infinite;pointer-events:none}
@keyframes sweep{0%{transform:translateX(-150%) skewX(-12deg)}35%,100%{transform:translateX(420%) skewX(-12deg)}}
.hero-in{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center}
.js:not(.ready) .hero-in > *{opacity:0}
.hero-logo{width:min(62vw,260px);height:auto;filter:drop-shadow(0 0 18px rgba(170,200,255,.55))}
.ready .hero-logo{animation:logoIn 1.8s var(--ease) both,breathe 5s ease-in-out 2s infinite}
@keyframes logoIn{from{opacity:0;transform:scale(.85);filter:blur(12px) drop-shadow(0 0 18px rgba(170,200,255,.55))}to{opacity:1;transform:none;filter:drop-shadow(0 0 18px rgba(170,200,255,.55))}}
@keyframes breathe{0%,100%{filter:drop-shadow(0 0 14px rgba(170,200,255,.45))}50%{filter:drop-shadow(0 0 30px rgba(190,215,255,.9))}}
.hero-no{margin:28px 0 0;font:600 17px/1 var(--mincho);letter-spacing:.6em;padding-left:.6em}
.ready .hero-no{animation:spread 1.6s var(--ease) .4s both}
@keyframes spread{from{opacity:0;letter-spacing:1.4em}to{opacity:1;letter-spacing:.6em}}
@keyframes bloom{from{opacity:0;filter:blur(14px)}to{opacity:1;filter:none}}
.hero-v{margin:22px 0 0;font:700 clamp(18px,5.2vw,22px)/1.5 var(--mincho);letter-spacing:.14em;padding-left:.14em}
.ready .hero-v{animation:up 1.4s var(--ease) .9s both}
@keyframes tagGlow{0%,100%{box-shadow:0 0 14px rgba(230,245,92,.4)}50%{box-shadow:0 0 34px rgba(230,245,92,.95)}}
.hero-d{margin:18px 0 0;display:flex;flex-direction:column;gap:6px;align-items:center}
.ready .hero-d{animation:up 1.4s var(--ease) 1.2s both}
.hero-d .dt{font:600 clamp(24px,7vw,34px)/1 var(--en2);letter-spacing:.08em}
.hero-d .dt small{font:500 .48em/1 var(--goth);letter-spacing:.1em;margin-left:8px}
.js:not(.ready) .hero .jelly{opacity:0 !important}
.hero .jelly{transition:opacity 2s ease}
@keyframes up{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}

/* 導入（光る見出し） */
.intro{position:relative;padding:56px 0 88px;overflow:hidden}
.glow{margin:0;font:700 clamp(23px,7.2vw,42px)/1.6 var(--mincho);letter-spacing:.06em;color:#fff;text-shadow:0 0 6px rgba(255,255,255,.9),0 0 18px rgba(236,170,255,.7),0 0 36px rgba(160,170,255,.55)}
.exp{margin:44px 0 0;padding:26px 20px 22px;background:var(--b5);border:1px solid rgba(255,255,255,.22)}
.exp-h{display:inline-block;margin:0;padding:3px 12px 4px;background:var(--lime);color:var(--black);font:900 14px/1.4 var(--goth);letter-spacing:.12em}
.exp-lead{margin:14px 0 0;font:700 clamp(19px,5.6vw,24px)/1.65 var(--mincho);letter-spacing:.06em}
.exp-s{margin:18px 0 0;padding:0;list-style:none;display:grid;gap:10px}
.exp-s li{display:grid;grid-template-columns:46px 1fr;gap:12px;align-items:center;padding:12px 14px;background:rgba(255,255,255,.06);border-left:3px solid var(--lime)}
.exp-ic{width:46px;height:46px;border-radius:50%;background:var(--lime);display:flex;align-items:center;justify-content:center}
.exp-ic svg{width:26px;height:26px;color:var(--black)}
.exp-s b{display:block;font:900 17px/1.4 var(--goth);letter-spacing:.1em;color:var(--lime)}
.exp-s p{margin:2px 0 0;font:500 14.5px/1.8 var(--goth);letter-spacing:.02em}

/* 3つのアイコン枠 */
.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:24px}
.tile{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;padding:16px 6px 14px;background:var(--b5);border:1px solid rgba(255,255,255,.22);text-align:center}
.js .stg.tiles > *{transform:perspective(600px) rotateY(80deg)}
.js .stg.tiles.in > *{transform:none}
.tile svg{width:38px;height:38px;color:var(--lime)}
.tiles.in .tile svg{animation:bob 3.2s ease-in-out infinite;animation-delay:calc(var(--i) * .4s)}
@keyframes bob{0%,100%{transform:none}50%{transform:translateY(-4px)}}
.tile b{display:flex;align-items:center;justify-content:center;min-height:2.9em;font:700 12px/1.45 var(--goth);letter-spacing:.02em}
.tile .v{font:900 clamp(18px,5.4vw,22px)/1 var(--goth);letter-spacing:.02em;color:#fff}
.tile .v small{font:700 12px/1 var(--goth);margin-left:1px}

/* 必ずお持ちください（MustBring.astro） */
.need{margin-top:20px;background:#fff;color:var(--black);box-shadow:0 18px 40px rgba(5,15,70,.35)}
.need-h{display:flex;align-items:center;justify-content:center;gap:10px;margin:0;padding:12px 16px;background:var(--black);color:#fff;font:900 clamp(18px,5vw,21px)/1.3 var(--goth);letter-spacing:.12em}
.need-ex{width:26px;height:26px;border-radius:50%;background:var(--lime);color:var(--black);display:flex;align-items:center;justify-content:center;font:900 17px/1 var(--goth);letter-spacing:0}
.need.in .need-ex{animation:ring 2.8s ease-in-out 1s infinite}
@keyframes ring{0%,60%,100%{transform:none}65%{transform:rotate(-16deg) scale(1.15)}72%{transform:rotate(14deg) scale(1.15)}79%{transform:rotate(-8deg)}86%{transform:none}}
.need-b{padding:20px 18px}
.need-g{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.need-g li{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 8px 14px;border:2px solid var(--black);text-align:center}
.need-ic{width:64px;height:64px;border-radius:50%;background:var(--lime);display:flex;align-items:center;justify-content:center}
.need-g.in .need-ic{animation:pop 2.6s ease-in-out infinite;animation-delay:calc(var(--i) * .5s + 1s)}
@keyframes pop{0%,70%,100%{transform:none}78%{transform:scale(1.12)}86%{transform:scale(.97)}}
.need-ic svg{width:34px;height:34px;color:var(--black)}
.need-g b{font:700 clamp(13px,3.9vw,15px)/1.45 var(--goth)}
.nw{white-space:nowrap}
.need-g small{font:500 11.5px/1.5 var(--goth);color:#4b5170}
.need-one{margin:16px 0 0;text-align:center;font:700 16px/1.4 var(--goth)}
.need-one em{position:relative;display:inline-block;font-style:normal;margin-left:6px;padding:0 10px 2px;background:var(--black);color:var(--lime);font-size:22px;overflow:hidden}
.need-one em::after{content:"";position:absolute;top:0;bottom:0;left:-60%;width:40%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-20deg);animation:shine 3.5s ease-in-out 1.5s infinite}
@keyframes shine{0%{left:-60%}40%,100%{left:130%}}
.need-t{margin:12px 0 0;font:500 14px/1.85 var(--goth);text-align:center;color:#2d334f}

/* ボタン（光が走る） */
.btn{position:relative;display:flex;align-items:center;justify-content:center;gap:16px;min-height:68px;margin-top:28px;padding:0 60px 0 24px;background:var(--black);color:#fff;text-decoration:none;font:700 clamp(17px,4.6vw,20px)/1.4 var(--goth);letter-spacing:.14em;white-space:nowrap;text-align:center;overflow:hidden;transition:background .2s,transform .2s;box-shadow:0 6px 18px rgba(5,15,70,.35)}
.btn::before{content:"";position:absolute;top:0;bottom:0;left:-60%;width:35%;background:linear-gradient(90deg,transparent,rgba(230,245,92,.35),transparent);transform:skewX(-20deg);animation:shine 4s ease-in-out infinite}
.btn:hover{background:#1c1c28}
.btn:active{transform:translateY(3px)}
.btn .arw{position:absolute;right:16px;top:50%;width:38px;height:38px;margin-top:-19px;border-radius:50%;background:var(--lime);color:var(--black);display:flex;align-items:center;justify-content:center;animation:nudge 2.4s ease-in-out infinite}
@keyframes nudge{0%,70%,100%{transform:none}80%{transform:translate(3px,-3px)}}
.btn-note{margin:14px 0 0;font:500 12px/1.7 var(--goth);color:var(--w8);text-align:center}

/* セクション見出し（英字＋日本語ラベルを重ねる） */
.sec{position:relative;padding:88px 0 96px}
.sec.dk{background:var(--b3);overflow:hidden}
.sec.dk::before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(closest-side,rgba(120,170,255,.22),transparent);top:-120px;left:-160px;animation:drift 18s ease-in-out infinite alternate;pointer-events:none}
@keyframes drift{from{transform:translate(0,0)}to{transform:translate(60vw,40vh)}}
.sh{position:relative;display:flex;flex-direction:column;align-items:center;margin-bottom:44px;text-align:center}
.sh-en{margin:0;font:400 clamp(60px,18vw,96px)/1 var(--en);letter-spacing:.02em;color:#fff;text-shadow:0 0 22px rgba(160,190,255,.45)}
.js .sh.fi{opacity:1;transform:none}
.js .sh.fi .sh-en{opacity:0;letter-spacing:.35em;filter:blur(8px);transition:opacity 1.2s ease,letter-spacing 1.4s var(--ease),filter 1.2s ease}
.js .sh.fi.in .sh-en{opacity:1;letter-spacing:.02em;filter:none}
.sh-ja{position:relative;margin:-.7em 0 0;padding:5px 14px 6px;background:var(--lime);color:var(--black);font:700 clamp(16px,4.4vw,18px)/1.3 var(--mincho);letter-spacing:.14em;box-shadow:0 6px 18px rgba(5,15,70,.35)}
.js .sh.fi .sh-ja{clip-path:inset(0 100% 0 0);transition:clip-path .8s cubic-bezier(.6,0,.2,1) .5s}
.js .sh.fi.in .sh-ja{clip-path:inset(0 0 0 0)}

/* 項目リスト（◆ラベル） */
.rows{margin:0;padding:0;list-style:none}
.rows > li{padding:20px 0;border-bottom:1px solid var(--w4)}
.rows > li:first-child{padding-top:0}
.rk{display:flex;align-items:center;gap:8px;margin:0 0 8px;font:700 15px/1.5 var(--goth);letter-spacing:.08em;color:var(--lime)}
.rk::before{content:"";width:7px;height:7px;background:var(--lime);transform:rotate(45deg);flex:none}
.in .rk::before{animation:spin 1s var(--ease) both;animation-delay:calc(var(--i,0) * 120ms + .3s)}
@keyframes spin{from{transform:rotate(-315deg) scale(0)}to{transform:rotate(45deg) scale(1)}}
.rv{margin:0;font:500 16px/1.9 var(--goth);letter-spacing:.03em}
.vc-lead,.vc-more,.pt-t,.need-t,.exp-lead,.hero-v{text-wrap:balance}
.rv,.pt-s,.st-s,.tl p,.card-b,.dots li,.vb p,.exp-s p{text-wrap:pretty}

/* 開催概要（白いカード：開催日・集合時刻・会場＋地図） */
.ov{background:#fff;color:var(--black);box-shadow:0 18px 40px rgba(5,15,70,.35)}
.ov-s{padding:22px 20px;border-bottom:1px solid #e3e6f3}
.ov-k{display:flex;align-items:center;gap:8px;margin:0 0 12px;font:700 15px/1.4 var(--goth);letter-spacing:.08em;color:var(--ink)}
.ov-k::before{content:"";width:7px;height:7px;background:var(--ink);transform:rotate(45deg)}
.cal{display:grid;gap:16px}
.cal-m{display:grid;grid-template-columns:52px 1fr;gap:10px;align-items:start}
.cal-ml{display:flex;flex-direction:column;align-items:flex-start;gap:2px;color:var(--ink)}
.cal-ml b{font:700 38px/1 var(--en2)}
.cal-ml span{font:700 11px/1 var(--goth);letter-spacing:.2em}
.cal-d{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.cal-d span{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:7px 4px 5px;background:#eef2ff;border-bottom:2px solid var(--ink)}
.cal-d b{font:700 24px/1 var(--en2)}
.cal-d i{font:700 11px/1.5 var(--goth);font-style:normal;color:var(--ink);white-space:nowrap}
.times{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.times span{padding:8px 0;text-align:center;border:1.5px solid var(--ink);color:var(--ink);font:700 17px/1 var(--goth);letter-spacing:.02em}
.ov-v{margin:0;font:500 15.5px/1.85 var(--goth)}
.ov-v b{font-weight:700}
.map{position:relative;aspect-ratio:16/11;background:#dfe5f7}
.map iframe{display:block;width:100%;height:100%;border:0}
.map-a{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;background:var(--black);color:#fff;text-decoration:none;font:700 14px/1 var(--goth);letter-spacing:.08em}
.map-a .arw{width:28px;height:28px;border-radius:50%;background:var(--lime);color:var(--black);display:flex;align-items:center;justify-content:center;animation:nudge 2.4s ease-in-out infinite}

/* 白いカード（シリーズ紹介） */
.card-w{position:relative;margin:0 auto;max-width:560px;filter:drop-shadow(0 18px 24px rgba(5,15,70,.35))}
.card{position:relative;background:linear-gradient(180deg,#eef2ff 0,#fff 120px);color:var(--ink);padding:40px 28px 24px}
.card-tail{display:block;width:100%;height:46px;margin-top:-1px}
.card-n{margin:0;font:700 clamp(23px,6.8vw,40px)/1.3 var(--mincho);letter-spacing:.12em;white-space:nowrap}
.card-e{margin:6px 0 0;font:500 clamp(20px,5.6vw,26px)/1 var(--en2);letter-spacing:.08em;color:#9aa8e6}
.icons{display:flex;gap:14px;margin:22px 0 0}
.icons a{width:52px;height:52px;border-radius:50%;border:1.5px solid var(--ink);display:flex;align-items:center;justify-content:center;color:var(--ink);text-decoration:none;position:relative}
.icons a::after{content:"";position:absolute;inset:-1.5px;border-radius:50%;border:3px solid transparent;border-bottom-color:var(--ink);transform:rotate(-30deg);animation:orbit 6s linear infinite}
@keyframes orbit{to{transform:rotate(330deg)}}
.nk{display:grid;gap:4px;margin:20px 0 0;padding:16px 18px;border-left:3px solid var(--ink);background:#eef2ff;color:#1b2552;text-decoration:none;transition:background .2s}
.nk:hover{background:#e2e8ff}
.nk-k{font:700 11px/1 var(--en2);letter-spacing:.24em;color:var(--ink)}
.nk-o{font:700 14px/1.5 var(--goth);color:var(--ink)}
.nk-h{font:700 15px/1.7 var(--mincho);letter-spacing:.02em;text-wrap:pretty}
.nk-x{display:inline-flex;align-items:center;gap:6px;margin-top:2px;font:700 12.5px/1.6 var(--goth);color:var(--ink);text-decoration:underline;text-underline-offset:3px}
.card-b{margin:22px 0 0;font:500 15.5px/1.95 var(--goth);letter-spacing:.03em;color:#1b2552}

/* 第1回の感想集（吹き出し） */
.vc-lead{margin:0 0 36px;text-align:center;font:500 14px/1.9 var(--goth);color:var(--w8)}
.vc{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:24px}
.vb{position:relative;max-width:88%;padding:18px 22px 16px;background:#fff;color:#1b2552;border-radius:22px;box-shadow:0 12px 28px rgba(5,15,70,.3)}
.vb p{margin:0;font:500 15px/1.85 var(--goth);letter-spacing:.03em}
.vb::after{content:"";position:absolute;bottom:-12px;width:26px;height:20px;background:#fff;clip-path:polygon(0 0,100% 0,30% 100%)}
.vb.l{align-self:flex-start;border-bottom-left-radius:6px}
.vb.l::after{left:18px}
.vb.r{align-self:flex-end;border-bottom-right-radius:6px;background:#eef2ff}
.vb.r::after{right:18px;background:#eef2ff;clip-path:polygon(0 0,100% 0,70% 100%)}
.vb.in{animation:float 6s ease-in-out 1.2s infinite}
.vb.r.in{animation-delay:2.4s}
@keyframes float{0%,100%{translate:0 0}50%{translate:0 -6px}}
.vc-more{margin:44px 0 0;text-align:center;font:700 clamp(16px,4.4vw,18px)/2 var(--goth);letter-spacing:.06em}
.vc-more a{display:inline-block;margin:0 4px;padding:2px 12px;border-radius:999px;background:var(--lime);color:var(--black);text-decoration:none;font-weight:900;letter-spacing:.02em}
.vc-more.in a{animation:tagGlow 3s ease-in-out infinite}

/* あらすじ */
.story .glow{font-size:clamp(18px,5.6vw,30px);line-height:2}

/* 体験のポイント */
.pts{display:grid;gap:16px;margin:0;padding:0;list-style:none}
.pt{display:grid;grid-template-columns:52px 1fr;gap:14px;padding:22px 20px;background:var(--b5);border:1px solid rgba(255,255,255,.2)}
.pt-no{width:52px;height:52px;border-radius:50%;background:var(--lime);color:var(--black);display:flex;align-items:center;justify-content:center;font:700 24px/1 var(--en2)}
.js .pt .pt-no{transform:rotate(-180deg) scale(.3);transition:transform 1s var(--ease) .3s}
.js .pt.in .pt-no{transform:none}
.pt-t{margin:4px 0 0;font:700 clamp(17px,4.8vw,19px)/1.55 var(--mincho);letter-spacing:.04em}
.pt-s{margin:8px 0 0;font:500 15px/1.9 var(--goth);letter-spacing:.03em;color:var(--w8)}

/* 体験の進め方（ステップ） */
.steps{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.st{position:relative;display:grid;grid-template-columns:58px 1fr;column-gap:14px;padding:16px 16px 16px 14px;background:#fff;color:var(--black)}
.st-n{grid-row:span 2;display:flex;flex-direction:column;align-items:center;justify-content:center;width:58px;height:58px;border-radius:50%;background:var(--ink);color:#fff;font:700 10px/1 var(--en2);letter-spacing:.14em}
.st-n b{font-size:24px;line-height:1}
.st-k{margin:4px 0 0;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;font:900 18px/1.4 var(--goth);letter-spacing:.06em}
.st-k small{font:700 13px/1 var(--en2);letter-spacing:.12em;color:#7a86c4}
.st-s{margin:4px 0 0;font:500 14.5px/1.8 var(--goth);color:#2d334f}
.st:not(:last-child)::after{content:"";position:absolute;left:41px;bottom:-12px;width:10px;height:10px;border-right:2px solid var(--lime);border-bottom:2px solid var(--lime);transform:rotate(45deg);z-index:1}
.steps.in .st:not(:last-child)::after{animation:down 1.6s ease-in-out infinite;animation-delay:calc(var(--i) * .2s)}
@keyframes down{0%,100%{transform:rotate(45deg) translate(0,0)}50%{transform:rotate(45deg) translate(3px,3px)}}
.js .stg.steps > *{transform:translateX(-30px)}
.js .stg.steps.in > *{transform:none}

/* 当日の流れ（時刻付きのタイムライン。線が上から引かれる） */
.tl-box{background:#fff;color:var(--black);padding:22px 18px 6px}
.tl-note{margin:0 0 16px;font:700 13px/1.6 var(--goth);color:var(--ink)}
.tl{margin:0;padding:0;list-style:none}
.tl li{position:relative;display:grid;grid-template-columns:62px 20px 1fr;gap:8px;padding-bottom:22px}
.tl li::before{content:"";position:absolute;left:79px;top:14px;bottom:-6px;width:2px;background:var(--ink);transform-origin:top}
.tl li:last-child::before{background:repeating-linear-gradient(180deg,#9aa5d6 0 5px,transparent 5px 10px);bottom:8px}
.js .tl li::before{transform:scaleY(0);transition:transform .7s ease;transition-delay:calc(var(--i) * .45s + .3s)}
.js .tl-box.in li::before{transform:none}
.tl .t{font:700 16px/1.7 var(--goth);text-align:right;white-space:nowrap}
.tl .d{position:relative;z-index:1;width:16px;height:16px;margin:6px 0 0 2px;border-radius:50%;background:var(--ink);box-shadow:0 0 0 4px #fff}
.js .tl .d,.js .tl .k,.js .tl p{opacity:0;transform:scale(.4);transition:opacity .5s ease,transform .6s var(--ease);transition-delay:calc(var(--i) * .45s)}
.js .tl .k,.js .tl p{transform:translateX(16px)}
.js .tl-box.in .d,.js .tl-box.in .k,.js .tl-box.in p{opacity:1;transform:none}
.tl-box.in .d{animation:pulse 2.4s ease-out infinite;animation-delay:calc(var(--i) * .3s + 2s)}
@keyframes pulse{0%{box-shadow:0 0 0 4px #fff,0 0 0 4px rgba(23,57,198,.5)}100%{box-shadow:0 0 0 4px #fff,0 0 0 14px rgba(23,57,198,0)}}
.tl .k{display:inline-block;padding:3px 10px;background:var(--ink);color:#fff;font:700 clamp(13px,3.9vw,14px)/1.5 var(--goth);letter-spacing:.04em;white-space:nowrap}
.tl p{margin:8px 0 0;font:500 14.5px/1.85 var(--goth);color:#2d334f}
.rcp{margin:0 0 16px;padding-top:14px;border-top:1px solid #e3e6f3;font:700 13px/1.9 var(--goth);color:var(--ink)}

/* チケット（白いカード＋PRICE の縦書き。金額は数字が増える） */
.tk{position:relative;background:#fff;color:var(--ink);padding:30px 44px 26px;box-shadow:0 18px 40px rgba(5,15,70,.35);overflow:hidden;text-align:center}
.tk::before,.tk::after{content:"PRICE";position:absolute;writing-mode:vertical-rl;font:400 34px/1 var(--en);letter-spacing:.06em;color:rgba(23,57,198,.16)}
.tk::before{left:6px;top:12px;animation:slideV 6s ease-in-out infinite alternate}
.tk::after{right:6px;bottom:12px;animation:slideV 6s ease-in-out infinite alternate-reverse}
@keyframes slideV{from{translate:0 0}to{translate:0 30px}}
.tk-h{margin:0;font:700 16px/1.5 var(--goth);letter-spacing:.2em}
.tk-pr{display:inline-flex;align-items:baseline;gap:4px;margin-top:10px;font:700 clamp(50px,15vw,64px)/1 var(--en2);letter-spacing:.02em;color:var(--black)}
.tk-pr small{font:700 14px/1 var(--goth)}
.tk-u{display:block;margin-top:6px;font:700 13px/1.5 var(--goth);color:var(--ink)}
.tk-n{margin:14px 0 0;padding-top:12px;border-top:1px solid #e3e6f3;font:500 13px/1.8 var(--goth);color:#4a5aa8}
.tk-rows{margin-top:36px}

/* 開閉式（注意事項） */
.ac{display:grid;gap:12px}
.ac details{background:var(--b5);border:1px solid rgba(255,255,255,.18)}
.ac summary{list-style:none;display:grid;grid-template-columns:44px 1fr 36px;gap:10px;align-items:center;padding:16px 16px 16px 18px;background:#fff;color:var(--black);cursor:pointer;transition:background .2s}
.ac summary:hover{background:#f3f5ff}
.ac summary::-webkit-details-marker{display:none}
.ac .an{font:700 26px/1 var(--en2);color:var(--ink)}
.ac .at{margin:0;font:700 clamp(16px,4.4vw,18px)/1.5 var(--goth);letter-spacing:.06em}
.ac .ai{width:36px;height:36px;border-radius:50%;background:var(--lime);position:relative;transition:transform .35s var(--ease)}
.ac details[open] .ai{transform:rotate(180deg)}
.ac .ai::before,.ac .ai::after{content:"";position:absolute;left:50%;top:50%;width:13px;height:2px;background:var(--black);transform:translate(-50%,-50%)}
.ac .ai::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .25s}
.ac details[open] .ai::after{transform:translate(-50%,-50%) rotate(0)}
.ac .ab{padding:20px 18px 22px}
.ac .ab .rows > li{padding:14px 0}
.ac .ab .rows > li:first-child{padding-top:0}
.ac .ab .rows > li:last-child{border-bottom:0;padding-bottom:0}
.ac .ab .rk{font-size:14px;margin-bottom:4px}
.ac .ab .rv{font-size:15px;line-height:1.85}
.ac details[open] .ab .rows > li,.ac details[open] .ab .dots > li{animation:open .5s ease both}
.ac details[open] .ab li:nth-child(2){animation-delay:.06s}.ac details[open] .ab li:nth-child(3){animation-delay:.12s}.ac details[open] .ab li:nth-child(4){animation-delay:.18s}.ac details[open] .ab li:nth-child(5){animation-delay:.24s}.ac details[open] .ab li:nth-child(6){animation-delay:.3s}.ac details[open] .ab li:nth-child(7){animation-delay:.36s}
.dots{margin:0;padding:0;list-style:none;display:grid;gap:12px}
.dots li{position:relative;padding-left:18px;font:500 15px/1.85 var(--goth);letter-spacing:.03em}
.dots li::before{content:"";position:absolute;left:2px;top:.75em;width:7px;height:7px;background:var(--lime);transform:rotate(45deg)}
@keyframes open{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

/* クレジット（ライム色の帯） */
.foot{position:relative;background:var(--lime);color:var(--black);padding:88px 0 140px;overflow:hidden;text-align:center}
.foot::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(115deg,rgba(11,11,20,.04) 0 2px,transparent 2px 22px);animation:causMove 30s linear infinite;pointer-events:none}
.xb{position:relative;display:flex;align-items:center;justify-content:center;gap:16px;margin:0 auto;max-width:460px;min-height:104px;padding:0 24px;background:var(--black);color:#fff;text-decoration:none;outline:1px solid var(--black);outline-offset:5px;transition:outline-offset .3s,transform .3s}
.xb:hover{outline-offset:9px}
.xb.in{animation:outl 3s ease-in-out 1s infinite}
@keyframes outl{0%,100%{outline-offset:5px}50%{outline-offset:10px}}
.xb::before,.xb::after{content:"";position:absolute;width:14px;height:14px;border:1.5px solid #fff;border-radius:50%;top:-11px;left:-11px;background:var(--black)}
.xb::after{left:auto;right:-11px}
.xb .xn{font:700 28px/1 var(--mincho);letter-spacing:.1em}
.xb .xo{font:400 clamp(26px,7vw,34px)/1 var(--en);letter-spacing:.06em}
.cr{position:relative;margin:64px 0 0;padding:0;list-style:none;display:grid;gap:30px}
.cr dt{font:700 14px/1 var(--goth);letter-spacing:.24em}
.cr dt::before{content:"+ ·  ";white-space:pre}
.cr dt::after{content:"  · +";white-space:pre}
.cr dd{margin:12px 0 0;font:700 clamp(17px,4.8vw,20px)/1.7 var(--mincho);letter-spacing:.12em}
.cr dd a{text-underline-offset:5px}
.ct{position:relative;display:inline-flex;align-items:center;gap:12px;margin-top:64px;color:var(--black);text-decoration:none;font:700 clamp(14px,4.2vw,16px)/1.6 var(--goth);letter-spacing:.06em;white-space:nowrap}
.ct .arw{width:34px;height:34px;border:1.5px solid var(--black);border-radius:50%;display:flex;align-items:center;justify-content:center;animation:nudge 2.4s ease-in-out infinite}
.ct-m{position:relative;margin:8px 0 0;font:500 14px/1.6 var(--goth)}
.copy{position:relative;margin:36px 0 0;font:600 18px/1 var(--en2);letter-spacing:.14em}

/* 画面下いっぱいの固定ボタン */
.fxbar{position:fixed;left:0;right:0;bottom:0;z-index:50;transform:translateY(110%);transition:transform .45s var(--ease);box-shadow:0 -6px 20px rgba(5,15,70,.35)}
.fxbar.on{transform:none}
.fxbar a{position:relative;display:flex;align-items:center;justify-content:center;gap:12px;min-height:62px;padding:0 16px env(safe-area-inset-bottom);background:var(--lime);color:var(--black);text-decoration:none;white-space:nowrap;font:900 17px/1 var(--goth);letter-spacing:.12em;overflow:hidden}
.fxbar a::before{content:"";position:absolute;top:0;bottom:0;left:-60%;width:30%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);transform:skewX(-20deg);animation:shine 3.6s ease-in-out infinite}
.fxbar .arw{width:30px;height:30px;border-radius:50%;background:var(--black);color:var(--lime);display:flex;align-items:center;justify-content:center;animation:nudge 2.4s ease-in-out infinite}

@media (max-width:370px){
  .wrap{padding:0 18px}
  .ac summary{grid-template-columns:34px 1fr 32px;gap:8px;padding:14px 12px 14px 14px}
  .ac .an{font-size:22px}
  .ac .at{font-size:15px;letter-spacing:.02em}
  .ac .ai{width:32px;height:32px}
  .tl-box{padding:20px 14px 6px}
  .tl li{grid-template-columns:54px 20px 1fr;gap:6px}
  .tl li::before{left:69px}
  .tl .t{font-size:14px}
  .pt{grid-template-columns:44px 1fr;gap:12px;padding:20px 16px}
  .pt-no{width:44px;height:44px;font-size:21px}
  .exp{padding:22px 16px 18px}
  .tile b{font-size:12px}
  .btn{padding:0 56px 0 16px;letter-spacing:.08em}
}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none !important;transition:none !important}
  .bub{display:none}
  .js .fi,.js .stg > *,.js .lines .ln,.js .tl .d,.js .tl .k,.js .tl p{opacity:1 !important;transform:none !important;filter:none !important;clip-path:none !important}
  .js .tl li::before,.js .pt .pt-no{transform:none !important}
  .js .fi .mk,.js .lines .mk{background-size:100% 100% !important}
  .js .sh.fi .sh-ja{clip-path:none !important}
  .js .sh.fi .sh-en{opacity:1 !important;filter:none !important;letter-spacing:.02em !important}
}
</style>
