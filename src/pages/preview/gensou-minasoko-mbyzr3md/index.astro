  <section class="sec dk" id="about" aria-labelledby="h-about">
    <div class="jelly" aria-hidden="true" style="width:min(28vw,140px);right:-4%;top:40px;--r:14deg;opacity:.7;animation-delay:-2s"><svg><use href="#jelly"/></svg></div>
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">About</p><h2 class="sh-ja" id="h-about">開催概要</h2></div>
      <ul class="rows fi">
        {about.map((r) => <li><span class="rk">{r.k}</span><p class="rv"><Tx s={r.s} mark={MARK_TBD} /></p></li>)}
        <li>
