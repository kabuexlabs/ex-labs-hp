        </li>
      </ul>
    </div>
  </section>

  <section class="sec story" id="story" aria-labelledby="h-story">
    <div class="bub" aria-hidden="true" style="opacity:.6">{bubbles.slice(0, 8).map((b) => <i style={`left:${(b.x * 3) % 100}%;width:${b.s}px;height:${b.s}px;animation-duration:${b.d + 4}s;animation-delay:${b.dl}s`}></i>)}</div>
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">Story</p><h2 class="sh-ja" id="h-story">あらすじ</h2></div>
      <p class="glow fi"><J t={"**閉館**した夜のサンシャイン水族館。\n誰もいないはずの館内で、\nイヤホンの向こうから\n「あなた」を呼ぶ声がします。"} keep={KEEP} /></p>
    </div>
  </section>

  <section class="sec dk" id="point" aria-labelledby="h-point">
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">Point</p><h2 class="sh-ja" id="h-point">体験のポイント</h2></div>
      <ol class="pts">
        {points.map((p) => (
          <li class="pt fi"><span class="pt-no">{p.no}</span><div><h3 class="pt-t"><J t={p.t} /></h3><p class="pt-s"><Tx s={p.s} mark={MARK_TBD} /></p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" id="howto" aria-labelledby="h-howto">
    <div class="jelly" aria-hidden="true" style="width:min(24vw,120px);left:-5%;top:100px;--r:-10deg;opacity:.6;animation-delay:-5s"><svg><use href="#jelly"/></svg></div>
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">How to</p><h2 class="sh-ja" id="h-howto">体験の進め方</h2></div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="st fi"><span class="st-n">STEP<b>{s.no}</b></span><p class="st-k">{s.k}<small>{s.en}</small></p><p class="st-s"><Tx s={s.s} mark={MARK_TBD} /></p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec dk" id="flow" aria-labelledby="h-flow">
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">Flow</p><h2 class="sh-ja" id="h-flow">当日の流れ</h2></div>
      <div class="tl-box fi">
        <p class="tl-note">例：18:50集合の回</p>
        <ol class="tl">
          {dayflow.map((f) => <li><span class="t">{f.t}</span><span class="d" aria-hidden="true"></span><div><span class="k">{f.k}</span><p><Tx s={f.s} mark={MARK_TBD} /></p></div></li>)}
        </ol>
      </div>
      {MARK_TBD && <p class="rcp fi">受付の場所：<Tx s="🟥" mark={MARK_TBD} /></p>}
    </div>
  </section>

  <section class="sec" id="ticket" aria-labelledby="h-ticket">
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">Ticket</p><h2 class="sh-ja" id="h-ticket">チケット・参加形式</h2></div>
      <div class="tk fi">
        <h3 class="tk-h">午前零時の幻想集<br>第二夜「水底の夢」</h3>
        <span class="tk-pr">5,500<small>円（税込）</small></span>
        <span class="tk-u">1名</span>
        <p class="tk-n"><Tx s="水族館への入館を含みます。🟥" mark={MARK_TBD} /></p>
      </div>
      <MustBring />
      <a href={reserveHref} class="btn fi" data-place="minasoko-ticket" {...reserveAttrs}>日時を選んで予約する<span class="arw"><svg width="14" height="14" aria-hidden="true"><use href="#arw"/></svg></span></a>
      <ul class="rows tk-rows fi">
        {ticketRows.map((r) => <li><span class="rk">{r.k}</span><p class="rv">{r.todo && MARK_TBD && <><span class="tbd-empty">未定：{r.todo}</span><br></>}<Tx s={r.s} mark={MARK_TBD} /></p></li>)}
      </ul>
    </div>
  </section>

  <section class="sec dk" id="access" aria-labelledby="h-access">
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">Access</p><h2 class="sh-ja" id="h-access">会場・集合案内</h2></div>
      <ul class="rows fi">
        {access.map((r) => <li><span class="rk">{r.k}</span><p class="rv"><Tx s={r.s} todo={r.todo} mark={MARK_TBD} /></p></li>)}
      </ul>
      <div class="qi fi" style="margin-top:28px">
        <div class="map" style="border-top:0"><iframe src={MAP_EMBED} title="サンシャイン水族館の地図（Google マップ）" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
        <a class="map-a" href={MAP_LINK} target="_blank" rel="noopener" data-place="minasoko-map-access">Google マップで開く<span class="arw"><svg width="12" height="12" aria-hidden="true"><use href="#arw"/></svg></span></a>
      </div>
    </div>
  </section>

  <section class="sec" id="notice" aria-labelledby="h-notice">
    <div class="jelly" aria-hidden="true" style="width:min(22vw,110px);right:-3%;top:60px;--r:8deg;opacity:.6;animation-delay:-1s"><svg><use href="#jelly"/></svg></div>
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true">Notice</p><h2 class="sh-ja" id="h-notice">ご参加にあたって</h2></div>
      <div class="ac fi">
        {notices.map((g, i) => (
          <details open={i === 0}>
            <summary><span class="an">{String(i + 1).padStart(2, '0')}</span><h3 class="at">{g.t}</h3><span class="ai" aria-hidden="true"></span></summary>
            <div class="ab">
              {g.rows.every((r) => !r.k) ? (
                <ul class="dots">{g.rows.map((r) => <li><Tx s={r.s} todo={r.todo} mark={MARK_TBD} /></li>)}</ul>
              ) : (
                <ul class="rows">{g.rows.map((r) => <li>{r.k && <span class="rk">{r.k}</span>}<p class="rv"><Tx s={r.s} todo={r.todo} mark={MARK_TBD} /></p></li>)}</ul>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec dk" id="faq" aria-labelledby="h-faq">
    <div class="wrap">
      <div class="sh fi"><p class="sh-en" aria-hidden="true" style="font-family:var(--en2);font-weight:500">FAQ</p><h2 class="sh-ja" id="h-faq">よくある質問</h2></div>
      <div class="faq fi">
        {faqs.map((f) => (
          <details>
            <summary><span class="qm" aria-hidden="true">Q</span><h3 class="qt"><J t={f.q} keep={['スマートフォン']} /></h3><span class="pl" aria-hidden="true">+</span></summary>
            <div class="qa"><span class="am" aria-hidden="true">A</span><p><Tx s={f.a} mark={MARK_TBD} /></p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="fin" aria-label="予約のご案内">
    <div class="rays" aria-hidden="true" style="opacity:.6"></div>
    <div class="bub" aria-hidden="true">{bubbles.slice(4, 14).map((b) => <i style={`left:${b.x}%;width:${b.s}px;height:${b.s}px;animation-duration:${b.d}s;animation-delay:${b.dl}s`}></i>)}</div>
    <div class="wrap">
      <p class="glow fi"><Tx s={CATCH_BR} mark={MARK_TBD} /></p>
      <p class="fin-i fi"><J t={"2027年2月14日（日）〜3月19日（金）の全10日間\nサンシャイン水族館／参加費5,500円（税込）"} keep={KEEP} /></p>
      <MustBring />
      <a href={reserveHref} class="btn fi" data-place="minasoko-bottom" {...reserveAttrs}>チケットを予約する<span class="arw"><svg width="14" height="14" aria-hidden="true"><use href="#arw"/></svg></span></a>
      <ul class="links fi">
        <li><a href={SERIES_URL}>シリーズ公式サイト（第一夜「草陰の夢」）</a></li>
        <li><a href="https://kabuexlabs.com/" target="_blank" rel="noopener">主催者（株式会社ex Labs）サイト</a>{MARK_TBD && <span class="tbd" title="原稿で未確定（🟥）の項目">要確認</span>}</li>
      </ul>
    </div>
  </section>

  <footer class="foot" aria-label="クレジット・お問い合わせ">
    <div class="wrap">
      <a class="xb" href={X_URL} target="_blank" rel="noopener" aria-label={`午前零時の幻想集 公式X ${X_ID}`}><span class="xn">幻想集</span><span class="xo">Official X</span></a>
      <dl class="cr">
        {credits.map((c) => <div><dt>{c.k}</dt><dd><Tx s={c.s} mark={MARK_TBD} /></dd></div>)}
      </dl>
      <a class="ct" href={`mailto:${MAIL}`}>イベントに関するお問い合わせ<span class="arw"><svg width="14" height="14" aria-hidden="true"><use href="#arw"/></svg></span></a>
      <p class="ct-m">{MAIL}</p>
      <p class="copy">© ex Labs Inc.</p>
    </div>
  </footer>
</main>

<nav class="fxbar" id="fx" aria-label="予約・公式X">
  <a class="r" href={reserveHref} data-place="minasoko-fixed" {...reserveAttrs}>チケットを予約する<span class="arw"><svg width="12" height="12" aria-hidden="true"><use href="#arw"/></svg></span></a>
  <a class="x" href={X_URL} target="_blank" rel="noopener" data-place="minasoko-fixed-x"><svg width="14" height="14" aria-hidden="true"><use href="#xlogo"/></svg>公式X</a>
</nav>

<script is:inline>
(function(){
  var fx=document.getElementById('fx'),hero=document.querySelector('.hero'),fin=document.querySelector('.fin');
  if('IntersectionObserver' in window){
    var hv=true,fv=false,up=function(){fx.classList.toggle('on',!hv&&!fv)};
    new IntersectionObserver(function(e){hv=e[0].isIntersecting;up()}).observe(hero);
    new IntersectionObserver(function(e){fv=e[0].isIntersecting;up()},{threshold:.1}).observe(fin);
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -10% 0px'});
    document.querySelectorAll('.fi').forEach(function(el){io.observe(el)});
  }else{
    fx.classList.add('on');
    document.querySelectorAll('.fi').forEach(function(el){el.classList.add('in')});
  }
})();
</script>
</body>
</html>
