  const h = (i * 7919 + 13) % 997;
  return { x: (h * 37) % 100, s: 4 + (h % 12), d: 9 + (h % 9), dl: -((h * 3) % 17) };
});
// オープニングの水槽の魚（水槽ごとに数匹。向き・高さ・速さは固定値）
const fish = (n: number, seed: number) => Array.from({ length: n }, (_, i) => {
  const h = (seed * 131 + i * 977) % 1000;
  return { y: 15 + (h % 65), s: 14 + (h % 18), d: 3 + (h % 4), dl: -((h * 7) % 40) / 10, r: i % 2 === 1 };
});

