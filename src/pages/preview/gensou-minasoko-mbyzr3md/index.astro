<script is:inline>
(function(){
  var d=document.documentElement;
  // オープニング：約6.5秒で自動的に消える。SKIP で即終了
  var op=document.getElementById('op'),done=false;
  function ready(){d.classList.add('ready')}
  function end(){if(done)return;done=true;d.classList.remove('op-on');ready();if(op){op.classList.add('out');setTimeout(function(){op&&op.parentNode&&op.parentNode.removeChild(op)},1100)}}
  if(d.classList.contains('op-on')){setTimeout(end,6500);var sk=document.getElementById('op-skip');sk&&sk.addEventListener('click',end)}else{ready();op&&op.parentNode&&op.parentNode.removeChild(op)}

  // 金額の数字が増える
  function count(el){var to=+el.getAttribute('data-to'),t0=null;function f(t){if(!t0)t0=t;var p=Math.min(1,(t-t0)/1400);p=1-Math.pow(1-p,3);el.textContent=Math.round(to*p).toLocaleString('ja-JP');if(p<1)requestAnimationFrame(f)}el.textContent='0';requestAnimationFrame(f)}

  var fx=document.getElementById('fx'),hero=document.querySelector('.hero');
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(e){fx.classList.toggle('on',!e[0].isIntersecting)}).observe(hero);
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){var t=e.target;t.classList.add('in');t.querySelectorAll('.count').forEach(count);io.unobserve(t)}})},{rootMargin:'0px 0px -12% 0px'});
    document.querySelectorAll('.fi,.stg,.lines').forEach(function(el){io.observe(el)});
  }else{
    fx.classList.add('on');
    document.querySelectorAll('.fi,.stg,.lines').forEach(function(el){el.classList.add('in')});
  }

  // クラゲの視差（スクロールに合わせてゆっくり動く）
  var js=[].slice.call(document.querySelectorAll('.jelly[data-p]')),tk=false;
  if(js.length&&!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)){
    window.addEventListener('scroll',function(){if(tk)return;tk=true;requestAnimationFrame(function(){js.forEach(function(j){var r=j.parentNode.getBoundingClientRect();j.style.translate='0 '+(r.top*parseFloat(j.getAttribute('data-p'))).toFixed(1)+'px'});tk=false})},{passive:true});
  }
})();
</script>
</body>
</html>
