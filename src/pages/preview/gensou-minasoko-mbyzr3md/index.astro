<script is:inline>
(function(){
  var fx=document.getElementById('fx'),hero=document.querySelector('.hero'),fin=document.querySelector('.fin');
  if('IntersectionObserver' in window){
    var hv=true,fv=false,up=function(){fx.classList.toggle('on',!hv&&!fv)};
    new IntersectionObserver(function(e){hv=e[0].isIntersecting;up()}).observe(hero);
    new IntersectionObserver(function(e){fv=e[0].isIntersecting;up()},{threshold:.15}).observe(fin);
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.fi').forEach(function(el){io.observe(el)});
  }else{
    fx.classList.add('on');
    document.querySelectorAll('.fi').forEach(function(el){el.classList.add('in')});
  }
})();
</script>
