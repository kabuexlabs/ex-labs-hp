/* 未確定（原稿の🟥）の印。本公開前に MARK_TBD=false で消える */
.tbd{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:var(--tbd);color:#fff;font:700 10px/1.6 var(--goth);letter-spacing:.06em;vertical-align:2px;white-space:nowrap}
.tbd-empty{display:inline-block;padding:2px 10px;border:1px dashed var(--tbd);border-radius:4px;color:#ffd6de;font:500 12px/1.7 var(--goth);background:rgba(255,77,109,.12)}
.card .tbd-empty,.tk .tbd-empty,.foot .tbd-empty{color:#c41f44}
.preview-bar{position:relative;z-index:60;background:var(--black);color:#fff;font:500 12px/1.6 var(--goth);text-align:center;padding:8px 16px;letter-spacing:.04em}
.preview-bar b{color:var(--tbd)}

/* 装飾：クラゲ・泡・光の筋・斜めの細線 */
.jelly{position:absolute;pointer-events:none;color:#fff;animation:sway 9s ease-in-out infinite}
.jelly svg{display:block;width:100%;height:auto;overflow:visible}
@keyframes sway{0%,100%{transform:translateY(0) rotate(var(--r,0deg))}50%{transform:translateY(-18px) rotate(calc(var(--r,0deg) + 3deg))}}
.bub{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.bub i{position:absolute;bottom:-20px;border-radius:50%;border:1px solid rgba(255,255,255,.55);background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.7),rgba(255,255,255,.08) 45%,transparent 70%);animation:rise linear infinite}
@keyframes rise{0%{transform:translate(0,0);opacity:0}10%{opacity:.9}100%{transform:translate(14px,-110vh);opacity:0}}
.rays{position:absolute;inset:-10% -30% 0;pointer-events:none;background:repeating-conic-gradient(from 168deg at 50% -6%,rgba(255,255,255,.10) 0deg 1.6deg,transparent 1.6deg 6deg);-webkit-mask:linear-gradient(180deg,#000 0,rgba(0,0,0,.4) 45%,transparent 75%);mask:linear-gradient(180deg,#000 0,rgba(0,0,0,.4) 45%,transparent 75%);animation:rays 14s ease-in-out infinite alternate}
@keyframes rays{from{transform:rotate(-2deg)}to{transform:rotate(2deg)}}
.hair{position:absolute;pointer-events:none;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);transform-origin:left center}

/* hero */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:96px 24px 120px;background:radial-gradient(120% 60% at 50% 0%,rgba(120,190,255,.35),transparent 60%),linear-gradient(180deg,#0c2aa0 0%,var(--b1) 55%,var(--b1) 100%);overflow:hidden;text-align:center}
.hero-in{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center}
.hero-logo{width:min(46vw,200px);height:auto;filter:drop-shadow(0 0 18px rgba(170,200,255,.55))}
.hero-no{margin:28px 0 0;font:500 15px/1 var(--mincho);letter-spacing:.6em;padding-left:.6em}
.hero-t{margin:14px 0 0;font:600 clamp(48px,15vw,92px)/1.15 var(--mincho);letter-spacing:.12em;padding-left:.12em;text-shadow:0 0 12px rgba(255,255,255,.75),0 0 30px rgba(214,170,255,.7),0 0 60px rgba(120,180,255,.6)}
.hero-t .q{font-size:.55em;vertical-align:.35em;letter-spacing:0}
.hero-en{margin:10px 0 0;font:400 clamp(18px,4.6vw,24px)/1 var(--en);letter-spacing:.24em;color:var(--w8)}
.hero-d{margin:28px 0 0;display:flex;flex-direction:column;gap:6px;align-items:center}
.hero-d .dt{font:500 clamp(24px,7vw,34px)/1 var(--en2);letter-spacing:.08em}
.hero-d .dt small{font-size:.5em;letter-spacing:.1em;margin-left:6px}
.hero-d .vn{font:500 15px/1.6 var(--mincho);letter-spacing:.24em}
.cue{position:absolute;left:0;right:0;bottom:28px;z-index:2;display:flex;flex-direction:column;align-items:center;gap:10px;font:400 13px/1 var(--en);letter-spacing:.4em;color:var(--w8)}
.cue span{display:block;width:1px;height:48px;background:linear-gradient(180deg,#fff,transparent);animation:cue 2.4s ease-in-out infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* 導入（光る見出し） */
.intro{position:relative;padding:72px 0 120px;overflow:hidden}
.intro-s{margin:0;font:500 clamp(14px,3.9vw,17px)/1.9 var(--mincho);letter-spacing:.08em;text-shadow:0 0 10px rgba(255,255,255,.35)}
.intro-s::after{content:"";display:inline-block;width:3.2em;height:1px;background:#fff;vertical-align:.3em;margin-left:4px}
.glow{margin:24px 0 0;font:600 clamp(26px,7.4vw,40px)/1.6 var(--mincho);letter-spacing:.06em;color:#fff;text-shadow:0 0 6px rgba(255,255,255,.9),0 0 18px rgba(236,170,255,.75),0 0 36px rgba(160,170,255,.6)}
.body{margin:48px 0 0;font:500 clamp(15px,4.1vw,17px)/2.3 var(--mincho);letter-spacing:.16em}
.body p{margin:0}
.body p + p{margin-top:24px}
.label{display:inline-block;margin-bottom:8px;font:600 13px/1 var(--mincho);letter-spacing:.2em;padding:6px 12px;border:1px solid var(--w4);border-radius:999px}

/* 要点（最初の画面の基本情報） */
.qi{position:relative;margin-top:56px;padding:28px 24px;border:1px solid var(--w4);background:rgba(10,26,110,.35);backdrop-filter:blur(2px)}
.qi dl{margin:0;display:grid;gap:14px}
.qi div{display:grid;grid-template-columns:4.6em 1fr;gap:12px;font-size:15px;line-height:1.8;letter-spacing:.06em}
.qi dt{font-weight:700;color:var(--w8)}
.qi dd{margin:0}

/* 持ち物の注意（原稿の【必ずお持ちください】） */
.must{display:flex;gap:14px;align-items:flex-start;margin:28px 0 0;padding:18px 18px 18px 16px;background:var(--lime);color:var(--black);border-radius:2px;box-shadow:0 10px 30px rgba(5,15,70,.35)}
.must svg{flex:none;width:40px;height:40px}
.must > div{flex:1;min-width:0}
.must-h{margin:0;font:700 16px/1.5 var(--goth);letter-spacing:.06em}
.must-t{margin:4px 0 0;font:500 14px/1.8 var(--goth)}

/* ボタン */
.btn{position:relative;display:flex;align-items:center;justify-content:center;gap:16px;min-height:72px;margin-top:32px;padding:0 60px 0 24px;background:var(--black);color:#fff;text-decoration:none;font:500 clamp(17px,4.6vw,21px)/1.4 var(--mincho);letter-spacing:.14em;white-space:nowrap;text-align:center;transition:background .2s}
.btn:hover{background:#1c1c28}
.btn .arw{position:absolute;right:20px;top:50%;width:38px;height:38px;margin-top:-19px;border:1.5px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center}
.btn-note{margin:10px 0 0;font:500 12px/1.7 var(--goth);color:var(--w8);text-align:center}

/* セクション見出し（英字＋装飾＋日本語） */
.sec{position:relative;padding:112px 0}
.sh{display:flex;flex-direction:column;align-items:center;margin-bottom:56px;text-align:center}
.sh-en{display:flex;align-items:center;gap:14px;margin:0;font:400 clamp(52px,15vw,84px)/1 var(--en);letter-spacing:.02em;color:#fff;text-shadow:0 0 22px rgba(160,190,255,.45)}
.sh-en svg{flex:none;width:42px;height:12px;opacity:.9}
.sh-ja{margin:16px 0 0;font:600 14px/1 var(--mincho);letter-spacing:.4em;padding-left:.4em;color:var(--w8)}

/* 項目リスト（+・ラベル） */
.rows{margin:0;padding:0;list-style:none}
.rows > li,.rows > div{padding:24px 0;border-bottom:1px solid var(--w4)}
.rows > :first-child{padding-top:0}
.rk{display:block;margin:0 0 10px;font:700 clamp(15px,4.2vw,17px)/1.5 var(--mincho);letter-spacing:.14em}
.rk::before{content:"+ ·  ";white-space:pre;font-weight:500}
.rv{margin:0;font:500 clamp(15px,4.2vw,17px)/2 var(--mincho);letter-spacing:.1em}

/* 日程 */
.cal{display:grid;gap:28px;margin-top:8px}
.cal-m{display:grid;grid-template-columns:64px 1fr;gap:12px;align-items:start}
.cal-ml{display:flex;flex-direction:column;align-items:flex-start;gap:2px}
.cal-ml b{font:500 40px/1 var(--en2);letter-spacing:.02em}
.cal-ml span{font:400 13px/1 var(--en);letter-spacing:.3em}
.cal-d{display:flex;flex-wrap:wrap;gap:8px}
.cal-d span{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:56px;padding:8px 6px 6px;border:1px solid var(--w4);border-radius:2px;background:rgba(255,255,255,.04)}
.cal-d b{font:500 26px/1 var(--en2)}
.cal-d i{font:500 11px/1.5 var(--mincho);font-style:normal;color:var(--w8);white-space:nowrap}
.times{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:12px}
.times span{padding:7px 0;text-align:center;border:1px solid var(--w4);font:500 17px/1 var(--en2);letter-spacing:.06em}
.map{margin-top:20px;aspect-ratio:16/11;background:#0e248f}
.map iframe{display:block;width:100%;height:100%;border:0}
.map-a{display:inline-flex;align-items:center;gap:10px;margin-top:0;padding:14px 22px;background:#fff;color:var(--ink);text-decoration:none;font:500 15px/1 var(--en2);letter-spacing:.12em}

/* 白いカード（シリーズ紹介） */
.card-w{position:relative;margin:0 auto;max-width:560px;filter:drop-shadow(0 18px 24px rgba(5,15,70,.35))}
.card{position:relative;background:linear-gradient(180deg,#eef2ff 0,#fff 120px);color:var(--ink);padding:44px 32px 28px}
.card-tail{display:block;width:100%;height:46px;margin-top:-1px}
.card-n{margin:0;font:600 clamp(23px,6.8vw,40px)/1.3 var(--mincho);letter-spacing:.12em;white-space:nowrap}
.card-e{margin:6px 0 0;font:500 clamp(20px,5.6vw,26px)/1 var(--en2);letter-spacing:.08em;color:#9aa8e6}
.icons{display:flex;gap:14px;margin:24px 0 0}
.icons a{width:56px;height:56px;border-radius:50%;border:1.5px solid var(--ink);display:flex;align-items:center;justify-content:center;color:var(--ink);text-decoration:none;position:relative}
.icons a::after{content:"";position:absolute;inset:-1.5px;border-radius:50%;border:3px solid transparent;border-bottom-color:var(--ink);transform:rotate(-30deg)}
.card-b{margin:24px 0 0;font:500 15.5px/2 var(--goth);letter-spacing:.06em}
.card-b p{margin:0}
.card-b p + p{margin-top:18px}
.card-b .label{border-color:var(--ink);color:var(--ink)}

/* 体験のポイント（番号付き） */
.pts{display:grid;gap:20px;margin:0;padding:0;list-style:none}
.pt{position:relative;padding:28px 24px 26px;background:linear-gradient(160deg,rgba(255,255,255,.14),rgba(255,255,255,.04));border:1px solid var(--w2);border-top:1px solid rgba(255,255,255,.5)}
.pt-no{display:block;font:500 40px/1 var(--en2);color:rgba(255,255,255,.75)}
.pt-t{margin:10px 0 0;font:600 clamp(18px,5vw,21px)/1.6 var(--mincho);letter-spacing:.08em}
.pt-s{margin:10px 0 0;font:500 15px/2 var(--mincho);letter-spacing:.06em;color:var(--w8)}

/* 体験の進め方（ステップ） */
.steps{margin:0;padding:0;list-style:none;position:relative}
.steps::before{content:"";position:absolute;left:27px;top:8px;bottom:8px;width:1px;background:linear-gradient(180deg,rgba(255,255,255,.6),rgba(255,255,255,.1))}
.st{position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px;padding:0 0 32px}
.st:last-child{padding-bottom:0}
.st-n{position:relative;z-index:1;width:56px;height:56px;border-radius:50%;background:var(--b1);border:1px solid rgba(255,255,255,.7);display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 0 16px rgba(160,190,255,.45)}
.st-n b{font:500 22px/1 var(--en2)}
.st-k{margin:6px 0 0;display:flex;align-items:baseline;gap:12px;font:700 18px/1.4 var(--mincho);letter-spacing:.16em}
.st-k small{font:400 14px/1 var(--en);letter-spacing:.2em;color:var(--w8)}
.st-s{margin:8px 0 0;font:500 15px/2 var(--mincho);letter-spacing:.06em;color:var(--w8)}

/* 当日の流れ（時刻表） */
.tl{margin:0;padding:0;list-style:none;border-top:1px solid var(--w4)}
.tl li{display:grid;grid-template-columns:8.5em 1fr;gap:16px;padding:20px 0;border-bottom:1px solid var(--w4)}
.tl b{font:700 15px/1.8 var(--mincho);letter-spacing:.06em}
.tl p{margin:0;font:500 15px/1.9 var(--mincho);letter-spacing:.06em;color:var(--w8)}
.rcp{margin-top:20px;font:500 14px/1.9 var(--mincho)}

/* チケット（白いカード＋黒いボタン） */
.tk{position:relative;background:#fff;color:var(--ink);padding:28px 24px 26px;box-shadow:0 18px 40px rgba(5,15,70,.35)}
.tk-h{margin:0;font:600 clamp(19px,5.4vw,23px)/1.5 var(--mincho);letter-spacing:.12em}
.tk-tag{display:inline-block;margin-top:8px;padding:2px 10px;background:var(--ink);color:#fff;font:500 13px/1.7 var(--mincho);letter-spacing:.08em}
.tk-p{display:flex;align-items:flex-end;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-top:24px}
.tk-l{padding:4px 10px;background:var(--lime);color:var(--black);font:600 14px/1.4 var(--mincho);letter-spacing:.08em}
.tk-pr{display:inline-flex;align-items:baseline;gap:4px;padding:6px 14px;background:var(--black);color:#fff;font:500 clamp(34px,10vw,46px)/1 var(--en2);letter-spacing:.02em}
.tk-pr small{font:500 12px/1 var(--mincho)}
.tk-n{margin:14px 0 0;font:500 13px/1.8 var(--goth);color:#4a5aa8;text-align:right}
.tk-rows{margin-top:40px}

/* 開閉式（注意事項・FAQ） */
.ac{display:grid;gap:14px}
.ac details{background:var(--b3);box-shadow:0 10px 24px rgba(5,15,70,.25)}
.ac summary{list-style:none;display:grid;grid-template-columns:52px 1fr 44px;gap:10px;align-items:center;padding:18px 18px 18px 22px;background:#fff;color:var(--ink);cursor:pointer}
.ac summary::-webkit-details-marker{display:none}
.ac .an{font:500 30px/1 var(--en2)}
.ac .at{font:600 clamp(16px,4.6vw,19px)/1.5 var(--mincho);letter-spacing:.14em}
.ac .ai{width:44px;height:44px;border-radius:50%;background:#e7eafb;position:relative}
.ac .ai::before,.ac .ai::after{content:"";position:absolute;left:50%;top:50%;width:14px;height:1.5px;background:var(--ink);transform:translate(-50%,-50%)}
.ac .ai::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .2s}
.ac details[open] .ai::after{transform:translate(-50%,-50%) rotate(0)}
.ac .ab{padding:24px 22px 28px}
.ac .ab .rows > li{padding:18px 0}
.ac .ab .rows > li:last-child{border-bottom:0;padding-bottom:0}
.ac .ab .rk{font-size:15px;margin-bottom:6px}
.ac .ab .rv{font-size:15px;line-height:1.95}
.dots{margin:0;padding:0;list-style:none;display:grid;gap:14px}
.dots li{position:relative;padding-left:18px;font:500 15px/1.95 var(--mincho);letter-spacing:.06em}
.dots li::before{content:"";position:absolute;left:2px;top:.85em;width:6px;height:6px;border-radius:50%;background:#fff}
.faq summary{grid-template-columns:40px 1fr 44px}
.faq .an{font-size:28px}
.faq .at{font-size:16px;letter-spacing:.06em;line-height:1.7}
.faq .ab{display:grid;grid-template-columns:40px 1fr;gap:10px;padding-left:22px;font:500 15px/2 var(--mincho);letter-spacing:.06em}
.faq .ab .an{font-size:28px;line-height:1.1}

/* 締めの予約案内 */
.fin{position:relative;padding:120px 0 128px;text-align:center;overflow:hidden;background:linear-gradient(180deg,var(--b1),var(--b2))}
.fin .glow{margin-top:0;font-size:clamp(22px,6.4vw,34px)}
.fin-i{margin:24px 0 0;font:500 15px/2 var(--mincho);letter-spacing:.1em}
.fin .must{text-align:left}
.links{margin:40px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;align-items:center;gap:12px;font:500 14px/1.8 var(--mincho);letter-spacing:.06em}
.links a{text-underline-offset:4px}

/* クレジット（ライム色の帯） */
.foot{position:relative;background:var(--lime);color:var(--black);padding:96px 0 120px;overflow:hidden;text-align:center}
.foot-k{position:absolute;font:600 clamp(150px,44vw,280px)/1 var(--mincho);color:var(--black);pointer-events:none;user-select:none}
.foot-k.l{left:-.32em;top:40px}
.foot-k.r{right:-.36em;bottom:-.1em}
.foot-v{position:absolute;top:50%;font:500 12px/1.3 var(--en2);letter-spacing:.12em;writing-mode:vertical-rl;pointer-events:none}
.foot-v.l{left:10px}.foot-v.r{right:10px}
.foot .wrap{z-index:1}
.xb{position:relative;display:flex;align-items:center;justify-content:center;gap:16px;margin:0 auto;max-width:460px;min-height:112px;padding:0 24px;background:var(--black);color:#fff;text-decoration:none;outline:1px solid var(--black);outline-offset:5px}
.xb::before,.xb::after{content:"";position:absolute;width:14px;height:14px;border:1.5px solid #fff;border-radius:50%;top:-11px;left:-11px;background:var(--black)}
.xb::after{left:auto;right:-11px}
.xb .xn{font:600 30px/1 var(--mincho);letter-spacing:.1em}
.xb .xo{font:400 clamp(26px,7vw,36px)/1 var(--en);letter-spacing:.06em}
.cr{margin:72px 0 0;padding:0;list-style:none;display:grid;gap:36px}
.cr dt{font:500 15px/1 var(--mincho);letter-spacing:.24em}
.cr dt::before{content:"+ ·  ";white-space:pre}
.cr dt::after{content:"  · +";white-space:pre}
.cr dd{margin:14px 0 0;font:500 clamp(17px,4.8vw,21px)/1.7 var(--mincho);letter-spacing:.16em}
.ct{display:inline-flex;align-items:center;gap:12px;margin-top:72px;color:var(--black);text-decoration:none;font:700 16px/1.6 var(--goth);letter-spacing:.1em}
.ct .arw{width:34px;height:34px;border:1.5px solid var(--black);border-radius:50%;display:flex;align-items:center;justify-content:center}
.ct-m{margin:8px 0 0;font:500 14px/1.6 var(--goth)}
.copy{margin:40px 0 0;font:500 18px/1 var(--en2);letter-spacing:.14em}

/* 追従の予約ボタン */
.fx{position:fixed;left:50%;bottom:max(16px,env(safe-area-inset-bottom));z-index:50;transform:translate(-50%,140%);transition:transform .35s ease;display:flex;align-items:center;gap:12px;padding:0 10px 0 28px;height:56px;border-radius:999px;background:var(--b1);border:1.5px solid rgba(255,255,255,.85);color:#fff;text-decoration:none;font:600 15px/1 var(--mincho);letter-spacing:.14em;white-space:nowrap;box-shadow:0 8px 24px rgba(5,15,70,.45)}
.fx.on{transform:translate(-50%,0)}
.fx .arw{width:38px;height:38px;border-radius:50%;background:#fff;color:var(--ink);display:flex;align-items:center;justify-content:center}

/* スクロールで浮かび上がる */
.js .fi{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s ease}
.js .fi.in{opacity:1;transform:none}

@media (min-width:760px){
  .pts{grid-template-columns:1fr 1fr}
  .pt:last-child:nth-child(odd){grid-column:1/-1}
}
@media (max-width:380px){
  .wrap{padding:0 20px}
  .tl li{grid-template-columns:1fr;gap:4px}
  .btn{padding:0 56px 0 16px;letter-spacing:.08em}
}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  .jelly,.bub i,.rays,.cue span{animation:none}
  .bub{display:none}
  .js .fi{opacity:1;transform:none;transition:none}
}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <radialGradient id="jg" cx="50%" cy="30%" r="70%">
      <stop offset="0" stop-color="#fff" stop-opacity=".95"/>
      <stop offset=".55" stop-color="#dfe6ff" stop-opacity=".6"/>
      <stop offset="1" stop-color="#b9c8ff" stop-opacity=".15"/>
    </radialGradient>
    <linearGradient id="tg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".85"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#a7f0ff" stop-opacity=".75"/>
      <stop offset="1" stop-color="#7fb6ff" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <symbol id="jelly" viewBox="0 0 200 340">
    <path d="M60 112 C48 160 76 196 58 246 C46 284 68 306 60 336" fill="none" stroke="url(#tg)" stroke-width="1.6"/>
    <path d="M140 112 C152 158 126 200 144 248 C154 286 132 308 140 336" fill="none" stroke="url(#tg)" stroke-width="1.6"/>
    <path d="M38 108 C30 150 50 180 40 220" fill="none" stroke="url(#tg)" stroke-width="1.2"/>
    <path d="M162 108 C170 150 150 180 160 220" fill="none" stroke="url(#tg)" stroke-width="1.2"/>
