{MARK_TBD && <div class="preview-bar">関係者確認用の限定ページです（検索には出ません）。<b>要確認</b>・<b>未定</b>の印は原稿で未確定（🟥）の項目です。</div>}

<main>
  <section class="hero" aria-label="メインビジュアル">
    <div class="rays" aria-hidden="true"></div>
    <div class="bub" aria-hidden="true">{bubbles.map((b) => <i style={`left:${b.x}%;width:${b.s}px;height:${b.s}px;animation-duration:${b.d}s;animation-delay:${b.dl}s`}></i>)}</div>
    <div class="jelly" aria-hidden="true" style="width:min(34vw,170px);left:-6%;top:16%;--r:-12deg;opacity:.85"><svg><use href="#jelly"/></svg></div>
    <div class="jelly" aria-hidden="true" style="width:min(22vw,110px);right:4%;top:8%;--r:10deg;opacity:.7;animation-delay:-3s"><svg><use href="#jelly"/></svg></div>
    <div class="jelly" aria-hidden="true" style="width:min(16vw,80px);right:-2%;bottom:18%;--r:-6deg;opacity:.55;animation-delay:-6s"><svg><use href="#jelly"/></svg></div>
    <div class="hero-in">
      <img class="hero-logo" src="/assets/gensou/logo-light.webp" alt="午前零時の幻想集 Midnight Tales" width="720" height="711" fetchpriority="high">
      <p class="hero-no">第二夜</p>
      <h1 class="hero-t"><span class="sr">午前零時の幻想集 第二夜</span><span class="q">「</span>水底の夢<span class="q">」</span></h1>
      <p class="hero-v"><span class="tag">閉館後</span><span>のサンシャイン水族館</span></p>
      <div class="hero-d"><span class="dt">2027.02.14 — 03.19<small>全10日間</small></span></div>
    </div>
  </section>

  <section class="intro" aria-label="ごあいさつ">
    <div class="hair" aria-hidden="true" style="width:140%;left:-10%;bottom:8%;transform:rotate(-32deg)"></div>
    <div class="wrap">
      <p class="intro-s fi">{TITLE}</p>
      <p class="glow fi"><Tx s={CATCH_BR} mark={MARK_TBD} /></p>
      <div class="first fi">
        <p class="first-h">初めての方へ</p>
        <p><Tx s="**謎解きの知識や演技の経験は必要ありません**。スマートフォンから流れる音声に従って歩き、出会う登場人物の話を聞くだけで物語が進みます。" /></p>
      </div>

      <div class="qi fi" aria-label="開催の基本情報">
        <p class="qi-h">開催概要</p>
        <dl>
          <div><dt>開催期間</dt><dd><b>2027.2.14</b>（日）〜<b>3.19</b>（金）<br>全10日間</dd></div>
          <div><dt>会場</dt><dd>サンシャイン水族館（東京・池袋）</dd></div>
          <div><dt>参加費</dt><dd><b>5,500</b>円（税込）</dd></div>
        </dl>
        <div class="map"><iframe src={MAP_EMBED} title="サンシャイン水族館の地図（Google マップ）" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
        <a class="map-a" href={MAP_LINK} target="_blank" rel="noopener" data-place="minasoko-map-top">Google マップで開く<span class="arw"><svg width="12" height="12" aria-hidden="true"><use href="#arw"/></svg></span></a>
      </div>

      <div class="tiles fi">
        <div class="tile"><svg aria-hidden="true"><use href="#clock"/></svg><b>所要時間</b><span class="v">約70<small>分</small></span></div>
        <div class="tile"><svg aria-hidden="true"><use href="#solo"/></svg><b>1人でも<br>参加できる</b></div>
        <div class="tile"><svg aria-hidden="true"><use href="#ear"/></svg><b>謎解きの<br>知識は不要</b></div>
      </div>

      <MustBring />
      <a href={reserveHref} class="btn fi" data-place="minasoko-top" {...reserveAttrs}>チケットを予約する<span class="arw"><svg width="14" height="14" aria-hidden="true"><use href="#arw"/></svg></span></a>
      {!RESERVE_URL && MARK_TBD && <p class="btn-note"><span class="tbd-empty">未定：チケット販売ページのURL</span></p>}
    </div>
  </section>

  <section class="sec" id="series" aria-labelledby="h-series" style="padding-top:16px">
    <div class="wrap">
      <div class="card-w fi">
        <div class="card">
          <h2 class="card-n" id="h-series">午前零時の幻想集</h2>
          <p class="card-e">Midnight Tales</p>
          <div class="icons">
            <a href={X_URL} target="_blank" rel="noopener" aria-label={`公式X ${X_ID}`}><svg width="22" height="22" aria-hidden="true"><use href="#xlogo"/></svg></a>
            <a href={SERIES_URL} aria-label="シリーズ公式サイト"><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></a>
          </div>
          <p class="card-b"><Tx s="『午前零時の幻想集』は、閉館後の施設を舞台に、物語の登場人物と出会いながら館内を巡る体験型イベントのシリーズです。第一夜「草陰の夢」は2026年11月に夢の島熱帯植物館で開催し、**日本経済新聞にも取り上げられました**。🟥" mark={MARK_TBD} /></p>
        </div>
        <svg class="card-tail" viewBox="0 0 560 46" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H560V8C548 8 540 12 540 22H510C496 22 480 46 440 46H120C80 46 64 22 50 22H20C20 12 12 8 0 8Z" fill="#fff"/></svg>
      </div>
