---
// メディア掲載実績の一覧ページ。掲載データは src/data/media.ts で管理し、
// 追加したらトップページの告知バー・セクションと一緒に自動で反映される。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { jsonLd } from '../../lib/microcms';
import { mediaItems } from '../../data/media';

// 掲載実績をマシンリーダブルにする（AI検索が「ex Labsは日経に掲載された」
// という事実を出典つきで参照できるようにする）。
const mediaLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '株式会社ex Labs メディア掲載実績',
  itemListElement: mediaItems.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'NewsArticle',
      headline: `${m.outlet}：${m.title}`,
      description: m.desc,
      publisher: { '@type': 'Organization', name: m.outlet },
      about: { '@type': 'Organization', name: '株式会社ex Labs' },
      ...(m.url ? { url: m.url } : {}),
    },
  })),
};
---
<BaseLayout
  title="メディア掲載実績 - 株式会社ex Labs"
  description="株式会社ex Labsのメディア掲載実績の一覧です。日本経済新聞への掲載、電ファミニコゲーマーでの紹介など、渋谷サクラステージの体験型イベント「ウワサバナシ調査委員会」をはじめとする取り組みが新聞・Webメディアで紹介されています。"
>
<script type="application/ld+json" set:html={jsonLd(mediaLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: 'メディア掲載実績' },
]} />

<section class="section" style="padding-top:40px"><div class="wrap">
<p class="eyebrow">MEDIA</p>
<h1 class="h2 serif">メディア掲載実績</h1>
<p class="h2sub"><span class="nobr">株式会社ex Labsの取り組みが</span><span class="nobr">紹介された</span><span class="nobr">新聞・メディアの一覧です。</span></p>

<div class="media-list" style="margin-top:48px">
{mediaItems.map((m) => (
  <article class="media-item">
    <div class="media-feature-head">
      <span class="media-outlet serif">{m.outlet}</span>
      <span class="media-date">{m.date}</span>
    </div>
    <p class="media-title">{m.title}</p>
    <p class="media-desc" style="margin-bottom:0">{m.desc}</p>
    {m.url && (
      <div class="media-actions" style="margin-top:22px">
        <a class="btn" href={m.url} target="_blank" rel="noopener">記事を読む（外部サイト）</a>
      </div>
    )}
  </article>
))}
</div>

<p class="media-note">※外部サイトの記事は、媒体側の都合により閲覧に会員登録が必要な場合や、公開が終了する場合があります。</p>
</div></section>

<section class="section tinted"><div class="wrap">
<div class="cta-mini">
<p class="cta-mini-title serif">取材・掲載のご相談はこちら</p>
<a class="btn" href="/#contact">取材について問い合わせる</a>
</div>
<p class="vc-line" style="margin-top:48px">関連ページ：<a href="/press/" style="color:var(--accent)">プレスリリース</a>／<a href="/#works" style="color:var(--accent)">実績紹介</a></p>
</div></section>

</BaseLayout>
