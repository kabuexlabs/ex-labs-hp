---
// 結果画面。スクリーンショットを撮って SNS に載せても成立するよう、
// 1枚の「調査報告書」カードとして構成する。数値・ランクは
// クライアント側で localStorage の進捗から算出する。
import CaseLayout from '../../../layouts/CaseLayout.astro';
import DetectiveRank from '../../../components/case/DetectiveRank.astro';
import { caseConfig } from '../../../data/case/config';
import { questions } from '../../../data/case/questions';
---

<CaseLayout title={`INVESTIGATION REPORT｜${caseConfig.title}`}>
  <main class="result">
    <div class="case-wrap">
      <article class="report" id="report">
        <header class="report-head">
          <p class="en-label report-eyebrow">{caseConfig.title}</p>
          <h1 class="en-label report-title">
            <span>Investigation</span>
            <span>Report</span>
          </h1>
          <p class="report-sub">あなたの調査結果</p>
        </header>

        <div class="report-score">
          <p class="score-main">
            <span class="score-solved" data-result-solved>0</span>
            <span class="score-total">/ {questions.length}</span>
          </p>
          <div class="score-accuracy">
            <span class="en-label accuracy-label">Accuracy</span>
            <span class="accuracy-value"><span data-result-accuracy>0</span>%</span>
          </div>
        </div>

        <div class="report-divider" aria-hidden="true"></div>

        <DetectiveRank />

        <footer class="report-foot">
          <p class="en-label report-complete">Investigation Complete</p>
          <p class="report-date" data-result-date></p>
        </footer>
      </article>

      <div class="result-actions">
        <a href="/case/questions/" class="btn btn-ghost">調査記録へ戻る</a>
      </div>
    </div>
  </main>
</CaseLayout>

<script>
  import { questions } from '../../../data/case/questions';
  import { loadProgress } from '../../../lib/case/progress';
  import { calculateDetectiveRank } from '../../../lib/case/ranking';

  const progress = loadProgress();
  const summary = calculateDetectiveRank(progress, questions);

  const set = (selector: string, value: string) => {
    const el = document.querySelector(selector);
    if (el) el.textContent = value;
  };
  set('[data-result-solved]', String(summary.solvedCount));
  set('[data-result-accuracy]', String(summary.accuracy));
  set('[data-rank-letter]', summary.rank.rank);
  set('[data-rank-title]', summary.rank.title);
  set('[data-rank-desc]', summary.rank.description);

  const finished = progress.finishedAt ?? new Date().toISOString();
  const d = new Date(finished);
  set(
    '[data-result-date]',
    `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`,
  );
</script>

<style>
.result{min-height:100dvh;display:flex;align-items:center;padding:32px 0}
.result > div{width:100%}
.report{
  background:var(--surface);
  border:1px solid var(--ink);
  border-radius:6px;
  padding:36px 24px 28px;
}
.report-head{text-align:center;border-bottom:1px solid var(--line);padding-bottom:24px}
.report-eyebrow{margin:0;font-size:11px;color:var(--sub)}
.report-title{
  margin:14px 0 0;
  display:flex;flex-direction:column;
  font-size:clamp(22px,6.5vw,28px);font-weight:700;line-height:1.2;
  letter-spacing:.14em;
}
.report-sub{margin:12px 0 0;font-size:12.5px;color:var(--sub);letter-spacing:.24em;text-indent:.24em}
.report-score{text-align:center;padding:30px 0 0}
.score-main{margin:0;font-family:var(--font-en);line-height:1}
.score-solved{font-size:clamp(56px,18vw,76px);font-weight:600;letter-spacing:.02em}
.score-total{font-size:20px;color:var(--sub);margin-left:6px}
.score-accuracy{
  display:flex;align-items:baseline;justify-content:center;gap:10px;
  margin-top:14px;
}
.accuracy-label{font-size:11px;color:var(--sub)}
.accuracy-value{font-family:var(--font-en);font-size:22px;font-weight:600}
.report-divider{
  height:1px;margin:28px auto;
  background:var(--line);
}
.report-foot{
  margin-top:30px;padding-top:18px;
  border-top:1px solid var(--line);
  display:flex;align-items:center;justify-content:space-between;
}
.report-complete{margin:0;font-size:10.5px;color:var(--sub)}
.report-date{margin:0;font-family:var(--font-en);font-size:12px;color:var(--sub);letter-spacing:.1em}
.result-actions{margin-top:20px}
</style>
