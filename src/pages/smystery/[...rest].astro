---
// Smystery公式サイトは一旦非公開。/smystery/ 配下の全URLに対して、
// 運営元が分からない素っ気ない「ページが見つかりません」画面を
// 410 Gone で返す（トップへリダイレクトすると ex Labs のサイトに
// 飛んで関係が分かってしまうため、あえて転送しない）。
// 410 + noindex により検索エンジンのインデックスからも削除される。
// ページ本体は src/archive/smystery/ に退避済み。公開を再開するときは
// このファイルを削除し、archive のページを src/pages/smystery/ に戻す。
export const prerender = false;

const html = `<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>404 Not Found</title>
<style>
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#fafafa;color:#555;font-family:system-ui,-apple-system,"Hiragino Sans","Noto Sans JP",sans-serif}
main{text-align:center;padding:24px}
h1{font-size:18px;font-weight:600;margin:0 0 10px}
p{font-size:13px;margin:0;color:#888}
</style>
</head>
<body>
<main>
<h1>お探しのページは見つかりませんでした</h1>
<p>このページは現在公開されていません。</p>
</main>
</body>
</html>`;

return new Response(html, {
  status: 410,
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'X-Robots-Tag': 'noindex, nofollow, noarchive',
    'Cache-Control': 'no-store',
  },
});
---
