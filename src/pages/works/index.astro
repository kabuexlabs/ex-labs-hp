---
// 制作事例一覧（/works/）。2026-09 リニューアル（デザイン元 ListPage.dc.html の works）。
// ジャンル別に実績を並べ、事例の詳細・サービスへ送客する。title・description は従来の値を維持。
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ListHero from '../../components/x/ListHero.astro';
import SecHead from '../../components/x/SecHead.astro';
import Cls from '../../components/x/Cls.astro';
import Ph from '../../components/x/Ph.astro';
import { jsonLd } from '../../lib/microcms';

const site = Astro.site ?? new URL('https://kabuexlabs.com');
type W = { img: string; cat: string; client: string; title: string; place: string; desc: string; result: string; link: string; href: string };
const W = (img: string, cat: string, client: string, title: string, place: string, desc: string, result: string, link: string, href: string): W => ({ img: '/assets/' + img, cat, client, title, place, desc, result, link, href });
const genres: { id: string; en: string; ja: string; lead: string; svc?: [string, string][]; items: W[] }[] = [
  { id: 'immersive', en: 'Immersive / Facility', ja: 'イマーシブ・施設一体型', lead: '商業施設・書店・街全体を物語の舞台にした没入型イベント。回遊・滞在時間・話題化を同時に設計します。', svc: [['イマーシブ制作のご依頼', '/services/immersive/'], ['施設活用イベントのご相談', '/services/shisetsu-event/']], items: [
    W('events/uwasabanashi-kv.webp', 'イマーシブ制作', '渋谷サクラステージ', 'ウワサバナシ調査委員会', '東京・渋谷（商業施設）', '東急不動産株式会社様・404 Not Found様・TSUTAYA様のご協力のもと、渋谷サクラステージを周遊する都市伝説イマーシブ体験を企画・制作。施設一体型イベントとして日本経済新聞に掲載されました。', '日本経済新聞掲載／施設全体を周遊する没入体験', '制作事例の詳細を読む', '/guide/case-uwasabanashi/'),
    W('work-1.webp', 'ミステリー原案', '博報堂 × 紀伊國屋書店', '月明かりの書店と呪われた原稿', '東京（書店・閉店後）', '閉店後の紀伊國屋書店を舞台に開催された、一夜限りの体験型イベントの制作を担当。営業時間外の店舗を「入れない時間の特別な場所」として活用した事例です。', '営業時間外の店舗活用／一夜限りの特別公演', '営業時間外の活用について読む', '/guide/eigyo-jikangai/'),
    W('events/kaitou-kv.webp', 'マジック×イマーシブ', '六本木・会員制バー', '怪盗と秘密の試験', '東京・六本木（バー）', '日本一になった実績のあるマジシャン様とのコラボレーションによる、マジック×イマーシブ公演を六本木の会員制バーで企画・制作。小空間でも成立する高密度な没入体験です。', '1空間完結型イマーシブ／店舗の夜間集客', '公演特設サイト', '/kaitou/'),
    W('work-3.webp', '街周遊型アートイマーシブ', '下北沢（自社主催）', 'ロスト・フレーム', '東京・下北沢（街全体）', '下北沢の街に散らばった絵画を探し、隠された物語を辿る周遊型アートイマーシブ。街歩き×謎解き×絵画による参加型アート体験で、店舗を巡る回遊を生みました。', '全公演完売（2026年7月7日〜8月31日）／街全体の回遊設計', '制作事例の詳細を読む', '/guide/case-lostframe/') ] },
  { id: 'murder', en: 'Murder Mystery', ja: 'マダミス（マーダーミステリー）', lead: '施設・ブランドに合わせたオリジナルシナリオの制作から、公演運営まで。宿泊施設の「泊まる理由」づくりにも活用されています。', svc: [['マーダーミステリー制作のご依頼', '/services/murder-mystery/']], items: [
    W('mm/aru-mm.webp', '自社レーベル', 'UNLIMITED MYSTERY（東大マーダーミステリーサークル）', '推理系マダミス作品群', '公演・オンライン', '東大マーダーミステリーサークルによる推理系マダミスの制作・公演。ロジックを重視したシナリオ設計のノウハウを、企業・施設向けの制作にも活かしています。', '', '作品一覧を見る', '/toudaimurder/works/') ] },
  { id: 'zunou', en: 'Brain Battle', ja: '頭脳戦・心理戦', lead: '頭脳戦に特化したレーベル「HACKTALE（ハックテイル）」を運営。大会形式の大型イベントから、店舗向けの周遊型コンテンツまで制作します。', items: [
    W('work-8.webp', '企画・制作・運営', '自社主催', '東京都頭脳王決定戦', '東京都内4会場', '「東京都で最も頭の良い人を決める」をコンセプトに、都内4会場を同時に活用した大型の頭脳戦イベントを企画・運営。予選・本戦の大会形式で、リピート参加とコミュニティを生みました。', '全公演チケット完売', '東京都頭脳王決定戦 2026', '/hacktale/event/zunouou/'),
    W('work-5.webp', 'コンテンツ制作', 'カラオケ館', '恣験', '店舗（複数拠点）', '参加者が様々な試験へ挑戦する周遊型の頭脳戦コンテンツを制作。店舗を巡りながら挑戦する構造で、既存店舗の新しい来店動機を作りました。', '店舗周遊型の頭脳戦コンテンツ', '頭脳戦制作サービス', '/services/zunousen/'),
    W('zunousen/present-poker.webp', '自社レーベル', 'HACKTALE', 'プレゼント・ポーカー／人狼定理／ダイスボックス ほか', '一般公演', '交渉・ブラフ・論理を軸にしたオリジナル頭脳戦・心理戦ゲームを制作し、一般公演を展開。対人の読み合いのために設計された作品群です。', '', 'HACKTALEの作品一覧', '/hacktale/works/') ] },
  { id: 'nazotoki', en: 'Puzzle / Art', ja: '謎解き・アート体験', lead: 'アートと謎解きを融合した自社主催展や、企業・施設向けの謎解きイベント。広告費をかけずに集客した事例もあります。', items: [
    W('work-2.webp', '企画・制作', '自社主催', 'ヌル・アーデン展', '東京', '東京藝術大学出身アーティストとのコラボレーション企画。アートと謎解きを融合した体験型イベントを実施し、公演終了後には作品オークションも開催しました。', '体験する美術館（本展・ロスト・フレーム）全体で、広告費0円（告知はXのみ）のまま累計約2,000人が参加', 'ネタバレ記録を見る', '/game/null-arden/') ] },
];
const allWorks = genres.flatMap((g) => g.items);
const faqs = [
  { q: 'どのような業種・施設の実績がありますか？', a: '商業施設（渋谷サクラステージ）、書店（紀伊國屋書店）、宿泊施設、カラオケ店、会員制バー、街全体（下北沢）など、空間を持つ企業・施設との実績が中心です。広告代理店（博報堂）と組んだ企画制作の実績もあります。' },
  { q: '「新規宿泊予約20件以上」はどのような施策ですか？', a: '宿泊施設向けにオリジナルのマーダーミステリーを制作し、宿泊とセットで体験できるプランにした事例です。告知は X（旧Twitter）のみで、コンテンツそのものが「泊まる理由」になるため、広告や割引に頼らず新規予約を生みました。' },
  { q: '自社の施設やブランドに合わせたオリジナル制作は可能ですか？', a: '可能です。企画・シナリオ・制作物・集客・当日運営まで一貫して対応します。ご相談とお見積りは無料です。' },
];
const listLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: '制作事例一覧｜体験型イベント・イマーシブ・マダミス・頭脳戦の実績',
  description: '株式会社ex Labsが企画・制作した体験型イベントの実績一覧。',
  url: new URL('/works/', site).toString(),
  about: { '@id': new URL('/#organization', site).toString() },
  mainEntity: { '@type': 'ItemList', itemListElement: allWorks.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: `${w.client}「${w.title}」`, url: new URL(w.href, site).toString() })) },
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout
  renewal
  title="制作事例一覧｜体験型イベント・イマーシブ・マダミス・頭脳戦の実績 - 株式会社ex Labs"
  description="株式会社ex Labsの制作事例一覧。渋谷サクラステージの施設一体型イマーシブ（日経掲載）、紀伊國屋書店の閉店後イベント、宿泊施設向けマダミス（新規予約20件超）、都内4会場の頭脳戦大会（全公演完売）など、体験型イベントの実績をジャンル別に紹介します。"
  cutin={[['その場所・モノに合った', '最高の体験を']]}
  contact={{ title: ['同じような事例を、', '貴社の場所・ブランドでも'], type: 'taikengata' }}
  footer="short"
>
<script type="application/ld+json" set:html={jsonLd(listLd)} />
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<ListHero crumb="制作事例一覧" en="Works" ja="制作事例一覧" lead="株式会社ex Labsが企画・制作した体験型イベントの実績を、ジャンル別にまとめました。商業施設・書店・宿泊施設・店舗・街全体など、「場所」を舞台にした事例が中心です。" />

<nav class="xw-nav" aria-label="ジャンル">
  <div class="xw-cats">{genres.map((g) => <a href={`#${g.id}`}>{g.ja}<span>{g.items.length}</span></a>)}</div>
</nav>

{genres.map((g) => (
  <section id={g.id} class="xw-sec">
    <div class="xw-in">
      <SecHead en={g.en} size="s" />
      <p class="x-sh-ja is-b"><Cls text={g.ja} emph={false} /></p>
      <p class="xw-lead"><Cls text={g.lead} emph={false} /></p>
      {g.svc && <p class="xw-svc">{g.svc.map(([t, h]) => <a href={h} class="xw-link" data-track="cta" data-show={h.split('/')[2]} data-place="works-genre">{t} →</a>)}</p>}
      <div class="x-rail is-bleed" style="--gtc:repeat(auto-fill,minmax(min(100%,320px),1fr));--gap:24px;--col:calc(100% - 52px);margin-top:44px">
        {g.items.map((w) => (
          <article class="xw-card">
            <div style="position:relative">
              <img src={w.img} alt={w.title} loading="lazy" decoding="async">
              <span class="xw-cat">{w.cat}</span>
            </div>
            <div class="xw-body">
              <p class="xw-client"><Cls text={w.client} emph={false} /><span style="margin:0 6px">/</span><Cls text={w.place} emph={false} /></p>
              <h3 class="xw-t"><Cls text={w.title} emph={false} /></h3>
              <p class="xw-d"><Cls text={w.desc} emph={false} /></p>
              {w.result && (
                <div class="xw-res"><p class="xw-res-h">Result</p>{w.result.split('／').map((r) => <p class="xw-res-p"><Cls text={r} emph={false} /></p>)}</div>
              )}
              <a href={w.href} class="xw-link" data-track="show" data-show={w.href.replace(/^\/|\/$/g, '').replace(/\//g, '-')} data-place="works">{w.link} →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
))}

<section class="xw-zero">
  <div class="x-wcard is-s xw-zero-card">
    <p class="xw-zero-en">No Initial Cost</p>
    <h2 class="xw-zero-h"><Ph list={['ご相談内容によっては、', '貴社負担なしで', 'イベントを行えます']} /></h2>
    <div class="xw-zero-body">
      <p><span class="x-c">ex Labsは、</span><span class="x-c">チケット売上などから費用をいただく</span><span class="x-c"><strong class="xw-mk">レベニューシェア型（成果報酬型）</strong>に</span><span class="x-c">対応しています。</span></p>
      <p><span class="x-c">案件によっては</span><span class="x-c"><strong class="xw-mk">初期費用0円・貴社のご負担なし</strong>で、</span><span class="x-c">企画・制作・集客・運営まで</span><span class="x-c">一括で実施可能です。</span></p>
    </div>
    <div class="xw-zero-btns">
      <a href="#contact" class="xw-zb is-fill" data-track="cta" data-show="contact" data-place="works-zero">負担なしでできるか相談する</a>
      <a href="/services/shisetsu-event/#revenue" class="xw-zb" data-track="cta" data-show="services-shisetsu" data-place="works-zero">初期費用0円の条件を見る</a>
    </div>
  </div>
</section>

<section class="xw-faq">
  <div style="max-width:960px;margin:0 auto">
    <SecHead en="FAQ" size="m" />
    <p class="x-sh-ja is-b">よくあるご質問</p>
    <div class="xw-faq-list">
      {faqs.map((q) => (
        <details>
          <summary><span class="xw-q">Q</span><span class="xw-faq-q"><Cls text={q.q} emph={false} /></span><span class="x-faq-plus" aria-hidden="true">+</span></summary>
          <div class="xw-faq-a"><span class="xw-a">A</span><p><Cls text={q.a} emph={false} /></p></div>
        </details>
      ))}
    </div>
  </div>
</section>
</BaseLayout>
<style>
.xw-nav{padding:0 16px 72px}
.xw-cats{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.xw-cats a{border:1px solid rgba(255,255,255,.55);border-radius:999px;padding:9px 18px;font-family:var(--x-min);font-weight:700;font-size:14px;white-space:nowrap}
.xw-cats a span{white-space:nowrap;margin-left:8px;font-family:var(--x-en);color:var(--x-lime)}
@media(max-width:699px){.xw-cats{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;margin:0 -16px;padding:0 16px 10px;scrollbar-width:none}.xw-cats::-webkit-scrollbar{display:none}}
.xw-sec{padding:0 16px clamp(96px,12vw,130px)}
.xw-in{max-width:1100px;margin:0 auto}
.xw-svc{margin:14px 0 0;display:flex;flex-wrap:wrap;justify-content:center;gap:8px 24px}
.xw-lead{margin:14px auto 0;max-width:34em;text-align:center;font-size:14px;line-height:2;color:var(--x-pale)}
.xw-card{background:var(--x-panel);display:grid;align-content:start}
.xw-card img{width:100%;height:auto;display:block}
.xw-cat{position:absolute;left:0;bottom:0;background:var(--x-lime);color:var(--x-ink);font-family:var(--x-min);font-weight:700;font-size:12px;padding:6px 12px}
.xw-body{padding:22px clamp(18px,3vw,26px) 26px;display:grid;gap:12px}
.xw-client{margin:0;font-size:12px;line-height:1.7;color:var(--x-pale2)}
.xw-t{margin:0;font-family:var(--x-min);font-weight:700;font-size:clamp(19px,2.4vw,23px);line-height:1.5}
.xw-d{margin:0;font-size:14px;line-height:1.9;color:var(--x-pale)}
.xw-res{background:var(--x-card);color:var(--x-blue);padding:14px 16px;display:grid;gap:6px}
.xw-res-h{white-space:nowrap;margin:0;font-family:var(--x-en);font-size:14px;letter-spacing:.14em}
.xw-res-p{margin:0;font-weight:700;font-size:14px;line-height:1.7}
.xw-link{justify-self:start;margin-top:4px;border-bottom:1px solid var(--x-lime);color:var(--x-lime)!important;font-family:var(--x-min);font-weight:700;font-size:14px;padding-bottom:2px}
.xw-zero{padding:0 16px 110px}
.xw-zero-card{max-width:960px;margin:0 auto;padding:clamp(40px,6vw,72px) clamp(22px,6vw,72px);text-align:center}
@media(max-width:360px){.xw-zero-card{padding-left:14px;padding-right:14px}.xw-faq-list summary{gap:12px;padding:20px 14px}}
.xw-zero-en{white-space:nowrap;margin:0;font-family:var(--x-en);font-size:clamp(22px,4vw,34px);letter-spacing:.1em;color:#9DB000}
.xw-zero-h{margin:14px 0 0;font-family:var(--x-min);font-weight:700;font-size:clamp(21px,3.2vw,32px);line-height:1.6}
.xw-zero-body{margin:24px auto 0;max-width:36em;display:grid;gap:10px;font-size:15px;line-height:1.95;font-weight:500}
.xw-zero-body p{margin:0}
.xw-mk{background:linear-gradient(transparent 62%,rgba(225,247,62,.9) 62%)}
.xw-zero-btns{margin-top:28px;display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.xw-zb{border:1px solid var(--x-blue);border-radius:999px;padding:15px 28px;font-family:var(--x-min);font-weight:700;font-size:15px}
.xw-zb.is-fill{background:var(--x-blue);color:#fff!important}
.xw-faq{padding:0 16px 120px}
.xw-faq-list{margin-top:40px;display:grid;gap:10px}
.xw-faq-list details{background:var(--x-panel)}
.xw-faq-list summary{cursor:pointer;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:16px;align-items:baseline;padding:22px clamp(18px,3vw,28px)}
.xw-q,.xw-a{white-space:nowrap;font-family:var(--x-en);font-size:26px;line-height:1}
.xw-q{color:var(--x-lime)}
.xw-faq-q{font-family:var(--x-min);font-weight:700;font-size:clamp(15px,2vw,17px);line-height:1.7}
.xw-faq-list .x-faq-plus{font-size:18px;line-height:1}
.xw-faq-a{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;padding:20px clamp(18px,3vw,28px) 26px;border-top:1px solid rgba(255,255,255,.2)}
.xw-faq-a p{margin:0;font-size:15px;line-height:1.95}
</style>
