---
// HACKTALE 公演予約 — カレンダー＋日付別の公演一覧。
// 月カレンダーの各日に公演（開始時刻・残り席）を表示し、受付中の公演は
// そのまま予約フォームへ進める。残席・受付状態はリクエストのたびに KV から
// 読む（キャッシュしない）。?m=YYYY-MM で月、?work= / ?fmt= で絞り込み。
export const prerender = false;

import HacktaleLayout from '../../../layouts/HacktaleLayout.astro';
import { htBase, HT_LINE_URL } from '../../../data/hacktale';
import {
  isKvConfigured,
  getWorks,
  getSessions,
  bookedSeatsMap,
  availability,
  AVAILABILITY_LABEL,
  formatStartJa,
  jstNow,
  sessionFormat,
  minPlayersOf,
  type HtSession,
  type HtAvailability,
  type HtWorkRec,
} from '../../../lib/hacktaleBooking';
import { FORMAT_LABEL, type HtFormat } from '../../../lib/hacktaleTemplates';

Astro.response.headers.set('Cache-Control', 'no-store');

const workFilter = (Astro.url.searchParams.get('work') ?? '').slice(0, 40);
const fmtParam = Astro.url.searchParams.get('fmt') ?? '';
const fmtFilter: HtFormat | '' = fmtParam === 'offline' || fmtParam === 'online' ? fmtParam : '';
const err = Astro.url.searchParams.get('err') ?? '';

const now = jstNow();
const today = now.slice(0, 10);

interface Row {
  s: HtSession;
  workTitle: string;
  image?: string;
  durationMin?: number;
  format: HtFormat;
  booked: number;
  min: number;
  avail: HtAvailability;
}
let rows: Row[] = [];
let works: HtWorkRec[] = [];
const configured = isKvConfigured();

if (configured) {
  works = await getWorks();
  const workMap = new Map(works.map((w) => [w.id, w]));
  // 非公開（draft）は載せない。今日以降の公演だけを開催順に表示し、
  // 中止・満席・受付終了も状態付きで残す（予約はできない）。
  const sessions = (await getSessions()).filter((s) => s.status !== 'draft' && s.start.slice(0, 10) >= today);
  const seats = await bookedSeatsMap(sessions.map((s) => s.id));
  rows = sessions
    .map((s) => {
      const w = workMap.get(s.workId);
      const booked = seats.get(s.id) ?? 0;
      return {
        s,
        workTitle: w?.title ?? s.workId,
        image: w?.image,
        durationMin: w?.durationMin,
        format: sessionFormat(s, w ?? null),
        booked,
        min: minPlayersOf(s),
        avail: availability(s, booked, now),
      };
    })
    .filter((r) => (!workFilter || r.s.workId === workFilter) && (!fmtFilter || r.format === fmtFilter));
}

// 絞り込みの選択肢は「今後の公演がある作品」だけ
const workChoices = works.filter((w) => rows.some((r) => r.s.workId === w.id) || w.id === workFilter);
const qs = (p: Record<string, string>) => {
  const q = new URLSearchParams();
  const merged = { work: workFilter, fmt: fmtFilter, ...p };
  for (const [k, v] of Object.entries(merged)) if (v) q.set(k, v);
  const s = q.toString();
  return `${htBase}/reservation/${s ? `?${s}` : ''}`;
};

// --- カレンダー（日本時間・日曜始まり） ------------------------------------------
const thisMonth = today.slice(0, 7);
const firstRowMonth = rows[0]?.s.start.slice(0, 7);
const lastRowMonth = rows[rows.length - 1]?.s.start.slice(0, 7) ?? thisMonth;
const mParam = Astro.url.searchParams.get('m') ?? '';
let month = /^\d{4}-\d{2}$/.test(mParam) ? mParam : firstRowMonth ?? thisMonth;
if (month < thisMonth) month = thisMonth;
const maxMonth = lastRowMonth > thisMonth ? lastRowMonth : thisMonth;
if (month > maxMonth) month = maxMonth;

const addMonth = (ym: string, d: number) => {
  const [y, m] = ym.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1 + d, 1));
  return `${dt.getUTCFullYear()}-${String(dt.getUTCMonth() + 1).padStart(2, '0')}`;
};
const [yy, mm] = month.split('-').map(Number);
const firstDow = new Date(Date.UTC(yy, mm - 1, 1)).getUTCDay();
const daysInMonth = new Date(Date.UTC(yy, mm, 0)).getUTCDate();
const cells: ({ date: string; day: number } | null)[] = [];
for (let i = 0; i < firstDow; i++) cells.push(null);
for (let d = 1; d <= daysInMonth; d++) cells.push({ date: `${month}-${String(d).padStart(2, '0')}`, day: d });
while (cells.length % 7 !== 0) cells.push(null);

const byDate = new Map<string, Row[]>();
for (const r of rows) {
  const d = r.s.start.slice(0, 10);
  byDate.set(d, [...(byDate.get(d) ?? []), r]);
}
const monthRows = rows.filter((r) => r.s.start.startsWith(month));
const monthDates = [...new Set(monthRows.map((r) => r.s.start.slice(0, 10)))];
const otherMonths = [...new Set(rows.map((r) => r.s.start.slice(0, 7)))].filter((m) => m !== month);

const shortLabel = (a: HtAvailability) =>
  a.state === 'open' ? `残${a.remaining}` : a.state === 'full' ? '満席' : a.state === 'closed' ? '終了' : a.flop ? '見送' : '中止';
const WD = ['日', '月', '火', '水', '木', '金', '土'];
const dayHead = (date: string) => {
  const [y, m, d] = date.split('-').map(Number);
  return `${m}月${d}日(${WD[new Date(Date.UTC(y, m - 1, d)).getUTCDay()]})`;
};
const openCount = rows.filter((r) => r.avail.state === 'open').length;
---

<HacktaleLayout
  title="公演予約 RESERVATION | ハックテイル"
  description="HACKTALE（ハックテイル）の公演予約ページ。カレンダーで開催日と残り席を確認して、そのままオンラインでご予約いただけます。貸切公演のご相談も受け付けています。"
  twitterCard="summary"
  back={{ href: `${htBase}/`, label: 'トップへ戻る' }}
>

<section class="sec"><div class="wrap">
<div class="shead"><h1 class="sheadh"><span class="en st">RESERVATION</span><span class="sj">公演予約</span></h1></div>
<p class="intro">カレンダーから日程を選び、「予約する」からお申し込みください。開催に必要な人数が集まった時点で開催決定となり、当日の詳細をメールでご案内します。</p>

{err === 'notfound' && <p class="alert">指定された公演が見つかりませんでした。最新の一覧からお選びください。</p>}
{!configured && <p class="alert">予約システムは現在準備中です。お手数ですが、<a href={`${htBase}/#contact`}>お問い合わせフォーム</a>または<a href={HT_LINE_URL} target="_blank" rel="noopener">公式LINE</a>からご連絡ください。</p>}

{configured && (
  <div class="filters" aria-label="絞り込み">
    <div class="fgroup">
      <a class:list={['fchip', { on: !workFilter }]} href={qs({ work: '', m: '' })}>すべての作品</a>
      {workChoices.map((w) => <a class:list={['fchip', { on: workFilter === w.id }]} href={qs({ work: w.id, m: '' })}>{w.title}</a>)}
    </div>
    <div class="fgroup">
      <a class:list={['fchip', { on: !fmtFilter }]} href={qs({ fmt: '', m: '' })}>対面・オンライン</a>
      <a class:list={['fchip', { on: fmtFilter === 'offline' }]} href={qs({ fmt: 'offline', m: '' })}>対面</a>
      <a class:list={['fchip', { on: fmtFilter === 'online' }]} href={qs({ fmt: 'online', m: '' })}>オンライン</a>
    </div>
  </div>
)}

{configured && rows.length === 0 && (
  <div class="empty">
    <p class="fw7 m0">{workFilter || fmtFilter ? '条件に合う受付中の公演はありません。' : '現在受付中の公演はありません。'}</p>
    <p class="edesc">貸切公演のご予約・日程のご相談はいつでも受け付けています。お気軽にご連絡ください。</p>
    <div class="fx ac gap16 fwrap">
      {(workFilter || fmtFilter) && <a class="btn" href={`${htBase}/reservation/`}>すべての公演を見る</a>}
      <a class="btn btn-acc" href={`${htBase}/#contact`}>貸切公演を相談する</a><a class="btn" href={HT_LINE_URL} target="_blank" rel="noopener">公式LINEで相談</a>
    </div>
  </div>
)}

{rows.length > 0 && (
  <>
  {/* ============ カレンダー ============ */}
  <div class="cal">
    <div class="calhead">
      {month > thisMonth ? <a class="nav" href={qs({ m: addMonth(month, -1) })} aria-label="前の月">←</a> : <span class="nav off" aria-hidden="true">←</span>}
      <p class="calm en">{yy}.{String(mm).padStart(2, '0')}<span class="calmj">{yy}年{mm}月</span></p>
      {month < maxMonth ? <a class="nav" href={qs({ m: addMonth(month, 1) })} aria-label="次の月">→</a> : <span class="nav off" aria-hidden="true">→</span>}
    </div>
    <div class="grid" role="grid">
      {WD.map((w, i) => <div class:list={['dow', { sun: i === 0, sat: i === 6 }]} role="columnheader">{w}</div>)}
      {cells.map((c, i) => c === null ? <div class="cell blank"></div> : (
        <div class:list={['cell', { past: c.date < today, today: c.date === today, has: byDate.has(c.date), sun: i % 7 === 0, sat: i % 7 === 6 }]} role="gridcell">
          <span class="dn">{c.day}</span>
          {(byDate.get(c.date) ?? []).map((r) => (
            <a class:list={['ev', r.avail.state]} href={r.avail.state === 'open' ? `${htBase}/reservation/${r.s.id}/` : `#d-${c.date}`} title={`${r.workTitle} ${r.s.start.slice(11)} ${AVAILABILITY_LABEL(r.avail)}`}>
              <span class="et">{r.s.start.slice(11)}</span>
              <span class="ew">{r.workTitle}</span>
              <span class="er">{shortLabel(r.avail)}</span>
            </a>
          ))}
        </div>
      ))}
    </div>
    <p class="legend"><span class="lg open"></span>受付中（数字は残り席）<span class="lg full"></span>満席<span class="lg closed"></span>受付終了・見送り</p>
  </div>

  {/* ============ この月の公演 ============ */}
  {monthRows.length === 0 && <p class="edesc">この月の公演はありません。{otherMonths.length > 0 && <>ほかの月: {otherMonths.map((m) => <a class="mlink" href={qs({ m })}>{Number(m.slice(5))}月</a>)}</>}</p>}
  {monthDates.map((date) => (
    <div class="day" id={`d-${date}`}>
      <p class="dayh">{dayHead(date)}</p>
      <div class="list">
      {byDate.get(date)!.map(({ s, workTitle, image, durationMin, format, booked, min, avail }) => (
        <div class="row">
          {image && <img class="thumb" src={image} alt="" loading="lazy" decoding="async">}
          <div class="body">
            <div class="chips">
              <span class:list={['stat', avail.state]}>{AVAILABILITY_LABEL(avail)}</span>
              <span class="chip">{FORMAT_LABEL[format]}</span>
              {avail.state !== 'cancelled' && (s.go
                ? <span class="chip gochip">開催決定</span>
                : booked < min && <span class="chip">あと{min - booked}名で開催決定</span>)}
            </div>
            <p class="wt">{workTitle}</p>
            <p class="dt">{formatStartJa(s.start)}</p>
            <dl class="spec">
              <div><dt>プレイ人数</dt><dd>{min < s.capacity ? `${min}〜${s.capacity}名` : `${s.capacity}名`}{durationMin ? `／約${durationMin}分` : ''}</dd></div>
              <div><dt>料金</dt><dd>{s.price}{format === 'offline' && /円$/.test(s.price) ? '/名' : ''}</dd></div>
              <div><dt>形式</dt><dd>{FORMAT_LABEL[format]}（{s.venue}）</dd></div>
            </dl>
            {s.deadline && avail.state === 'open' && <p class="meta dim2">受付期限: {formatStartJa(s.deadline)} まで</p>}
          </div>
          <div class="act">
            {avail.state === 'open'
              ? <a class="btn btn-acc" href={`${htBase}/reservation/${s.id}/`}>予約する</a>
              : <span class:list={['btn', 'dead']}>{avail.state === 'cancelled' ? (avail.flop ? '開催見送り' : '公演中止') : avail.state === 'full' ? '満席' : '受付終了'}</span>}
          </div>
        </div>
      ))}
      </div>
    </div>
  ))}
  {monthRows.length > 0 && otherMonths.length > 0 && (
    <p class="edesc more">ほかの月の公演: {otherMonths.map((m) => <a class="mlink" href={qs({ m })}>{Number(m.slice(0, 4)) !== yy ? `${m.slice(0, 4)}年` : ''}{Number(m.slice(5))}月</a>)}</p>
  )}
  </>
)}

{configured && rows.length > 0 && openCount === 0 && (
  <p class="edesc" style="margin-top:20px">現在受付中の公演はありません。次回公演の情報はNEWS・Xでお知らせします。</p>
)}

<div class="kashikiri">
  <p class="kh fw7 m0">貸切公演をご希望の方へ</p>
  <p class="kd">上記の公開公演とは別に、ご希望の日程での貸切公演も承っています。日程を調整のうえご案内しますので、お問い合わせフォーム・公式LINEからご相談ください。</p>
  <div class="fx ac gap16 fwrap"><a class="btn" href={`${htBase}/#contact`}>貸切公演を相談する</a><a class="btn" href={HT_LINE_URL} target="_blank" rel="noopener">公式LINEで相談</a></div>
</div>
</div></section>

</HacktaleLayout>

<style>
.sec{padding:64px 0 112px}
.shead{margin-bottom:20px}
.sheadh{display:flex;align-items:baseline;gap:18px;margin:0}
.st{font-size:clamp(38px,4.5vw,60px);line-height:1}
.sj{font-size:13px;letter-spacing:.2em;color:#9b978c}
.intro{font-size:14px;line-height:2;color:#c9c5ba;margin:0 0 28px;max-width:680px}
.alert{border:1px solid #e5484d;color:#e08a8a;padding:14px 18px;font-size:14px;line-height:1.9;margin:0 0 24px}
.alert a{color:#e08a8a;text-decoration:underline}

.filters{display:flex;flex-direction:column;gap:10px;margin:0 0 24px}
.fgroup{display:flex;gap:8px;flex-wrap:wrap}
.fchip{font-size:12.5px;letter-spacing:.06em;border:1px solid rgba(255,255,255,.25);padding:6px 14px;color:#c9c5ba;white-space:nowrap}
.fchip:hover{border-color:var(--acc);color:var(--acc)}
.fchip.on{background:var(--acc);border-color:var(--acc);color:#0d0d0e;font-weight:700}

/* カレンダー */
.cal{border:1px solid rgba(255,255,255,.12);background:#141416;padding:20px 20px 16px;margin:0 0 40px}
.calhead{display:flex;align-items:center;justify-content:space-between;margin:0 0 14px}
.calm{font-size:28px;margin:0;line-height:1;display:flex;align-items:baseline;gap:12px}
.calmj{font-family:'Zen Kaku Gothic New',sans-serif;font-size:13px;color:#9b978c;letter-spacing:.1em}
.nav{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:1px solid rgba(255,255,255,.25);font-size:18px;color:#f1efe9}
.nav:hover{border-color:var(--acc);color:var(--acc)}
.nav.off{opacity:.2}
.grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}
.dow{text-align:center;font-size:11px;letter-spacing:.1em;color:#9b978c;padding:4px 0 6px}
.dow.sun{color:#e08a8a}.dow.sat{color:#8ab4e0}
.cell{min-height:92px;border:1px solid rgba(255,255,255,.07);padding:6px;display:flex;flex-direction:column;gap:4px;min-width:0}
.cell.blank{border-color:transparent}
.cell.past{opacity:.35}
.cell.today{border-color:rgba(217,230,59,.6)}
.cell.has{background:rgba(255,255,255,.025)}
.dn{font-size:12px;color:#c9c5ba;line-height:1}
.cell.sun .dn{color:#e08a8a}.cell.sat .dn{color:#8ab4e0}
.ev{display:flex;flex-direction:column;gap:1px;font-size:11px;line-height:1.35;padding:4px 5px;border-left:3px solid rgba(255,255,255,.3);background:rgba(255,255,255,.05);color:#c9c5ba;min-width:0}
.ev:hover{background:rgba(217,230,59,.12);color:#f1efe9}
.et{font-weight:700;color:#f1efe9}
.ew{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.er{font-weight:700}
.ev.open{border-left-color:var(--acc)}
.ev.open .er{color:var(--acc)}
.ev.full{border-left-color:#e5484d}
.ev.full .er{color:#e5484d}
.ev.closed,.ev.cancelled{opacity:.6}
.legend{display:flex;align-items:center;flex-wrap:wrap;gap:6px 14px;font-size:11.5px;color:#9b978c;margin:14px 0 0}
.lg{display:inline-block;width:10px;height:10px;margin-right:-8px}
.lg.open{background:var(--acc)}.lg.full{background:#e5484d}.lg.closed{background:rgba(255,255,255,.3)}

/* 日付別の一覧 */
.day{margin:0 0 28px;scroll-margin-top:90px}
.dayh{font-size:15px;font-weight:900;letter-spacing:.06em;margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.12)}
.list{display:flex;flex-direction:column;gap:14px}
.row{display:grid;grid-template-columns:88px 1fr auto;gap:20px;align-items:center;border:1px solid rgba(255,255,255,.12);background:#141416;padding:18px 22px}
.thumb{width:88px;height:88px;object-fit:cover;display:block;border:1px solid rgba(255,255,255,.12)}
.chips{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.chip{font-size:11px;letter-spacing:.08em;border:1px solid rgba(255,255,255,.25);padding:3px 9px;color:#c9c5ba}
.stat{font-size:11px;letter-spacing:.1em;padding:3px 9px;font-weight:700}
.stat.open{background:var(--acc);color:#0d0d0e}
.stat.full,.stat.cancelled{background:#e5484d;color:#fff}
.stat.closed{border:1px solid rgba(255,255,255,.35);color:#c9c5ba}
.wt{font-size:17px;font-weight:900;margin:0 0 4px}
.dt{font-size:15px;font-weight:700;color:var(--acc);margin:0 0 6px;letter-spacing:.04em}
.meta{font-size:12px;color:#9b978c;margin:0;line-height:1.8}
.gochip{border-color:var(--acc);color:var(--acc)}
.spec{margin:0;display:flex;flex-direction:column;gap:2px}
.spec div{display:flex;gap:10px;font-size:12.5px;line-height:1.8}
.spec dt{color:#9b978c;min-width:5.5em;flex-shrink:0}
.spec dd{margin:0;color:#c9c5ba}
.dim2{color:#6f6c64}
.act .btn{white-space:nowrap}
.dead{border-color:rgba(255,255,255,.15);color:#6f6c64;cursor:default}
.empty{border:1px solid rgba(255,255,255,.12);background:#141416;padding:32px 28px;display:flex;flex-direction:column;gap:16px}
.edesc{font-size:13px;line-height:2;color:#c9c5ba;margin:0}
.more{margin-top:8px}
.mlink{color:var(--acc);border-bottom:1px solid rgba(217,230,59,.4);margin:0 6px}
.kashikiri{margin-top:56px;border:1px solid rgba(217,230,59,.4);padding:28px;display:flex;flex-direction:column;gap:14px}
.kh{font-size:16px}
.kd{font-size:13px;line-height:2;color:#c9c5ba;margin:0}
@media(max-width:760px){
.st{font-size:clamp(30px,9vw,38px)}
.sj{white-space:nowrap}
.cal{padding:14px 10px 12px;margin:0 -8px 32px}
.calm{font-size:22px}
.grid{gap:2px}
.cell{min-height:64px;padding:4px 3px}
.dn{font-size:11px}
.ev{padding:3px 3px;border-left-width:2px;font-size:10px;align-items:flex-start}
.ew{display:none}
.row{grid-template-columns:64px 1fr;gap:14px;padding:16px}
.thumb{width:64px;height:64px}
.act{grid-column:1/-1}
.act .btn{width:100%;justify-content:center;box-sizing:border-box}
.kashikiri{padding:22px 18px}
}
</style>
