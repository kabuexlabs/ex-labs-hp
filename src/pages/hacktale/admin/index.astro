---
// HACKTALE 公演予約の管理ページ（社内用）。
//   /hacktale/admin/                 … 公演回一覧＋作品＋設定
//   /hacktale/admin/?session=<id>    … 公演回の編集・開催決定/見送り・予約者一覧・メール
//   /hacktale/admin/?session=<id>&csv=1 … 予約者CSV
// HACKTALE_ADMIN_KEY（未設定なら YOYAKU_ADMIN_KEY）を知っている人だけが
// 操作できる。合言葉は POST でのみ受け取り、以降は HttpOnly な
// セッション Cookie で認証する（/yoyaku/admin/ と同じ方式）。
export const prerender = false;

import {
  isKvConfigured,
  checkHtAdminKey,
  seedWorks,
  getWorks,
  getWork,
  saveWork,
  getSessions,
  getSession,
  saveSession,
  deleteSessionIfEmpty,
  newSessionId,
  newReservationId,
  bookedSeats,
  bookedSeatsMap,
  availability,
  AVAILABILITY_LABEL,
  SESSION_STATUS_LABEL,
  MAIL_KIND_LABEL,
  getReservations,
  getReservation,
  reserveSeats,
  cancelReservation,
  changeReservationCount,
  recountSeats,
  getSettings,
  saveSettings,
  getMailLog,
  sendAcceptMail,
  sendGoMailAll,
  resendGoMail,
  sendFlopMailAll,
  sendNoticeMail,
  claimBulkSend,
  afterReservation,
  markGo,
  unmarkGo,
  remindSession,
  sessionFormat,
  workFormats,
  workDefaultPrice,
  sessionTemplates,
  initialTemplates,
  minPlayersOf,
  formatStartJa,
  validStart,
  jstNow,
  hoursUntil,
  type HtSession,
  type HtSessionStatus,
  type HtReservation,
  type HtWorkRec,
  type HtSettings,
  type HtMailLog,
} from '../../../lib/hacktaleBooking';
import {
  type HtFormat,
  type GoKind,
  FORMAT_LABEL,
  PLACEHOLDERS,
  SUBJECTS,
  DEFAULT_OFFLINE_VENUE,
  DEFAULT_ONLINE_VENUE,
  defaultAcceptTemplate,
  defaultGoTemplate,
  FLOP_TEMPLATE,
  renderTemplate,
  missingPlaceholders,
} from '../../../lib/hacktaleTemplates';
import { normalizePhone, validPhone, validEmail, adminEmail } from '../../../lib/yoyaku';
import { randomBytes } from 'node:crypto';
import { loginAllowed, recordLoginFailure } from '../../../lib/contact';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

const COOKIE = 'ht_admin';
const BASE = '/hacktale/admin/';
let error = '';
let loginFailed = false;
let message = Astro.url.searchParams.get('msg') ?? '';
let sessionId = Astro.url.searchParams.get('session') ?? '';
// go | flop | changed | cancelled — 一斉送信フォームを出す
let noticeMode = Astro.url.searchParams.get('notice') ?? '';
// 一斉送信フォームで入力された内容（エラー・テスト送信後も消さずに再表示する）
let postedSubject: string | null = null;
let postedBody: string | null = null;
let postedTo: Set<string> | null = null;

let key = Astro.cookies.get(COOKIE)?.value ?? '';
const configured = isKvConfigured();
const authed = () => checkHtAdminKey(key);

const back = (params: Record<string, string>) => {
  const q = new URLSearchParams(params);
  return Astro.redirect(`${BASE}?${q.toString()}`, 303);
};
const validUrl = (u: string) => /^https:\/\/[^\s]+$/.test(u);
const sendSummary = (r: { sent: number; failed: number; skipped: number }) =>
  `成功${r.sent}件${r.failed ? `／失敗${r.failed}件（予約一覧から再送できます）` : ''}${r.skipped ? `／対象外${r.skipped}件（送信済み・メールなし）` : ''}`;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const get = (k: string) => String(form.get(k) ?? '').trim();
  // 文面は改行・字下げを保つため trim しない（末尾の空白行だけ落とす）
  const getText = (k: string, max: number) => String(form.get(k) ?? '').replace(/\r\n/g, '\n').replace(/\s+$/, '').slice(0, max);
  const action = get('action');

  if (action === 'login') {
    const loginIp = (Astro.request.headers.get('x-forwarded-for') ?? '').split(',')[0].trim() || 'unknown';
    const entered = get('key');
    if (!(await loginAllowed(loginIp))) {
      loginFailed = true;
    } else if (checkHtAdminKey(entered)) {
      Astro.cookies.set(COOKIE, entered, { httpOnly: true, secure: true, sameSite: 'lax', path: '/hacktale/admin' });
      return Astro.redirect(BASE, 303);
    } else {
      await recordLoginFailure(loginIp);
      loginFailed = true;
    }
  } else if (action === 'logout') {
    Astro.cookies.delete(COOKIE, { path: '/hacktale/admin' });
    return Astro.redirect(BASE, 303);
  } else if (authed() && configured) {
    sessionId = get('session') || sessionId;

    // --- 設定 ---------------------------------------------------------------
    if (action === 'settings') {
      const hours = Math.min(Math.max(parseInt(get('hours'), 10) || 36, 1), 168);
      const cur = await getSettings();
      await saveSettings({ ...cur, reminderEnabled: get('enabled') !== '', reminderHours: hours, bankInfo: getText('bank', 500) || undefined });
      return back({ msg: '設定を保存しました。' });
    }

    // --- 作品 ---------------------------------------------------------------
    if (action === 'work-save') {
      const formats: HtFormat[] = [
        ...(get('f_offline') !== '' ? (['offline'] as const) : []),
        ...(get('f_online') !== '' ? (['online'] as const) : []),
      ];
      const isNew = get('new') === '1';
      const id = isNew ? get('id').toLowerCase() : get('id');
      const existing = await getWork(id);
      if (isNew && !/^[a-z0-9-]{2,40}$/.test(id)) error = '作品IDは半角英数字とハイフン（2〜40文字）で入力してください。';
      else if (isNew && existing) error = `作品ID「${id}」はすでに使われています。`;
      else if (!isNew && !existing) error = '作品が見つかりません。';
      else if (!get('title')) error = '作品名を入力してください。';
      else if (formats.length === 0) error = '対応する形式（対面・オンライン）を1つ以上選んでください。';
      else {
        const w: HtWorkRec = {
          id,
          title: get('title').slice(0, 60),
          desc: get('desc').slice(0, 500) || undefined,
          image: get('image').slice(0, 200) || undefined,
          durationMin: parseInt(get('duration'), 10) || undefined,
          defaultCapacity: Math.min(Math.max(parseInt(get('capacity'), 10) || 1, 1), 500),
          defaultPrice: get('price').slice(0, 100) || undefined,
          defaultPriceOnline: get('price_online').slice(0, 100) || undefined,
          formats: formats,
          active: get('active') !== '',
          createdAt: existing?.createdAt ?? new Date().toISOString(),
        };
        await saveWork(w);
        return back({ msg: `作品「${w.title}」を保存しました。既存の公演回の定員・料金・文面は変わりません。` });
      }
    }

    // --- 公演回の作成・複製 ----------------------------------------------------
    if (action === 'session-create' || action === 'session-clone') {
      let base: Partial<HtSession> = {};
      let work: HtWorkRec | null = null;
      if (action === 'session-clone') {
        const src = await getSession(get('session'));
        if (!src) error = '複製元の公演回が見つかりません。';
        else {
          base = src;
          work = await getWork(src.workId);
        }
      } else {
        work = await getWork(get('work'));
        if (!work) error = '作品を選択してください。';
      }
      if (!error && work) {
        const start = get('start') || base.start || '';
        const fIn = get('format');
        if (!validStart(start)) error = '開催日時を入力してください。';
        else if (action === 'session-create' && fIn !== 'offline' && fIn !== 'online') error = '形式（対面・オンライン）を選んでください。';
        else if (action === 'session-create' && !workFormats(work).includes(fIn as HtFormat)) {
          error = `「${work.title}」は${FORMAT_LABEL[fIn as HtFormat]}公演に対応していません（作品の設定で対応形式を追加できます）。`;
        } else {
          const f = get('format');
          const format: HtFormat = f === 'online' || f === 'offline' ? f : base.format ?? sessionFormat(base as HtSession, work);
          const goKind: GoKind = format === 'online' ? 'online' : get('prep') !== '' ? 'offline-prep' : 'offline';
          const capacity = Math.min(Math.max(parseInt(get('capacity'), 10) || base.capacity || work.defaultCapacity, 1), 500);
          const minIn = parseInt(get('min'), 10);
          const s: HtSession = {
            id: newSessionId(),
            workId: work.id,
            format,
            start,
            venue: (get('venue') || base.venue || '').slice(0, 120) || (format === 'online' ? DEFAULT_ONLINE_VENUE : DEFAULT_OFFLINE_VENUE),
            meeting: base.meeting,
            // 作品の標準定員・料金は「初期値」としてコピーするだけなので、
            // 後から作品側を変えても既存の公演回には影響しない。
            price: (get('price') || base.price || workDefaultPrice(work, format) || '').slice(0, 100) || '未定',
            capacity,
            minPlayers: Math.min(Number.isInteger(minIn) && minIn >= 1 ? minIn : base.minPlayers ?? capacity, capacity),
            autoGo: base.autoGo ?? format === 'offline',
            discordUrl: undefined, // Discord は卓ごとに発行し直す運用なので複製しない
            notes: base.notes,
            ...(action === 'session-clone'
              ? { acceptTemplate: base.acceptTemplate, goTemplate: base.goTemplate, flopTemplate: base.flopTemplate }
              : initialTemplates(work.id, goKind)),
            status: 'draft',
            createdAt: new Date().toISOString(),
          };
          await saveSession(s);
          return back({
            session: s.id,
            msg: `公演回を${action === 'session-clone' ? '複製' : '作成'}しました（非公開の状態です）。下の「メール文面」も確認してから公開してください。${format === 'online' ? ' オンライン公演はDiscordリンクを入れてから開催決定してください。' : ''}`,
          });
        }
      }
    }

    // --- 公演回の編集・状態変更 -------------------------------------------------
    const sessionActions = ['session-save', 'session-status', 'session-delete', 'session-recount', 'tpl-reset', 'go', 'ungo', 'flop'];
    if (sessionActions.includes(action)) {
      const s = await getSession(get('session'));
      if (!s) {
        error = '公演回が見つかりません。';
      } else if (action === 'session-recount') {
        const n = await recountSeats(s.id);
        return back({ session: s.id, msg: `確定人数を再集計しました（${n}名）。` });
      } else if (action === 'session-delete') {
        const ok = await deleteSessionIfEmpty(s.id);
        if (ok) return back({ msg: '公演回を削除しました。' });
        error = '予約履歴のある公演回は削除できません。「中止」にして履歴を残してください。';
      } else if (action === 'go') {
        await markGo(s.id);
        return back({ session: s.id, notice: 'go', msg: '開催決定にしました。下の開催案内メールを確認して一斉送信してください。以降の新しい申し込みには開催案内が自動で届きます。' });
      } else if (action === 'ungo') {
        await unmarkGo(s.id);
        return back({ session: s.id, msg: '開催決定を取り消しました（送信済みの開催案内は取り消せません）。' });
      } else if (action === 'flop') {
        await saveSession({ ...s, status: 'cancelled', flop: true });
        return back({ session: s.id, notice: 'flop', msg: '開催見送り（流卓）にしました。受付は止まっています。下の見送りメールを確認して送信してください。' });
      } else if (action === 'tpl-reset') {
        const work = await getWork(s.workId);
        const which = get('which');
        if (which === 'accept') await saveSession({ ...s, acceptTemplate: defaultAcceptTemplate(s.workId) });
        else if (which === 'flop') await saveSession({ ...s, flopTemplate: FLOP_TEMPLATE });
        else {
          const k = get('kind') as GoKind;
          const kind: GoKind = ['offline', 'offline-prep', 'online'].includes(k) ? k : sessionFormat(s, work) === 'online' ? 'online' : 'offline';
          await saveSession({ ...s, goTemplate: defaultGoTemplate(kind) });
        }
        return back({ session: s.id, msg: '文面を既定に戻しました。' });
      } else if (action === 'session-status') {
        const status = get('status') as HtSessionStatus;
        if (!['draft', 'open', 'closed', 'cancelled'].includes(status)) error = '状態が不正です。';
        else {
          await saveSession({ ...s, status, flop: status === 'cancelled' ? s.flop : undefined });
          const confirmed = (await getReservations(s.id)).filter((r) => r.status === 'confirmed');
          if (status === 'cancelled' && confirmed.length > 0) {
            return back({ session: s.id, notice: 'cancelled', msg: `公演を中止にしました。確定済みの予約が${confirmed.length}件あります。下の案内メールを確認して送信してください。` });
          }
          return back({ session: s.id, msg: `状態を「${SESSION_STATUS_LABEL[status]}」に変更しました。` });
        }
      } else {
        // session-save
        const start = get('start');
        const capacity = parseInt(get('capacity'), 10);
        const minPlayers = parseInt(get('min'), 10);
        const discordUrl = get('discord');
        const booked = await bookedSeats(s.id);
        if (!validStart(start)) error = '開催日時の形式が正しくありません。';
        else if (!Number.isInteger(capacity) || capacity < 1 || capacity > 500) error = '定員は1〜500で入力してください。';
        else if (capacity < booked) error = `確定済みの予約が${booked}名分あるため、定員を${booked}名未満にはできません。`;
        else if (!Number.isInteger(minPlayers) || minPlayers < 1 || minPlayers > capacity) error = '開催最少人数は1〜定員の範囲で入力してください。';
        else if (get('deadline') && !validStart(get('deadline'))) error = '受付期限の形式が正しくありません。';
        else if (discordUrl && !validUrl(discordUrl)) error = 'Discordリンクは https:// から始まるURLを入力してください。';
        else if (!workFormats(await getWork(get('work') || s.workId)).includes(get('format') === 'online' ? 'online' : 'offline')) {
          error = `この作品は${get('format') === 'online' ? 'オンライン' : '対面'}公演に対応していません（作品の設定で対応形式を追加できます）。`;
        }
        else {
          const updated: HtSession = {
            ...s,
            workId: (await getWork(get('work'))) ? get('work') : s.workId,
            format: get('format') === 'online' ? 'online' : 'offline',
            start,
            venue: get('venue').slice(0, 120) || s.venue,
            meeting: get('meeting').slice(0, 200) || undefined,
            price: get('price').slice(0, 100) || '未定',
            capacity,
            minPlayers,
            autoGo: get('autogo') !== '',
            discordUrl: discordUrl || undefined,
            deadline: get('deadline') || undefined,
            notes: getText('notes', 2000) || undefined,
            acceptTemplate: getText('tpl_accept', 6000) || undefined,
            goTemplate: getText('tpl_go', 6000) || undefined,
            flopTemplate: getText('tpl_flop', 6000) || undefined,
          };
          await saveSession(updated);
          const confirmed = (await getReservations(s.id)).filter((r) => r.status === 'confirmed');
          const changed = s.start !== updated.start || s.venue !== updated.venue;
          if (changed && confirmed.length > 0) {
            return back({ session: s.id, notice: 'changed', msg: `保存しました。日時または会場が変わったため、確定済みの予約${confirmed.length}件（${confirmed.reduce((n, r) => n + r.count, 0)}名）に影響します。下の案内メールを確認して送信してください。` });
          }
          return back({ session: s.id, msg: '公演回を保存しました。' });
        }
      }
    }

    // --- 一斉送信・予約の操作 ---------------------------------------------------
    const resActions = ['res-add', 'res-cancel', 'res-count', 'res-resend', 'res-resend-go', 'notice', 'notice-test', 'go-send', 'flop-send', 'remind-now'];
    if (resActions.includes(action)) {
      const s = await getSession(get('session'));
      const settings = await getSettings();
      if (!s) {
        error = '公演回が見つかりません。';
      } else {
        const work = await getWork(s.workId);
        if (action === 'go-send') {
          const body = getText('body', 6000);
          const missing = missingPlaceholders(body, { discordUrl: s.discordUrl, bankInfo: settings.bankInfo });
          if (!body) error = '本文を入力してください。';
          else if (missing.length > 0) {
            error = `送信できません。${missing.join('、')}が未入力です。入力してから送信してください。`;
            noticeMode = 'go';
          } else {
            // 手直しした文面を公演回に保存し、あとから申し込んだ人にも同じ案内が届くようにする
            await saveSession({ ...s, goTemplate: body });
            const fresh = (await getSession(s.id)) ?? s;
            const res = await sendGoMailAll(work, fresh, settings, body);
            return back({ session: s.id, msg: `開催案内を送信しました（${sendSummary(res)}）。` });
          }
        } else if (action === 'flop-send') {
          const subject = get('subject').slice(0, 120);
          const body = getText('body', 6000);
          if (!subject || !body) error = '件名と本文を入力してください。';
          else {
            await saveSession({ ...s, flopTemplate: body });
            const res = await sendFlopMailAll(work, s, settings, subject, body);
            return back({ session: s.id, msg: `見送りメールを送信しました（${sendSummary(res)}）。` });
          }
        } else if (action === 'res-add') {
          // 電話・LINEで受けた予約の手動登録。定員チェックは Web と同じ経路。
          const name = get('name').slice(0, 40);
          const email = get('email').slice(0, 254);
          const phone = normalizePhone(get('phone')).slice(0, 20);
          const count = parseInt(get('count'), 10);
          if (!name || !Number.isInteger(count) || count < 1) error = 'お名前と人数を入力してください。';
          else if (email && !validEmail(email)) error = 'メールアドレスの形式をご確認ください。';
          else if (phone && !validPhone(phone)) error = '電話番号の形式をご確認ください。';
          else {
            const r: HtReservation = {
              id: newReservationId(),
              sessionId: s.id,
              name,
              email: email || '',
              phone: phone || '',
              xId: get('x').replace(/^@/, '').slice(0, 30) || undefined,
              count,
              note: get('note').slice(0, 500) || undefined,
              status: 'confirmed',
              source: 'manual',
              createdAt: new Date().toISOString(),
              reminderSkipped: hoursUntil(s.start, jstNow()) <= settings.reminderHours ? 'リマインド設定時刻より後の手動登録' : undefined,
            };
            const result = await reserveSeats(s, r);
            if (result < 0) error = `残席が足りません（定員${s.capacity}名）。定員を増やすか人数を減らしてください。`;
            else {
              const mail = await afterReservation(s.id, r, get('sendmail') !== '');
              const mailMsg = mail.kind === 'none' ? '' : mail.ok ? `（${mail.kind === 'go' ? '開催案内' : '受付メール'}を送信しました）` : '（※メール送信に失敗しました。予約一覧から再送できます）';
              return back({ session: s.id, msg: `予約 ${r.id}（${name}様 ${count}名）を登録しました${mailMsg}。` });
            }
          }
        } else if (action === 'remind-now') {
          const works = new Map((await getWorks()).map((w) => [w.id, w]));
          if (!s.go) error = '開催決定していない公演にはリマインドを送れません。';
          else {
            const r = await remindSession(works, s.id, settings, true);
            return back({ session: s.id, msg: `リマインドを送信しました（対象${r.due}件／成功${r.sent}件${r.failed ? `／失敗${r.failed}件` : ''}）。送信済みの予約には再送しません。` });
          }
        } else if (action === 'notice' || action === 'notice-test') {
          // 予約者への一斉送信（自由文・日時変更・中止の案内）。宛先は画面で選んだ予約だけ。
          const subject = get('subject').slice(0, 120);
          const body = getText('body', 6000);
          const picked = new Set(form.getAll('to').map((v) => String(v)));
          postedSubject = subject;
          postedBody = body;
          postedTo = picked;
          if (!noticeMode) noticeMode = 'custom'; // エラー・テスト送信後もフォームを再表示する
          const all = await getReservations(s.id);
          const targets = all.filter((r) => picked.has(r.id) && r.email);
          if (!subject || !body) error = '件名と本文を入力してください。';
          else if (body.includes('（ここに本文を入力')) error = '本文の「（ここに本文を入力してください）」を書き換えてから送信してください。';
          else if (action === 'notice-test') {
            // 自分宛のテスト送信：1人目の宛先（いなければ見本）の内容で差し込んで info@ に送る
            const sample = targets[0] ?? all[0];
            const fake: HtReservation = {
              ...(sample ?? { id: 'HT-000000-TEST', sessionId: s.id, name: '（お名前）', phone: '', count: 1, status: 'confirmed', source: 'manual', createdAt: new Date().toISOString() }),
              email: adminEmail(),
            } as HtReservation;
            const ok = await sendNoticeMail(work, s, fake, `【テスト送信】${subject}`, body, settings);
            message = ok
              ? `テストメールを ${adminEmail()} に送信しました（${sample ? `${sample.name}様あての内容` : '見本の内容'}）。内容を確認してから本番の送信をしてください。`
              : 'テストメールの送信に失敗しました。メール設定（SMTP/Resend）を確認してください。';
          } else if (targets.length === 0) error = '送信先が選ばれていません（メールアドレスのある予約者にチェックを入れてください）。';
          else if (!(await claimBulkSend(get('bulk')))) {
            // 同じフォームからの2回目（連打・再読み込み）は送らない
            return back({ session: s.id, msg: 'この一斉送信はすでに実行済みです（二重送信を防ぐため、2回目は送っていません）。送信結果は下の「メール送信履歴」で確認できます。' });
          } else {
            let sent = 0;
            let failed = 0;
            for (const r of targets) (await sendNoticeMail(work, s, r, subject, body, settings)) ? sent++ : failed++;
            return back({ session: s.id, msg: `予約者への一斉送信が完了しました（送信先${targets.length}件：成功${sent}件${failed ? `／失敗${failed}件。失敗分は下の「メール送信履歴」で確認し、宛先を絞って再送してください` : ''}）。` });
          }
        } else {
          const r = await getReservation(s.id, get('res'));
          if (!r) error = '予約が見つかりません。';
          else if (action === 'res-cancel') {
            await cancelReservation(s, r);
            return back({ session: s.id, msg: `予約 ${r.id} をキャンセルし、${r.count}名分の枠を戻しました。` });
          } else if (action === 'res-count') {
            const newCount = parseInt(get('count'), 10);
            if (!Number.isInteger(newCount) || newCount < 1) error = '人数が不正です。';
            else if (r.status !== 'confirmed') error = 'キャンセル済みの予約は変更できません。';
            else {
              const ok = await changeReservationCount(s, r, newCount);
              if (ok) return back({ session: s.id, msg: `予約 ${r.id} の人数を${r.count}名 → ${newCount}名に変更しました。` });
              error = '残席が足りないため人数を増やせません。';
            }
          } else if (action === 'res-resend') {
            if (!r.email) error = 'この予約にはメールアドレスが登録されていません。';
            else {
              const ok = await sendAcceptMail(work, s, r, settings);
              return back({ session: s.id, msg: ok ? `予約 ${r.id} に受付メールを再送しました。` : '再送に失敗しました。メール設定（SMTP/Resend）を確認してください。' });
            }
          } else if (action === 'res-resend-go') {
            const missing = missingPlaceholders(sessionTemplates(s, work).go, { discordUrl: s.discordUrl, bankInfo: settings.bankInfo });
            if (!r.email) error = 'この予約にはメールアドレスが登録されていません。';
            else if (!s.go) error = '開催決定していない公演です。';
            else if (missing.length > 0) error = `送信できません。${missing.join('、')}が未入力です。`;
            else {
              const ok = await resendGoMail(work, s, r, settings);
              return back({ session: s.id, msg: ok ? `予約 ${r.id} に開催案内を再送しました。` : '再送に失敗しました。メール設定（SMTP/Resend）を確認してください。' });
            }
          }
        }
      }
    }
  }
}

// --- CSV 出力（認証済みのみ） ---------------------------------------------------
if (authed() && configured && sessionId && Astro.url.searchParams.get('csv') === '1') {
  const s = await getSession(sessionId);
  if (s) {
    const work = await getWork(s.workId);
    const list = await getReservations(sessionId);
    const esc = (v: string) => `"${v.replace(/"/g, '""')}"`;
    const rows = [
      ['予約番号', '状態', 'お名前', 'メールアドレス', '電話番号', 'X', '人数', '備考', '受付経路', '予約日時', '受付メール', '開催案内', 'リマインド'],
      ...list.map((r) => [
        r.id,
        r.status === 'confirmed' ? '確定' : 'キャンセル',
        r.name,
        r.email,
        r.phone,
        r.xId ? `@${r.xId}` : '',
        String(r.count),
        r.note ?? '',
        r.source === 'web' ? 'Web' : '手動',
        r.createdAt,
        r.confirmMailAt ? '送信済み' : r.confirmMailError ? '失敗' : '未送信',
        r.goMailAt ? '送信済み' : r.goMailError ? '失敗' : '未送信',
        r.remindedAt ? '送信済み' : r.reminderSkipped ? '対象外' : '未送信',
      ]),
    ];
    const csv = '﻿' + rows.map((row) => row.map(esc).join(',')).join('\r\n');
    const fname = `hacktale_${(work?.title ?? s.workId).replace(/[\\/:*?"<>|\s]/g, '_')}_${s.start.replace(/[-:T]/g, '')}.csv`;
    return new Response(csv, {
      headers: {
        'Content-Type': 'text/csv; charset=utf-8',
        'Content-Disposition': `attachment; filename*=UTF-8''${encodeURIComponent(fname)}`,
        'Cache-Control': 'no-store',
      },
    });
  }
}

// --- 表示用データ ----------------------------------------------------------------
let works: HtWorkRec[] = [];
let sessions: (HtSession & { booked: number; reservations: HtReservation[] })[] = [];
let settings: HtSettings = { reminderEnabled: true, reminderHours: 36 };
let detail: {
  s: HtSession;
  work: HtWorkRec | null;
  format: HtFormat;
  booked: number;
  min: number;
  tpl: { accept: string; go: string; flop: string };
  missingGo: string[];
  reservations: HtReservation[];
  maillog: HtMailLog[];
} | null = null;
const showPast = Astro.url.searchParams.get('past') === '1';
const now = jstNow();

if (authed() && configured) {
  await seedWorks();
  works = await getWorks();
  const all = await getSessions();
  const seats = await bookedSeatsMap(all.map((s) => s.id));
  const shown = all.filter((s) => showPast || s.start >= now.slice(0, 10));
  // 一覧で各回の予約者まで見えるよう、表示する回の予約をまとめて読む
  const resLists = await Promise.all(shown.map((s) => getReservations(s.id)));
  sessions = shown.map((s, i) => ({ ...s, booked: seats.get(s.id) ?? 0, reservations: resLists[i] }));
  settings = await getSettings();
  if (sessionId) {
    const s = await getSession(sessionId);
    if (s) {
      const work = works.find((w) => w.id === s.workId) ?? null;
      const tpl = sessionTemplates(s, work);
      detail = {
        s,
        work,
        format: sessionFormat(s, work),
        booked: seats.get(s.id) ?? (await bookedSeats(s.id)),
        min: minPlayersOf(s),
        tpl,
        missingGo: missingPlaceholders(tpl.go, { discordUrl: s.discordUrl, bankInfo: settings.bankInfo }),
        reservations: await getReservations(s.id),
        maillog: (await getMailLog(300)).filter((m) => m.sessionId === s.id).slice(0, 40),
      };
    }
  }
}

const workTitle = (id: string) => works.find((w) => w.id === id)?.title ?? id;
const confirmedOf = (list: HtReservation[]) => list.filter((r) => r.status === 'confirmed');

// 一斉送信フォームの件名・本文と、1人目の予約者での差し込みプレビュー
let noticeSubject = '';
let noticeBody = '';
let preview = '';
if (detail && noticeMode) {
  const t = workTitle(detail.s.workId);
  if (noticeMode === 'go') {
    noticeSubject = SUBJECTS.go;
    noticeBody = detail.tpl.go;
  } else if (noticeMode === 'flop') {
    noticeSubject = SUBJECTS.flop;
    noticeBody = detail.tpl.flop;
  } else if (noticeMode === 'cancelled') {
    noticeSubject = `【HACKTALE】公演中止のお知らせ（{日付}「{作品名}」）`;
    noticeBody = `ご予約いただいていた下記の公演は、誠に申し訳ありませんが中止となりました。\n\n■ 公演\n${t}\n{日時}\n${detail.s.venue}\n\n楽しみにお待ちいただいていたところ、大変申し訳ございません。今後の公演情報はNEWS・Xでお知らせいたします。`;
  } else if (noticeMode === 'custom') {
    noticeSubject = `【HACKTALE】{日付}「{作品名}」公演についてのご連絡`;
    noticeBody = `お世話になっております。\n\n先日お申し込みいただきました{日時}「{作品名}」の公演につきまして、ご連絡いたします。\n\n（ここに本文を入力してください）\n\nどうぞよろしくお願いいたします。`;
  } else if (noticeMode === 'changed') {
    noticeSubject = `【HACKTALE】公演内容変更のお知らせ（{日付}「{作品名}」）`;
    noticeBody = `ご予約いただいている公演の開催内容が変更になりましたのでお知らせします。\n\n■ 変更後の内容\n{作品名}\n{日時}\n会場: ${detail.s.venue}${detail.s.meeting ? `（集合: ${detail.s.meeting}）` : ''}\n\nご都合が合わなくなった場合は、このメールへの返信でキャンセル・変更を承ります。`;
  }
  if (postedSubject !== null) noticeSubject = postedSubject;
  if (postedBody !== null) noticeBody = postedBody;
  const sample = confirmedOf(detail.reservations)[0];
  preview = renderTemplate(noticeBody, {
    workTitle: t,
    start: detail.s.start,
    price: detail.s.price,
    discordUrl: detail.s.discordUrl,
    bankInfo: settings.bankInfo,
    name: sample?.name ?? '（お名前）',
    count: sample?.count ?? 1,
    reservationId: sample?.id ?? 'HT-000000-XXXX',
  });
}
// 一斉送信フォームの宛先候補（メールアドレスのある予約。確定は既定でチェック、キャンセル済みは外す）
const bulkToken = randomBytes(16).toString('hex');
const recipientCandidates = detail ? detail.reservations.filter((r) => r.email) : [];
const noMailCount = detail ? confirmedOf(detail.reservations).filter((r) => !r.email).length : 0;
const isChecked = (r: HtReservation) => (postedTo ? postedTo.has(r.id) : r.status === 'confirmed');
const noticeTarget = detail
  ? noticeMode === 'go'
    ? confirmedOf(detail.reservations).filter((r) => r.email && !r.goMailAt).length
    : confirmedOf(detail.reservations).filter((r) => r.email).length
  : 0;
const decisionLabel = (s: HtSession, booked: number) =>
  s.flop ? '見送り' : s.go ? '開催決定' : booked >= minPlayersOf(s) ? `人数到達（${booked}/${minPlayersOf(s)}）` : `未決定（${booked}/${minPlayersOf(s)}）`;
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>HACKTALE 公演予約 管理</title>
<link rel="icon" href="/favicon.ico" sizes="48x48">
</head>
<body>
<div class="wrap">
<header class="top">
  <p class="brand">HACKTALE<span>公演予約 管理</span></p>
  {authed() && (
    <form method="POST" class="inline"><input type="hidden" name="action" value="logout"><button class="linkbtn" type="submit">ログアウト</button></form>
  )}
</header>

{!authed() ? (
  <div class="card login">
    <h1>管理ログイン</h1>
    {loginFailed && <p class="err">合言葉が違うか、試行回数の上限に達しました。10分ほど待って再度お試しください。</p>}
    <form method="POST">
      <input type="hidden" name="action" value="login">
      <label>合言葉<input type="password" name="key" required autocomplete="current-password"></label>
      <button class="btn" type="submit">ログイン</button>
    </form>
  </div>
) : !configured ? (
  <div class="card"><p class="err">データベース（Upstash Redis）が未設定です。docs/hacktale-yoyaku-setup.md の手順で KV_REST_API_URL / KV_REST_API_TOKEN を設定してください。</p></div>
) : (
  <>
  {message && <p class="ok">{message}</p>}
  {error && <p class="err">{error}</p>}

  {!detail ? (
    <>
    {!settings.bankInfo && <p class="warn">振込先が未設定です。オンライン公演の開催案内に差し込むため、ページ下の「設定」で入力してください。</p>}

    {/* ============ 公演回一覧（各回の予約状況と予約者） ============ */}
    <section class="card">
      <div class="cardhead"><h1>公演回と予約状況</h1><a class="linkbtn" href={showPast ? BASE : `${BASE}?past=1`}>{showPast ? '今後の公演だけ表示' : '過去の公演も表示'}</a></div>
      {sessions.length === 0 && <p class="dim">公演回がありません。下のフォームから作成してください。</p>}
      {sessions.length > 0 && (
        <p class="dim">{showPast ? '全' : '今後の'}公演 {sessions.length}回／確定予約 {sessions.reduce((n, s) => n + confirmedOf(s.reservations).length, 0)}組 {sessions.reduce((n, s) => n + s.booked, 0)}名。各回の「予約者」を開くとお客様の情報が見られます。</p>
      )}
      {sessions.map((s) => {
        const conf = confirmedOf(s.reservations);
        const cancelled = s.reservations.length - conf.length;
        const min = minPlayersOf(s);
        const fmt = sessionFormat(s, works.find((w) => w.id === s.workId) ?? null);
        return (
          <article class="sc">
            <div class="schead">
              <div class="sct">
                <a class="scdate" href={`${BASE}?session=${s.id}`}>{formatStartJa(s.start)}</a>
                <span class="scwork">{workTitle(s.workId)}</span>
                <span class="badge">{FORMAT_LABEL[fmt]}</span>
                <span class="badge">{SESSION_STATUS_LABEL[s.status]}</span>
                <span class:list={['badge', { goB: s.go }]}>{decisionLabel(s, s.booked)}</span>
              </div>
              <div class="btnrow" style="margin:0">
                {conf.some((r) => r.email) && <a class="btn small ghost" href={`${BASE}?session=${s.id}&notice=custom#notice`}>メール一斉送信</a>}
                <a class="btn small" href={`${BASE}?session=${s.id}`}>管理</a>
              </div>
            </div>
            <div class="meter" title={`確定${s.booked}名／最少${min}名／定員${s.capacity}名`}>
              <div class="meterbar"><span class="mfill" style={`width:${Math.min(100, (s.booked / s.capacity) * 100)}%`}></span><span class="mmin" style={`left:${(min / s.capacity) * 100}%`}></span></div>
              <span class="mtext">予約 <b>{s.booked}</b>名／最少 {min}名／定員 {s.capacity}名（残り{Math.max(s.capacity - s.booked, 0)}席）｜{AVAILABILITY_LABEL(availability(s, s.booked, now))}</span>
            </div>
            {s.reservations.length > 0 ? (
              <details class="roster" open={conf.length > 0}>
                <summary>予約者 {conf.length}組 {s.booked}名{cancelled > 0 ? `（キャンセル ${cancelled}件）` : ''}</summary>
                <div class="tblwrap">
                <table class="tbl">
                  <thead><tr><th>お名前</th><th>人数</th><th>電話</th><th>メール</th><th>X</th><th>備考</th><th>予約日時</th><th>メール</th></tr></thead>
                  <tbody>
                  {s.reservations.map((r) => (
                    <tr class:list={[{ cancelled: r.status === 'cancelled' }]}>
                      <td class="nowrap">{r.name}{r.status === 'cancelled' && <span class="dim2">（キャンセル）</span>}<br><span class="dim2">{r.id}{r.source === 'manual' ? '・手動' : ''}</span></td>
                      <td class="nowrap">{r.count}名</td>
                      <td class="nowrap">{r.phone ? <a href={`tel:${r.phone}`}>{r.phone}</a> : '―'}</td>
                      <td class="small2">{r.email ? <a href={`mailto:${r.email}`}>{r.email}</a> : '―'}</td>
                      <td class="nowrap">{r.xId ? <a href={`https://x.com/${encodeURIComponent(r.xId)}`} target="_blank" rel="noopener noreferrer">@{r.xId}</a> : '―'}</td>
                      <td class="small2">{r.note ?? '―'}</td>
                      <td class="nowrap small2">{new Date(Date.parse(r.createdAt) + 9 * 3600000).toISOString().slice(5, 16).replace('T', ' ').replace('-', '/')}</td>
                      <td class="nowrap small2">{r.goMailAt ? '開催案内 済' : r.goMailError ? <b class="fail">開催案内 失敗</b> : r.confirmMailAt ? '受付 済' : r.confirmMailError ? <b class="fail">受付 失敗</b> : '―'}</td>
                    </tr>
                  ))}
                  </tbody>
                </table>
                </div>
              </details>
            ) : <p class="dim2 noroster">まだ予約はありません。</p>}
          </article>
        );
      })}
    </section>

    {/* ============ 公演回の新規作成 ============ */}
    <section class="card">
      <h2>公演回を作成</h2>
      <p class="dim">空欄の項目は作品の標準値が入ります。メール文面は形式に合わせた既定文が入り、作成後の画面で手直しできます。作成直後は「非公開」です。</p>
      <form method="POST" class="grid">
        <input type="hidden" name="action" value="session-create">
        <label>作品
          <select name="work" required>
            {works.filter((w) => w.active).map((w) => <option value={w.id}>{w.title}（標準{w.defaultCapacity}名・{workFormats(w).map((f) => FORMAT_LABEL[f]).join('/')}）</option>)}
          </select>
        </label>
        <label>形式（必須）
          <select name="format" required>
            <option value="" disabled selected>選んでください</option>
            <option value="offline">対面</option>
            <option value="online">オンライン</option>
          </select>
        </label>
        <label>開催日時<input type="datetime-local" name="start" required></label>
        <label>会場（空欄=形式ごとの標準）<input type="text" name="venue" placeholder="対面: 神田三崎町／オンライン: Discord"></label>
        <label>定員（空欄=作品の標準）<input type="number" name="capacity" min="1" max="500"></label>
        <label>開催最少人数（空欄=定員と同じ）<input type="number" name="min" min="1" max="500"></label>
        <label class="wide">料金（空欄=作品の形式ごとの標準。人狼定理なら対面4,500円／オンライン3,500円。メールの {'{料金}'} に入ります）<input type="text" name="price" maxlength="100"></label>
        <label class="check"><input type="checkbox" name="prep">事前読み込みあり（対面の開催案内にDiscordサーバー案内を入れる）</label>
        <button class="btn" type="submit">作成する（非公開で保存）</button>
      </form>
    </section>

    {/* ============ 作品 ============ */}
    <section class="card">
      <h2>作品</h2>
      <p class="dim">「標準の定員」「料金」は新しい公演回を作るときの初期値です。変更しても登録済みの公演回には影響しません。「対面公演あり／オンライン公演あり」は、その形式で公演回を作れるかどうかです（人狼定理は両方）。</p>
      {works.map((w) => (
        <details class="wk">
          <summary>{w.title}（標準{w.defaultCapacity}名・{workFormats(w).map((f) => FORMAT_LABEL[f]).join('/')}{w.durationMin ? `・約${w.durationMin}分` : ''}）{!w.active && '｜停止中'}</summary>
          <form method="POST" class="grid">
            <input type="hidden" name="action" value="work-save">
            <input type="hidden" name="id" value={w.id}>
            <label>作品名<input type="text" name="title" value={w.title} required maxlength="60"></label>
            <label>所要時間（分）<input type="number" name="duration" value={w.durationMin ?? ''} min="0"></label>
            <label>標準の定員<input type="number" name="capacity" value={w.defaultCapacity} min="1" max="500" required></label>
            <label>料金の初期値（対面）<input type="text" name="price" value={w.defaultPrice ?? ''} maxlength="100"></label>
            <label>料金の初期値（オンライン）<input type="text" name="price_online" value={w.defaultPriceOnline ?? ''} maxlength="100" placeholder="空欄=対面と同じ"></label>
            <label class="check"><input type="checkbox" name="f_offline" checked={workFormats(w).includes('offline')}>対面公演あり</label>
            <label class="check"><input type="checkbox" name="f_online" checked={workFormats(w).includes('online')}>オンライン公演あり</label>
            <label>画像パス<input type="text" name="image" value={w.image ?? ''} placeholder="/assets/hacktale/kv-xxx.webp"></label>
            <label class="wide">紹介文<textarea name="desc" rows="2">{w.desc ?? ''}</textarea></label>
            <label class="check"><input type="checkbox" name="active" checked={w.active}>新しい公演回の作成対象にする</label>
            <button class="btn" type="submit">保存</button>
          </form>
        </details>
      ))}
      <details class="wk">
        <summary>＋ 新しい作品を登録</summary>
        <form method="POST" class="grid">
          <input type="hidden" name="action" value="work-save">
          <input type="hidden" name="new" value="1">
          <label>作品ID（半角英数字とハイフン）<input type="text" name="id" required pattern="[a-z0-9-]{2,40}" placeholder="例: new-game"></label>
          <label>作品名<input type="text" name="title" required maxlength="60"></label>
          <label>所要時間（分）<input type="number" name="duration" min="0"></label>
          <label>標準の定員<input type="number" name="capacity" min="1" max="500" value="8" required></label>
          <label>料金の初期値（対面）<input type="text" name="price" maxlength="100"></label>
          <label>料金の初期値（オンライン）<input type="text" name="price_online" maxlength="100" placeholder="空欄=対面と同じ"></label>
          <label class="check"><input type="checkbox" name="f_offline" checked>対面公演あり</label>
          <label class="check"><input type="checkbox" name="f_online">オンライン公演あり</label>
          <label class="wide">紹介文<textarea name="desc" rows="2"></textarea></label>
          <label class="check"><input type="checkbox" name="active" checked>新しい公演回の作成対象にする</label>
          <button class="btn" type="submit">登録</button>
        </form>
      </details>
    </section>

    {/* ============ 設定 ============ */}
    <section class="card">
      <h2>設定</h2>
      <form method="POST" class="grid">
        <input type="hidden" name="action" value="settings">
        <label class="wide">振込先（オンライン公演の開催案内の {'{振込先}'} に入ります。改行もそのまま反映）
          <textarea name="bank" rows="4" placeholder={'銀行名\n支店名(番号)\n普通 口座番号\n口座名義'}>{settings.bankInfo ?? ''}</textarea>
        </label>
        <label class="check"><input type="checkbox" name="enabled" checked={settings.reminderEnabled}>開催決定した公演のリマインドメールを自動送信する</label>
        <label>リマインド：開始まで何時間以内になったら送るか
          <input type="number" name="hours" value={settings.reminderHours} min="1" max="168">
        </label>
        <p class="dim wide">リマインドは毎朝9時（日本時間）の定期実行です。既定の36時間なら実質「前日の朝9時」に届きます。同じ定期実行で、まだ開催決定していない8日以内の公演を管理者宛にお知らせします。</p>
        <button class="btn" type="submit">設定を保存</button>
      </form>
    </section>
    </>
  ) : (
    <>
    {/* ============ 公演回の詳細 ============ */}
    <p><a class="linkbtn" href={BASE}>← 公演回一覧へ戻る</a></p>
    <section class="card">
      <div class="cardhead">
        <h1>{workTitle(detail.s.workId)}｜{formatStartJa(detail.s.start)}</h1>
        <span class="badge">{FORMAT_LABEL[detail.format]}</span>
        <span class="badge">{SESSION_STATUS_LABEL[detail.s.status]}</span>
        <span class:list={['badge', { goB: detail.s.go }]}>{decisionLabel(detail.s, detail.booked)}</span>
      </div>
      <p class="dim">確定 {detail.booked}名／開催最少 {detail.min}名／定員 {detail.s.capacity}名（残り{Math.max(detail.s.capacity - detail.booked, 0)}席）｜お客様側の表示: {AVAILABILITY_LABEL(availability(detail.s, detail.booked, now))}｜自動開催決定: {detail.s.autoGo ? 'ON' : 'OFF'}</p>
      {detail.missingGo.length > 0 && !detail.s.flop && <p class="warn">開催案内の差し込みが未入力です: {detail.missingGo.join('、')}。このままでは開催案内を送れません。</p>}

      <div class="btnrow">
        {detail.s.status !== 'open' && !detail.s.flop && <form method="POST" class="inline"><input type="hidden" name="action" value="session-status"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="status" value="open"><button class="btn small" type="submit">公開する</button></form>}
        {!detail.s.go && !detail.s.flop && <form method="POST" class="inline" onsubmit="return confirm('開催決定にしますか？次の画面で開催案内メールを確認して送信します。')"><input type="hidden" name="action" value="go"><input type="hidden" name="session" value={detail.s.id}><button class="btn small" type="submit">開催決定（立卓）</button></form>}
        {detail.s.go && !detail.s.flop && <a class="btn small" href={`${BASE}?session=${detail.s.id}&notice=go`}>開催案内を一斉送信</a>}
        {!detail.s.flop && detail.s.status !== 'cancelled' && <form method="POST" class="inline" onsubmit="return confirm('人数未達で開催見送り（流卓）にしますか？受付は止まり、次の画面で見送りメールを確認して送信します。')"><input type="hidden" name="action" value="flop"><input type="hidden" name="session" value={detail.s.id}><button class="btn small danger" type="submit">開催見送り（流卓）</button></form>}
        {detail.s.flop && <a class="btn small ghost" href={`${BASE}?session=${detail.s.id}&notice=flop`}>見送りメールを送信</a>}
        {detail.s.status === 'open' && <form method="POST" class="inline"><input type="hidden" name="action" value="session-status"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="status" value="closed"><button class="btn small ghost" type="submit">受付停止</button></form>}
        {detail.s.status !== 'draft' && detail.s.status !== 'cancelled' && <form method="POST" class="inline"><input type="hidden" name="action" value="session-status"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="status" value="draft"><button class="btn small ghost" type="submit">非公開に戻す</button></form>}
        {detail.s.status !== 'cancelled' && <form method="POST" class="inline" onsubmit="return confirm('この公演を中止にしますか？（人数未達の場合は「開催見送り」を使ってください）')"><input type="hidden" name="action" value="session-status"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="status" value="cancelled"><button class="btn small danger" type="submit">中止（その他の理由）</button></form>}
        <form method="POST" class="inline"><input type="hidden" name="action" value="session-clone"><input type="hidden" name="session" value={detail.s.id}><button class="btn small ghost" type="submit">複製</button></form>
        <a class="btn small" href={`${BASE}?session=${detail.s.id}&notice=custom#notice`}>予約者へメール一斉送信</a>
        <a class="btn small ghost" href={`${BASE}?session=${detail.s.id}&csv=1`}>CSV出力</a>
        {detail.s.go && <form method="POST" class="inline"><input type="hidden" name="action" value="remind-now"><input type="hidden" name="session" value={detail.s.id}><button class="btn small ghost" type="submit" onclick="return confirm('未送信の確定予約にリマインドメールを今すぐ送信します。よろしいですか？')">リマインドを今すぐ送信</button></form>}
        {detail.s.go && !detail.s.flop && <form method="POST" class="inline" onsubmit="return confirm('開催決定を取り消しますか？（送信済みの開催案内は取り消せません）')"><input type="hidden" name="action" value="ungo"><input type="hidden" name="session" value={detail.s.id}><button class="linkbtn" type="submit">開催決定を取り消す</button></form>}
        {detail.reservations.length === 0 && <form method="POST" class="inline" onsubmit="return confirm('この公演回を削除しますか？')"><input type="hidden" name="action" value="session-delete"><input type="hidden" name="session" value={detail.s.id}><button class="btn small danger" type="submit">削除</button></form>}
      </div>
      <p class="dim">公開ページ: <a href={`/hacktale/reservation/${detail.s.id}/`} target="_blank" rel="noopener">/hacktale/reservation/{detail.s.id}/</a></p>
    </section>

    {noticeMode && (
      <section class="card notice" id="notice">
        <h2>{noticeMode === 'go' ? '開催案内メール（一斉送信）' : noticeMode === 'flop' ? '開催見送りメール' : noticeMode === 'cancelled' ? '中止のご案内メール' : noticeMode === 'custom' ? '予約者へメール一斉送信' : '変更のご案内メール'}</h2>
        <p class="dim">
          {noticeMode === 'go'
            ? `開催案内をまだ受け取っていない確定予約 ${noticeTarget}件に送信します。ここで手直しした本文は公演回に保存され、この後に申し込んだ方にも同じ案内が自動で届きます。`
            : noticeMode === 'flop'
              ? `確定済みの予約 ${noticeTarget}件に送信します。`
              : '下の「送信先」でチェックした予約者に送ります。まず「自分にテスト送信」で届き方を確認できます。'}
          宛名（〇〇 様）と予約番号・問い合わせ先は自動で付きます。
        </p>
        <form method="POST" class="grid">
          {(noticeMode === 'go' || noticeMode === 'flop') && <input type="hidden" name="action" value={noticeMode === 'go' ? 'go-send' : 'flop-send'}>}
          <input type="hidden" name="session" value={detail.s.id}>
          {noticeMode === 'go'
            ? <p class="wide dim">件名: {renderTemplate(noticeSubject, { workTitle: workTitle(detail.s.workId), start: detail.s.start, price: detail.s.price })}</p>
            : <label class="wide">件名<input type="text" name="subject" value={noticeSubject} required maxlength="120"></label>}
          <label class="wide">本文<textarea name="body" rows="16" required>{noticeBody}</textarea></label>
          {(noticeMode === 'custom' || noticeMode === 'changed' || noticeMode === 'cancelled') && (
            <>
            <p class="wide dim">差し込み（送信時に予約者ごとに置き換わります）: {PLACEHOLDERS.map((p) => <span class="ph" title={p.desc}>{p.key}</span>)}</p>
            <input type="hidden" name="bulk" value={bulkToken}>
            <fieldset class="wide rcpt">
              <legend>送信先（{recipientCandidates.filter(isChecked).length}件選択中）</legend>
              {recipientCandidates.length === 0 && <p class="dim2">メールアドレスのある予約者がいません。</p>}
              {recipientCandidates.map((r) => (
                <label class:list={['check', { cancelled: r.status === 'cancelled' }]}>
                  <input type="checkbox" name="to" value={r.id} checked={isChecked(r)}>
                  {r.name}様（{r.count}名）<span class="dim2">{r.email}{r.status === 'cancelled' ? '・キャンセル済み' : ''}</span>
                </label>
              ))}
              {noMailCount > 0 && <p class="dim2">※メールアドレスのない予約（電話・LINEでの手動登録）が{noMailCount}件あります。この方々には個別にご連絡ください。</p>}
            </fieldset>
            </>
          )}
          <details class="wide pv"><summary>差し込み後のプレビュー（{confirmedOf(detail.reservations)[0]?.name ?? '見本'}様あて）</summary><pre>{preview}</pre></details>
          {(noticeMode === 'custom' || noticeMode === 'changed' || noticeMode === 'cancelled') ? (
            <div class="wide btnrow">
              <button class="btn ghost" type="submit" name="action" value="notice-test" formnovalidate>自分にテスト送信（{adminEmail()}）</button>
              <button class="btn" type="submit" name="action" value="notice" onclick="return confirm('チェックした予約者に一斉送信します。よろしいですか？')">チェックした予約者に送信する</button>
            </div>
          ) : (
            <button class="btn" type="submit" onclick="return confirm('この内容で一斉送信します。よろしいですか？')">この内容で送信する</button>
          )}
        </form>
      </section>
    )}

    {/* ============ 公演回の編集 ============ */}
    <section class="card">
      <h2>公演回の編集</h2>
      <form method="POST" class="grid">
        <input type="hidden" name="action" value="session-save">
        <input type="hidden" name="session" value={detail.s.id}>
        <label>作品
          <select name="work">{works.map((w) => <option value={w.id} selected={w.id === detail!.s.workId}>{w.title}</option>)}</select>
        </label>
        <label>形式
          <select name="format"><option value="offline" selected={detail.format === 'offline'}>対面</option><option value="online" selected={detail.format === 'online'}>オンライン</option></select>
        </label>
        <label>開催日時<input type="datetime-local" name="start" value={detail.s.start} required></label>
        <label>受付期限（空欄=開始時刻まで）<input type="datetime-local" name="deadline" value={detail.s.deadline ?? ''}></label>
        <label>会場（一覧・予約ページに表示）<input type="text" name="venue" value={detail.s.venue} required maxlength="120"></label>
        <label>集合場所（任意）<input type="text" name="meeting" value={detail.s.meeting ?? ''} maxlength="200"></label>
        <label>定員<input type="number" name="capacity" value={detail.s.capacity} min="1" max="500" required></label>
        <label>開催最少人数<input type="number" name="min" value={detail.min} min="1" max="500" required></label>
        <label>料金（{'{料金}'}）<input type="text" name="price" value={detail.s.price} maxlength="100"></label>
        <label>Discordリンク（{'{Discordリンク}'}）<input type="url" name="discord" value={detail.s.discordUrl ?? ''} placeholder="https://discord.gg/..."></label>
        <label class="check"><input type="checkbox" name="autogo" checked={!!detail.s.autoGo}>開催最少人数に達したら自動で開催決定し、開催案内を送る（差し込みが揃っている場合のみ）</label>
        <label class="wide">予約ページに出す注意事項（任意）<textarea name="notes" rows="3">{detail.s.notes ?? ''}</textarea></label>

        <div class="wide tplhead">
          <h3>メール文面</h3>
          <p class="dim">次の差し込みは送信時に自動で置き換わります: {PLACEHOLDERS.map((p) => <span class="ph" title={p.desc}>{p.key}</span>)}</p>
        </div>
        <label class="wide">① 受付メール（申し込み直後に自動送信）<textarea name="tpl_accept" rows="10">{detail.tpl.accept}</textarea></label>
        <label class="wide">② 開催案内メール（開催決定時に一斉送信／開催決定後の申し込みには自動送信）<textarea name="tpl_go" rows="16">{detail.tpl.go}</textarea></label>
        <label class="wide">③ 開催見送りメール（流卓時）<textarea name="tpl_flop" rows="8">{detail.tpl.flop}</textarea></label>
        <p class="dim wide">確定済みの予約人数より少ない定員には変更できません。日時・会場を変更すると、確定済み予約への案内メール送信フォームが表示されます。</p>
        <button class="btn" type="submit">保存</button>
      </form>
      <div class="btnrow">
        <span class="dim">文面を既定に戻す:</span>
        <form method="POST" class="inline"><input type="hidden" name="action" value="tpl-reset"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="which" value="accept"><button class="linkbtn" type="submit" onclick="return confirm('受付メールを既定の文面に戻しますか？')">①受付</button></form>
        <form method="POST" class="inline"><input type="hidden" name="action" value="tpl-reset"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="which" value="go"><input type="hidden" name="kind" value="offline"><button class="linkbtn" type="submit" onclick="return confirm('開催案内を「対面」の既定文面に戻しますか？')">②対面</button></form>
        <form method="POST" class="inline"><input type="hidden" name="action" value="tpl-reset"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="which" value="go"><input type="hidden" name="kind" value="offline-prep"><button class="linkbtn" type="submit" onclick="return confirm('開催案内を「対面＋事前読み込み」の既定文面に戻しますか？')">②対面＋事前読み込み</button></form>
        <form method="POST" class="inline"><input type="hidden" name="action" value="tpl-reset"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="which" value="go"><input type="hidden" name="kind" value="online"><button class="linkbtn" type="submit" onclick="return confirm('開催案内を「オンライン」の既定文面に戻しますか？')">②オンライン</button></form>
        <form method="POST" class="inline"><input type="hidden" name="action" value="tpl-reset"><input type="hidden" name="session" value={detail.s.id}><input type="hidden" name="which" value="flop"><button class="linkbtn" type="submit" onclick="return confirm('見送りメールを既定の文面に戻しますか？')">③見送り</button></form>
      </div>
    </section>

    {/* ============ 予約一覧 ============ */}
    <section class="card">
      <div class="cardhead"><h2>予約一覧（{detail.reservations.length}件）</h2>
      <form method="POST" class="inline"><input type="hidden" name="action" value="session-recount"><input type="hidden" name="session" value={detail.s.id}><button class="linkbtn" type="submit">確定人数を再集計</button></form></div>
      {detail.reservations.length === 0 && <p class="dim">まだ予約はありません。</p>}
      {detail.reservations.length > 0 && (
        <table class="tbl">
          <thead><tr><th>予約番号</th><th>お名前</th><th>連絡先</th><th>人数</th><th>状態</th><th>メール</th><th>操作</th></tr></thead>
          <tbody>
          {detail.reservations.map((r) => (
            <tr class:list={[{ cancelled: r.status === 'cancelled' }]}>
              <td class="nowrap">{r.id}<br><span class="dim2">{r.createdAt.slice(0, 16).replace('T', ' ')}（{r.source === 'web' ? 'Web' : '手動'}）</span></td>
              <td>{r.name}{r.note && <><br><span class="dim2">備考: {r.note}</span></>}</td>
              <td class="small2">{r.email || '（メールなし）'}<br>{r.phone}{r.xId && <><br>@{r.xId}</>}</td>
              <td class="nowrap">{r.count}名</td>
              <td class="nowrap">{r.status === 'confirmed' ? '確定' : 'キャンセル'}</td>
              <td class="small2 nowrap">
                受付: {r.confirmMailAt ? '済' : r.confirmMailError ? <b class="fail">失敗</b> : '―'}<br>
                開催案内: {r.goMailAt ? '済' : r.goMailError ? <b class="fail">失敗</b> : '未'}<br>
                リマインド: {r.remindedAt ? '済' : r.reminderSkipped ? '対象外' : '未'}
                {r.flopMailAt && <><br>見送り: 済</>}
              </td>
              <td class="ops">
                {r.status === 'confirmed' && (
                  <>
                  <form method="POST" class="inline"><input type="hidden" name="action" value="res-count"><input type="hidden" name="session" value={detail!.s.id}><input type="hidden" name="res" value={r.id}><input class="numin" type="number" name="count" value={r.count} min="1" max="500"><button class="linkbtn" type="submit">人数変更</button></form>
                  <form method="POST" class="inline" onsubmit={`return confirm('予約 ${r.id}（${r.name}様 ${r.count}名）をキャンセルしますか？枠は戻ります。')`}><input type="hidden" name="action" value="res-cancel"><input type="hidden" name="session" value={detail!.s.id}><input type="hidden" name="res" value={r.id}><button class="linkbtn danger2" type="submit">キャンセル</button></form>
                  </>
                )}
                {r.email && <form method="POST" class="inline"><input type="hidden" name="action" value="res-resend"><input type="hidden" name="session" value={detail!.s.id}><input type="hidden" name="res" value={r.id}><button class="linkbtn" type="submit">受付メール再送</button></form>}
                {r.email && r.status === 'confirmed' && detail!.s.go && <form method="POST" class="inline"><input type="hidden" name="action" value="res-resend-go"><input type="hidden" name="session" value={detail!.s.id}><input type="hidden" name="res" value={r.id}><button class="linkbtn" type="submit">開催案内{r.goMailAt ? '再送' : '送信'}</button></form>}
              </td>
            </tr>
          ))}
          </tbody>
        </table>
      )}
    </section>

    {/* ============ 手動登録 ============ */}
    <section class="card">
      <h2>予約の手動登録（電話・LINE受付分）</h2>
      <form method="POST" class="grid">
        <input type="hidden" name="action" value="res-add">
        <input type="hidden" name="session" value={detail.s.id}>
        <label>お名前<input type="text" name="name" required maxlength="40"></label>
        <label>人数<input type="number" name="count" value="1" min="1" max="50" required></label>
        <label>メール（任意）<input type="email" name="email" maxlength="254"></label>
        <label>電話（任意）<input type="tel" name="phone" maxlength="20"></label>
        <label>X ID（任意）<input type="text" name="x" maxlength="30"></label>
        <label class="wide">備考<input type="text" name="note" maxlength="500" placeholder="例: LINEで受付"></label>
        <label class="check"><input type="checkbox" name="sendmail" checked>メールを送る（開催決定前は受付メール、決定後は開催案内）</label>
        <button class="btn" type="submit">登録する（定員チェックあり）</button>
      </form>
    </section>

    {/* ============ 送信履歴 ============ */}
    <section class="card">
      <h2>メール送信履歴（この公演・直近40件）</h2>
      {detail.maillog.length === 0 && <p class="dim">送信履歴はまだありません。</p>}
      {detail.maillog.length > 0 && (
        <table class="tbl">
          <thead><tr><th>日時(UTC)</th><th>種類</th><th>宛先</th><th>件名</th><th>結果</th></tr></thead>
          <tbody>
          {detail.maillog.map((m) => (
            <tr><td class="nowrap">{m.at.slice(0, 16).replace('T', ' ')}</td><td class="nowrap">{MAIL_KIND_LABEL[m.kind] ?? m.kind}</td><td class="small2">{m.to}</td><td class="small2">{m.subject}</td><td>{m.ok ? '成功' : <b class="fail">失敗</b>}</td></tr>
          ))}
          </tbody>
        </table>
      )}
    </section>
    </>
  )}
  </>
)}
<p class="foot">HACKTALE 公演予約管理｜株式会社 ex Labs</p>
</div>

<style is:global>
*{box-sizing:border-box}
body{margin:0;background:#111113;color:#f1efe9;font-family:'Hiragino Kaku Gothic ProN','Noto Sans JP',sans-serif;font-size:14px;line-height:1.8;-webkit-font-smoothing:antialiased}
.wrap{max-width:960px;margin:0 auto;padding:28px 20px 80px}
.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.brand{font-weight:900;letter-spacing:.1em;margin:0;font-size:16px}
.brand span{font-weight:400;font-size:12px;color:#9b978c;margin-left:12px;letter-spacing:.08em}
h1{font-size:18px;margin:0 0 4px;line-height:1.5}
h2{font-size:15px;margin:0 0 10px}
h3{font-size:14px;margin:8px 0 4px}
a{color:#d9e63b}
.card{background:#18181b;border:1px solid rgba(255,255,255,.12);padding:20px 22px;margin:0 0 18px}
.card.notice{border-color:#d9e63b}
.cardhead{display:flex;align-items:center;gap:10px 14px;flex-wrap:wrap;margin-bottom:6px}
.cardhead h1,.cardhead h2{margin-right:auto}
.login{max-width:420px;margin:60px auto}
.ok{border:1px solid rgba(217,230,59,.6);color:#e9f28d;padding:12px 16px;margin:0 0 16px;background:rgba(217,230,59,.06)}
.err{border:1px solid #e5484d;color:#e08a8a;padding:12px 16px;margin:0 0 16px}
.warn{border:1px solid #d9a13b;color:#f0c987;padding:10px 14px;margin:8px 0 12px;font-size:13px}
.dim{color:#9b978c;font-size:12.5px;margin:0 0 12px}
.dim2{color:#6f6c64;font-size:11.5px}
.small2{font-size:12px;word-break:break-all}
.fail{color:#e5484d}
label{display:block;font-size:12.5px;font-weight:700;margin:0}
input[type=text],input[type=email],input[type=tel],input[type=url],input[type=number],input[type=password],input[type=datetime-local],select,textarea{width:100%;margin-top:5px;padding:9px 11px;font:inherit;font-size:14px;background:#0d0d0e;border:1px solid rgba(255,255,255,.2);color:#f1efe9}
textarea{font-size:13px;line-height:1.7;resize:vertical}
input:focus,select:focus,textarea:focus{outline:none;border-color:#d9e63b}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:end}
.grid .wide{grid-column:1/-1}
.grid .btn{grid-column:1/-1;justify-self:start}
.check{display:flex;align-items:center;gap:8px;font-weight:400;grid-column:1/-1}
.check input{width:auto;margin:0;accent-color:#d9e63b}
.btn{display:inline-flex;align-items:center;background:#d9e63b;color:#0d0d0e;border:1px solid #d9e63b;padding:10px 22px;font:inherit;font-size:13px;font-weight:700;letter-spacing:.06em;cursor:pointer;text-decoration:none}
.btn.small{padding:5px 14px;font-size:12px}
.btn.ghost{background:transparent;color:#f1efe9;border-color:rgba(255,255,255,.3)}
.btn.danger{background:transparent;color:#e5484d;border-color:#e5484d}
.btnrow{display:flex;gap:8px 12px;flex-wrap:wrap;align-items:center;margin:12px 0}
.badge{font-size:11px;letter-spacing:.1em;border:1px solid rgba(255,255,255,.3);padding:3px 10px;color:#c9c5ba;white-space:nowrap}
.badge.goB{background:#d9e63b;color:#0d0d0e;border-color:#d9e63b;font-weight:700}
.tbl{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:6px}
.tbl th{color:#9b978c;font-size:11px;letter-spacing:.06em;font-weight:500}
.tbl th,.tbl td{text-align:left;padding:9px 10px 9px 0;border-bottom:1px solid rgba(255,255,255,.08);vertical-align:top}
.nowrap{white-space:nowrap}
.cancelled td{color:#6f6c64}
.inline{display:inline}
.linkbtn{background:none;border:none;color:#d9e63b;font:inherit;font-size:12.5px;cursor:pointer;text-decoration:underline;padding:0}
.danger2{color:#e5484d}
.ops{display:flex;flex-direction:column;gap:6px;min-width:130px}
.ops form{display:flex;gap:6px;align-items:center}
.numin{width:60px!important;margin:0!important;padding:4px 6px!important}
.wk{border-top:1px solid rgba(255,255,255,.08);padding:10px 0}
.wk summary{cursor:pointer;font-weight:700;font-size:13px}
.wk form{margin-top:14px}
.tplhead{border-top:1px solid rgba(255,255,255,.1);padding-top:12px}
.ph{display:inline-block;font-family:ui-monospace,monospace;font-size:11.5px;border:1px solid rgba(255,255,255,.2);padding:0 6px;margin:2px 4px 2px 0;color:#e9f28d;cursor:help}
.pv summary{cursor:pointer;font-size:12.5px;color:#c9c5ba}
.pv pre{white-space:pre-wrap;font-family:inherit;font-size:12.5px;line-height:1.8;background:#0d0d0e;border:1px solid rgba(255,255,255,.12);padding:14px;margin:8px 0 0;max-height:420px;overflow:auto}
.foot{color:#6f6c64;font-size:11px;text-align:center;margin-top:40px}
.sc{border-top:1px solid rgba(255,255,255,.1);padding:16px 0 14px}
.sc:first-of-type{border-top:none}
.schead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.sct{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px}
.scdate{font-weight:900;font-size:15px;color:#f1efe9;text-decoration:none}
.scdate:hover{color:#d9e63b}
.scwork{font-weight:700;font-size:14px}
.meter{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:10px 0 6px}
.meterbar{position:relative;width:180px;height:8px;background:#2a2a2e;flex-shrink:0}
.mfill{position:absolute;left:0;top:0;bottom:0;background:#d9e63b}
.mmin{position:absolute;top:-4px;bottom:-4px;width:2px;background:#e5484d;margin-left:-1px}
.mtext{font-size:12.5px;color:#c9c5ba}
.mtext b{color:#d9e63b;font-size:14px}
.roster summary{cursor:pointer;font-size:13px;font-weight:700;color:#e9f28d;margin:4px 0}
.tblwrap{overflow-x:auto}
.noroster{margin:4px 0 0}
.tbl a{color:#f1efe9}
.rcpt{border:1px solid rgba(255,255,255,.15);padding:10px 14px 12px;margin:0;display:flex;flex-direction:column;gap:6px}
.rcpt legend{font-size:12.5px;font-weight:700;padding:0 6px}
.rcpt .check{font-size:13px}
.rcpt .check.cancelled{color:#8f8b82}
@media(max-width:720px){.grid{grid-template-columns:1fr}.tbl{display:block;overflow-x:auto;white-space:nowrap}.wrap{padding:20px 14px 60px}}
</style>
</body>
</html>
