<body id="top">
<div class="prog" aria-hidden="true"></div>

<!-- ===== ヒーロー：大義 ===== -->
<section class="hero" aria-labelledby="copy">
  <div class="grid" aria-hidden="true"></div>
  <div class="glow g1" aria-hidden="true" data-par="0.12"></div><div class="glow g2" aria-hidden="true" data-par="0.2"></div><div class="glow g3" aria-hidden="true" data-par="0.08"></div>
  <div class="suits" aria-hidden="true">
    {SUITS.map((k, i) => <svg viewBox="0 0 24 24" data-par={String(0.25 + i * 0.1)}><path d={SUIT[k]} /></svg>)}
  </div>
  <header class="hd">
    <img src="/assets/hacktale/logo.png" alt="HACKTALE" width="1100" height="230">
    <span class="en">AWARD #1</span>
  </header>
  <a class="scroll" href="#message" aria-label="下へスクロール">SCROLL</a>
  <div class="copy-wrap">
    <h1 class="copy" id="copy" aria-label={CAUSE}>
      <span class="ln ln1" aria-hidden="true"><b class="x1 cut" data-t="頭脳戦">頭脳戦</b><span class="s">、</span><span class="ph ph-dice"><img src="/assets/hacktale/award/dice.webp" alt="" width="360" height="360" decoding="async"></span></span>
      <span class="ln ln2" aria-hidden="true"><b class="x2 tile t-blue">コンゲーム</b><span class="s">の</span></span>
      <span class="ln ln3" aria-hidden="true"><span class="ph ph-hands"><img src="/assets/hacktale/award/hands.webp" alt="" width="480" height="282" decoding="async"></span><b class="x3 tile t-purple">作品</b><span class="s">が</span><b class="x4">もっと</b></span>
      <span class="ln ln4" aria-hidden="true"><b class="x5 tile t-red">もっと</b><b class="x6 cut" data-t="増">増</b><span class="s tate">えて</span><b class="x6">欲</b><span class="s tate">しい</span><b class="x7">！</b></span>
    </h1>
    <div class="hero-meta">
      <p class="t"><span class="nb">第1回</span> <span class="nb">ハックテイル大賞</span> <span class="nb">作品募集</span></p>
      <p class="d en"><span class="nb">2026.11.25 WED</span><i>—</i><span class="nb">2027.02.28 SUN</span></p>
      <ul class="chips"><li>応募無料</li><li>プロ・アマ不問</li><li>何作品でも</li></ul>
    </div>
  </div>
</section>

<div class="mq" aria-hidden="true"><div class="mq-t">
  {[0, 1].map(() => <div class="mq-h">{Array.from({ length: 4 }, (_, i) => <><span>{CAUSE}</span><svg viewBox="0 0 24 24"><path d={SUIT[SUITS[i]]} fill={COLORS[i % 3]} /></svg></>)}</div>)}
</div></div>

<!-- ===== MESSAGE（開催趣旨） ===== -->
<section class="msg" id="message" aria-labelledby="msg-h">
  <div class="chip" aria-hidden="true">
    <svg viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="98" fill="#0c0c12"/>
      <g fill="#fff">{Array.from({ length: 8 }, (_, i) => <rect x="91" y="2" width="18" height="24" transform={`rotate(${i * 45} 100 100)`} fill={i % 2 ? '#ff2d4a' : '#fff'} />)}</g>
      <circle cx="100" cy="100" r="66" fill="none" stroke="#fff" stroke-width="2" stroke-dasharray="4 6"/>
      <circle cx="100" cy="100" r="54" fill="#fff"/>
      <path d={SUIT.spade} fill="#0c0c12" transform="translate(64 64) scale(3)"/>
    </svg>
  </div>
  <div class="chip2" aria-hidden="true">
    <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="96" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="14 10"/><circle cx="100" cy="100" r="70" fill="none" stroke="#fff" stroke-width="1.5"/></svg>
  </div>
  <div class="wrap">
    <p class="lbl io"><b>00</b><span>MESSAGE</span></p>
    <h2 class="sr" id="msg-h">開催趣旨</h2>
    {MESSAGE.map((para) => <p class="para io">{para.map((l, i) => <span style={`transition-delay:${i * 0.11}s`}>{l}</span>)}</p>)}
    <p class="last io"><span>頭脳戦、コンゲームの作品が</span><span>もっともっと増えて欲しい<i>！</i></span></p>
  </div>
</section>

<!-- ===== THEME（募集内容） ===== -->
<section class="sec c-blue" id="theme" aria-labelledby="theme-h">
  <div class="wrap">
    <p class="lbl io"><b>01</b><span>THEME</span></p>
    <h2 class="h2 io" id="theme-h"><span class="wipe">運ではなく、</span><span class="wipe"><em>「読み合い」</em>と</span><span class="wipe"><em>「閃き」</em>で。</span></h2>
    <p class="lead rv-b"><J t={jt('募集するのは、運ではなく**「読み合い」**と**「閃き」**で勝敗が決まる、**オリジナルの対人ゲーム**です。')} keep={KEEP_J} /></p>

    <h3 class="h3 rv-l"><span class="en">CONDITIONS</span><span>頭脳戦ゲームの条件</span></h3>
    <p class="must rv-z">すべてを満たすこと</p>
    <ol class="cond stg sl">
      {CONDITIONS.map((c, i) => (
        <li style={`--c:${COLORS[i % 3]}`}><span class="no">{pad(i + 1)}</span><span class="k">{c.k}</span><span class="s"><J t={jt(c.s)} keep={KEEP_J} /></span>{c.n && <span class="n"><J t={jt(`（${c.n}）`)} keep={KEEP_J} /></span>}</li>
      ))}
    </ol>

    <h3 class="h3 rv-l"><span class="en">SPEC</span><span>ゲームの仕様</span></h3>
    <dl class="spec stg sz">
      {SPEC.map((s, i) => (
        <div class={s.big ? 'big' : 'wide'} style={`--c:${COLORS[(i + 1) % 3]}`}>
          <dt>{s.k}</dt>
          {s.big && <p class="num" aria-hidden="true">{s.big}<small>{s.unit}</small></p>}
          <dd><J t={jt(s.v)} keep={KEEP_J} /></dd>
        </div>
      ))}
    </dl>

    <h3 class="h3 rv-l"><span class="en">SUBMISSION</span><span>提出物</span></h3>
    <ul class="sub stg sf">
      {SUBMIT.map((s) => (
        <li><span class={`t${s.req ? ' req' : ''}`}>{s.req ? '必須' : '任意'}</span><span class="s"><J t={jt(s.s)} keep={KEEP_J} />{s.n && <span class="n"><J t={jt(s.n)} keep={KEEP_J} /></span>}</span></li>
      ))}
    </ul>
    <p class="callout rv"><J t={jt('ルール説明書だけを読んで、**作者がいなくても遊べる状態**でご応募ください。')} keep={KEEP_J} /></p>
  </div>
</section>

<!-- ===== PRIZE（賞と特典） ===== -->
<section class="sec c-red" id="prize" aria-labelledby="prize-h">
  <div class="wrap">
    <p class="lbl io"><b>02</b><span>PRIZE</span></p>
    <h2 class="h2 io" id="prize-h"><span class="wipe">賞と特典</span></h2>

    <div class="grand rv-z">
      <svg class="suit" viewBox="0 0 24 24" aria-hidden="true"><path d={SUIT.spade} /></svg>
      <div class="r">
        <p class="k">GRAND PRIZE</p>
        <h3>ハックテイル大賞</h3>
        <p class="cnt">1作品</p>
        <div class="money"><span class="lab">賞金</span><span class="v" data-count="30">30</span><span class="u">万円</span></div>
        <p class="plus"><span>1公演ごとのライセンス料</span></p>
        <ul>
          {['1公演あたり売上の一定割合をライセンス料として支払い（料率と売上の範囲は要相談）', 'ハックテイルでの公演化', '制作チームによる監修'].map((s, i) => <li style={`--c:${COLORS[i % 3]}`}><span><J t={jt(s)} keep={KEEP_J} /></span></li>)}
        </ul>
      </div>
    </div>
    <div class="prizes stg">
      {PRIZES.map((p, i) => (
        <div style={`--c:${p.color}`}>
          <h4>{p.name}</h4>
          {p.money ? <p class="m"><span data-count={p.money.replace('万円', '')}>{p.money.replace('万円', '')}</span><small>万円</small></p> : <p class="m none">賞金なし</p>}
          {p.count && <p class="c">{p.count}</p>}
          {p.note && <p class="nt"><J t={jt(p.note)} keep={KEEP_J} /></p>}
        </div>
      ))}
    </div>
    <p class="note rv"><J t={jt('賞金は受賞者（チームの場合は代表者）の指定口座に振り込みます。税法上必要な場合は源泉徴収後の金額となります。審査の結果、「該当作なし」とする賞が出る場合があります。')} keep={KEEP_J} /></p>

    <div class="folds stg">
      <details class="fold" style="--c:var(--red)">
        <summary><span class="ic" aria-hidden="true">?</span><span class="t">大賞・特別賞の決まり方</span><span class="hint" aria-hidden="true"></span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body">
          <p class="callout"><J t={jt('大賞は、ハックテイルとの公演化契約（ライセンス契約）を結んだ時点で確定します。契約に至らなかった場合は大賞になりません。')} keep={KEEP_J} /></p>
          <ol class="steps">{DECIDE.map((s, i) => <li style={`--c:${i === 3 ? 'var(--ink)' : COLORS[i % 3]}`}><J t={jt(s)} keep={KEEP_J} /></li>)}</ol>
          <p class="callout sp"><J t={jt(SPECIAL_NOTE)} keep={KEEP_J} /></p>
        </div>
      </details>
      <details class="fold" style="--c:var(--purple)">
        <summary><span class="ic" aria-hidden="true">§</span><span class="t">契約の主な条件</span><span class="hint" aria-hidden="true"></span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body">
          <dl class="kv">
            {CONTRACT.map((c) => (
              <div><dt><J t={jt(c.k)} keep={KEEP_J} /></dt><dd><J t={jt(c.v)} keep={KEEP_J} /></dd></div>
            ))}
          </dl>
        </div>
      </details>
    </div>
  </div>
</section>

<!-- ===== JUDGING（審査の流れと日程・審査の進め方・審査基準・審査員） ===== -->
<section class="sec c-purple" id="judging" aria-labelledby="judging-h">
  <div class="wrap">
    <p class="lbl io"><b>03</b><span>JUDGING</span></p>
    <h2 class="h2 io" id="judging-h"><span class="wipe">審査の流れと</span><span class="wipe">日程</span></h2>
    <ol class="flow io">
      {FLOW.map((f, i) => (
        <li class={i === 0 ? 'hot' : ''} style={`--c:${COLORS[i % 3]}`}><span class="d">{f.d}</span><span class="k">{f.k}</span><span class="s"><J t={jt(f.s)} keep={KEEP_J} /></span></li>
      ))}
    </ol>
    <p class="note rv"><J t={jt('一次審査はルール説明書を読んで選び、通過作だけを審査員が実際に遊んで点数を付けます。3月以降の日程は予定です。')} keep={KEEP_J} /></p>

    <div class="folds stg">
      <details class="fold" style="--c:var(--purple)">
        <summary><span class="ic" aria-hidden="true">3</span><span class="t">審査の進め方</span><span class="hint" aria-hidden="true"></span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body">
          <p class="lead"><J t={jt('審査は3段階で、二次審査では審査員が実際に遊んで評価します。')} keep={KEEP_J} /></p>
          <div class="three" role="list">
            <div role="listitem" style="--c:var(--blue)"><p class="n en">01</p><p class="k">一次審査</p><p class="s">書類で選考</p></div>
            <div role="listitem" style="--c:var(--red)"><p class="n en">02</p><p class="k">二次審査</p><p class="s"><span class="nb">実際に遊んで</span><span class="nb">審査</span></p></div>
            <div role="listitem" style="--c:var(--purple)"><p class="n en">03</p><p class="k">最終審査</p><p class="s"><span class="nb">大賞候補を</span><span class="nb">選出</span></p></div>
          </div>
        </div>
      </details>
      <details class="fold" style="--c:var(--blue)">
        <summary><span class="ic" aria-hidden="true">100</span><span class="t">審査基準と配点</span><span class="hint" aria-hidden="true"></span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body">
          <ul class="crit">
            {CRITERIA.map((c, i) => (
              <li style={`--c:${COLORS[i % 3]}`}>
                <div class="top"><h4>{c.k}</h4><p class="p">{c.p}<small>点</small></p></div>
                <div class="bar" aria-hidden="true"><i style={`--w:${(c.p / 25) * 100}%;animation-delay:${i * 0.08}s`}></i></div>
                <p><J t={jt(c.s)} keep={KEEP_J} /></p>
              </li>
            ))}
          </ul>
          <p class="total"><span>合計</span><b>100</b><span>点満点</span></p>
        </div>
      </details>
    </div>

    <h3 class="h3 rv-l"><span class="en">JUDGES</span><span>審査員</span></h3>
    <ul class="judges stg sz">
      {JUDGES.map((j, i) => (
        <li style={`--c:${COLORS[(i + 1) % 3]}`}>
          <span class="ph-j"><img src={j.img} alt={`${j.name}のプロフィール画像`} width="640" height="640" loading="lazy" decoding="async" style={`object-position:${j.pos}`}></span>
          <span class="tx"><span class="role en">JUDGE</span><span class="nm">{j.name}</span><span class="ti">{j.title}</span></span>
        </li>
      ))}
    </ul>
    <p class="lead rv-b" style="margin-top:1.6em"><J t={jt('ハックテイル制作チームとゲスト審査員（後日発表）が複数名で審査します。')} keep={KEEP_J} /></p>
    <p class="note rv"><J t={jt('審査内容や選考理由についての個別のお問い合わせにはお答えできません。')} keep={KEEP_J} /></p>
  </div>
</section>

<!-- ===== OUTLINE（応募概要） ===== -->
<section class="sec c-blue" id="outline" aria-labelledby="outline-h">
  <div class="wrap">
    <p class="lbl io"><b>04</b><span>OUTLINE</span></p>
    <h2 class="h2 io" id="outline-h"><span class="wipe">応募は<em>無料</em>。</span><span class="wipe"><em>何作品</em>でも。</span></h2>
    <p class="lead rv-b"><J t={jt('応募は無料で、個人でもチームでも、何作品でも出せます。')} keep={KEEP_J} /></p>
    <dl class="kv stg">
      {OUTLINE.map((o) => (
        <div><dt><J t={jt(o.k)} keep={KEEP_J} /></dt><dd><J t={jt(o.v)} keep={KEEP_J} /></dd></div>
      ))}
    </dl>
  </div>
</section>

<!-- ===== RULES（注意事項） ===== -->
<section class="sec c-red" id="rules" aria-labelledby="rules-h">
  <div class="wrap">
    <p class="lbl io"><b>05</b><span>RULES</span></p>
    <h2 class="h2 io" id="rules-h"><span class="wipe">注意事項</span></h2>
    <p class="lead rv-b"><J t={jt('次のいずれかに当てはまる作品は、審査の対象外または受賞取り消しとなります。')} keep={KEEP_J} /></p>
    <div class="acc stg">
      <details open style="--c:var(--red)">
        <summary><span class="q">1</span><span class="t">応募できない作品</span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body"><dl>{NG.map((n) => <div><dt>{n.k}</dt><dd><J t={jt(n.s)} keep={KEEP_J} /></dd></div>)}</dl></div>
      </details>
      <details style="--c:var(--purple)">
        <summary><span class="q">2</span><span class="t">応募者へのお願い</span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body"><ul>{ASK.map((s) => <li><J t={jt(s)} keep={KEEP_J} /></li>)}</ul></div>
      </details>
      <details style="--c:var(--blue)">
        <summary><span class="q">3</span><span class="t">主催者からのお断り</span><span class="pm" aria-hidden="true"></span></summary>
        <div class="body"><ul>{DISCLAIM.map((s) => <li><J t={jt(s)} keep={KEEP_J} /></li>)}</ul></div>
      </details>
    </div>
  </div>
</section>

<!-- ===== RIGHTS（権利の扱い） ===== -->
<section class="sec c-purple" id="rights" aria-labelledby="rights-h">
  <div class="wrap">
    <p class="lbl io"><b>06</b><span>RIGHTS</span></p>
    <h2 class="h2 io" id="rights-h"><span class="wipe">権利の扱い</span></h2>
    <div class="copyr rv-z">
      <span class="c" aria-hidden="true">©</span>
      <p><J t={jt('著作権は応募者に残ります。')} keep={KEEP_J} /><small><J t={jt('ハックテイルが公演化・商品化できるのは、契約を結んだ作品だけです。')} keep={KEEP_J} /></small></p>
    </div>
    <ul class="rights stg">
      {RIGHTS.map((r, i) => (
        <li class={r.free ? 'free' : ''} style={`--c:${r.free ? 'var(--ink)' : COLORS[i % 3]}`}><span class="k"><span><J t={jt(r.k)} keep={KEEP_J} /></span></span><span class="s"><em>ハックテイルができること</em><J t={jt(r.s)} keep={KEEP_J} /></span></li>
      ))}
    </ul>
    <ul class="bul stg">{RIGHTS_NOTE.map((s, i) => <li style={`--c:${COLORS[i % 3]}`}><J t={jt(s)} keep={KEEP_J} /></li>)}</ul>
  </div>
</section>

<!-- ===== FAQ ===== -->
<section class="sec c-blue" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <p class="lbl io"><b>07</b><span>FAQ</span></p>
    <h2 class="h2 io" id="faq-h"><span class="wipe">よくある質問</span></h2>
    <div class="acc stg">
      {FAQ.map(([q, a], i) => (
        <details style={`--c:${COLORS[i % 3]}`}>
          <summary><span class="q">Q</span><span class="t"><J t={jt(q)} keep={KEEP_J} /></span><span class="pm" aria-hidden="true"></span></summary>
          <div class="body a"><b>A</b><span><J t={jt(a)} keep={KEEP_J} /></span></div>
        </details>
      ))}
    </div>
  </div>
</section>

<div class="mq light rev" aria-hidden="true"><div class="mq-t">
  {[0, 1].map(() => <div class="mq-h">{Array.from({ length: 4 }, (_, i) => <><span>{CAUSE}</span><svg viewBox="0 0 24 24"><path d={SUIT[SUITS[(i + 2) % 4]]} fill={COLORS[(i + 1) % 3]} /></svg></>)}</div>)}
</div></div>

<!-- ===== ENTRY（黒いフッター） ===== -->
<footer class="foot" id="entry">
  <div class="grid" aria-hidden="true"></div>
  <div class="glow g1" aria-hidden="true"></div><div class="glow g2" aria-hidden="true"></div>
  <div class="wrap">
    <img class="logo" src="/assets/hacktale/logo.png" alt="HACKTALE" width="1100" height="230" loading="lazy">
    <p><span class="sublogo">AWARD #1 — ENTRY</span></p>
    <p class="catch rv"><span>頭脳戦、</span><span>コンゲームの作品が</span><span>もっともっと</span><span>増えて欲しい！</span></p>
    <p class="period rv"><b>募集期間</b><span class="nb">2026年11月25日（水）〜</span><span class="nb">2027年2月28日（日）23:59</span></p>
    <div class="btns stg">
      {ENTRY_URL
        ? <a class="btn main" href={entryHref} {...entryAttrs}><span>応募フォームへ</span><span class="ar"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 2.5 12.5 7 8 11.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span></a>
        : <span class="btn main off" aria-disabled="true"><span>応募フォーム（準備中）</span></span>}
      <a class="btn ln" href="#outline"><span>応募概要を見る</span><span class="ar"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v11M2.5 8 7 12.5 11.5 8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span></a>
      <a class="btn ln" href="/hacktale/"><span>HACKTALE 公式サイト</span><span class="ar"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 2.5 12.5 7 8 11.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span></a>
    </div>
    <nav class="fnav" aria-label="ページ内">
      {NAV.map(([k, jp, h], i) => <a href={h} style={`--c:${['#ff6a80', '#b08bff', '#7f9dff'][i % 3]}`}><i>{pad(i)}</i>{k}<small>{jp}</small></a>)}
    </nav>
    <p class="copyline">主催：{ORGANIZER}{ORGANIZER_CORP && <>（運営：<a href={CORP_URL}>{ORGANIZER_CORP}</a>）</>}<br>公式X：<a href={HT_X_URL} target="_blank" rel="noopener">@hacktalegame</a></p>
  </div>
</footer>

<!-- ===== 画面下に浮く固定バー ===== -->
<nav class="dock" aria-label="応募">
  <div class="dock-in">
    <a href="#outline">応募要項</a>
    <a class="entry" href={entryHref} {...entryAttrs}>応募する<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 2.5 12.5 7 8 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></a>
    <button type="button" class="menu" aria-label="メニュー" aria-expanded="false" aria-controls="drawer"><i></i><i></i></button>
  </div>
</nav>
<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="メニュー">
  <div class="sheet">
    <span class="grip" aria-hidden="true"></span>
    <nav class="fnav" aria-label="メニュー">
      {NAV.map(([k, jp, h], i) => <a href={h} style={`--c:${['#ff6a80', '#b08bff', '#7f9dff'][i % 3]};transition-delay:${0.12 + i * 0.035}s`}><i>{pad(i)}</i>{k}<small>{jp}</small></a>)}
    </nav>
    <p class="cause"><span class="nb">頭脳戦、コンゲームの作品が</span><span class="nb">もっともっと増えて欲しい！</span></p>
  </div>
</div>

<script is:inline>
(function(){
  var d=document.documentElement,rm=d.classList.contains('rm');
  // スクロールで出る
  var els=document.querySelectorAll('.rv,.rv-l,.rv-r,.rv-z,.rv-b,.rv-f,.stg,.io');
  // 数字が増える
  function count(el){var n=Number(el.getAttribute('data-count')),t0=null;if(!n||rm)return;el.textContent='0';
    function step(t){if(!t0)t0=t;var p=Math.min(1,(t-t0)/1300),e=1-Math.pow(1-p,3);el.textContent=String(Math.round(n*e));if(p<1)requestAnimationFrame(step)}
    requestAnimationFrame(step)}
  if('IntersectionObserver' in window && !rm){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');e.target.querySelectorAll('[data-count]').forEach(count);io.unobserve(e.target)}})},{rootMargin:'0px 0px -10% 0px',threshold:.08});
    els.forEach(function(el){io.observe(el)});
  }else{els.forEach(function(el){el.classList.add('in')})}
  // 進み具合の線と、ヒーローの装飾の視差
  var prog=document.querySelector('.prog'),pars=document.querySelectorAll('.hero [data-par]'),tick=false;
  function onScroll(){tick=false;var y=window.scrollY||0,h=document.documentElement.scrollHeight-window.innerHeight;
    prog.style.setProperty('--p',h>0?Math.min(1,y/h):0);
    if(!rm&&y<window.innerHeight*1.2)pars.forEach(function(el){el.style.translate='0 '+(y*Number(el.getAttribute('data-par'))).toFixed(1)+'px'})}
  window.addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(onScroll)}},{passive:true});onScroll();
  // メニュー
  var dr=document.getElementById('drawer'),mb=document.querySelector('.dock .menu');
  function setOpen(o){dr.classList.toggle('open',o);mb.setAttribute('aria-expanded',o?'true':'false');document.body.style.overflow=o?'hidden':''}
  mb.addEventListener('click',function(){setOpen(!dr.classList.contains('open'))});
  dr.addEventListener('click',function(e){if(e.target===dr||e.target.closest('a'))setOpen(false)});
  document.querySelectorAll('.dock a').forEach(function(a){a.addEventListener('click',function(){setOpen(false)})});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&dr.classList.contains('open')){setOpen(false);mb.focus()}});
})();
</script>
</body>
</html>
