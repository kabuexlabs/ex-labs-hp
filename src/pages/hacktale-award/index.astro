.sub .n{display:block;font:500 13px/1.7 var(--go);color:var(--mute)}
.callout{margin-top:24px;padding:20px 22px;border-radius:16px;background:var(--ink);color:#fff;font:700 clamp(15px,4.1vw,17px)/1.9 var(--go);position:relative;overflow:hidden}
.callout::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:var(--grad)}
.callout .mk{color:#fff;background-image:linear-gradient(transparent 62%,rgba(123,59,255,.75) 62%)}

/* ---------- 賞 ---------- */
.grand{position:relative;margin-top:clamp(36px,7vw,56px);color:#fff;padding:clamp(30px,7vw,56px) clamp(22px,6vw,56px);border-radius:24px;border:3px solid transparent;
  background:linear-gradient(var(--ink),var(--ink)) padding-box,linear-gradient(120deg,var(--red),var(--purple),var(--blue),var(--red)) border-box;background-size:auto,300% 100%;animation:edge 6s linear infinite;overflow:hidden}
@keyframes edge{to{background-position:0 0,300% 0}}
.grand .suit{position:absolute;right:-30px;top:-30px;width:190px;height:190px;fill:none;stroke:rgba(255,255,255,.12);stroke-width:.8;animation:spin 40s linear infinite}
.grand .r{position:relative;z-index:1}
.grand .k{font:700 12px/1 var(--en);letter-spacing:.2em;color:#fff;display:inline-block;padding:.7em 1em;border-radius:99px;background:var(--grad)}
.grand h3{font:900 clamp(26px,7.4vw,44px)/1.4 var(--go);letter-spacing:.04em;margin-top:.5em}
.grand .cnt{font:700 13px/1 var(--go);letter-spacing:.1em;opacity:.75;margin-top:.8em}
.money{display:flex;align-items:baseline;flex-wrap:wrap;gap:.2em .5em;margin-top:24px}
.money .lab{font:700 13px/1 var(--go);letter-spacing:.12em;padding:.55em .9em;background:#fff;color:var(--ink);align-self:center;border-radius:99px}
.money .v{font:700 clamp(72px,22vw,140px)/1 var(--en);letter-spacing:-.04em;background:linear-gradient(100deg,#ff5a70,#b08bff 55%,#6f95ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.money .u{font:900 clamp(22px,6vw,34px)/1 var(--go)}
.plus{display:flex;align-items:center;gap:14px;margin:18px 0 0;font:900 clamp(15px,4.2vw,19px)/1.6 var(--go)}
.plus::before{content:"+";flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--red);font:700 24px/1 var(--en);animation:pulse 2.2s ease-in-out infinite}
@keyframes pulse{50%{box-shadow:0 0 0 10px rgba(255,45,74,0);transform:scale(1.08)}0%,100%{box-shadow:0 0 0 0 rgba(255,45,74,.5)}}
.grand ul{margin-top:22px;display:grid;gap:8px}
.grand li{padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.08);font-size:14px;line-height:1.75;display:flex;gap:12px}
.grand li::before{content:"";flex:none;width:8px;height:8px;margin-top:.55em;border-radius:50%;background:var(--c)}
.prizes{display:grid;gap:10px;margin-top:10px}
.prizes>div{background:#fff;border:2px solid var(--c);border-radius:18px;padding:22px 20px;display:grid;grid-template-columns:1fr auto;gap:6px 12px;align-items:center;position:relative;overflow:hidden}
.prizes h4{font:900 20px/1.4 var(--go);letter-spacing:.04em;color:var(--c)}
.prizes .c{grid-column:1;font-size:12px;color:var(--mute);letter-spacing:.08em}
.prizes .m{grid-column:2;grid-row:1;font:700 clamp(30px,8.4vw,40px)/1 var(--en);letter-spacing:-.02em;text-align:right;white-space:nowrap}
.prizes .m small{font:900 14px/1 var(--go);margin-left:.15em}
.prizes .m.none{font:700 13px/1 var(--go);color:var(--mute)}
.prizes .nt{grid-column:1/-1;font-size:13.5px;color:var(--ink2)}
@media (min-width:760px){.prizes{grid-template-columns:repeat(2,1fr);align-items:start}}

/* ---------- 閉じておいて開ける欄 ---------- */
.folds{margin-top:clamp(28px,6vw,44px);display:grid;gap:12px}
.fold{border:2px solid var(--ink);border-radius:18px;background:#fff;overflow:hidden;transition:box-shadow .3s ease,transform .3s ease}
.fold[open]{box-shadow:0 14px 34px rgba(12,12,18,.12)}
.fold summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:14px;padding:18px 18px;font:900 clamp(16px,4.4vw,19px)/1.5 var(--go)}
.fold summary::-webkit-details-marker{display:none}
.fold .ic{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--c);color:#fff;font:700 14px/1 var(--en)}
.fold .t{flex:1}
.fold .hint{flex:none;font:700 11px/1 var(--go);letter-spacing:.08em;color:var(--mute)}
.fold .hint::before{content:"ひらく"}
.fold[open] .hint::before{content:"とじる"}
.pm{flex:none;position:relative;width:30px;height:30px;border-radius:50%;background:var(--ink);transition:transform .4s cubic-bezier(.2,1.3,.4,1),background .3s}
.pm::before,.pm::after{content:"";position:absolute;left:9px;top:14px;width:12px;height:2px;background:#fff;transition:transform .35s ease}
.pm::after{transform:rotate(90deg)}
[open]>summary .pm{transform:rotate(180deg);background:var(--c,var(--ac))}
[open]>summary .pm::after{transform:rotate(0)}
.fold .body{padding:4px 18px 24px}
.js .fold[open] .body{animation:open .5s cubic-bezier(.2,.7,.2,1)}
@keyframes open{from{opacity:0;transform:translateY(-10px)}}
.fold .callout{margin-top:0}
.fold .callout.sp{margin-top:22px;background:var(--soft);color:var(--ink)}
.fold .callout.sp::before{background:var(--purple)}
.fold .lead{margin-top:0;font-size:15px}
.steps{margin-top:22px;counter-reset:st}
.steps li{position:relative;padding:0 0 26px 70px;font:500 14.5px/1.9 var(--go)}
.steps li::before{counter-increment:st;content:"STEP " counter(st);position:absolute;left:0;top:.25em;font:700 10px/1 var(--en);letter-spacing:.08em;color:#fff;background:var(--c);padding:.65em 0;width:56px;text-align:center;border-radius:99px}
.steps li::after{content:"";position:absolute;left:27px;top:2.5em;bottom:4px;width:2px;background:var(--line)}
.steps li:last-child{padding-bottom:0}
.steps li:last-child::after{display:none}
.kv{margin-top:24px;border-top:2px solid var(--ink)}
.fold .kv{margin-top:6px;border-top:0}
.kv>div{display:grid;grid-template-columns:6.6em 1fr;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);font-size:14.5px;line-height:1.8}
.kv dt{font-weight:900;letter-spacing:.04em}
.kv dd{color:var(--ink2)}
@media (min-width:760px){.kv>div{grid-template-columns:12em 1fr;padding:20px 0}}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px}
.three>div{padding:16px 6px;text-align:center;border-radius:14px;background:var(--c);color:#fff}
.three .n{font:700 11px/1 var(--en);letter-spacing:.12em;opacity:.85}
.three .k{font:900 clamp(14px,4vw,19px)/1.4 var(--go);margin-top:.5em}
.three .s{font-size:11px;margin-top:.4em;line-height:1.5;opacity:.9}
.crit li{padding:18px 0;border-bottom:1px solid var(--line)}
.crit li:first-child{padding-top:6px}
.crit .top{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.crit h4{font:900 clamp(16px,4.6vw,19px)/1.5 var(--go)}
.crit .p{font:700 clamp(28px,8vw,36px)/1 var(--en);letter-spacing:-.02em;color:var(--c);white-space:nowrap}
.crit .p small{font:700 12px/1 var(--go);margin-left:.2em;color:var(--mute)}
.bar{height:8px;border-radius:99px;background:var(--soft);margin-top:10px;position:relative;overflow:hidden}
.bar i{position:absolute;inset:0 auto 0 0;border-radius:99px;background:var(--c);width:var(--w)}
.js .fold[open] .bar i{animation:grow 1.2s cubic-bezier(.2,.7,.2,1) both}
@keyframes grow{from{width:0}}
.crit p{font-size:14px;line-height:1.85;color:var(--ink2);margin-top:10px}
.total{display:flex;justify-content:flex-end;align-items:baseline;gap:.5em;margin-top:16px;font:900 13px/1 var(--go);letter-spacing:.08em}
.total b{font:700 44px/1 var(--en);letter-spacing:-.02em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}

/* ---------- 審査員 ---------- */
.judges{margin-top:24px;display:grid;gap:12px}
.judges li{display:flex;align-items:center;gap:18px;padding:18px;border-radius:20px;background:var(--ink);color:#fff;position:relative;overflow:hidden}
.judges li::after{content:"";position:absolute;right:-80px;top:-80px;width:150px;height:150px;border-radius:50%;border:2px dashed rgba(255,255,255,.2);animation:spin 30s linear infinite}
.ph-j{flex:none;position:relative;width:clamp(96px,28vw,132px);aspect-ratio:1;border-radius:50%;padding:4px;background:conic-gradient(var(--red),var(--purple),var(--blue),var(--red));animation:spin 8s linear infinite}
.ph-j img{width:100%;height:100%;object-fit:cover;border-radius:50%;border:3px solid var(--ink);animation:spin 8s linear infinite reverse}
.judges .tx{display:grid;gap:6px;position:relative;z-index:1}
.judges .role{justify-self:start;font:700 10px/1 var(--en);letter-spacing:.2em;padding:.6em .9em;border-radius:99px;background:var(--c)}
.judges .nm{font:900 clamp(22px,6.4vw,30px)/1.3 var(--go);letter-spacing:.04em}
.judges .ti{font:700 13.5px/1.5 var(--go);opacity:.8}
@media (min-width:760px){.judges{grid-template-columns:repeat(2,1fr)}}
@media (min-width:960px){.judges{grid-template-columns:repeat(3,1fr)}.judges li{gap:14px;padding:16px}.ph-j{width:88px}.judges .nm{font-size:22px}.judges .ti{font-size:12.5px}}

/* ---------- 審査の流れ ---------- */
.flow{margin-top:clamp(36px,7vw,56px);position:relative}
.flow li{position:relative;display:grid;grid-template-columns:96px 1fr;gap:2px 16px;padding:0 0 28px 36px}
.flow li::before{content:"";position:absolute;left:3px;top:.4em;width:16px;height:16px;border-radius:50%;background:var(--c);box-shadow:0 0 0 4px color-mix(in srgb,var(--c) 22%,transparent)}
.flow li::after{content:"";position:absolute;left:10px;top:1.7em;bottom:-.3em;width:2px;background:var(--ink);transform-origin:top;transition:transform 1s ease}
.js .flow:not(.in) li::after{transform:scaleY(0)}
.js .flow li{opacity:0;transform:translateX(-20px);transition:opacity .6s ease,transform .6s ease}
.js .flow.in li{opacity:1;transform:none}
.js .flow.in li:nth-child(2){transition-delay:.15s}.js .flow.in li:nth-child(3){transition-delay:.3s}.js .flow.in li:nth-child(4){transition-delay:.45s}.js .flow.in li:nth-child(5){transition-delay:.6s}.js .flow.in li:nth-child(6){transition-delay:.75s}
.flow li:last-child::after{display:none}
.js .flow li.hot::before{animation:ping 2s ease-in-out infinite}
@keyframes ping{50%{box-shadow:0 0 0 12px rgba(255,45,74,0)}}
.flow .d{font:700 15px/1.5 var(--en);letter-spacing:.02em;color:var(--c);grid-row:span 2;white-space:nowrap}
.flow .k{font:900 18px/1.5 var(--go)}
.flow .s{font-size:13.5px;color:var(--mute)}
@media (min-width:900px){
  .flow{display:grid;grid-template-columns:repeat(6,1fr);border-top:2px solid var(--ink)}
  .flow li{display:block;padding:30px 14px 0 0}
  .flow li::before{left:0;top:-9px}
  .flow li::after{display:none}
  .flow .d,.flow .k,.flow .s{display:block}
  .flow .d{margin-bottom:8px}
  .flow .k{font-size:17px}
  .flow .s{margin-top:4px;font-size:13px;line-height:1.7}
}

/* ---------- 注意事項・FAQ ---------- */
.acc{margin-top:26px;display:grid;gap:10px}
.acc details{border-radius:16px;background:var(--soft);transition:background .3s}
.acc details[open]{background:#fff;box-shadow:inset 0 0 0 2px var(--c,var(--ac))}
.acc summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:14px;padding:18px 16px;font:700 clamp(15px,4.1vw,18px)/1.6 var(--go)}
.acc summary::-webkit-details-marker{display:none}
.acc summary .q{flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--c,var(--ac));color:#fff;font:700 14px/1 var(--en)}
.acc summary .t{flex:1}
.acc .body{padding:0 16px 20px 62px;font-size:14.5px;line-height:1.95;color:var(--ink2)}
.acc .body.a{display:flex;gap:14px;padding-left:16px}
.acc .body.a b{flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;border:2px solid var(--c,var(--ac));color:var(--c,var(--ac));font:700 14px/1 var(--en)}
.acc .body ul li{position:relative;padding:10px 0 10px 1.2em;border-top:1px dashed var(--line)}
.acc .body ul li:first-child{border-top:0;padding-top:0}
.acc .body ul li::before{content:"";position:absolute;left:0;top:1.1em;width:7px;height:7px;border-radius:50%;background:var(--c,var(--ac))}
.acc .body ul li:first-child::before{top:.8em}
.acc .body dl>div{padding:12px 0;border-top:1px dashed var(--line)}
.acc .body dl>div:first-child{border-top:0;padding-top:0}
.acc .body dt{font-weight:900;color:var(--ink)}
.js .acc details[open] .body{animation:open .45s ease}
.js .acc details[open] summary .q{animation:qpop .5s cubic-bezier(.2,1.6,.4,1)}
@keyframes qpop{0%{transform:scale(.5) rotate(-40deg)}}

/* ---------- 権利 ---------- */
.copyr{display:flex;align-items:center;gap:18px;margin-top:clamp(32px,7vw,48px);padding:24px 22px;border-radius:20px;background:linear-gradient(120deg,var(--purple),var(--blue));color:#fff}
.copyr .c{flex:none;position:relative;width:62px;height:62px;display:grid;place-items:center;font:700 30px/1 var(--en)}
.copyr .c::before{content:"";position:absolute;inset:0;border-radius:50%;border:2px dashed #fff;animation:spin 14s linear infinite}
.copyr p{font:900 clamp(17px,4.8vw,22px)/1.6 var(--go)}
.copyr p small{display:block;font:500 13px/1.8 var(--go);opacity:.9;margin-top:4px}
.rights{margin-top:12px;display:grid;gap:10px}
.rights li{padding:18px;border-radius:16px;border:1px solid var(--line);display:grid;gap:6px}
.rights .k{font:900 14.5px/1.6 var(--go);display:flex;align-items:center;gap:10px}
.rights .k::before{content:"";width:12px;height:12px;border-radius:3px;background:var(--c);flex:none;transform:rotate(45deg)}
.rights li.free{border:2px solid var(--ink)}
.rights .s{font:500 14.5px/1.85 var(--go);color:var(--ink2)}
.rights .s em{font-style:normal;font-size:11.5px;letter-spacing:.06em;color:var(--mute);display:block}
@media (min-width:760px){.rights li{grid-template-columns:18em 1fr;align-items:center}}
.bul{margin-top:18px}
.bul li{position:relative;padding:8px 0 8px 1.3em;font-size:14px;line-height:1.85;color:var(--ink2)}
.bul li::before{content:"";position:absolute;left:0;top:1.15em;width:7px;height:7px;border-radius:50%;background:var(--c)}

/* ---------- 応募（黒いフッター） ---------- */
.foot{background:var(--ink);color:#fff;padding:clamp(72px,14vw,130px) 0 clamp(56px,10vw,90px);position:relative;overflow:hidden}
.foot .grid{opacity:.7}
.foot .wrap{position:relative;z-index:1}
.foot .logo{height:auto;width:clamp(170px,48vw,280px);filter:invert(1)}
.foot .sublogo{display:inline-block;font:700 12px/1 var(--en);letter-spacing:.18em;margin-top:16px;padding:.7em 1em;border-radius:99px;background:var(--grad)}
.foot .catch{margin-top:40px;font:900 clamp(24px,7vw,46px)/1.5 var(--go);letter-spacing:.02em;background:linear-gradient(90deg,#ff5a70,#b08bff,#6f95ff,#ff5a70);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:edge2 8s linear infinite}
@keyframes edge2{to{background-position:300% 0}}
.foot .catch span{display:block}
.foot .period{margin-top:18px;font:700 14px/1.9 var(--go)}
.foot .period b{display:inline-block;font:700 11px/1 var(--go);letter-spacing:.1em;padding:.6em .9em;border-radius:99px;background:#fff;color:var(--ink);margin-right:.8em;vertical-align:.1em}
.btns{display:grid;gap:10px;margin-top:32px;max-width:520px}
.btn{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 16px 16px 26px;border-radius:99px;text-decoration:none;font:900 16px/1.2 var(--go);letter-spacing:.04em;position:relative;overflow:hidden;white-space:nowrap}
.btn .ar{flex:none;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);transition:transform .4s cubic-bezier(.2,1.3,.4,1)}
.btn .ar svg{width:14px;height:14px}
.btn:hover .ar{transform:translateX(4px) rotate(-45deg)}
.btn.main{background:var(--grad);background-size:200% 100%;color:#fff;animation:hue 4s linear infinite alternate}
.btn.main::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.4) 50%,transparent 65%);transform:translateX(-120%);animation:shine 3.2s ease-in-out infinite}
@keyframes shine{0%,55%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
.btn.ln{color:#fff;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.6)}
.btn.off{cursor:default}
.fnav{margin-top:52px;display:grid;grid-template-columns:1fr 1fr;gap:0 20px;max-width:520px}
.fnav a{display:grid;grid-template-columns:auto 1fr;gap:5px 10px;align-items:baseline;padding:13px 0;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.18);font:700 15px/1.2 var(--en);letter-spacing:.1em}
.fnav a i{font-style:normal;font-size:11px;color:var(--c);grid-row:span 2}
.fnav a small{grid-column:2;font:500 11px/1.2 var(--go);letter-spacing:.04em;opacity:.65}
.fnav a:hover{color:var(--c)}
.copyline{margin-top:44px;font-size:12px;line-height:2;opacity:.85}
.copyline a{text-decoration:underline;text-underline-offset:3px}

/* ---------- 画面下に浮く固定バー ---------- */
.dock{position:fixed;left:0;right:0;bottom:calc(10px + env(safe-area-inset-bottom));z-index:50;display:flex;justify-content:center;padding:0 12px;pointer-events:none}
.dock-in{pointer-events:auto;display:grid;grid-template-columns:1fr 1.3fr 52px;gap:6px;width:min(100%,520px);padding:6px;background:rgba(12,12,18,.9);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-radius:99px;box-shadow:0 12px 34px rgba(12,12,18,.35),inset 0 0 0 1px rgba(255,255,255,.14)}
.js .dock-in{animation:dock .9s cubic-bezier(.2,1.2,.4,1) 1.6s both}
@keyframes dock{0%{transform:translateY(140%)}}
.dock a,.dock button{height:50px;border-radius:99px;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;color:#fff;background:none;border:0;cursor:pointer;font:900 clamp(13px,3.7vw,15px)/1 var(--go);letter-spacing:.04em;white-space:nowrap;position:relative;overflow:hidden}
.dock .entry{background:var(--grad);background-size:200% 100%;animation:hue 4s linear infinite alternate}
.dock .entry::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.4) 50%,transparent 65%);transform:translateX(-120%);animation:shine 3.2s ease-in-out 2s infinite}
.dock .entry svg{width:13px;height:13px}
.dock .menu{background:rgba(255,255,255,.14)}
.dock .menu i{position:absolute;left:17px;width:18px;height:2px;background:#fff;border-radius:2px;transition:transform .35s ease,opacity .2s}
.dock .menu i:nth-child(1){top:19px}.dock .menu i:nth-child(2){top:29px;width:12px}
.dock .menu[aria-expanded="true"] i:nth-child(1){transform:translateY(5px) rotate(45deg)}
.dock .menu[aria-expanded="true"] i:nth-child(2){transform:translateY(-5px) rotate(-45deg);width:18px}
/* 下から出るメニュー */
.drawer{position:fixed;inset:0;z-index:45;background:rgba(12,12,18,.55);visibility:hidden;opacity:0;transition:opacity .4s ease,visibility 0s .5s}
.drawer.open{visibility:visible;opacity:1;transition:opacity .4s ease}
.sheet{position:absolute;left:0;right:0;bottom:0;max-height:88svh;overflow-y:auto;background:var(--ink);color:#fff;border-radius:28px 28px 0 0;padding:14px var(--gut) calc(100px + env(safe-area-inset-bottom));transform:translateY(100%);transition:transform .55s cubic-bezier(.2,.9,.2,1)}
.sheet::before{content:"";position:absolute;left:0;right:0;top:0;height:5px;background:var(--grad)}
.drawer.open .sheet{transform:none}
.sheet .grip{display:block;width:44px;height:4px;border-radius:4px;background:rgba(255,255,255,.3);margin:8px auto 22px}
.sheet .fnav{margin:0 auto;max-width:520px}
.sheet .cause{max-width:520px;margin:22px auto 0;font:900 15px/1.7 var(--go);opacity:.9}
.js .sheet .fnav a{opacity:0;transform:translateY(16px);transition:opacity .45s ease,transform .45s ease,color .2s}
.js .drawer.open .sheet .fnav a{opacity:1;transform:none}
</style>
