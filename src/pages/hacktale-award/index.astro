<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="HACKTALE（ハックテイル）">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(pageLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<meta name="theme-color" content="#0c0c12">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap" rel="stylesheet">
<SiteGuard />
<script is:inline>
(function(){var d=document.documentElement;d.classList.add('js');
if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('rm');})();
</script>
<style is:global>
:root{
  --ink:#0c0c12;--ink2:#34343f;--mute:#70707c;--line:#dcdce4;--paper:#ffffff;--soft:#f3f3f8;
  --red:#ff2d4a;--blue:#2457ff;--purple:#7b3bff;--ac:var(--red);
  --grad:linear-gradient(90deg,var(--red),var(--purple) 50%,var(--blue));
  --en:'Space Grotesk',system-ui,sans-serif;--go:'Zen Kaku Gothic New','Hiragino Sans','Yu Gothic',sans-serif;
  --gut:clamp(20px,6.4vw,64px);
  color-scheme:light;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
html.rm{scroll-behavior:auto}
/* 改行：文節の切れ目（<wbr>）と句読点でだけ折り返す */
body{background:var(--paper);color:var(--ink);font-family:var(--go);font-weight:500;line-height:1.85;letter-spacing:.03em;
  word-break:keep-all;overflow-wrap:anywhere;line-break:strict;
  padding-bottom:calc(84px + env(safe-area-inset-bottom));overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit}
ul,ol{list-style:none}
.en{font-family:var(--en)}
.wrap{width:min(100%,1040px);margin:0 auto;padding:0 var(--gut)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.nb{display:inline-block}
.tbd{display:inline-block;margin-left:.4em;padding:0 .5em;font:700 11px/1.7 var(--go);letter-spacing:.06em;color:#fff;background:var(--red);vertical-align:.15em;border-radius:99px;white-space:nowrap}
.c-red{--ac:var(--red)}.c-blue{--ac:var(--blue)}.c-purple{--ac:var(--purple)}

/* 画面上の進み具合 */
.prog{position:fixed;left:0;top:0;z-index:70;width:100%;height:3px;background:var(--grad);transform-origin:0 50%;transform:scaleX(var(--p,0))}

/* ---------- 見出し ---------- */
.sec{padding:clamp(84px,15vw,150px) 0 0;position:relative}
.lbl{display:inline-flex;align-items:center;gap:12px;font:700 clamp(13px,3.4vw,15px)/1 var(--en);letter-spacing:.18em;color:var(--ink)}
.lbl b{display:grid;place-items:center;min-width:34px;height:34px;padding:0 8px;background:var(--ac);color:#fff;font-weight:700;letter-spacing:.02em;border-radius:8px;transform:rotate(-6deg)}
.lbl::after{content:"";height:2px;width:0;background:var(--ac);transition:width .9s cubic-bezier(.2,.7,.2,1) .35s}
.lbl.in::after{width:40px}
.js .lbl b{transform:rotate(-180deg) scale(0);transition:transform .8s cubic-bezier(.2,1.4,.4,1)}
.js .lbl.in b{transform:rotate(-6deg)}
.js .lbl span{opacity:0;letter-spacing:.5em;transition:opacity .7s ease .15s,letter-spacing .9s cubic-bezier(.2,.7,.2,1) .15s}
.js .lbl.in span{opacity:1;letter-spacing:.18em}
.h2{font:900 clamp(27px,7.4vw,50px)/1.4 var(--go);letter-spacing:.02em;margin-top:.7em;text-wrap:balance}
.h2 .wipe{display:inline-block}
.js .h2 .wipe{clip-path:inset(0 100% 0 0);transform:translateX(-12px);transition:clip-path .9s cubic-bezier(.7,0,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
.js .h2.in .wipe{clip-path:inset(-10% -5% -10% -5%);transform:none}
.js .h2 .wipe:nth-child(2){transition-delay:.14s}.js .h2 .wipe:nth-child(3){transition-delay:.28s}.js .h2 .wipe:nth-child(4){transition-delay:.42s}
.h2 em{font-style:normal;color:var(--ac)}
p,li,dd,dt,summary{text-wrap:pretty}
.lead{font:500 clamp(15px,4vw,17px)/2 var(--go);margin-top:1.4em;color:var(--ink2);max-width:38em}
.mk{background:linear-gradient(transparent 62%,color-mix(in srgb,var(--ac) 30%,transparent) 62%) no-repeat 0 0/100% 100%;font-weight:700;color:var(--ink)}
.js .rv .mk,.js .rv-b .mk{background-size:0 100%;transition:background-size 1s cubic-bezier(.2,.7,.2,1) .6s}
.js .rv.in .mk,.js .rv-b.in .mk{background-size:100% 100%}
.h3{font:900 clamp(19px,5.2vw,25px)/1.5 var(--go);letter-spacing:.03em;margin:clamp(52px,10vw,84px) 0 0;display:flex;flex-wrap:wrap;align-items:center;gap:.3em .7em}
.h3 .en{font:700 11px/1 var(--en);letter-spacing:.16em;color:#fff;background:var(--ink);padding:.6em .8em;border-radius:99px}
.note{font-size:13px;line-height:1.9;color:var(--mute);margin-top:1.2em}

/* ---------- スクロールで出る ---------- */
.js .rv{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
.js .rv-l{opacity:0;transform:translateX(-40px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
.js .rv-r{opacity:0;transform:translateX(40px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
.js .rv-z{opacity:0;transform:scale(.86);transition:opacity .8s ease,transform .9s cubic-bezier(.2,1.3,.4,1)}
.js .rv-b{opacity:0;filter:blur(10px);transition:opacity .9s ease,filter .9s ease}
.js .rv-f{opacity:0;transform:perspective(900px) rotateX(-40deg);transform-origin:50% 0;transition:opacity .8s ease,transform .9s cubic-bezier(.2,.7,.2,1)}
.js .rv.in,.js .rv-l.in,.js .rv-r.in,.js .rv-z.in,.js .rv-f.in{opacity:1;transform:none}
.js .rv-b.in{opacity:1;filter:none}
.js .stg>*{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.js .stg.sl>*{transform:translateX(-32px)}
.js .stg.sz>*{transform:scale(.8)}
.js .stg.sf>*{transform:perspective(800px) rotateY(-50deg);transform-origin:0 50%}
.js .stg.in>*{opacity:1;transform:none}
.js .stg.in>*:nth-child(2){transition-delay:.09s}.js .stg.in>*:nth-child(3){transition-delay:.18s}.js .stg.in>*:nth-child(4){transition-delay:.27s}
.js .stg.in>*:nth-child(5){transition-delay:.36s}.js .stg.in>*:nth-child(6){transition-delay:.45s}.js .stg.in>*:nth-child(7){transition-delay:.54s}
.js .stg.in>*:nth-child(n+8){transition-delay:.63s}
html.rm *{animation:none!important;transition:none!important}
html.rm .rv,html.rm .rv-l,html.rm .rv-r,html.rm .rv-z,html.rm .rv-b,html.rm .rv-f,html.rm .stg>*,html.rm .lbl b,html.rm .lbl span{opacity:1!important;transform:none!important;filter:none!important}
html.rm .lbl b{transform:rotate(-6deg)!important}
html.rm .h2 .wipe{clip-path:none!important;transform:none!important}

/* ---------- ヒーロー（黒地に方眼） ---------- */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;overflow:hidden;background:var(--ink);color:#fff}
.grid{position:absolute;inset:-80px;pointer-events:none;
  background:linear-gradient(90deg,rgba(255,255,255,.09) 1px,transparent 1px) 0 0/64px 64px,linear-gradient(rgba(255,255,255,.09) 1px,transparent 1px) 0 0/64px 64px;
  animation:drift 16s linear infinite}
@keyframes drift{to{transform:translate(64px,64px)}}
.glow{position:absolute;border-radius:50%;pointer-events:none;opacity:.55}
.glow.g1{width:90vw;height:90vw;max-width:720px;max-height:720px;left:-30%;top:-12%;background:radial-gradient(circle,rgba(123,59,255,.7),transparent 62%);animation:float1 13s ease-in-out infinite}
.glow.g2{width:80vw;height:80vw;max-width:640px;max-height:640px;right:-34%;top:26%;background:radial-gradient(circle,rgba(36,87,255,.7),transparent 62%);animation:float2 15s ease-in-out infinite}
.glow.g3{width:70vw;height:70vw;max-width:560px;max-height:560px;left:6%;bottom:-26%;background:radial-gradient(circle,rgba(255,45,74,.6),transparent 62%);animation:float1 17s ease-in-out infinite reverse}
@keyframes float1{50%{transform:translate(8%,6%) scale(1.12)}}
@keyframes float2{50%{transform:translate(-10%,-6%) scale(.9)}}
.suits{position:absolute;inset:0;pointer-events:none}
.suits svg{position:absolute;width:clamp(26px,7vw,46px);height:auto;fill:none;stroke-width:1.4;will-change:transform}
.suits svg:nth-child(1){left:7%;top:19%;stroke:var(--red);animation:bob 6s ease-in-out infinite}
.suits svg:nth-child(2){right:9%;top:15%;stroke:#fff;animation:bob 7s ease-in-out -2s infinite}
.suits svg:nth-child(3){right:7%;bottom:24%;stroke:var(--blue);fill:var(--blue);animation:spin 14s linear infinite}
.suits svg:nth-child(4){left:11%;bottom:19%;stroke:var(--purple);animation:bob 8s ease-in-out -4s infinite}
@keyframes bob{50%{transform:translateY(-16px) rotate(14deg)}}
@keyframes spin{to{transform:rotate(360deg)}}

.hd{position:relative;z-index:3;display:flex;align-items:center;gap:14px;padding:calc(22px + env(safe-area-inset-top)) var(--gut) 0}
.hd img{width:clamp(140px,40vw,220px);height:auto;filter:invert(1)}
.hd .en{font:700 clamp(11px,3vw,13px)/1 var(--en);letter-spacing:.16em;padding:.7em 1em;border-radius:99px;background:var(--grad);background-size:200% 100%;animation:hue 5s linear infinite alternate}
@keyframes hue{to{background-position:100% 0}}
.js .hd{animation:drop .8s cubic-bezier(.2,.7,.2,1) both}
@keyframes drop{0%{opacity:0;transform:translateY(-20px)}}

.copy-wrap{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:28px 0 110px}
.copy{position:relative;font-family:var(--go);font-weight:900;line-height:1;letter-spacing:0;width:min(92vw,800px);--u:min(1vw,8px,calc((100svh - 330px)/96))}
.copy .ln{display:flex;align-items:flex-end;position:relative;white-space:nowrap}
.copy .ln>*{flex:none}
.copy .ln+.ln{margin-top:calc(var(--u)*3)}
.copy .ln1{padding-left:calc(var(--u)*2)}
.copy .ln2{justify-content:flex-end}
.copy .ln3{justify-content:flex-start}
.copy .ln4{justify-content:center}
.copy b{font-weight:900;display:inline-block}
.copy .s{font-weight:700;font-size:calc(var(--u)*6);line-height:1.05;padding:0 .1em .08em;color:rgba(255,255,255,.86)}
.copy .tate{writing-mode:vertical-rl;text-orientation:upright;letter-spacing:-.06em;padding:0 .02em .05em}
.copy .x1{font-size:calc(var(--u)*21)}
.copy .x2{font-size:calc(var(--u)*14.4)}
.copy .x3{font-size:calc(var(--u)*14.4)}
.copy .x4{font-size:calc(var(--u)*9)}
.copy .x5{font-size:calc(var(--u)*9.6)}
.copy .x6{font-size:calc(var(--u)*18)}
.copy .x7{font-size:calc(var(--u)*13);color:var(--red);margin-left:-.18em;transform-origin:50% 100%}
.js .copy .x7{animation:bang 2.4s cubic-bezier(.3,1.6,.5,1) 1.6s infinite}
@keyframes bang{0%,60%,100%{transform:none}70%{transform:translateY(-18%) rotate(8deg) scale(1.1)}80%{transform:translateY(0) rotate(-4deg)}}
/* 色付きの札に載せた言葉 */
.tile{position:relative;z-index:0;padding:.1em .16em .12em;margin:0 .04em}
.tile::before{content:"";position:absolute;inset:0;z-index:-1;background:var(--c);border-radius:.08em;transform:skewX(-7deg) rotate(-1.2deg);transform-origin:0 50%}
.t-blue{--c:var(--blue)}.t-purple{--c:var(--purple)}.t-red{--c:var(--red)}
.js .tile::before{animation:tile .8s cubic-bezier(.7,0,.15,1) both}
.js .ln2 .tile::before{animation-delay:.5s}.js .ln3 .tile::before{animation-delay:.7s}.js .ln4 .tile::before{animation-delay:.9s}
@keyframes tile{0%{transform:skewX(-7deg) rotate(-1.2deg) scaleX(0)}}
/* HACKTALE のロゴと同じ「ずれた切れ目」 */
.cut{position:relative;color:transparent}
.cut::before,.cut::after{content:attr(data-t);position:absolute;left:0;top:0;color:#fff}
.cut::before{clip-path:inset(0 0 54% 0)}
.cut::after{clip-path:inset(46% 0 0 0);transform:translateX(.05em)}
.js .cut::after{animation:slip 5s cubic-bezier(.2,.8,.2,1) 1s infinite}
@keyframes slip{0%{transform:translateX(-.14em)}6%{transform:translateX(.1em)}11%{transform:translateX(.02em)}18%,92%{transform:translateX(.05em)}96%{transform:translateX(.2em)}100%{transform:translateX(-.14em)}}
.ph{position:relative;display:inline-block;overflow:hidden;filter:grayscale(1) contrast(1.1);flex:none}
.ph img{width:100%;height:100%;object-fit:cover}
.ph-hands{width:calc(var(--u)*17);height:calc(var(--u)*11);margin:0 calc(var(--u)*1.6) calc(var(--u)*1.4) 0;border-radius:calc(var(--u)*1.2);box-shadow:0 0 0 2px #fff;transform:rotate(-4deg)}
.ph-hands img{filter:brightness(1.9)}
.ph-dice{width:calc(var(--u)*14);height:calc(var(--u)*14);border-radius:50%;margin:0 0 calc(var(--u)*2.4) calc(var(--u)*1);box-shadow:0 0 0 calc(var(--u)*.5) var(--ink),0 0 0 calc(var(--u)*.9) #fff}
.js .ph-dice{animation:roll 1.1s cubic-bezier(.2,.8,.2,1) .7s both}
@keyframes roll{0%{opacity:0;transform:translateX(60vw) rotate(540deg)}}
.js .ph-hands{animation:pop .8s cubic-bezier(.2,1.4,.4,1) .9s both}
@keyframes pop{0%{opacity:0;transform:scale(.4) rotate(20deg)}}
.js .copy .ln{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}
.js .copy .ln1{animation-delay:.15s}.js .copy .ln2{animation-delay:.3s}.js .copy .ln3{animation-delay:.45s}.js .copy .ln4{animation-delay:.6s}
@keyframes rise{0%{opacity:0;transform:translateY(40px) skewY(4deg)}}

.hero-meta{position:relative;z-index:3;margin-top:clamp(32px,7vw,56px);text-align:center;padding:0 var(--gut)}
.hero-meta .t{font:900 clamp(17px,4.8vw,24px)/1.5 var(--go);letter-spacing:.08em}
.hero-meta .d{margin-top:.6em;font:600 clamp(13px,3.5vw,16px)/1.6 var(--en);letter-spacing:.1em}
.hero-meta .d i{font-style:normal;padding:0 .5em;opacity:.6}
.chips{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:16px}
.chips li{font:700 12px/1 var(--go);letter-spacing:.06em;padding:.75em 1.1em;border-radius:99px;border:1px solid rgba(255,255,255,.5)}
.chips li:nth-child(1){background:var(--red);border-color:var(--red)}
.chips li:nth-child(2){background:var(--purple);border-color:var(--purple)}
.chips li:nth-child(3){background:var(--blue);border-color:var(--blue)}
.js .hero-meta>*{animation:rise .9s cubic-bezier(.2,.7,.2,1) 1s both}
.js .hero-meta .d{animation-delay:1.1s}
.js .chips li{animation:pop .7s cubic-bezier(.2,1.4,.4,1) both}
.js .chips li:nth-child(1){animation-delay:1.3s}.js .chips li:nth-child(2){animation-delay:1.42s}.js .chips li:nth-child(3){animation-delay:1.54s}
.scroll{position:absolute;z-index:3;right:calc(var(--gut) - 8px);top:calc(26px + env(safe-area-inset-top));writing-mode:vertical-rl;display:flex;align-items:center;gap:10px;font:600 10px/1 var(--en);letter-spacing:.3em;color:#fff;text-decoration:none;opacity:.8}
.scroll::after{content:"";width:1px;height:54px;background:linear-gradient(#fff 50%,rgba(255,255,255,.2) 50%) 0 0/100% 200%;animation:sc 1.8s linear infinite}
@keyframes sc{from{background-position:0 100%}to{background-position:0 -100%}}

/* ---------- 流れる帯 ---------- */
.mq{overflow:hidden;background:var(--ink);color:#fff;padding:16px 0;border-top:1px solid rgba(255,255,255,.14)}
.mq.light{background:#fff;color:var(--ink);border:solid var(--ink);border-width:2px 0;margin-top:clamp(84px,15vw,150px)}
.mq-t{display:flex;width:max-content;animation:mq 26s linear infinite}
.mq.rev .mq-t{animation-direction:reverse}
@keyframes mq{to{transform:translateX(-50%)}}
.mq-h{display:flex;align-items:center;flex:none}
.mq-h span{font:900 clamp(18px,5vw,26px)/1 var(--go);letter-spacing:.06em;padding:0 .9em;white-space:nowrap}
.mq-h svg{width:20px;height:20px;flex:none}

/* ---------- メッセージ（紫→青） ---------- */
.msg{position:relative;background:linear-gradient(150deg,#6a2cff 0%,#3b3df5 55%,#1f5cff 100%);color:#fff;overflow:hidden;padding:clamp(88px,16vw,160px) 0 clamp(96px,18vw,170px)}
.msg .wrap{position:relative;z-index:2}
.msg .lbl{color:#fff}.msg .lbl b{background:#fff;color:var(--purple)}.msg .lbl::after{background:#fff}
.msg .para{font:700 clamp(16px,4.5vw,22px)/2.2 var(--go);letter-spacing:.05em;margin-top:2em}
.msg .para span{display:block}
.js .msg .para span{opacity:0;transform:translateX(-24px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.js .msg .para.in span{opacity:1;transform:none}
.msg .last{margin-top:2.4em;display:grid;gap:8px;justify-items:start}
.msg .last span{display:block;font:900 clamp(20px,5.8vw,34px)/1.3 var(--go);letter-spacing:.03em;padding:.35em .55em;background:var(--ink);transform:rotate(-1.5deg)}
.msg .last span:nth-child(2){background:#fff;color:var(--ink);transform:rotate(1deg) translateX(4%)}
.msg .last span i{font-style:normal;color:var(--red)}
.js .msg .last span{clip-path:inset(0 100% 0 0);transition:clip-path .8s cubic-bezier(.7,0,.2,1)}
.js .msg .last.in span{clip-path:inset(-20%)}
.js .msg .last.in span:nth-child(2){transition-delay:.25s}
.chip{position:absolute;z-index:1;right:-38vw;top:4%;width:60vw;max-width:560px;aspect-ratio:1;opacity:.9}
.chip svg{width:100%;height:100%;animation:spin 50s linear infinite}
.chip2{position:absolute;z-index:1;left:-16vw;bottom:-14vw;width:40vw;max-width:340px;aspect-ratio:1;opacity:.5}
.chip2 svg{width:100%;height:100%;animation:spin 70s linear infinite reverse}
@media (min-width:900px){.chip{right:-10vw;top:14%;width:40vw}}

/* ---------- 募集内容 ---------- */
.cond{margin-top:28px;display:grid;gap:12px}
.cond li{display:grid;grid-template-columns:auto 1fr;gap:2px 16px;padding:20px 18px;background:var(--soft);border-radius:16px;position:relative;overflow:hidden}
.cond li::after{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--c)}
.cond .no{grid-row:span 3;font:700 clamp(30px,8vw,42px)/1 var(--en);color:var(--c);min-width:1.5em}
.cond .k{font:700 12px/1.6 var(--go);letter-spacing:.12em;color:var(--mute)}
.cond .s{font:700 clamp(16px,4.4vw,19px)/1.7 var(--go)}
.cond .n{font-size:13px;color:var(--mute)}
.must{display:inline-block;margin-top:18px;font:700 13px/1 var(--go);letter-spacing:.1em;padding:.8em 1.1em;background:var(--ink);color:#fff;border-radius:99px}
.spec{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}
.spec>div{background:#fff;border:2px solid var(--ink);border-radius:16px;padding:18px 16px;display:flex;flex-direction:column;gap:8px}
.spec>div.big{background:var(--c);border-color:var(--c);color:#fff}
.spec dt{font:700 12px/1.4 var(--go);letter-spacing:.12em;opacity:.8}
.spec .num{font:700 clamp(38px,11vw,56px)/1 var(--en);letter-spacing:-.02em;white-space:nowrap}
.spec .num small{display:block;font-size:12px;letter-spacing:.16em;margin-top:6px;opacity:.85}
.spec dd{font-size:14px;line-height:1.7}
.spec>div.wide{grid-column:1/-1}
@media (min-width:760px){.spec{grid-template-columns:repeat(5,1fr)}.spec>div.wide{grid-column:auto}}
.sub{margin-top:24px;display:grid;gap:10px}
.sub li{display:flex;gap:14px;align-items:flex-start;padding:16px;border:1px solid var(--line);border-radius:14px}
.sub .t{flex:none;font:700 12px/1 var(--go);letter-spacing:.1em;padding:.6em .9em;border-radius:99px;border:1.5px solid var(--ink)}
