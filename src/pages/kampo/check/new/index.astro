---
// 受付：顧客識別（会員番号／電話番号／LINE表示名／識別なし）、入力者、保存の同意。
// 舌は薬剤師が観察して担当者画面で入力する（2026-10-25 改修計画 Q5。受付での「舌チェックの担当」の選択は廃止）。
// 同意でセッションを作り、設問1へ。LINE表示名は同名の候補を出してスタッフが選ぶ。
export const prerender = false;
import KampoLayout from '../../../../layouts/KampoLayout.astro';
import consentText from '../../../../data/kampo/consent.md?raw';
import {
  isKvConfigured, createSession, saveCustomer, getCustomer, newId, normalizePhone,
  findCustomerByMember, findCustomerByPhone, findCustomersByLineName, customerLabel, fmtJst,
  type KampoCustomer, type InputBy,
} from '../../../../lib/kampo/store';

const kv = isKvConfigured();
let error = '';
const msg = Astro.url.searchParams.get('msg') ?? '';
let candidates: KampoCustomer[] | null = null;
let posted = { idtype: 'none', ident: '', inputby: 'customer' };

if (Astro.request.method === 'POST' && kv) {
  const form = await Astro.request.formData();
  const get = (k: string) => String(form.get(k) ?? '').trim();
  const action = get('action');
  const idtype = ['member', 'phone', 'line', 'none'].includes(get('idtype')) ? get('idtype') : 'none';
  const ident = get('ident').slice(0, 60);
  const inputBy: InputBy = get('inputby') === 'staff' ? 'staff' : 'customer';
  posted = { idtype, ident, inputby: inputBy };

  const start = async (customer: KampoCustomer | null) => {
    const s = await createSession({ customer, inputBy });
    return Astro.redirect(`/kampo/check/${s.id}/q/1/`, 303);
  };
  const newCustomer = async (fields: Partial<KampoCustomer>) => {
    const c: KampoCustomer = { id: newId(), createdAt: new Date().toISOString(), ...fields };
    await saveCustomer(c);
    return c;
  };

  if (get('consent') !== 'on') {
    error = '保存についての同意をご確認のうえ、チェックを入れてください。';
  } else if (action === 'pick') {
    // LINE表示名の候補から選択（'new' なら新規登録）
    const picked = get('customerId');
    const c = picked === 'new' ? await newCustomer({ lineName: ident }) : await getCustomer(picked);
    if (!c) error = 'お客様の候補を選び直してください。';
    else return await start(c);
  } else if (idtype === 'none') {
    return await start(null);
  } else if (!ident) {
    error = '識別のための番号または名前を入力してください（なければ「識別なし」を選べます）。';
  } else if (idtype === 'member') {
    const no = ident.replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0));
    const c = (await findCustomerByMember(no)) ?? (await newCustomer({ memberNo: no }));
    return await start(c);
  } else if (idtype === 'phone') {
    const digits = normalizePhone(ident);
    if (digits.length < 10 || digits.length > 11) error = '電話番号は10〜11桁の数字で入力してください。';
    else {
      const c = (await findCustomerByPhone(digits)) ?? (await newCustomer({ phone: digits }));
      return await start(c);
    }
  } else if (idtype === 'line') {
    const found = await findCustomersByLineName(ident);
    if (found.length === 0) return await start(await newCustomer({ lineName: ident }));
    candidates = found;
  }
}
---
<KampoLayout title="受付" width="normal">
  <a slot="actions" class="kp-btn ghost small" href="/kampo/staff/">スタッフ画面</a>
  <section class="kp-hero">
    <div class="kp-hero-title"><span>BODY</span><span>CHECK</span><span class="sky">KAMPO</span><small>体質チェック ／ 漢方</small></div>
    <div class="kp-hero-text">
      <p>今のお体の状態やお悩みについての質問に答えると、</p>
      <p>薬剤師が体質と養生、合いそうな漢方薬についてご説明します。</p>
      <p class="kp-note" style="margin-top:14px">所要時間は5〜10分です。スタッフが下の受付を済ませてから、iPad をお客様にお渡しください。舌の状態は、回答のあとに薬剤師が確認します。</p>
    </div>
  </section>
  {msg === 'notfound' && <p class="kp-notice">指定のチェックが見つかりませんでした。新しく始めてください。</p>}
  {!kv && <p class="kp-error">データ保存先（KV）が未設定のため、チェックを始められません。</p>}
  {error && <p class="kp-error">{error}</p>}

  {candidates ? (
    <form method="post" class="kp-panel">
      <h2>LINE表示名「{posted.ident}」に近いお客様が見つかりました</h2>
      <div class="kp-panel-b">
        <input type="hidden" name="action" value="pick">
        <input type="hidden" name="idtype" value="line">
        <input type="hidden" name="ident" value={posted.ident}>
        <input type="hidden" name="inputby" value={posted.inputby}>
        <input type="hidden" name="consent" value="on">
        <p class="kp-note">該当するお客様を選ぶか、新しいお客様として登録してください。</p>
        <div class="kp-radios" style="grid-template-columns:1fr">
          {candidates.map((c, i) => (
            <label class="kp-radio"><input type="radio" name="customerId" value={c.id} checked={i === 0}>{customerLabel(c)}<small style="color:var(--muted);margin-left:auto">登録 {fmtJst(c.createdAt).slice(0, 10)}</small></label>
          ))}
          <label class="kp-radio"><input type="radio" name="customerId" value="new">新しいお客様として登録する</label>
        </div>
        <div class="kp-nav" style="margin-top:32px">
          <div class="kp-nav-pill">
            <a class="tri-l" href="/kampo/check/new/">戻る</a>
            <button class="tri-r" type="submit">この内容で始める</button>
          </div>
        </div>
      </div>
    </form>
  ) : (
    <form method="post" id="newForm">
      <input type="hidden" name="action" value="start">
      <section class="kp-panel">
        <h2>受付（スタッフが入力）</h2>
        <div class="kp-panel-b">
          <p class="kp-h2" style="border:0;padding:0;margin-top:0">お客様の識別</p>
          <div class="kp-radios">
            <label class="kp-radio"><input type="radio" name="idtype" value="member" checked={posted.idtype === 'member'}>会員番号</label>
            <label class="kp-radio"><input type="radio" name="idtype" value="phone" checked={posted.idtype === 'phone'}>電話番号</label>
            <label class="kp-radio"><input type="radio" name="idtype" value="line" checked={posted.idtype === 'line'}>LINE表示名</label>
            <label class="kp-radio"><input type="radio" name="idtype" value="none" checked={posted.idtype === 'none'}>識別なし</label>
          </div>
          <label class="kp-field" id="identField">番号または名前<small>識別なしの場合は空欄</small>
            <input class="kp-input" type="text" name="ident" value={posted.ident} autocomplete="off" placeholder="例: 12345 / 09012345678 / LINEの表示名">
          </label>
          <hr class="kp-rule" style="margin:30px 0">
          <p class="kp-h2" style="border:0;padding:0;margin-top:0">入力する方</p>
          <div class="kp-radios">
            <label class="kp-radio"><input type="radio" name="inputby" value="customer" checked={posted.inputby === 'customer'}>お客様ご本人</label>
            <label class="kp-radio"><input type="radio" name="inputby" value="staff" checked={posted.inputby === 'staff'}>スタッフが聞き取り</label>
          </div>
        </div>
      </section>
      <section class="kp-panel">
        <h2>回答の保存について</h2>
        <div class="kp-panel-b">
          <p style="font-size:15px">{consentText.trim()}</p>
          <label class="kp-check" style="margin-top:18px;font-size:16px"><input type="checkbox" name="consent" id="consent">上記に同意して体質チェックを始める</label>
        </div>
      </section>
      <div style="text-align:center;margin-top:44px">
        <button class="kp-btn start" type="submit" id="startBtn" disabled>START</button>
        <p class="kp-note" style="margin-top:10px">同意にチェックを入れると押せるようになります</p>
      </div>
    </form>
  )}
  <script is:inline>
  (function(){
    var c=document.getElementById('consent'),b=document.getElementById('startBtn');
    if(c&&b){var s=function(){b.disabled=!c.checked};c.addEventListener('change',s);s();}
    var f=document.getElementById('newForm');if(!f)return;
    var ident=f.querySelector('input[name=ident]'),field=document.getElementById('identField');
    var upd=function(){var v=(f.querySelector('input[name=idtype]:checked')||{}).value;var none=v==='none';field.style.opacity=none?'.5':'1';ident.disabled=none;
      ident.inputMode=v==='phone'?'tel':v==='member'?'numeric':'text';};
    Array.prototype.forEach.call(f.querySelectorAll('input[name=idtype]'),function(r){r.addEventListener('change',upd)});upd();
  })();
  </script>
</KampoLayout>
