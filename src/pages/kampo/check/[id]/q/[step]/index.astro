---
// 設問（1画面1問）。回答は1問ごとに保存し、途中離脱しても同じ URL で再開できる。
// 表示する設問と選択肢は flow.ts の walk() が決める（深掘りでは答えた所見を出さない・月経の設問は条件つき）。
// 全部答えたら「回答の確認」へ。患者向け画面には体質の点数・漢方薬の提案を出さない。
// 直ちに対応が必要な選択肢を選ぶと、その場で「すぐに近くのスタッフにお声がけください」を出す（119番の一律表示はしない）。
// 2026-10-28 修正依頼：進み具合は STEP n / 5 で出す（2-4）。妊娠・授乳は「回答せずに次へ」で進める（3-2）。生活習慣は小見出しで区切る（6-1）。
// 2026-10-29 第2弾：
//  - 体質チェックでは、お悩みで「あり」になった項目をチェック済み（変えられない）で出す（2-3）。前の回答と同時にあり得ない選択肢、
//    同じ画面で選んだ選択肢と矛盾する選択肢はグレーで押せない（5-3）。STEP 3 の最初に「お悩みと似た質問もありますが…」（5-2）。
//  - 薬の名前・病名と時期・手術の内容は、選んだら任意の記入欄を出す（6-1・7-1）。漢方薬は候補から選ぶ（ひらがな・漢字・ツムラ番号。6-3）。
//  - 「どれもあてはまらない」は小見出しの外に区切って置く（6.5-1）。確認画面の「修正する」から来たら、直したあと確認画面に戻る（8-2）。
// 2026-10-29 第3弾：記入欄・漢方薬の候補・症状の選択肢は、選んだ選択肢のすぐ下に出す（4・5・6）。最後の設問で進み具合 100%（7）。
//  同じ oneOf の選択肢はどれか1つ（10-4）。受診のおすすめ（refer）の選択肢を選ぶとその場で表示（3-1）。舌のご本人確認ではイラストを出す（11-1）。
// 2026-10-31 第4弾：お悩みで自動チェックされた項目だけでも「次へ」を押せる（0-1。サーバーは「ほかには特にない」を記録）。受診のおすすめは患者画面に出さない（0-2。薬剤師画面のみ）。
//  舌は1ページの中に小見出し（色・形・苔・静脈）と項目別イラストで出す（2-8）。食品アレルギーは選択肢（2-9）、耳鳴りの音の高さは選択肢のすぐ下（2-10）。
// 2026-10-31 第5弾：薬・病気・アレルギー（Question.gate）は「ある／ない」を先に聞き、「ある」のときだけ種類を出す（1-1f）。
//  種類は小さめのボタンを2〜3列、名前の欄はその行のすぐ下に全幅（1-1e）。「その他」「種類がわからない」は区切り線の下（sepBefore）。
//  食品・症状などの追加の選択肢は4〜6列の小さいボタン。短い選択肢の設問も小さめのボタンで横に並べる。
export const prerender = false;
import KampoLayout from '../../../../../../layouts/KampoLayout.astro';
import QMark from '../../../../../../components/kampo/QMark.astro';
import { STEPS, stepOfSection, findingById, formulaByCode, type Option, type Followup } from '../../../../../../lib/kampo/masters';
import { getSession, saveSession, getCustomer, saveCustomer } from '../../../../../../lib/kampo/store';
import { walk, firstUnansweredStep, normalizeAnswer, isAnswered, conflictIn, selectable, sexFromAnswers, ageBandFromAnswers } from '../../../../../../lib/kampo/flow';
import { isUrgent } from '../../../../../../lib/kampo/safety';
import { isLegacy } from '../../../../../../lib/kampo/compute';

const id = Astro.params.id ?? '';
const stepNum = parseInt(Astro.params.step ?? '', 10);
const ret = Astro.url.searchParams.get('ret') === 'confirm';
const qs = ret ? '?ret=confirm' : '';
const s = await getSession(id);
if (!s) return Astro.redirect('/kampo/check/new/?msg=notfound', 303);
if (s.status !== 'in_progress' || isLegacy(s)) return Astro.redirect(`/kampo/check/${s.id}/done/`, 303);
let steps = walk(s.answers).steps;
if (!Number.isInteger(stepNum) || stepNum < 1) return Astro.redirect(`/kampo/check/${s.id}/q/1/`, 303);
const firstOpen = firstUnansweredStep(steps);
if (stepNum > steps.length || stepNum > firstOpen) {
  return Astro.redirect(firstOpen > steps.length ? `/kampo/check/${s.id}/confirm/` : `/kampo/check/${s.id}/q/${firstOpen}/${qs}`, 303);
}
const q = steps[stepNum - 1].q;
let error = '';
const clean = (v: unknown, n = 60) => String(v ?? '').replace(/\s+/g, ' ').trim().slice(0, n);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const skip = q.optional && form.get('skip') === '1';
  const rawIds = [...form.getAll('opt').map(String), ...(form.get('sub') ? [String(form.get('sub'))] : []), ...form.getAll('fu').map(String)];
  let ids = skip ? [] : normalizeAnswer(q, rawIds);
  // お悩みで自動チェックされた項目だけで「次へ」を押したら、ほかには特にない（none）を記録する（第4弾 0-1）
  if (!skip && ids.length === 0 && q.options.some((o) => o.locked)) {
    const none = q.options.find((o) => o.exclusive === 'none' && selectable(o));
    if (none) ids = [none.id];
  }
  const conflict = skip ? null : conflictIn(q, ids);
  if (!skip && !isAnswered(q, ids)) {
    const missGroup = (q.groups ?? []).filter((g) => g.required && !ids.some((x) => q.options.find((o) => o.id === x)?.group === g.id)).map((g) => g.title);
    error = missGroup.length ? `「${missGroup.join('」「')}」を選んでください。`
      : (q.followups ?? []).some((fu) => fu.required && (ids.includes(fu.when) || q.options.find((o) => o.id === fu.when)?.locked)) && ids.length ? 'すぐ下に出ている追加の項目（音の種類など）も選んでください。'
      : q.sub ? '上下それぞれ1つずつ選んでください。'
      : q.gate && ids.includes(q.gate.yes) ? 'あてはまる種類を1つ以上選んでください。' : '1つ以上選んでください。';
  } else if (conflict) {
    error = `「${conflict[0]}」と「${conflict[1]}」は同時に選べません。`;
  } else {
    s.answers[q.id] = ids;
    // 短い記入欄（選んだ選択肢のものだけ残す）
    for (const o of [...q.options, ...(q.followups ?? []).flatMap((fu) => fu.options)]) {
      if (!o.note) continue;
      const v = clean(form.get(`note-${o.id}`));
      if (ids.includes(o.id) && v) s.texts[o.id] = v;
      else delete s.texts[o.id];
    }
    if (q.note) {
      const v = clean(form.get('note-q'), 120);
      const show = ids.some((x) => { const o = q.options.find((y) => y.id === x); return o && !o.exclusive && !(q.note!.except ?? []).includes(o.id); });
      if (show && v) s.texts[q.id] = v;
      else delete s.texts[q.id];
    }
    // 前の回答が変わって表示されなくなった設問の回答は捨てる（判定・安全確認に混ざらないように）
    const w = walk(s.answers);
    const shown = new Set(w.steps.map((x) => x.q.id));
    for (const k of Object.keys(s.answers)) if (!shown.has(k)) delete s.answers[k];
    s.urgent = isUrgent(w);
    // 顧客レコードに性別・年代を控える（履歴画面用）
    if ((q.id === 'A1' || q.id === 'A2') && s.customerId) {
      const c = await getCustomer(s.customerId);
      if (c) { c.sex = sexFromAnswers(s.answers) ?? c.sex; c.ageBand = ageBandFromAnswers(s.answers) ?? c.ageBand; await saveCustomer(c); }
    }
    await saveSession(s);
    steps = walk(s.answers).steps;
    if (ret) {
      // 確認画面から直しに来たとき：答えていない設問（前の回答が変わって増えた設問）があればそこへ、なければ確認画面へ
      const open = firstUnansweredStep(steps);
      return Astro.redirect(open > steps.length ? `/kampo/check/${s.id}/confirm/` : `/kampo/check/${s.id}/q/${open}/${qs}`, 303);
    }
    const idx = steps.findIndex((x) => x.q.id === q.id);
    const nextStep = (idx >= 0 ? idx : stepNum - 1) + 2;
    return Astro.redirect(nextStep > steps.length ? `/kampo/check/${s.id}/confirm/` : `/kampo/check/${s.id}/q/${nextStep}/`, 303);
  }
}

const selected = new Set(s.answers[q.id] ?? []);
const multi = q.type === 'multi';
const hint = multi && !q.groups?.length && !q.gate ? '※あてはまるものをすべて選んでください' : '';
const withImages = q.options.some((o) => o.image);
// STEP 表示：段階の中での位置を進み具合に使う（分母が動いても段階は変わらない）
const stepIdx = stepOfSection(q.section);
const inGroup = steps.filter((x) => stepOfSection(x.q.section) === stepIdx);
const pos = Math.max(0, inGroup.findIndex((x) => x.q.id === q.id));
const progressPct = Math.round((100 * (stepIdx + (pos + 1) / Math.max(1, inGroup.length))) / STEPS.length);
// 同時に選べない選択肢（所見の conflicts）
const conflictsOf = (o: Option) => q.options.filter((b) => b !== o && selectable(b) && (o.findings ?? []).some((f) => (findingById(f)?.conflicts ?? []).some((x) => (b.findings ?? []).includes(x)))).map((b) => b.id);
// 小見出しごとに分ける（小見出しのない選択肢は最後のまとまり。小見出しのある設問では区切り線の下に置く）
const groups: { heading?: string; hint?: string; required?: boolean; gid?: string; kind?: 'gate' | 'gated'; options: Option[] }[] = [];
const gate = q.gate;
if (gate) {
  // 「ある／ない」を先に。「ある」のときだけ種類を出す（第5弾 1-1f）
  groups.push({ kind: 'gate', options: q.options.filter((o) => o.id === gate.yes || o.id === gate.no) });
  groups.push({ kind: 'gated', heading: 'あてはまるものをすべて選んでください', options: q.options.filter((o) => o.id !== gate.yes && o.id !== gate.no) });
} else if (q.groups?.length) {
  // 1ページの中の小見出し（舌：色・色の追加・形・苔・苔の追加・静脈。第4弾 2-8）
  for (const g of q.groups) groups.push({ heading: g.title, hint: g.hint, required: g.required, gid: g.id, options: q.options.filter((o) => o.group === g.id) });
} else {
  for (const o of q.options) {
    const last = groups[groups.length - 1];
    if (last && last.heading === o.heading) last.options.push(o);
    else groups.push({ heading: o.heading, options: [o] });
  }
}
const hasHeadings = groups.some((g) => g.heading) && !q.groups?.length;
const hasIcons = q.options.some((o) => o.icon);
const followups: Followup[] = q.followups ?? [];
// 記入欄・追加の選択肢を選択肢のすぐ下に出す設問は1列
const inline = q.options.some((o) => o.note) || (followups.length > 0 && q.section !== 'complaint');
// 同時に選べない選択肢（所見の conflicts と、設問の excludes）
const exclOf = (o: Option) => q.options.filter((b) => b !== o && (o.excludes?.includes(b.id) || b.excludes?.includes(o.id))).map((b) => b.id);
const colsOf = (opts: Option[], kind?: 'gate' | 'gated') => {
  if (kind === 'gate') return 'cols2 gate';
  if (kind === 'gated') return 'compact cols3 dense';
  if (hasIcons) return 'icons';
  if (inline) return 'one';
  const maxLen = Math.max(...opts.map((o) => o.text.length), 0);
  return withImages ? 'imgs' : maxLen <= 8 && opts.length >= 3 ? 'compact cols4' : maxLen <= 14 && opts.length >= 3 ? 'compact cols3' : '';
};
const fuOf = (o: Option) => followups.filter((f) => f.when === o.id);
// 漢方薬の候補：名前・読み・商品名・ツムラ番号で探す
const pickKey = (o: Option) => { const f = o.formula ? formulaByCode(o.formula) : undefined; return f ? [f.name, f.reading, ...(f.aliases ?? [])].join(' ') : o.text; };
const pickNo = (o: Option) => (o.formula ? formulaByCode(o.formula)?.tsumuraNo ?? '' : '');
const firstConstitution = q.section === 'constitution' && pos === 0;
---
<KampoLayout title={`${STEPS[stepIdx].label} ${q.title}`} width="normal" progress={{ done: progressPct, total: 100 }}>
  <form method="post" id="qform" data-qid={q.id} data-type={q.type} data-sub={q.sub ? '1' : '0'} data-gate-yes={gate?.yes} data-gate-no={gate?.no}>
    <p class="kp-qmeta">STEP {stepIdx + 1} / {STEPS.length}　{STEPS[stepIdx].label}</p>
    {firstConstitution && <p class="kp-qintro">お悩みと似た質問もありますが、体質を見るために皆さまにお聞きしています。お悩みで選んだ項目は、チェックした状態で表示しています。</p>}
    {q.section === 'safety' && <p class="kp-eyebrow" style="letter-spacing:.14em;margin-bottom:4px">安心してご相談いただくための確認です</p>}
    <div class="kp-q"><QMark /><h1 class="kp-qtitle">{q.title}</h1></div>
    {hint && <p class="kp-qhint">{hint}</p>}
    {q.help && <p class="kp-qhelp">{q.help}</p>}
    {error && <p class="kp-error" style="margin:0 0 16px">{error}</p>}
    {groups.map((g) => (
      <>
        {g.heading && <p class="kp-opt-h" data-group-required={g.required ? g.gid : undefined} data-gated={g.kind === 'gated' ? '1' : undefined} hidden={g.kind === 'gated' && !selected.has(gate!.yes)}>{g.heading}{g.hint && <small class="kp-opt-hint">{g.hint}</small>}</p>}
        <div class:list={['kp-opts', colsOf(g.options, g.kind), { 'kp-opts-sep': hasHeadings && !g.heading }]} data-gated={g.kind === 'gated' ? '1' : undefined} hidden={g.kind === 'gated' && !selected.has(gate!.yes)}>
          {g.options.map((o) => {
            const on = o.locked || selected.has(o.id);
            return (
              <>
                {o.sepBefore && <hr class="kp-opt-sep">}
                <label class:list={['kp-opt', { check: multi, none: !!o.exclusive, 'is-on': on, 'has-img': !!o.image, 'has-icon': !!o.icon, locked: !!o.locked, 'is-off': !!o.blocked }]}>
                  <input type={multi ? 'checkbox' : 'radio'} name={selectable(o) ? 'opt' : undefined} value={o.id} checked={on} disabled={!selectable(o)}
                    data-ex={o.exclusive || (o.defer && !o.group) ? '1' : '0'} data-urgent={o.urgent ? '1' : '0'} data-locked={o.locked ? '1' : '0'} data-conf={[...conflictsOf(o), ...exclOf(o)].join(' ')} data-one={o.oneOf ?? ''} data-group={o.group ?? ''} data-gex={o.groupExclusive ? '1' : '0'}>
                  {o.image && <img class="kp-opt-img" src={o.image} alt="" width="160" height="236" loading="lazy">}
                  {o.icon && <img class="kp-opt-icon" src={o.icon} alt="" width="84" height="91" loading="lazy">}
                  <span class="kp-opt-text">{o.text}{o.locked && <small class="kp-opt-lock">お悩みで選んだ項目</small>}{o.blocked && <small class="kp-opt-lock off">{o.blockedText ?? 'ほかの回答と同時には選べません'}</small>}</span>
                </label>
                {o.note && (
                  <label class="kp-notefield" data-for={o.id} hidden={!selected.has(o.id)}>
                    <span>{o.noteLabel ?? `「${o.text}」：何に出ましたか（任意）`}</span>
                    <input class="kp-input" type="text" name={`note-${o.id}`} maxlength="60" value={s.texts[o.id] ?? ''} placeholder={o.notePlaceholder ?? ''} autocomplete="off">
                  </label>
                )}
                {fuOf(o).map((fu) => (
                  <div class:list={['kp-sub', 'kp-fu', 'inline', { picker: fu.picker === 'formulas' }]} data-when={fu.when} data-type={fu.type} data-required={fu.required ? '1' : '0'} hidden={!(selected.has(fu.when) || o.locked)}>
                    <p class="kp-fu-title">{fu.title}</p>
                    {fu.help && <p class="kp-qhelp" style="margin:0 0 12px">{fu.help}</p>}
                    {fu.picker === 'formulas' ? (
                      <>
                        <p class="kp-picked" data-empty="まだ選んでいません"></p>
                        <input class="kp-input kp-picker-q" type="search" placeholder="例：ほちゅう／補中益気湯／41" autocomplete="off" enterkeyhint="search">
                        <div class="kp-opts one kp-picker-list">
                          {fu.options.filter((x) => !x.notfound).map((x) => (
                            <label class:list={['kp-opt', 'check', { 'is-on': selected.has(x.id) }]} data-key={pickKey(x)} data-no={pickNo(x)} hidden={!selected.has(x.id)}>
                              <input type="checkbox" name="fu" value={x.id} checked={selected.has(x.id)} data-ex="0">
                              <span class="kp-opt-text">{x.text}{pickNo(x) && <small class="kp-opt-lock" style="color:var(--muted)">ツムラ {pickNo(x)}</small>}</span>
                            </label>
                          ))}
                        </div>
                        <p class="kp-picker-none" hidden>候補が見つかりません。下の「見つからない（薬剤師に伝える）」を選んでください。</p>
                        <div class="kp-opts one" style="margin-top:12px">
                          {fu.options.filter((x) => x.notfound).map((x) => (
                            <label class:list={['kp-opt', 'check', 'none', { 'is-on': selected.has(x.id) }]}>
                              <input type="checkbox" name="fu" value={x.id} checked={selected.has(x.id)} data-ex="0">
                              <span class="kp-opt-text">{x.text}</span>
                            </label>
                          ))}
                        </div>
                      </>
                    ) : (
                      <div class:list={['kp-opts', fu.options.length >= 8 && Math.max(...fu.options.map((x) => x.text.length)) <= 12 ? 'mini' : 'compact cols3']}>
                        {fu.options.map((x) => (
                          <>
                            <label class:list={['kp-opt', { check: fu.type === 'multi', none: !!x.exclusive, 'is-on': selected.has(x.id) }]}>
                              <input type={fu.type === 'multi' ? 'checkbox' : 'radio'} name="fu" value={x.id} checked={selected.has(x.id)} data-ex={x.exclusive ? '1' : '0'}>
                              <span class="kp-opt-text">{x.text}</span>
                            </label>
                            {x.note && (
                              <label class="kp-notefield" data-for={x.id} hidden={!selected.has(x.id)}>
                                <span>{x.noteLabel ?? `「${x.text}」：内容（任意）`}</span>
                                <input class="kp-input" type="text" name={`note-${x.id}`} maxlength="60" value={s.texts[x.id] ?? ''} autocomplete="off">
                              </label>
                            )}
                          </>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </>
            );
          })}
        </div>
      </>
    ))}
    {q.note && (
      <label class="kp-notefield" data-qnote data-except={(q.note.except ?? []).join(' ')} hidden={![...selected].some((x) => { const o = q.options.find((y) => y.id === x); return o && !o.exclusive && !(q.note!.except ?? []).includes(o.id); })}>
        <span>{q.note.label}</span>
        <input class="kp-input" type="text" name="note-q" maxlength="120" value={s.texts[q.id] ?? ''} placeholder={q.note.placeholder ?? ''} autocomplete="off">
      </label>
    )}
    <p class="kp-alert refer" id="alert-urgent" hidden>すぐに近くのスタッフにお声がけください。回答はこのまま続けられます。</p>
    {q.sub && (
      <div class="kp-sub">
        <div class="kp-q" style="margin-bottom:22px"><QMark /><h2 class="kp-qtitle" style="font-size:26px">{q.sub.title}</h2></div>
        <div class:list={['kp-opts', q.sub.options.length >= 3 ? 'cols3' : '']}>
          {q.sub.options.map((o) => (
            <label class:list={['kp-opt', { 'is-on': selected.has(o.id) }]}>
              <input type="radio" name="sub" value={o.id} checked={selected.has(o.id)}>
              <span class="kp-opt-text">{o.text}</span>
            </label>
          ))}
        </div>
      </div>
    )}
    <hr class="kp-rule" style="margin:44px 0 36px">
    <div class="kp-nav">
      <div class="kp-nav-pill">
        {ret ? <a class="tri-l" href={`/kampo/check/${s.id}/confirm/`}>確認画面へ</a> : stepNum > 1 ? <a class="tri-l" href={`/kampo/check/${s.id}/q/${stepNum - 1}/`}>戻る</a> : <span class="tri-l" aria-disabled="true">戻る</span>}
        <button class="tri-r" type="submit" id="nextBtn" disabled>{ret ? '直して確認画面へ' : '次へ'}</button>
      </div>
    </div>
    {q.optional && <p style="text-align:center;margin-top:22px"><button class="kp-btn ghost small" type="submit" name="skip" value="1" id="skipBtn">回答せずに次へ</button></p>}
  </form>
  <style is:global>
  .kp-opts.imgs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .kp-opts.imgs .kp-opt-img{width:100%;max-width:160px;height:auto;mix-blend-mode:multiply}
  @media(max-width:640px){.kp-opts.imgs{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .kp-qintro{margin:6px 0 18px;padding:12px 16px;background:var(--sky-soft);font-size:15px;line-height:1.9;color:var(--ink-2)}
  .kp-opt-h{font-size:15px;letter-spacing:.14em;color:var(--sky-text);margin:28px 0 4px;padding-bottom:6px;border-bottom:1px solid var(--line)}
  .kp-opt-h:first-of-type{margin-top:8px}
  .kp-opts-sep{margin-top:30px;padding-top:26px;border-top:1px solid var(--line)}
  .kp-opt.locked{cursor:default}
  .kp-opt.is-off{opacity:.4;cursor:not-allowed}
  .kp-opt-lock{display:block;font-size:12px;color:var(--sky-text);letter-spacing:.08em}
  .kp-opt-lock.off{color:var(--muted)}
  .kp-notefield{display:block;margin-top:20px;font-size:15px;color:var(--ink-2)}
  .kp-notefield[hidden],.kp-sub[hidden],.kp-picker-list label[hidden],.kp-picker-none[hidden]{display:none}
  .kp-notefield .kp-input{margin-top:6px}
  .kp-picked{font-size:15px;margin:0 0 10px;color:var(--ink)}
  .kp-picked:empty::before{content:attr(data-empty);color:var(--muted)}
  .kp-picker-list{margin-top:10px;gap:10px}
  .kp-picker-list .kp-opt{min-height:64px}
  .kp-picker-none{margin-top:10px;font-size:14px;color:var(--muted)}
  .kp-fu.inline{margin:6px 0 10px;padding:16px 18px;border:1px solid var(--sky-border);background:var(--sky-mist)}
  .kp-fu-title{font-size:17px;font-weight:500;letter-spacing:.06em;margin:0 0 8px}
  .kp-opts.one>.kp-notefield{margin-top:2px;margin-bottom:8px}
  .kp-opt-hint{display:block;margin-top:4px;font-size:13px;letter-spacing:.04em;color:var(--muted);font-weight:400}
  .kp-opts.icons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .kp-opts.icons .kp-opt{flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;gap:8px;min-height:0;padding:14px 10px}
  .kp-opts.icons .kp-opt-icon{width:84px;height:auto}
  .kp-opts.icons .kp-opt.has-icon:not(.is-on) .kp-opt-icon{opacity:.92}
  @media(max-width:640px){.kp-opts.icons{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .kp-opts>.kp-fu.inline,.kp-opts>.kp-notefield{grid-column:1/-1}
  /* 第5弾 1-1e：小さめのボタン（44px 以上）を横に並べる。名前の欄は選んだ行のすぐ下に全幅（dense で行を詰める） */
  .kp-opts[hidden],.kp-opt-h[hidden]{display:none}
  .kp-opts.gate{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px;max-width:560px}
  .kp-opts.compact{gap:10px 12px}
  .kp-opts.compact .kp-opt{min-height:56px;padding:10px 12px 10px 48px;font-size:16px;letter-spacing:.03em;gap:10px}
  .kp-opts.compact .kp-opt::before{left:14px;width:22px;height:22px;margin-top:-11px}
  .kp-opts.compact .kp-opt::after{left:20px}
  .kp-opts.compact .kp-opt.check::after{left:21px;width:6px;height:12px;margin-top:-8px}
  .kp-opts.dense{grid-auto-flow:row dense}
  .kp-opts.dense>.kp-notefield{margin:0 0 4px;padding:10px 14px;background:var(--sky-mist);border:1px solid var(--sky-border)}
  .kp-opt-sep{grid-column:1/-1;border:0;border-top:1px solid var(--line);margin:10px 0 2px;width:100%}
  .kp-opts.mini{grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:8px}
  .kp-opts.mini .kp-opt{min-height:44px;padding:6px 8px 6px 36px;font-size:15px;letter-spacing:.02em;gap:6px;line-height:1.35}
  .kp-opts.mini .kp-opt::before{left:10px;width:18px;height:18px;margin-top:-9px}
  .kp-opts.mini .kp-opt::after{left:15px;width:8px;height:8px;margin-top:-4px}
  .kp-opts.mini .kp-opt.check::after{left:16px;width:5px;height:10px;margin-top:-7px}
  .kp-fu.inline .kp-opts.compact .kp-opt{min-height:48px}
  @media(max-width:900px){.kp-opts.compact.cols4{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:640px){.kp-opts.compact.cols3,.kp-opts.compact.cols4{grid-template-columns:repeat(2,minmax(0,1fr))}.kp-opts.gate{grid-template-columns:repeat(2,minmax(0,1fr))}.kp-opts.mini{grid-template-columns:repeat(3,minmax(0,1fr))}.kp-opts.compact .kp-opt{font-size:15px}}
  </style>
  <script is:inline>
  (function(){
    var form=document.getElementById('qform');if(!form)return;
    var type=form.dataset.type,hasSub=form.dataset.sub==='1';
    var next=document.getElementById('nextBtn');
    var A=function(sel,root){return Array.prototype.slice.call((root||form).querySelectorAll(sel))};
    var opts=A('input[name=opt]');
    var allIn=A('.kp-opt input');
    var lockedAny=A('input[data-locked="1"]').length>0;
    var subs=A('input[name=sub]');
    var fuBoxes=A('.kp-fu');
    var isEx=function(i){return i.dataset.ex==='1'};
    var gateYes=form.dataset.gateYes||'';
    var byVal=function(v){return allIn.filter(function(i){return i.value===v})[0]};
    // 同じ画面で選んだ選択肢と矛盾する選択肢はグレーで押せない（第2弾 5-3）
    function blockConflicts(){
      var off={};
      opts.forEach(function(i){if(i.checked&&i.dataset.conf)i.dataset.conf.split(' ').forEach(function(x){off[x]=1})});
      opts.forEach(function(i){var b=!!off[i.value]&&!i.checked;i.disabled=b;i.closest('.kp-opt').classList.toggle('is-off',b)});
    }
    // 次へを押せる条件：何か選んでいる（お悩みで自動チェックされた項目も回答済み）＋必須の小見出し・追加の選択がそろっている
    function ready(){
      var checked=opts.filter(function(i){return i.checked});
      if(!(checked.length>0||lockedAny))return false;
      // 「ある」を選んだら種類も1つ以上（第5弾 1-1f）
      if(gateYes&&checked.length===1&&checked[0].value===gateYes)return false;
      if(hasSub&&!subs.some(function(i){return i.checked}))return false;
      var ok=true;
      A('[data-group-required]').forEach(function(h){var g=h.dataset.groupRequired;if(!opts.some(function(i){return i.checked&&i.dataset.group===g}))ok=false});
      fuBoxes.forEach(function(b){if(!b.hidden&&b.dataset.required==='1'&&!A('input[name=fu]',b).some(function(i){return i.checked}))ok=false});
      return ok;
    }
    function sync(){
      if(gateYes){
        var y=byVal(gateYes),on=!!(y&&y.checked);
        A('[data-gated]').forEach(function(el){el.hidden=!on});
        if(!on)A('[data-gated] input').forEach(function(i){if(i.type==='checkbox'||i.type==='radio')i.checked=false});
      }
      var checked=opts.filter(function(i){return i.checked});
      blockConflicts();
      A('.kp-opt input').forEach(function(i){if(i.dataset.locked!=='1')i.closest('.kp-opt').classList.toggle('is-on',i.checked)});
      var el=document.getElementById('alert-urgent');if(el)el.hidden=!checked.some(function(i){return i.dataset.urgent==='1'});
      A('.kp-notefield[data-for]').forEach(function(n){var o=byVal(n.dataset.for);n.hidden=!(o&&o.checked)});
      A('.kp-notefield[data-qnote]').forEach(function(n){var ex=(n.dataset.except||'').split(' ');n.hidden=!checked.some(function(i){return !isEx(i)&&ex.indexOf(i.value)<0})});
      fuBoxes.forEach(function(b){var w=byVal(b.dataset.when);b.hidden=!(w&&(w.checked||w.dataset.locked==='1'));if(b.hidden)A('input[name=fu]',b).forEach(function(i){i.checked=false});renderPicker(b)});
      next.disabled=!ready();
    }
    function exclusive(list,i,isMulti){
      if(!isMulti)return;
      if(i.checked&&isEx(i)){list.forEach(function(o){if(o!==i)o.checked=false})}
      else if(i.checked){list.forEach(function(o){if(isEx(o))o.checked=false})}
    }
    // 漢方薬の候補（ひらがな・カタカナ・漢字・ツムラ番号）
    var hira=function(s){return s.replace(/[ァ-ヶ]/g,function(c){return String.fromCharCode(c.charCodeAt(0)-0x60)})};
    var half=function(s){return s.replace(/[０-９]/g,function(c){return String.fromCharCode(c.charCodeAt(0)-0xfee0)})};
    function renderPicker(b){
      if(!b.classList.contains('picker'))return;
      var q=b.querySelector('.kp-picker-q'),items=A('.kp-picker-list label',b),none=b.querySelector('.kp-picker-none');
      var v=hira(half((q.value||'').trim()).replace(/^(ツムラ|つむら)?\s*(no\.?)?\s*/i,''));
      var shown=0;
      items.forEach(function(l){
        var on=l.querySelector('input').checked;
        var hit=!!v&&(/^\d+$/.test(v)?l.dataset.no===v:hira(l.dataset.key).indexOf(v)>=0);
        var show=on||(hit&&shown<8);if(hit&&!on)shown++;
        l.hidden=!show;
      });
      none.hidden=!(v&&shown===0);
      b.querySelector('.kp-picked').textContent=items.filter(function(l){return l.querySelector('input').checked}).map(function(l){return '✓ '+l.querySelector('.kp-opt-text').firstChild.textContent}).join('　');
    }
    fuBoxes.forEach(function(b){
      var q=b.querySelector('.kp-picker-q');
      if(q){q.addEventListener('input',function(){renderPicker(b)});q.addEventListener('keydown',function(e){if(e.key==='Enter')e.preventDefault()})}
      var list=A('input[name=fu]',b);
      list.forEach(function(i){i.addEventListener('change',function(){exclusive(list,i,b.dataset.type==='multi');if(q&&i.checked){q.value=''}sync()})});
    });
    opts.forEach(function(i){i.addEventListener('change',function(){
      exclusive(opts,i,type==='multi');
      // oneOf：同じ名前の選択肢は、別のものを選ぶと切り替わる（舌の色など）
      if(i.checked&&i.dataset.one)opts.forEach(function(o){if(o!==i&&o.dataset.one===i.dataset.one)o.checked=false});
      // 同じ小見出しの「ふつう」は、同じ小見出しのほかの選択肢と同時に選べない
      if(i.checked&&i.dataset.group)opts.forEach(function(o){if(o!==i&&o.dataset.group===i.dataset.group&&(i.dataset.gex==='1'||o.dataset.gex==='1'))o.checked=false});
      sync();
    })});
    subs.forEach(function(i){i.addEventListener('change',sync)});
    sync();
  })();
  </script>
</KampoLayout>
