---
// 設問（1画面1問）。回答は1問ごとに保存し、途中離脱しても同じ URL で再開できる。
// 表示する設問・選択肢は flow.ts の walk() が決める（回答済みの事項は再質問しない・条件付きの設問）。
// 「特にない」「わからない」「回答しない」はほかの選択肢と同時に選べない。自由記述はない（医薬品は検索・選択式）。
// 緊急・受診勧奨・相談の選択肢を選ぶと、その場で注意を表示する（回答は続けられる）。
// 最後の設問のあとは回答確認へ。?from=confirm で来たときは、保存後に回答確認へ戻る（未回答があればそこへ）。
export const prerender = false;
import KampoLayout from '../../../../../../layouts/KampoLayout.astro';
import QMark from '../../../../../../components/kampo/QMark.astro';
import { SECTION_LABEL } from '../../../../../../lib/kampo/masters';
import { getSession, saveSession, getCustomer, saveCustomer } from '../../../../../../lib/kampo/store';
import { walk, firstUnansweredStep, normalizeAnswer, isAnswered, sexOf, ageBandOf } from '../../../../../../lib/kampo/flow';

const id = Astro.params.id ?? '';
const stepNum = parseInt(Astro.params.step ?? '', 10);
const fromConfirm = Astro.url.searchParams.get('from') === 'confirm';
const s = await getSession(id);
if (!s) return Astro.redirect('/kampo/check/new/?msg=notfound', 303);
if (s.status !== 'in_progress') return Astro.redirect(`/kampo/check/${s.id}/done/`, 303);
let w = walk(s.answers, s.tongueMode);
if (!Number.isInteger(stepNum) || stepNum < 1) return Astro.redirect(`/kampo/check/${s.id}/q/1/`, 303);
const firstOpen = firstUnansweredStep(w.steps);
if (stepNum > w.steps.length || stepNum > firstOpen) {
  return Astro.redirect(firstOpen > w.steps.length ? `/kampo/check/${s.id}/confirm/` : `/kampo/check/${s.id}/q/${firstOpen}/`, 303);
}
const q = w.steps[stepNum - 1].q;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const raw = [...form.getAll('opt').map(String), ...(form.get('sub') ? [String(form.get('sub'))] : [])];
  const ids = normalizeAnswer(q, raw);
  if (!isAnswered(q, ids)) {
    error = q.sub ? '上下それぞれ1つずつ選んでください。' : '1つ以上選んでください。';
  } else {
    s.answers[q.id] = ids;
    // 表示されなくなった設問・選択肢の回答は捨てる（判定・安全性に混ざらないように）
    w = walk(s.answers, s.tongueMode);
    const kept = new Map(w.steps.map((x) => [x.q.id, x.ids]));
    for (const k of Object.keys(s.answers)) {
      const v = kept.get(k);
      if (v?.length) s.answers[k] = v; else delete s.answers[k];
    }
    if ((q.id === 'P1' || q.id === 'P2') && s.customerId) {
      const c = await getCustomer(s.customerId);
      if (c) { c.sex = sexOf(s.answers) ?? c.sex; c.ageBand = ageBandOf(s.answers) ?? c.ageBand; await saveCustomer(c); }
    }
    await saveSession(s);
    const open = firstUnansweredStep(w.steps);
    if (fromConfirm) return Astro.redirect(open > w.steps.length ? `/kampo/check/${s.id}/confirm/` : `/kampo/check/${s.id}/q/${open}/?from=confirm`, 303);
    const idx = w.steps.findIndex((x) => x.q.id === q.id);
    const nextStep = (idx >= 0 ? idx : stepNum - 1) + 2;
    if (nextStep > w.steps.length) return Astro.redirect(`/kampo/check/${s.id}/confirm/`, 303);
    return Astro.redirect(`/kampo/check/${s.id}/q/${nextStep}/`, 303);
  }
}

const selected = new Set(w.steps[stepNum - 1]?.ids ?? s.answers[q.id] ?? []);
const isLast = stepNum === w.steps.length;
const multi = q.type === 'multi';
const hint = multi ? '※複数回答可' : '';
const withImages = q.options.some((o) => o.image);
const dense = !!q.searchable || q.options.length > 14;
const meta = `${SECTION_LABEL[q.section]}${q.domain ? `　${q.domain}` : ''}`;
const maxLen = Math.max(...q.options.map((o) => o.text.length), 0);
const cols = withImages || dense ? '' : maxLen <= 8 && q.options.length >= 3 ? 'cols4' : maxLen <= 14 && q.options.length >= 3 ? 'cols3' : '';
const img = (k: string | undefined) => `/assets/kampo/tongue/${k && k !== 'placeholder' ? k : 'placeholder'}.svg`;
const search = (o: (typeof q.options)[number]) => [o.text, o.kana ?? '', ...(o.aliases ?? [])].join(' ');
---
<KampoLayout title={`Q${stepNum} ${q.title}`} width="normal" progress={{ done: stepNum - 1, total: w.steps.length }}>
  <form method="post" id="qform" data-type={q.type} data-sub={q.sub ? '1' : '0'}>
    <p class="kp-qmeta">{meta}　Q{stepNum} / {w.steps.length}</p>
    {(q.section === 'safety' || q.section === 'redflag') && <p class="kp-eyebrow" style="letter-spacing:.14em;margin-bottom:4px">安心してご相談いただくための確認です</p>}
    <div class="kp-q"><QMark /><h1 class="kp-qtitle">{q.title}</h1></div>
    {hint && <p class="kp-qhint">{hint}{multi && q.options.some((o) => o.exclusive) ? '（「特にない」「わからない」はほかと一緒に選べません）' : ''}</p>}
    {q.help && <p class="kp-qhelp">{q.help}</p>}
    {error && <p class="kp-error" style="margin:0 0 16px">{error}</p>}
    {q.searchable && (
      <div class="kp-search">
        <input type="search" id="qsearch" placeholder="名前の一部を入力（ひらがな・漢字）" autocomplete="off" aria-label="選択肢を絞り込む">
        <small id="qcount"></small>
      </div>
    )}
    <div class:list={['kp-opts', cols, { dense }]}>
      {q.options.map((o) => {
        const on = selected.has(o.id);
        return (
          <label class:list={['kp-opt', { check: multi, none: !!o.exclusive, 'is-on': on, 'has-img': withImages }]} data-search={q.searchable && !o.exclusive ? search(o) : undefined}>
            <input type={multi ? 'checkbox' : 'radio'} name="opt" value={o.id} checked={on} data-ex={o.exclusive ? '1' : '0'} data-alert={o.alert ?? ''}>
            {withImages && !o.exclusive && <img class="kp-opt-img" src={img(o.image)} alt="" width="150" height="186">}
            <span class="kp-opt-text">{o.text}{o.kana && <small class="kana">{o.kana}</small>}</span>
          </label>
        );
      })}
    </div>
    <p class="kp-alert emergency" id="alert-emergency" hidden>この症状がある場合は、回答を中断して、すぐにスタッフにお知らせください。強い症状が続くときは、ためらわずに救急車（119）を呼んでください。</p>
    <p class="kp-alert refer" id="alert-refer" hidden>この症状がある場合は、早めに医療機関の受診をおすすめします。回答はこのまま続けられます。スタッフにもお伝えください。</p>
    <p class="kp-alert consult" id="alert-consult" hidden>あてはまる場合は、医療機関の受診もあわせてご検討ください。薬剤師がお話を伺います。</p>
    {q.sub && (
      <div class="kp-sub">
        <div class="kp-q" style="margin-bottom:22px"><QMark /><h2 class="kp-qtitle" style="font-size:26px">{q.sub.title}</h2></div>
        <div class:list={['kp-opts', q.sub.options.length >= 3 ? 'cols3' : '']}>
          {q.sub.options.map((o) => (
            <label class:list={['kp-opt', { 'is-on': selected.has(o.id) }]}>
              <input type="radio" name="sub" value={o.id} checked={selected.has(o.id)}>
              <span class="kp-opt-text">{o.text}</span>
            </label>
          ))}
        </div>
      </div>
    )}
    <hr class="kp-rule" style="margin:44px 0 36px">
    <div class="kp-nav">
      <div class="kp-nav-pill">
        {stepNum > 1 ? <a class="tri-l" href={`/kampo/check/${s.id}/q/${stepNum - 1}/${fromConfirm ? '?from=confirm' : ''}`}>戻る</a> : <span class="tri-l" aria-disabled="true">戻る</span>}
        <button class="tri-r" type="submit" id="nextBtn" disabled>{fromConfirm ? '回答確認へ' : isLast ? '回答を確認する' : '次へ'}</button>
      </div>
    </div>
  </form>
  <script is:inline>
  (function(){
    var form=document.getElementById('qform');if(!form)return;
    var type=form.dataset.type,hasSub=form.dataset.sub==='1';
    var next=document.getElementById('nextBtn');
    var opts=Array.prototype.slice.call(form.querySelectorAll('input[name=opt]'));
    var subs=Array.prototype.slice.call(form.querySelectorAll('input[name=sub]'));
    var isEx=function(i){return i.dataset.ex==='1'};
    function sync(){
      var checked=opts.filter(function(i){return i.checked});
      opts.forEach(function(i){i.closest('.kp-opt').classList.toggle('is-on',i.checked)});
      subs.forEach(function(i){i.closest('.kp-opt').classList.toggle('is-on',i.checked)});
      ['emergency','refer','consult'].forEach(function(k){var el=document.getElementById('alert-'+k);if(el)el.hidden=!checked.some(function(i){return i.dataset.alert===k})});
      next.disabled=!(checked.length>0&&(!hasSub||subs.some(function(i){return i.checked})));
    }
    opts.forEach(function(i){i.addEventListener('change',function(){
      if(type==='multi'&&i.checked){
        // 排他：「特にない」「わからない」を選んだらほかを外す／ほかを選んだら排他を外す
        if(isEx(i))opts.forEach(function(o){if(o!==i)o.checked=false});
        else opts.forEach(function(o){if(isEx(o))o.checked=false});
      }
      sync();
    })});
    subs.forEach(function(i){i.addEventListener('change',sync)});
    var qs=document.getElementById('qsearch'),cnt=document.getElementById('qcount');
    if(qs){
      var items=Array.prototype.slice.call(form.querySelectorAll('.kp-opt[data-search]'));
      var kata=function(s){return s.replace(/[ァ-ヶ]/g,function(c){return String.fromCharCode(c.charCodeAt(0)-0x60)})};
      var f=function(){var v=kata(qs.value.trim().toLowerCase());var n=0;
        items.forEach(function(el){var inp=el.querySelector('input');var hit=!v||kata(el.dataset.search.toLowerCase()).indexOf(v)>=0||inp.checked;el.classList.toggle('is-hidden',!hit);if(hit)n++});
        if(cnt)cnt.textContent=v?n+'件':'';};
      qs.addEventListener('input',f);f();
    }
    sync();
  })();
  </script>
</KampoLayout>
