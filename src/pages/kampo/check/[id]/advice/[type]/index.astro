---
// 改善アドバイス（来店客向け）：特徴／生活養生（心・食・動・休）／おすすめのツボ／あなたへの一言／監修者。
export const prerender = false;
import KampoLayout from '../../../../../../layouts/KampoLayout.astro';
import AdviceBlock from '../../../../../../components/kampo/AdviceBlock.astro';
import { isTypeKey, TYPE_DEFS } from '../../../../../../lib/kampo/masters';
import { getSession } from '../../../../../../lib/kampo/store';

const s = await getSession(Astro.params.id ?? '');
if (!s) return Astro.redirect('/kampo/check/new/?msg=notfound', 303);
const type = Astro.params.type ?? '';
if (!isTypeKey(type)) return Astro.redirect(`/kampo/check/${s.id}/result/`, 303);
if (s.status === 'in_progress') return Astro.redirect(`/kampo/check/${s.id}/`, 303);
const pct = s.scores?.pct[type];
const d = TYPE_DEFS[type];
const others = [...(s.scores?.mainTypes ?? []), ...(s.scores?.subTypes ?? [])].filter((t) => t !== type);
---
<KampoLayout title={`${d.name}の改善アドバイス`} width="normal">
  <a slot="actions" class="kp-btn ghost small no-print" href={`/kampo/check/${s.id}/result/`}>結果に戻る</a>
  <button slot="actions" class="kp-btn ghost small no-print" type="button" onclick="window.print()">印刷</button>
  <AdviceBlock type={type} answers={s.answers} pct={pct} />
  <div class="kp-card no-print" style="margin-top:16px;background:var(--accent-soft);border-color:#CFE3DB">
    <h2 style="font-size:18px">薬剤師があなたに合う漢方をご提案します</h2>
    <p style="font-size:15px;margin-top:6px">養生とあわせて、体質と安全確認の内容に合う漢方を薬剤師がご提案します。気になることはお気軽にご相談ください。</p>
  </div>
  <div class="no-print" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px">
    <a class="kp-btn ghost" href={`/kampo/check/${s.id}/result/`}>結果に戻る</a>
    {others.map((t) => <a class="kp-btn ghost" href={`/kampo/check/${s.id}/advice/${t}/`}>{TYPE_DEFS[t].name}のアドバイスを見る</a>)}
  </div>
</KampoLayout>
