---
// 来店客向け結果：体質チェック結果（8軸レーダー・点数と段階・主体質／副体質）、改善アドバイスへの導線、
// おすすめの漢方薬（主訴ごとの二段階選定。理由は ①主訴 ②体質 ③他の候補との比較 ④服用前の確認）。
// 受診勧奨があるときは漢方薬を出さない。安全確認の内容そのものは出さない。
// 右下の隠しボタン（長押し）からスタッフ画面へ。
export const prerender = false;
import KampoLayout from '../../../../../layouts/KampoLayout.astro';
import RadarChart from '../../../../../components/kampo/RadarChart.astro';
import AdviceBlock from '../../../../../components/kampo/AdviceBlock.astro';
import ResultTabs from '../../../../../components/kampo/ResultTabs.astro';
import { TYPES, TYPE_DEFS, FORMULAS } from '../../../../../lib/kampo/masters';
import { LEVEL_LABEL } from '../../../../../lib/kampo/scoring';
import { typeIconSvg } from '../../../../../lib/kampo/icons';
import { getSession, saveSession, fmtJst } from '../../../../../lib/kampo/store';
import { visibleQuestions, firstUnansweredStep } from '../../../../../lib/kampo/flow';
import { finalize, computeSession } from '../../../../../lib/kampo/compute';
import { selectFormulas, customerPicks } from '../../../../../lib/kampo/recommend';

const s = await getSession(Astro.params.id ?? '');
if (!s) return Astro.redirect('/kampo/check/new/?msg=notfound', 303);
if (s.status === 'in_progress') {
  const vis = visibleQuestions(s.answers, s.tongueMode);
  const step = firstUnansweredStep(vis, s.answers, s.texts);
  if (step <= vis.length) return Astro.redirect(`/kampo/check/${s.id}/q/${step}/`, 303);
  finalize(s);
  await saveSession(s);
}
// 旧版のスコア（五臓なし）は再計算して保存し直す
if (!s.scores || !s.scores.organPct) { finalize(s); await saveSession(s); }
const r = s.scores!;
const flags = s.safetyFlags ?? computeSession(s).safetyFlags;
const cards = [...r.mainTypes.map((t) => ({ t, rank: '主体質' })), ...r.subTypes.map((t) => ({ t, rank: '副体質' }))];
const staffHref = `/kampo/staff/pin/?next=${encodeURIComponent(`/kampo/staff/session/${s.id}/`)}`;
const sel = selectFormulas(r, s.answers, s.texts, flags, FORMULAS, s.tongueOverride);
const { picks, messages } = customerPicks(sel, r);
const name = (t: (typeof TYPES)[number]) => TYPE_DEFS[t].name;
const summary = r.isBalanced
  ? '大きな偏りは見られません。今の生活を続けながら、季節の変わり目にもう一度チェックしてみましょう。'
  : `あなたの体質は、${r.mainTypes.map(name).join('・')}の傾向がもっとも強いようです。${r.subTypes.length ? `${r.subTypes.map(name).join('・')}の傾向も見られます。` : ''}体質の偏りは、生活養生と、体質に合った漢方薬で整えていくことができます。`;
---
<KampoLayout title="体質チェックの結果" width="normal">
  <button slot="actions" class="kp-btn pink small no-print" type="button" onclick="window.print()">結果を印刷する</button>
  <ResultTabs id={s.id} active="result" adviceType={r.mainTypes[0]} />

  <section id="result">
    <h1 class="kp-h1">あなたの<span class="sky">体質チェック結果</span></h1>
    <p class="kp-result-lede">{summary}</p>
    <p class="kp-note" style="margin-top:6px">{fmtJst(s.completedAt ?? s.startedAt)}　{s.customerLabel}</p>

    <div class="kp-panel">
      <h2>あなたの体質バランス</h2>
      <div class="kp-panel-b kp-result-top">
        <RadarChart pct={r.pct} />
        <ul class="kp-scores">
          {TYPES.map((t) => (
            <li class:list={[{ main: r.mainTypes.includes(t) }]}>
              <span class="nm">{TYPE_DEFS[t].name}</span>
              <span class="bar"><i style={`width:${r.pct[t]}%`}></i></span>
              <span class="pct">{r.pct[t]}<small>点</small></span>
              <span class="lv">{LEVEL_LABEL[r.level[t]]}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="kp-note" style="padding:0 32px 22px">点数は「その体質の特徴にどれくらい当てはまったか」の割合です。20点未満＝バランス、20点〜＝傾向あり、40点〜＝注意、60点〜＝強い。</p>
    </div>

    {r.isBalanced ? (
      <div class="kp-panel"><h2>体質の偏り</h2><div class="kp-panel-b"><p style="font-size:16px">大きな偏りは見られません。今の生活を維持し、季節の変わり目に再度チェックをおすすめします。</p></div></div>
    ) : cards.map(({ t, rank }) => {
      const d = TYPE_DEFS[t];
      return (
        <article class="kp-panel kp-tcard">
          <h2>{rank}：{d.name}（{d.reading}）</h2>
          <div class="kp-panel-b kp-tcard-b">
            <div class="kp-tcard-side">
              <div class="kp-ring"><small>{rank}</small><b>{r.pct[t]}</b><small>点・{LEVEL_LABEL[r.level[t]]}</small></div>
              <span class="kp-tcard-icon" style={`color:${d.color}`}><Fragment set:html={typeIconSvg(t, 36)} /></span>
            </div>
            <div>
              <h3 class="kp-tcard-h">{d.headline}</h3>
              <p class="kp-tcard-p">{d.summary}</p>
              <ul class="kp-sym">{d.symptoms.map((x) => <li>{x}</li>)}</ul>
              <a class="kp-btn ghost small no-print" href={`/kampo/check/${s.id}/advice/${t}/`} style="margin-top:18px">改善アドバイスを見る</a>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  {!r.isBalanced && (
    <section id="advice" class="kp-panel no-print">
      <h2>改善アドバイス</h2>
      <div class="kp-panel-b kp-advice-links">
        {cards.map(({ t, rank }) => (
          <a href={`/kampo/check/${s.id}/advice/${t}/`}><small>{rank}</small>{TYPE_DEFS[t].name}の生活養生・ツボ</a>
        ))}
      </div>
    </section>
  )}

  <section id="kampo">
    <h2 class="kp-h1" style="margin-top:56px">あなたに<span class="sky">おすすめの漢方薬</span></h2>
    {sel.refer ? (
      <div class="kp-panel"><h2>薬剤師がお話を伺います</h2><div class="kp-panel-b"><p style="font-size:16px">回答の内容から、まず薬剤師が詳しくお話を伺います。漢方薬のご提案はそのあとで行います。</p></div></div>
    ) : (
      <>
        <p class="kp-result-lede">気になっている症状（主訴）に使われる漢方薬の中から、あなたの体質にもっとも合うものを選びました。体質に合うものがない場合は、無理におすすめしません。</p>
        {picks.map((p, i) => (
          <article class="kp-panel kp-fml">
            <h2>「{p.groups.map((g) => g.label).join('」「')}」のお悩みに</h2>
            <div class="kp-panel-b">
              <div class="kp-fml-head">
                <div class="kp-ring kp-ring-sm"><small>おすすめ</small><b>{i + 1}</b></div>
                <div>
                  <p class="kp-fml-name">{p.candidate.name}<small>（{p.candidate.reading}）</small></p>
                  {p.status === 'check'
                    ? <p class="kp-chip check" style="margin-top:6px">薬剤師が確認してからのご提案です</p>
                    : <p class="kp-chip ok" style="margin-top:6px">体質に合うおすすめ</p>}
                </div>
              </div>
              <ol class="kp-reasons">
                <li><h3>主訴の候補になった理由</h3><p class="pre">{p.reasons.complaint}</p><p class="kp-note">効能・効果（承認された内容）：{p.candidate.formula.efficacy}</p></li>
                <li><h3>あなたの体質に合う理由</h3>
                  <ul>{p.reasons.constitution.map((x) => <li>{x}</li>)}</ul>
                  <p class="kp-fml-sub"><b>使用目標</b>{p.reasons.useTarget}</p>
                  <p class="kp-fml-sub"><b>漢方の考え方</b>{p.reasons.action}</p>
                </li>
                <li><h3>ほかの候補との比較</h3><ul>{p.reasons.comparison.map((x) => <li>{x}</li>)}</ul></li>
                <li><h3>服用前に確認すること</h3><ul>{p.reasons.cautions.map((x) => <li>{x}</li>)}</ul></li>
              </ol>
            </div>
          </article>
        ))}
        {messages.map((m) => (
          <div class="kp-panel"><h2>「{m.label}」のお悩み</h2><div class="kp-panel-b"><p style="font-size:15.5px">{m.text}</p></div></div>
        ))}
        {sel.otherComplaint && (
          <div class="kp-panel"><h2>その他のお悩み</h2><div class="kp-panel-b"><p style="font-size:15.5px">「{sel.otherComplaint}」については、薬剤師がお話を伺います。</p></div></div>
        )}
      </>
    )}
    <div class="kp-panel" style="background:var(--sky-mist)">
      <h2>薬剤師が詳しくご提案します</h2>
      <div class="kp-panel-b"><p style="font-size:15px">ここに挙げた漢方薬は、回答と体質チェックの結果から選んだものです。服用中のお薬や体調を確かめたうえで、薬剤師が最終的にご提案します。結果画面はそのままスタッフにお渡しください。</p></div>
    </div>
  </section>

  <p class="kp-foot"><span>このチェックは体質の傾向を知るためのもので、病気の診断を行うものではありません。</span><span>ESSENCE薬局</span></p>

  {/* 印刷時の2ページ目：主体質の改善アドバイス */}
  {!r.isBalanced && r.mainTypes.map((t) => (
    <div class="print-only page-break"><AdviceBlock type={t} answers={s.answers} pct={r.pct[t]} /></div>
  ))}

  <style is:global>
  .kp-result-lede{font-size:16px;line-height:2.1;margin-bottom:6px}
  .kp-result-top{display:grid;grid-template-columns:minmax(0,440px) 1fr;gap:32px;align-items:center}
  .kp-scores{list-style:none;margin:0;padding:0;display:grid;gap:12px}
  .kp-scores li{display:grid;grid-template-columns:64px 1fr 64px 64px;align-items:center;gap:14px;font-size:15px}
  .kp-scores .bar{height:8px;background:#EEEEEE;border-radius:4px;overflow:hidden}
  .kp-scores .bar i{display:block;height:100%;background:var(--sky);border-radius:4px}
  .kp-scores li.main .nm,.kp-scores li.main .pct{color:var(--sky-text);font-weight:500}
  .kp-scores .pct{text-align:right;font-family:var(--en);font-size:20px;font-variant-numeric:tabular-nums}
  .kp-scores .pct small{font-family:'Noto Sans JP',sans-serif;font-size:11px;margin-left:2px;color:var(--muted)}
  .kp-scores .lv{font-size:12px;color:var(--muted);text-align:right}
  .kp-tcard-b{display:grid;grid-template-columns:200px 1fr;gap:30px;align-items:start}
  .kp-tcard-side{display:flex;flex-direction:column;align-items:center;gap:12px}
  .kp-tcard-icon{display:flex}
  .kp-tcard-h{font-size:22px;letter-spacing:.08em;margin-bottom:10px}
  .kp-tcard-p{font-size:15.5px;line-height:2}
  .kp-sym{list-style:none;margin:16px 0 0;padding:16px 20px;background:var(--panel);font-size:15px;line-height:2}
  .kp-sym li::before{content:'・'}
  .kp-advice-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
  .kp-advice-links a{position:relative;display:block;padding:16px 40px 16px 20px;border:1px solid var(--line);text-decoration:none;color:var(--ink);font-size:16px}
  .kp-advice-links a small{display:block;font-size:12px;color:var(--sky-text);letter-spacing:.12em}
  .kp-advice-links a::after{content:'';position:absolute;right:20px;top:50%;width:9px;height:9px;margin-top:-5px;border:solid var(--sky);border-width:1.5px 1.5px 0 0;transform:rotate(45deg)}
  .kp-fml-head{display:flex;gap:24px;align-items:center;margin-bottom:10px}
  .kp-ring-sm{width:104px;height:104px;margin:6px}
  .kp-ring-sm b{font-size:36px}
  .kp-fml-name{font-size:26px;letter-spacing:.08em}
  .kp-fml-name small{font-size:14px;color:var(--muted);margin-left:6px;letter-spacing:.04em}
  .kp-reasons{list-style:none;counter-reset:r;margin:18px 0 0;padding:0;display:grid;gap:0}
  .kp-reasons>li{counter-increment:r;position:relative;padding:20px 0 20px 54px;border-top:1px solid var(--line)}
  .kp-reasons>li::before{content:counter(r);position:absolute;left:0;top:20px;width:34px;height:34px;border-radius:50%;background:#9A9A9A;color:#fff;font-family:var(--en);font-size:17px;display:flex;align-items:center;justify-content:center}
  .kp-reasons h3{font-size:17px;font-weight:500;letter-spacing:.08em;margin-bottom:6px}
  .kp-reasons p,.kp-reasons li li{font-size:15px;line-height:1.95}
  .kp-reasons p.pre{white-space:pre-line}
  .kp-reasons ul{margin:4px 0 0;padding-left:1.2em}
  .kp-fml-sub{margin-top:8px;background:var(--panel);padding:10px 14px}
  .kp-fml-sub b{display:inline-block;min-width:7em;font-weight:500;color:var(--ink-2);margin-right:8px}
  @media(max-width:760px){.kp-result-top,.kp-tcard-b{grid-template-columns:1fr}.kp-scores li{grid-template-columns:52px 1fr 52px 56px;gap:10px}.kp-fml-head{gap:14px}.kp-fml-name{font-size:21px}.kp-reasons>li{padding-left:44px}}
  @media print{.kp-result-top{grid-template-columns:230px 1fr;gap:14px}.kp-tcard-b{grid-template-columns:120px 1fr;gap:14px}.kp-tcard .kp-ring{width:96px;height:96px}.kp-tcard .kp-ring b{font-size:30px}.kp-tcard-p,.kp-sym{font-size:11px;line-height:1.7}.kp-sym{padding:8px 12px;margin-top:8px}.kp-reasons p,.kp-reasons li li{font-size:10.5px;line-height:1.6}.kp-reasons>li{padding:8px 0 8px 40px}.kp-fml{break-inside:auto}}
  </style>

  <button class="kp-hidden-btn no-print" id="staffBtn" type="button" data-href={staffHref} aria-label="スタッフ用（長押し）" tabindex="-1"></button>
  <script is:inline>
  (function(){var b=document.getElementById('staffBtn');if(!b)return;var t=null;var go=function(){location.href=b.dataset.href};
    b.addEventListener('pointerdown',function(e){e.preventDefault();clearTimeout(t);t=setTimeout(go,1200)});
    ['pointerup','pointercancel','pointerleave'].forEach(function(ev){b.addEventListener(ev,function(){clearTimeout(t)})});
    b.addEventListener('contextmenu',function(e){e.preventDefault()});
  })();
  </script>
</KampoLayout>
