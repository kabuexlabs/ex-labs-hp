---
// お客様用の結果画面（薬剤師が PIN の後ろで開き、お客様に見せて説明する。2026-10-31 第4弾 0-2 で復活）：
//   薬剤師の入力・確認が終わったあと、薬剤師画面の「お客様用の結果を表示」から開く（問診の直後にお客様が一人で見る形にはしない）。
//   タイプは6つ（気虚・血虚・気滞・瘀血・水滞・水不足（陰虚））のレーダーチャートと解説。寒熱は別の枠。
//   漢方薬の名前・候補、受診のおすすめ、点数は出さない（漢方・受診のおすすめは薬剤師画面だけ。薬剤師が口頭で伝える）。
//   養生は「全員共通の土台（胃腸・睡眠・冷やさない）」＋「主タイプ＋主訴に関係するタイプ」の最大2つ分（3-9）。
export const prerender = false;
import KampoLayout from '../../../../../layouts/KampoLayout.astro';
import AdviceBlock from '../../../../../components/kampo/AdviceBlock.astro';
import RadarChart from '../../../../../components/kampo/RadarChart.astro';
import ResultTabs from '../../../../../components/kampo/ResultTabs.astro';
import { axisDef, axisName, TYPES, FOUNDATION, type TypeKey } from '../../../../../lib/kampo/masters';
import { resultCards, CARD_RANK_LABEL, COMBO_LABEL, LEVEL_LABEL, advicePlan, relatedTypeOf, toAxis } from '../../../../../lib/kampo/scoring';
import { typeIconSvg } from '../../../../../lib/kampo/icons';
import { getSession, saveSession, fmtJst } from '../../../../../lib/kampo/store';
import { finalize, isLegacy, computeSession } from '../../../../../lib/kampo/compute';

const s = await getSession(Astro.params.id ?? '');
if (!s) return Astro.redirect('/kampo/staff/?msg=notfound', 303);
if (s.status === 'in_progress' && !isLegacy(s)) return Astro.redirect(`/kampo/check/${s.id}/`, 303);
if (!s.scores && !isLegacy(s)) { finalize(s); await saveSession(s); }
const legacy = isLegacy(s);
// 観察（舌・顔色・爪）を入れたあとの最新のスコアで出す（旧版は保存時のスコア）
const c = legacy ? null : computeSession(s);
const r = c ? c.scores : s.scores;
const plan = c && r ? advicePlan(r, relatedTypeOf(c.w.state, r.mainTypes as string[])) : null;
const print = Astro.url.searchParams.get('print') === '1';
const name = (t: string) => axisName(t);
const pctOf = (k: string) => { if (!r) return 0; const e = Object.entries(r.pct).find(([key]) => toAxis(key) === k); return e ? e[1] : 0; };
const levelOf = (k: string) => { if (!r) return ''; const e = Object.entries(r.level ?? {}).find(([key]) => toAxis(key) === k); return e ? LEVEL_LABEL[e[1]] : ''; };
const radarPct = Object.fromEntries(TYPES.map((t) => [t, pctOf(t)])) as Record<TypeKey, number>;
// 解説カード：新版は養生に使う最大2タイプ、旧版は主・併存
const cards = legacy ? (r ? resultCards(r).filter((x) => x.rank !== 'thermal') : []) : (plan?.types ?? []).map((t, i) => ({ t, rank: i === 0 ? 'main' : 'sub' as 'main' | 'sub' }));
const thermal = r ? (['cold', 'heat'] as const).filter((t) => pctOf(t) >= 20).sort((a, b) => pctOf(b) - pctOf(a)) : [];
const others = (r && !legacy ? TYPES.filter((t) => pctOf(t) >= 20 && !(plan?.types ?? []).includes(t)).sort((a, b) => pctOf(b) - pctOf(a)) : []) as TypeKey[];
const combos = (r?.combos ?? []).map((x) => COMBO_LABEL[x]);
const thermalText = thermal.length ? `寒熱では、${thermal.map(name).join('・')}の傾向があります。` : '';
const comboText = combos.length ? `${combos.join('・')}の組み合わせが見られます。` : '';
const mainNames = cards.filter((x) => x.rank === 'main').map((x) => name(x.t)).join('・');
const summary = !r
  ? '体質の結果がありません。'
  : r.isBalanced
    ? `大きな偏りは見られません。${thermalText}今の生活を続けながら、季節の変わり目にもう一度チェックしてみましょう。`
    : plan && plan.tied.length >= 2
      ? `${plan.tied.map(name).join('・')}の傾向が同じくらい見られます。${thermalText}${comboText}体質の偏りは、毎日の養生で整えていくことができます。`
      : `あなたの体質は、${mainNames}の傾向がもっとも見られます。${cards.filter((x) => x.rank === 'sub').length ? `${cards.filter((x) => x.rank === 'sub').map((x) => name(x.t)).join('・')}の傾向もあります。` : ''}${thermalText}${comboText}体質の偏りは、毎日の養生で整えていくことができます。`;
const adviceTypes = cards.map((x) => x.t) as TypeKey[];
---
<KampoLayout title="体質チェックの結果" width="normal">
  <a slot="actions" class="kp-btn ghost small no-print" href={`/kampo/staff/session/${s.id}/`}>担当者画面へ</a>
  <button slot="actions" class="kp-btn pink small no-print" type="button" onclick="window.print()">印刷する</button>
  <ResultTabs id={s.id} active="result" adviceType={cards[0]?.t ?? thermal[0]} />

  <section id="result">
    <h1 class="kp-h1">あなたの<span class="sky">体質チェック結果</span></h1>
    <p class="kp-result-lede">{summary}</p>
    <p class="kp-note" style="margin-top:6px">{fmtJst(s.completedAt ?? s.startedAt)}　{s.customerLabel}</p>

    {r && !legacy && (
      <div class="kp-panel kp-radar-panel">
        <h2>体質バランス</h2>
        <div class="kp-panel-b kp-radar-b">
          <div class="kp-radar-wrap"><RadarChart pct={radarPct} size={340} title="体質バランス" showScore={false} /></div>
          <ul class="kp-levels">
            {TYPES.map((t) => (
              <li class:list={[{ on: pctOf(t) >= 20 }]}><span class="nm"><i style={`background:${axisDef(t).color}`}></i>{name(t)}</span><span class="lv">{levelOf(t)}</span></li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {r?.isBalanced && (
      <div class="kp-panel"><h2>体質の偏り</h2><div class="kp-panel-b"><p style="font-size:16px">大きな偏りは見られません。今の生活を維持し、季節の変わり目に再度チェックをおすすめします。</p></div></div>
    )}
    {cards.map(({ t, rank }) => {
      const d = axisDef(t);
      return (
        <article class="kp-panel kp-tcard">
          <h2>{CARD_RANK_LABEL[rank]}：{d.name}（{d.reading}）</h2>
          <div class="kp-panel-b kp-tcard-b">
            <div class="kp-tcard-side">
              <span class="kp-tcard-icon" style={`color:${d.color}`}><Fragment set:html={typeIconSvg(t, 56)} /></span>
            </div>
            <div>
              <h3 class="kp-tcard-h">{d.headline}</h3>
              <p class="kp-tcard-p">{d.summary}</p>
              <ul class="kp-sym">{d.symptoms.map((x) => <li>{x}</li>)}</ul>
              <a class="kp-btn ghost small no-print" href={`/kampo/check/${s.id}/advice/${t}/`} style="margin-top:18px">改善アドバイスを見る</a>
            </div>
          </div>
        </article>
      );
    })}
    {others.length > 0 && (
      <div class="kp-panel"><h2>ほかに見られる傾向</h2>
        <div class="kp-panel-b"><ul class="kp-others">{others.map((t) => <li><b>{name(t)}</b>（{levelOf(t)}）<span>{axisDef(t).headline}</span></li>)}</ul>
          <p class="kp-note" style="margin-top:8px">ほかの傾向は、まず下の土台と上のタイプの養生を続けながら、薬剤師と相談して整えていきます。</p></div>
      </div>
    )}
    {thermal.length > 0 && (
      <div class="kp-panel"><h2>寒熱の傾向</h2>
        <div class="kp-panel-b"><ul class="kp-others">{thermal.map((t) => <li><b>{name(t)}</b>（{levelOf(t)}）<span>{axisDef(t).headline ?? ''}</span></li>)}</ul>
          <div class="no-print" style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">{thermal.map((t) => <a class="kp-btn ghost small" href={`/kampo/check/${s.id}/advice/${t}/`}>{name(t)}の改善アドバイス</a>)}</div></div>
      </div>
    )}
  </section>

  {/* 全員共通の土台 */}
  {!legacy && (
    <section id="foundation" class="kp-panel">
      <h2>{FOUNDATION.title}</h2>
      <div class="kp-panel-b">
        <p style="font-size:15.5px;line-height:2">{FOUNDATION.lead}</p>
        <div class="kp-found">{FOUNDATION.items.map((x, i) => <div class="kp-found-i"><span class="kp-found-n">{i + 1}</span><div><b>{x.label}</b><p>{x.text}</p></div></div>)}</div>
      </div>
    </section>
  )}

  {(adviceTypes.length > 0 || thermal.length > 0) && (
    <section id="advice" class="kp-panel no-print">
      <h2>改善アドバイス</h2>
      <div class="kp-panel-b kp-advice-links">
        {adviceTypes.map((t, i) => (
          <a href={`/kampo/check/${s.id}/advice/${t}/`}><small>{i === 0 ? CARD_RANK_LABEL.main : CARD_RANK_LABEL.sub}</small>{name(t)}の生活養生・ツボ</a>
        ))}
        {thermal.map((t) => <a href={`/kampo/check/${s.id}/advice/${t}/`}><small>寒熱</small>{name(t)}の生活養生・ツボ</a>)}
      </div>
    </section>
  )}
  <div class="kp-panel" style="background:var(--sky-mist)">
    <h2>ご相談について</h2>
    <div class="kp-panel-b"><p style="font-size:15px">気になる症状については、体調やお薬の内容を確かめたうえで、薬剤師がご相談をお受けします。</p></div>
  </div>

  <p class="kp-foot"><span>このチェックは体質の傾向を知るためのもので、病気の診断を行うものではありません。体質の判定方法は検証中の暫定版です。</span><span>ESSENCE薬局</span></p>

  {/* 印刷時の2ページ目：土台＋体質別の改善アドバイス（最大2つ） */}
  {adviceTypes.map((t) => (
    <div class="print-only page-break"><AdviceBlock type={t} answers={s.answers} types={adviceTypes} /></div>
  ))}
  {print && <script is:inline>window.addEventListener('load',function(){setTimeout(function(){window.print()},300)})</script>}
  <style is:global>
  .kp-result-lede{font-size:16px;line-height:2.1;margin-bottom:6px}
  .kp-radar-b{display:grid;grid-template-columns:minmax(0,380px) 1fr;gap:28px;align-items:center}
  .kp-levels{list-style:none;margin:0;padding:0;display:grid;gap:8px}
  .kp-levels li{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 14px;background:var(--panel);font-size:15px;color:var(--muted)}
  .kp-levels li.on{background:var(--sky-soft);color:var(--ink)}
  .kp-levels .nm{display:flex;gap:8px;align-items:center}
  .kp-levels .nm i{width:10px;height:10px;border-radius:3px;display:block}
  .kp-levels .lv{font-size:13px;letter-spacing:.08em}
  .kp-others{list-style:none;margin:0;padding:0;display:grid;gap:8px;font-size:15px}
  .kp-others li span{display:block;font-size:13.5px;color:var(--ink-2);margin-top:2px}
  .kp-found{display:grid;gap:12px;margin-top:14px}
  .kp-found-i{display:grid;grid-template-columns:36px 1fr;gap:14px;align-items:start;background:var(--panel);padding:14px 18px}
  .kp-found-n{width:32px;height:32px;border-radius:50%;background:var(--sky-strong);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--en)}
  .kp-found-i p{font-size:15px;line-height:1.9;margin-top:2px}
  .kp-tcard-b{display:grid;grid-template-columns:200px 1fr;gap:30px;align-items:start}
  .kp-tcard-side{display:flex;flex-direction:column;align-items:center;gap:12px}
  .kp-tcard-icon{display:flex}
  .kp-tcard-h{font-size:22px;letter-spacing:.08em;margin-bottom:10px}
  .kp-tcard-p{font-size:15.5px;line-height:2}
  .kp-sym{list-style:none;margin:16px 0 0;padding:16px 20px;background:var(--panel);font-size:15px;line-height:2}
  .kp-sym li::before{content:'・'}
  .kp-advice-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
  .kp-advice-links a{position:relative;display:block;padding:16px 40px 16px 20px;border:1px solid var(--line);text-decoration:none;color:var(--ink);font-size:16px}
  .kp-advice-links a small{display:block;font-size:12px;color:var(--sky-text);letter-spacing:.12em}
  .kp-advice-links a::after{content:'';position:absolute;right:20px;top:50%;width:9px;height:9px;margin-top:-5px;border:solid var(--sky-strong);border-width:1.5px 1.5px 0 0;transform:rotate(45deg)}
  @media(max-width:760px){.kp-radar-b,.kp-tcard-b{grid-template-columns:1fr}}
  @media print{.kp-radar-b{grid-template-columns:230px 1fr;gap:14px}.kp-tcard-b{grid-template-columns:120px 1fr;gap:14px}.kp-tcard-p,.kp-sym{font-size:11px;line-height:1.7}.kp-sym{padding:8px 12px;margin-top:8px}.kp-found-i p{font-size:11px;line-height:1.7}.kp-found-i{padding:8px 12px}}
  </style>
</KampoLayout>
