---
// 体質の説明画面（薬剤師が来店客に説明するときに使う。PIN 必須＝middleware の kampoGuard）。
// 気血水6証のレーダー（強く示唆の暫定カットオフに対する割合）・体質の特徴・寒熱の傾向・養生アドバイスへの導線。
// 漢方薬は出さない（仕様書 §25⑪：患者画面で処方を自動推奨しない）。判定基準は草案である旨を必ず表示する。
// 主証が保留のときは、断定せず「傾向が見られる体質（確認中）」として出す。
export const prerender = false;
import KampoLayout from '../../../../../layouts/KampoLayout.astro';
import RadarChart from '../../../../../components/kampo/RadarChart.astro';
import AdviceBlock from '../../../../../components/kampo/AdviceBlock.astro';
import ResultTabs from '../../../../../components/kampo/ResultTabs.astro';
import { TYPE_DEFS, type AdviceKey, type PatternId } from '../../../../../lib/kampo/masters';
import { typeIconSvg } from '../../../../../lib/kampo/icons';
import { getSession, fmtJst, isV2 } from '../../../../../lib/kampo/store';
import { computeSession } from '../../../../../lib/kampo/compute';

const s = await getSession(Astro.params.id ?? '');
if (!s) return Astro.redirect('/kampo/staff/?msg=notfound', 303);
if (!isV2(s)) return Astro.redirect(`/kampo/staff/session/${s.id}/`, 303);
if (s.status === 'in_progress') return Astro.redirect(`/kampo/staff/session/${s.id}/`, 303);
const r = computeSession(s);
const a = r.assessment;
const determined = a.primary.status === 'determined';
const main: PatternId[] = determined ? [a.primary.patternId!] : a.primary.candidates.slice(0, 2);
const sub: PatternId[] = determined ? a.coexisting : [];
const thermal: AdviceKey[] = a.coldHeat.status === 'cold' ? ['cold'] : a.coldHeat.status === 'heat' ? ['heat'] : [];
const cards: { k: AdviceKey; rank: string }[] = [
  ...main.map((k) => ({ k, rank: determined ? '主な体質' : '傾向が見られる体質（確認中）' })),
  ...sub.map((k) => ({ k, rank: 'あわせて見られる体質' })),
  ...thermal.map((k) => ({ k, rank: '寒熱の傾向' })),
];
const axes = a.patterns.map((p) => ({ label: p.name, value: Math.round((100 * p.score) / p.cutoff.strong), color: TYPE_DEFS[p.id].color }));
const name = (k: AdviceKey) => TYPE_DEFS[k].name;
const summary = cards.length === 0
  ? '今回の回答からは、はっきりした体質の偏りは読み取れませんでした。気になることは薬剤師にお話しください。'
  : determined
    ? `回答からは「${main.map(name).join('・')}」の傾向がもっとも強く見られます。${sub.length ? `「${sub.map(name).join('・')}」の傾向もあわせて見られます。` : ''}`
    : `回答からは「${main.map(name).join('・')}」の傾向が見られますが、判断の材料がまだ少ないため、薬剤師がお話を伺いながら確認します。`;
const adviceKeys = cards.map((c) => c.k);
const back = `/kampo/staff/session/${s.id}/`;
---
<KampoLayout title="体質の説明" width="normal">
  <a slot="actions" class="kp-btn ghost small no-print" href={back}>担当者画面へ戻る</a>
  <button slot="actions" class="kp-btn pink small no-print" type="button" onclick="window.print()">印刷する</button>
  <ResultTabs id={s.id} active="result" adviceType={adviceKeys[0]} />

  <section id="result">
    <h1 class="kp-h1">あなたの<span class="sky">体質の傾向</span></h1>
    <p class="kp-result-lede">{summary}</p>
    <p class="kp-note" style="margin-top:6px">{fmtJst(s.completedAt ?? s.startedAt)}　{s.customerLabel}</p>

    <div class="kp-panel">
      <h2>体質バランス</h2>
      <div class="kp-panel-b kp-result-top">
        <RadarChart axes={axes} />
        <ul class="kp-scores">
          {a.patterns.map((p) => (
            <li class:list={[{ main: main.includes(p.id) }]}>
              <span class="nm">{p.name}</span>
              <span class="bar"><i style={`width:${Math.min(100, Math.round((100 * p.score) / p.cutoff.strong))}%`}></i></span>
              <span class="lv">{p.level === 'strong' ? '強く見られる' : p.level === 'candidate' ? '見られる' : p.level === 'low' ? 'わずか' : '—'}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="kp-note" style="padding:0 32px 22px">グラフは「その体質の特徴にどれくらい当てはまったか」の目安です。判定の基準は開発中の暫定のもので、病気の診断ではありません。</p>
    </div>

    {cards.length === 0 ? (
      <div class="kp-panel"><h2>体質の傾向</h2><div class="kp-panel-b"><p style="font-size:16px">はっきりした偏りは読み取れませんでした。季節の変わり目などに、もう一度チェックしてみてください。</p></div></div>
    ) : cards.map(({ k, rank }) => {
      const d = TYPE_DEFS[k];
      return (
        <article class="kp-panel kp-tcard">
          <h2>{rank}：{d.name}（{d.reading}）</h2>
          <div class="kp-panel-b kp-tcard-b">
            <div class="kp-tcard-side">
              <span class="kp-tcard-icon" style={`color:${d.color}`}><Fragment set:html={typeIconSvg(k, 56)} /></span>
            </div>
            <div>
              <h3 class="kp-tcard-h">{d.headline}</h3>
              <p class="kp-tcard-p">{d.summary}</p>
              <ul class="kp-sym">{d.symptoms.map((x) => <li>{x}</li>)}</ul>
              <a class="kp-btn ghost small no-print" href={`/kampo/check/${s.id}/advice/${k}/`} style="margin-top:18px">養生アドバイスを見る</a>
            </div>
          </div>
        </article>
      );
    })}
    {(a.coldHeat.status === 'mixed' || a.coldHeat.notes.some((n) => n.includes('併存'))) && (
      <div class="kp-panel"><h2>冷えとほてり</h2><div class="kp-panel-b"><p style="font-size:15.5px">冷えとほてりの両方の回答がありました。どこが・いつ冷えたりほてったりするかを、薬剤師が詳しく伺います。</p></div></div>
    )}
  </section>

  <div class="kp-panel" style="background:var(--sky-mist)">
    <h2>このあと薬剤師がご説明します</h2>
    <div class="kp-panel-b"><p style="font-size:15px">体質の傾向は、回答から整理した目安です。服用中のお薬や体調を伺ったうえで、養生や漢方薬について薬剤師がご説明します。</p></div>
  </div>
  <p class="kp-foot"><span>このチェックは体質の傾向を知るためのもので、病気の診断を行うものではありません。判定の基準は開発中の暫定版です。</span><span>ESSENCE薬局</span></p>

  {/* 印刷時の2ページ目以降：養生アドバイス */}
  {adviceKeys.map((k) => <div class="print-only page-break"><AdviceBlock type={k} answers={s.answers} /></div>)}

  <style is:global>
  .kp-result-lede{font-size:16px;line-height:2.1;margin-bottom:6px}
  .kp-result-top{display:grid;grid-template-columns:minmax(0,440px) 1fr;gap:32px;align-items:center}
  .kp-scores{list-style:none;margin:0;padding:0;display:grid;gap:12px}
  .kp-scores li{display:grid;grid-template-columns:64px 1fr 100px;align-items:center;gap:14px;font-size:15px}
  .kp-scores .bar{height:8px;background:#EEEEEE;border-radius:4px;overflow:hidden}
  .kp-scores .bar i{display:block;height:100%;background:var(--sky);border-radius:4px}
  .kp-scores li.main .nm{color:var(--sky-text);font-weight:500}
  .kp-scores .lv{font-size:12.5px;color:var(--muted);text-align:right}
  .kp-tcard-b{display:grid;grid-template-columns:140px 1fr;gap:30px;align-items:start}
  .kp-tcard-side{display:flex;flex-direction:column;align-items:center;gap:12px;padding-top:8px}
  .kp-tcard-icon{display:flex}
  .kp-tcard-h{font-size:22px;letter-spacing:.08em;margin-bottom:10px}
  .kp-tcard-p{font-size:15.5px;line-height:2}
  .kp-sym{list-style:none;margin:16px 0 0;padding:16px 20px;background:var(--panel);font-size:15px;line-height:2}
  .kp-sym li::before{content:'・'}
  @media(max-width:760px){.kp-result-top,.kp-tcard-b{grid-template-columns:1fr}.kp-scores li{grid-template-columns:52px 1fr 80px;gap:10px}}
  @media print{.kp-result-top{grid-template-columns:230px 1fr;gap:14px}.kp-tcard-b{grid-template-columns:80px 1fr;gap:14px}.kp-tcard-p,.kp-sym{font-size:11px;line-height:1.7}.kp-sym{padding:8px 12px;margin-top:8px}}
  </style>
</KampoLayout>
