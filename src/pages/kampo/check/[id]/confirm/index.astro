---
// 回答の確認：答えた内容を STEP ごと（問診中の表示と同じ STEP 名）に質問の順で見直し、「修正する」で各設問に戻れる。
// 直したらその場で確認画面に戻る（?ret=confirm。前の回答が変わって増えた設問があれば先にそれを聞く。2026-10-29 第2弾 8-1・8-2）。
// 「この内容で送信する」で回答を確定する。
export const prerender = false;
import KampoLayout from '../../../../../layouts/KampoLayout.astro';
import { STEPS, stepOfSection } from '../../../../../lib/kampo/masters';
import { getSession, saveSession } from '../../../../../lib/kampo/store';
import { walk, firstUnansweredStep } from '../../../../../lib/kampo/flow';
import { finalize, isLegacy } from '../../../../../lib/kampo/compute';

const s = await getSession(Astro.params.id ?? '');
if (!s) return Astro.redirect('/kampo/check/new/?msg=notfound', 303);
if (s.status !== 'in_progress' || isLegacy(s)) return Astro.redirect(`/kampo/check/${s.id}/done/`, 303);
const { steps } = walk(s.answers);
const open = firstUnansweredStep(steps);
if (open <= steps.length) return Astro.redirect(`/kampo/check/${s.id}/q/${open}/`, 303);
if (Astro.request.method === 'POST') {
  finalize(s);
  await saveSession(s);
  return Astro.redirect(`/kampo/check/${s.id}/done/`, 303);
}
const textOf = (st: (typeof steps)[number]) => {
  if (st.skipped) return '回答なし（薬剤師が口頭で確認します）';
  const main = [...st.q.options.filter((o) => o.locked).map((o) => `${o.text}（お悩みで選択）`), ...st.ids.filter((id) => st.q.options.some((o) => o.id === id) || st.q.sub?.options.some((o) => o.id === id)).map((id) => {
    const o = [...st.q.options, ...(st.q.sub?.options ?? [])].find((x) => x.id === id)!;
    return o.text + (s.texts[id] ? `（${s.texts[id]}）` : '');
  })];
  const extra = (st.q.followups ?? []).map((fu) => {
    const picked = fu.options.filter((o) => st.ids.includes(o.id)).map((o) => o.text + (s.texts[o.id] ? `（${s.texts[o.id]}）` : ''));
    return picked.length ? `${fu.title}：${picked.join('、')}` : '';
  }).filter(Boolean);
  const note = s.texts[st.q.id] ? [`${st.q.note?.label.replace(/（.*?）$/, '') ?? '記入'}：${s.texts[st.q.id]}`] : [];
  return [main.join('、'), ...extra, ...note].filter(Boolean);
};
// STEP ごとにまとめる（質問の順）
const byStep = STEPS.map((x, k) => ({ label: `STEP ${k + 1}　${x.label}`, items: steps.map((st, i) => ({ st, n: i + 1 })).filter(({ st }) => stepOfSection(st.q.section) === k) })).filter((g) => g.items.length);
---
<KampoLayout title="回答の確認" width="normal" progress={{ done: 100, total: 100 }}>
  <h1 class="kp-h1">回答の<span class="sky">確認</span></h1>
  <p class="kp-result-lede" style="font-size:16px;line-height:2">内容をご確認ください。直したいところは「修正する」から戻れます。</p>
  <div class="kp-panel">
    <div class="kp-panel-b">
      {byStep.map((g) => (
        <section class="kp-confirm-step">
          <h2 class="kp-confirm-h">{g.label}</h2>
          <ol class="kp-confirm">
            {g.items.map(({ st, n }) => (
              <li>
                <p class="kp-confirm-q">{st.q.title}</p>
                <p class="kp-confirm-a">{textOf(st).map((t, k) => (k ? <><br><small>{t}</small></> : t))}</p>
                <a class="kp-confirm-edit" href={`/kampo/check/${s.id}/q/${n}/?ret=confirm`}>修正する</a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
  <form method="post" style="text-align:center;margin-top:36px">
    <button class="kp-btn" type="submit" style="min-width:280px">この内容で送信する</button>
  </form>
  <style is:global>
  .kp-confirm{list-style:none;margin:0;padding:0}
  .kp-confirm li{display:grid;grid-template-columns:1fr auto;gap:4px 16px;padding:14px 0;border-top:1px solid var(--line)}
  .kp-confirm li:first-child{border-top:0}
  .kp-confirm-q{font-size:15px;color:var(--ink-2);grid-column:1}
  .kp-confirm-step+.kp-confirm-step{margin-top:26px}
  .kp-confirm-h{font-size:16px;font-weight:700;letter-spacing:.12em;color:#4A4A4A;background:var(--sky-band);padding:10px 16px;margin:0 0 4px}
  .kp-confirm-a small{font-size:14px;color:var(--ink-2)}
  .kp-confirm-a{font-size:16px;grid-column:1}
  .kp-confirm-edit{grid-column:2;grid-row:1/3;align-self:center;font-size:14px;white-space:nowrap}
  </style>
</KampoLayout>
