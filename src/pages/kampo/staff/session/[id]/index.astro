---
// 薬剤師の入力画面（担当者画面）。2026-10-31 第4弾 3-1 で作り直し：
//   いちばん上：要約（お客様・いちばん改善したいこと・体質の上位・寒熱・虚実・必ず伝えるもの（赤）・確認の進み具合・担当者）
//   タブ「1. 確認する」：観察（舌・顔色・爪・体格・声）／お客様に聞いて確認する（安全確認タグと薬・持病・アレルギーを1つのチェックリストに）
//   タブ「2. 提案する」：体質（AI の判定・横向きの棒グラフ）／漢方薬の候補（注意は候補のすぐ下に「種類・何が起きるか・根拠」）／
//                       美容商品／お客様に伝える養生／店内メモ・お客様用の結果・印刷・保存
// ④「薬剤師の判定」と ③「漢方薬の入力」は廃止（AI の判定と候補は最初から表示。漢方薬の確認・修正は ② の行で）。
// 「確認した」「取り消す」「お客様に伝えた」は画面を読み込み直さずにその場で反映する（fetch。x-kampo-ajax）。
// 受診のおすすめは患者さんの画面には出さず、ここ（赤帯）だけに出して薬剤師が口頭で伝える。
// 旧版のセッションは再計算せず、保存時の内容を文言だけで表示する。
export const prerender = false;
import KampoLayout from '../../../../../layouts/KampoLayout.astro';
import {
  TYPES, AXES, STAFF_QUESTIONS, SECTION_LABEL, LEGACY, formulaByCode, findingLabel, legacyOptionText, optionText, optionById, axisName, axisColor,
  strengthRangeLabel, THERMAL_LABEL, HEAT_LABEL, symptomLabel, questionById, FOUNDATION, type Option, type Question,
} from '../../../../../lib/kampo/masters';
import { LEVEL_LABEL, DEF_EXC_LABEL, THERMAL_STATE_LABEL, COMBO_LABEL, SELF_TONGUE_FACTOR, toAxis, advicePlan, relatedTypeOf } from '../../../../../lib/kampo/scoring';
import { FOOD_HERBS, staffChecks, noKampoReason, referrals, CAUTION_KIND_LABEL } from '../../../../../lib/kampo/safety';
import { FINDING_STATUS_LABEL } from '../../../../../lib/kampo/findings';
import { buildReasons, selectionSnapshot, FIT_LEVEL_LABEL, OUTCOME_LABEL, type Candidate } from '../../../../../lib/kampo/recommend';
import { SEX_LABEL, AGE_BAND_LABEL, MENSES_LABEL, kampoOf, tongueMode, normalizeAnswer } from '../../../../../lib/kampo/flow';
import { computeSession, selectionOf, finalize, isLegacy, kampoHidden } from '../../../../../lib/kampo/compute';
import { clearStaffCookie } from '../../../../../lib/kampo/auth';
import { getSession, saveSession, getCustomer, audit, fmtJst, getStaffRoster, STATUS_LABEL, INPUT_BY_LABEL, type KampoProposal } from '../../../../../lib/kampo/store';

const id = Astro.params.id ?? '';
const s = await getSession(id);
if (!s) return Astro.redirect('/kampo/staff/?msg=notfound', 303);
const self = `/kampo/staff/session/${s.id}/`;
const legacy = isLegacy(s);
const msg = Astro.url.searchParams.get('msg') ?? '';
const errs: Record<string, string> = {};
const roster = await getStaffRoster();
const WHO = 'kampo_who';
const whoRaw = Astro.cookies.get(WHO)?.value;
let who = whoRaw ? decodeURIComponent(whoRaw) : '';
if (who && !roster.includes(who)) who = '';
const isAjax = Astro.request.headers.get('x-kampo-ajax') === '1';
const jsonRes = (o: Record<string, unknown>, status = 200) => new Response(JSON.stringify(o), { status, headers: { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' } });
const NEED_WHO = '上で担当者を選んでください。';

// 観察の設問
const sq = (qid: string) => STAFF_QUESTIONS.find((x) => x.id === qid);
const TONGUE = sq('X_tongue');
const LOOK = ['X_face', 'X_nail_color', 'X_nail_shape', 'X_build', 'X_voice'].map(sq).filter((x): x is Question => !!x);
const tMode = tongueMode(s.answers);
const tongueEditable = tMode === 'staff' || tMode === undefined;
// 記入欄のある選択肢（薬・病気・アレルギー）：薬剤師が確認・修正した内容は texts の「<ID>#staff」
const NOTE_OPTS = ['C1', 'C2', 'C3'].flatMap((qid) => (questionById(qid)?.options ?? []).filter((o) => o.note).map((o) => ({ qid, o })));
const NOTE_FIX_IDS = [...NOTE_OPTS.map((x) => x.o.id), 'C3F-other'];
const PREG_TEXTS = ['preg_weeks', 'preg_due', 'lact_months'];
const A3P_TO_X: Record<string, string> = { 'A3P-preg': 'X_preg-preg', 'A3P-lact': 'X_preg-lact', 'A3P-no': 'X_preg-no', 'A3P-maybe': 'X_preg-maybe' };
// 記入漏れの薬として追加できる種類（問診と同じ選択肢。漢方薬は候補から選ぶ）
const MED_KINDS = (questionById('C1')?.options ?? []).filter((o) => !o.exclusive && o.id !== 'C1-kampo');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const get = (k: string) => String(form.get(k) ?? '').trim();
  const action = get('action');
  const needWho = (where: string) => { if (!who) errs[where] = NEED_WHO; return !!who; };
  if (action === 'leave') {
    clearStaffCookie(Astro.cookies);
    return Astro.redirect(`/kampo/check/${s.id}/done/`, 303);
  }
  if (action === 'who') {
    const v = get('who');
    if (roster.includes(v)) Astro.cookies.set(WHO, encodeURIComponent(v), { path: '/kampo/', maxAge: 60 * 60 * 12, sameSite: 'lax', httpOnly: true, secure: import.meta.env.PROD });
    else Astro.cookies.delete(WHO, { path: '/kampo/' });
    return Astro.redirect(`${self}${get('hash') || ''}`, 303);
  }
  // 「確認した」「取り消す」「お客様に伝えた」（画面を読み込み直さずに反映する。fetch から呼ぶ）
  if (!legacy && ['check', 'uncheck', 'notify', 'unnotify'].includes(action)) {
    const key = get('key').slice(0, 160);
    if (!who) return isAjax ? jsonRes({ ok: false, error: NEED_WHO }) : Astro.redirect(`${self}?msg=nowho`, 303);
    if (!key) return jsonRes({ ok: false, error: '項目が見つかりません。' });
    const now = new Date().toISOString();
    if (action === 'check') s.tagChecks = { ...(s.tagChecks ?? {}), [key]: { by: who, at: now, note: get('note').slice(0, 200) || undefined } };
    else if (action === 'uncheck') { if (s.tagChecks) delete s.tagChecks[key]; }
    else if (action === 'notify') s.referralNotified = { ...(s.referralNotified ?? {}), [key]: { by: who, at: now } };
    else if (s.referralNotified) delete s.referralNotified[key];
    if (s.status !== 'in_progress') finalize(s);
    await saveSession(s);
    await audit(action, `${s.id}:${key}`, who);
    return isAjax ? jsonRes({ ok: true, by: who, at: fmtJst(now), action }) : Astro.redirect(`${self}?msg=${action}#t1`, 303);
  }
  if (action === 'observe' && !legacy && needWho(get('scope') === 'oral' ? 'oral' : 'obs')) {
    const scope = get('scope') === 'oral' ? 'oral' : 'obs';
    const sa: Record<string, string[]> = { ...(s.staffAnswers ?? {}) };
    const setQ = (q: Question) => {
      const ids = normalizeAnswer(q, form.getAll(q.id).map(String));
      if (ids.length) sa[q.id] = ids; else delete sa[q.id];
    };
    let pregMissing = false;
    if (scope === 'obs') for (const q of [...(tongueEditable && TONGUE ? [TONGUE] : []), ...LOOK]) setQ(q);
    else {
      // 妊娠・授乳：ご本人がはっきり答えていて、薬剤師が修正していなければ保存しない（ご本人の回答のまま）
      const px = sq('X_preg');
      if (px) {
        const ids = normalizeAnswer(px, form.getAll('X_preg').map(String));
        const p0 = s.answers.A3P?.[0];
        if (!ids.length) { if (get('pregRequired') === '1') pregMissing = true; else delete sa.X_preg; }
        else if (!s.staffAnswers?.X_preg?.length && p0 && p0 !== 'A3P-maybe' && A3P_TO_X[p0] === ids[0]) delete sa.X_preg;
        else sa.X_preg = ids;
      }
      // 服用中・体調を崩した漢方薬は候補から選ぶ（保存すると薬剤師の入力が優先）
      for (const k of ['X_kampo_current', 'X_kampo_adverse'] as const) { const q = sq(k); if (q) sa[k] = normalizeAnswer(q, form.getAll(k).map(String)); }
    }
    if (pregMissing) errs[scope] = '妊娠・授乳を口頭で確認して選んでください（「妊娠の可能性がある」「回答せずに次へ」のときは必須です）。';
    else {
      s.staffAnswers = Object.keys(sa).length ? sa : undefined;
      s.staffAnsweredAt = new Date().toISOString();
      s.staffAnsweredBy = who;
      if (scope === 'oral') {
        for (const oid of NOTE_FIX_IDS) { const v = get(`fix-${oid}`).slice(0, 120); if (v) s.texts[`${oid}#staff`] = v; else delete s.texts[`${oid}#staff`]; }
        for (const k of PREG_TEXTS) { const v = get(k).slice(0, 40); if (v) s.texts[`${k}#staff`] = v; else delete s.texts[`${k}#staff`]; }
        for (const k of ['X_kampo_current-other', 'X_kampo_adverse-other']) { const v = get(k).slice(0, 80); if (v) s.texts[k] = v; else delete s.texts[k]; }
        // 記入漏れの薬（お薬手帳で確認）
        const kinds = form.getAll('extra_kind').map(String);
        const names = form.getAll('extra_name').map((x) => String(x).trim().slice(0, 60));
        const extras = kinds.map((k, i) => ({ id: k, name: names[i] ?? '' })).filter((m) => MED_KINDS.some((o) => o.id === m.id) && m.name);
        s.staffMeds = extras.length ? extras : undefined;
      }
      if (s.status !== 'in_progress') finalize(s);
      await saveSession(s);
      await audit(`observe_${scope}`, s.id, who);
      return Astro.redirect(`${self}?msg=${scope}#t1`, 303);
    }
  }
  if ((action === 'unlock' || action === 'relock') && !legacy && needWho('unlock')) {
    if (action === 'unlock') s.kampoUnlocked = { by: who, at: new Date().toISOString() };
    else delete s.kampoUnlocked;
    await saveSession(s);
    await audit(action, s.id, who);
    return Astro.redirect(`${self}?msg=${action}#select`, 303);
  }
  if (action === 'proposal' && !legacy && needWho('proposal')) {
    const selCodes = [...new Set(form.getAll('sel').map(String))].filter((cd) => formulaByCode(cd));
    const other = get('selOther').slice(0, 120);
    if (selCodes.length === 0 && !other && !get('note')) errs.proposal = '提案する漢方薬を選ぶか、メモを入力してください。';
    else if (s.status === 'in_progress') errs.proposal = '回答がまだ終わっていません。';
    else {
      const snapshot = selectionSnapshot(selectionOf(s, computeSession(s)));
      const selReason = get('selReason').slice(0, 300) || undefined;
      const selected = selCodes.map((cd) => ({ formulaCode: cd, name: formulaByCode(cd)!.name, reason: selReason }));
      if (other) selected.push({ formulaCode: 'other', name: other, reason: get('reason_other').slice(0, 300) || undefined });
      const now = new Date().toISOString();
      const dv = get('deliveredVia');
      const p: KampoProposal = {
        staffName: who, candidates: snapshot, selected, note: get('note').slice(0, 2000) || undefined,
        deliveredVia: dv === 'print' ? 'print' : dv === 'screen' ? 'screen' : '',
        createdAt: s.proposal?.createdAt ?? now, updatedAt: now,
      };
      s.proposal = p;
      s.status = 'proposed';
      await saveSession(s);
      await audit('proposal', s.id, who);
      return Astro.redirect(`${self}?msg=saved#t2`, 303);
    }
  }
} else {
  await audit('view_session', s.id);
}

const customer = s.customerId ? await getCustomer(s.customerId) : null;
const inProgress = s.status === 'in_progress';
const c = legacy ? null : computeSession(s);
const r = c ? c.scores : s.scores;
const w = c?.w;
const sel = c ? selectionOf(s, c) : null;
const flags = c?.safetyFlags ?? s.safetyFlags ?? [];
const hideKampo = !legacy && kampoHidden(s);
const noKampo = legacy ? null : noKampoReason(flags);
const plan = c && r ? advicePlan(c.scores, relatedTypeOf(c.w.state, c.scores.mainTypes as string[])) : null;
const selectedSet = new Set((s.proposal?.selected ?? []).map((x) => x.formulaCode));
const idsOf = (qid: string) => w?.steps.find((x) => x.q.id === qid)?.ids ?? [];
const complaintName = (cid: string) => w?.steps.flatMap((x) => (x.q.section === 'complaint' ? x.q.options : [])).find((o) => o.complaint === cid)?.text ?? cid;
type StepLike = { q: { options: Option[]; sub?: { options: Option[] }; followups?: { title: string; options: Option[] }[] }; ids: string[]; skipped?: boolean };
const stepText = (st: StepLike) => {
  if (st.skipped) return '回答なし（口頭で確認）';
  const main = st.ids.filter((x) => st.q.options.some((o) => o.id === x) || st.q.sub?.options.some((o) => o.id === x)).map((x) => ([...st.q.options, ...(st.q.sub?.options ?? [])].find((o) => o.id === x)?.text ?? x) + (s.texts[x] ? `（${s.texts[x]}）` : ''));
  const fus = (st.q.followups ?? []).map((fu) => { const p = fu.options.filter((o) => st.ids.includes(o.id)).map((o) => o.text + (s.texts[o.id] ? `（${s.texts[o.id]}）` : '')); return p.length ? `［${fu.title.replace(/（.*?）$/, '')}：${p.join('、')}］` : ''; }).filter(Boolean);
  return [...st.q.options.filter((o) => o.locked).map((o) => `${o.text}（お悩みで選択）`), ...main, ...fus].join('、');
};
const answerOf = (qid: string) => { const st = w?.steps.find((x) => x.q.id === qid); return st ? stepText(st) : ''; };
const staffSel = new Set(Object.values(s.staffAnswers ?? {}).flat());

// ---- 要約 ----
const pctOf = (k: string) => { if (!r) return 0; const e = Object.entries(r.pct).find(([key]) => toAxis(key) === k); return e ? e[1] : 0; };
const levelOf = (k: string) => { if (!r) return ''; const e = Object.entries(r.level ?? {}).find(([key]) => toAxis(key) === k); return e ? LEVEL_LABEL[e[1]] : ''; };
const evOf = (k: string) => { if (!r?.evidence) return []; const e = Object.entries(r.evidence).find(([key]) => toAxis(key) === k); return e ? e[1] : []; };
const rank = TYPES.map((t) => ({ t, pct: pctOf(t) })).sort((a, b) => b.pct - a.pct);
const topText = !r ? '—' : r.isBalanced ? 'バランス良好（全タイプ20点未満）' : plan && plan.tied.length >= 2 ? `${plan.tied.map(axisName).join('・')}が同じくらい（${rank[0].pct}点前後）` : rank.filter((x) => x.pct >= 20).slice(0, 2).map((x) => `${axisName(x.t)} ${x.pct}点`).join('・') || '—';
const refers = w ? referrals(w, s.staffAnswers) : [];
const referKey = (m: string) => `refer:${m}`.slice(0, 160);
const contraHits = sel ? sel.groups.flatMap((g) => g.candidates.filter((cd) => cd.safety.cautions.some((x) => x.exclude && x.kind === 'interaction')).map((cd) => ({ name: cd.name, c: cd.safety.cautions.find((x) => x.exclude && x.kind === 'interaction')! }))) : [];
const pregUnconfirmed = flags.some((f) => f.code === 'preg_unconfirmed') || flags.some((f) => f.code === 'pregnancy' && f.label === '妊娠の可能性あり' && f.source !== '薬剤師が口頭で確認');

// ---- チェックリスト（安全確認タグ＋薬・持病・アレルギー。1つにまとめる）----
interface ChkRow { key: string; section: 'tag' | 'med'; label: string; answer: string; points: string[]; kind: 'none' | 'text' | 'preg' | 'kampo_current' | 'kampo_adverse'; fixId?: string; patient?: string; fixed?: string; urgent?: boolean; isTag?: boolean }
const rows: ChkRow[] = [];
if (c) {
  for (const t of c.tags) rows.push({ key: t.id, section: 'tag', label: t.label, answer: t.sources.join('／'), points: t.checks, kind: 'none', urgent: t.urgent, isTag: true });
  for (const x of staffChecks(c.w)) rows.push({ key: `memo:${x.label}`.slice(0, 160), section: 'tag', label: x.label, answer: '回答から', points: [x.detail], kind: 'none' });
  const fixOf = (oid: string) => ({ patient: (s.texts[oid] ?? '').trim(), fixed: (s.texts[`${oid}#staff`] ?? '').trim() });
  const pa = idsOf('A3P');
  if (c.w.steps.some((x) => x.q.id === 'A3P') && c.w.sex !== 'male') rows.push({ key: 'row:pregnancy', section: 'med', label: '妊娠・授乳', answer: pa[0] ? optionText(pa[0]) : '回答なし', points: pregUnconfirmed ? ['口頭で確認して選んでください（必須）'] : ['ご本人の回答のとおりか確認'], kind: 'preg' });
  for (const oid of idsOf('C1')) {
    const o = optionById(oid);
    if (!o || o.exclusive || oid === 'C1-kampo') continue;
    rows.push({ key: `row:${oid}`, section: 'med', label: `薬：${o.text}`, answer: fixOf(oid).patient || '記入なし', points: ['薬の名前をお薬手帳などで確認'], kind: o.note ? 'text' : 'none', fixId: o.note ? oid : undefined, ...fixOf(oid) });
  }
  const curNames = kampoOf(s.answers, s.staffAnswers, 'X_kampo_current');
  const patientCur = idsOf('C1').filter((x) => x.startsWith('C1KP-')).map(optionText);
  rows.push({ key: 'row:kampo_current', section: 'med', label: '服用中の漢方薬', answer: idsOf('C1').includes('C1-kampo') ? (patientCur.join('・') || '名前は選択なし') : 'なし', points: ['お薬手帳で名前を確認し、選び間違い（加味帰脾湯と帰脾湯など）を直す'], kind: 'kampo_current', patient: curNames.source === 'staff' ? '薬剤師が保存済み' : '' });
  for (const oid of idsOf('C2')) {
    const o = optionById(oid);
    if (!o || o.exclusive) continue;
    rows.push({ key: `row:${oid}`, section: 'med', label: `${oid === 'C2-surgery' ? '手術' : '病気'}：${o.text}`, answer: o.note ? (fixOf(oid).patient || '記入なし') : '（選択のみ）', points: o.note ? ['病名・内容を口頭で確認'] : ['主治医の指示とあわせて確認'], kind: o.note ? 'text' : 'none', fixId: o.note ? oid : undefined, ...fixOf(oid) });
  }
  const c3 = idsOf('C3');
  if (c3.includes('C3-drug')) rows.push({ key: 'row:C3-drug', section: 'med', label: '薬のアレルギー', answer: fixOf('C3-drug').patient || '記入なし', points: ['何の薬で、どんな症状が出たか'], kind: 'text', fixId: 'C3-drug', ...fixOf('C3-drug') });
  if (c3.includes('C3-food')) {
    const foods = c3.filter((x) => x.startsWith('C3F-') && x !== 'C3F-other').map(optionText);
    const other = c3.includes('C3F-other');
    rows.push({ key: 'row:C3-food', section: 'med', label: '食品のアレルギー', answer: `${foods.join('・') || '食品の選択なし'}${other ? `／その他：${fixOf('C3F-other').patient || '記入なし'}` : ''}`, points: ['選んだ食品に当たる生薬を含む処方は、候補から外しています'], kind: other ? 'text' : 'none', fixId: other ? 'C3F-other' : undefined, ...(other ? fixOf('C3F-other') : {}) });
  }
  if (c3.includes('C3-kampo')) {
    const advNames = c3.filter((x) => x.startsWith('C3KP-')).map(optionText);
    const sym = c3.filter((x) => x.startsWith('C3S-')).map(optionText);
    rows.push({ key: 'row:kampo_adverse', section: 'med', label: '漢方薬で体調を崩した経験', answer: `${advNames.join('・') || '名前は選択なし'}／症状：${sym.join('・') || '未回答'}`, points: ['どの漢方薬か、症状、時期を確認（原因の生薬は未特定）'], kind: 'kampo_adverse' });
  }
}
const isDone = (k: string) => !!s.tagChecks?.[k];
const doneCount = rows.filter((x) => isDone(x.key)).length;
const kampoNameMissing = flags.some((f) => (f.code === 'kampo_current' || f.code === 'adverse_kampo') && /未確認|見つからない|ご本人が選択/.test(f.detail ?? ''));
// 観察の要約
const obsLine = (qid: string, label: string) => { const q = sq(qid); const ids = s.staffAnswers?.[qid]; return ids?.length ? `${label}：${ids.map((x) => q?.options.find((o) => o.id === x)?.text ?? x).join('・')}` : ''; };
const obsSummary = [obsLine('X_tongue', '舌'), obsLine('X_face', '顔色'), obsLine('X_nail_color', '爪の色'), obsLine('X_nail_shape', '爪の形'), obsLine('X_build', '体格'), obsLine('X_voice', '声')].filter(Boolean);
// 妊娠・授乳
const pregPatient = idsOf('A3P')[0];
const pregChecked = (o: Option) => (s.staffAnswers?.X_preg?.length ? staffSel.has(o.id) : !pregUnconfirmed && !!pregPatient && A3P_TO_X[pregPatient] === o.id);
const pregCurrent = s.staffAnswers?.X_preg?.[0] ?? (!pregUnconfirmed && pregPatient ? A3P_TO_X[pregPatient] : '');
const selfTongue = idsOf('TS').map(optionText);
// 漢方薬：薬剤師が保存していなければ、ご本人の選択をチェック済みで出す
const kampoState = { X_kampo_current: kampoOf(s.answers, s.staffAnswers, 'X_kampo_current'), X_kampo_adverse: kampoOf(s.answers, s.staffAnswers, 'X_kampo_adverse') };
const kampoChecked = (k: 'X_kampo_current' | 'X_kampo_adverse', o: Option) => (s.staffAnswers?.[k] !== undefined ? staffSel.has(o.id) : !!o.formula && kampoState[k].codes.includes(o.formula));
const formulaOf = (o: Option) => (o.formula ? formulaByCode(o.formula) : undefined);

const MSG: Record<string, string> = {
  saved: '提案を保存しました。', obs: '観察（舌・顔色・爪など）を保存し、AI の判定と候補を更新しました。', oral: '確認内容を保存し、AI の判定・飲み合わせのチェックを更新しました。',
  unlock: '漢方候補を表示に切り替えました。', relock: '漢方候補を伏せる表示に戻しました。', nowho: NEED_WHO,
};
const thermalCell = (cd: Candidate) => `${THERMAL_LABEL[cd.formula.thermal]}${cd.formula.heat ? `（${HEAT_LABEL[cd.formula.heat]}）` : ''}／${strengthRangeLabel(cd.formula.strength)}`;
const cautionTone = (x: { basis: string; exclude?: boolean }) => (x.exclude || x.basis === '併用禁忌' ? 'red' : x.basis === '薬剤師が確認' ? 'gray' : 'yellow');
// 候補を表示できない理由（第4弾 0-3）
const emptyReasons: string[] = [];
if (sel && !noKampo && !hideKampo) {
  if (!sel.groups.length) emptyReasons.push('いちばん改善したい主訴が決まっていません（回答の途中の可能性があります）。');
  for (const g of sel.groups) {
    if (g.outcome === 'no_pool') emptyReasons.push(g.symptoms.length ? `主訴「${g.label}」の症状（${g.symptoms.map(symptomLabel).join('・')}）を承認効能に持つ漢方薬がマスタにありません。` : `主訴「${g.label}」に当たる承認効能の語がないため、候補群がありません（体質に合わせた養生の相談になります）。`);
    if (g.outcome === 'all_excluded') {
      const allergy = g.candidates.some((cd) => cd.safety.cautions.some((x) => x.exclude && x.kind === 'allergy'));
      emptyReasons.push(allergy ? '該当する漢方候補がありません（食品アレルギーによる除外）。' : `主訴「${g.label}」の候補はすべて除外されました（理由は下の「除外した処方」）。`);
    }
  }
}
const allExcludedByAllergy = (sel?.groups ?? []).some((g) => g.outcome === 'all_excluded' && g.candidates.some((cd) => cd.safety.cautions.some((x) => x.exclude && x.kind === 'allergy')));
const legacyQs = legacy ? LEGACY.versions[s.questionnaireVersion] ?? [] : [];
const presentF = w ? [...w.state].filter(([, e]) => e.status === 'present').map(([fid, e]) => ({ fid, label: findingLabel(fid), ...e })) : [];
const notPresentF = w ? [...w.state].filter(([, e]) => e.status !== 'present').map(([fid, e]) => ({ fid, label: findingLabel(fid), ...e })) : [];
const J_THERMAL: Record<string, string> = { cold: '冷え', heat: '熱', neutral: 'どちらでもない', pending: '判断保留' };
const J_DEFEXC: Record<string, string> = { def: '虚証寄り', mid: '虚実間', exc: '実証寄り', pending: '判断保留' };
const j = s.judgment;
---
<KampoLayout title={`薬剤師の入力画面 ${s.customerLabel}`} mode="staff" width="wide">
  <a slot="actions" class="kp-btn ghost small" href="/kampo/staff/">一覧へ</a>
  {customer && <a slot="actions" class="kp-btn ghost small" href={`/kampo/staff/customer/${customer.id}/`}>顧客履歴</a>}
  {!inProgress && !legacy && <a slot="actions" class="kp-btn ghost small" href={`/kampo/check/${s.id}/result/`} target="_blank" rel="noopener">お客様用の結果を表示</a>}
  <form slot="actions" method="post"><button class="kp-btn small" type="submit" name="action" value="leave">来店客モードへ戻る</button></form>

  {msg && MSG[msg] && <p class:list={[msg === 'nowho' ? 'kp-error' : 'kp-ok']} style="margin:0 0 12px">{MSG[msg]}</p>}
  {legacy && <p class="kp-notice" style="margin:0 0 12px">旧版の問診（設問版 {s.questionnaireVersion}）のチェックです。いまの判定では再計算せず、保存時の内容を表示します。提案の保存・観察の入力はできません。</p>}
  {inProgress && !legacy && <p class="kp-notice" style="margin:0 0 12px">このチェックはまだ回答の途中です（表示は現時点の回答で仮計算）。<a href={`/kampo/check/${s.id}/`}>続きから回答する</a></p>}

  {/* いちばん上：要約（常に表示） */}
  <section class="kp-sum" id="summary">
    <div class="kp-sum-top">
      <div class="kp-sum-who">
        <b class="kp-sum-name">{s.customerLabel}</b>
        <small>{fmtJst(s.startedAt)}　{INPUT_BY_LABEL[s.inputBy]}　<span class:list={['kp-chip', { ok: s.status === 'proposed' }]}>{STATUS_LABEL[s.status]}</span>　設問版 {s.questionnaireVersion}</small>
        {w && <small>{w.sex ? SEX_LABEL[w.sex] : '—'}／{w.ageBand ? AGE_BAND_LABEL[w.ageBand] : '—'}{w.menses ? `／${MENSES_LABEL[w.menses]}` : ''}</small>}
      </div>
      <form method="post" class="kp-who">
        <input type="hidden" name="action" value="who"><input type="hidden" name="hash" value="#summary">
        <label>担当者
          <select class="kp-input" name="who" onchange="this.form.submit()" aria-label="担当者">
            <option value="">選択してください</option>
            {roster.map((n) => <option value={n} selected={n === who}>{n}</option>)}
          </select>
        </label>
        {roster.length === 0 ? <span class="kp-note">担当者の名簿が未登録です。<a href="/kampo/staff/#roster">スタッフ画面の「担当者の名簿」</a>で登録してください。</span> : !who && <span class="kp-note kp-need-who">記録の前に担当者を選んでください（以降の記録に自動で入ります）。</span>}
        <noscript><button class="kp-btn ghost small" type="submit">決定</button></noscript>
      </form>
    </div>
    {!legacy && r && w && (
      <div class="kp-sum-grid">
        <div><small>いちばん改善したいこと</small><b>{w.primary ? complaintName(w.primary) : '—'}</b>{w.complaints.filter((x) => x !== w.primary).length > 0 && <span class="kp-sum-sub">ほか：{w.complaints.filter((x) => x !== w.primary).map(complaintName).join('、')}</span>}</div>
        <div><small>体質（AI の判定・上位）</small><b>{topText}</b>{(r.combos ?? []).length > 0 && <span class="kp-sum-sub">{(r.combos ?? []).map((x) => COMBO_LABEL[x]).join('・')}</span>}</div>
        <div><small>寒熱・虚実</small><b>{THERMAL_STATE_LABEL[r.thermalLabel]}／{DEF_EXC_LABEL[r.defExcLabel]}</b></div>
        <div><small>確認の進み具合</small><b><span id="kp-prog-done">{doneCount}</span> / <span id="kp-prog-total">{rows.length}</span> 確認済み</b><span class="kp-sum-sub">漢方薬の名前の確認が必要：<span id="kp-kampo-open">{kampoNameMissing ? '1' : '0'}</span>件</span></div>
      </div>
    )}
    {/* 必ず伝える・止めるもの（赤）：受診のおすすめと併用禁忌だけ */}
    {!legacy && ((c?.urgent ?? s.urgent) || refers.length > 0 || contraHits.length > 0) && (
      <div class="kp-red-zone" id="red-zone">
        {(c?.urgent ?? s.urgent) && <p class="kp-red-row"><b>直ちに対応が必要な回答があります。</b>お客様に声をかけ、状況を確認してください（救急要請などの判断は薬剤師が行います）。</p>}
        {refers.map((x) => {
          const k = referKey(x.message);
          const nt = s.referralNotified?.[k];
          return (
            <div class:list={['kp-red-row', 'kp-refer-row', { notified: !!nt }]} data-key={k}>
              <span class="kp-red-tag">受診のおすすめ</span>
              <span class="kp-red-text"><b>{x.text}</b>：{x.message}</span>
              <span class="kp-red-act">
                <span class="kp-notified-on" hidden={!nt}>お客様に伝えた ✓ <small data-role="by">{nt ? `${nt.by} ${fmtJst(nt.at)}` : ''}</small></span>
                <button class="kp-btn small kp-bigbtn" type="button" data-act="notify" hidden={!!nt}>お客様に伝えた</button>
                <button class="kp-link-small" type="button" data-act="unnotify" hidden={!nt}>取り消す</button>
              </span>
              <span class="kp-row-err" role="alert" hidden></span>
            </div>
          );
        })}
        {contraHits.map((x) => <p class="kp-red-row"><span class="kp-red-tag">候補から除外</span> <span class="kp-red-text"><b>{x.name}</b>：{x.c.pair}（{x.c.effect}）</span></p>)}
      </div>
    )}
  </section>

  {legacy ? (
    <div class="kp-card" style="margin-top:16px">
      <h2 class="kp-h2" style="margin-top:0">保存済みの内容</h2>
      {r && (
        <table class="kp-table compact"><thead><tr><th>タイプ</th><th class="num">点</th></tr></thead>
          <tbody>{AXES.map((k) => <tr><td>{axisName(k)}</td><td class="num">{pctOf(k)}</td></tr>)}</tbody></table>
      )}
      {s.proposal ? (
        <dl class="kp-kv" style="margin-top:12px">
          <dt>担当</dt><dd>{s.proposal.staffName}</dd>
          <dt>提案</dt><dd>{s.proposal.selected.map((x) => x.name).join('・') || '—'}</dd>
          <dt>メモ</dt><dd style="white-space:pre-wrap">{s.proposal.note ?? '—'}</dd>
          <dt>保存日時</dt><dd>{fmtJst(s.proposal.updatedAt)}</dd>
        </dl>
      ) : <p class="kp-note" style="margin-top:12px">提案は保存されていません。</p>}
      {j && !j.skipped && <p class="kp-note" style="margin-top:12px">薬剤師の判定（旧版の記録）：{j.types.map(axisName).join('・')}／寒熱 {J_THERMAL[j.thermal]}／虚実 {J_DEFEXC[j.defExc]}（{j.staffName}）</p>}
      <details class="kp-fold"><summary>回答一覧（{legacyQs.filter((q) => s.answers[q.id]?.length).length}問）</summary>
        <table class="kp-table"><tbody>
          {legacyQs.filter((q) => s.answers[q.id]?.length).map((q) => (
            <tr><th style="width:40%">{q.id}　{q.title.replace(/\{main\}/g, '主訴')}</th><td>{(s.answers[q.id] ?? []).map((x) => legacyOptionText(s.questionnaireVersion, x) + (s.texts[x] ? `（${s.texts[x]}）` : '')).join('、')}{s.texts[q.id] ?? ''}</td></tr>
          ))}
        </tbody></table>
      </details>
    </div>
  ) : (
    <>
      <nav class="kp-tabs2" aria-label="薬剤師画面の切り替え">
        <button type="button" class="kp-tab on" data-tab="t1">1. 確認する<small>{rows.length - doneCount > 0 ? `（未確認 ${rows.length - doneCount}）` : '（確認済み）'}</small></button>
        <button type="button" class="kp-tab" data-tab="t2">2. 提案する</button>
      </nav>

      {/* ===== タブ1：確認する ===== */}
      <div data-pane="t1" id="t1">
        <section class="kp-card kp-step" id="obs">
          <h2 class="kp-h2" style="margin-top:0">観察 <small class="kp-h2-sub">舌・顔色・爪・体格・声　{s.staffAnsweredAt ? `最終保存 ${fmtJst(s.staffAnsweredAt)}${s.staffAnsweredBy ? `（${s.staffAnsweredBy}）` : ''}` : '未入力'}</small></h2>
          <p class="kp-note">観察した内容は、問診と同じく体質の暫定スコアに加点します。顔色・爪は観察を優先し、化粧・ネイルなどで「判断できない」ときだけご本人の回答を使います。</p>
          {errs.obs && <p class="kp-error">{errs.obs}</p>}
          <details class="kp-obs-fold" open={!obsSummary.length}>
            <summary><span class="kp-obs-sum">{obsSummary.length ? obsSummary.join('　／　') : '未入力'}</span><span class="kp-btn ghost small kp-open-btn">開いて直す</span></summary>
            <form method="post" class="kp-obsform">
              <input type="hidden" name="action" value="observe"><input type="hidden" name="scope" value="obs">
              <h3 class="kp-obs-h">舌</h3>
              {tMode === 'self' ? (
                <div class="kp-notice" style="margin:6px 0">
                  <p><b>ご本人入力</b>（ご本人が鏡で見てイラストから選択。判定の重みは {SELF_TONGUE_FACTOR} 倍）</p>
                  <p style="margin-top:4px">{selfTongue.join('・') || '（回答なし）'}</p>
                </div>
              ) : tMode === 'none' ? (
                <p class="kp-notice" style="margin:6px 0">ご本人が「舌の確認はしない」を選びました。舌は判定から外しています（点数・満点とも）。</p>
              ) : TONGUE && (
                <div class="kp-obs-groups" data-qid={TONGUE.id}>
                  {(TONGUE.groups ?? []).map((g) => (
                    <fieldset class="kp-obs-g">
                      <legend>{g.title}<small>{g.hint}</small></legend>
                      <div class="kp-iconopts">
                        {TONGUE.options.filter((o) => o.group === g.id).map((o) => (
                          <label class="kp-check small has-icon">
                            <input type="checkbox" name={TONGUE.id} value={o.id} checked={staffSel.has(o.id)} data-one={o.oneOf ?? ''} data-group={o.group ?? ''} data-gex={o.groupExclusive ? '1' : '0'} data-conf={(o.excludes ?? []).concat(TONGUE.options.filter((b) => b.excludes?.includes(o.id)).map((b) => b.id)).join(' ')}>
                            {o.icon && <img src={o.icon} alt="" width="64" height="69" loading="lazy">}
                            <span>{o.text}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  ))}
                </div>
              )}
              <h3 class="kp-obs-h">顔色・爪・体格・声</h3>
              {LOOK.map((q) => (
                <fieldset class="kp-obs" data-type={q.type}>
                  <legend>{q.title}{q.help && <small>　{q.help}</small>}</legend>
                  <div class:list={['kp-obs-opts', { imgs: q.options.some((o) => o.image) }]}>
                    {q.options.map((o) => <label class="kp-check small"><input type={q.type === 'multi' ? 'checkbox' : 'radio'} name={q.id} value={o.id} checked={staffSel.has(o.id)} data-ex={o.exclusive || o.defer ? '1' : '0'}>{o.image && <img src={o.image} alt="" width="48" height="70">}<span>{o.text}</span></label>)}
                  </div>
                  {q.id === 'X_face' && <p class="kp-note">ご本人の回答：{answerOf('F1') || '—'}</p>}
                  {q.id === 'X_nail_shape' && <p class="kp-note">ご本人の回答（肌・髪・爪・唇）：{answerOf('B2') || '—'}（「爪が割れやすい」はこちらを使います）</p>}
                </fieldset>
              ))}
              <div class="kp-saverow">
                <button class="kp-btn small" type="submit">観察を保存して AI の判定を更新</button>
                {!who && <span class="kp-row-err show">{NEED_WHO}</span>}
              </div>
            </form>
          </details>
        </section>

        <section class="kp-card kp-step" id="oral">
          <h2 class="kp-h2" style="margin-top:0">お客様に聞いて確認する <small class="kp-h2-sub">安全確認と、薬・持病・アレルギー</small></h2>
          <p class="kp-note">確認した行は「確認した」を押すと灰色になり、上の件数がその場で減ります。ご本人の記入を直すときは「直す」を開きます。直したら一番下の「確認内容を保存して再計算」で、飲み合わせのチェックと候補を更新します。</p>
          {errs.oral && <p class="kp-error">{errs.oral}</p>}
          <form method="post" class="kp-oralform" id="oralForm">
            <input type="hidden" name="action" value="observe"><input type="hidden" name="scope" value="oral">
            <table class="kp-chk">
              <thead><tr><th>項目</th><th>ご本人の回答</th><th>確認する点</th><th>メモ</th><th>確認</th></tr></thead>
              {(['tag', 'med'] as const).map((sec) => (
                <tbody>
                  <tr class="kp-chk-sec"><th colspan="5">{sec === 'tag' ? '安全確認' : '薬・持病・アレルギー'}</th></tr>
                  {rows.filter((x) => x.section === sec).length === 0 && <tr><td colspan="5" class="kp-note">{sec === 'tag' ? '安全確認の付いた回答はありません。' : '該当する回答はありません。'}</td></tr>}
                  {rows.filter((x) => x.section === sec).map((x) => {
                    const ck = s.tagChecks?.[x.key];
                    return (
                      <tr class:list={['kp-chk-row', { done: !!ck, urgent: x.urgent }]} data-key={x.key} data-tag={x.isTag ? '1' : '0'}>
                        <th class="kp-chk-label">{x.label}{x.urgent && <span class="kp-chip refer">直ちに対応</span>}</th>
                        <td class="kp-chk-ans">{x.answer}
                          {x.kind === 'text' && x.fixId && x.fixed && <small class="kp-fixed">薬剤師が確認：「{x.fixed}」</small>}
                        </td>
                        <td class="kp-chk-pts">
                          {x.points.length > 1 ? <ul>{x.points.map((p) => <li>{p}</li>)}</ul> : <span>{x.points[0]}</span>}
                          {x.kind === 'text' && x.fixId && (
                            <details class="kp-fix"><summary>直す</summary>
                              <input class="kp-input" type="text" name={`fix-${x.fixId}`} value={x.fixed ?? ''} placeholder="確認した正式な名前・内容（任意）" maxlength="120">
                            </details>
                          )}
                          {x.kind === 'preg' && (
                            <div class="kp-preg-box">
                              <input type="hidden" name="pregRequired" value={pregUnconfirmed && !s.staffAnswers?.X_preg?.length ? '1' : '0'}>
                              <details class="kp-fix" open={pregUnconfirmed}><summary>{pregUnconfirmed ? '口頭で確認して選ぶ（必須）' : '直す'}</summary>
                                <div class="kp-obs-opts kp-preg">{sq('X_preg')!.options.map((o) => <label class="kp-check small"><input type="radio" name="X_preg" value={o.id} checked={pregChecked(o)}><span>{o.text}</span></label>)}</div>
                              </details>
                              <div class="kp-preg-more" data-when="X_preg-preg" hidden={pregCurrent !== 'X_preg-preg'}>
                                <label>妊娠週数（または月数）<input class="kp-input" type="text" name="preg_weeks" value={s.texts['preg_weeks#staff'] ?? ''} placeholder="例：12週"></label>
                                <label>出産予定日<input class="kp-input" type="text" name="preg_due" value={s.texts['preg_due#staff'] ?? ''} placeholder="例：2027年4月"></label>
                              </div>
                              <div class="kp-preg-more" data-when="X_preg-lact" hidden={pregCurrent !== 'X_preg-lact'}>
                                <label>産後何か月か<input class="kp-input" type="text" name="lact_months" value={s.texts['lact_months#staff'] ?? ''} placeholder="例：産後4か月"></label>
                              </div>
                            </div>
                          )}
                          {(x.kind === 'kampo_current' || x.kind === 'kampo_adverse') && (() => {
                            const kk = (x.kind === 'kampo_current' ? 'X_kampo_current' : 'X_kampo_adverse') as 'X_kampo_current' | 'X_kampo_adverse';
                            const qk = sq(kk);
                            return qk && (
                              <fieldset class="kp-kampo" data-kind={x.kind}>
                                <div class="kp-kampo-picked"></div>
                                <input class="kp-input kp-kampo-q" type="search" placeholder="名前・ひらがな・ツムラ番号で探す（例：ほちゅう／41）" autocomplete="off">
                                <div class="kp-obs-opts kp-kampo-list">
                                  {qk.options.map((o) => {
                                    const f = formulaOf(o);
                                    const on = kampoChecked(kk, o);
                                    return <label class="kp-check small" data-key={f ? [f.name, f.reading, ...(f.aliases ?? [])].join(' ') : o.text} data-no={f?.tsumuraNo ?? ''} hidden={!on}><input type="checkbox" name={kk} value={o.id} checked={on}><span><span class="kp-kampo-name">{o.text}</span><small>{f?.tsumuraNo ? `　ツムラ No.${f.tsumuraNo}${f.tsumuraNoVerified ? '' : '（未確認）'}` : '　ツムラ番号なし'}</small></span></label>;
                                  })}
                                </div>
                                <input class="kp-input" type="text" name={`${kk}-other`} value={s.texts[`${kk}-other`] ?? ''} placeholder="一覧にない漢方薬・市販薬の商品名（任意）" maxlength="80">
                              </fieldset>
                            );
                          })()}
                        </td>
                        <td class="kp-chk-memo"><input class="kp-input" type="text" data-role="note" value={ck?.note ?? ''} placeholder="メモ（任意）" maxlength="200"></td>
                        <td class="kp-chk-act">
                          <span class="kp-done-on" hidden={!ck}>確認済み ✓<small data-role="by">{ck ? `${ck.by} ${fmtJst(ck.at)}` : ''}</small></span>
                          <button class="kp-btn small kp-bigbtn" type="button" data-act="check" hidden={!!ck}>確認した</button>
                          <button class="kp-link-small" type="button" data-act="uncheck" hidden={!ck}>取り消す</button>
                          <span class="kp-row-err" role="alert" hidden></span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              ))}
            </table>

            <div class="kp-extra" id="extra">
              <h3 class="kp-obs-h" style="margin-top:18px">＋ 記入漏れの薬を追加（お薬手帳で確認）</h3>
              <p class="kp-note">お薬手帳に、ご本人が選ばなかった薬があれば追加します。漢方薬は「漢方薬（候補から選ぶ）」を選ぶと、上の「服用中の漢方薬」の行に追加されます。</p>
              <ul class="kp-extra-list" id="extraList">
                {(s.staffMeds ?? []).map((m) => <li><span>{optionText(m.id)}：{m.name}</span><input type="hidden" name="extra_kind" value={m.id}><input type="hidden" name="extra_name" value={m.name}><button type="button" class="kp-link-small" data-rm="1">削除</button></li>)}
              </ul>
              <div class="kp-extra-add">
                <select class="kp-input" id="extraKind" aria-label="薬の種類">
                  {MED_KINDS.map((o) => <option value={o.id}>{o.text}</option>)}
                  <option value="__kampo">漢方薬（候補から選ぶ）</option>
                </select>
                <input class="kp-input" type="text" id="extraName" placeholder="薬の名前" maxlength="60">
                <button class="kp-btn ghost small" type="button" id="extraAdd">＋追加</button>
              </div>
              <div class="kp-extra-kampo" id="extraKampo" hidden>
                <input class="kp-input" type="search" id="extraKampoQ" placeholder="漢方薬の名前・ひらがな・ツムラ番号で探す" autocomplete="off">
                <p class="kp-note">検索した漢方薬は、上の「服用中の漢方薬」の行に追加されます。</p>
              </div>
            </div>
            <div class="kp-saverow">
              <button class="kp-btn small" type="submit">確認内容を保存して再計算</button>
              {!who && <span class="kp-row-err show">{NEED_WHO}</span>}
            </div>
          </form>

          <details class="kp-fold" open={flags.some((f) => f.code === 'allergy_food')}>
            <summary>食品と生薬の対応（食品アレルギーの参考）</summary>
            <p class="kp-note">ご本人が選んだ食品に当たる生薬を含む処方は、候補から自動で外しています（構成生薬は添付文書の抜粋に基づくデータで、原本での再確認待ちです）。</p>
            <table class="kp-table compact"><thead><tr><th>食品</th><th>重なる生薬</th></tr></thead>
              <tbody>{FOOD_HERBS.map((x) => <tr><td>{x.food}</td><td>{x.herb}</td></tr>)}</tbody></table>
          </details>
        </section>

        <details class="kp-fold">
          <summary>回答一覧（{w ? w.steps.length : 0}問）／所見の一覧（あり {presentF.length}・なし／わからない {notPresentF.length}）</summary>
          <div class="kp-card">
            <table class="kp-table">
              <tbody>
                {w?.steps.map((st) => (
                  <tr><th style="width:40%"><small style="color:var(--muted)">{SECTION_LABEL[st.q.section]}</small><br>{st.q.title}</th><td>{stepText(st) || '—'}{s.texts[st.q.id] && <><br><small>記入：{s.texts[st.q.id]}</small></>}</td></tr>
                ))}
              </tbody>
            </table>
            <h3 class="kp-obs-h">所見</h3>
            <table class="kp-table compact">
              <thead><tr><th>所見</th><th>状態</th><th>どこで答えたか</th></tr></thead>
              <tbody>{[...presentF, ...notPresentF].map((x) => (
                <tr><td>{x.label}</td><td>{FINDING_STATUS_LABEL[x.status]}{x.source === 'implied' ? '（関連する回答から）' : x.source === 'staff' ? '（薬剤師）' : ''}</td><td><small>{SECTION_LABEL[x.section]}　{x.question}</small></td></tr>
              ))}</tbody>
            </table>
          </div>
        </details>
      </div>

      {/* ===== タブ2：提案する ===== */}
      <div data-pane="t2" id="t2">
        <p class="kp-refresh" id="kp-refresh-note" hidden>安全確認の確認状況が変わりました。候補の判定を更新するには <a href="" onclick="location.reload();return false">画面を読み込み直す</a> か、タブ1の「確認内容を保存して再計算」を押してください。</p>
        <section class="kp-card kp-step" id="ai">
          <h2 class="kp-h2" style="margin-top:0">体質（AI の判定）</h2>
          {!r ? <p class="kp-note">スコアはまだありません。</p> : (
            <>
              <p class="kp-note" style="margin-bottom:10px">問診と観察（舌・顔色・爪・体格・声）を所見ごとの草案の重みで集計した暫定値です。同じ所見・意味の近い所見は1回分だけ数えます。区切り（20／40／60点）も暫定です。</p>
              {plan?.allHigh && <p class="kp-notice warn">全体的に高く出ています（60点以上が{plan.strongCount}タイプ）。主訴から優先順位を決めてご説明ください。</p>}
              {plan && plan.tied.length >= 2 && <p class="kp-notice">{plan.tied.map(axisName).join('・')}が同じくらい（差5点以内）です。「主」と決めつけず、並べてご説明ください。</p>}
              <div class="kp-bars">
                {rank.map(({ t, pct }) => (
                  <details class="kp-bar-row">
                    <summary>
                      <span class="kp-bar-name"><i style={`background:${axisColor(t)}`}></i>{axisName(t)}{plan?.types.includes(t) && <small class="kp-bar-tag">養生に使う</small>}</span>
                      <span class="kp-bar"><b style={`width:${pct}%;background:${axisColor(t)}`}></b></span>
                      <span class="kp-bar-pct">{pct}点<small>{levelOf(t)}</small></span>
                    </summary>
                    <p class="kp-ev"><small>根拠の所見：{evOf(t).slice(0, 6).map(findingLabel).join('、') || '—'}</small></p>
                  </details>
                ))}
              </div>
              <div class="kp-bars kp-bars-thermal">
                {(['cold', 'heat'] as const).map((t) => (
                  <details class="kp-bar-row">
                    <summary>
                      <span class="kp-bar-name"><i style={`background:${axisColor(t)}`}></i>寒熱：{axisName(t)}</span>
                      <span class="kp-bar"><b style={`width:${pctOf(t)}%;background:${axisColor(t)}`}></b></span>
                      <span class="kp-bar-pct">{pctOf(t)}点<small>{levelOf(t)}</small></span>
                    </summary>
                    <p class="kp-ev"><small>根拠の所見：{evOf(t).slice(0, 6).map(findingLabel).join('、') || '—'}</small></p>
                  </details>
                ))}
              </div>
              <dl class="kp-kv" style="margin-top:10px">
                <dt>虚実指数</dt><dd>{r.defExcIndex > 0 ? '+' : ''}{r.defExcIndex}　{DEF_EXC_LABEL[r.defExcLabel]}</dd>
                <dt>寒熱指数</dt><dd>{r.thermalIndex > 0 ? '+' : ''}{r.thermalIndex}　{THERMAL_STATE_LABEL[r.thermalLabel]}</dd>
              </dl>
            </>
          )}
        </section>

        <section class="kp-card kp-step" id="select">
          <h2 class="kp-h2" style="margin-top:0">漢方薬の候補</h2>
          {noKampo ? (
            <p class="kp-notice kp-nokampo"><b>候補は表示していません。</b>{noKampo}</p>
          ) : hideKampo ? (
            <div class="kp-beauty">
              <p class="kp-notice" style="margin:0 0 10px"><b>候補は伏せています。</b>漢方薬で体調を崩したことがある方のため、漢方候補は初期表示では出さず、薬剤師が確認してから切り替えます。</p>
              <form method="post" class="kp-unlock-form">
                <input type="hidden" name="action" value="unlock">
                <p class="kp-note">症状が軽い場合（軽い胃もたれなど）は、確認したうえで漢方候補を表示できます。体調を崩した漢方薬と共通の生薬を含む候補には「◯◯が共通」と出ます。</p>
                <button class="kp-btn" type="submit">漢方候補も表示する{who ? `（${who}）` : ''}</button>
                {errs.unlock && <p class="kp-error" style="margin-top:8px">{errs.unlock}</p>}
              </form>
            </div>
          ) : (
            s.kampoUnlocked && (
              <form method="post" class="kp-notice" style="margin:0 0 10px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <input type="hidden" name="action" value="relock">
                <span>漢方薬で体調を崩したことがある方です。{s.kampoUnlocked.by}（{fmtJst(s.kampoUnlocked.at)}）が確認して漢方候補を表示しています。</span>
                <button class="kp-btn ghost small" type="submit">伏せる表示に戻す</button>
                {errs.unlock && <span class="kp-error">{errs.unlock}</span>}
              </form>
            )
          )}
          {emptyReasons.length > 0 && (
            <div class="kp-notice warn" role="status">
              <b>候補を表示できない理由</b>
              <ul style="margin:4px 0 0;padding-left:1.2em">{emptyReasons.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
          {sel && !noKampo && !hideKampo && sel.general.length > 0 && (
            <details class="kp-general">
              <summary>全候補に共通の確認事項 {sel.general.length}件（候補の判定は「要確認」のまま）</summary>
              <ul>{sel.general.map((x) => <li>{x}</li>)}</ul>
            </details>
          )}
          <form method="post" id="propForm">
            <input type="hidden" name="action" value="proposal">
            {sel && !noKampo && !hideKampo && sel.groups.map((g) => {
              const shown = g.candidates.filter((cd) => cd.safety.status !== 'excluded');
              const excluded = g.candidates.filter((cd) => cd.safety.status === 'excluded');
              return (
                <div class="kp-sel-group">
                  <h3 class="kp-sel-h">主訴：{g.label}（{g.category}）<small>{g.details.length ? `詳細：${g.details.map((d) => d.text).join('／')}` : '（詳細の選択なし）'}</small>
                    <span class:list={['kp-chip', { ok: g.outcome === 'pick', check: g.outcome === 'pick_check', warn: g.outcome === 'all_excluded' }]}>{OUTCOME_LABEL[g.outcome]}{g.pick ? `：${g.pick.name}` : ''}</span></h3>
                  {(g.symptoms.length > 0 || g.also.length > 0) && <p class="kp-note">候補抽出に使う症状：{g.symptoms.map(symptomLabel).join('・') || '—'}　／　加点に使う随伴症状：{g.also.map(symptomLabel).join('・') || '—'}</p>}
                  {shown.length > 0 && (
                    <div class="kp-sel-scroll">
                      <table class="kp-table kp-sel-table">
                        <thead><tr><th>選定</th><th>判定</th><th>漢方薬</th><th>効能の該当（承認）</th><th>寒熱／体力</th><th class="num">適合度</th></tr></thead>
                        {shown.map((cd) => (
                          <tbody class:list={['kp-cand', { 'is-pick': g.pick?.code === cd.code, 'is-unfit': cd.level === 'unfit' }]}>
                            <tr>
                              <td><input type="checkbox" name="sel" value={cd.code} checked={selectedSet.has(cd.code)} aria-label={`${cd.name}を選定`}></td>
                              <td>{g.pick?.code === cd.code ? <span class="kp-chip ok">推薦</span> : <span class="kp-chip">{FIT_LEVEL_LABEL[cd.level]}</span>}{cd.safety.status === 'check' && <span class="kp-chip check">要確認</span>}</td>
                              <td><b>{cd.name}</b>{cd.formula.tsumuraNo ? <small class="kp-tsu">ツムラ {cd.formula.tsumuraNo}</small> : null}{!cd.formula.verified && <small class="kp-sel-unv" title="効能・効果を製品の添付文書で未確認">効能は未確認</small>}<br><small>{cd.formula.targetLabel}</small></td>
                              <td>{cd.matched.map((m) => m.term).join('、')}{cd.alsoCovers.length > 0 && <><br><small>随伴症状：{cd.alsoCovers.map((x) => symptomLabel(x.symptom)).join('・')}</small></>}</td>
                              <td>{thermalCell(cd)}{cd.mismatches.map((m) => <div class="kp-sel-bad">不適合：{m.text}</div>)}{cd.gaps.map((m) => <div class="kp-sel-gap">ずれ：{m.text}</div>)}</td>
                              <td class="num"><b>{cd.fit.toFixed(2)}</b></td>
                            </tr>
                            {cd.safety.cautions.length > 0 && (
                              <tr class="kp-cd-cautions"><td></td><td colspan="5">
                                <ul class="kp-cautions">
                                  {cd.safety.cautions.map((x) => (
                                    <li class={`kp-cau ${cautionTone(x)}`}>
                                      <span class="kp-cau-kind">【{CAUTION_KIND_LABEL[x.kind]}】</span><b>{x.pair}</b>
                                      <span class="kp-cau-eff">{x.effect}</span>
                                      <span class="kp-cau-basis">{x.basis}</span>
                                    </li>
                                  ))}
                                </ul>
                              </td></tr>
                            )}
                          </tbody>
                        ))}
                      </table>
                    </div>
                  )}
                  {excluded.length > 0 && <p class="kp-excluded"><b>除外した処方（{excluded.length}）：</b>{excluded.map((cd) => `${cd.name}（${cd.safety.exclude.join('、')}）`).join('　／　')}</p>}
                  {shown.length === 0 && g.candidates.length > 0 && allExcludedByAllergy && <p class="kp-notice warn">該当する漢方候補がありません（食品アレルギーによる除外）。</p>}
                  {g.pick && (() => {
                    const rs = buildReasons(g, g.pick, r!);
                    return (
                      <details class="kp-fold">
                        <summary>推薦理由：{g.pick.name}</summary>
                        <ol class="kp-sel-reasons">
                          <li><b>主訴の候補になった理由</b><p>{rs.complaint}</p><p class="kp-note">効能・効果：{g.pick.formula.efficacy}</p></li>
                          <li><b>体質に合う理由</b><ul class="kp-sel-ul">{rs.constitution.map((x) => <li>{x}</li>)}</ul><p class="kp-note">使用目標：{rs.useTarget}／漢方の考え方：{rs.action}</p></li>
                          <li><b>ほかの候補との比較</b><ul class="kp-sel-ul">{rs.comparison.map((x) => <li>{x}</li>)}</ul></li>
                          <li><b>服用前の確認事項</b><ul class="kp-sel-ul">{rs.cautions.map((x) => <li>{x}</li>)}</ul></li>
                        </ol>
                      </details>
                    );
                  })()}
                </div>
              );
            })}
            {sel && !noKampo && !hideKampo && <p class="kp-note kp-basis-note">注意の「根拠」の区分（併用禁忌・併用注意・禁忌・慎重投与）は、添付文書のデータ登録前の暫定（一般的な知見）です。製品の添付文書で確認してください。</p>}

            <h3 class="kp-obs-h" style="margin-top:22px">美容商品のおすすめ</h3>
            <p class="kp-note">美容商品のデータをいただいたら、ここに表示します（未登録）。</p>

            <h3 class="kp-obs-h" style="margin-top:22px">お客様に伝える養生</h3>
            {plan ? (
              <div class="kp-advice-plan">
                <p><b>土台（全員共通）</b>：{FOUNDATION.items.map((x) => x.label).join('・')}</p>
                <p><b>体質別</b>：{plan.types.length ? plan.types.map(axisName).join('・') : 'バランス良好のため土台のみ'}{plan.tied.length >= 2 && '（同じくらいの体質があります）'}</p>
                <p class="kp-note">主タイプ＋主訴に関係するタイプの最大2つ分と、土台を、お客様用の結果に出します。逆の内容になる養生は両方に合う表現にそろえます。</p>
              </div>
            ) : <p class="kp-note">スコアがありません。</p>}

            <h3 class="kp-obs-h" style="margin-top:22px">選定とメモ</h3>
            {!noKampo && !hideKampo && (
              <label class="kp-field">選定理由<small>選んだ漢方薬に共通のメモ（任意）</small>
                <input class="kp-input" type="text" name="selReason" value={s.proposal?.selected.find((x) => x.formulaCode !== 'other')?.reason ?? ''} placeholder="例：随伴症状ののぼせ・月経不順も考慮">
              </label>
            )}
            <div class="kp-sel-other">
              <label class="kp-field" style="margin:0">{hideKampo || noKampo ? '提案する商品・ご案内（任意）' : '候補以外の漢方薬'}
                <input class="kp-input" type="text" name="selOther" value={s.proposal?.selected.find((x) => x.formulaCode === 'other')?.name ?? ''} placeholder={hideKampo || noKampo ? '商品名・養生のご案内など' : '漢方薬の名前（候補にないものを提案する場合）'}>
              </label>
              <input class="kp-input" type="text" name="reason_other" value={s.proposal?.selected.find((x) => x.formulaCode === 'other')?.reason ?? ''} placeholder="理由（任意）" style="margin-top:8px">
            </div>
            <div style="margin-top:14px">
              <span class="kp-field" style="display:block;margin-top:0">結果の渡し方</span>
              <div class="kp-radios cols" style="margin-top:8px;max-width:520px">
                <label class="kp-radio" style="min-height:48px"><input type="radio" name="deliveredVia" value="screen" checked={s.proposal?.deliveredVia === 'screen' || !s.proposal}>画面で説明</label>
                <label class="kp-radio" style="min-height:48px"><input type="radio" name="deliveredVia" value="print" checked={s.proposal?.deliveredVia === 'print'}>A4印刷して渡す</label>
              </div>
            </div>
            <label class="kp-field">メモ<small>店内用。お客様には表示されません</small>
              <textarea class="kp-input" name="note" rows="3" placeholder="提案内容、次回の確認事項など">{s.proposal?.note ?? ''}</textarea>
            </label>
            {s.proposal && <p class="kp-note" style="margin-top:8px">前回保存: {fmtJst(s.proposal.updatedAt)}　担当 {s.proposal.staffName}　選定: {s.proposal.selected.map((x) => x.name).join('・') || '—'}</p>}
            {errs.proposal && <p class="kp-error" style="margin-top:10px">{errs.proposal}</p>}
            <div class="kp-final-actions">
              <a class="kp-btn ghost" href={`/kampo/check/${s.id}/result/`} target="_blank" rel="noopener">お客様用の結果を開く</a>
              <a class="kp-btn ghost" href={`/kampo/check/${s.id}/result/?print=1`} target="_blank" rel="noopener">A4で印刷</a>
              <button class="kp-btn" type="submit" disabled={inProgress}>{s.proposal ? '提案を更新する' : '提案を保存する'}{who ? `（${who}）` : ''}</button>
            </div>
            {!who && <p class="kp-row-err show" style="margin-top:8px">{NEED_WHO}</p>}
          </form>
        </section>
      </div>
    </>
  )}

  <script is:inline>
  (function(){
    var A=function(sel,root){return Array.prototype.slice.call((root||document).querySelectorAll(sel))};
    // ---- タブ（JS なしなら両方表示）----
    var tabs=A('[data-tab]'),panes=A('[data-pane]');
    function show(n){panes.forEach(function(p){p.hidden=p.dataset.pane!==n});tabs.forEach(function(t){t.classList.toggle('on',t.dataset.tab===n)})}
    if(tabs.length){
      var h=location.hash.replace('#',''),tg=h&&document.getElementById(h),pn=tg&&tg.closest?tg.closest('[data-pane]'):null;
      show(pn?pn.dataset.pane:(h==='t2'?'t2':'t1'));
      tabs.forEach(function(t){t.addEventListener('click',function(){show(t.dataset.tab);history.replaceState(null,'','#'+t.dataset.tab);window.scrollTo({top:document.getElementById('summary').offsetTop,behavior:'smooth'})})});
    }
    // ---- 確認した／取り消す／お客様に伝えた（読み込み直さずに反映）----
    function post(params,cb){
      fetch(location.pathname,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','x-kampo-ajax':'1'},body:new URLSearchParams(params),credentials:'same-origin'})
        .then(function(r){return r.json()}).then(cb).catch(function(){cb({ok:false,error:'通信に失敗しました。もう一度押してください。'})});
    }
    function recount(){
      var rowsEl=A('.kp-chk-row'),d=rowsEl.filter(function(r){return r.classList.contains('done')}).length;
      var a=document.getElementById('kp-prog-done'),b=document.getElementById('kp-prog-total');if(a)a.textContent=d;if(b)b.textContent=rowsEl.length;
      var tb=document.querySelector('[data-tab=t1] small');if(tb)tb.textContent=rowsEl.length-d>0?'（未確認 '+(rowsEl.length-d)+'）':'（確認済み）';
    }
    document.addEventListener('click',function(e){
      var btn=e.target.closest?e.target.closest('[data-act]'):null;if(!btn)return;
      var row=btn.closest('.kp-chk-row')||btn.closest('.kp-refer-row');if(!row)return;
      e.preventDefault();
      var act=btn.dataset.act,err=row.querySelector('.kp-row-err');
      var note=row.querySelector('[data-role=note]');
      btn.disabled=true;
      post({action:act,key:row.dataset.key,note:note?note.value:''},function(res){
        btn.disabled=false;
        if(!res.ok){if(err){err.textContent=res.error||'記録できませんでした。';err.hidden=false}return}
        if(err)err.hidden=true;
        var on=act==='check'||act==='notify';
        var q=function(sel){return row.querySelector(sel)};
        if(act==='check'||act==='uncheck'){
          row.classList.toggle('done',on);
          q('[data-act=check]').hidden=on;q('[data-act=uncheck]').hidden=!on;
          var d=q('.kp-done-on');d.hidden=!on;q('.kp-done-on [data-role=by]').textContent=on?res.by+' '+res.at:'';
          recount();
          if(row.dataset.tag==='1'){var rf=document.getElementById('kp-refresh-note');if(rf)rf.hidden=false}
        }else{
          row.classList.toggle('notified',on);
          q('[data-act=notify]').hidden=on;q('[data-act=unnotify]').hidden=!on;
          var n=q('.kp-notified-on');n.hidden=!on;q('.kp-notified-on [data-role=by]').textContent=on?res.by+' '+res.at:'';
        }
      });
    });
    // ---- 観察・口頭確認のフォーム内の排他（舌：1つ選ぶ／ふつう／同時に選べない組み合わせ）----
    function rules(root){
      var ins=A('input[type=checkbox],input[type=radio]',root);
      function block(){
        var off={};
        ins.forEach(function(i){if(i.checked&&i.dataset.conf)i.dataset.conf.split(' ').forEach(function(x){if(x)off[x]=1})});
        ins.forEach(function(i){var b=!!off[i.value]&&!i.checked;i.disabled=b;var l=i.closest('label');if(l)l.classList.toggle('is-off',b)});
      }
      ins.forEach(function(i){i.addEventListener('change',function(){
        if(i.checked&&i.dataset.one)ins.forEach(function(o){if(o!==i&&o.dataset.one===i.dataset.one)o.checked=false});
        if(i.checked&&i.dataset.group)ins.forEach(function(o){if(o!==i&&o.dataset.group===i.dataset.group&&(i.dataset.gex==='1'||o.dataset.gex==='1'))o.checked=false});
        block();
      })});
      block();
    }
    A('.kp-obs-groups').forEach(rules);
    // 顔色・爪・体格・声：「ふつう」「特記なし」「判断できない」は他と同時に選べない
    A('fieldset.kp-obs[data-type=multi]').forEach(function(fs){
      var ins=A('input',fs);
      ins.forEach(function(i){i.addEventListener('change',function(){if(!i.checked)return;ins.forEach(function(o){if(o===i)return;if(i.dataset.ex==='1'||o.dataset.ex==='1')o.checked=false})})});
    });
    // 妊娠・授乳：妊娠中なら週数・予定日、授乳中なら産後の月数
    var pregs=A('input[name=X_preg]');
    if(pregs.length){var u=function(){var v=(pregs.filter(function(i){return i.checked})[0]||{}).value;A('.kp-preg-more').forEach(function(d){if(v)d.hidden=d.dataset.when!==v})};pregs.forEach(function(i){i.addEventListener('change',u)})}
    // ---- 漢方薬の検索（名前・ひらがな・カタカナ・ツムラ番号）----
    var hira=function(s){return s.replace(/[ァ-ヶ]/g,function(c){return String.fromCharCode(c.charCodeAt(0)-0x60)})};
    var half=function(s){return s.replace(/[０-９]/g,function(c){return String.fromCharCode(c.charCodeAt(0)-0xfee0)})};
    A('.kp-kampo').forEach(function(fs){
      var q=fs.querySelector('.kp-kampo-q'),picked=fs.querySelector('.kp-kampo-picked');
      var items=A('.kp-kampo-list label',fs);
      function render(v0){
        var v=hira(half((v0!==undefined?v0:q.value||'').trim()).replace(/^(ツムラ|つむら)?\s*(no\.?)?\s*/i,''));
        items.forEach(function(l){
          var on=l.querySelector('input').checked;
          var hit=!!v&&(/^\d+$/.test(v)?l.dataset.no===v:hira(l.dataset.key).indexOf(v)>=0);
          l.hidden=!(on||hit);
        });
        var nm=items.filter(function(l){return l.querySelector('input').checked}).map(function(l){return l.querySelector('.kp-kampo-name').textContent});
        picked.textContent='入力済み：'+(nm.join('・')||'なし');
      }
      q.addEventListener('input',function(){render()});
      q.addEventListener('keydown',function(e){if(e.key==='Enter')e.preventDefault()});
      items.forEach(function(l){l.querySelector('input').addEventListener('change',function(){render()})});
      fs._render=render;render();
    });
    // ---- 記入漏れの薬の追加 ----
    var kind=document.getElementById('extraKind'),nameIn=document.getElementById('extraName'),add=document.getElementById('extraAdd'),list=document.getElementById('extraList');
    var ek=document.getElementById('extraKampo'),ekq=document.getElementById('extraKampoQ');
    if(kind){
      kind.addEventListener('change',function(){var k=kind.value==='__kampo';ek.hidden=!k;nameIn.hidden=k;add.hidden=k;if(k){ekq.focus()}});
      add.addEventListener('click',function(){
        var v=(nameIn.value||'').trim();if(!v){nameIn.focus();return}
        var li=document.createElement('li');
        var sp=document.createElement('span');sp.textContent=kind.options[kind.selectedIndex].textContent+'：'+v;
        var h1=document.createElement('input');h1.type='hidden';h1.name='extra_kind';h1.value=kind.value;
        var h2=document.createElement('input');h2.type='hidden';h2.name='extra_name';h2.value=v;
        var rm=document.createElement('button');rm.type='button';rm.className='kp-link-small';rm.dataset.rm='1';rm.textContent='削除';
        li.appendChild(sp);li.appendChild(h1);li.appendChild(h2);li.appendChild(rm);list.appendChild(li);nameIn.value='';
      });
      list.addEventListener('click',function(e){var b=e.target.closest?e.target.closest('[data-rm]'):null;if(b)b.closest('li').remove()});
      if(ekq)ekq.addEventListener('input',function(){var fs=document.querySelector('.kp-kampo[data-kind=kampo_current]');if(fs&&fs._render){fs._render(ekq.value);fs.scrollIntoView({block:'center'})}});
    }
  })();
  </script>
