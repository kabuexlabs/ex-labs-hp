---
// スタッフ画面トップ：本日のチェック一覧（直ちに対応が必要な回答・安全確認タグの印つき）・顧客検索・新規チェック・CSV書き出し。
// 「来店客モードへ戻る」でスタッフ Cookie を消す（iPad を渡す前に押す）。
// 体質（AI の暫定判定）は一覧にも出す（2026-10-31 第4弾 3-2：薬剤師が先に判定する手順は取り下げ。AI の判定は最初から表示）。
export const prerender = false;
import KampoLayout from '../../../layouts/KampoLayout.astro';
import { SEX_LABEL, AGE_BAND_LABEL, type Sex } from '../../../lib/kampo/flow';
import { clearStaffCookie, pinConfigured } from '../../../lib/kampo/auth';
import { supervisorName } from '../../../lib/kampo/compute';
import {
  isKvConfigured, listSessionsByDay, listRecentSessions, searchCustomers, countSessions, purgeExpired, jstDate, fmtJst, customerLabel, receiptNo,
  STATUS_LABEL, INPUT_BY_LABEL, typeNamesOf, getStaffRoster, saveStaffRoster, audit,
} from '../../../lib/kampo/store';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'leave') {
    clearStaffCookie(Astro.cookies);
    return Astro.redirect('/kampo/check/new/', 303);
  }
  // 担当者の名簿（薬剤師の入力画面の「担当者」はここから選ぶ。第3弾 10-3）
  if (action === 'roster' && isKvConfigured()) {
    await saveStaffRoster(String(form.get('names') ?? '').split(/[\n,、，]/));
    await audit('roster', 'staffnames');
    return Astro.redirect('/kampo/staff/?msg=roster#roster', 303);
  }
}
const kv = isKvConfigured();
const today = jstDate();
const dateParam = Astro.url.searchParams.get('date') ?? '';
const date = /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : today;
const qstr = (Astro.url.searchParams.get('q') ?? '').trim();
const msg = Astro.url.searchParams.get('msg') ?? '';
const shift = (d: string, n: number) => { const t = new Date(`${d}T00:00:00+09:00`); t.setUTCDate(t.getUTCDate() + n); return jstDate(new Date(t.getTime() - 9 * 3600 * 1000 + 12 * 3600 * 1000)); };
let sessions: Awaited<ReturnType<typeof listSessionsByDay>> = [];
let recent: Awaited<ReturnType<typeof listRecentSessions>> = [];
let customers: Awaited<ReturnType<typeof searchCustomers>> = [];
let total = 0;
let roster: string[] = [];
let loadError = '';
if (kv) {
  try {
    if (date === today) await purgeExpired().catch((e) => console.error('[kampo] purge', e));
    [sessions, total, recent, roster] = await Promise.all([listSessionsByDay(date), countSessions(), listRecentSessions(20), getStaffRoster()]);
    if (qstr) customers = await searchCustomers(qstr);
  } catch (e) {
    loadError = String((e as Error).message ?? e);
  }
}
const flagSummary = (s: (typeof sessions)[number]) => {
  const f = s.safetyFlags ?? [];
  const refer = f.filter((x) => x.level === 'refer').length;
  const warn = f.filter((x) => x.level === 'warn').length;
  return { refer, warn, tags: (s.tags ?? []).filter((t) => !s.tagChecks?.[t.id]).length };
};
// 直ちに対応が必要な回答があるチェックを一番上に
sessions.sort((a, b) => Number(!!b.urgent) - Number(!!a.urgent));
const urgentCount = sessions.filter((s) => s.urgent).length;
---
<KampoLayout title="スタッフ画面" mode="staff" width="wide">
  <a slot="actions" class="kp-btn ghost small" href="/kampo/check/new/">新規チェックを始める</a>
  <form slot="actions" method="post"><button class="kp-btn small" type="submit" name="action" value="leave">来店客モードへ戻る</button></form>

  {msg === 'notfound' && <p class="kp-notice" style="margin-bottom:12px">指定のチェックが見つかりませんでした（保持期限切れの可能性があります）。</p>}
  {!kv && <p class="kp-error" style="margin-bottom:12px">データ保存先（KV）が未設定です。</p>}
  {loadError && <p class="kp-error" style="margin-bottom:12px">読み込みエラー: {loadError}</p>}

  {urgentCount > 0 && <div class="kp-band">直ちに対応が必要な回答があります（{urgentCount}件）。お客様に声をかけて状況を確認してください。</div>}
  <div class="kp-card">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <h1 class="kp-title" style="font-size:20px;margin:0">{date === today ? '本日' : date.replace(/-/g, '/')}のチェック<span class="kp-chip" style="margin-left:8px">{sessions.length}件</span></h1>
      <form method="get" style="margin-left:auto;display:flex;gap:6px;align-items:center">
        <a class="kp-btn ghost small" href={`/kampo/staff/?date=${shift(date, -1)}`}>前日</a>
        <input class="kp-input" type="date" name="date" value={date} style="min-height:44px;padding:6px 10px;font-size:15px;margin:0;width:170px">
        <button class="kp-btn ghost small" type="submit">表示</button>
        <a class="kp-btn ghost small" href={`/kampo/staff/?date=${shift(date, 1)}`}>翌日</a>
        {date !== today && <a class="kp-btn ghost small" href="/kampo/staff/">今日</a>}
      </form>
    </div>
    {sessions.length === 0 ? (
      <p class="kp-note" style="margin-top:12px">この日のチェックはありません。</p>
    ) : (
      <table class="kp-table" style="margin-top:12px">
        <thead><tr><th>時刻</th><th>受付・お客様</th><th>入力</th><th>主な体質（AI）</th><th>ほかの体質（AI）</th><th>安全確認</th><th>状態</th><th></th></tr></thead>
        <tbody>
          {sessions.map((s) => { const f = flagSummary(s); return (
            <tr class:list={[{ 'kp-row-urgent': s.urgent }]}>
              <td>{fmtJst(s.startedAt, false)}</td>
              <td><b>受付 {receiptNo(s.id)}</b><br><small>{s.customerLabel}</small></td>
              <td>{INPUT_BY_LABEL[s.inputBy]}</td>
              <td>{s.scores ? (s.scores.isBalanced ? 'バランス良好' : typeNamesOf(s.scores.mainTypes)) : '—'}</td>
              <td>{s.scores ? typeNamesOf(s.scores.subTypes) || '—' : '—'}</td>
              <td>{s.urgent && <span class="kp-chip refer">直ちに対応</span>} {f.tags > 0 && <span class="kp-chip warn">タグ未確認 {f.tags}</span>} {f.refer > 0 && <span class="kp-chip refer">受診勧奨 {f.refer}</span>} {f.warn > 0 && <span class="kp-chip check">注意 {f.warn}</span>} {!s.urgent && f.tags + f.refer + f.warn === 0 && <span class="kp-chip ok">なし</span>}</td>
              <td><span class:list={['kp-chip', { ok: s.status === 'proposed' }]}>{STATUS_LABEL[s.status]}</span></td>
              <td><a class="kp-btn ghost small" href={`/kampo/staff/session/${s.id}/`}>開く</a></td>
            </tr>
          ); })}
        </tbody>
      </table>
    )}
  </div>

  <div class="kp-card">
    <h2 class="kp-title" style="font-size:18px">直近のチェック（日付をまたいで新しい順に20件）</h2>
    <p class="kp-note">過去のチェックは、ここ・上の日付の切り替え・下の顧客検索（→ 履歴）から「開く」で薬剤師の入力画面を開けます。各チェックの URL は <code>/kampo/staff/session/（チェックID）/</code> です（スタッフPINが必要）。</p>
    {recent.length === 0 ? <p class="kp-note" style="margin-top:8px">まだチェックはありません。</p> : (
      <table class="kp-table" style="margin-top:8px">
        <thead><tr><th>日時</th><th>お客様</th><th>入力</th><th>状態</th><th>チェックID</th><th></th></tr></thead>
        <tbody>{recent.map((x) => (
          <tr class:list={[{ 'kp-row-urgent': x.urgent }]}><td>{fmtJst(x.startedAt)}</td><td>{x.customerLabel}</td><td>{INPUT_BY_LABEL[x.inputBy]}</td><td><span class:list={['kp-chip', { ok: x.status === 'proposed' }]}>{STATUS_LABEL[x.status]}</span></td><td><small>{x.id}</small></td><td><a class="kp-btn ghost small" href={`/kampo/staff/session/${x.id}/`}>開く</a></td></tr>
        ))}</tbody>
      </table>
    )}
  </div>

  <div class="kp-card">
    <h2 class="kp-title" style="font-size:18px">顧客検索</h2>
    <form method="get" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
      <label class="kp-field" style="flex:1;min-width:240px;margin-top:0">会員番号・電話番号・LINE表示名
        <input class="kp-input" type="text" name="q" value={qstr} placeholder="例: 12345 / 09012345678 / 表示名の一部" autocomplete="off">
      </label>
      <button class="kp-btn small" type="submit" style="min-height:56px">検索</button>
    </form>
    {qstr && (customers.length === 0 ? <p class="kp-note" style="margin-top:12px">「{qstr}」に一致するお客様はいません。</p> : (
      <table class="kp-table" style="margin-top:12px">
        <thead><tr><th>お客様</th><th>性別・年代</th><th>登録日</th><th></th></tr></thead>
        <tbody>{customers.map((c) => (
          <tr><td>{customerLabel(c)}</td><td>{c.sex ? SEX_LABEL[c.sex as Sex] ?? c.sex : '—'}／{c.ageBand ? AGE_BAND_LABEL[c.ageBand] ?? c.ageBand : '—'}</td><td>{fmtJst(c.createdAt).slice(0, 10)}</td><td><a class="kp-btn ghost small" href={`/kampo/staff/customer/${c.id}/`}>履歴</a></td></tr>
        ))}</tbody>
      </table>
    ))}
  </div>

  <div class="kp-card">
    <h2 class="kp-title" style="font-size:18px">設定・データ</h2>
    <dl class="kp-kv">
      <dt>保存件数</dt><dd>{total} 件（保持期間 3年。期限切れは自動で削除）</dd>
      <dt>監修者表示</dt><dd>{supervisorName() || <span style="color:var(--danger)">未設定（KAMPO_SUPERVISOR_NAME）。改善アドバイスの監修欄は表示していません</span>}</dd>
      <dt>スタッフPIN</dt><dd>{pinConfigured() ? '設定済み' : <span style="color:var(--danger)">未設定（KAMPO_STAFF_PIN）。ログインの合言葉で代用中</span>}</dd>
      <dt>CSV書き出し</dt><dd><a href="/kampo/staff/export.csv">全チェックの一覧と回答（CSV）</a></dd>
      <dt>マスタ編集</dt><dd>設問・文面・処方は <code>src/data/kampo/</code> の JSON を直して再デプロイ</dd>
    </dl>
    <form method="post" id="roster" class="kp-roster">
      <input type="hidden" name="action" value="roster">
      <label class="kp-field" style="margin-top:14px">担当者の名簿<small>1行に1人。薬剤師の入力画面の「担当者」はここから選びます（選んだ担当者は以降の記録に自動で入ります）</small>
        <textarea class="kp-input" name="names" rows="4" placeholder="例：山田（薬剤師）">{roster.join('\n')}</textarea>
      </label>
      {msg === 'roster' && <p class="kp-ok" style="margin:8px 0 0">担当者の名簿を保存しました（{roster.length}人）。</p>}
      <button class="kp-btn ghost small" type="submit" style="margin-top:10px" disabled={!kv}>名簿を保存</button>
    </form>
  </div>
  <style is:global>.kp-row-urgent td{background:var(--danger-soft)}</style>
</KampoLayout>
