---
// Rendered on request so newly published blog posts appear in the
// related-articles section without a redeploy.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { jsonLd } from '../../lib/microcms';
import LatestPosts from '../../components/LatestPosts.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroWorksMarquee from '../../components/HeroWorksMarquee.astro';
import { mediaItems } from '../../data/media';

const faqs = [
  {
    q: 'イマーシブコンテンツとは、謎解きやマーダーミステリーと何が違うのですか？',
    a: '謎解きは「協力して謎を解くこと」、マーダーミステリーは「役になりきって推理すること」が体験の中心です。イマーシブコンテンツは、謎を解くこと自体よりも、実在する街・空間・香り・アート作品などを通じて「物語の中に入り込む没入感」そのものを体験の目的とする点が異なります。',
  },
  {
    q: 'どのような街やブランドと組み合わせられますか？',
    a: '商品ブランド、商業施設・観光施設・商店街エリアなど、実在する場所やブランドと組み合わせたオリジナルのイマーシブコンテンツを企画・制作します。実際に渋谷サクラステージや下北沢の街全体を舞台にした作品を制作した実績があります。',
  },
  {
    q: '制作期間や費用はどのくらいですか？',
    a: '形式と規模で変わります。参考価格と納期は本ページの「ご依頼の条件」に前提つきで掲載しています（1空間公演型は数十万円台〜、施設一体型は100万円前後〜、街歩き周遊型は数百万円規模。オリジナル制作は最短1ヶ月・標準1〜3ヶ月）。有料チケット型の企画は、初期費用0円のレベニューシェア型も選べます。',
  },
  {
    q: '一度実施した後、再演することはできますか？',
    a: '複数のエンディングを用意するなど、リプレイ性を持たせた設計も可能です。継続的な集客コンテンツとして展開したい場合もご相談ください。',
  },
  {
    q: 'イマーシブの制作依頼は、何から始めればいいですか？',
    a: 'お問い合わせフォームで「イマーシブの制作」を選び、目的（集客・話題化・ブランド体験など）・舞台にしたい場所・希望時期をお知らせください。予算や企画内容が未定の段階でも構いません。内容を伺ったうえで、企画の方向性と概算お見積りを無料でご提案します。',
  },
  {
    q: '制作依頼から公開までの期間はどのくらいですか？',
    a: '既存公演の貸切・出張実施は2〜4週間、オリジナル制作は最短1ヶ月・標準1〜3ヶ月が目安です（脚本・稽古・テスト公演を含む）。商業施設との調整やテナント連携を含む大型企画では2〜4ヶ月を見込みます。開催希望日が決まっている場合は、お問い合わせ時にお伝えいただければ間に合う構成をご提案します。',
  },
  {
    q: 'VRや映像でのイマーシブコンテンツも制作できますか？',
    a: 'VR・XR・映像単体のコンテンツ制作は当社の主業務ではありません。当社が得意とするのは、実在の街・施設・店舗を舞台にしたリアルなイマーシブ体験で、映像や音響は演出の一部として組み込みます。',
  },
  {
    q: 'イマーシブイベントの制作を依頼する場合、どのような流れになりますか？',
    a: 'お問い合わせフォームからご連絡いただいた後、目的・舞台となる場所・ご予算をヒアリングし、企画をご提案します。ご発注後はシナリオ制作・体験設計・テストプレイを経て、当日の運営まで一貫してex Labsが担当します。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'イマーシブコンテンツ制作',
  name: 'イマーシブコンテンツ制作',
  alternateName: ['イマーシブイベント制作', 'イマーシブ制作依頼', 'イマーシブシアター制作', 'イマーシブイベントの企画制作'],
  description: '実在する街・空間・ブランドを舞台にした没入型（イマーシブ）体験コンテンツの企画・シナリオ制作・体験設計・運営。施設一体型・街歩き周遊型・1空間公演型のリアル体験に対応',
  provider: { '@type': 'Organization', '@id': new URL('/#organization', Astro.site).toString(), name: '株式会社ex Labs', url: new URL('/', Astro.site).toString() },
  audience: { '@type': 'BusinessAudience', name: '商業施設・観光施設・宿泊施設・店舗・商店街・ブランド・広告代理店' },
  areaServed: 'JP',
  subjectOf: {
    '@type': 'NewsArticle',
    headline: '日本経済新聞：渋谷サクラステージの施設一体型イマーシブ「ウワサバナシ調査委員会」が紹介',
    publisher: { '@type': 'Organization', name: '日本経済新聞' },
    url: 'https://www.nikkei.com/article/DGXZQOUC222NG0S6A720C2000000/',
  },
  url: new URL('/services/immersive/', Astro.site).toString(),
};
---
<BaseLayout
  title="イマーシブ制作依頼・お見積り｜没入型体験イベントの企画・制作会社 - 株式会社ex Labs"
  description="イマーシブ（没入型体験）コンテンツ・イマーシブイベントの制作依頼なら、イマーシブ制作会社の株式会社ex Labs。日本経済新聞に掲載された渋谷サクラステージの施設一体型イマーシブなど制作実績多数。企画から体験設計・運営まで一貫対応。見積り無料。"
>
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(serviceLd)} />
<Breadcrumb items={[
  { name: 'ホーム', href: '/' },
  { name: 'サービス', href: '/services/' },
  { name: 'イマーシブ制作' },
]} />

<section class="hero">
<div class="hero-overlay"></div>
<div class="wrap hero-center" style="padding-top:36px;padding-bottom:44px">
<img class="hero-logo" src="/assets/logo.png" alt="株式会社 ex Labs" width="2048" height="520" loading="eager" decoding="async" style="width:min(220px,46vw);margin-bottom:26px">
<h1 class="hero-title serif"><span class="hl">街もブランドも物語になる</span><br><span class="hl">イマーシブ体験を制作しませんか？</span></h1>
<p class="hero-sub">Immersive Experience Production — ex Labs Inc.</p>
<div class="hero-actions">
<a class="btn" href="/?c=immersive#contact">イマーシブ制作を相談する</a>
<a class="btn ghost" href="#terms">条件・価格を見る</a>
</div>
</div>
<HeroWorksMarquee />
</section>

<section class="section" style="padding-top:56px"><div class="wrap">
<p class="eyebrow">SERVICE</p>
<h2 class="h2 serif">イマーシブコンテンツ制作｜没入型体験の企画・制作</h2>
<p class="lede">株式会社ex Labsは、参加者が物語を「観る」のではなく<strong>自分自身が物語の当事者として体験する</strong>、イマーシブ（没入型）コンテンツを企画・制作しています。実在する街・空間・香り・アート作品を物語に組み込み、「<strong>その場所だからこそ体験できる物語</strong>」をお届けします。<strong>制作に関するご相談・お見積りは無料</strong>です。</p>
<div class="svc-sum" id="summary">
<div class="svc-sum-cell"><p class="svc-sum-k">依頼できる制作内容</p><p class="svc-sum-v">企画・脚本・体験設計・制作物（サイン・小道具）・キャスト・告知集客・当日運営・実施後レポート。脚本のみ、運営のみなど一部の依頼も可能です。</p></div>
<div class="svc-sum-cell"><p class="svc-sum-k">想定する依頼者</p><p class="svc-sum-v">商業施設・観光施設・宿泊施設、店舗・バー、商店街・自治体、ブランド・広告代理店、イベント主催者。</p></div>
<div class="svc-sum-cell"><p class="svc-sum-k">対応形式</p><p class="svc-sum-v">施設一体型／街歩き周遊型／1空間公演型。いずれも実在の場所で行うリアル体験です。VR・映像単体の制作は主業務ではありません。</p></div>
<div class="svc-sum-cell"><p class="svc-sum-k">根拠になる実績</p><p class="svc-sum-v">渋谷サクラステージ「ウワサバナシ調査委員会」（日本経済新聞掲載）、下北沢「ロスト・フレーム」（全公演完売）、六本木「怪盗と秘密の試験」（電ファミニコゲーマー掲載）。</p></div>
</div>
<nav class="svc-jump" aria-label="ページ内の移動"><a href="#formats">対応内容・形式</a><a href="#works">事例</a><a href="#terms">条件・価格・納期</a><a href="/?c=immersive#contact" class="is-cta">相談する（無料）</a></nav>
<p class="lede" style="margin-top:36px"><strong>イマーシブ（immersive）とは「没入型」の意味</strong>で、観客が客席から鑑賞するのではなく、物語の世界に入り込んで登場人物として体験するエンターテインメント形式を指します。イマーシブシアターのような劇場型から、街全体を舞台にした周遊型まで、空間そのものを物語に変えるのが特徴です。用語の詳しい解説は<a href="/guide/immersive/" style="color:var(--accent)">イマーシブとは？完全ガイド</a>、制作工程の全体像は<a href="/guide/immersive-seisaku/" style="color:var(--accent)">イマーシブ制作とは</a>をご覧ください。</p>
</div></section>

<section class="section tinted"><div class="wrap">
<p class="eyebrow">ISSUES</p>
<h2 class="h2 serif">こんなご要望はありませんか？</h2>
<ul class="bullets">
<li>謎解きやマーダーミステリーとは違う、没入感を軸にした体験を作りたい</li>
<li>街やエリア全体を舞台にした周遊型のイベントを実施したい</li>
<li>自社ブランド・商品の世界観を、体験として届けたい</li>
<li>記憶に残る、話題化するオリジナルの体験コンテンツを企画してほしい</li>
</ul>
<div class="rule"></div>
<p class="lede">イマーシブコンテンツは、ゴールへの到達よりも<strong>体験の過程で得られる没入感や感情の動き</strong>が主役です。だからこそ、シナリオだけでなく、街・空間・香り・アートといった<strong>五感の演出</strong>を物語にどう織り込むかが問われます。</p>
</div></section>

<section class="section" id="formats"><div class="wrap">
<p class="eyebrow">FORMATS</p>
<h2 class="h2 serif">施設一体型・街歩き型・1空間公演型の選び方</h2>
<p class="h2sub">当社が制作するのは、実在の場所で行うリアルなイマーシブ体験です。目的と使える空間に合わせて、3つの形式から選びます。</p>
<div class="cmp-wrap"><table class="cmp-table"><thead><tr><th>形式</th><th>向いている目的</th><th>必要な空間・会期</th><th>参考価格・納期（前提つき）</th><th>当社の実績</th></tr></thead><tbody>
<tr><th scope="row">施設一体型</th><td>商業施設の館内回遊・滞在時間の延長・テナント送客、話題化</td><td>共有区画＋館内の複数スポット。2週間〜1ヶ月以上の会期</td><td>受託なら100万円前後〜。有料チケット型はレベニューシェア（初期費用0円）も可／標準1〜3ヶ月</td><td>渋谷サクラステージ「ウワサバナシ調査委員会」</td></tr>
<tr><th scope="row">街歩き周遊型</th><td>商店街・エリアの回遊、協力店舗への送客、観光・地域の話題化</td><td>複数の協力店舗・屋外スポット。数週間〜2ヶ月の会期</td><td>規模により数百万円規模／標準1〜3ヶ月</td><td>下北沢「ロスト・フレーム」</td></tr>
<tr><th scope="row">1空間公演型</th><td>店舗・バー・宿泊施設の夜間集客、ブランド体験、少人数の高密度な体験</td><td>1室・1フロア。60〜90分×複数回公演</td><td>数十万円台〜／既存公演の貸切・出張なら2〜4週間</td><td>六本木「怪盗と秘密の試験」、神田の密室型空間「ANATOR」</td></tr>
</tbody></table></div>
<p class="cmp-note">映像・音響・プロジェクションを演出の一部として組み込むことはありますが、VR・XR・映像単体のコンテンツ制作は当社の主業務ではありません。既存IP・ブランドの世界観を扱う場合は権利者の許諾を前提に、制作範囲（脚本・制作物・キャスト・運営）を契約時に明記します（<a href="/guide/ip-event/" style="color:var(--accent)">IP・キャラクターの体験型イベント制作の進め方</a>）。詳しい条件は<a href="#terms" style="color:var(--accent)">ご依頼の条件</a>をご覧ください。</p>
</div></section>

<section class="section tinted"><div class="wrap">
<p class="eyebrow">FEATURES</p>
<h2 class="h2 serif">ex Labsのイマーシブ制作が選ばれる理由</h2>
<div class="str-grid tag-immersive">
<div class="str-card"><p class="str-num">01</p><h3 class="str-title"><span class="nobr">複数の</span><span class="nobr">イマーシブレーベルを</span><span class="nobr">自社運営</span></h3>
<p class="str-lead"><span class="nobr">アート×体験の「体験する美術館」、</span><span class="nobr">マジック×イマーシブの</span><span class="nobr">「IMMERSIVE ILLUSION」など、</span><span class="nobr">複数の没入型レーベルを</span><span class="nobr">自社で運営しています。</span></p>
<ul class="feature-points"><li>ジャンルごとの体験設計ノウハウを蓄積</li><li>それぞれにファン・集客基盤を形成</li></ul></div>
<div class="str-card"><p class="str-num">02</p><h3 class="str-title"><span class="nobr">街・ブランドと連携した</span><span class="nobr">制作実績</span></h3>
<p class="str-lead"><span class="nobr">渋谷サクラステージや</span><span class="nobr">下北沢の街全体を舞台にした</span><span class="nobr">イマーシブ作品を制作してきました。</span></p>
<ul class="feature-points"><li>実在の街・商店街を舞台にした周遊型の設計力</li><li>ブランドの世界観を体験に落とし込む企画力</li></ul></div>
</div>
</div></section>

<section class="section" id="works"><div class="wrap">
<p class="eyebrow">WORKS</p>
<h2 class="h2 serif">イマーシブの制作実績</h2>
<p class="h2sub">当社のイマーシブの取り組みは、以下のメディアでご紹介いただきました。</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:22px;max-width:920px;margin:0 auto 48px">
{mediaItems.map((m) => (
  <article class="media-item" style="padding:26px 28px">
    <div class="media-feature-head" style="margin-bottom:10px">
      <span class="media-outlet serif" style="font-size:22px">{m.outlet}</span>
      <span class="media-date">{m.date}</span>
    </div>
    <p class="media-title" style="font-size:14px;margin-bottom:0">{m.title}</p>
    {m.url && <p style="margin:14px 0 0"><a class="nobr" href={m.url} target="_blank" rel="noopener" style="color:var(--accent);font-size:13px;font-weight:700">記事を読む（外部サイト）&nbsp;→</a></p>}
  </article>
))}
</div>
<div class="str-grid tag-immersive">
<div class="str-card"><p class="str-num">01</p><h3 class="str-title"><span class="nobr">ウワサバナシ調査委員会</span><span class="nobr">（渋谷サクラステージ）</span></h3>
<p class="str-lead"><span class="nobr">東急不動産様・404 Not Found様・</span><span class="nobr">TSUTAYA様と連携した、</span><span class="nobr">施設全体を周遊する</span><span class="nobr">都市伝説×イマーシブ×謎解き。</span></p>
<ul class="feature-points"><li>商業施設の共有区画・館内導線を「体験の目的地」に転換する施設一体型イマーシブ</li><li>本取り組みは日本経済新聞に掲載</li></ul>
<p class="vc-line" style="margin:16px 0 0;padding-top:12px;text-align:left"><a href="/uwasabanashi/" style="color:var(--accent)">特設サイト →</a></p></div>
<div class="str-card"><p class="str-num">02</p><h3 class="str-title"><span class="nobr">怪盗と秘密の試験</span><span class="nobr">（IMMERSIVE ILLUSION）</span></h3>
<p class="str-lead"><span class="nobr">日本一になった実績のある</span><span class="nobr">マジシャン様とのコラボによる、</span><span class="nobr">六本木の会員制バーを舞台にした</span><span class="nobr">マジック×イマーシブ公演。</span></p>
<ul class="feature-points"><li>実在するバー空間そのものを物語の舞台に変える少人数制の没入体験</li><li>自社レーベル「IMMERSIVE ILLUSION」として企画・制作・運営。本公演は電ファミニコゲーマーで紹介</li></ul>
<p class="vc-line" style="margin:16px 0 0;padding-top:12px;text-align:left"><a href="/kaitou/" style="color:var(--accent)">公演サイト →</a></p></div>
<div class="str-card"><p class="str-num">03</p><h3 class="str-title"><span class="nobr">ロスト・フレーム</span><span class="nobr">（体験する美術館）</span></h3>
<p class="str-lead"><span class="nobr">下北沢の街全体を舞台にした</span><span class="nobr">アート×イマーシブ体験を制作。</span></p>
<ul class="feature-points"><li>街に散らばった絵画を探し、隠された物語を辿る周遊型アートイマーシブ</li><li>絵画と街が交差する、その場所ならではの体験設計</li><li>2026年7月〜8月31日の全公演が完売</li></ul></div>
<div class="str-card"><p class="str-num">04</p><h3 class="str-title"><span class="nobr">ヌル・アーデン展</span><span class="nobr">（自社主催）</span></h3>
<p class="str-lead"><span class="nobr">東京藝術大学出身</span><span class="nobr">アーティストとの</span><span class="nobr">コラボレーションによる、</span><span class="nobr">アート×謎解きを融合した</span><span class="nobr">没入型の展覧会イベントを企画・制作。</span></p>
<ul class="feature-points"><li>アート作品の世界に入り込む、体験としての美術展</li><li>公演終了後には作品オークションも開催</li></ul></div>
</div>
<p class="vc-line" style="margin-top:32px">施設の課題・担当範囲・確認できる結果を項目ごとに整理した事例は<a href="/works/" style="color:var(--accent)">制作事例一覧</a>へ。渋谷サクラステージの<a href="/guide/case-uwasabanashi/" style="color:var(--accent)">制作事例の詳細</a>も公開しています。</p>
</div></section>

<section class="section tinted">
<div class="wrap">
<p class="eyebrow">GALLERY</p>
<h2 class="h2 serif">イマーシブイベントの実績ギャラリー</h2>
<p class="h2sub">ex Labsが企画・制作したイマーシブイベントの数々。</p>
</div>
<div class="hero-works" style="margin-top:48px">
<div class="hero-works-track">
{/* -50%ループの片側コピー（4回分）が4Kの画面幅より広くなるよう8回繰り返す。
    動く帯の中の lazy 画像は読み込みが間に合わず空白に見えるため eager 固定 */}
{[...Array(8)].map((_, i) => (
  <>
  <img src="/assets/events/uwasabanashi-kv.webp" alt={i === 0 ? '渋谷サクラステージの施設一体型イマーシブ「ウワサバナシ調査委員会」' : ''} aria-hidden={i > 0 ? 'true' : undefined} width="880" height="1244" loading="eager" decoding="async">
