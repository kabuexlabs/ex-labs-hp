<script is:inline>
(function(){
  var menu=document.getElementById('menu'),openBtn=document.querySelector('[data-menu-open]');
  function set(open){
    if(open){menu.removeAttribute('hidden')}else{menu.setAttribute('hidden','')}
    document.documentElement.classList.toggle('menu-open',open);
    openBtn.setAttribute('aria-expanded',open?'true':'false');
  }
  openBtn.addEventListener('click',function(){set(true)});
  menu.querySelectorAll('[data-menu-close]').forEach(function(el){el.addEventListener('click',function(){set(false)})});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!menu.hasAttribute('hidden'))set(false)});
  window.matchMedia('(min-width:1200px)').addEventListener('change',function(m){if(m.matches)set(false)});
})();
</script>

