---
// 体験する美術館「7枚目のコンポジション」公式LP（2026.11.21–23／京都市京セラ美術館）。
// デザインはハンドオフ（design_handoff_7th_composition）の再実装。コーポレートサイトとも
// 既存の体験する美術館LP（TaikenbizyutuLayout）ともデザイン系統が別なので、このファイルだけで完結させている。
// 限定公開（URLを知っている人だけが見る前提）：noindex, nofollow。sitemap・llms.txt・ナビには載せない。
// 検索に出すときは INDEXABLE を true にし、sitemap・llms.txt・seo-audit のサブブランド一覧に追加する。
// ［ ］で囲んだ文言は未確定のプレースホルダー（ハンドオフのまま）。決まったら下のデータを書き換える。
const INDEXABLE = false;
import SiteGuard from '../../../components/SiteGuard.astro';

// ---- 未定の項目（決まったらここを埋める） ----
// 購入先URL。null の間はチケットボタンをすべて #ticket へのアンカーにする
const TICKET_URL: string | null = null;
// 地図の埋め込みURL（Google マップの「地図を埋め込む」の src）。null の間は枠だけ表示
const MAP_EMBED_URL: string | null = null;

const ticketHref = TICKET_URL ?? '#ticket';
const ticketAttrs = TICKET_URL
  ? { target: '_blank', rel: 'noopener', 'data-track': 'ticket', 'data-show': '7th-composition' }
  : {};

const title = '体験する美術館「7枚目のコンポジション」公式サイト｜京都市京セラ美術館 2026.11.21–23';
const canonical = 'https://kabuexlabs.com/taikenbizyutu/7th-composition/';
const ogImage = 'https://kabuexlabs.com/assets/7th-composition/og.jpg';
const description =
  '絵画×イマーシブ。体験する美術館「7枚目のコンポジション」2026年11月21日（土）〜23日（月）京都市京セラ美術館にて開催。絵画を鑑賞することで物語の中に巻き込まれていく60分のイマーシブ体験。1名4,500円、各回最大30名、1名から参加可能。';

const nav = [
  ['story', 'ストーリー', 'Story'], ['experience', '体験について', 'Experience'], ['team', '制作チーム', 'Creators'],
  ['cast', 'キャスト', 'Cast'], ['ticket', 'チケット', 'Ticket'], ['flow', '当日の流れ', 'Flow'],
  ['access', 'アクセス', 'Access'], ['faq', 'よくある質問', 'Q&A'], ['contact', 'お問い合わせ', 'Contact'],
].map(([id, ja, en]) => ({ href: '#' + id, ja, en }));

// お知らせ（日付が確定したものを載せる）
const news: { date: string; text: string }[] = [{ date: '2026.—.—', text: '［お知らせ内容 未定］' }];

// キャスト（写真・プロフィールは荒巻まりの より提供予定）
const cast: { name: string; roman: string; profile: string; photo?: string }[] = [1, 2, 3].map(() => ({
  name: '［出演者名］',
  roman: 'Name',
  profile: '［プロフィール　荒巻まりの より提供予定］',
}));

const kv = (arr: string[][]) => arr.map(([k, v]) => ({ k, v }));
const ticketRows = kv([
  ['開催日', '2026年11月21日（土）・22日（日）・23日（月）'], ['料金', '1名4,500円［税込・税別は要確認］'],
  ['割引', 'なし'], ['別途入館料', 'なし'], ['公演時間', '60分'], ['公演回数', '各日7公演'],
  ['定員', '各回30名'], ['最少催行人数', '各回12名'], ['対象年齢', '18歳以上'], ['1名での参加', '可能'],
  ['服装', '動きやすい服装でお越しください'], ['私物の持ち込み', '不可'], ['販売開始日時', '［未定］'],
  ['購入先URL', TICKET_URL ?? '［未定］'], ['販売締切', '開演1時間前'],
]);
const schedule = [
  ['第1回', '12:00', '13:00'], ['第2回', '12:45', '13:45'], ['第3回', '13:30', '14:30'], ['第4回', '14:15', '15:15'],
  ['第5回', '15:00', '16:00'], ['第6回', '15:45', '16:45'], ['第7回', '16:30', '17:30'],
];
const notes = [
  '本公演は18歳以上の方を対象としています。', '動きやすい服装でお越しください。',
  '遅刻は厳禁です。指定時刻に1分でも遅れた場合はご参加いただけません。', '体験中の撮影はできません。',
  '公演内容のネタバレは禁止です。', 'チケット購入後のお客様都合によるキャンセルはお受けできません。',
];
const ngList = ['途中退出・再入場', '録音', '日時変更', '主催者都合で中止した場合の返金', '最少催行人数に満たない場合の実施判断・連絡・返金'];
const accessRows = kv([
  ['会場名', '京都市京セラ美術館'], ['使用会場', '講演室・多目的ホール'],
  ['受付・集合場所', '［確認中｜松崎圭佑］'], ['使用室の階・館内経路', '［確認中｜松崎圭佑］'],
  ['住所・最寄り駅・地図', '［確認中｜松崎圭佑］'], ['バリアフリー対応', 'なし'], ['荷物預かり', 'なし'],
]);
const faqs = [
  ['1人でも参加できますか？', 'はい。1名様からご参加いただけます。'],
  ['年齢制限はありますか？', '18歳以上の方を対象としています。'],
  ['公演時間はどのくらいですか？', '60分です。'],
  ['チケット代以外に入館料はかかりますか？', '本公演への参加にあたり、別途入館料はかかりません。'],
  ['割引はありますか？', '割引はございません。'],
  ['服装の指定はありますか？', '動きやすい服装でお越しください。'],
  ['私物は持ち込めますか？', '体験エリアへの私物の持ち込みは可能ですが、クロークはございません。可能な限り身軽な格好でお越しください。'],
  ['遅刻しても参加できますか？', '指定時刻に1分でも遅れた場合はご参加いただけません。'],
  ['体験中に撮影できますか？', '体験中の撮影はできません。また、公演内容のネタバレは禁止です。'],
  ['購入後にキャンセルできますか？', 'お客様都合によるキャンセルはお受けできません。'],
];
const credits = kv([
  ['絵画', '伊藤ゆきの'], ['ディレクター・シナリオ・デザイン', '荒巻まりの'], ['ゲームデザイン', '御湯波ライト'],
  ['プロデューサー', 'かるら'], ['企画', '株式会社ex Labs'],
]);
const [leadCredit, ...restCredits] = credits;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: '体験する美術館「7枚目のコンポジション」',
  alternateName: 'The 7th Composition',
  description,
  image: 'https://kabuexlabs.com/assets/7th-composition/kv.webp',
  url: canonical,
  startDate: '2026-11-21T12:00:00+09:00',
  endDate: '2026-11-23T17:30:00+09:00',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: '京都市京セラ美術館', address: { '@type': 'PostalAddress', addressLocality: '京都市', addressRegion: '京都府', addressCountry: 'JP' } },
  organizer: { '@type': 'Organization', name: '株式会社ex Labs', url: 'https://kabuexlabs.com/' },
  offers: { '@type': 'Offer', price: 4500, priceCurrency: 'JPY', url: TICKET_URL ?? canonical },
};
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{!INDEXABLE && <meta name="robots" content="noindex, nofollow">}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="体験する美術館「7枚目のコンポジション」">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#861E3E">
{INDEXABLE && <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Italiana&family=Shippori+Mincho:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap" rel="stylesheet">
<link rel="preload" as="image" href="/assets/7th-composition/kv.webp">
<SiteGuard />
</head>
<body>
<div class="page">

<header class="hd">
  <div class="hd-in">
    <a href="#top" class="logo">
      <span class="logo-s">体験する美術館</span>
      <span class="logo-m">7枚目のコンポジション</span>
    </a>
    <nav class="hd-nav" aria-label="ページ内メニュー">
      {nav.map((n) => <a href={n.href}>{n.ja}</a>)}
    </nav>
    <span class="hd-sp"></span>
    <a href={ticketHref} {...ticketAttrs} data-place="header" class="btn glow hd-buy">チケットを購入する</a>
    <button type="button" class="circ hd-menu" aria-label="メニュー" aria-controls="menu" aria-expanded="false" data-menu-open>
      <span></span><span></span>
    </button>
  </div>
</header>

<div id="menu" class="menu" hidden>
  <div class="menu-hd">
    <span class="menu-t">Menu</span>
    <button type="button" class="circ menu-x" aria-label="閉じる" data-menu-close>×</button>
  </div>
  <nav class="menu-nav" aria-label="メニュー">
    {nav.map((n) => (
      <a href={n.href} data-menu-close><span class="ja">{n.ja}</span><span class="en">{n.en}</span></a>
    ))}
  </nav>
  <a href={ticketHref} {...ticketAttrs} data-place="menu" class="btn glow menu-buy" data-menu-close>チケットを購入する</a>
</div>

<main>
<section id="top" class="hero">
  <div class="hero-in">
    <div class="hero-vis">
      <img src="/assets/7th-composition/kv.webp" alt="7枚目のコンポジション 公演ビジュアル" width="1075" height="1523" fetchpriority="high">
    </div>
    <div class="hero-txt">
      <div class="hero-tate">
        <h1>体験する美術館<span class="sr">「7枚目のコンポジション」</span></h1>
        <p class="bodoni">The 7th Composition</p>
      </div>
      <div class="hero-main">
        <p class="genre"><span>絵画</span><span class="bodoni x">×</span><span>イマーシブ</span></p>
        <div class="date bodoni">
          <div class="yr">2026</div>
          <div class="big">11.21<span class="badge"><span>Sat</span></span></div>
          <div class="row2">
            <div class="at"><span class="bodoni">at</span>京都市<br>京セラ美術館</div>
            <div class="slash"></div>
            <div class="big">23<span class="badge"><span>Mon</span></span></div>
          </div>
        </div>
        <p class="catch">あるはずのない記憶に導かれ、<br>交錯する未来へ——</p>
        <p class="en-detail bodoni">Taiken-suru Bijutsukan<br>THE 7TH COMPOSITION<br>2026.11.21(Sat) - 11.23(Mon)<br>at Kyoto City KYOCERA Museum of Art</p>
        <div>
          <a href={ticketHref} {...ticketAttrs} data-place="hero" class="btn glow btn-l">チケットを購入する<span class="bodoni">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="news" class="news">
  <div class="w880">
    <div class="news-hd">
      <h2 class="italiana">News</h2>
      <span>お知らせ</span>
    </div>
    {news.map((n) => (
      <div class="news-row"><span class="bodoni d">{n.date}</span><span>{n.text}</span></div>
    ))}
  </div>
</section>

<section id="story" class="sec story">
  <div class="story-circle" aria-hidden="true"></div>
  <div class="story-line" aria-hidden="true"></div>
  <div class="w880 rel">
    <div class="sh"><div class="sh-r"><span class="orn">+·◎·</span><h2>Story</h2><span class="orn">+·◎·</span></div><p>ストーリー</p></div>
    <p class="story-lead">あるはずのない記憶に導かれ、交錯する未来へ——</p>
    <p class="story-h glow-t">［あらすじ 見出し］</p>
    <p class="body">［あらすじ本文　荒巻まりの・right より提供予定］</p>
  </div>
</section>

<section id="experience" class="sec">
  <div class="w1080">
    <div class="sh"><div class="sh-r"><span class="orn">+·◎·</span><h2>Experience</h2><span class="orn">+·◎·</span></div><p>体験について</p></div>
    <div class="exp-lead">
      <p class="exp-h glow-t">『鑑賞するアート』から<br>『体験するアート』へ</p>
      <p class="body">体験する美術館は、「『鑑賞するアート』から『体験するアート』へ」をテーマにした、絵画を鑑賞することで物語の中に観客が巻き込まれていくイマーシブ体験です。</p>
    </div>
    <div class="spec">
      <div><span class="lb">+・体験ジャンル</span><span class="genre-v">絵画 × イマーシブ</span></div>
      <div><span class="lb">+・公演時間</span><span class="num"><span class="bodoni n">60</span><span>分</span></span></div>
      <div><span class="lb">+・参加人数</span><span class="num"><span>各回最大</span><span class="bodoni n">30</span><span>名</span></span></div>
      <div><span class="lb">+・おひとりさま</span><span class="num"><span class="bodoni n">1</span><span>名から参加可能</span></span></div>
    </div>
    <div class="hl">
      <div class="hl-img" aria-hidden="true"></div>
      <div class="hl-txt">
        <p class="hl-t italiana">Highlights<span></span></p>
        <p class="hl-h">具体的な体験方法・見どころ</p>
        <p class="hl-b">京都市京セラ美術館の2部屋を活用した物語体験コンテンツ。</p>
      </div>
    </div>
  </div>
</section>

<section id="team" class="sec">
  <div class="w880">
    <div class="sh"><div class="sh-r"><span class="orn">+·◎·</span><h2>Creators</h2><span class="orn">+·◎·</span></div><p>制作チーム</p></div>
    <div class="team">
      <div class="team-lead">
        <span class="role">+・{leadCredit.k}・+</span>
        <span class="name">{leadCredit.v}</span>
      </div>
      <div class="team-grid">
        {restCredits.map((c) => (
          <div><span class="role">+・{c.k}・+</span><span class="name">{c.v}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="cast" class="sec">
  <div class="w1160">
    <div class="sh"><div class="sh-r"><span class="orn">+·◎·</span><h2>Cast</h2><span class="orn">+·◎·</span></div><p>キャスト</p></div>
    <div class="cast">
      {cast.map((c) => (
        <div class="card">
          <div class="card-tab"></div>
          <div class="card-body">
            {c.photo
              ? <img class="card-ph" src={c.photo} alt={c.name} loading="lazy">
              : <div class="card-ph ph">cast photo</div>}
            <p class="card-pf italiana">Profile<span></span></p>
            <div>
              <p class="card-name">{c.name}</p>
              <p class="card-roman bodoni">{c.roman}</p>
            </div>
            <p class="card-txt">{c.profile}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="ticket" class="sec panel-sec">
  <div class="panel">
    <div class="sh sh-56"><div class="sh-r"><span class="orn">+·◎·</span><h2>Ticket</h2><span class="orn">+·◎·</span></div><p>チケット・開催情報</p></div>
    <div class="price">
      <span class="lb">+・料金・+</span>
      <span class="price-v"><span class="p1">1名</span><span class="bodoni pn">4,500</span><span class="p2">円</span></span>
      <span class="price-note">［税込・税別は要確認］</span>
    </div>
    <div class="info">
      {ticketRows.map((r) => (
        <div class="info-row"><span class="k">+・{r.k}</span><span class="v">{r.v}</span></div>
      ))}
    </div>
    <div class="sched">
      <p class="sched-t italiana">Schedule</p>
      <p class="sched-s">3日間共通の公演スケジュール</p>
      <div class="sched-tb">
        <div class="sched-hd"><span>公演回</span><span>開始</span><span>終演</span></div>
        {schedule.map(([no, s, e]) => (
          <div class="sched-row"><span class="no">{no}</span><span class="bodoni t">{s}</span><span class="bodoni t e">{e}</span></div>
        ))}
        <p class="sched-note">※受付・事前説明・退場を含む総所要時間は60分間です。</p>
      </div>
    </div>
    <div class="ticket-cta">
      <a href={ticketHref} {...ticketAttrs} data-place="ticket" class="btn glow btn-xl">チケットを購入する<span class="bodoni">→</span></a>
    </div>
  </div>
</section>

<section id="flow" class="sec">
  <div class="w1160">
    <div class="sh"><div class="sh-r"><span class="orn">+·◎·</span><h2>Flow</h2><span class="orn">+·◎·</span></div><p>当日の流れ</p></div>
    <div class="flow">
      <div><span class="bodoni fn">01</span><span class="fh">受付</span></div>
      <div><span class="bodoni fn">02</span><span class="fh">参加準備・事前説明</span></div>
      <div class="gold"><span class="bodoni fn">03</span><span class="fh">体験開始</span><span class="fd">絵画を通して物語に巻き込まれていく、60分のイマーシブ体験</span></div>
      <div><span class="bodoni fn">04</span><span class="fh">体験終了・退場</span></div>
    </div>
  </div>
</section>

<section id="attention" class="sec">
  <div class="w820">
    <div class="sh sh-40"><div class="sh-r"><span class="orn">+·◎·</span><h2>Attention</h2><span class="orn">+·◎·</span></div><p>注意事項</p></div>
    <div class="deco" aria-hidden="true"><span class="l"></span><span class="bodoni">+·◇·+</span><span class="r"></span></div>
    <ul class="att">{notes.map((t) => <li>{t}</li>)}</ul>
    <p class="att-h">以下の扱いは不可能です。</p>
    <ul class="att">{ngList.map((t) => <li>{t}</li>)}</ul>
    <div class="deco deco-b" aria-hidden="true"><span class="l"></span><span class="bodoni">+·◇·+</span><span class="r"></span></div>
  </div>
</section>

<section id="access" class="sec panel-sec">
  <div class="panel">
    <div class="sh sh-56"><div class="sh-r"><span class="orn">+·◎·</span><h2>Access</h2><span class="orn">+·◎·</span></div><p>会場・アクセス</p></div>
    <div class="acc">
      <div class="acc-info">
        {accessRows.map((r) => (
          <div class="info-row"><span class="k">+・{r.k}</span><span class="v">{r.v}</span></div>
        ))}
      </div>
      {MAP_EMBED_URL
        ? <iframe class="map" src={MAP_EMBED_URL} title="京都市京セラ美術館の地図" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        : <div class="map ph">map embed</div>}
    </div>
  </div>
</section>

<section id="faq" class="sec">
  <div class="w880">
    <div class="sh sh-56"><div class="sh-r"><span class="orn">+·◎·</span><h2>Q&amp;A</h2><span class="orn">+·◎·</span></div><p>よくある質問</p></div>
    <div class="faq">
      {faqs.map(([q, a], i) => (
        <details open={i === 0}>
          <summary><span class="bodoni q">Q.</span><span class="qt">{q}</span><span class="bodoni sign" aria-hidden="true"></span></summary>
          <div class="ans"><span class="bodoni a">A.</span><p>{a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="contact" class="sec contact">
  <div class="w880 center">
    <div class="sh sh-48"><div class="sh-r"><span class="orn">+·◎·</span><h2>Contact</h2><span class="orn">+·◎·</span></div><p>お問い合わせ</p></div>
    <p class="contact-t">公演に関するお問い合わせは、下記メールアドレスまでご連絡ください。</p>
    <a href="mailto:info@kabuexlabs.com" class="mail bodoni">info@kabuexlabs.com<span class="ic">↗</span></a>
  </div>
</section>
</main>

<footer class="ft">
  <span aria-hidden="true" class="ft-big ft-big1">7枚目の</span>
