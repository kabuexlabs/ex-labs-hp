---
// 体験する美術館 トップページ。
// 川久ミュージアム (museum-kawakyu.jp) を参考にしたリデザイン：
// セクションごとに色面を切り替え、写真は額装マットで囲んでコラージュ配置、
// 大判のセリフ英字見出し・円形の MORE・リング状テキストを用いる。
// 公演情報・NEWS・FAQ・クリエイター・絵画は src/data/taikenbizyutu.ts に集約している。
import TaikenbizyutuLayout from '../../layouts/TaikenbizyutuLayout.astro';
import TaikenbizyutuContactForm from '../../components/TaikenbizyutuContactForm.astro';
import { jsonLd } from '../../lib/microcms';
import { TICKET_URL, LOST_FRAME, CREATORS, TB_NEWS, TB_FAQS, TB_X_URL, LOST_FRAME_ARTS, NULL_ARDEN_ARTS } from '../../data/taikenbizyutu';

const assets = '/assets/taikenbizyutu';
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const soldOut = LOST_FRAME.status === 'soldout';

// ART コラージュ: 最新公演の絵画を先頭に、過去公演の絵画を続ける。
const arts = [...LOST_FRAME_ARTS, ...NULL_ARDEN_ARTS];
// ヒーロー直下の帯に並べる3点
const strip = LOST_FRAME_ARTS.slice(0, 3);
// ABOUT の円形ブロックの背景に敷く絵画
const aboutBg = LOST_FRAME_ARTS[1]?.src ?? LOST_FRAME_ARTS[0].src;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: TB_FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${LOST_FRAME.name}（${LOST_FRAME.nameEn}）`,
  description: LOST_FRAME.description,
  image: new URL(LOST_FRAME.image, site).toString(),
  url: new URL(LOST_FRAME.path, site).toString(),
  startDate: LOST_FRAME.startDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  duration: LOST_FRAME.durationIso,
  location: {
    '@type': 'Place',
    name: '東京・下北沢エリア各所',
    address: { '@type': 'PostalAddress', addressLocality: '世田谷区', addressRegion: '東京都', addressCountry: 'JP' },
  },
  organizer: { '@type': 'Organization', name: '株式会社ex Labs', url: 'https://kabuexlabs.com/' },
  performer: { '@type': 'Organization', name: '体験する美術館', url: new URL('/taikenbizyutu/', site).toString() },
  offers: {
    '@type': 'AggregateOffer',
    url: TICKET_URL,
    priceCurrency: 'JPY',
    lowPrice: Math.min(...LOST_FRAME.prices.map((x) => x.price)),
    highPrice: Math.max(...LOST_FRAME.prices.map((x) => x.price)),
    availability: soldOut ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    validFrom: LOST_FRAME.startDate,
  },
};

const ringText = 'TAIKEN SURU BIJUTSUKAN — EXPERIENTIAL ART MUSEUM — ';
---

<TaikenbizyutuLayout hero>
<Fragment slot="head">
  <script type="application/ld+json" set:html={jsonLd(faqLd)} />
  <script type="application/ld+json" set:html={jsonLd(eventLd)} />
</Fragment>

{/* ---------- HERO：上半分は墨、下半分は灰紫。キービジュアルが境界をまたぐ ---------- */}
<section id="top" class="hero">
  <div class="hero-top">
    <div class="herox hero-el e0"><span>絵&nbsp;画</span><span class="xmark">×</span><span>体&nbsp;験</span><span class="xmark">×</span><span>交&nbsp;流</span></div>
    <h1 class="heromark-h1 hero-el e1"><img class="heromark" src={`${assets}/logo-white.webp`} alt="体験する美術館" width="1000" height="487"><span class="sr-only">体験する美術館｜下北沢の街を巡る参加型アート・周遊型アートイマーシブ｜絵画と物語、街歩き謎解きの体験</span></h1>
    <p class="herolead m0 hero-el e2">鑑賞するアートから、<wbr>体験するアートへ。</p>
    <p class="note tc m0 hero-el e3" style="letter-spacing:.14em">絵画と物語、観客の参加を編み込んだ<wbr>参加型芸術のレーベル</p>
  </div>
  <div class="hero-kv hero-el e4">
    <a href={LOST_FRAME.path} aria-label="最新の公演『ロスト・フレーム』を見る"><img src={`${assets}/lost-frame.webp`} alt="ロスト・フレーム キービジュアル" width="900" height="1281"></a>
  </div>
</section>

{/* 絵画3点の帯 */}
<div class="strip">
  <div class="strip-in">
    {strip.map((a) => (
      <a class="strip-item" href="#art"><img src={a.src} alt={a.alt} width={a.width || undefined} height={a.height || undefined} loading="lazy"></a>
    ))}
  </div>
</div>

{/* ---------- CONCEPT（藍）：ずらし組みの見出しとステートメント ---------- */}
<section id="concept" class="sec bg-navy">
  <div class="wrapc">
    <h2 class="stag rv"><span>鑑賞するアートから、</span><span>体験するアートへ。</span><span>絵画の側から立ち上がる時間。</span></h2>
    <div class="concept-body rv d1">
      <p class="lead m0">「体験する美術館」は、“鑑賞するアート”を“体験するアート”へと問い直す、参加型芸術のレーベルです。ハプニングや参加型アート、関係性の美学の系譜では絵画は乗り越えの対象でしたが、本レーベルは逆に、絵画の側から上演性と時間を回復する試みに取り組んでいます。</p>
      <p class="lead" style="margin:24px 0 0">閉館後の美術館、使用されていない展示会場、そして街そのもの——。公演ごとに会場を変えながら、絵画と物語、そして観客の参加による絵画鑑賞の場を立ち上げています。</p>
    </div>
    <div class="concept-more rv d2"><a class="circ" href="#about">MORE</a></div>
  </div>
</section>

{/* ---------- WORKS（葡萄）：大判見出しと額装ポスターのコラージュ ---------- */}
<section id="works" class="sec bg-plum">
  <div class="wrapc">
    <p class="kicker rv">Works</p>
    <h2 class="disp rv d1">Works</h2>
    <p class="h2 rv d1" style="margin-top:8px">公演一覧</p>
    <div class="works-grid rv d2">
      <div class="work">
        <a class="mat" href={LOST_FRAME.path}><img src={`${assets}/lost-frame.webp`} alt="ロスト・フレーム キービジュアル" width="900" height="1281" loading="lazy"></a>
        <div class="work-body">
          {soldOut ? <span class="sold">第二弾 ─ SOLD OUT</span> : <span class="badge">第二弾 ─ 受付中</span>}
          <p class="ewtitle">ロスト・フレーム</p>
          <p class="ewsub en m0">Lost Frame</p>
          <p class="cdesc" style="margin:14px 0 0">絵画と街が交差する、街を巡る参加型の絵画鑑賞。会場は東京・下北沢の街そのもの。</p>
          <a class="artlink" href={LOST_FRAME.path}><span class="arw">→</span><span>公演詳細を見る</span></a>
          <a class="artlink" href={LOST_FRAME.spoilerPath}><span class="arw">→</span><span>公演記録（ネタバレ）を読む</span></a>
        </div>
      </div>
      <div class="work work-up">
        <span class="mat"><img src={`${assets}/null-arden.webp`} alt="ヌル・アーデン展 キービジュアル" width="900" height="1267" loading="lazy"></span>
        <div class="work-body">
          <span class="sold">第一弾 ─ SOLD OUT</span>
          <p class="ewtitle">ヌル・アーデン展</p>
          <p class="ewsub en m0">Null Arden Exhibition</p>
          <p class="cdesc" style="margin:14px 0 0">名以外を持たぬ画家「ヌル・アーデン」の個展を会場に、絵画と物語、図像の読解による参加型の展示。全公演、満席にて終了しました。</p>
          <a class="artlink" href="/game/null-arden/"><span class="arw">→</span><span>ネタバレ公開特設サイトで解説を読む</span></a>
          <a class="artlink" href="/game/auction/"><span class="arw">→</span><span>作品オークションの記録を読む</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ---------- NEWS（生成り） ---------- */}
<section id="news" class="sec bg-cream">
  <div class="wrapc">
    <p class="kicker rv">News</p>
    <h2 class="disp rv d1">News</h2>
    <p class="h2 rv d1" style="margin-top:8px">お知らせ</p>
    <div class="newslist rv d2">
      {TB_NEWS.map((n) => (
        <div class="newsrow">
          <time class="ndate" datetime={n.iso}>{n.date}</time>
          <span>
            {n.text}
            {n.link && (
              <>（<a href={n.link.href} target={n.link.external ? '_blank' : undefined} rel={n.link.external ? 'noopener' : undefined}>{n.link.label}</a>）</>
            )}
          </span>
        </div>
      ))}
    </div>
    <p class="note rv" style="margin-top:24px">最新情報は<a href={TB_X_URL} target="_blank" rel="noopener">公式X（@taikenbizyutu）</a>にて随時お知らせします。</p>
  </div>
</section>

{/* ---------- 最新公演（墨） ---------- */}
<section id="lostframe" class="sec bg-char">
  <div class="wrapc">
    <div class="evgrid">
      <div class="rv"><span class="mat"><img src={`${assets}/lost-frame.webp`} alt="ロスト・フレーム キービジュアル" width="900" height="1281" loading="lazy"></span></div>
      <div class="rv d1">
        {soldOut ? <span class="sold">最新公演 ─ 第二弾 完売御礼</span> : <span class="badge">最新公演 ─ 第二弾</span>}
        <h2 class="evtitle">ロスト・フレーム</h2>
        <p class="evsub en">Lost Frame</p>
        <p class="lead" style="margin:28px 0 0">下北沢の街に散らばった絵画を探し、<wbr>隠された物語を辿る……<br>絵画と街が交差する、<wbr>街を巡る参加型の絵画鑑賞。</p>
        <div class="story" style="margin-top:28px">
          <p class="m0">『ロスト・フレーム』は、街を巡りながら絵画と物語に出会い、絵画に埋め込まれた図像や作中言語を読み解いていく、参加型の絵画鑑賞の公演です。</p>
          <p style="margin:16px 0 0">下北沢エリアの店舗様との連携により、街に点在する場所を巡り、手描きの絵画と物語を軸にした鑑賞のなかで、登場人物と実際に言葉を交わす——観客の関わりによって絵画が意味を帯びていく、新しい絵画鑑賞のかたちに立ち会っていただきます。</p>
          <p style="margin:16px 0 0">観客の選択によって、物語は異なる結末へと分岐します。</p>
        </div>
        <div class="dl" style="margin-top:36px">
          <div class="dlrow"><span class="dt">エリア</span><span>{LOST_FRAME.area}</span></div>
          <div class="dlrow"><span class="dt">形式</span><span>{LOST_FRAME.format}</span></div>
          <div class="dlrow"><span class="dt">所要時間</span><span>{LOST_FRAME.duration}</span></div>
          <div class="dlrow"><span class="dt">定員</span><span>{LOST_FRAME.capacity}</span></div>
          <div class="dlrow"><span class="dt">参加費</span><span>{LOST_FRAME.prices.map((x) => `${x.price.toLocaleString('ja-JP')}円（${x.people}名参加）`).join(' ／ ')}<br><span class="note">※1人あたり</span></span></div>
          <div class="dlrow"><span class="dt">参加のお申し込み</span><span>{soldOut ? <>全公演 完売しました（<a href={LOST_FRAME.soldoutNewsPath}>お知らせ</a>）</> : <a href={TICKET_URL} target="_blank" rel="noopener">お申し込みページへ →</a>}</span></div>
        </div>
        <div class="fx gap16 wrap" style="margin-top:32px">
          {soldOut ? <span class="bigx soldbtn" aria-disabled="true">全公演 完売しました</span> : <a class="bigx" href={TICKET_URL} target="_blank" rel="noopener">参加を申し込む</a>}
          <a class="bigx" href={LOST_FRAME.path}>公演詳細を見る</a>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ---------- ABOUT（生成り）：リング状テキストの円形ブロック ---------- */}
<section id="about" class="sec bg-cream about">
  <div class="wrapc">
    <div class="ring rv" style={`background-image:url(${aboutBg})`}>
      <div class="disc">
        <svg class="ringtxt" viewBox="0 0 500 500" aria-hidden="true">
          <defs><path id="ringpath" d="M250,250 m-215,0 a215,215 0 1,1 430,0 a215,215 0 1,1 -430,0"/></defs>
          <text><textPath href="#ringpath">{ringText}{ringText}</textPath></text>
        </svg>
        <div class="disc-in">
          <p class="kicker">About</p>
          <h2 class="h2" style="margin-top:6px">『体験する美術館』とは</h2>
          <p class="disc-lead">「体験する美術館」は、“鑑賞するアート”を“体験するアート”へと問い直す、参加型芸術のレーベルです。絵画の側から上演性と時間を回復する試みに取り組んでいます。</p>
        </div>
      </div>
    </div>
    <div class="grid3 rv d1">
      <div class="card3">
        <div class="num">01</div>
        <h3 class="h3">物語の中で、絵画と出会う。</h3>
        <p class="body14 m0">画家やイラストレーターが、その公演のためだけに描き下ろした絵画。作品に埋め込まれた図像や作中言語を読み解きながら、鑑賞そのものに観客が参加していきます。</p>
      </div>
      <div class="card3">
        <div class="num">02</div>
        <h3 class="h3">美術家の創作を更新する。</h3>
        <p class="body14 m0">鑑賞の順序が可変であることを前提に描かれる絵画——観客の選択によって意味が変わる図像構成は、タブローの制作方法そのものに関わる実験です。美術家との共同制作を通じて、絵画表現の新たな発表・展開の機会を生み出します。</p>
      </div>
      <div class="card3">
        <div class="num">03</div>
        <h3 class="h3">作品が新たな手へ渡る。</h3>
        <p class="body14 m0">公演終了後には、公演内で用いられた作品のオークションを開催。作品が鑑賞の記憶とともに新たな持ち主のもとへ渡る機会を設けています。</p>
        <p class="note" style="margin:12px 0 0">※『ロスト・フレーム』におけるオークションの実施は未定です。</p>
      </div>
    </div>
  </div>
</section>

{/* ---------- MODEL（灰）：テキスト主体の案内 ---------- */}
<section id="model" class="sec bg-grey">
  <div class="wrapc">
    <p class="kicker rv">Model</p>
    <h2 class="h2 rv d1">地域とクリエイターをつなぐ、<wbr>新たなモデル</h2>
    <div class="grid3 rv d2" style="margin-top:56px">
      <div class="card3">
        <div class="num">舞台</div>
        <h3 class="h3">街や施設が、美術館になる。</h3>
        <p class="body14 m0">閉館後の美術館、使用されていない展示会場、店舗の一部スペース、そして街そのもの——公演ごとに、その場所ならではの舞台を立ち上げます。会場となる店舗様・施設様には、新たな来店・認知獲得の機会となります。</p>
      </div>
      <div class="card3">
        <div class="num">回遊</div>
        <h3 class="h3">地域全体への送客に。</h3>
        <p class="body14 m0">公演の参加者が絵画を探して会場や街を巡ることで、地域全体への回遊・来訪にもつながります。</p>
      </div>
      <div class="card3">
        <div class="num">運営</div>
        <h3 class="h3">初期費用のご負担なく。</h3>
        <p class="body14 m0">株式会社ex Labsが集客から企画・運営までを一括して担うため、施設・店舗側は初期費用をご負担いただくことなく認知を獲得できるスキームを採用しています。</p>
      </div>
    </div>
  </div>
</section>

{/* ---------- CREATORS ＋ ART（葡萄）：コレクション風のコラージュ ---------- */}
<section id="creators" class="sec bg-plum" style="padding-bottom:0">
  <div class="wrapc">
    <p class="kicker rv">Creators</p>
    <h2 class="h2 rv d1">絵画クリエイター</h2>
    <p class="lead muted rv d2" style="margin:24px 0 0;max-width:720px">本企画には、東京藝術大学出身者や漫画家など、多様なジャンルで活躍するクリエイターが絵画制作に参画しています。</p>
    <div class="cnames rv d2" style="margin-top:40px">
      {CREATORS.map((c) => (
        <div class="cnameplate"><span class="cnn">{c.name}</span></div>
      ))}
    </div>
    <p class="note rv" style="margin-top:20px">※敬称略・順不同。</p>
  </div>
</section>

<section id="art" class="sec bg-plum">
  <div class="wrapc">
    <p class="kicker rv">Art</p>
    <h2 class="disp rv d1">Art<br>Collection</h2>
    <p class="lead muted rv d2" style="margin:28px 0 0;max-width:720px">各公演のために描き下ろされた、手描きの絵画作品。物語の鍵として会場に展示され、公演終了後にはオークションを通じて新たな持ち主のもとへ。</p>
    <div class="collage rv d2" style="margin-top:64px">
      {arts.map((a) => (
        <figure class="m0">
          <span class="mat"><img src={a.src} alt={a.alt} width={a.width || undefined} height={a.height || undefined} loading="lazy"></span>
          <figcaption class="mcap">{a.caption}</figcaption>
        </figure>
      ))}
    </div>
    <p class="note tc rv" style="margin:64px 0 0">ここに掲載しているのは一部です。ほかにも多数の作品がございます。<br>『ロスト・フレーム』の絵画は<a href={LOST_FRAME.spoilerPath}>公演記録ページ</a>でも紹介しています（ネタバレを含みます）。</p>
  </div>
</section>

{/* ---------- FAQ（生成り） ---------- */}
<section id="faq" class="sec bg-cream">
  <div class="wrapc" style="max-width:860px">
    <p class="kicker rv">FAQ</p>
    <h2 class="h2 rv d1">よくある質問</h2>
    <div style="margin-top:44px">
      {TB_FAQS.map((f) => (
        <details class="faqit rv">
          <summary class="faqq"><span class="qmark">Q</span>{f.q}</summary>
          <p class="faqa">
            {f.a}
            {f.link && (
              <a class="faqlink" href={f.link.href} target={f.link.external ? '_blank' : undefined} rel={f.link.external ? 'noopener' : undefined}>→ {f.link.label}</a>
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

{/* ---------- CONTACT（墨） ---------- */}
<section id="contact" class="sec bg-char">
  <div class="wrapc tc">
    <p class="kicker rv">Contact</p>
    <h2 class="h2 rv d1">お問い合わせ</h2>
    <div class="fx jc gap24 wrap" style="margin-top:48px">
      <div class="card3 ccard rv"><p class="ctitle m0">取材・メディアの方</p><p class="cdesc" style="margin:10px 0 0">本レーベル・各公演に関する取材のご相談を承ります。</p></div>
      <div class="card3 ccard rv d1"><p class="ctitle m0">店舗・施設の方</p><p class="cdesc" style="margin:10px 0 0">イベント連携・スペース活用のご相談を承ります。</p></div>
      <div class="card3 ccard rv d2"><p class="ctitle m0">クリエイターの方</p><p class="cdesc" style="margin:10px 0 0">絵画制作への参画のご相談を承ります。</p></div>
    </div>
    <TaikenbizyutuContactForm />
  </div>
</section>

</TaikenbizyutuLayout>

<style>
/* ---- HERO ---- */
.hero{position:relative;background:var(--char);text-align:center;overflow:hidden}
.hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:46%;background:var(--mauve);z-index:0}
.hero>*{position:relative;z-index:1}
.hero-top{padding:128px 24px 48px}
.heromark-h1{margin:0;line-height:0;font-size:inherit;font-weight:inherit}
.heromark{width:min(420px,66vw);height:auto}
.herox{font-size:14px;letter-spacing:.3em;color:#cfc8bc;display:flex;justify-content:center;align-items:center;gap:12px;margin-bottom:28px}
.xmark{color:var(--gold);font-size:11px}
.herolead{font-size:17px;letter-spacing:.24em;color:#ece7df;margin-top:32px !important}
.hero .note{margin-top:10px !important}
.hero-kv{padding:0 24px 56px}
.hero-kv img{display:block;width:min(440px,78vw);height:auto;margin:0 auto;box-shadow:0 24px 60px rgba(0,0,0,.45)}
.hero-kv a:hover{opacity:1}
/* 絵画3点の帯 */
.strip{background:#c9c6c6;padding:26px 22px}
.strip-in{display:grid;grid-template-columns:repeat(3,1fr);gap:0;max-width:1120px;margin:0 auto}
.strip-item{display:block;aspect-ratio:3/4;overflow:hidden}
