---
// 体験する美術館 トップページ。
// Claude Design のハンドオフ (Taiken Bijutsukan Site.dc.html) を Astro に移植したもの。
// WORKS / ART は横スクロール列、Lost Frame のカードと WORKS ナビは LP ページへ遷移する。
// 公演情報・NEWS・FAQ・クリエイターは src/data/taikenbizyutu.ts に集約している。
import TaikenbizyutuLayout from '../../layouts/TaikenbizyutuLayout.astro';
import TaikenbizyutuContactForm from '../../components/TaikenbizyutuContactForm.astro';
import { jsonLd } from '../../lib/microcms';
import { TICKET_URL, LOST_FRAME, CREATORS, TB_NEWS, TB_FAQS, TB_X_URL, LOST_FRAME_ARTS, NULL_ARDEN_ARTS } from '../../data/taikenbizyutu';

const assets = '/assets/taikenbizyutu';
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const soldOut = LOST_FRAME.status === 'soldout';

// ART 列: 最新公演の絵画を先頭に、過去公演の絵画を続ける。
const arts = [...LOST_FRAME_ARTS, ...NULL_ARDEN_ARTS];

// FAQ リッチリザルト用。回答末尾のリンクはテキストに含めない (本文と同一にする)。
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: TB_FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 開催中の公演 (Event)。詳細は LP 側にも同じものを置き、url は LP に向ける。
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${LOST_FRAME.name}（${LOST_FRAME.nameEn}）`,
  description: LOST_FRAME.description,
  image: new URL(LOST_FRAME.image, site).toString(),
  url: new URL(LOST_FRAME.path, site).toString(),
  startDate: LOST_FRAME.startDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  duration: LOST_FRAME.durationIso,
  location: {
    '@type': 'Place',
    name: '東京・下北沢エリア各所',
    address: { '@type': 'PostalAddress', addressLocality: '世田谷区', addressRegion: '東京都', addressCountry: 'JP' },
  },
  organizer: { '@type': 'Organization', name: '株式会社ex Labs', url: 'https://kabuexlabs.com/' },
  performer: { '@type': 'Organization', name: '体験する美術館', url: new URL('/taikenbizyutu/', site).toString() },
  offers: {
    '@type': 'AggregateOffer',
    url: TICKET_URL,
    priceCurrency: 'JPY',
    lowPrice: Math.min(...LOST_FRAME.prices.map((x) => x.price)),
    highPrice: Math.max(...LOST_FRAME.prices.map((x) => x.price)),
    availability: soldOut ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    validFrom: LOST_FRAME.startDate,
  },
};
---

<TaikenbizyutuLayout>
<Fragment slot="head">
  <script type="application/ld+json" set:html={jsonLd(faqLd)} />
  <script type="application/ld+json" set:html={jsonLd(eventLd)} />
</Fragment>

<section id="top" class="hero fx col ac jc">
  <div class="fx col ac gap24" style="padding:120px 24px 140px;position:relative;z-index:1">
    <div class="herox fx ac gap12 hero-el e0"><span>絵&nbsp;画</span><span class="xmark">×</span><span>体&nbsp;験</span><span class="xmark">×</span><span>交&nbsp;流</span></div>
    <h1 class="heromark-h1"><img class="heromark hero-el e1" src={`${assets}/logo-white.webp`} alt="体験する美術館" width="1000" height="487"><span class="sr-only">体験する美術館｜下北沢の街を巡る参加型アート・周遊型アートイマーシブ｜絵画と物語、街歩き謎解きの体験</span></h1>
    <p class="herolead m0 hero-el e2">鑑賞するアートから、<wbr>体験するアートへ。</p>
    <p class="note tc m0 hero-el e3" style="letter-spacing:.14em">絵画と物語、観客の参加を編み込んだ<wbr>参加型芸術のレーベル</p>
    <div class="hero-el e4" style="margin-top:28px"><a class="bigx" href="/taikenbizyutu/lostframe/">最新の公演を見る</a></div>
  </div>
  <div class="scrolly"></div>
</section>

<section id="works" class="sec hairtop">
  <div class="wrapc">
    <div class="kicker rv">Works</div>
    <h2 class="h2 rv d1">公演一覧</h2>
    <p class="lead muted rv d2" style="margin:28px 0 0;max-width:720px">閉館後の美術館、使用されていない展示会場、そして街そのもの——。公演ごとに会場を変えながら、絵画と物語、そして観客の参加による絵画鑑賞の場を立ち上げています。</p>
    <div class="scroller rv d2" style="margin-top:56px">
    <div class="hscroll ewrow">
      <a class="ewcard" href="/taikenbizyutu/lostframe/">
        <img class="poster" src={`${assets}/lost-frame.webp`} alt="ロスト・フレーム キービジュアル" width="900" height="1281" loading="lazy">
        <div class="ewbody">
          {soldOut ? <span class="sold">第二弾 ─ SOLD OUT</span> : <span class="badge">第二弾 ─ 受付中</span>}
          <p class="ewtitle">ロスト・フレーム</p>
          <p class="ewsub en m0">Lost Frame</p>
          <p class="cdesc" style="margin:14px 0 0">絵画と街が交差する、街を巡る参加型の絵画鑑賞。会場は東京・下北沢の街そのもの。</p>
          <p class="arw" style="margin:16px 0 0;font-size:15px">→ 公演詳細を見る</p>
        </div>
      </a>
      <div class="ewcard">
        <img class="poster" src={`${assets}/null-arden.webp`} alt="ヌル・アーデン展 キービジュアル" width="900" height="1267" loading="lazy">
        <div class="ewbody">
          <span class="sold">第一弾 ─ SOLD OUT</span>
          <p class="ewtitle">ヌル・アーデン展</p>
          <p class="ewsub en m0">Null Arden Exhibition</p>
          <p class="cdesc" style="margin:14px 0 0">名以外を持たぬ画家「ヌル・アーデン」の個展を会場に、絵画と物語、図像の読解による参加型の展示。全公演、満席にて終了しました。</p>
          <div style="margin-top:10px">
            <a class="artlink" href="/game/null-arden/"><span class="arw">→</span><span>ネタバレ公開特設サイトで解説を読む</span></a>
            <a class="artlink" href="/game/auction/"><span class="arw">→</span><span>作品オークションの記録を読む</span></a>
          </div>
        </div>
      </div>
    </div>
    <div class="swipe"><span class="ar l">◀</span>スワイプで他の公演を見る<span class="ar r">▶</span></div>
    </div>
  </div>
</section>

<section id="news" class="sec hairtop">
  <div class="wrapc">
    <div class="kicker rv">News</div>
    <h2 class="h2 rv d1">お知らせ</h2>
    <div style="margin-top:40px">
      {TB_NEWS.map((n, i) => (
        <div class={`newsrow fx gap24 rv${i > 0 ? ` d${Math.min(i, 4)}` : ''}`}>
          <time class="ndate" datetime={n.iso}>{n.date}</time>
          <span>
            {n.text}
            {n.link && (
              <>（<a href={n.link.href} target={n.link.external ? '_blank' : undefined} rel={n.link.external ? 'noopener' : undefined}>{n.link.label}</a>）</>
            )}
          </span>
        </div>
      ))}
    </div>
    <p class="note rv" style="margin-top:18px">最新情報は<a href={TB_X_URL} target="_blank" rel="noopener">公式X（@taikenbizyutu）</a>にて随時お知らせします。</p>
  </div>
</section>

<section id="lostframe" class="sec hairtop">
  <div class="wrapc">
    <div class="evgrid">
      <div class="posrel rv"><img class="poster pshadow" src={`${assets}/lost-frame.webp`} alt="ロスト・フレーム キービジュアル" width="900" height="1281" loading="lazy"></div>
      <div class="rv d1">
        {soldOut ? <span class="sold">最新公演 ─ 第二弾 完売御礼</span> : <span class="badge">最新公演 ─ 第二弾</span>}
        <h2 class="evtitle">ロスト・フレーム</h2>
        <p class="evsub en">Lost Frame</p>
        <p class="lead" style="margin:28px 0 0">下北沢の街に散らばった絵画を探し、<wbr>隠された物語を辿る……<br>絵画と街が交差する、<wbr>街を巡る参加型の絵画鑑賞。</p>
        <div class="story" style="margin-top:28px">
          <p class="m0">『ロスト・フレーム』は、街を巡りながら絵画と物語に出会い、絵画に埋め込まれた図像や作中言語を読み解いていく、参加型の絵画鑑賞の公演です。</p>
          <p style="margin:16px 0 0">下北沢エリアの店舗様との連携により、街に点在する場所を巡り、手描きの絵画と物語を軸にした鑑賞のなかで、登場人物と実際に言葉を交わす——観客の関わりによって絵画が意味を帯びていく、新しい絵画鑑賞のかたちに立ち会っていただきます。</p>
          <p style="margin:16px 0 0">観客の選択によって、物語は異なる結末へと分岐します。</p>
        </div>
        <div class="dl" style="margin-top:36px">
          <div class="dlrow"><span class="dt">エリア</span><span>{LOST_FRAME.area}</span></div>
          <div class="dlrow"><span class="dt">形式</span><span>{LOST_FRAME.format}</span></div>
          <div class="dlrow"><span class="dt">所要時間</span><span>{LOST_FRAME.duration}</span></div>
          <div class="dlrow"><span class="dt">定員</span><span>{LOST_FRAME.capacity}</span></div>
          <div class="dlrow"><span class="dt">参加費</span><span>{LOST_FRAME.prices.map((x) => `${x.price.toLocaleString('ja-JP')}円（${x.people}名参加）`).join(' ／ ')}<br><span class="note">※1人あたり</span></span></div>
          <div class="dlrow"><span class="dt">参加のお申し込み</span><span>{soldOut ? <>全公演 完売しました（<a href={LOST_FRAME.soldoutNewsPath}>お知らせ</a>）</> : <a href={TICKET_URL} target="_blank" rel="noopener">お申し込みページへ →</a>}</span></div>
        </div>
        <div class="fx gap16 wrap" style="margin-top:32px">
          {soldOut ? <span class="bigx soldbtn" aria-disabled="true">全公演 完売しました</span> : <a class="bigx" href={TICKET_URL} target="_blank" rel="noopener">参加を申し込む</a>}
          <a class="bigx" href="/taikenbizyutu/lostframe/">公演詳細を見る</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="about" class="sec hairtop dark2">
  <div class="wrapc">
    <div class="kicker rv">About</div>
    <h2 class="h2 rv d1">『体験する美術館』とは</h2>
    <p class="lead rv d2" style="margin:32px 0 0;max-width:720px">「体験する美術館」は、“鑑賞するアート”を“体験するアート”へと問い直す、参加型芸術のレーベルです。ハプニングや参加型アート、関係性の美学の系譜では絵画は乗り越えの対象でしたが、本レーベルは逆に、絵画の側から上演性と時間を回復する試みに取り組んでいます。</p>
    <div class="scroller mobscroll rv d2" style="margin-top:64px;--fadecol:#1a1714">
    <div class="hscroll grid3">
      <div class="card3">
        <div class="num">01</div>
        <h3 class="h3">物語の中で、絵画と出会う。</h3>
        <p class="body14 m0">画家やイラストレーターが、その公演のためだけに描き下ろした絵画。作品に埋め込まれた図像や作中言語を読み解きながら、鑑賞そのものに観客が参加していきます。</p>
      </div>
      <div class="card3">
        <div class="num">02</div>
        <h3 class="h3">美術家の創作を更新する。</h3>
        <p class="body14 m0">鑑賞の順序が可変であることを前提に描かれる絵画——観客の選択によって意味が変わる図像構成は、タブローの制作方法そのものに関わる実験です。美術家との共同制作を通じて、絵画表現の新たな発表・展開の機会を生み出します。</p>
      </div>
      <div class="card3">
        <div class="num">03</div>
        <h3 class="h3">作品が新たな手へ渡る。</h3>
        <p class="body14 m0">公演終了後には、公演内で用いられた作品のオークションを開催。作品が鑑賞の記憶とともに新たな持ち主のもとへ渡る機会を設けています。</p>
        <p class="note" style="margin:12px 0 0">※『ロスト・フレーム』におけるオークションの実施は未定です。</p>
      </div>
    </div>
    <div class="swipe"><span class="ar l">◀</span>スワイプで見る<span class="ar r">▶</span></div>
    </div>
  </div>
</section>

<section id="model" class="sec hairtop">
  <div class="wrapc">
    <div class="kicker rv">Model</div>
    <h2 class="h2 rv d1">地域とクリエイターをつなぐ、<wbr>新たなモデル</h2>
    <div class="scroller mobscroll rv d2" style="margin-top:64px">
    <div class="hscroll grid3">
      <div class="card3">
        <div class="num">舞台</div>
        <h3 class="h3">街や施設が、美術館になる。</h3>
        <p class="body14 m0">閉館後の美術館、使用されていない展示会場、店舗の一部スペース、そして街そのもの——公演ごとに、その場所ならではの舞台を立ち上げます。会場となる店舗様・施設様には、新たな来店・認知獲得の機会となります。</p>
      </div>
      <div class="card3">
        <div class="num">回遊</div>
        <h3 class="h3">地域全体への送客に。</h3>
        <p class="body14 m0">公演の参加者が絵画を探して会場や街を巡ることで、地域全体への回遊・来訪にもつながります。</p>
      </div>
      <div class="card3">
        <div class="num">運営</div>
        <h3 class="h3">初期費用のご負担なく。</h3>
        <p class="body14 m0">株式会社ex Labsが集客から企画・運営までを一括して担うため、施設・店舗側は初期費用をご負担いただくことなく認知を獲得できるスキームを採用しています。</p>
      </div>
    </div>
    <div class="swipe"><span class="ar l">◀</span>スワイプで見る<span class="ar r">▶</span></div>
    </div>
  </div>
</section>

<section id="creators" class="sec hairtop dark2">
  <div class="wrapc">
    <div class="kicker rv">Creators</div>
    <h2 class="h2 rv d1">絵画クリエイター</h2>
    <p class="lead muted rv d2" style="margin:28px 0 0;max-width:720px">本企画には、東京藝術大学出身者や漫画家など、多様なジャンルで活躍するクリエイターが絵画制作に参画しています。</p>
    <div class="cnames rv d2" style="margin-top:56px">
      {CREATORS.map((c) => (
        <div class="cnameplate">
          <span class="cnn">{c.name}</span>
        </div>
      ))}
    </div>
    <p class="note rv" style="margin-top:34px">※敬称略・順不同。</p>
  </div>
</section>

<section id="art" class="sec hairtop">
  <div class="wrapc">
    <div class="kicker rv">Art</div>
    <h2 class="h2 rv d1">作品群</h2>
    <p class="lead muted rv d2" style="margin:28px 0 0;max-width:720px">各公演のために描き下ろされた、手描きの絵画作品。物語の鍵として会場に展示され、公演終了後にはオークションを通じて新たな持ち主のもとへ。</p>
    <div class="scroller rv d2" style="margin-top:56px">
    <div class="hscroll artrow">
      {arts.map((a) => (
        <div>
          <div class="artframe fx ac jc"><img class="poster pshadow artimg" src={a.src} alt={a.alt} width={a.width || undefined} height={a.height || undefined} loading="lazy"></div>
          <p class="wcap">{a.caption}</p>
        </div>
      ))}
    </div>
    <div class="swipe"><span class="ar l">◀</span>スワイプで作品を見る<span class="ar r">▶</span></div>
    </div>
    <p class="note tc rv" style="margin:40px 0 0">ここに掲載しているのは一部です。ほかにも多数の作品がございます。<br>『ロスト・フレーム』の絵画は<a href={LOST_FRAME.spoilerPath}>公演記録ページ</a>でも紹介しています（ネタバレを含みます）。</p>
  </div>
</section>

<section id="faq" class="sec hairtop dark2">
  <div class="wrapc" style="max-width:860px">
    <div class="kicker rv">FAQ</div>
    <h2 class="h2 rv d1">よくある質問</h2>
    <div style="margin-top:44px">
      {TB_FAQS.map((f) => (
        <details class="faqit rv">
          <summary class="faqq"><span class="qmark">Q</span>{f.q}</summary>
          <p class="faqa">
            {f.a}
            {f.link && (
              <a class="faqlink" href={f.link.href} target={f.link.external ? '_blank' : undefined} rel={f.link.external ? 'noopener' : undefined}>→ {f.link.label}</a>
            )}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="contact" class="sec hairtop">
  <div class="wrapc tc">
    <div class="kicker rv">Contact</div>
    <h2 class="h2 rv d1">お問い合わせ</h2>
    <div class="fx jc gap24 wrap" style="margin-top:48px">
      <div class="card3 ccard rv"><p class="ctitle m0">取材・メディアの方</p><p class="cdesc" style="margin:10px 0 0">本レーベル・各公演に関する取材のご相談を承ります。</p></div>
      <div class="card3 ccard rv d1"><p class="ctitle m0">店舗・施設の方</p><p class="cdesc" style="margin:10px 0 0">イベント連携・スペース活用のご相談を承ります。</p></div>
      <div class="card3 ccard rv d2"><p class="ctitle m0">クリエイターの方</p><p class="cdesc" style="margin:10px 0 0">絵画制作への参画のご相談を承ります。</p></div>
    </div>
    <TaikenbizyutuContactForm />
  </div>
</section>

</TaikenbizyutuLayout>

<style>
.hero{min-height:100vh;background:#161412;position:relative}
/* ロゴ画像がこのページの見出しそのものなので h1 で包む（alt が見出しテキスト
   になる）。見た目は変えないよう既定のマージン・行間をリセットする。 */
.heromark-h1{margin:0;line-height:0;font-size:inherit;font-weight:inherit}
.heromark{width:min(480px,72vw);height:auto}
.herox{font-size:15px;letter-spacing:.3em;color:#cfc8bc}
.xmark{color:#b39a63;font-size:12px}
.herolead{font-size:17px;letter-spacing:.24em;color:#ebe5da;text-align:center}
.scrolly{position:absolute;bottom:0;left:50%;width:1px;height:88px;background:linear-gradient(180deg,rgba(179,154,99,0),#b39a63)}
.newsrow{padding:20px 0;border-bottom:1px solid rgba(235,229,218,.1);font-size:14px;letter-spacing:.06em}
.ndate{font-family:'Cormorant Garamond',serif;font-style:italic;color:#b39a63;font-size:15px;min-width:96px}
.soldbtn{border-color:#a5524a;color:#c9756b;cursor:default}
.evtitle{font-size:52px;font-weight:500;letter-spacing:.12em;margin:18px 0 0;line-height:1.3}
.evsub{font-size:24px;color:#b39a63;letter-spacing:.06em;margin:2px 0 0}
.story{font-size:15.5px;letter-spacing:.06em;color:#d8d2c6}
.dl{border-top:1px solid rgba(235,229,218,.1)}
.dlrow{display:grid;grid-template-columns:130px 1fr;gap:16px;padding:14px 2px;border-bottom:1px solid rgba(235,229,218,.1);font-size:14px;letter-spacing:.06em}
.dt{color:#9c9488}
.num{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:38px;color:#b39a63;line-height:1}
/* 絵画クリエイター — 名前のみ表示 */
.cnames{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.cnameplate{border-top:1px solid rgba(179,154,99,.42);padding:26px 8px;text-align:center}
.cnn{font-size:20px;letter-spacing:.2em;color:#ebe5da}
.faqit{border-bottom:1px solid rgba(235,229,218,.1)}
.faqq{cursor:pointer;list-style:none;padding:22px 2px;font-size:16px;letter-spacing:.08em;display:flex;gap:18px;align-items:baseline}
.faqq::-webkit-details-marker{display:none}
.qmark{font-family:'Cormorant Garamond',serif;font-style:italic;color:#b39a63;font-size:20px}
.faqa{padding:0 2px 24px 38px;font-size:14.5px;color:#b5aea2;letter-spacing:.05em;margin:0}
.faqlink{display:inline-block;margin-left:10px;font-size:13.5px;letter-spacing:.1em;white-space:nowrap}
.ccard{width:260px;text-align:left}
.wcap{font-size:13px;color:#9c9488;letter-spacing:.14em;margin:14px 0 0;text-align:center}
.ewrow{grid-auto-columns:min(440px,82vw)}
.ewcard{display:block;color:inherit;border:1px solid rgba(235,229,218,.12);background:#1a1714;padding:28px}
