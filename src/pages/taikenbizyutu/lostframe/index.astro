---
// 『ロスト・フレーム』公演LP。
// 支給されたLP画像 (3枚・縦つなぎでシームレスなグラデーションになっている) を
// 全幅で積み、参加申し込みのCTAと追従ボタンを重ねる構成。
// トップページの WORKS ナビ・Lost Frame カードからここに遷移する。
// NOTE: LP は画像のみで構成され、LP画像 (lp-1〜3) 内に「イマーシブ」「周遊型」
//       「チケット」等の文字が焼き込まれている。画像内の文言は画像を作り直さない
//       限り変えられないため、このページの SEO テキスト（title / description /
//       sr-only 見出し / alt）は画像の内容とキーワードに合わせている。
// 公演の数値情報 (料金・所要時間・申込URL) は src/data/taikenbizyutu.ts を参照する。
import TaikenbizyutuLayout from '../../../layouts/TaikenbizyutuLayout.astro';
import { jsonLd } from '../../../lib/microcms';
import { TICKET_URL, LOST_FRAME } from '../../../data/taikenbizyutu';

const assets = '/assets/taikenbizyutu';
const site = Astro.site ?? new URL('https://kabuexlabs.com');

const title = 'ロスト・フレーム Lost Frame｜下北沢の周遊型アートイマーシブ・街歩き謎解き｜体験する美術館';
const description =
  '下北沢の街に散らばった絵画を探し、隠された物語を辿る——絵画と街が交差する周遊型アートイマーシブ『ロスト・フレーム』。街歩き×謎解き×絵画による参加型アート体験。所要時間75分・1〜4名、下北沢エリア開催。';

// 画像のみの LP なので、検索エンジンには構造化データで公演情報を渡す。
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${LOST_FRAME.name}（${LOST_FRAME.nameEn}）`,
  description: LOST_FRAME.description,
  image: new URL(LOST_FRAME.image, site).toString(),
  url: new URL(LOST_FRAME.path, site).toString(),
  startDate: LOST_FRAME.startDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  duration: LOST_FRAME.durationIso,
  location: {
    '@type': 'Place',
    name: '東京・下北沢エリア各所',
    address: { '@type': 'PostalAddress', addressLocality: '世田谷区', addressRegion: '東京都', addressCountry: 'JP' },
  },
  organizer: { '@type': 'Organization', name: '株式会社ex Labs', url: 'https://kabuexlabs.com/' },
  performer: { '@type': 'Organization', name: '体験する美術館', url: new URL('/taikenbizyutu/', site).toString() },
  offers: LOST_FRAME.prices.map((x) => ({
    '@type': 'Offer',
    name: `${x.people}名参加（1人あたり）`,
    url: TICKET_URL,
    price: x.price,
    priceCurrency: 'JPY',
    availability: 'https://schema.org/InStock',
    validFrom: LOST_FRAME.startDate,
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '体験する美術館', item: new URL('/taikenbizyutu/', site).toString() },
    { '@type': 'ListItem', position: 2, name: LOST_FRAME.name },
  ],
};
---

<TaikenbizyutuLayout title={title} description={description} bare>
<Fragment slot="head">
  <script type="application/ld+json" set:html={jsonLd(eventLd)} />
  <script type="application/ld+json" set:html={jsonLd(breadcrumbLd)} />
</Fragment>

<header class="lphdr fx ac jb">
  <a class="lpback" href="/taikenbizyutu/">← 体験する美術館</a>
  <a class="lpticket-s" href={TICKET_URL} target="_blank" rel="noopener">参加を申し込む</a>
</header>

<div class="lp">
  {/* LP は画像のみで構成されているため、検索エンジン・読み上げ用に
      ページ見出しをテキストで置く（内容は LP 画像1枚目と同一）。 */}
  <h1 class="sr-only">ロスト・フレーム Lost Frame｜下北沢の街を巡る周遊型アートイマーシブ・街歩き謎解き｜体験する美術館</h1>
  <img class="lpimg" src={`${assets}/lp-1.webp`} alt="ロスト・フレーム Lost Frame ─ 周遊型アートイマーシブ『体験する美術館』。その日、絵画は街にこぼれた。下北沢の街に散らばった絵画を探し、隠された物語を辿る……絵画と街が交差する、街歩き型の参加型アート体験" width="1600" height="2900">
  <img class="lpimg" src={`${assets}/lp-2.webp`} alt="STORY：古着と音楽、演劇とアート。多様な文化が調和する街、下北沢。しかし最近、奇妙な出来事が目撃されている。絵画のモチーフが街にこぼれるように現れはじめたのだ——。ABOUT：実際に下北沢の街を歩きながら、この公演のためだけに描かれた絵画と物語に出会い、街歩き型の謎解き（図像の読解）を楽しむ参加型アートイマーシブ。PAINTING：荒巻まりの、小島有貴、中堀慎治、山科ティナ" width="1600" height="3700" loading="lazy">
  <img class="lpimg" src={`${assets}/lp-3.webp`} alt="所要時間75分、定員1〜4名。参加費（1人あたり）：4,000円［4名参加］、4,500円［3名参加］、5,000円［2名参加］、8,000円［1名参加］。STEP：01 公式サイトで参加を申し込む、02 記載の住所で公演に参加。CREATER：企画 株式会社ex Labs／ディレクター・デザイン・ストーリー制作 荒巻まりの／プロデューサー・図像設計 かるら／監修 御湯波ライト" width="1600" height="4000" loading="lazy">

  <div class="lpcta tc">
    <a class="lpbtn" href={TICKET_URL} target="_blank" rel="noopener">参加を申し込む <span class="arr">▶▶</span></a>
    <p class="lpnote">お申し込みページ（escape.id）へ移動します</p>
    <p class="lpnote" style="margin-top:34px">公演の記録（ネタバレを含みます）は <a class="lpnote-link" href={LOST_FRAME.noteUrl} target="_blank" rel="noopener">note の記事</a> で公開しています。</p>
    <a class="lphome" href="/taikenbizyutu/">← 体験する美術館 トップへ戻る</a>
  </div>

  <footer class="lpftr tc">
    <p class="m0">企画・運営：<a href="https://kabuexlabs.com/">株式会社 ex Labs</a></p>
    <p class="m0">© 2026 ex Labs Inc. All Rights Reserved.</p>
  </footer>
</div>

<a class="fab" href={TICKET_URL} target="_blank" rel="noopener">参加を<br>申し込む ▶▶</a>

<style>
.lp{background:#4e3f49}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.lpimg{display:block;width:100%;height:auto}
.lphdr{position:sticky;top:0;z-index:50;background:rgba(19,25,38,.72);backdrop-filter:blur(8px);padding:10px 18px;border-bottom:1px solid rgba(255,255,255,.12)}
.lpback{color:#fff;font-size:13px;letter-spacing:.14em}
.lpback:hover{color:#efe14a}
.lpticket-s{color:#131926;background:#efe14a;font-size:12px;font-weight:600;letter-spacing:.14em;padding:8px 16px}
.lpticket-s:hover{color:#131926;background:#fff}
.lpcta{padding:64px 24px 72px;background:linear-gradient(180deg,#4e3f49 0%,#3a2f37 100%)}
.lpbtn{display:inline-block;background:#efe14a;color:#1c1a12;font-size:20px;font-weight:600;letter-spacing:.16em;padding:22px 56px;clip-path:polygon(6% 12%,55% 0,100% 18%,96% 88%,10% 100%,0 78%);transition:transform .2s}
.lpbtn:hover{color:#1c1a12;transform:scale(1.05)}
.arr{font-size:15px}
.lpnote{font-size:12px;color:rgba(255,255,255,.65);letter-spacing:.1em;margin:18px 0 0}
.lpnote-link{color:#fff;border-bottom:1px solid rgba(255,255,255,.4)}
.lpnote-link:hover{color:#efe14a;border-color:#efe14a}
.lphome{display:inline-block;color:#fff;font-size:13px;letter-spacing:.14em;margin-top:34px;border-bottom:1px solid rgba(255,255,255,.4);padding-bottom:2px}
.lphome:hover{color:#efe14a;border-color:#efe14a}
.lpftr{background:#2c242b;color:rgba(255,255,255,.55);font-size:11px;letter-spacing:.1em;padding:28px 24px 90px}
.lpftr a{color:rgba(255,255,255,.75)}
.lpftr a:hover{color:#efe14a}
.fab{position:fixed;right:16px;bottom:16px;z-index:60;background:#efe14a;color:#1c1a12;font-size:13px;font-weight:600;letter-spacing:.08em;line-height:1.5;text-align:center;padding:14px 18px;clip-path:polygon(8% 10%,60% 0,100% 16%,95% 90%,8% 100%,0 74%);box-shadow:0 6px 24px rgba(0,0,0,.4)}
.fab:hover{color:#1c1a12;background:#fff}
@media (min-width:1100px){.lp{max-width:none}.lpbtn{font-size:22px}}
</style>
</TaikenbizyutuLayout>
