      {gMatched.map((g) => <li><ShowGroupCard rows={g} show={g.filter((r) => mIds.has(r.row.id)).map((r) => r.row.id)} place="events" /></li>)}
    </ul>

    <details class="xe-unknown" id="ev-unknown" hidden={gUnknown.length === 0} open={gMatched.length === 0 && gUnknown.length > 0}>
      <summary><span>条件を判定できない公演<span class="xe-unk-n" data-unknown-count>{gUnknown.length}</span>件</span><span class="x-faq-plus" aria-hidden="true">+</span></summary>
      <p class="xe-unk-note"><Ph list={['開演時刻・終了時刻・上限人数・', '開催の確認が取れていないため、', '条件に合うかを判定できません。', '公式ページでご確認ください。']} /></p>
      <ul class="xe-list" id="ev-unknown-list">
        {gUnknown.map((g) => <li><ShowGroupCard rows={g} show={g.filter((r) => uIds.has(r.row.id)).map((r) => r.row.id)} place="events-unknown" /></li>)}
      </ul>
    </details>
    </div>
    <ul class="xe-list" id="ev-rest" hidden>
      {gRest.map((g) => <li><ShowGroupCard rows={g} show={[]} place="events" /></li>)}
    </ul>
  </div>
</section>

