---
// 「今日できるイマーシブ」「今日 イマーシブ 東京」「今週末 マダミス 東京」の受け皿（/events/）。
// SSR で毎リクエスト日本時間で判定し、今日・明日・今週末の開催を見出し付きの本文として出す（検索エンジンに日付と作品名が見える）。
// 絞り込みはクエリ文字列（GET）で動き、JS があれば同じ判定関数で即時反映。絞り込み状態は canonical で /events/ に集約
// （BaseLayout の canonical はクエリを含まない）。掲載は株式会社ex Labs が確認した公演のみ（データ正本 src/data/events/）。
// 2026-09-28 リニューアル（デザイン元 Events.dc.html）：表示部品を components/x/ に置き換え。検索・判定のロジックは従来のまま。
// 旧ページの「探し方と選び方」「要点」「選び方・基礎知識」「関連記事」はクライアント指示で削除。
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SecHead from '../../components/x/SecHead.astro';
import Ph from '../../components/x/Ph.astro';
import Cls from '../../components/x/Cls.astro';
import ScheduleCard from '../../components/x/ScheduleCard.astro';
import ShowGroupCard from '../../components/x/ShowGroupCard.astro';
import { shows as calendarShows } from '../../data/shows';
import { eventsData, EVENTS_CONTACT, LIST_DAYS } from '../../data/events/index';
import { AREAS, GENRES, REGIONS, areaName, regionName } from '../../data/events/areas';
import { parseCriteria, criteriaToQuery, resolveAll, resolveListings, isListing, search, nextAvailableDate, compareRows, BUDGET_OPTIONS, END_BY_OPTIONS, PARTY_MAX, fmtYen, minToHhmm, type AnyResolved, type Criteria } from '../../lib/events';
import { jstDateString, addDays, weekRange, fmtDateShort, fmtDateJa, fmtVerified } from '../../lib/thisWeek';
import { jsonLd } from '../../lib/microcms';

const now = new Date();
const today = jstDateString(now);
const site = Astro.site ?? new URL('https://kabuexlabs.com');
const c = parseCriteria(Astro.url.searchParams);
const limit = addDays(today, LIST_DAYS);
const own = resolveAll(eventsData, now).filter((r) => r.row.date <= limit);
const ext = resolveListings(eventsData, now).filter((r) => r.row.date <= limit);
const all: AnyResolved[] = [...own, ...ext].sort((a, b) => compareRows(a.row, b.row));
const result = search(all, c, now);
const nextDate = result.matched.length === 0 ? nextAvailableDate(all, c, now) : null;
const weekend = weekRange(now).weekend.filter((d) => d >= today);
const weekendLabel = weekend.map(fmtDateShort).join('・');
const windowLabel = result.window ? result.window.map(fmtDateJa).join('・') : `これから${LIST_DAYS}日以内`;
const dataAreas = new Set(all.map((r) => r.row.area));
const dataRegions = new Set(all.map((r) => r.row.region));
const areaOptions = AREAS.filter((a) => dataAreas.has(a.id));
const regionOptions = REGIONS.filter((r) => dataRegions.has(r.id));
const latestVerified = eventsData.works.filter((w) => w.published).map((w) => w.verified.at).sort().pop() ?? '';
const anyStale = own.some((r) => r.stale);

// 今日・明日・今週末の要約（検索エンジンにも見える静的な本文。カードは下の結果に1回だけ出す）
const sumFor = (when: Criteria['when']) => search(all, { when }, now).matched;
const todayRows = sumFor('today');
const tomorrowRows = sumFor('tomorrow');
const weekendRows = sumFor('weekend');
const nextAny = todayRows.length === 0 ? nextAvailableDate(all, { when: 'today' }, now) : null;
const label = (r: AnyResolved) => isListing(r) ? r.listing.title : r.work.title;
const place = (r: AnyResolved) => isListing(r) ? `${regionName(r.listing.regionId)}・${areaName(r.listing.areaId)}` : `${regionName(r.venue.regionId)}・${areaName(r.venue.areaId)}`;
const timeOf = (r: AnyResolved) => r.row.start !== undefined ? `${minToHhmm(r.row.start)}開演` : '開演時刻は公式で確認';
const ctaOf = (r: AnyResolved) => r.cta === 'book' ? '予約可（確認時点）' : r.cta === 'soldout' ? '満席（確認時点）' : r.cta === 'started' ? '開演済み' : '空席は公式で確認';
const worksUpcoming = [...new Map(own.filter((r) => !['ended', 'cancelled'].includes(r.eventState)).map((r) => [r.work.id, r])).values()];

const pageTitle = '今日できるイマーシブ｜東京で今日・明日・今週末に参加できる公演を探す - 株式会社ex Labs';
const pageDesc = `今日できるイマーシブ体験・マダミスを東京で探すページ。今日（${fmtDateShort(today)}）・明日・今週末（${weekendLabel}）に参加できる公演を日本時間で毎日更新し、人数・エリア・予算でも絞り込めます。開催・販売・空席の確認状況を分けて表示し、予約は公式販売ページへ。`.slice(0, 160);

const faqs = [
  { q: '今日、東京でイマーシブ体験に参加できますか？', a: `このページの「今日」の欄に、今日（${fmtDateJa(today)}）に開催予定として確認できた公演を表示しています。参加できるかどうかは各公演の公式販売ページの空席次第です。開催予定があるだけでは予約可能と表示せず、受付中かつ確認時点で空席ありの回だけ「予約する」ボタンにしています。` },
  { q: '予約なしで当日参加できるイマーシブはありますか？', a: '当サイトで掲載している公演は、公式販売ページでの事前予約が基本です。当日券の有無は公演ごとに異なるため、公式ページの案内を確認してください。ページ上の「販売」「空席」の表示は確認時点のもので、当日の状況を保証するものではありません。' },
  { q: '一人でも参加できますか？', a: '作品によります。「ウワサバナシ調査委員会」はチケット1枚につき1名で1人から参加できます。「怪盗と秘密の試験」は各回2〜4名の1組での参加で、1人での申込はできません。各カードの「申込可能な人数」で確認できます。' },
  { q: '料金はいくらくらいですか？', a: '掲載中の公演では、周遊型の「ウワサバナシ調査委員会」が1人¥4,000（税込・手数料別）、少人数型の「怪盗と秘密の試験」が1組¥13,000〜（2人参加・税込・手数料別）です。東京のマダミス店舗公演は1人3,000〜6,000円程度が目安です。1組料金は人数に応じた1人あたりの目安も表示しています。' },
  { q: '所要時間はどのくらいですか？', a: '周遊型で60〜120分程度、公演型で1〜3時間程度が一般的です。掲載中の「ウワサバナシ調査委員会」は約70分です。終了時刻の上限（例：19時までに終わる）で絞り込むこともできますが、開演時刻が未確認の公演は条件に合うとは扱わず、別枠で表示します。' },
  { q: '初めてでも楽しめますか？服装や持ち物は？', a: '多くのイマーシブ体験は演技の経験がなくても参加できます。周遊型は歩きやすい靴、スマートフォンとイヤホン、水分を持参するよう案内されることが多く、各公演の「持ち物・参加条件」に確認できた内容を載せています。詳しくはイマーシブ体験の服装・持ち物ガイドをご覧ください。' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '今日できるイマーシブ｜東京で今日・明日・今週末に参加できる公演',
  url: new URL('/events/', site).toString(),
  inLanguage: 'ja',
  description: pageDesc,
  publisher: { '@type': 'Organization', name: '株式会社ex Labs', url: site.toString() },
  dateModified: today,
  mainEntity: { '@type': 'ItemList', itemListElement: worksUpcoming.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.work.title, url: new URL(`/events/${r.work.slug}/`, site).toString() })) },
};

const relax: { label: string; q: string }[] = [];
if (c.party) relax.push({ label: '人数の指定を外す', q: criteriaToQuery({ ...c, party: undefined }) });
if (c.area || c.region) relax.push({ label: 'エリアの指定を外す', q: criteriaToQuery({ ...c, area: undefined, region: undefined }) });
if (c.genre) relax.push({ label: 'ジャンルの指定を外す', q: criteriaToQuery({ ...c, genre: '' }) });
if (c.start || c.endBy || c.budget) relax.push({ label: '時間帯・終了時刻・予算の指定を外す', q: criteriaToQuery({ ...c, start: '', endBy: undefined, budget: undefined }) });

// ---- 2026-09 リニューアル：表示用 ----
const WDE = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const [ty, tm, td] = today.split('-');
const todayBig = `${tm}.${td}`;
const todayWd = WDE[new Date(`${today}T12:00:00+09:00`).getUTCDay()];
const tomorrow = addDays(today, 1);
const weekendSub = weekend.length ? weekend.map((d) => fmtDateShort(d).replace(/（.*$/, '')).join('・').replace(/^(\d+)\/(\d+)・\1\//, '$1/$2・') : '';
const whens: { k: Criteria['when']; label: string; sub: string }[] = [
  { k: 'today', label: '今日', sub: fmtDateShort(today) },
  { k: 'tomorrow', label: '明日', sub: fmtDateShort(tomorrow) },
  { k: 'weekend', label: '今週末', sub: weekendLabel },
  { k: 'date', label: '日付を指定', sub: 'カレンダーから' },
];
// 「これから90日」の一覧は出さない（2026-09-28 クライアント指示）。日付の条件（今日・明日・今週末・日付指定）を選んだときだけ公演回の一覧を表示する
const noWhen = c.when === 'all';
// 検索結果は同じ公演の公演回を1枚にまとめる（2026-09-28 クライアント指示）。自社公演は作品ごと、外部掲載は1件ずつ
const live = all.filter((r) => !['ended', 'cancelled'].includes(r.eventState));
const groupKey = (r: AnyResolved) => (isListing(r) ? r.row.id : `w:${r.row.workId}`);
const groups = [...live.reduce((m, r) => m.set(groupKey(r), [...(m.get(groupKey(r)) ?? []), r]), new Map<string, AnyResolved[]>()).values()];
const idsOf = (xs: AnyResolved[]) => new Set(xs.map((r) => r.row.id));
const mIds = idsOf(result.matched), uIds = idsOf(result.unknown);
const gMatched = groups.filter((g) => g.some((r) => mIds.has(r.row.id)));
const gUnknown = groups.filter((g) => !g.some((r) => mIds.has(r.row.id)) && g.some((r) => uIds.has(r.row.id)));
const gRest = groups.filter((g) => !gMatched.includes(g) && !gUnknown.includes(g));
const firstShown = (g: AnyResolved[], ids: Set<string>) => g.find((r) => ids.has(r.row.id))?.row.date ?? '9999';
gMatched.sort((a, b) => firstShown(a, mIds).localeCompare(firstShown(b, mIds)));
gUnknown.sort((a, b) => firstShown(a, uIds).localeCompare(firstShown(b, uIds)));
const scheduleShows = calendarShows.filter((s) => s.published && s.occurrences.some((o) => o.date >= today));
const areaOf = (r: AnyResolved) => place(r);
const worksCards = eventsData.works.filter((w) => w.published).map((w) => {
  const nxt = own.find((r) => r.work.id === w.id && !['ended', 'cancelled'].includes(r.eventState));
  const v = eventsData.venues.find((x) => x.id === (nxt?.venue.id ?? eventsData.occurrences.find((o) => o.workId === w.id)?.venueId ?? w.venueId)) ?? null;
  const org = eventsData.organizers.find((o) => o.id === w.organizerId);
  return { w, genre: GENRES.find((x) => x.id === w.genres[0])?.name ?? '', area: v ? `${regionName(v.regionId)}・${areaName(v.areaId)}` : '東京', next: nxt ? fmtDateJa(nxt.row.date) : '開催日は公式チケットページで確認', org: org?.relationLabel ?? '', own: org?.relation === 'ex-labs' };
});
// 2026-09-28 クライアント指定の文面・改行位置
const aboutLines = ['「公演を探す」は、', '株式会社ex Labs が運営する', 'マダミス・イマーシブ公演の発見と', '集客を支援する', '無料の公演情報サービスです。'];
const authorText = 'イマーシブ・マダミス（マーダーミステリー）・謎解き・頭脳戦など、体験型エンターテインメントの企画・制作・集客・運営を一貫して手がける制作会社。東京大学発スタートアップとして2025年設立。累計コンテンツ体験者数15,000人超、渋谷サクラステージでの施設一体型イベントは日本経済新聞に掲載。実際に企画・運営した現場の知見をもとに執筆しています。';

---
<BaseLayout renewal title={pageTitle} description={pageDesc} cutin={[['今日できる', 'イマーシブを'], ['探す']]} contact={{ title: ['掲載・修正のご依頼、', '制作のご相談はこちら'], type: 'other' }} footer="short">
<script type="application/ld+json" set:html={jsonLd(faqLd)} />
<script type="application/ld+json" set:html={jsonLd(pageLd)} />
<script type="application/ld+json" set:html={jsonLd({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).toString() }, { '@type': 'ListItem', position: 2, name: '今日できるイマーシブ（公演を探す）', item: new URL('/events/', site).toString() }] })} />

<nav class="xe-crumb" aria-label="パンくずリスト"><a href="/">ホーム</a><span>/</span><span aria-current="page" style="color:#fff">今日できるイマーシブ（公演を探す）</span></nav>

<section class="xe-hero">
  <div class="xe-hero-in">
    <div class="x-sh"><span class="x-sh-deco" aria-hidden="true">+<span class="x-sh-line"></span></span><p class="x-sh-en" style="font-size:clamp(30px,8vw,96px)" aria-hidden="true">Today's Immersive</p><span class="x-sh-deco" aria-hidden="true"><span class="x-sh-line"></span>+</span></div>
    <h1 class="xe-h1"><Ph list={['今日できる', 'イマーシブを探す']} /><span class="xe-h1-sub"><Ph list={['東京の今日・明日・', '今週末の公演']} /></span></h1>
    <div class="x-wcard is-s xe-today">
      <div class="xe-today-big"><span class="xe-big">{todayBig}</span><span class="xe-wd">{todayWd}</span></div>
      <p class="xe-today-l"><span class="x-c">今日 {fmtDateJa(today)}</span><span class="x-c" style="margin-left:.6em">東京</span></p>
      <div class="xe-counts">
        {[{ k: 'today', label: '今日', n: todayRows.length, sub: fmtDateShort(today) }, { k: 'tomorrow', label: '明日', n: tomorrowRows.length, sub: fmtDateShort(tomorrow) }, { k: 'weekend', label: '今週末', n: weekendRows.length, sub: weekendSub }].map((x) => (
          <a href={`/events/?when=${x.k}#results`} class="xe-count" data-when-go={x.k}><span class="xe-count-l">{x.label}</span><span class="xe-count-n">{x.n}<span>件</span></span><span class="xe-count-s">{x.sub}</span></a>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="schedule" class="xe-sec">
  <div class="xe-in">
    <SecHead en="Schedule" size="m" />
    <p class="x-sh-ja is-b" style="font-size:clamp(19px,2.6vw,25px)">今週・来週の開催日</p>
    <p class="xe-lead"><Ph list={['◯の日付をタップで', '予約サイトへ']} /></p>
    <div class="x-rail is-bleed" style="--gtc:repeat(auto-fit,minmax(min(100%,420px),1fr));--gap:24px;--col:calc(100% - 40px);margin-top:40px">
      {scheduleShows.map((s) => <ScheduleCard show={s} place="events-cal" now={now} />)}
    </div>
    <p class="xe-note-c"><Ph list={['◯は開催日です。', '空席は予約サイトの表示が最新で、', '◯があっても満席の場合があります。']} /></p>
  </div>
</section>

<section id="search" class="xe-sec" style="padding-bottom:clamp(80px,10vw,110px)">
  <div style="max-width:960px;margin:0 auto">
    <SecHead en="Search" size="m" />
    <p class="x-sh-ja is-b" style="font-size:clamp(19px,2.6vw,25px)"><Ph list={['日付・人数で', '絞り込む']} /></p>
    <p class="xe-lead"><Ph list={['参加できる公演回だけが', '並びます']} /></p>
    <form class="xe-form" id="ev-form" method="get" action="/events/" aria-label="公演の検索条件">
      <fieldset class="xe-when-fs">
        <legend class="xe-lbl">いつ遊ぶ？</legend>
        <div class="xe-whens" id="ev-when">
          {whens.map((w) => <label class="xe-when"><input type="radio" name="when" value={w.k} checked={c.when === w.k}><span class="xe-when-l">{w.label}</span><span class="xe-when-s" data-when-label={w.k === 'date' || w.k === 'all' ? undefined : w.k}>{w.sub}</span></label>)}
        </div>
        <label class="xe-date" data-date-row hidden={c.when !== 'date' ? true : undefined}>日付<input type="date" id="ev-date" name="date" value={c.date ?? ''} min={today} max={limit}></label>
      </fieldset>
      <div class="xe-sels">
        <label class="xe-sel"><span class="xe-lbl-s">申込人数</span><span class="xe-sel-w"><select id="ev-party" name="party"><option value="">指定なし</option>{Array.from({ length: PARTY_MAX }, (_, i) => i + 1).map((n) => <option value={n} selected={c.party === n}>{n}人</option>)}</select></span></label>
        <label class="xe-sel"><span class="xe-lbl-s">エリア</span><span class="xe-sel-w"><select id="ev-area" name="area"><option value="">{regionOptions.map((r) => r.name).join('・') || '東京'}すべて</option>{areaOptions.map((a) => <option value={a.id} selected={c.area === a.id}>{a.name}</option>)}</select></span></label>
        <label class="xe-sel"><span class="xe-lbl-s">ジャンル</span><span class="xe-sel-w"><select id="ev-genre" name="genre"><option value="">すべて</option>{GENRES.map((g) => <option value={g.id} selected={c.genre === g.id}>{g.name}</option>)}</select></span></label>
      </div>
      <details class="xe-adv" open={!!(c.start || c.endBy || c.budget)}>
        <summary><span><Ph list={['時間帯・終了時刻・', '予算で絞り込む']} /></span><span class="x-faq-plus" aria-hidden="true">+</span></summary>
        <div class="xe-sels" style="margin-top:18px">
          <label class="xe-sel"><span class="xe-lbl-s">開始時間帯</span><span class="xe-sel-w"><select id="ev-start" name="start"><option value="">指定なし</option><option value="morning" selected={c.start === 'morning'}>午前（〜12:00）</option><option value="afternoon" selected={c.start === 'afternoon'}>午後（12:00〜17:00）</option><option value="evening" selected={c.start === 'evening'}>夜（17:00〜）</option></select></span></label>
          <label class="xe-sel"><span class="xe-lbl-s">終了時刻の上限</span><span class="xe-sel-w"><select id="ev-end" name="end"><option value="">指定なし</option>{END_BY_OPTIONS.map((t) => <option value={t} selected={c.endBy === t}>{t}までに終わる</option>)}</select></span></label>
          <label class="xe-sel"><span class="xe-lbl-s">1人あたり予算（手数料別）</span><span class="xe-sel-w"><select id="ev-budget" name="budget"><option value="">指定なし</option>{BUDGET_OPTIONS.map((b) => <option value={b} selected={c.budget === b}>{fmtYen(b)}以内</option>)}</select></span></label>
        </div>
        <p class="xe-adv-note"><Ph list={['開演時刻・終了時刻・上限人数が', '未確認の公演は、', 'これらの条件に「合う」とは扱わず、', '結果の下に', '「条件を判定できない公演」として', '分けて表示します。']} /></p>
      </details>
      <div class="xe-submit">
        <button type="submit" class="xe-go"><span data-go-when hidden={!noWhen ? true : undefined}>いつ遊ぶかを選んで探す</span><span data-go-count hidden={noWhen ? true : undefined}>この条件で探す（<span data-gcount>{gMatched.length}</span>件）</span></button>
        <a class="xe-reset" href="/events/">条件をリセット</a>
      </div>
    </form>
  </div>
</section>

<section id="results" class="xe-sec" aria-live="polite">
  <div class="xe-in">

    <p class="xe-pick" id="ev-pick" hidden={!noWhen ? true : undefined}><Ph list={['「いつ遊ぶ？」で', '今日・明日・今週末・日付を選ぶと、', 'その日の公演回が並びます。']} /></p>
    <div id="ev-res-block" hidden={noWhen ? true : undefined}>
    <div class="xe-res-h">
      <p class="xe-res-en">Results</p>
      <h2 class="xe-res-t"><span data-window-label>{windowLabel}</span>の公演<span class="xe-res-n"><span data-gcount>{gMatched.length}</span>件</span></h2>
      <p class="xe-res-note"><Ph list={['開催日時順。', '主催者による優先表示はしていません。']} /><span class="x-c">掲載基準と修正依頼は<a href="/events/about/" style="border-bottom:1px solid;color:#fff">サービスについて</a>をご覧ください。</span></p>
      <p class="xe-res-note">販売・空席は各公演の公式ページの表示が最新です。{anyStale && <strong>日程が変わっている場合があるため、予約前に公式ページをご確認ください。</strong>}</p>
    </div>

    <div id="ev-zero" class="xe-zero" hidden={gMatched.length > 0}>
      <p class="xe-zero-t"><Ph list={['この条件に合う公演は', '見つかりませんでした。']} /></p>
      <p class="xe-zero-s">条件に合わない公演は表示していません。日付や人数を変えるか、次の候補日をお試しください。</p>
      <div class="xe-zero-btns">
        <a class="xe-zero-next" hidden={!nextDate} href={nextDate ? `/events/${criteriaToQuery({ ...c, when: 'date', date: nextDate })}#results` : '/events/'} data-next-date>{nextDate ? `次に候補がある日：${fmtDateJa(nextDate)}` : ''}</a>
        {relax.map((x) => <a class="xe-zero-rel" href={`/events/${x.q}#results`}>{x.label}</a>)}
