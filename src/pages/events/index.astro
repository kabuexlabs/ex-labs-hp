<script>
  // 絞り込みの即時反映（サーバーと同じ判定関数）。JS が無い場合はフォーム送信（GET）で同じ結果になる。
  import { parseCriteria, criteriaToQuery, matchCriteria, dateWindow, eventState } from '../../lib/events';
  import { jstDateString, addDays, weekRange, fmtDateShort, fmtDateJa } from '../../lib/thisWeek';
  const form = document.getElementById('ev-form') as HTMLFormElement | null;
  const matched = document.getElementById('ev-matched');
  const unknownList = document.getElementById('ev-unknown-list');
  const unknownBox = document.getElementById('ev-unknown') as HTMLDetailsElement | null;
  const rest = document.getElementById('ev-rest');
  const zero = document.getElementById('ev-zero');
  const LIST_DAYS = 90;
  if (form && matched && unknownList && unknownBox && rest && zero) {
    const beacon = (e: string, c: string) => {
      try {
        const b = JSON.stringify({ e, p: location.pathname, c });
        if (navigator.sendBeacon) navigator.sendBeacon('/api/track', new Blob([b], { type: 'application/json' }));
        else fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: b, keepalive: true });
      } catch (_) { /* 計測失敗は無視 */ }
    };
    const cat = (c: ReturnType<typeof parseCriteria>) => `${c.when}-p${c.party ?? 0}-${c.area || c.region || 'all'}-${c.genre || 'all'}`.slice(0, 40);
    const items = () => Array.from(document.querySelectorAll<HTMLLIElement>('#ev-matched > li, #ev-unknown-list > li, #ev-rest > li'));
    const apply = (fromUser: boolean) => {
      const now = new Date();
      const c = parseCriteria(new URLSearchParams(new FormData(form) as unknown as Record<string, string>));
      const today = jstDateString(now);
      const win = dateWindow(c, now);
      let nMatch = 0, nUnknown = 0;
      const nextDates: string[] = [];
      for (const li of items()) {
        const card = li.querySelector<HTMLElement>('.ev-card');
        if (!card) continue;
        let row: any;
        try { row = JSON.parse(card.dataset.row || ''); } catch { continue; }
        const es = eventState(row, now);
        if (es === 'ended' || es === 'cancelled') { li.remove(); continue; }
        const m = matchCriteria(row, c, now, win);
        if (m === 'match') { matched.appendChild(li); nMatch++; }
        else if (m === 'unknown') { unknownList.appendChild(li); nUnknown++; }
        else { rest.appendChild(li); if (row.date >= today && matchCriteria(row, { ...c, when: 'all', date: undefined }, now, null) === 'match') nextDates.push(row.date); }
      }
      for (const ul of [matched, unknownList]) {
        Array.from(ul.children).sort((a, b) => {
          const ra = JSON.parse((a.querySelector('.ev-card') as HTMLElement).dataset.row || '{}');
          const rb = JSON.parse((b.querySelector('.ev-card') as HTMLElement).dataset.row || '{}');
          return ra.date !== rb.date ? (ra.date < rb.date ? -1 : 1) : (ra.start ?? 1e9) - (rb.start ?? 1e9);
        }).forEach((el) => ul.appendChild(el));
      }
      const count = document.querySelector('[data-count]'); if (count) count.textContent = String(nMatch);
      const uc = document.querySelector('[data-unknown-count]'); if (uc) uc.textContent = String(nUnknown);
      const wl = document.querySelector('[data-window-label]'); if (wl) wl.textContent = win ? win.map(fmtDateJa).join('・') : `これから${LIST_DAYS}日以内`;
      zero.hidden = nMatch > 0;
      unknownBox.hidden = nUnknown === 0;
      if (nMatch === 0 && nUnknown > 0) unknownBox.open = true;
      const after = win && win.length ? win[win.length - 1] : today;
      const nd = nextDates.filter((d) => d > after).sort()[0];
      const ndA = zero.querySelector<HTMLAnchorElement>('[data-next-date]');
      if (ndA) { if (nd) { ndA.textContent = `次に候補がある日：${fmtDateJa(nd)}`; ndA.href = `/events/${criteriaToQuery({ ...c, when: 'date', date: nd })}#results`; ndA.parentElement!.hidden = false; } else ndA.parentElement!.hidden = true; }
      const wk = weekRange(now).weekend.filter((d) => d >= today);
      const lab: Record<string, string> = { today: fmtDateShort(today), tomorrow: fmtDateShort(addDays(today, 1)), weekend: wk.map(fmtDateShort).join('・') };
      form.querySelectorAll<HTMLElement>('[data-when-label]').forEach((el) => { el.textContent = lab[el.dataset.whenLabel || ''] || ''; });
      const q = criteriaToQuery(c);
      if (fromUser) {
        history.replaceState(null, '', `/events/${q}#results`);
        beacon('ev-search', cat(c));
        if (nMatch === 0) beacon('ev-zero', cat(c));
      }
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); apply(true); document.getElementById('results')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'date' && t.value) (form.querySelector('input[name=when][value=date]') as HTMLInputElement).checked = true;
      if (t.name === 'when' && t.value === 'date') { const d = document.getElementById('ev-date') as HTMLInputElement; d.focus(); if (!d.value) return; }
      apply(true);
    });
    if (document.body.dataset.evInit !== '1') { document.body.dataset.evInit = '1'; apply(false); setInterval(() => apply(false), 60000); }
  }
</script>
