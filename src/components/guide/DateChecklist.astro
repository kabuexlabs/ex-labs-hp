---
// デート・お出かけ記事の「予約前に確認すべき点」。全記事で同じ9項目（表のどの欄を見ればよいかも添える）。
const items: [string, string][] = [
  ['雨天時', '屋内で完結するか、受付後に屋外を歩くか（表の「屋内・屋外」欄）。駅から会場までの道のりは傘の用意を前提に。'],
  ['予約の必要性', '日時指定の予約制か、当日参加できるか。受付時刻・遅刻・キャンセルや日時変更の扱いは各予約ページの規約で確認。'],
  ['2人分の総額', '「1人料金×2」か「1組料金」か。予約サイトの手数料、素材費・送料などの追加料金が別にかかるか。'],
  ['所要時間', '本編の時間と、集合・受付・説明を含む時間は別。前後の予定には余裕を持たせる。'],
  ['駅からの移動時間', '最寄り駅・出口と、駅直結かどうか。徒歩の分数は各公式ページのアクセス案内で確認。'],
  ['貸切・相席', '二人だけで体験できるか、同じ回・同じチームに他の参加者が入るか。途中で二人が離れる場面があるか。'],
  ['会話量', '二人で相談する時間が中心か、キャストや他の参加者と話す場面があるか（表の「会話量」欄）。'],
  ['初心者向け', '難易度の表記、進行のサポートの有無、事前の知識や準備が必要か。'],
  ['食事へ行きやすいエリアか', '終了予定時刻と会場の最寄り駅を確認し、体験の前後に食事の予定を入れられるかを考える。'],
];
---
<dl class="dchk">
  {items.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
</dl>
<style>
.dchk{margin:16px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:10px;text-align:left}
.dchk div{background:#fff;border:1px solid #D6DFFB;padding:12px 14px}
.dchk dt{font-weight:800;font-size:14px;color:var(--x-blue,#0B35C8)}
.dchk dd{margin:4px 0 0;font-size:13.5px;line-height:1.7;color:var(--ink,#0B0B14)}
</style>
