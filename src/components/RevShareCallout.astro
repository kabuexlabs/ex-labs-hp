---
// 費用を掲載しているページに置く「原価＋実績に対するレベニューシェア」の訴求（2026-10-03 追加）。
// 解説記事は冒頭（H1・導入の直後）、サービスページは費用・条件の節に1か所ずつ置く。文言はここだけで管理する。
interface Props { href?: string; place: string; showGuide?: boolean }
const { href = '/#contact', place, showGuide = true } = Astro.props;
---
<aside class="rsc" aria-label="レベニューシェアでの実施">
  <p class="rsc-eb">REVENUE SHARE</p>
  <p class="rsc-t"><span>原価＋実績に対する</span><span>レベニューシェアで</span><span>実施できます</span></p>
  <p class="rsc-b">ex Labsの強みとして、制作費を一括でお支払いいただく方法のほかに、<strong>原価＋実績に対するレベニューシェア</strong>で実施することが可能です。掲載している費用の目安とあわせて、ご予算に合う進め方をご相談ください。</p>
  <div class="rsc-act">
    <a class="rsc-btn" href={href} data-track="cta" data-show="revshare" data-place={place}>レベニューシェアでの実施を相談する（無料）</a>
    {showGuide && <a class="rsc-sub" href="/guide/event-revenue-share/" data-track="show" data-show="guide-revshare" data-place={place}>レベニューシェアの仕組み →</a>}
  </div>
</aside>
<style>
.rsc{max-width:820px;margin:28px auto 0;padding:24px clamp(18px,4vw,32px);background:#E1F73E;color:#0B0B14;border:2px solid #0B0B14;text-align:left;box-shadow:6px 6px 0 #0B35C8}
.rsc-eb{margin:0 0 6px;font-size:11.5px;font-weight:800;letter-spacing:.2em;color:#0B35C8}
.rsc-t{margin:0;font-family:var(--x-min,serif);font-weight:800;font-size:clamp(19px,3.2vw,25px);line-height:1.5;color:#0B0B14}
.rsc-t span{display:inline-block}
.rsc-b{margin:10px 0 0;font-size:14.5px;line-height:1.9;color:#0B0B14}
.rsc-b strong{background:none!important;padding:0!important;color:#0B0B14;border-bottom:2px solid #0B0B14}
.rsc-act{margin-top:16px;display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px}
.rsc-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;background:#0B0B14;color:#fff!important;font-weight:700;font-size:14.5px;text-decoration:none!important}
.rsc-sub{display:inline-block;padding:8px 0;font-weight:700;font-size:14px;color:#0B0B14!important;border-bottom:1px solid currentColor;text-decoration:none!important}
@media(max-width:640px){.rsc-btn{width:100%}}
</style>
