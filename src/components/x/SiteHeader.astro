    <a href="/" class="x-hd-logo"><img src="/assets/exlabs-logo-w.png" alt="ex Labs" width="2048" height="520"></a>
    <a href={ctaHref} class="x-hd-cta">お問い合わせ</a>
  </div>
  <nav class="x-hd-nav" aria-label="サイト内のページ">
    <a href="/services/immersive/">イマーシブ制作</a><a href="/works/">制作事例</a><a href="/services/shisetsu-event/">施設活用</a><a href="/events/">公演を探す</a><a href="/#service">サービス</a><a href="/#about">会社概要</a><a href="/#works">実績</a><a href="/#strength">強み</a><a href="/#message">メッセージ</a><a href="/press/">プレスリリース</a><a href="/blog/">ブログ</a><a href="/game/">過去コンテンツのネタバレ</a>
  </nav>
</header>
