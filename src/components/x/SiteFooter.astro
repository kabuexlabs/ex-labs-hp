---
// 全ページ共通フッター（明朝・中央揃え・「TOP ↑」は下線テキスト）。full＝キャッチ・リンク付き／short＝住所と著作権のみ。
interface Props { footer?: 'full' | 'short' }
const { footer = 'full' } = Astro.props;
---
<footer class="x-foot">
  <p class="x-foot-name">+ · 株式会社 ex Labs · +</p>
  {footer === 'full' && <p class="x-foot-tag"><span class="x-c">AI時代に、人間が作る面白さを追求する</span> <span class="x-c">— 体験型エンターテインメントの</span><span class="x-c">企画・制作</span></p>}
  <p class="x-foot-addr"><span class="x-c">東京都新宿区西新宿3-3-13</span> <span class="x-c">西新宿水間ビル2F</span></p>
  {footer === 'full' && (
    <nav class="x-foot-links" aria-label="フッターのリンク">
      <a href="/company/">会社概要</a><a href="/services/">サービス一覧</a><a href="/works/">制作事例一覧</a><a href="/events/">公演を探す</a><a href="/guide/">解説記事一覧</a><a href="/media/">メディア掲載実績</a><a href="/press/">プレスリリース</a><a href="/blog/">ブログ</a>
    </nav>
  )}
  <p class={`x-foot-copy${footer === 'short' ? ' is-gap' : ''}`}>© 2026 ex Labs Inc.</p>
  <p class="x-foot-note">本サイトに掲載の文章・画像等の無断転載・複製を禁じます。</p>
  <a href="#top" class="x-foot-top">TOP ↑</a>
</footer>
