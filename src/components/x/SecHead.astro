---
// セクション見出し：縁取りの英字＋線つきの和文サブ見出し（2026-10 トンマナ改訂）。jaWeight="b" の長いサブ見出しは線なし。
import Cls from './Cls.astro';
interface Props { en: string; ja?: string; tag?: 'h1' | 'h2'; size?: 'l' | 'm' | 's' | 'top'; jaTag?: 'p' | 'h1' | 'h2'; jaWeight?: 'n' | 'b' }
const { en, ja, tag = 'h2', size = 'l', jaTag = 'p', jaWeight = 'n' } = Astro.props;
const Tag = tag; const JaTag = jaTag;
---
<div class="x-sh">
  <Tag class={`x-sh-en is-${size}`}>{en}</Tag>
</div>
{ja && (jaWeight === 'b'
  ? <JaTag class="x-sh-ja is-b"><Cls text={ja} emph={false} /></JaTag>
  : <JaTag class="x-sh-ja"><span class="x-sh-ln" aria-hidden="true"></span><span class="x-sh-jt"><Cls text={ja} emph={false} /></span><span class="x-sh-ln" aria-hidden="true"></span></JaTag>)}
