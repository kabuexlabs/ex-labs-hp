---
// [data-link-preview="<URL>"] を付けた要素に、リンク先の og:image（SNS のリンクカードと同じ画像）を表示する。
// 情報は /api/link-preview から取り、画像は相手のサイトから直接読み込む（こちらで保存・加工しない）。
// 取得できない・読み込めないときは何もしない（元の文字のパネルのまま）。画像の上に出典（ドメイン）を必ず出す。
// 1ページに何度置いてもよい（同じURLは1回だけ取得し、処理済みの要素は飛ばす）。
---
<script is:inline>
(() => {
  const cache = (window.__lpCache = window.__lpCache || {});
  const load = (u) => (cache[u] = cache[u] || fetch('/api/link-preview?url=' + encodeURIComponent(u)).then((r) => (r.ok ? r.json() : null)).catch(() => null));
  document.querySelectorAll('[data-link-preview]:not([data-lp-done])').forEach((el) => {
    const u = el.getAttribute('data-link-preview');
    if (!u) return;
    el.setAttribute('data-lp-done', '');
    load(u).then((j) => {
      if (!j || !j.image) return;
      const img = new Image();
      img.className = 'lp-img';
      img.alt = '';
      img.decoding = 'async';
      img.referrerPolicy = 'no-referrer';
      img.onload = () => {
        const c = document.createElement('span');
        c.className = 'lp-credit';
        c.textContent = '画像出典：' + new URL(j.image).hostname;
        el.appendChild(c);
        el.classList.add('has-lp');
      };
      img.onerror = () => img.remove();
      el.appendChild(img);
      img.src = j.image;
    });
  });
})();
</script>
<style is:global>
[data-link-preview]{position:relative;overflow:hidden}
[data-link-preview] .lp-img{display:none}
[data-link-preview].has-lp{display:block!important;padding:0!important}
[data-link-preview].has-lp > span:not(.lp-credit){display:none}
[data-link-preview].has-lp .lp-img{display:block;width:100%;height:100%;object-fit:contain;background:#000}
[data-link-preview] .lp-credit{position:absolute;top:0;right:0;padding:3px 8px;font-size:10.5px;line-height:1.4;letter-spacing:.02em;color:#fff;background:rgba(0,0,0,.6)}
</style>
