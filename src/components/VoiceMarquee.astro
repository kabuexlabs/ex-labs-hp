---
import type { Voice } from '../data/voices';

export interface Props {
  voices: Voice[];
  heading?: string;
}

const { voices, heading = 'お客様の声' } = Astro.props;
// -50%ループの片側コピーがワイド画面でもコンテナ幅を下回って途切れないよう、
// 声の枚数が少なくても track 全体が最低16枚になるまで「偶数回」繰り返す
// （偶数でないと -50% がセット境界に揃わず、継ぎ目がズレて見える）。
const reps = voices.length ? Math.max(2, Math.ceil(16 / voices.length / 2) * 2) : 0;
const track = Array(reps).fill(voices).flat();
---
{voices.length > 0 && (
  <section class="section"><div class="wrap">
  <p class="eyebrow">VOICE</p>
  <h2 class="h2 serif">{heading}</h2>
  <div class="voice-marquee">
    <div class="voice-track">
      {/* 動く帯の中の lazy 画像は読み込みが間に合わず途切れて見えるため eager 固定 */}
      {track.map((v, i) => (
        <img class="voice-card" src={v.src} alt={i < voices.length ? v.alt : ''} aria-hidden={i >= voices.length ? 'true' : undefined} loading="eager" decoding="async" />
      ))}
    </div>
  </div>
  </div></section>
)}
