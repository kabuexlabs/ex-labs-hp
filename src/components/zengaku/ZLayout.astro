---
// 全国学生 未来視察連盟 LP（仮・限定公開）の共通レイアウト：head・ヘッダー・フッター・共通スタイル。
// 参考デザイン（2026-11-27 ユーザー提供のスクリーンショット：トビタテ!留学JAPAN／日米学生会議）の雰囲気のみ。
// ロゴ・画像・文言は使っていない（赤×青の2点を結ぶ「視察ルート」の印は自作）。
import { BASE, ORG, VARS, isClosed } from '../../lib/zengaku';
interface Props { title: string; description: string; ogTitle?: string; ogDesc?: string; sticky?: boolean; page?: string }
const { title, description, ogTitle, ogDesc, sticky = false, page = '' } = Astro.props;
const closed = isClosed();
const nav = [
  { href: `${BASE}/#about`, label: '私たちについて' },
  { href: `${BASE}/#activities`, label: '活動内容' },
  { href: `${BASE}/#reports`, label: '活動報告' },
  { href: `${BASE}/representative/`, label: '学内代表の募集' },
  { href: `${BASE}/#contact`, label: 'お問い合わせ' },
];
const applyHref = `${BASE}/milano/#apply`;
---
<!doctype html>
<html lang="ja" data-page={page}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="theme-color" content="#ffffff">
<meta property="og:type" content="website">
<meta property="og:site_name" content={ORG}>
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={ogDesc ?? description}>
<meta property="og:locale" content="ja_JP">
<link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><circle cx="10" cy="20" r="7" fill="#d7343c"/><circle cx="24" cy="9" r="5" fill="#2557b0"/></svg>')}`}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
<script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
<a class="skip" href="#main">本文へ移動</a>
<header class="hd" id="hd">
  <div class="hd-in">
    <a class="brand" href={`${BASE}/`} aria-label={`${ORG} トップへ`}>
      <svg class="brand-mark" viewBox="0 0 44 32" aria-hidden="true"><path d="M9 23 C 16 6, 28 4, 35 9" fill="none" stroke="#9aa9c7" stroke-width="1.6" stroke-dasharray="2.4 3"/><circle cx="9" cy="23" r="7" fill="var(--red)"/><circle cx="35" cy="9" r="5" fill="var(--blue)"/></svg>
      <span class="brand-t"><span class="brand-s">全国学生</span><span class="brand-m">未来視察連盟</span></span>
    </a>
    <nav class="gnav" aria-label="メインメニュー">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <a class={`hd-cta${closed ? ' is-off' : ''}`} href={closed ? undefined : applyHref} aria-disabled={closed ? 'true' : undefined}>{closed ? '応募受付は終了しました' : 'ミラノツアーに応募する'}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="drawer"><span class="menu-l">メニュー</span><span class="menu-i" aria-hidden="true"><i></i><i></i><i></i></span></button>
  </div>
  <div class="drawer" id="drawer" hidden>
    <ul>{nav.map((n) => <li><a href={n.href}>{n.label}<span aria-hidden="true">→</span></a></li>)}</ul>
    <a class={`btn btn-red${closed ? ' is-off' : ''}`} href={closed ? undefined : applyHref} aria-disabled={closed ? 'true' : undefined}>{closed ? '応募受付は終了しました' : 'ミラノツアーに応募する'}</a>
  </div>
</header>

<main id="main"><slot /></main>

<footer class="ft">
  <div class="ft-in">
    <p class="ft-brand">
      <svg class="brand-mark" viewBox="0 0 44 32" aria-hidden="true"><path d="M9 23 C 16 6, 28 4, 35 9" fill="none" stroke="#9aa9c7" stroke-width="1.6" stroke-dasharray="2.4 3"/><circle cx="9" cy="23" r="7" fill="var(--red)"/><circle cx="35" cy="9" r="5" fill="var(--blue)"/></svg>
      <span>{ORG}</span>
    </p>
    <ul class="ft-links">
      <li><a href={`${BASE}/milano/`}>ミラノ建築短期留学ツアー</a></li>
      <li><a href={`${BASE}/representative/`}>学内代表の募集</a></li>
      <li><a href={`${BASE}/#contact`}>お問い合わせ</a></li>
      <li><a href={`${BASE}/privacy/`}>プライバシーポリシー</a></li>
    </ul>
    {(VARS.SNS_INSTAGRAM || VARS.SNS_X) && (
      <ul class="sns">
        {VARS.SNS_INSTAGRAM && <li><a href={VARS.SNS_INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg></a></li>}
        {VARS.SNS_X && <li><a href={VARS.SNS_X} target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24"><path d="M4 4h4.6l4 5.6L17.4 4H20l-6.2 7.2L20.5 20h-4.6l-4.3-6-5.1 6H4l6.4-7.4z" fill="currentColor"/></svg></a></li>}
      </ul>
    )}
    <p class="copy">© 2026 {ORG}</p>
  </div>
</footer>

<a class="totop" href="#hd" aria-label="ページの先頭へ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg><span>TOP</span></a>

{sticky && (
  <div class="sticky" id="sticky">
    {closed
      ? <span class="sticky-btn is-off" aria-disabled="true">応募受付は終了しました</span>
      : <a class="sticky-btn" href="#apply"><span class="sticky-badge">応募受付中</span>応募する（1/15締切）</a>}
  </div>
)}

<script is:inline>
(function(){
  var btn=document.querySelector('.menu-btn'),dr=document.getElementById('drawer');
  if(btn&&dr){
    var set=function(o){btn.setAttribute('aria-expanded',o?'true':'false');dr.hidden=!o;document.documentElement.classList.toggle('menu-open',o)};
    btn.addEventListener('click',function(){set(dr.hidden)});
    dr.addEventListener('click',function(e){if(e.target.closest('a'))set(false)});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')set(false)});
  }
  // スクロールで現れる
  var els=[].slice.call(document.querySelectorAll('.rv'));
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(el){io.observe(el)});
  }else{els.forEach(function(el){el.classList.add('in')})}
  // TOP ボタンと追従ボタン：少しスクロールしてから出す。追従ボタンは応募フォームが見えている間は隠す
  var root=document.documentElement,ap=document.getElementById('apply');
  var onScroll=function(){root.classList.toggle('scrolled',window.scrollY>480)};
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  if(ap&&'IntersectionObserver' in window){new IntersectionObserver(function(es){root.classList.toggle('at-apply',es[0].isIntersecting)}).observe(ap)}
})();
</script>

<style is:global>
:root{
  --red:#d7343c;--red-d:#b9262e;--blue:#2557b0;--blue-d:#173f87;--sky:#e4f3fb;--sky-2:#cfe9f6;--ink:#1d222b;--ink-2:#454c59;--muted:#6b7280;
  --line:#dfe4ea;--paper:#ffffff;--cream:#faf8f3;--yellow:#f4e94f;
  --mincho:'Shippori Mincho B1','Hiragino Mincho ProN','Yu Mincho',serif;
  --gothic:'Zen Kaku Gothic New','Hiragino Kaku Gothic ProN','Hiragino Sans','Yu Gothic',Meiryo,sans-serif;
  --en:'Cormorant Garamond','Times New Roman',serif;
  --w:1080px;--r:14px;--sh:0 10px 30px rgba(23,40,80,.08);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;scroll-padding-top:84px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{font-variant-numeric:lining-nums}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--gothic);font-weight:500;font-size:16px;line-height:1.9;letter-spacing:.03em;overflow-x:hidden;font-feature-settings:"palt" 0}
img,svg{max-width:100%}
a{color:var(--blue)}
.wb{word-break:keep-all;overflow-wrap:anywhere}
h1,h2,h3,p,ul,ol,dl,dd,figure{margin:0}
ul,ol{padding:0;list-style:none}
.skip{position:absolute;left:-9999px}
.skip:focus{left:12px;top:12px;z-index:200;background:#fff;padding:8px 12px}
.wrap{max-width:var(--w);margin:0 auto;padding:0 20px}
@media (max-width:480px){.wrap{padding:0 16px}}

/* ---------- header ---------- */
.hd{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);box-shadow:0 1px 0 rgba(0,0,0,.06)}
.hd-in{max-width:1240px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;gap:20px;min-height:68px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);flex-shrink:0}
.brand-mark{width:40px;height:30px;flex-shrink:0}
.brand-t{display:flex;flex-direction:column;line-height:1.15}
.brand-s{font-size:11px;letter-spacing:.32em;color:var(--ink-2);font-weight:700}
.brand-m{font-family:var(--mincho);font-weight:800;font-size:20px;letter-spacing:.08em}
.gnav{margin-left:auto}
.gnav ul{display:flex;gap:4px}
.gnav a{display:block;padding:8px 10px;color:var(--ink);text-decoration:none;font-size:14px;font-weight:700;letter-spacing:.06em;position:relative}
.gnav a::after{content:"";position:absolute;left:10px;right:10px;bottom:4px;height:2px;background:linear-gradient(90deg,var(--red),var(--blue));transform:scaleX(0);transform-origin:left;transition:transform .3s}
.gnav a:hover::after{transform:scaleX(1)}
.hd-cta{flex-shrink:0;background:var(--red);color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:11px 20px;border-radius:999px;letter-spacing:.06em;transition:background .2s,transform .2s}
.hd-cta:hover{background:var(--red-d);transform:translateY(-1px)}
.menu-btn{display:none}
.drawer{display:none}
@media (max-width:1000px){
  .gnav{display:none}
  .hd-in{padding:8px 0 8px 16px;gap:10px;min-height:62px}
  .hd-cta{margin-left:auto;padding:9px 14px;font-size:12.5px}
  .menu-btn{display:flex;align-items:center;gap:8px;border:0;background:var(--red);color:#fff;font:700 13px/1 var(--gothic);letter-spacing:.1em;padding:0 14px;height:62px;margin:-8px 0;cursor:pointer}
  .menu-i{display:flex;flex-direction:column;gap:5px}
  .menu-i i{display:block;width:22px;height:2px;background:#fff;transition:transform .25s,opacity .25s}
  [aria-expanded="true"] .menu-i i:nth-child(1){transform:translateY(7px) rotate(45deg)}
  [aria-expanded="true"] .menu-i i:nth-child(2){opacity:0}
  [aria-expanded="true"] .menu-i i:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .drawer{display:block;position:absolute;left:0;right:0;top:100%;background:#fff;padding:8px 20px 24px;box-shadow:0 20px 30px rgba(0,0,0,.12);max-height:calc(100vh - 62px);overflow:auto}
  .drawer[hidden]{display:none}
  .drawer li a{display:flex;justify-content:space-between;padding:16px 4px;border-bottom:1px solid var(--line);color:var(--ink);text-decoration:none;font-weight:700}
  .drawer li a span{color:var(--red)}
  .drawer .btn{margin-top:20px;width:100%}
}
@media (max-width:400px){.brand-m{font-size:17px}.brand-mark{width:32px}.hd-cta{display:none}.menu-btn{margin-left:auto}}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:60px;padding:14px 34px;border-radius:999px;font-weight:700;font-size:16px;letter-spacing:.06em;text-decoration:none;transition:transform .2s,background .2s,box-shadow .2s;text-align:center;line-height:1.5;border:0;cursor:pointer;font-family:var(--gothic)}
.btn .ar{display:inline-block;transition:transform .2s}
.btn:hover .ar{transform:translateX(4px)}
.btn-red{background:var(--red);color:#fff;box-shadow:0 8px 20px rgba(215,52,60,.25)}
.btn-red:hover{background:var(--red-d);transform:translateY(-2px)}
.btn-line{background:#fff;color:var(--blue);border:1.5px solid var(--blue)}
.btn-line:hover{background:var(--blue);color:#fff}
.btn-blue{background:var(--blue);color:#fff}
.btn-blue:hover{background:var(--blue-d)}
.is-off,.btn.is-off,.btn:disabled{background:#c9ced6!important;color:#fff!important;box-shadow:none!important;cursor:not-allowed;transform:none!important;pointer-events:none}

/* ---------- section heading ---------- */
.sec{padding:96px 0}
@media (max-width:640px){.sec{padding:72px 0}}
.sh{text-align:center;margin-bottom:44px}
.sh-en{font-family:var(--en);font-style:italic;font-weight:500;font-size:20px;color:var(--blue);letter-spacing:.08em;line-height:1}
.sh-ja{font-family:var(--mincho);font-weight:800;font-size:clamp(28px,4.4vw,40px);letter-spacing:.08em;line-height:1.45;margin-top:10px}
.sh-route{display:block;width:84px;height:14px;margin:18px auto 0;background:
  radial-gradient(circle at 6px 7px,var(--red) 5px,transparent 5.5px),
  radial-gradient(circle at 79px 7px,var(--blue) 4px,transparent 4.5px),
  linear-gradient(90deg,transparent 12px,#9aa9c7 12px) 0 6.3px/100% 1.4px no-repeat}
.sh-lead{margin-top:18px;color:var(--ink-2)}
.sh.left{text-align:left}
.sh.left .sh-route{margin-left:0}

/* ---------- reveal ---------- */
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
.js .rv.in{opacity:1;transform:none}
.js .rv.d1{transition-delay:.08s}.js .rv.d2{transition-delay:.16s}.js .rv.d3{transition-delay:.24s}.js .rv.d4{transition-delay:.32s}
@media (prefers-reduced-motion:reduce){.js .rv{opacity:1;transform:none;transition:none}}

/* ---------- TBD marker ---------- */
.tbd{display:inline;border-bottom:1.5px dashed #e08a8f}
.tbd-note{display:inline-block;margin-left:.4em;font-size:11px;font-weight:700;color:#fff;background:#d7343c;border-radius:4px;padding:1px 6px;vertical-align:2px;letter-spacing:.04em;line-height:1.6}

/* ---------- footer ---------- */
.ft{background:var(--cream);border-top:1px solid var(--line);padding:56px 0 calc(40px + env(safe-area-inset-bottom))}
.ft-in{max-width:var(--w);margin:0 auto;padding:0 20px;text-align:center}
.ft-brand{display:inline-flex;align-items:center;gap:10px;font-family:var(--mincho);font-weight:800;font-size:20px;letter-spacing:.08em}
.ft-links{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 22px;margin:24px 0}
.ft-links a{color:var(--ink-2);text-decoration:none;font-size:14px}
.ft-links a:hover{color:var(--red)}
.sns{display:flex;justify-content:center;gap:18px;margin-bottom:22px}
.sns a{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#fff;color:var(--ink);box-shadow:var(--sh)}
.sns svg{width:22px;height:22px}
.copy{font-size:12px;color:var(--muted);letter-spacing:.06em}
[data-page="milano"] .ft{padding-bottom:calc(120px + env(safe-area-inset-bottom))}
@media (min-width:821px){[data-page="milano"] .ft{padding-bottom:40px}}

/* ---------- to top / sticky ---------- */
.totop{position:fixed;right:14px;bottom:calc(18px + env(safe-area-inset-bottom));z-index:40;width:56px;height:56px;border-radius:12px;background:var(--blue);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-decoration:none;font:600 11px/1 var(--en);letter-spacing:.12em;opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .3s,transform .3s;box-shadow:0 8px 20px rgba(37,87,176,.3)}
.totop svg{width:18px;height:18px;margin-bottom:3px}
.scrolled .totop{opacity:1;pointer-events:auto;transform:none}
[data-page="milano"] .totop{bottom:calc(96px + env(safe-area-inset-bottom))}
@media (min-width:821px){[data-page="milano"] .totop{bottom:calc(18px + env(safe-area-inset-bottom))}}
.sticky{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:45;transition:transform .35s,opacity .35s}
.sticky-btn{display:flex;align-items:center;justify-content:center;min-height:62px;border-radius:14px;background:var(--red);color:#fff;font-weight:900;font-size:17px;letter-spacing:.08em;text-decoration:none;box-shadow:0 10px 26px rgba(23,40,80,.25);position:relative}
.sticky-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--yellow);color:var(--ink);font-size:12px;font-weight:700;padding:3px 14px;border-radius:999px;letter-spacing:.08em;line-height:1.5;white-space:nowrap}
.at-apply .sticky{transform:translateY(140%);opacity:0;pointer-events:none}
@media (min-width:821px){.sticky{display:none}}
.menu-open .sticky,.menu-open .totop{opacity:0;pointer-events:none}
</style>
</body>
</html>
