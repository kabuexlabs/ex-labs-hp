---
// 東大マーダーミステリーサークル (/toudaimurder/) 用の「お客様の声」マーキー。
// 本体サイトの VoiceMarquee.astro と同じ考え方 (画像を横スクロール) を、
// ダークテーマ・ToudaimurderLayout の変数 (--acc / --ln / --dim) に合わせて再実装。
import type { TmVoice } from '../data/toudaimurderWorks';

export interface Props {
  voices: TmVoice[];
  heading?: string;
}

const { voices, heading = 'お客様の声' } = Astro.props;
// -50%ループの片側コピーがワイド画面でもコンテナ幅を下回って途切れないよう、
// 声の枚数が少なくても track 全体が最低16枚になるまで「偶数回」繰り返す
// （偶数でないと -50% がセット境界に揃わず、継ぎ目がズレて見える）。
const reps = voices.length ? Math.max(2, Math.ceil(16 / voices.length / 2) * 2) : 0;
const track = Array(reps).fill(voices).flat();
---

{voices.length > 0 && (
  <section class="wrap bt vsec">
    <div class="shead rv"><h2 class="sh"><span class="sht en" style="font-size:clamp(40px,4.6vw,72px)">VOICE</span><span class="shj">{heading}</span></h2></div>
    <div class="vmq rv d1">
      <div class="vtrack">
        {/* 動く帯の中の lazy 画像は読み込みが間に合わず途切れて見えるため eager 固定 */}
        {track.map((v, i) => (
          <img class="vcard" src={v.src} alt={i < voices.length ? v.alt : ''} aria-hidden={i >= voices.length ? 'true' : undefined} loading="eager" decoding="async" width="360" height="360">
        ))}
      </div>
    </div>
  </section>
)}

<style>
/* .shead は各ページ側で個別定義されており (Astro のスコープCSS)、
   コンポーネント自身には効かない。ここで独自に余白を持たせる。 */
.vsec{padding-top:72px;padding-bottom:88px}
.shead{padding-bottom:44px}
.vmq{overflow:hidden;position:relative;-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.vtrack{display:flex;align-items:flex-start;gap:24px;width:max-content;animation:vmq 34s linear infinite;will-change:transform;backface-visibility:hidden;transform:translate3d(0,0,0)}
.vtrack:hover{animation-play-state:paused}
@keyframes vmq{to{transform:translate3d(-50%,0,0)}}
.vcard{flex:none;height:320px;width:auto;border:1px solid var(--ln);border-radius:4px}
@media (prefers-reduced-motion:reduce){.vtrack{animation:none}}
@media (max-width:700px){.vsec{padding-top:48px}.shead{padding-bottom:28px}.vcard{height:220px}}
</style>
