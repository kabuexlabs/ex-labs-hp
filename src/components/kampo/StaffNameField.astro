---
// 担当薬剤師の入力欄（KAMPO_STAFF_NAMES があれば選択式、なければ氏名の入力）。「その他」を選ぶと入力欄を出す（ページ側のスクリプト）。
export interface Props { name: string; current?: string; names: string[]; label?: string }
const { name, current = '', names, label = '担当薬剤師' } = Astro.props;
---
<label class="kp-field" style="margin-top:0">{label}
  {names.length ? (
    <select class="kp-input kp-staffsel" name={name} data-other={`${name}Other`}>
      <option value="">選択してください</option>
      {names.map((n) => <option value={n} selected={n === current}>{n}</option>)}
      <option value="__other" selected={!!current && !names.includes(current)}>その他（入力）</option>
    </select>
  ) : (
    <input class="kp-input" type="text" name={name} value={current} placeholder="氏名（KAMPO_STAFF_NAMES に登録すると選択式になります）">
  )}
  {names.length > 0 && <input class="kp-input" type="text" name={`${name}Other`} value={!names.includes(current) ? current : ''} placeholder="担当者名" style="margin-top:8px" hidden={!current || names.includes(current)}>}
</label>
