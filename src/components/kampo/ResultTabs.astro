---
// 結果まわりのタブ（体質チェック結果／改善アドバイス／おすすめの漢方薬）
export interface Props { id: string; active: 'result' | 'advice' | 'kampo'; adviceType?: string }
const { id, active, adviceType } = Astro.props;
const base = `/kampo/check/${id}`;
const tabs = [
  { key: 'result', label: '体質チェック結果', href: `${base}/result/#result` },
  { key: 'advice', label: '改善アドバイス', href: adviceType ? `${base}/advice/${adviceType}/` : `${base}/result/#advice` },
  { key: 'kampo', label: 'おすすめの漢方薬', href: `${base}/result/#kampo` },
];
---
<nav class="kp-tabs no-print" aria-label="結果の項目">
  {tabs.map((t) => <a class:list={[{ on: t.key === active }]} href={t.href} aria-current={t.key === active ? 'page' : undefined}>{t.label}</a>)}
</nav>
