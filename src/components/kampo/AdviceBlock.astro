---
// 改善アドバイス：特徴（summary）→ 生活養生（心・食・動・休）→ おすすめのツボ → あなたへの一言 → 監修者。
// 改善アドバイス画面と、体質の説明画面の印刷用2ページ目で共用する。
import { TYPE_DEFS, type AdviceKey } from '../../lib/kampo/masters';
import { personalTips } from '../../lib/kampo/flow';
import { typeIconSvg } from '../../lib/kampo/icons';
import { supervisorName, supervisorBio } from '../../lib/kampo/compute';
import type { Answers } from '../../lib/kampo/flow';
export interface Props { type: AdviceKey; answers: Answers; showSupervisor?: boolean }
const { type, answers, showSupervisor = true } = Astro.props;
const d = TYPE_DEFS[type];
const tips = personalTips(answers, type);
const sup = supervisorName();
const bio = supervisorBio();
const ADVICE: [keyof typeof d.advice, string][] = [['mind', '心'], ['food', '食'], ['move', '動'], ['rest', '休']];
---
<section class="kp-panel kp-advice">
  <h2>{d.name}（{d.reading}）の改善アドバイス</h2>
  <div class="kp-panel-b">
    <div class="kp-advice-head">
      <div class="kp-ring" style={`--c:${d.color}`}><small>{d.name}</small><span class="kp-advice-icon"><Fragment set:html={typeIconSvg(type, 40)} /></span></div>
      <div>
        <p class="kp-advice-headline">{d.headline}</p>
        <p class="kp-advice-text">{d.summary}</p>
      </div>
    </div>
    <h3 class="kp-h2">生活養生</h3>
    <div class="kp-advice-grid">
      {ADVICE.map(([k, label]) => (
        <div class="kp-advice-item"><span class="kp-advice-badge">{label}</span><p>{d.advice[k]}</p></div>
      ))}
    </div>
    <h3 class="kp-h2">おすすめのツボ</h3>
    <div class="kp-tsubo">
      <p class="kp-tsubo-name">{d.tsubo.name}<small>（{d.tsubo.reading}）</small></p>
      <p><b>位置</b>　{d.tsubo.position}</p>
      <p><b>効果</b>　{d.tsubo.effect}</p>
    </div>
    {tips.length > 0 && <div class="kp-tip"><b>あなたへの一言</b>　{tips.join('　')}</div>}
    {showSupervisor && <p class="kp-supervisor">監修：{sup || '（薬剤師名を設定してください）'}{bio && <span>　{bio}</span>}</p>}
  </div>
</section>
<style is:global>
.kp-advice-head{display:grid;grid-template-columns:180px 1fr;gap:28px;align-items:center}
.kp-advice-head .kp-ring{margin:8px}
.kp-advice-icon{color:var(--sky);margin:4px 0}
.kp-advice-headline{font-size:21px;letter-spacing:.08em;margin-bottom:8px}
.kp-advice-text{font-size:15.5px;line-height:2}
.kp-advice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.kp-advice-item{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start;background:var(--panel);padding:16px 18px}
.kp-advice-item p{font-size:15px;line-height:1.9}
.kp-advice-badge{width:40px;height:40px;border-radius:50%;background:#9A9A9A;color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:500}
.kp-tsubo{background:var(--panel);padding:18px 22px;font-size:15px;display:grid;gap:4px}
.kp-tsubo-name{font-size:18px;font-weight:500}
.kp-tsubo-name small{font-size:13px;color:var(--muted)}
.kp-tip{margin-top:18px;padding:16px 22px;background:var(--sky-soft);font-size:15.5px}
.kp-supervisor{margin-top:22px;padding-top:14px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
@media(max-width:760px){.kp-advice-head{grid-template-columns:1fr;justify-items:center}.kp-advice-grid{grid-template-columns:1fr}}
@media print{.kp-advice-head{grid-template-columns:120px 1fr;gap:14px}.kp-advice-head .kp-ring{width:96px;height:96px}.kp-advice-head .kp-ring b{font-size:30px}.kp-advice-text,.kp-advice-item p,.kp-tsubo{font-size:11px;line-height:1.7}.kp-advice-item{padding:8px 10px}.kp-tip{padding:8px 12px;font-size:11px;margin-top:8px}.kp-supervisor{margin-top:8px;font-size:10.5px}}
</style>
