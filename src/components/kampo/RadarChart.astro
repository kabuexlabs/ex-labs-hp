---
// レーダーチャート（サーバー側で描く SVG。JS 不要）。軸は上から時計回り。
// v2 では気血水6証（気虚・血虚・気滞・瘀血・水滞・陰虚）を、各証の「強く示唆」の暫定カットオフに対する割合で描く。
export interface Axis { label: string; value: number; color?: string; note?: string }
export interface Props { axes: Axis[]; size?: number; title?: string }
const { axes, size = 360, title = '体質バランス' } = Astro.props;
const cx = size / 2;
const cy = size / 2;
const R = size * 0.34;
const n = Math.max(3, axes.length);
const clamp = (v: number) => Math.max(0, Math.min(100, v));
const angle = (i: number) => -Math.PI / 2 + (i * 2 * Math.PI) / n;
const pt = (i: number, r: number) => [cx + r * Math.cos(angle(i)), cy + r * Math.sin(angle(i))] as const;
const ring = (frac: number) => axes.map((_, i) => pt(i, R * frac).map((v) => v.toFixed(1)).join(',')).join(' ');
const data = axes.map((a, i) => pt(i, (R * clamp(a.value)) / 100).map((v) => v.toFixed(1)).join(',')).join(' ');
const labelR = R * 1.26;
const desc = axes.map((a) => `${a.label} ${a.note ?? Math.round(a.value)}`).join('、');
---
<svg class="kp-radar" viewBox={`-64 0 ${size + 128} ${size}`} width="100%" role="img" aria-label={`${title}：${desc}`}>
  <title>{title}</title>
  {[0.2, 0.4, 0.6, 0.8, 1].map((f) => (
    <polygon points={ring(f)} fill={f === 1 ? '#F7FBFD' : 'none'} stroke="#D9D9D9" stroke-width={f === 1 ? 1.5 : 1} />
  ))}
  {axes.map((_, i) => { const [x, y] = pt(i, R); return <line x1={cx} y1={cy} x2={x.toFixed(1)} y2={y.toFixed(1)} stroke="#D9D9D9" stroke-width="1" />; })}
  <polygon points={data} fill="#86CDE8" fill-opacity="0.35" stroke="#5FB8DD" stroke-width="2.5" stroke-linejoin="round" />
  {axes.map((a, i) => { const [x, y] = pt(i, (R * clamp(a.value)) / 100); return <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="5" fill={a.color ?? '#5FB8DD'} stroke="#fff" stroke-width="1.5" />; })}
  {axes.map((a, i) => {
    const [x, y] = pt(i, labelR);
    const ang = angle(i);
    const anchor = Math.abs(Math.cos(ang)) < 0.2 ? 'middle' : Math.cos(ang) > 0 ? 'start' : 'end';
    return (
      <text x={x.toFixed(1)} y={y.toFixed(1)} text-anchor={anchor} dominant-baseline="middle" font-size={size * 0.04} font-weight="700" fill="#2B2B2B">
        {a.label}
        {a.note && <tspan font-size={size * 0.034} font-weight="500" fill="#6B6B6B"> {a.note}</tspan>}
      </text>
    );
  })}
</svg>
