---
// 調査期間終了の全画面表示。問題一覧・問題詳細ページに置かれ、
// 期限切れを検知したページスクリプトが .open を付けて表示する。
// リピーターはここから新しい調査として再スタートできる。
import { caseConfig } from '../../data/case/config';
---

<div class="overlay center expired-overlay" id="expired-overlay" aria-hidden="true">
  <div class="sheet expired-sheet" role="dialog" aria-modal="true" aria-labelledby="expired-title">
    <div class="expired-icon" aria-hidden="true">
      {/* lucide: timer-off 系のシンプルな時計アイコン */}
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M10 2h4"/></svg>
    </div>
    <p class="en-label expired-en" id="expired-title">Time Up</p>
    <p class="expired-jp">調査期間が終了しました</p>
    <p class="expired-desc">
      この調査の有効時間（開始から{caseConfig.timeLimitHours}時間）を過ぎたため、
      問題の閲覧・回答はできなくなりました。
    </p>
    <div class="expired-actions">
      <a href="/case/result/" class="btn btn-ghost" id="expired-result" hidden>これまでの調査結果を見る</a>
      <button type="button" class="btn btn-primary" id="expired-restart">新しい調査を開始する</button>
    </div>
    <p class="expired-note">
      新しく開始すると、これまでの進捗はリセットされ最初からの挑戦になります。
    </p>
  </div>
</div>

<script>
  import { restartInvestigation } from '../../lib/case/session';
  document.getElementById('expired-restart')?.addEventListener('click', () => {
    restartInvestigation();
    window.location.href = '/case/questions/';
  });
</script>

<style>
/* 期限切れは閉じられないブロッキング表示。背景を濃くして下の情報を隠す */
.expired-overlay{background:var(--scrim-strong)}
.expired-sheet{text-align:center}
.expired-icon{
  display:flex;align-items:center;justify-content:center;
  width:56px;height:56px;margin:4px auto 18px;
  border:1px solid var(--ink);border-radius:50%;color:var(--ink);
}
.expired-en{margin:0;font-size:13px}
.expired-jp{margin:10px 0 0;font-size:20px;font-weight:700;letter-spacing:.08em}
.expired-desc{margin:12px 0 22px;font-size:13.5px;color:var(--sub);line-height:2}
.expired-actions{display:flex;flex-direction:column;gap:10px}
.expired-note{margin:14px 0 0;font-size:11.5px;color:var(--sub);line-height:1.8}
</style>
