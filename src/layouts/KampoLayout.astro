---
// 漢方体質チェック（/kampo/）専用レイアウト。
// 非公開ツール（合言葉＋PIN）なので、サイト共通のナビ・フッター・計測・JSON-LD は載せず、
// noindex と no-store を必ず付ける。
// デザイン（2026-10-24〜）：白地に淡い水色のアクセント、細身の英字タイトル、枠線の選択肢、
// 「Q」マーク、丸いボタン、水色帯の見出し。来店客モードとスタッフ画面はヘッダー色で見分ける。
export interface Props {
  title: string;
  mode?: 'customer' | 'staff';
  /** 本文の最大幅 */
  width?: 'narrow' | 'normal' | 'wide';
  /** 設問の進捗（ヘッダー右に丸と％を出す） */
  progress?: { done: number; total: number };
}
const { title, mode = 'customer', width = 'normal', progress } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
const shop = 'ESSENCE薬局';
const pct = progress ? Math.round((100 * progress.done) / Math.max(1, progress.total)) : 0;
const dots = 5;
const filled = progress ? Math.round((dots * progress.done) / Math.max(1, progress.total)) : 0;
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="format-detection" content="telephone=no">
<title>{title}｜{shop} 体質チェック</title>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400&family=Noto+Sans+JP:wght@300;400;500;700&display=swap">
<style is:global>
:root{
  --sky:#86CDE8;--sky-strong:#5FB8DD;--sky-text:#3E9FD2;--sky-soft:#EAF8FD;--sky-band:#DAEEF8;--sky-mist:#F3FAFD;
  --ink:#333333;--ink-2:#555555;--muted:#888888;--line:#D9D9D9;--line-soft:#ECECEC;--radio:#E3E3E3;--paper:#FFFFFF;--panel:#F3F3F3;
  --pink:#E2457B;--danger:#C62828;--danger-soft:#FDECEC;--danger-deep:#8E1B1B;--warn:#8A5A00;--warn-soft:#FFF5DC;--info:#2F6E95;--info-soft:#EAF4FA;
  --staff:#3F5566;
  --en:'Lato','Noto Sans JP',sans-serif;
  --accent:var(--sky-strong);--accent-soft:var(--sky-soft);--accent-dark:var(--sky-text);
}
*{box-sizing:border-box}
html{font-size:16px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Noto Sans JP',system-ui,sans-serif;font-weight:400;-webkit-font-smoothing:antialiased;letter-spacing:.06em;line-height:1.85;min-height:100vh}
a{color:var(--sky-text)}
img{max-width:100%;display:block}
h1,h2,h3{margin:0;line-height:1.5;font-weight:400}
p{margin:0}
/* ヘッダー */
.kp-head{background:var(--paper);border-bottom:1px solid var(--line-soft)}
.kp-head.staff{background:var(--staff);border-bottom-color:var(--staff);color:#fff}
.kp-head-in{max-width:1180px;margin:0 auto;padding:18px 24px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.kp-brand{text-decoration:none;color:inherit;display:block;line-height:1.15}
.kp-brand .en{display:block;font-family:var(--en);font-weight:300;font-size:30px;letter-spacing:.02em;color:var(--ink)}
.kp-brand .en b{font-weight:300;color:var(--sky)}
.kp-brand .ja{display:block;font-size:13px;letter-spacing:.14em;color:var(--ink-2);margin-top:6px}
.kp-head.staff .kp-brand .en,.kp-head.staff .kp-brand .ja{color:#fff}
.kp-head.staff .kp-brand .en b{color:#BFE6F5}
.kp-head-actions{margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.kp-progress~.kp-head-actions{margin-left:0}
.kp-head-actions:empty{display:none}
.kp-progress{display:flex;align-items:center;gap:10px;margin-left:auto}
.kp-progress i{width:14px;height:14px;border-radius:50%;background:#CFCFCF;display:block}
.kp-progress i.on{background:var(--sky)}
.kp-progress b{font-family:var(--en);font-weight:400;font-size:22px;color:var(--sky);margin-left:12px;letter-spacing:0;min-width:3.2em;text-align:right}
.kp-main{margin:0 auto;padding:40px 24px 80px}
.kp-main.narrow{max-width:760px}.kp-main.normal{max-width:1040px}.kp-main.wide{max-width:1180px}
/* 共通の部品 */
.kp-card{background:var(--paper);border:1px solid var(--line);padding:28px 32px}
.kp-card+.kp-card{margin-top:20px}
.kp-title{font-size:28px;font-weight:400;letter-spacing:.1em;line-height:1.5}
.kp-title .sky{color:var(--sky)}
.kp-lede{color:var(--ink-2);font-size:15px;margin-top:8px}
.kp-eyebrow{font-family:var(--en);font-size:14px;letter-spacing:.24em;color:var(--sky-text);text-transform:uppercase}
.kp-note{font-size:13.5px;color:var(--muted)}
/* 左に水色の縦線つきの大見出し */
.kp-h1{position:relative;padding-left:28px;font-size:30px;font-weight:400;letter-spacing:.1em;line-height:1.5;margin:8px 0 22px}
.kp-h1::before{content:'';position:absolute;left:0;top:.15em;bottom:.15em;width:8px;background:var(--sky)}
.kp-h1 .sky{color:var(--sky)}
/* 水色の帯の見出しつきのパネル */
.kp-panel{border:1px solid var(--line);background:var(--paper);margin-top:28px}
.kp-panel>h2,.kp-panel-h{background:var(--sky-band);padding:18px 28px;font-size:20px;font-weight:700;letter-spacing:.08em;color:#4A4A4A}
.kp-panel-b{padding:28px 32px}
.kp-h2{font-size:18px;font-weight:500;letter-spacing:.1em;margin:28px 0 12px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.kp-h2:first-child{margin-top:0}
.kp-rule{border:0;border-top:1px solid var(--line);margin:36px 0}
/* ボタン（丸いピル型） */
.kp-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:10px 34px;border-radius:999px;border:1px solid var(--sky);background:var(--sky);color:#fff;font:inherit;font-size:16px;font-weight:500;letter-spacing:.12em;cursor:pointer;text-decoration:none;transition:background .15s,color .15s,border-color .15s;position:relative}
.kp-btn:hover{background:var(--sky-strong);border-color:var(--sky-strong)}
.kp-btn:disabled,.kp-btn[aria-disabled=true]{background:#D5E9F1;border-color:#D5E9F1;color:#fff;cursor:not-allowed}
.kp-btn.ghost{background:var(--paper);color:var(--sky-text);border-color:var(--line)}
.kp-btn.ghost:hover{background:var(--sky-mist);border-color:var(--sky)}
.kp-btn.pink{background:var(--paper);color:var(--pink);border-color:var(--pink)}
.kp-btn.pink:hover{background:#FFF3F7}
.kp-btn.small{min-height:42px;padding:6px 18px;font-size:13.5px;letter-spacing:.08em}
.kp-btn.block{width:100%}
.kp-btn.start{min-width:min(100%,420px);min-height:84px;font-family:var(--en);font-size:30px;font-weight:400;letter-spacing:.06em}
.kp-head.staff .kp-btn.ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.55)}
.kp-head.staff .kp-btn.ghost:hover{background:rgba(255,255,255,.1)}
.kp-head.staff .kp-btn:not(.ghost){background:#fff;color:var(--staff);border-color:#fff}
/* 戻る｜次へ（左右一体のピル） */
.kp-nav{display:flex;justify-content:flex-end;margin-top:8px}
.kp-nav-pill{display:grid;grid-template-columns:1fr 1fr;width:min(100%,560px);border:1px solid #C9C9C9;border-radius:999px;overflow:hidden;background:var(--paper)}
.kp-nav-pill>*{display:flex;align-items:center;justify-content:center;gap:14px;min-height:72px;font:inherit;font-size:20px;letter-spacing:.1em;color:var(--sky-text);background:transparent;border:0;cursor:pointer;text-decoration:none}
.kp-nav-pill>*+*{border-left:1px solid #C9C9C9}
.kp-nav-pill>*:hover{background:var(--sky-mist)}
.kp-nav-pill .tri-l::before{content:'';border:7px solid transparent;border-right:11px solid currentColor;border-left:0}
.kp-nav-pill .tri-r::after{content:'';border:7px solid transparent;border-left:11px solid currentColor;border-right:0}
.kp-nav-pill [disabled],.kp-nav-pill [aria-disabled=true]{color:#C4C4C4;cursor:not-allowed;background:transparent}
/* フォーム */
.kp-field{display:block;margin-top:18px;font-weight:500;font-size:15px;letter-spacing:.08em}
.kp-field small{font-weight:400;color:var(--muted);margin-left:6px}
.kp-input,input[type=text].kp-input,input[type=tel].kp-input,input[type=password].kp-input,input[type=date].kp-input,select.kp-input,textarea.kp-input{width:100%;margin-top:8px;padding:14px 16px;min-height:56px;font:inherit;font-size:17px;border:1px solid var(--line);border-radius:0;background:#fff;color:var(--ink)}
textarea.kp-input{min-height:100px;line-height:1.7;resize:vertical}
.kp-input:focus{outline:2px solid var(--sky-soft);border-color:var(--sky)}
/* 選択肢（白い枠・灰色の丸、選ぶと淡い水色） */
.kp-opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 28px;margin-top:8px}
.kp-opts.cols4{grid-template-columns:repeat(4,minmax(0,1fr))}
.kp-opts.cols3{grid-template-columns:repeat(3,minmax(0,1fr))}
.kp-opts.one{grid-template-columns:1fr}
.kp-opt,.kp-radio{position:relative;display:flex;align-items:center;gap:18px;min-height:84px;padding:18px 22px 18px 66px;border:1px solid var(--line);background:var(--paper);cursor:pointer;font-size:18px;line-height:1.6;letter-spacing:.06em;-webkit-tap-highlight-color:transparent;user-select:none;transition:background .12s,border-color .12s}
.kp-opt input,.kp-radio input{position:absolute;opacity:0;width:1px;height:1px;left:0;top:0}
.kp-opt::before,.kp-radio::before{content:'';position:absolute;left:24px;top:50%;width:26px;height:26px;margin-top:-13px;border-radius:50%;background:var(--radio)}
.kp-opt.check::before{border-radius:6px}
.kp-opt::after,.kp-radio::after{content:'';position:absolute;left:31px;top:50%;width:12px;height:12px;margin-top:-6px;border-radius:50%;background:var(--sky);opacity:0;box-shadow:0 0 0 4px #BFE6F5}
.kp-opt.check::after{left:31px;width:7px;height:13px;margin-top:-9px;border-radius:0;background:transparent;border:solid var(--sky-strong);border-width:0 3px 3px 0;transform:rotate(45deg);box-shadow:none}
.kp-opt.is-on,.kp-radio:has(input:checked){background:var(--sky-soft);border-color:#BFE3F2}
.kp-opt.is-on::after,.kp-radio:has(input:checked)::after{opacity:1}
.kp-opt.is-on.check::before{background:#CFEAF6}
.kp-opt.is-off{opacity:.4}
.kp-opt.none{color:var(--ink-2)}
.kp-opt:has(input:focus-visible),.kp-radio:has(input:focus-visible){outline:2px solid var(--sky)}
.kp-opt.has-img{flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;padding:24px 18px 26px;gap:14px}
.kp-opt.has-img::before{top:30px;margin-top:0}
.kp-opt.has-img::after{top:37px;margin-top:0}
.kp-opt.has-img.check::after{top:33px}
.kp-opt-img{width:150px;height:186px;object-fit:contain}
.kp-free{grid-column:1/-1;margin-top:-8px}
.kp-free input{width:100%;padding:12px 16px;min-height:56px;font:inherit;font-size:17px;border:1px solid var(--line);background:var(--sky-mist)}
.kp-radios{display:grid;gap:16px 20px;margin-top:10px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.kp-radio{min-height:68px;font-size:17px}
.kp-check{display:flex;align-items:flex-start;gap:12px;padding:14px 18px;border:1px solid var(--line);margin-top:10px;cursor:pointer;background:#fff;font-size:15px}
.kp-check input{width:22px;height:22px;accent-color:var(--sky-strong);margin:3px 0 0;flex:none}
.kp-check:has(input:checked){background:var(--sky-soft);border-color:#BFE3F2}
.kp-check.small{font-size:13.5px;padding:8px 10px}
/* 設問 */
.kp-q{display:flex;align-items:center;gap:30px;margin:6px 0 10px}
.kp-qmark{flex:none;width:76px;height:84px;color:var(--sky)}
.kp-qtitle{font-size:30px;font-weight:400;letter-spacing:.08em;line-height:1.55}
.kp-qmeta{font-size:13px;letter-spacing:.16em;color:var(--sky-text);margin-bottom:2px}
.kp-qhint{font-size:15px;color:var(--ink-2);margin:4px 0 26px 106px}
.kp-qhelp{font-size:14px;color:var(--muted);margin:-14px 0 24px 106px}
.kp-sub{margin-top:36px;padding-top:30px;border-top:1px solid var(--line)}
.kp-sub h3{font-size:22px;letter-spacing:.08em;margin-bottom:20px}
/* 入口（START）のヒーロー：上部に淡い水色の波、左に英字の大見出し、右に説明 */
.kp-hero{position:relative;display:grid;grid-template-columns:auto 1fr;gap:0;align-items:center;margin:-40px -24px 36px;padding:150px 48px 56px;background:
  radial-gradient(120% 60% at 10% -10%,rgba(134,205,232,.55),transparent 60%),
  radial-gradient(90% 50% at 85% -15%,rgba(170,222,240,.6),transparent 62%),
  linear-gradient(176deg,#CDEBF6 0%,#E4F4FA 18%,#FFFFFF 34%)}
.kp-hero::before{content:'';position:absolute;left:0;right:0;top:46px;height:80px;background:linear-gradient(172deg,transparent 30%,rgba(255,255,255,.55) 31%,rgba(255,255,255,.55) 52%,transparent 53%),linear-gradient(186deg,transparent 40%,rgba(134,205,232,.25) 41%,transparent 70%);pointer-events:none}
.kp-hero-title{display:flex;flex-direction:column;font-family:var(--en);font-weight:300;font-size:76px;line-height:1.08;letter-spacing:.01em;color:var(--ink);padding-right:48px;border-right:1px solid var(--line)}
.kp-hero-title .sky{color:var(--sky)}
.kp-hero-title small{font-family:'Noto Sans JP',sans-serif;font-size:17px;letter-spacing:.16em;color:var(--ink-2);margin-top:22px}
.kp-hero-text{padding-left:52px;font-size:17px;line-height:2.4;letter-spacing:.06em}
.kp-hero-sm{grid-template-columns:1fr;justify-items:center;padding:120px 24px 40px}
.kp-hero-sm .kp-hero-title{border-right:0;padding-right:0;font-size:56px;text-align:center;align-items:center}
@media(max-width:760px){
  .kp-hero{grid-template-columns:1fr;margin:-28px -16px 28px;padding:110px 20px 36px}
  .kp-hero-title{font-size:52px;border-right:0;padding-right:0;border-bottom:1px solid var(--line);padding-bottom:22px}
  .kp-hero-text{padding:22px 0 0;line-height:2}
}
/* お知らせ */
.kp-error{background:var(--danger-soft);border:1px solid #F2B8B8;color:var(--danger);padding:12px 16px;font-size:15px;margin-top:14px}
.kp-notice{background:var(--warn-soft);border:1px solid #F0DCA4;color:var(--warn);padding:12px 16px;font-size:14px;margin-top:14px}
.kp-alert{margin:18px 0 0;padding:12px 16px;font-size:14.5px;line-height:1.7;border-left:4px solid}
.kp-alert.refer{background:var(--danger-soft);border-color:var(--danger);color:var(--danger-deep)}
.kp-alert.consult{background:var(--warn-soft);border-color:#E3B54A;color:var(--warn)}
.kp-ok{background:var(--sky-soft);border:1px solid #BFE3F2;color:#1F6E96;padding:12px 16px;font-size:15px;margin-top:14px}
/* 結果のタブ */
.kp-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin:6px 0 42px}
.kp-tabs a{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:4px;min-height:96px;padding:12px;font-size:19px;letter-spacing:.12em;color:var(--sky);text-decoration:none;background:linear-gradient(180deg,#F4FAFD 0%,#fff 100%);border-bottom:6px solid var(--sky)}
.kp-tabs a::before{content:'';width:14px;height:14px;border:solid var(--sky);border-width:0 1.5px 1.5px 0;transform:rotate(45deg);margin-bottom:8px}
.kp-tabs a.on{background:var(--sky);color:#fff;justify-content:center;border-bottom-color:var(--sky)}
.kp-tabs a.on::before{display:none}
.kp-tabs a.on::after{content:'';position:absolute;left:50%;bottom:-18px;margin-left:-11px;border:11px solid transparent;border-top:10px solid var(--sky);border-bottom:0}
/* 二重の水色リング（優先度・点数のバッジ） */
.kp-ring{width:150px;height:150px;border-radius:50%;border:2px solid var(--sky);box-shadow:0 0 0 5px #fff,0 0 0 7px var(--sky);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--sky);margin:8px auto;line-height:1.2}
.kp-ring small{font-size:15px;letter-spacing:.1em}
.kp-ring b{font-family:var(--en);font-weight:300;font-size:46px}
/* スタッフ画面：情報密度を上げる */
.kp-staff{font-size:14px}
.kp-staff .kp-card{padding:18px 22px}
.kp-staff .kp-h2{font-size:15px;margin:22px 0 10px}
.kp-staff .kp-radio{min-height:52px;font-size:14px;padding-left:56px}
.kp-staff .kp-radio::before{left:18px}
.kp-staff .kp-radio::after{left:25px}
.kp-table{width:100%;border-collapse:collapse;font-size:13.5px}
.kp-table th,.kp-table td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line-soft);vertical-align:top}
.kp-table th{font-size:12px;font-weight:500;letter-spacing:.06em;color:var(--ink-2);white-space:nowrap;background:var(--sky-mist)}
.kp-table .num{text-align:right;font-variant-numeric:tabular-nums}
.kp-table.compact td,.kp-table.compact th{white-space:nowrap;padding:6px 8px}
.kp-flag{display:flex;gap:10px;align-items:flex-start;padding:10px 14px;margin-top:8px;font-size:14px}
.kp-flag b{white-space:nowrap}
.kp-flag.refer{background:var(--danger-deep);color:#fff}
.kp-flag.warn{background:var(--danger-soft);color:var(--danger);border:1px solid #F2B8B8}
.kp-flag.info{background:var(--info-soft);color:var(--info);border:1px solid #C8E0EE}
.kp-band{background:var(--danger-deep);color:#fff;padding:12px 18px;font-weight:500;font-size:15px;margin-bottom:14px}
.kp-chip{display:inline-block;border-radius:999px;padding:2px 10px;font-size:12px;font-weight:500;background:#EFEFEF;color:var(--ink);letter-spacing:.04em;white-space:nowrap}
.kp-chip.ok{background:var(--sky-soft);color:#1F6E96}.kp-chip.warn{background:var(--danger-soft);color:var(--danger)}.kp-chip.refer{background:var(--danger-deep);color:#fff}.kp-chip.check{background:var(--warn-soft);color:var(--warn)}
.kp-kv{display:grid;grid-template-columns:140px 1fr;gap:6px 14px;font-size:14px}
.kp-kv dt{color:var(--muted)}.kp-kv dd{margin:0}
.kp-grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
details.kp-fold{margin-top:16px}
details.kp-fold summary{cursor:pointer;font-weight:500;padding:10px 0;color:var(--sky-text)}
.kp-hidden-btn{position:fixed;right:0;bottom:0;width:72px;height:72px;opacity:0;z-index:40;-webkit-touch-callout:none;user-select:none;touch-action:manipulation;border:0;background:transparent}
.kp-foot{margin-top:56px;padding-top:18px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted);display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap}
.print-only{display:none}
@media(max-width:900px){
  .kp-opts.cols4{grid-template-columns:repeat(2,minmax(0,1fr))}
  .kp-opts.cols3{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:760px){
  .kp-main{padding:28px 16px 64px}
  .kp-head-in{padding:14px 16px}
  .kp-brand .en{font-size:24px}
  .kp-card,.kp-panel-b{padding:22px 18px}
  .kp-panel>h2,.kp-panel-h{padding:14px 18px;font-size:17px}
  .kp-opts,.kp-opts.cols4,.kp-opts.cols3{grid-template-columns:1fr;gap:14px}
  .kp-opt{min-height:72px;font-size:17px}
  .kp-opt-img{width:120px;height:150px}
  .kp-q{gap:16px}.kp-qmark{width:52px;height:58px}
  .kp-qtitle{font-size:23px}
  .kp-qhint,.kp-qhelp{margin-left:0}
  .kp-nav-pill>*{min-height:62px;font-size:17px}
  .kp-tabs{gap:10px}.kp-tabs a{font-size:14px;min-height:78px;letter-spacing:.04em}
  .kp-h1{font-size:23px;padding-left:20px}.kp-h1::before{width:6px}
  .kp-grid2{grid-template-columns:1fr}
  .kp-kv{grid-template-columns:110px 1fr}
}
@media print{
  @page{size:A4 portrait;margin:12mm}
  body{font-size:11.5px}
  .kp-head,.kp-nav,.kp-tabs,.no-print,.kp-hidden-btn{display:none!important}
  .kp-main{max-width:none;padding:0}
  .kp-panel,.kp-card{break-inside:avoid}
  .kp-panel-b{padding:14px 16px}
  .kp-panel>h2,.kp-panel-h{padding:8px 14px;font-size:14px}
  .kp-h1{font-size:18px;margin:0 0 10px}
  .print-only{display:block}
  .page-break{break-before:page}
  a{text-decoration:none;color:inherit}
}
</style>
</head>
<body>
<header class:list={['kp-head', mode]}>
  <div class="kp-head-in">
    <a class="kp-brand" href={mode === 'staff' ? '/kampo/staff/' : '/kampo/check/new/'}>
      <span class="en">BODY CHECK <b>{mode === 'staff' ? 'STAFF' : 'KAMPO'}</b></span>
      <span class="ja">{mode === 'staff' ? `${shop} ／ スタッフ画面` : `体質チェック ／ 漢方 ｜ ${shop}`}</span>
    </a>
    {progress && (
      <div class="kp-progress" aria-label={`回答 ${pct}%`}>
        {Array.from({ length: dots }, (_, i) => <i class:list={[{ on: i < filled }]}></i>)}
        <b>{pct}%</b>
      </div>
    )}
    <div class="kp-head-actions"><slot name="actions" /></div>
  </div>
</header>
<main class:list={['kp-main', width, { 'kp-staff': mode === 'staff' }]}>
  <slot />
</main>
</body>
</html>
