---
// 真凜会（/karma/shinrinkai/）のサブページ用レイアウト。配色・書体・ヘッダー・フッターはトップ（index.astro）に揃える。
// すべて noindex。sitemap・他ページからはリンクしない。
import SiteGuard from '../components/SiteGuard.astro';
interface Props { title: string; path: string; description?: string }
const { title, path, description = '真凜会 会員限定書庫。' } = Astro.props;
const canonical = `https://kabuexlabs.com${path}`;
const fullTitle = `${title}｜真凜会 SHINRINKAI`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex, nofollow">
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#121212">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap" rel="stylesheet">
<SiteGuard />
</head>
<body>
<header class="hdr">
  <a class="logo" href="/karma/shinrinkai/" aria-label="真凜会 SHINRINKAI トップへ">
    <span class="logo-ja">真凜会</span>
    <span class="logo-en">SHINRINKAI</span>
  </a>
  <nav class="nav" aria-label="メニュー">
    <a href="/karma/shinrinkai/#teachings">真凜会の教え</a>
    <a href="/karma/shinrinkai/#activities">活動のご案内</a>
    <a href="/karma/shinrinkai/#archive" class="is-current">会員限定書庫</a>
  </nav>
</header>
<main class="sub">
  <slot />
  <p class="back"><a href="/karma/shinrinkai/#archive">← 会員限定書庫へもどる</a></p>
</main>
<footer class="ftr">
  <div class="ftr-row">
    <p class="ftr-logo">真凜会<span>SHINRINKAI</span></p>
    <p class="ftr-copy">© 取調室カルマ</p>
  </div>
  <p class="ftr-note">『取調室カルマ』グッズ購入特典サイト<br>本サイトの教団・活動案内は作品世界の設定です。<br>特典コンテンツの転載・再配布はご遠慮ください。</p>
</footer>
<style is:global>
:root{--bg:#121212;--bg2:#1b1b1b;--ink:#ece6dc;--dim:#a8a19a;--mute:#7c7670;--red:#b23a30;--red-soft:#c9705f;--pink:#c98d80;--rule:rgba(236,230,220,.14)}
html{overflow-x:clip}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Shippori Mincho','Hiragino Mincho ProN','Yu Mincho',serif;font-weight:400;line-height:2;letter-spacing:.06em;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
p,h1,h2,h3,ul,ol{margin:0}
h1,h2,h3{font-weight:400}
:where(a,button,input):focus-visible{outline:1px solid var(--red-soft);outline-offset:4px}
.hdr{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px clamp(24px,6vw,64px) 18px;border-bottom:1px solid var(--rule)}
.logo{display:flex;flex-direction:column;align-items:center;gap:2px;flex:none}
.logo-ja{font-size:clamp(26px,6.4vw,34px);font-weight:500;letter-spacing:.62em;margin-right:-.62em;line-height:1.3}
.logo-en{font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:.32em;margin-right:-.32em;font-weight:500}
.nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px 18px;font-size:14px;letter-spacing:.14em}
.nav a{padding:4px 0 6px;transition:color .2s}
.nav a:hover{color:var(--pink)}
.nav a.is-current{border-bottom:2px solid #c3332b;padding-bottom:5px}
.sub{max-width:772px;margin:0 auto;padding:clamp(72px,14vw,120px) clamp(24px,6vw,64px) clamp(64px,12vw,96px);box-sizing:content-box}
.eyebrow{font-family:'Cormorant Garamond',serif;font-size:clamp(15px,3.8vw,17px);letter-spacing:.3em;color:var(--red-soft);font-weight:500;margin-bottom:20px}
.page-h1{font-size:clamp(28px,7vw,40px);line-height:1.7;letter-spacing:.14em;color:#f3eee6;margin-bottom:clamp(28px,6vw,40px)}
.lead{font-size:clamp(15px,3.9vw,17px);line-height:2.3;color:var(--dim);margin-bottom:clamp(40px,9vw,56px)}
.btn-red{display:inline-block;border:1px solid var(--red-soft);padding:14px clamp(26px,7vw,40px);font:inherit;font-size:clamp(15px,3.9vw,17px);letter-spacing:.2em;color:inherit;background:#2c1d1b;cursor:pointer;transition:background .2s,color .2s}
.btn-red:hover{background:rgba(178,58,48,.35);color:#fff}
.btn-red:disabled{opacity:.5;cursor:wait}
.pending-box{border:1px solid rgba(236,230,220,.18);padding:clamp(32px,7vw,44px) clamp(24px,6vw,36px);color:var(--dim);line-height:2.2}
/* パスワード */
.gate{border:1px solid rgba(236,230,220,.18);padding:clamp(32px,7vw,44px) clamp(24px,6vw,36px);display:flex;flex-direction:column;gap:18px}
.gate-label{font-size:15px;letter-spacing:.12em}
.gate-input{font:inherit;font-size:17px;letter-spacing:.1em;color:var(--ink);background:#0d0d0d;border:1px solid rgba(236,230,220,.3);padding:12px 14px;border-radius:0;width:100%;box-sizing:border-box}
.gate-input:focus{border-color:var(--red-soft);outline:none}
.gate-err{color:#e07a6c;font-size:14px}
.gate-note{font-size:13px;color:var(--mute);line-height:2}
.back{margin-top:clamp(64px,12vw,96px);font-size:15px;letter-spacing:.1em}
.back a{border-bottom:1px solid var(--rule);padding-bottom:4px}
.back a:hover{color:var(--pink)}
.ftr{border-top:1px solid var(--rule);padding:clamp(40px,9vw,56px) clamp(24px,6vw,64px) 72px}
.ftr-row{display:flex;justify-content:space-between;align-items:center;gap:20px}
.ftr-logo{font-size:clamp(26px,6.4vw,32px);font-weight:500;letter-spacing:.62em;display:flex;flex-direction:column;align-items:center;gap:6px;line-height:1.3}
.ftr-logo span{font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:.32em;font-weight:500}
.ftr-copy{font-size:clamp(13px,3.3vw,15px);letter-spacing:.06em;color:var(--dim)}
.ftr-note{margin-top:clamp(40px,9vw,56px);font-size:clamp(13px,3.3vw,15px);line-height:2.1;letter-spacing:.04em;color:var(--dim)}
[hidden]{display:none !important}
@media (max-width:420px){.nav{font-size:13px;letter-spacing:.1em;gap:6px 14px}}
@media (min-width:760px){.nav{flex-wrap:nowrap;gap:32px}}
</style>
</body>
</html>
