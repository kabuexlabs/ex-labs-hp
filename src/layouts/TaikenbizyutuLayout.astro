---
import SiteGuard from '../components/SiteGuard.astro';
// 体験する美術館 (/taikenbizyutu/) 専用レイアウト。
// 本体サイトとは別ブランドのマイクロサイトなので BaseLayout は使わず、
// フォント・配色・ヘッダー/フッターをここで完結させる。
// サブドメイン taikenbizyutu.kabuexlabs.com は vercel.json のリダイレクトで
// /taikenbizyutu/ 配下へ転送される (toudaimurder と同じ方式)。
import { jsonLd } from '../lib/microcms';
import { TB_BASE, TB_X_URL } from '../data/taikenbizyutu';

export interface Props {
  title?: string;
  description?: string;
  /** OGP 画像 (public/ 配下のパス)。設定すると twitter card も large になる */
  ogImage?: string;
  /** ヘッダー/フッターを持たない全幅ページ (ロスト・フレームLP) 用 */
  bare?: boolean;
  /** トップページ用。ヒーローに大きなロゴを置くので、固定ヘッダーの小ロゴを出さない */
  hero?: boolean;
}

// NOTE: 検索エンジン向けの SEO レイヤー（title / description / sr-only 見出し /
// 構造化データ / alt）には「イマーシブ・周遊型・街歩き謎解き」等の検索ワードを
// 載せ、画面に見える本文は参加型アートの文脈で統一する——という二層構成。
// これで検索流入を確保しつつ、来訪者・審査で目に入る本文は芸術文脈を保つ。
const {
  title = '体験する美術館｜参加型アート・周遊型アートイマーシブ｜絵画×物語×街歩き謎解き',
  description =
    '「体験する美術館」は、下北沢など実在の街を舞台に、絵画と物語、街歩き型の謎解きを織り込んだ参加型アート／周遊型アートイマーシブのレーベルです。鑑賞するアートから体験するアートへ——第二弾『ロスト・フレーム』は全公演完売御礼。',
  ogImage = '/assets/taikenbizyutu/ogp.jpg',
  bare = false,
  hero = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://kabuexlabs.com');
// Canonical always uses the trailing-slash form: SSR routes answer
// both /path and /path/, and a request-echoing canonical would split
// the page into two competing URLs in Google's eyes.
const canonical = new URL(Astro.url.pathname.replace(/([^/])$/, '$1/'), site);
const ogImageAbs = new URL(ogImage, site);

const base = TB_BASE;
const nav = [
  { href: `${base}/lostframe/`, label: 'WORKS' },
  { href: `${base}/#news`, label: 'NEWS' },
  { href: `${base}/#about`, label: 'ABOUT' },
  { href: `${base}/#model`, label: 'MODEL' },
  { href: `${base}/#creators`, label: 'CREATORS' },
  { href: `${base}/#art`, label: 'ART' },
  { href: `${base}/#faq`, label: 'FAQ' },
  { href: `${base}/#contact`, label: 'CONTACT' },
];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '体験する美術館',
  url: new URL(`${base}/`, site).toString(),
  logo: new URL('/assets/taikenbizyutu/logo-white.webp', site).toString(),
  sameAs: [TB_X_URL],
  keywords:
    '参加型アート, 周遊型アートイマーシブ, イマーシブ, 街歩き 謎解き, 体験型アート, 下北沢 アートイベント, 絵画 展示',
  description:
    '絵画と物語、観客の参加を編み込んだ参加型アート／周遊型アートイマーシブのレーベル。閉館後の美術館や街そのものを会場に、街歩き型の謎解きと絵画鑑賞を融合した体験を届けています。',
  parentOrganization: {
    '@type': 'Organization',
    name: '株式会社ex Labs',
    url: 'https://kabuexlabs.com/',
  },
};
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImageAbs}>
<meta property="og:site_name" content="体験する美術館">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
<script type="application/ld+json" set:html={jsonLd(orgLd)} />
<noscript><style>.rv{opacity:1 !important;transform:none !important}.hero-el{opacity:1 !important;transform:none !important;animation:none !important}</style></noscript>
<slot name="head" />
<SiteGuard />
</head>
<body>
<div class="page">
{!bare && (
<header class="hdr">
  {!hero && (
    <a class="hbrand" href={`${base}/`} aria-label="体験する美術館 トップページ"><img src="/assets/taikenbizyutu/logo-white.webp" alt="体験する美術館" width="99" height="48"></a>
  )}
  <button class="menub" id="menuBtn" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
</header>
)}
{!bare && (
<nav class="mnav" id="mnav" aria-label="メニュー">
  <div class="mnav-in">
    {nav.map((item) => <a class="mitem" href={item.href}><span class="mitem-en">{item.label}</span></a>)}
    <a class="mitem gold" href={TB_X_URL} target="_blank" rel="noopener"><span class="mitem-en">OFFICIAL X ↗</span></a>
  </div>
</nav>
)}
<slot />
{!bare && (
<footer class="ftr">
  <div class="wrapc fx col ac gap16">
    <img class="flogo" src="/assets/taikenbizyutu/logo-white.webp" alt="体験する美術館" width="62" height="30" loading="lazy">
    <p class="fsmall m0">企画・運営：<a href="https://kabuexlabs.com/">株式会社 ex Labs</a></p>
    <p class="fsmall m0">イマーシブイベントの制作依頼：<a href="https://kabuexlabs.com/services/immersive/">イマーシブ制作のex Labs</a></p>
    <p class="fsmall m0">解説記事：<a href="https://kabuexlabs.com/guide/immersive/">イマーシブとは</a>／<a href="https://kabuexlabs.com/guide/botsunyukan/">没入感とは</a>／<a href="https://kabuexlabs.com/guide/immersive-theater/">イマーシブシアターとは</a>／<a href="https://kabuexlabs.com/guide/taikengata-event/">体験型イベントとは</a>／<a href="https://kabuexlabs.com/guide/shuyu-event/">周遊型イベントとは</a></p>
    <p class="fsmall m0">© 2026 ex Labs Inc. All Rights Reserved.</p>
    <p class="fsmall m0">本サイトに掲載の文章・画像等の無断転載・複製を禁じます。</p>
  </div>
</footer>
)}
</div>

<style is:global>
/* ---- palette (体験する美術館の独自配色：生成り・青墨・松葉・弁柄・砂・真鍮) ---- */
:root{
  --ink:#1e2224;    /* 青墨 */
  --sky:#a9bfcb;    /* ロスト・フレームの空色 (ヒーロー下帯) */
  --moss:#24413a;   /* 松葉 */
  --rust:#7d3a2c;   /* 弁柄 */
  --paper:#efe8da;  /* 生成り */
  --sand:#cdbfa6;   /* 砂 */
  --mat:#efe8da;    /* 額装マット (暗い面では生成り) */
  --brass:#d4b878;  /* 真鍮 */
  --fg:#ece7df; --fg2:#b3ada3; --accent:#d4b878; --line:rgba(236,231,223,.14); --onaccent:#1e2224;
}
html{scroll-behavior:smooth;scroll-padding-top:24px;overflow-x:clip}
:where(a,button,input,textarea,select,summary):focus-visible{outline:2px solid var(--brass);outline-offset:3px}
body{margin:0;background:var(--ink)}
a{color:var(--accent);text-decoration:none}
a:hover{opacity:.75}
.page{background:var(--ink);color:var(--fg);font-family:'Shippori Mincho',serif;-webkit-font-smoothing:antialiased;line-height:1.9;min-height:100vh}
.en{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400}
.gold{color:var(--accent)}
.muted{color:var(--fg2)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.fx{display:flex}.col{display:flex;flex-direction:column}.ac{align-items:center}.jc{justify-content:center}.jb{justify-content:space-between}
.wrap{flex-wrap:wrap}.tc{text-align:center}.nowrap{white-space:nowrap}
/* 句読点の位置でだけ折り返したい語句に付ける */
.nobr{display:inline-block;white-space:nowrap}
.gap12{gap:12px}.gap16{gap:16px}.gap24{gap:24px}.m0{margin:0}.posrel{position:relative}
.wrapc{max-width:1120px;margin:0 auto;padding:0 36px}
/* 色面セクション。--fg 等を切り替えるだけで内側のクラスが追従する */
.sec{padding:120px 0;color:var(--fg);position:relative}
.bg-ink{background:var(--ink);--fg:#ece7df;--fg2:#b3ada3;--accent:#d4b878;--line:rgba(236,231,223,.14);--onaccent:#1e2224;--mat:#efe8da}
.bg-moss{background:var(--moss);--fg:#ece9de;--fg2:#b9c4bb;--accent:#d4b878;--line:rgba(236,233,222,.18);--onaccent:#24413a;--mat:#efe8da}
.bg-rust{background:var(--rust);--fg:#f3e9dc;--fg2:#dcc8b8;--accent:#e8c98a;--line:rgba(243,233,220,.2);--onaccent:#7d3a2c;--mat:#efe8da}
.bg-paper{background:var(--paper);--fg:#24262a;--fg2:#6b665c;--accent:#7d3a2c;--line:rgba(36,38,42,.16);--onaccent:#fff;--mat:#d9cfbb}
.bg-sand{background:var(--sand);--fg:#2b2926;--fg2:#5c554b;--accent:#7d3a2c;--line:rgba(43,41,38,.22);--onaccent:#fff;--mat:#efe8da}
.hairtop{border-top:1px solid var(--line)}
.kicker{font-size:12px;letter-spacing:.3em;color:var(--accent);text-transform:uppercase;font-family:'Cormorant Garamond',serif;font-weight:500}
.h2{font-size:30px;font-weight:400;letter-spacing:.16em;margin:14px 0 0;line-height:1.6;color:var(--fg)}
/* 大判の英字見出し (OWNER'S COLLECTION 風) */
.disp{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(48px,12.5vw,190px);line-height:.92;letter-spacing:-.01em;color:var(--accent);text-transform:uppercase;margin:0;text-wrap:balance}
.lead{font-size:16px;letter-spacing:.08em;line-height:2.2}
/* 3行を少しずつずらして組む見出し */
.stag{font-size:clamp(22px,4.6vw,56px);font-weight:400;letter-spacing:.06em;line-height:1.45;color:var(--accent);margin:0}
.stag span{display:block}
.stag span:nth-child(2){padding-left:1.2em}
.stag span:nth-child(3){padding-left:2.6em}
/* 額装マット */
.mat{background:var(--mat);padding:10%;display:block}
.mat img{display:block;width:100%;height:auto}
.mcap{font-size:13.5px;letter-spacing:.16em;line-height:2.1;text-align:center;margin:20px 0 0;color:var(--fg)}
.mcap small{display:block;font-size:12px;color:var(--fg2);letter-spacing:.12em}
/* コラージュ配置：2列で交互に段差、PCは3列 */
.collage{display:grid;grid-template-columns:repeat(2,1fr);gap:40px 22px;align-items:start}
.collage>:nth-child(even){margin-top:96px}
@media (min-width:900px){
  .collage{grid-template-columns:repeat(3,1fr);gap:64px 40px}
  .collage>:nth-child(even){margin-top:0}
  .collage>:nth-child(3n+2){margin-top:120px}
}
/* 円形のリンク (MORE) */
.circ{display:inline-flex;align-items:center;justify-content:center;width:168px;height:168px;border:1px solid currentColor;border-radius:50%;font-family:'Cormorant Garamond',serif;font-size:20px;letter-spacing:.14em;color:var(--fg);transition:background .3s,color .3s}
.circ:hover{background:var(--fg);color:var(--moss);opacity:1}
/* 固定ヘッダー：小ロゴ + 丸いメニューボタン */
.hdr{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:18px 20px;pointer-events:none}
.hdr>*{pointer-events:auto}
.hbrand{display:block;background:rgba(30,34,36,.88);padding:9px 14px;border-radius:999px}
.hbrand img{height:22px;width:auto;display:block}
.menub{margin-left:auto;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:7px;width:56px;height:56px;border-radius:50%;background:rgba(30,34,36,.92);border:1px solid rgba(255,255,255,.08);cursor:pointer;padding:0;box-shadow:0 4px 18px rgba(0,0,0,.25)}
.menub span{display:block;width:22px;height:1px;background:#fff;transition:transform .3s,opacity .3s}
.menub.x span:nth-child(1){transform:translateY(4px) rotate(45deg)}
.menub.x span:nth-child(2){transform:translateY(-4px) rotate(-45deg)}
.mnav{position:fixed;inset:0;z-index:49;background:rgba(30,34,36,.97);display:none;padding:96px 24px 48px;overflow-y:auto}
.mnav.open{display:block}
.mnav-in{max-width:520px;margin:0 auto;display:flex;flex-direction:column}
body.noscroll{overflow:hidden}
.mitem{display:block;color:#ece7df;padding:16px 0;border-bottom:1px solid rgba(236,231,223,.1)}
.mitem-en{font-family:'Cormorant Garamond',serif;font-size:34px;letter-spacing:.08em;line-height:1.1}
.mitem.gold{color:var(--brass)}
.badge{display:inline-block;border:1px solid var(--accent);color:var(--accent);font-size:11px;letter-spacing:.3em;padding:5px 14px}
.sold{display:inline-block;border:1px solid #b56a62;color:#d08a80;font-size:11px;letter-spacing:.3em;padding:5px 14px}
.poster{width:100%;height:auto;display:block}
.pshadow{box-shadow:0 12px 36px rgba(0,0,0,.35)}
.note{font-size:12.5px;color:var(--fg2);letter-spacing:.04em}
.bigx{display:inline-block;border:1px solid var(--accent);color:var(--accent);font-size:13px;letter-spacing:.3em;padding:16px 42px}
.bigx:hover{background:var(--accent);color:var(--onaccent);opacity:1}
.card3{border-top:1px solid var(--line);padding-top:26px}
.h3{font-size:19px;font-weight:500;letter-spacing:.1em;margin:16px 0 10px;line-height:1.7;color:var(--fg)}
.body14{font-size:14px;color:var(--fg2);letter-spacing:.04em}
.ctitle{font-size:15px;letter-spacing:.2em;color:var(--fg)}
.cdesc{font-size:13px;color:var(--fg2);letter-spacing:.05em}
.ftr{background:var(--ink);border-top:1px solid rgba(236,231,223,.1);padding:64px 0 56px;color:#ece7df}
.flogo{height:30px;width:auto;opacity:.9}
.fsmall{font-size:12px;color:#8f887e;letter-spacing:.1em}
.ftr a{color:var(--brass)}
/* スクロール連動フェードイン */
.rv{opacity:0;transform:translateY(12px);transition:opacity .6s ease,transform .6s ease}
.rv.on{opacity:1;transform:none}
.d1{transition-delay:.06s}.d2{transition-delay:.12s}.d3{transition-delay:.18s}.d4{transition-delay:.24s}
@media (max-width:900px){
  .sec{padding:80px 0}
  .wrapc{padding:0 22px}
  .h2{font-size:24px;letter-spacing:.12em}
  .lead{font-size:15px}
  .bigx{padding:14px 30px;letter-spacing:.22em;font-size:12.5px}
  .circ{width:132px;height:132px;font-size:17px}
  .stag{letter-spacing:.02em}
  .stag span:nth-child(2){padding-left:.5em}
  .stag span:nth-child(3){padding-left:.9em}
  .mitem-en{font-size:28px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv{opacity:1;transform:none;transition:none}
  .hero-el{opacity:1 !important;transform:none !important;animation:none !important}
}
</style>

<script>
// スクロール連動フェードイン (.rv → .on)。
// threshold は 0 — 縦に長い要素でも「10%見える」条件で永遠に隠れるのを防ぐ。
const io = new IntersectionObserver(
  (entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add('on');
        io.unobserve(e.target);
      }
    }
  },
  { threshold: 0, rootMargin: '0px 0px -8% 0px' },
);
document.querySelectorAll('.rv').forEach((el) => io.observe(el));

// モバイルのハンバーガーメニュー
const menuBtn = document.getElementById('menuBtn');
const mnav = document.getElementById('mnav');
if (menuBtn && mnav) {
  menuBtn.addEventListener('click', () => {
    const open = mnav.classList.toggle('open');
    menuBtn.classList.toggle('x', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    document.body.classList.toggle('noscroll', open);
  });
  mnav.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      mnav.classList.remove('open');
      menuBtn.classList.remove('x');
      menuBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('noscroll');
    }),
  );
}
</script>
</body>
</html>
