---
import SiteGuard from '../components/SiteGuard.astro';
import ContactBlock, { type ContactType } from '../components/x/ContactBlock.astro';
import Ph from '../components/x/Ph.astro';
import SiteHeader from '../components/x/SiteHeader.astro';
import SiteFooter from '../components/x/SiteFooter.astro';
import '../styles/global.css';
import '../styles/x.css';
import '../styles/xguide.css';
import '../styles/xtone.css';
import { jsonLd } from '../lib/microcms';
import { ORG_NAME, ORG_ALT_NAMES, ORG_DESCRIPTION, ORG_KNOWS_ABOUT, ORG_OFFERS } from '../data/org';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** 2026-09 リニューアルのデザイン（青地）で組むページ。本文は各ページ、Contact とフッターはここで描画 */
  renewal?: boolean;
  /** 開幕のカットイン（行ごとの文節配列）。同じページはセッション中1回だけ再生 */
  cutin?: string[][];
  /** フッター前の Contact（リニューアルページのみ） */
  contact?: { title?: string[]; note?: string; type?: ContactType; placeholder?: string };
  /** フッターの種類：full＝キャッチ・リンク付き（トップ・既存ページ）／short＝住所と著作権のみ（サービス・一覧） */
  footer?: 'full' | 'short';
}

const {
  title = '株式会社 ex Labs｜イマーシブ・マダミス（マーダーミステリー）・頭脳戦・施設活用イベントの企画・制作会社',
  description = '株式会社ex Labsは、イマーシブ・マダミス（マーダーミステリー）・頭脳戦・心理戦・謎解きなど体験型エンターテインメントの企画・制作・集客・運営を一貫して手掛ける制作会社。累計体験者数15,000人超、日本経済新聞掲載。東京都の夢の島熱帯植物館・京都市の京都市京セラ美術館で公演を企画・主催。日本テレビ『金曜ミステリークラブ!!!』にミステリー企画で参画。施設活用イベントは初期費用0円のレベニューシェア型にも対応。',
  // Fresh filename (not just a query) so scrapers that cached the old
  // logo thumbnail — or that ignore query strings — re-fetch the card.
  ogImage = '/assets/share-card.png',
  ogType = 'website',
  renewal = false,
  cutin,
  contact,
  footer = 'full',
} = Astro.props;
// 解説記事・ブログ記事の本文ページ（一覧 /guide/・/blog/ は除く）は記事用の新デザインのスキンを当てる
const isArticle = !renewal && /^\/(guide|blog)\/[^/]+\/?$/.test(Astro.url.pathname);
// Noto Sans JP は旧デザインの本文（会社概要・サービス一覧・公演詳細など）だけで使う。新デザインと解説記事では描画されないため読み込まない
// （和文フォントは太さごとに @font-face が百以上あり、CSS だけで約1MB。スマホの初回表示を遅らせる）。
const fontCss = `https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700${renewal || isArticle ? '' : '&family=Noto+Sans+JP:wght@400;500;700;800'}&family=Montserrat:wght@600;700;800&display=swap`;
const cutKey = 'exl_cut:' + Astro.url.pathname.replace(/[^A-Za-z0-9/_-]/g, '').slice(0, 120);

const site = Astro.site ?? new URL('https://kabuexlabs.com');
// Canonical always uses the trailing-slash form: SSR routes answer
// both /path and /path/, and a request-echoing canonical would split
// the page into two competing URLs in Google's eyes.
const canonical = new URL(Astro.url.pathname.replace(/([^/])$/, '$1/'), site);
const ogImageAbs = new URL(ogImage, site);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ORG_NAME,
  alternateName: 'ex Labs公式サイト',
  url: site.toString(),
  description:
    'イマーシブ（没入型体験）・マダミス（マーダーミステリー）・謎解きなど体験型エンターテインメントの企画・制作会社 ex Labs の公式サイト。',
  inLanguage: 'ja',
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).toString(),
  name: ORG_NAME,
  legalName: ORG_NAME,
  alternateName: ORG_ALT_NAMES,
  url: site.toString(),
  logo: new URL('/assets/logo.png', site).toString(),
  image: new URL('/assets/share-card.png', site).toString(),
  email: 'info@kabuexlabs.com',
  description: ORG_DESCRIPTION,
  slogan: 'AI時代に、人間が作る面白さを追求する',
  foundingDate: '2025-11',
  founder: { '@type': 'Person', '@id': new URL('/company/iida-yuki/#person', site).toString(), name: '飯田 雄貴', alternateName: ['飯田雄貴', '飯田ゆうき', 'いいだ ゆうき', 'Yuki Iida'], jobTitle: '代表取締役', url: new URL('/company/iida-yuki/', site).toString(), sameAs: [
      'https://x.com/JaPJaPyuki',
      'https://www.instagram.com/yukiiidaiidaiida/',
      'https://www.facebook.com/p/%E9%A3%AF%E7%94%B0%E9%9B%84%E8%B2%B4-100027623407162/',
      ] },
  address: { '@type': 'PostalAddress', streetAddress: '西新宿3-3-13 西新宿水間ビル2F', addressLocality: '新宿区', addressRegion: '東京都', postalCode: '160-0023', addressCountry: 'JP' },
  // AI検索（AIO）向けの専門領域宣言。「マーダーミステリーの制作会社は？」
  // のような質問に対し、この会社が該当領域の事業者だと判定させるための情報。
  knowsAbout: ORG_KNOWS_ABOUT,
  // 提供サービスを実体として列挙し、各サービスページに紐づける。
  makesOffer: ORG_OFFERS.map((o) => ({ n: o.name, p: o.path })).map((s) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: s.n,
      serviceType: s.n,
      url: new URL(s.p, site).toString(),
      provider: { '@type': 'Organization', name: ORG_NAME },
      areaServed: { '@type': 'Country', name: '日本' },
    },
  })),
  // Entity consolidation for AI/LLM search: link the official X account
  // and the PR TIMES company page so answer engines can verify this is
  // the same organization across sources.
  sameAs: [
    'https://x.com/kabuexlabs',
    'https://note.com/kabuexlabs',
    'https://prtimes.jp/main/html/searchrlp/company_id/185770',
  ],
  knowsLanguage: 'ja',
  areaServed: { '@type': 'Country', name: '日本' },
  address: {
    '@type': 'PostalAddress',
    postalCode: '160-0023',
    addressRegion: '東京都',
    addressLocality: '新宿区',
    streetAddress: '西新宿3-3-13 西新宿水間ビル2F',
    addressCountry: 'JP',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@kabuexlabs.com',
    contactType: 'customer support',
    areaServed: 'JP',
    availableLanguage: 'Japanese',
  },
};
---

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/rss+xml" title="株式会社ex Labs｜解説記事・ブログ" href="/rss.xml">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImageAbs}>
{ogImage.startsWith('/assets/share-card') && (
  <>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  </>
)}
<meta property="og:site_name" content={ORG_NAME}>
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<meta name="google-site-verification" content="70Rfozvga_yw5B2FeapOdwuZiC8fwS_oCnVyWKijlRE">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-ex.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{/* ヘッダーのロゴ（全ページ共通）を最優先で先読み。 */}
<link rel="preload" as="image" href="/assets/logo.png" fetchpriority="high">
{/* Webフォントは非同期読み込み（media=print→onloadでall）。display=swap で取得前もフォールバックで即表示。
    2026-10 のトンマナ改訂で、和文は Zen Kaku Gothic New、英字・数字は Montserrat に統一（src/styles/xtone.css）。Noto は旧デザインの本文用。 */}
<link rel="preload" as="style" href={fontCss}>
<link rel="stylesheet" href={fontCss} media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href={fontCss}></noscript>
<script type="application/ld+json" set:html={jsonLd(orgLd)} />
<script type="application/ld+json" set:html={jsonLd(websiteLd)} />
<SiteGuard />
</head>
<body class={renewal ? 'x-body' : isArticle ? 'x-legacy x-guide' : 'x-legacy'}>

{cutin && (
  <>
  <div class="x-cut" id="x-cut" aria-hidden="true">
    <div class="x-cut-band"></div>
    <div class="x-cut-in">
      <img class="x-cut-logo" src="/assets/exlabs-logo-w.png" alt="" width="2048" height="520">
      <span class="x-cut-line"></span>
      <div class="x-cut-txt">{cutin.map((ln, i) => <span class="x-cut-ln" style={`animation-delay:${(0.95 + i * 0.2).toFixed(2)}s`}><Ph list={ln} /></span>)}</div>
    </div>
  </div>
  <script is:inline define:vars={{ cutKey }}>
    /* カットイン（約3.3秒）。タップ・スクロール・キー操作ですぐ閉じる。予約や問い合わせの邪魔にならないよう、
       1回の訪問（セッション）で最初に開いたページだけに出す。視差効果を減らす設定の方には出さない。 */
    (function () {
      var el = document.getElementById('x-cut'); if (!el) return;
      var seen = false; try { seen = !!(sessionStorage.getItem(cutKey) || sessionStorage.getItem('exl_cut_any')); sessionStorage.setItem(cutKey, '1'); sessionStorage.setItem('exl_cut_any', '1'); } catch (e) {}
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seen || reduce || location.hash) { el.remove(); return; }
      document.documentElement.style.overflow = 'hidden';
      var done = function () { document.documentElement.style.overflow = ''; if (el.parentNode) el.remove(); };
      el.addEventListener('click', done);
      ['touchstart', 'wheel', 'keydown'].forEach(function (t) { window.addEventListener(t, done, { once: true, passive: true }); });
      setTimeout(done, 3300);
      window.addEventListener('pageshow', function (e) { if (e.persisted) done(); });
    })();
  </script>
  </>
)}

<SiteHeader ctaHref={renewal ? '#contact' : '/#contact'} />

<main class={renewal ? 'x-root' : undefined} lang="ja"><slot /></main>

<div class={`x-end${renewal && contact ? ' has-contact' : ''}`} id={renewal && contact ? 'contact' : undefined}>
  <div class="x-end-in">
    {renewal && contact && <ContactBlock {...contact} />}
    <SiteFooter footer={footer} />
  </div>
</div>

<script is:inline>
/* Safety net: hero logo/headline/marquee use entrance animations that
   start at opacity:0. On iOS Safari a bfcache "back" restore or a
   throttled load can leave those animations un-run, freezing the hero
   invisible. Force any still-hidden hero element visible after the
   animations would normally have finished, and again on bfcache show. */
(function () {
  function ensureHeroVisible() {
    document.querySelectorAll('.hero-logo,.hero-title,.hero-sub,.hero-actions,.hero-works').forEach(function (el) {
      if (parseFloat(getComputedStyle(el).opacity) < 0.99) el.style.opacity = '1';
    });
  }
  window.addEventListener('pageshow', function (e) { if (e.persisted) ensureHeroVisible(); });
  window.addEventListener('load', function () { setTimeout(ensureHeroVisible, 1800); });
})();
/* 外部サイトへのリンクに付けている「↗」が、iPhone では絵文字（色つきの四角）で表示されるため、文字として表示する指定（U+FE0E）を付ける */
(function () {
  var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, { acceptNode: function (n) { return n.nodeValue.indexOf('\u2197') >= 0 ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP; } });
  var n; while ((n = w.nextNode())) n.nodeValue = n.nodeValue.replace(/\u2197(?!\uFE0E)/g, '\u2197\uFE0E');
})();
/* 横に並ぶカード（.x-hscroll・.x-rail.is-carousel・旧デザインの .blog-strip・.works-grid）の下に「‹ 1 / 11 ›」のボタンを付け、横に送れることを分かるようにする。
   はみ出していないとき（パソコンの幅で全部見えている等）はボタンを隠す。 */
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var arrow = function (d) { return '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="' + (d < 0 ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7') + '" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>'; };
  document.querySelectorAll('.x-hscroll, .x-rail.is-carousel, .blog-strip, .works-grid').forEach(function (t) {
    var items = Array.prototype.slice.call(t.children);
    if (items.length < 2) return;
    var nav = document.createElement('div');
    nav.className = 'x-car';
    nav.innerHTML = '<button type="button" class="x-car-b" aria-label="前へ">' + arrow(-1) + '</button><span class="x-car-n"></span><button type="button" class="x-car-b" aria-label="次へ">' + arrow(1) + '</button>';
    t.insertAdjacentElement('afterend', nav);
    var prev = nav.children[0], cnt = nav.children[1], next = nav.children[2];
    var left0 = function () { return t.getBoundingClientRect().left + (parseFloat(getComputedStyle(t).paddingLeft) || 0); };
    var cur = function () { var L = left0(), best = 0, d = Infinity; items.forEach(function (c, j) { var x = Math.abs(c.getBoundingClientRect().left - L); if (x < d) { d = x; best = j; } }); return best; };
    var atEnd = function () { return t.scrollLeft + t.clientWidth >= t.scrollWidth - 4; };
    // 枠の高さを、いま表示しているカードに合わせる（一番背の高いカードに合わせると、短いカードの下とボタンの間が空く）
    var fitH = function (i) {
      var cs = getComputedStyle(t);
      var pad = cs.boxSizing === 'border-box' ? (parseFloat(cs.paddingTop) || 0) + (parseFloat(cs.paddingBottom) || 0) : 0;
      t.style.height = Math.ceil(items[i].getBoundingClientRect().height + pad) + 'px';
    };
    var upd = function () {
      var over = t.scrollWidth > t.clientWidth + 4;
      nav.hidden = !over;
      t.classList.toggle('is-fit', over);
      if (!over) { t.style.height = ''; return; }
      var i = atEnd() ? items.length - 1 : cur();
      fitH(i);
      cnt.textContent = (i + 1) + ' / ' + items.length;
      prev.disabled = t.scrollLeft <= 2;
      next.disabled = atEnd();
    };
    var go = function (dir) {
      var i = Math.max(0, Math.min(items.length - 1, cur() + dir));
      t.scrollBy({ left: items[i].getBoundingClientRect().left - left0(), behavior: reduce ? 'auto' : 'smooth' });
    };
    prev.addEventListener('click', function () { go(-1); });
    next.addEventListener('click', function () { go(1); });
    var raf = 0;
    t.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(upd); }, { passive: true });
    window.addEventListener('resize', upd);
    window.addEventListener('load', upd);
    // 画像の読み込みなどでカードの高さが変わったら合わせ直す
    if ('ResizeObserver' in window) { var ro = new ResizeObserver(function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(upd); }); items.forEach(function (c) { ro.observe(c); }); }
    upd();
  });
})();
/* マーキーのスクロール速度を全トラックで統一する。CSSの固定
   duration だとトラック幅（ロゴ枚数）によって px/秒 が変わるため、
   幅に比例した duration を計算して速度を一定にする。遅延読み込みの
   画像で幅が変わっても ResizeObserver で追従する。 */
(function () {
  var SPEED = 86; // px/秒（従来の展開団体マーキー実測値に合わせ体感を維持）
  function set(t) {
    var dist = t.scrollWidth / 2;
    if (dist > 0) t.style.animationDuration = Math.round((dist / SPEED) * 10) / 10 + 's';
  }
  var tracks = document.querySelectorAll('.marquee-track');
  if (!tracks.length) return;
  tracks.forEach(set);
  if ('ResizeObserver' in window) {
    var ro = new ResizeObserver(function (entries) {
      entries.forEach(function (e) { set(e.target); });
    });
    tracks.forEach(function (t) { ro.observe(t); });
  } else {
    window.addEventListener('load', function () { tracks.forEach(set); });
  }
})();
/* 横スワイプできるカルーセルの直下に「スワイプ」ヒントを自動で
   付ける。実際にはみ出しているときだけ表示し、一度スクロール
   したらフェードアウトする。対象クラスはCSSの横スクロール
   ストリップ群と揃えること。 */
(function () {
  // .blog-strip・.works-grid は「‹ 1 / N ›」のボタンを付けるので、ここでは対象外
  var strips = document.querySelectorAll('.str-grid,.style-grid,.genre-grid,.flow-row,.biz-flow,.event-row');
  function attach() {
    strips.forEach(function (el) {
      if (el.dataset.swipeHint || el.scrollWidth <= el.clientWidth + 8) return;
      el.dataset.swipeHint = '1';
      var hint = document.createElement('p');
      hint.className = 'swipe-hint';
      hint.textContent = '横にスワイプ';
      el.insertAdjacentElement('afterend', hint);
      el.addEventListener('scroll', function () { hint.classList.add('is-fading'); }, { once: true, passive: true });
    });
  }
  window.addEventListener('load', attach);
  attach();
})();
(function () {
  var sections = document.querySelectorAll('section.section');
  if (!sections.length) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
    sections.forEach(function (el) { el.classList.add('is-visible'); });
    return;
  }
  /* threshold は 0 にする。割合しきい値（例 0.12）だと、画面の高さより
     「セクション高の12%」が大きい縦長セクション（記事一覧など）で
     しきい値に永遠に達せず、opacity:0 のまま表示されないことがある
     （スマホ実機の画面高で発生）。 */
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
  sections.forEach(function (el) { io.observe(el); });
})();
</script>

</body>
</html>
