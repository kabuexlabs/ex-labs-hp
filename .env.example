MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key

# --- 日程調整（/yoyaku）関連。設定手順は docs/yoyaku-setup.md 参照 ---

# 予約ページのURLトークン（推測できない長いランダム文字列にする）
# 例: openssl rand -hex 16 で生成
BOOKING_PAGE_TOKEN=

# 管理ページ（/yoyaku/admin/）の合言葉
YOYAKU_ADMIN_KEY=

# Upstash Redis（Vercel Marketplace 経由なら自動で注入される）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend（メール送信・無料枠 月3,000通）。未設定でも予約は動き、メールだけ送られない
RESEND_API_KEY=
# 送信元（Resend でドメイン認証したアドレスにする）
MAIL_FROM="ex Labs 予約窓口 <yoyaku@kabuexlabs.com>"
# 予約通知・リマインドの控えを受け取るアドレス
YOYAKU_ADMIN_EMAIL=info@kabuexlabs.com

# Cron エンドポイント保護用（Vercel が自動でヘッダに付与する）
CRON_SECRET=

# --- 街歩き謎解き（/shimokita）関連。設定手順は docs/shimokita-setup.md 参照 ---

# 運営管理画面（/shimokita/admin/）の合言葉。
# 未設定の場合は YOYAKU_ADMIN_KEY を流用する。
SMK_ADMIN_KEY=

# --- HACKTALE 公演予約（/hacktale/reservation・/hacktale/admin）関連 ---
# 設定手順は docs/hacktale-yoyaku-setup.md 参照。
# DB は上の KV_REST_API_*、メールは SMTP_USER/SMTP_PASS（または RESEND_API_KEY）、
# cron 保護は CRON_SECRET をそのまま共用する。

# 管理ページ（/hacktale/admin/）の合言葉。未設定なら YOYAKU_ADMIN_KEY を流用
HACKTALE_ADMIN_KEY=

# --- 漢方体質チェック 試験サイト（/kampo/）関連。設定手順は docs/kampo-setup.md 参照 ---
# DB は上の KV_REST_API_* を共用（kampo: プレフィックスで分離）。cron は未登録（Hobby の上限）。

# 共通パスワード（店頭 iPad・PC でのログイン）。未設定なら YOYAKU_ADMIN_KEY を流用
KAMPO_PASSWORD=
# スタッフ画面の4桁PIN。未設定なら共通パスワードで代用（画面に注意が出る）
KAMPO_STAFF_PIN=
# Cookie の署名鍵（32文字以上のランダム文字列。未設定ならパスワードから派生）
KAMPO_SESSION_SECRET=
# 監修者表示（例: 薬剤師 ○○ ○○）と経歴の一文（任意）
KAMPO_SUPERVISOR_NAME=
KAMPO_SUPERVISOR_BIO=
# 担当薬剤師の氏名（カンマ区切り。提案保存時の選択肢になる）
KAMPO_STAFF_NAMES=
# データ保持年数（既定 3）
KAMPO_RETENTION_YEARS=3
