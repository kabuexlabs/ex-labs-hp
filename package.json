{
  "name": "ex-labs-hp",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "seo:audit": "node scripts/seo-audit.mjs --warn",
    "seo:fanout": "node scripts/fanout-audit.mjs",
    "seo:report": "python3 scripts/gsc_report.py",
    "test:spam": "node --experimental-strip-types scripts/spam-test.mjs",
    "check": "npm run build && node scripts/seo-audit.mjs && npm run test:spam && npm run test:week && node scripts/fanout-audit.mjs",
    "llms:full": "node scripts/build-llms-full.mjs",
    "seo:crawl": "node scripts/crawl-audit.mjs --warn",
    "indexnow": "node scripts/indexnow.mjs",
    "test:week": "node --experimental-strip-types scripts/this-week-test.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.2",
    "astro": "^7.0.6",
    "leaflet": "^1.9.4",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.14.0"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.1",
    "smtp-server": "^3.19.2"
  }
}
